container Output
:	Descr = "Exports and reports beside a model run: networks and public transport nodes for GIS, the public transport network in a time window, the recognised flex lines per feed, the routes of one OD pair and the validation sample against 9292 for checking the model, and post-analyses for the RuimteScanner."
{
	container Exports
	:	Descr = "The networks and the public transport nodes for use in GIS or in the RuimteScanner."
	{
		parameter<String> Network_Car_TomTom         := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/TomTom/Roads_selection/Export/Network";
		parameter<String> Network_Car_OSM            := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/OSM/OSM_Networks_Export/Car/Generate";
		parameter<String> Network_Cycling_OSM        := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/OSM/OSM_Networks_Export/Cycling/Generate";
		parameter<String> Network_Walking_OSM        := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/OSM/OSM_Networks_Export/Walking/Generate";
		parameter<String> PT_Nodes                   := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/GTFS/PT_Hubs/Export_Knooppunten";
		parameter<String> PT_Nodes_CarTravelTime_tif := 'Ready' , ExplicitSuppliers = "/SourceData/Infrastructure/GTFS/PT_Hubs/Accessibility_Car/Traveltime_25m";
	}
	#include<PT_NetworkExport.dms>
	#include<FlexLines.dms>
	#include<OD_PairRoutes.dms>
	#include<Validation.dms>
	#include<PostAnalysis.dms>
}
