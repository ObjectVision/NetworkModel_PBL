Template CreateNetwork_TomTom_T : Descr = "Builds the TomTom car network from RoadDomain and Junctions, with the origins and destinations connected, link impedances per congestion moment, junction penalties and the time-dependent link times."
{
	// begin case parameters
	unit<uint32> OrgDomain;
	unit<uint32> DestDomain;
	unit<uint32> RoadDomain;
	unit<uint32> Junctions;
	// end case parameters
	container    root       := .;

	unit<uint32> Locations := union_unit(orgDomain, destDomain)
	{
		attribute<rdc>  geometry := union_data(.,orgDomain/geometry, destDomain/geometry);
		attribute<bool> IsOrg    := union_data(.,const(TRUE , OrgDomain), const(FALSE,DestDomain));
		attribute<bool> IsDest   := union_data(.,const(FALSE, OrgDomain), const(TRUE ,DestDomain));
	}
	
	unit<uint32> UniqueLocations := unique(Locations/geometry)
	{ 
		attribute<rdc>       geometry               := values;
		attribute<Locations> Locations_rel          := rlookup(geometry, Locations/geometry);
		attribute<OrgDomain> OrgDomain_rel          := rlookup(geometry, orgDomain/geometry);
		attribute<bool>      IsOrg                  := rjoin(geometry, Locations/geometry, Locations/IsOrg);
		
		attribute<uint64>    F_JNCTID               := max(Junctions/JNCTID) + 1000000u64 + uint64(id(.));
		attribute<uint64>    T_JNCTID               := Closest_JNCTID;
		
		//for OD connection lines:
		unit<uint32>         uqGeoJunctions         := CreateInitialWorkingNetwork/Road_linestrings/uqGeoJunctions;
		attribute<uqGeoJunctions> Closest_Junction := capacitated_connect(uqGeoJunctions/geometry, float64(uqGeoJunctions/Connectable), geometry, const(1d,.));
		attribute<uint64>    Closest_JNCTID         := uqGeoJunctions/JNCTID[Closest_Junction];
		attribute<rdc>       OD_line          (arc) := points2sequence(GenConnLines/Points, GenConnLines/Seq, GenConnLines/Ord);
		attribute<m>         length                 := arc_length(OD_line, m_f64)[m];
		attribute<float32>   DestWeight             := const(1f,.);
		attribute<rdc>       Clostest_JNCT_geometry := uqGeoJunctions/geometry[Closest_Junction];
		
		unit<uint32> GenConnLines := union_unit(.,.)
		{
			attribute<rdc>    Points := union_data(., geometry, uqGeoJunctions/geometry[Closest_Junction]);
			attribute<..>     Seq    := union_data(., id(..), id(..));
			attribute<uint32> Ord    := union_data(., const(0,..,uint32), const(1,..,uint32));
		}  
	}
	
	container CreateInitialWorkingNetwork
	{
		unit<uint32> Roads_with_unconnected_subnetworks_w_CarRoads := RoadDomain
		{
			attribute<bool> IsCarRoad := Direction != /Classifications/Directions_TomTom/V/nocars;
		
			container Speed_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					,'CalcTimes/'+ModelParameters/Impl/CongestionTimes/name+'/PerMoment/'+ModelParameters/CongestionSpeed_DaySelection+'/KPH'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := ='CalcTimes/'+first(ModelParameters/Impl/CongestionTimes/name)+'/PerMoment/freeflow/KPH';
			}
			// The speeds of the opposite direction of a two-way road.
			container Speed_per_ImpedanceType_bwd :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					,'CalcTimes/'+ModelParameters/Impl/CongestionTimes/name+'/PerMoment/'+ModelParameters/CongestionSpeed_DaySelection+'/KPH_bwd'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := ='CalcTimes/'+first(ModelParameters/Impl/CongestionTimes/name)+'/PerMoment/freeflow/KPH_bwd';
			}
		}
		
		unit<uint32> Roads_with_unconnected_subnetworks_wo_CarRoads := select(Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad)
		{
			attribute<rdc>        geometry (arc) := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/geometry);
			attribute<RoadDomain> Road_rel       := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, id(RoadDomain)), Descr = "The road element, for the time-dependent link times (TimeDependent).";
			attribute<bool>       IsOneDirection := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/IsOneDirection);
			attribute<m>          Meters         := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Meters);
			attribute<Bool >      Connectable    := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Connectable);
			
			attribute<uint64>     F_JNCTID       := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/F_JNCTID_directed);
			attribute<uint64>     T_JNCTID       := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/T_JNCTID_directed);
			attribute<Junctions>  F_JNCT_rel     := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/F_JNCT_rel);
			attribute<Junctions>  T_JNCT_rel     := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/T_JNCT_rel);
				attribute<Classifications/FuncRoadClass> FRC_rel := collect_by_cond(.,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/FRC_rel), Descr = "The road class of the road element (TomTom FRC).";
			
			container Speed_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					,'collect_by_cond(Roads_with_unconnected_subnetworks_wo_CarRoads,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Speed_per_ImpedanceType/'+ModelParameters/Impl/CongestionTimes/name+')'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := collect_by_cond(Roads_with_unconnected_subnetworks_wo_CarRoads,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Speed_per_ImpedanceType/Freeflow);
			}
			container Speed_per_ImpedanceType_bwd :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					,'collect_by_cond(Roads_with_unconnected_subnetworks_wo_CarRoads,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Speed_per_ImpedanceType_bwd/'+ModelParameters/Impl/CongestionTimes/name+')'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := collect_by_cond(Roads_with_unconnected_subnetworks_wo_CarRoads,Roads_with_unconnected_subnetworks_w_CarRoads/IsCarRoad, Roads_with_unconnected_subnetworks_w_CarRoads/Speed_per_ImpedanceType_bwd/Freeflow);
			}

			container             Connectiveness := Templates/Check_Connectiveness_T(.,Junctions, F_JNCT_rel, T_JNCT_rel);
		}
		
		attribute<bool> Roads_isConnected (Roads_with_unconnected_subnetworks_wo_CarRoads) := Roads_with_unconnected_subnetworks_wo_CarRoads/Connectiveness/IsInMainNetwork;

		unit<uint32> Road_linestrings := select(Roads_isConnected)
		{
			attribute<rdc>        geometry (arc) := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/geometry);
			attribute<RoadDomain> Road_rel       := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/Road_rel);
			attribute<bool>       IsOneDirection := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/IsOneDirection);
			attribute<Bool>       Connectable    := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/Connectable);
			attribute<m>          Meters         := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/Meters);
			attribute<Junctions>  F_JNCT_rel     := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/F_JNCT_rel);
			attribute<Junctions>  T_JNCT_rel     := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/T_JNCT_rel);
			
			attribute<uint64>     F_JNCTID       := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/F_JNCTID);
			attribute<uint64>     T_JNCTID       := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/T_JNCTID);
				attribute<Classifications/FuncRoadClass> FRC_rel := collect_by_cond(.,Roads_isConnected, Roads_with_unconnected_subnetworks_wo_CarRoads/FRC_rel);
			
			container Speed_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					, 'Collect_by_cond(..,Roads_isConnected,Roads_with_unconnected_subnetworks_wo_CarRoads/Speed_per_ImpedanceType/'+ModelParameters/Impl/CongestionTimes/name+')'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := Collect_by_cond(..,Roads_isConnected,Roads_with_unconnected_subnetworks_wo_CarRoads/Speed_per_ImpedanceType/Freeflow);
			}
			container Speed_per_ImpedanceType_bwd :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					, 'Collect_by_cond(..,Roads_isConnected,Roads_with_unconnected_subnetworks_wo_CarRoads/Speed_per_ImpedanceType_bwd/'+ModelParameters/Impl/CongestionTimes/name+')'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := Collect_by_cond(..,Roads_isConnected,Roads_with_unconnected_subnetworks_wo_CarRoads/Speed_per_ImpedanceType_bwd/Freeflow);
			}
			attribute<NodeSet>    F1_node        := rlookup(F_JNCTID, NodeSet/JNCTID), Descr = "Begin node of the road element, for the node degree.";
			attribute<NodeSet>    F2_node        := rlookup(T_JNCTID, NodeSet/JNCTID), Descr = "End node of the road element, for the node degree.";
			
			//needed for OD-connection lines
			unit<uint32> UseableJunctions := union_unit(.,.)
			{
				attribute<rdc>            geometry         := union_data(., Junctions/geometry[F_JNCT_rel], Junctions/geometry[T_JNCT_rel]);
				attribute<uint64>         JNCTID           := union_data(., F_JNCTID, T_JNCTID);
				attribute<uqGeoJunctions> UqGeoJunctionsID := rlookup(geometry, uqGeoJunctions/geometry);
				attribute<bool>           Connectable      := rjoin(JNCTID, Road_linestrings/F_JNCTID, Road_linestrings/Connectable) || rjoin(JNCTID, Road_linestrings/T_JNCTID, Road_linestrings/Connectable);
			}  
			//needed for OD-connection lines
			unit<uint32> uqGeoJunctions := unique(UseableJunctions/geometry)
			{
				attribute<rdc>     geometry    := values;
				attribute<uint64>  JNCTID      := first(UseableJunctions/JNCTID, UseableJunctions/UqGeoJunctionsID);
				attribute<UseableJunctions> Junctions_rel := first(id(UseableJunctions), UseableJunctions/UqGeoJunctionsID);
				attribute<float64> Connectable := float64(any(UseableJunctions/Connectable, UseableJunctions/UqGeoJunctionsID));
			}
		}

		// A two-way road becomes two directed links, each with the speed of its own direction: the road elements themselves in their driving
		// direction, and for the two-way roads a reversed copy. With InterpretAllRoadsAsBidirectional every road element stays one undirected link.
		unit<uint32> Road_linestrings_bwd := select_with_org_rel(not(Road_linestrings/IsOneDirection) && not(ModelParameters/Advanced/InterpretAllRoadsAsBidirectional))
		{
			attribute<rdc>        geometry (arc) := Road_linestrings/geometry[org_rel];
			attribute<RoadDomain> Road_rel       := Road_linestrings/Road_rel[org_rel];
			attribute<m>          Meters         := Road_linestrings/Meters[org_rel];
			attribute<uint64>     F_JNCTID       := Road_linestrings/T_JNCTID[org_rel];
			attribute<uint64>     T_JNCTID       := Road_linestrings/F_JNCTID[org_rel];
			attribute<Classifications/FuncRoadClass> FRC_rel := Road_linestrings/FRC_rel[org_rel];
			container Speed_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					, 'Road_linestrings/Speed_per_ImpedanceType_bwd/'+ModelParameters/Impl/CongestionTimes/name+'[org_rel]'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (..) := Road_linestrings/Speed_per_ImpedanceType_bwd/Freeflow[org_rel];
			}
		}

		unit<uint32> LinkSet := union_unit(Road_linestrings, Road_linestrings_bwd, UniqueLocations)
		{
			attribute<rdc>        geometry (arc) := union_data(., Road_linestrings/geometry, Road_linestrings_bwd/geometry, UniqueLocations/OD_line);
			attribute<bool>       IsOneDirection := union_data(., Road_linestrings/IsOneDirection || not(ModelParameters/Advanced/InterpretAllRoadsAsBidirectional), const(TRUE, Road_linestrings_bwd), const(FALSE,UniqueLocations)), Descr = "Road elements are directed links (a two-way road also has a reversed copy); the OD connection links can be driven in both directions.";
			attribute<bool>       IsBackward     := union_data(., const(FALSE, Road_linestrings), const(TRUE, Road_linestrings_bwd), const(FALSE,UniqueLocations)), Descr = "The reversed copy of a two-way road.";
			attribute<RoadDomain> Road_rel       := union_data(., Road_linestrings/Road_rel, Road_linestrings_bwd/Road_rel, const(value(null_u, RoadDomain), UniqueLocations)), Descr = "The road element of the link; null for the OD connection links.";
			attribute<m>          Meters         := union_data(., Road_linestrings/Meters, Road_linestrings_bwd/Meters, UniqueLocations/Length);
			attribute<uint64>     F_JNCTID       := union_data(., Road_linestrings/F_JNCTID, Road_linestrings_bwd/F_JNCTID, UniqueLocations/F_JNCTID);
			attribute<uint64>     T_JNCTID       := union_data(., Road_linestrings/T_JNCTID, Road_linestrings_bwd/T_JNCTID, UniqueLocations/T_JNCTID);
			attribute<Classifications/FuncRoadClass> FRC_rel := union_data(., Road_linestrings/FRC_rel, Road_linestrings_bwd/FRC_rel, const(Classifications/FuncRoadClass/V/Not_Applicable, UniqueLocations)), Descr = "Road class per link; the OD connection links get Not Applicable.";
			
			attribute<rdc>        FromPoint      := union_data(., rjoin(Road_linestrings/F_JNCTID, Junctions/JNCTID, Junctions/geometry), rjoin(Road_linestrings_bwd/F_JNCTID, Junctions/JNCTID, Junctions/geometry), UniqueLocations/geometry);
			attribute<rdc>        ToPoint        := union_data(., rjoin(Road_linestrings/T_JNCTID, Junctions/JNCTID, Junctions/geometry), rjoin(Road_linestrings_bwd/T_JNCTID, Junctions/JNCTID, Junctions/geometry), UniqueLocations/Clostest_JNCT_geometry);
			
			attribute<NodeSet>    F1             := rlookup(F_JNCTID, NodeSet/JNCTID);
			attribute<NodeSet>    F2             := rlookup(T_JNCTID, NodeSet/JNCTID);
			
	
			container Speed_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					, 'union_data(.., MakeDefined(Road_linestrings/Speed_per_ImpedanceType/'+ModelParameters/Impl/CongestionTimes/name+', ModelParameters/Advanced/CarDefaultSpeed_low), MakeDefined(Road_linestrings_bwd/Speed_per_ImpedanceType/'+ModelParameters/Impl/CongestionTimes/name+', ModelParameters/Advanced/CarDefaultSpeed_low), const(ModelParameters/Advanced/CarDefaultSpeed_low, UniqueLocations))'
					, .
					, km_hr
				)
			{
				attribute<km_hr> Freeflow (LinkSet) := union_data(.., MakeDefined(Road_linestrings/Speed_per_ImpedanceType/Freeflow, ModelParameters/Advanced/CarDefaultSpeed_low), MakeDefined(Road_linestrings_bwd/Speed_per_ImpedanceType/Freeflow, ModelParameters/Advanced/CarDefaultSpeed_low), const(ModelParameters/Advanced/CarDefaultSpeed_low, UniqueLocations));
			}
			
			attribute<km>         LengthKm       := convert(meters, km), Descr = "The length of the link, which is also the second criterion of the front of the direct car trip (#88).";

			container Impedance_per_ImpedanceType :=
				for_each_nedv(
					ModelParameters/Impl/CongestionTimes/name
					, 'convert(MakeDefined(convert((LengthKm / Speed_per_ImpedanceType/'+ModelParameters/Impl/CongestionTimes/name+'), min_f), 0.0001[min_f]), s_f) + Float32(CorrectImpedanceForCrossroads/impedance_Start + CorrectImpedanceForCrossroads/impedance_End)'
					, .
					, s_f
				)
			{
				attribute<s_f> Freeflow (LinkSet) := convert(MakeDefined(convert((LengthKm / Speed_per_ImpedanceType/freeflow), min_f), 0.0001[min_f]), s_f) + Float32(CorrectImpedanceForCrossroads/impedance_Start + CorrectImpedanceForCrossroads/impedance_End);
			}
		}

		unit<uint32> NodeSet := union_unit(Junctions, UniqueLocations)
		{
			attribute<uint64> JNCTID                    := union_data(., Junctions/JNCTID,   UniqueLocations/F_JNCTID);
			attribute<rdc>    geometry                  := union_data(., Junctions/geometry, UniqueLocations/geometry);
			
			// The node degree counts road elements: not the OD connection links (they would turn every attachment point into a junction with a
			// penalty for through traffic) and not the reversed copy of a two-way road.
			attribute<uint32> NrConnectedLinks          := pcount(Road_linestrings/F1_node) + pcount(Road_linestrings/F2_node);
			
			attribute<.>      OrgNode_rel   (OrgDomain) := rlookup(OrgDomain/geometry,  geometry);
			attribute<.>      DestNode_rel (DestDomain) := rlookup(DestDomain/geometry, geometry);
			
			
		}
					
		container       CorrectImpedanceForCrossroads
		// Determines for every begin and end node the number of connected links, which tells whether it is a bend (2 links), a side road
		// (3 links), a crossing (4 links) or a complex crossing (more than 4 links); depending on this number some seconds are added to the
		// total impedance.
		{
			// A route that passes a node drives over a link that ends there and one that starts there; each link therefore gets half of the penalty
			// of its begin and end node, so that a junction passed costs its value once.
			parameter<s>      Impedance2Links               := ModelParameters/Advanced/Junction_Penalties/with_2Links_Car;
			parameter<s>      Impedance3Links               := ModelParameters/Advanced/Junction_Penalties/with_3Links_Car;
			parameter<s>      Impedance4Links               := ModelParameters/Advanced/Junction_Penalties/with_4Links_Car;
			parameter<s>      Impedance_gt4Links            := ModelParameters/Advanced/Junction_Penalties/with_gt4Links_Car;

			parameter<s>      Impedance2_lowerSpeedLinks    := ModelParameters/Advanced/Junction_Penalties/with_2_lowerSpeedLinks_Car;
			parameter<s>      Impedance3_lowerSpeedLinks    := ModelParameters/Advanced/Junction_Penalties/with_3_lowerSpeedLinks_Car;
			parameter<s>      Impedance4_lowerSpeedLinks    := ModelParameters/Advanced/Junction_Penalties/with_4_lowerSpeedLinks_Car;
			parameter<s>      Impedance_gt4_lowerSpeedLinks := ModelParameters/Advanced/Junction_Penalties/with_gt4_lowerSpeedLinks_Car;

			attribute<uint32> Start               (LinkSet) := NodeSet/NrConnectedLinks[LinkSet/F1];
			attribute<uint32> End                 (LinkSet) := NodeSet/NrConnectedLinks[LinkSet/F2];
		
			attribute<s_f>    impedance_Start     (LinkSet) := 0.5f *
			                                                   convert(switch(
			                                                        case(Start <= 2, Impedance2Links)
			                                                       ,case(Start  = 3, Impedance3Links)
			                                                       ,case(Start  = 4, Impedance4Links)
			                                                       ,Impedance_gt4Links
			                                                   ), s_f);
		
			attribute<s_f>    impedance_End       (LinkSet) := 0.5f *
			                                                   convert(switch(
			                                                        case(End <= 2, Impedance2Links)
			                                                       ,case(End  = 3, Impedance3Links)
			                                                       ,case(End  = 4, Impedance4Links)
			                                                       ,Impedance_gt4Links
			                                                   ), s_f);
				
				
		}
	}

	// Time-dependent link times (ModelParameters/Impl/CarTimeDependent, NetworkModel_PBL#132, GeoDMS#1304). Every link is a road section in one
	// direction or an OD connection link, without merging, so a link can get its own profile: only when its speed changes within the window
	// (CarTD_WindowStart, CarTD_NrSlots time slots of 300 s). The factor per time slot is T_ref / T: T is the link time as the snapshot of that
	// time slot calculates it, with the same operations as TomTom.dms (Roads_selection/CalcTimes: SP_freeflow x relative speed, MINUTES without
	// speed, the cap MaxSpeed) and LinkSet/Impedance_per_ImpedanceType above (CarDefaultSpeed_low, the junction corrections); T_ref is the
	// snapshot of the congestion moment of the PartOfDay (07:30). The search takes T_ref as the fixed link time and divides it per time slot
	// by the factor, so within a time slot the link time is exactly that of the snapshot of that slot; a trip that crosses the boundary of a
	// time slot drives the rest of the link at the speed of the next slot (the integral of GeoDMS#1304).
	container TimeDependent
	{
		unit<uint32>             LinkSet               := CreateInitialWorkingNetwork/LinkSet;
		unit<uint32>             Speednetworks         := /SourceData/Infrastructure/TomTom/Speednetworks;
		unit<uint32>             Keys                  := /SourceData/Infrastructure/TomTom/SpeedProfileKeys;
		parameter<string>        RefMoment             := /ModelParameters/Impl/Car_CongestionMoment_ForDirect;
		parameter<km_hr>         MaxSpeed              := MakeDefined(rjoin(RefMoment, ModelParameters/Impl/CongestionTimes/name, ModelParameters/Impl/CongestionTimes/MaxSpeed), 0[km_hr]), Descr = "The cap of the congestion moment (100 km/h during the day), for all time slots of the window.";
		parameter<string>        RefTime               := rjoin(RefMoment, ModelParameters/Impl/CongestionTimes/name, ModelParameters/Impl/CongestionTimes/Time);
		parameter<uint32>        RefSlot               := (uint32(substr(RefTime, 0, 2)) * 3600 + uint32(substr(RefTime, 2, 2)) * 60 - ModelParameters/Advanced/CarTD_WindowStart) / 300, Descr = "The time slot of the congestion moment in the window (18 for 07:30 with a window from 06:00).";
		parameter<uint32>        NrSlots               := ModelParameters/Advanced/CarTD_NrSlots;
		parameter<uint32>        FirstDaySlot          := ModelParameters/Advanced/CarTD_WindowStart / 300;

		attribute<RoadDomain>    Road_rel    (LinkSet) := LinkSet/Road_rel;
		attribute<Speednetworks> Sn_rel      (LinkSet) := LinkSet/IsBackward ? RoadDomain/Speednetworks_bwd_rel[Road_rel] : RoadDomain/Speednetworks_fwd_rel[Road_rel], Descr = "The row of Speednetworks in the direction of the link.";
		attribute<Keys>          Day_rel     (LinkSet) := Speednetworks/DayProfile_rel[Sn_rel];
		attribute<bool>          HasProfile  (LinkSet) := IsDefined(Day_rel) && Speednetworks/SP_freeflow[Sn_rel] > 0w && not(RoadDomain/IsFerry[Road_rel]) && Keys/VariesInWindow[Day_rel];
		attribute<s_f>           T_ref       (LinkSet) := ='LinkSet/Impedance_per_ImpedanceType/' + RefMoment, Descr = "The fixed link time of the search: the snapshot of the congestion moment.";

		unit<uint32> Profile := select_with_org_rel(HasProfile)
		, Descr = "The links with their own profile, with the quantities of their link time that do not depend on the time slot."
		{
			attribute<Speednetworks> Sn_rel   := ../Sn_rel[org_rel];
			attribute<Keys>          Day_rel  := ../Day_rel[org_rel];
			attribute<km_hr>         SP_ff    := value(float32(Speednetworks/SP_freeflow[Sn_rel]), km_hr);
			attribute<m>             Meters   := RoadDomain/meters[../Road_rel[org_rel]];
			attribute<min_f>         Minutes0 := RoadDomain/Minutes[../Road_rel[org_rel]];
			attribute<min_f>         Min_cap  := convert(convert(Meters, km) / (MaxSpeed > 0[km_hr] ? MaxSpeed : 1000[km_hr]), min_f);
			attribute<km>            LengthKm := LinkSet/LengthKm[org_rel];
			attribute<float32>       Corr     := Float32(CreateInitialWorkingNetwork/CorrectImpedanceForCrossroads/impedance_Start[org_rel] + CreateInitialWorkingNetwork/CorrectImpedanceForCrossroads/impedance_End[org_rel]);
			attribute<s_f>           T_ref    := ../T_ref[org_rel];
		}
		attribute<Profile>       Profile_rel (LinkSet) := rlookup(id(LinkSet), Profile/org_rel), Descr = "link_profile_rel of the search; null keeps T_ref.";

		unit<uint32> ProfileSlot := range(uint32, 0, #Profile * NrSlots)
		, Descr = "Per profile the time slots of the window, profile after profile (the order of combine(Profile, Slot) that the search expects)."
		{
			attribute<Profile> P_rel     := value(uint32(id(.)) / NrSlots, Profile);
			attribute<uint32>  Slot      := uint32(id(.)) % NrSlots;
			attribute<float32> rel_speed := /SourceData/Infrastructure/TomTom/ProfileDaySlot/rel_speed[value(uint32(Profile/Day_rel[P_rel]) * 288 + FirstDaySlot + Slot, /SourceData/Infrastructure/TomTom/ProfileDaySlot)];
			attribute<km_hr>   Speed     := Profile/SP_ff[P_rel] * rel_speed;
			attribute<min_f>   Min_u     := MakeDefined(convert(convert(Profile/Meters[P_rel], km) / Speed, min_f), Profile/Minutes0[P_rel]);
			attribute<min_f>   Minutes   := MaxSpeed > 0[km_hr] ? max_elem(Min_u, Profile/Min_cap[P_rel]) : Min_u;
			attribute<km_hr>   kph       := convert(Profile/Meters[P_rel], km) / convert(Minutes, hr_f);
			attribute<km_hr>   Speed_net := MakeDefined(kph, ModelParameters/Advanced/CarDefaultSpeed_low);
			attribute<s_f>     T         := convert(MakeDefined(convert((Profile/LengthKm[P_rel] / Speed_net), min_f), 0.0001[min_f]), s_f) + Profile/Corr[P_rel], Descr = "The link time of the snapshot of this time slot.";
			attribute<float32> factor    := Profile/T_ref[P_rel] / T, Descr = "profile_slot_factor of the search: T_ref / T; 1 in the time slot of the congestion moment.";
		}

		// Checks: in the time slot of the congestion moment T equals T_ref (the same operations); all factors are positive and finite.
		parameter<uint32>        NrRefMismatch         := sum_uint32(ProfileSlot/Slot == RefSlot && ProfileSlot/T != Profile/T_ref[ProfileSlot/P_rel]), Descr = "Must be 0.";
		parameter<float32>       MinFactor             := min(ProfileSlot/factor);
		parameter<float32>       MaxFactor             := max(ProfileSlot/factor);
		parameter<uint32>        NrBadFactor           := sum_uint32(not(IsDefined(ProfileSlot/factor)) || not(ProfileSlot/factor > 0f) || ProfileSlot/factor > 1000f), Descr = "Must be 0.";
		parameter<string>        Report                := 'links ' + string(#LinkSet) + ', met profiel ' + string(#Profile) + ', tijdvakken ' + string(NrSlots) + ' vanaf ' + string(FirstDaySlot * 300) + ' s (referentie ' + string(RefSlot) + '); factor ' + string(MinFactor) + '..' + string(MaxFactor) + '; afwijkend in het referentievak ' + string(NrRefMismatch) + ', ongeldige factoren ' + string(NrBadFactor);
	}
}
