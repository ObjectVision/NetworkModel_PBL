Template ReadMergeExports_OV_perType_T
{
	parameter<string> Export_CombinationTypes;
	parameter<string> Dest;
	//
	// Samenvoegen van de OV-uitvoer: eerst per vertrekmoment over alle herkomstblokken (Merge_Regions), dan over de
	// vertrekmomenten (Merge_Times). Sinds 2026-09-25 (audit 6.5) met de naamstaart van de schrijver en via GDAL; de
	// bestandsnaam van Merge_Times begint met 'tt_<datum>', zoals FindMedian (PostAnalysis) hem leest (tot dan 'tt__').

	container Read_Regions :=
		for_each_ne(
			Impl/OrgBlockDomain/name
			, 'Templates/ReadExport_OV_perTime_T('+quote(Export_CombinationTypes)+','+quote(Impl/OrgBlockDomain/name)+','+quote(Dest)+')'
		);

	container Merge_Regions :=
		for_each_ne(
			 Advanced/MeasureMoments/name
			, 'Templates/Merge_Regions_OV_T('+quote(Export_CombinationTypes)+','+quote( Advanced/MeasureMoments/name)+','+quote(Dest)+')'
		)
	{
		parameter<string>   OUTPUT_Merge_Regions  := 'Ready', ExplicitSuppliers = "=asList(Advanced/MeasureMoments/Name+'/LongFormat/File_fullOD',';')";
	}

	container Read_Times  := Templates/ReadExport_OV_perTime_T(Export_CombinationTypes,'All',Dest);
	container Merge_Times := Merge_Times_OV_T(Export_CombinationTypes,Dest);

	Template Merge_Times_OV_T
	{
		parameter<string> Export_CombinationTypes;
		parameter<string> Dest_str;
		//

		unit<uint32> Merged := ='union_unit('+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/domain')+')'
		{
			// Sinds 2026-10-03 dezelfde kolommen als de bestanden per vertrekmoment, de getallen als getal (zie Merge_Regions_OV_T).
			attribute<string>  OrgName            := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/OrgName')+')';
			attribute<string>  DestName           := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/DestName')+')';
			attribute<string>  DepTime            := ='union_data(.,'+asList('const('+quote(Advanced/MeasureMoments/Name)+',Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/domain)',',')+')';
			attribute<float64> Traveltime         := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/Traveltime')+')';
			attribute<string>  ModeUsed           := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/ModeUsed')+')';
			attribute<uint8>   NeedsCar           := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/NeedsCar')+')';
			attribute<uint8>   NeedsBike          := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/NeedsBike')+')';
			attribute<float64> Price              := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/Price')+')';
			attribute<float64> WaitingTime        := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/WaitingTime')+')';
			attribute<float64> PretransTime       := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PretransTime')+')';
			attribute<float64> PTTime             := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PTTime')+')';
			attribute<float64> PosttransTime      := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PosttransTime')+')';
			attribute<float64> PretransPrice      := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PretransPrice')+')';
			attribute<float64> PTPrice            := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PTPrice')+')';
			attribute<float64> PosttransPrice     := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PosttransPrice')+')';
			attribute<float64> TravelDist_V       := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_V')+')';
			attribute<float64> TravelDist_PT      := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_PT')+')';
			attribute<float64> TravelDist_N       := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_N')+')';
			attribute<float64> TravelDist_Walking := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_Walking')+')';
			attribute<float64> TravelDist_Cycling := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_Cycling')+')';
			attribute<float64> TravelDist_Car     := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/TravelDist_Car')+')';
			attribute<float64> WalkingTime        := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/WalkingTime')+')';
			attribute<float64> CyclingTime        := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/CyclingTime')+')';
			attribute<float64> CarTime            := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/CarTime')+')';
			attribute<float64> WalkingPrice       := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/WalkingPrice')+')';
			attribute<float64> CyclingPrice       := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/CyclingPrice')+')';
			attribute<float64> CarPrice           := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/CarPrice')+')';
			attribute<string>  Label      := OrgName +'_'+DestName, DialogType = "LabelText";
		}

		container LongFormat
		{
			unit<uint32> File_fullOD := Merged
			,	StorageName = "='%LocalDataProjDir%/Output/tt'+fileNameSuffix+'.csv'"
			,	StorageType = "gdalwrite.vect"
			{
				attribute<string>  OrgName            := Merged/OrgName;
				attribute<string>  DestName           := Merged/DestName;
				attribute<string>  DepTime            := Merged/DepTime;
				attribute<float64> Traveltime         := Merged/Traveltime;
				attribute<string>  ModeUsed           := Merged/ModeUsed;
				attribute<uint8>   NeedsCar           := Merged/NeedsCar;
				attribute<uint8>   NeedsBike          := Merged/NeedsBike;
				attribute<float64> Price              := Merged/Price;
				attribute<float64> WaitingTime        := Merged/WaitingTime;
				attribute<float64> PretransTime       := Merged/PretransTime;
				attribute<float64> PTTime             := Merged/PTTime;
				attribute<float64> PosttransTime      := Merged/PosttransTime;
				attribute<float64> PretransPrice      := Merged/PretransPrice;
				attribute<float64> PTPrice            := Merged/PTPrice;
				attribute<float64> PosttransPrice     := Merged/PosttransPrice;
				attribute<float64> TravelDist_V       := Merged/TravelDist_V;
				attribute<float64> TravelDist_PT      := Merged/TravelDist_PT;
				attribute<float64> TravelDist_N       := Merged/TravelDist_N;
				attribute<float64> TravelDist_Walking := Merged/TravelDist_Walking;
				attribute<float64> TravelDist_Cycling := Merged/TravelDist_Cycling;
				attribute<float64> TravelDist_Car     := Merged/TravelDist_Car;
				attribute<float64> WalkingTime        := Merged/WalkingTime;
				attribute<float64> CyclingTime        := Merged/CyclingTime;
				attribute<float64> CarTime            := Merged/CarTime;
				attribute<float64> WalkingPrice       := Merged/WalkingPrice;
				attribute<float64> CyclingPrice       := Merged/CyclingPrice;
				attribute<float64> CarPrice           := Merged/CarPrice;
			}
		}

		parameter<string> fileNameSuffix :=
			'_' + ModelParameters/Analysis_Date +
			'_ORG-' + ModelParameters/Advanced/OrgSet_string +
			ModelParameters/Advanced/PT_OutputFileTail;
	}
}
