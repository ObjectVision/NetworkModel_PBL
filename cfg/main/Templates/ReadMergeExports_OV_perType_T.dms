Template ReadMergeExports_OV_perType_T
{
	parameter<string> Export_CombinationTypes;
	parameter<string> Dest;
	//
	// Samenvoegen van de OV-uitvoer: eerst per vertrekmoment over alle herkomstblokken (Merge_Regions), dan over de
	// vertrekmomenten (Merge_Times). Sinds 2026-09-25 (audit 6.5) met de naamstaart van de schrijver en via GDAL; de
	// bestandsnaam van Merge_Times begint met 'tt_<datum>', zoals FindMedian (PostAnalysis) hem leest (tot dan 'tt__').

	container Read_Regions :=
		for_each_ne(
			Impl/OrgBlockDomain/name
			, 'Templates/ReadExport_OV_perTime_T('+quote(Export_CombinationTypes)+','+quote(Impl/OrgBlockDomain/name)+','+quote(Dest)+')'
		);

	container Merge_Regions :=
		for_each_ne(
			 Advanced/MeasureMoments/name
			, 'Templates/Merge_Regions_OV_T('+quote(Export_CombinationTypes)+','+quote( Advanced/MeasureMoments/name)+','+quote(Dest)+')'
		)
	{
		parameter<string>   OUTPUT_Merge_Regions  := 'Ready', ExplicitSuppliers = "=asList(Advanced/MeasureMoments/Name+'/LongFormat/File_fullOD',';')";
	}

	container Read_Times  := Templates/ReadExport_OV_perTime_T(Export_CombinationTypes,'All',Dest);
	container Merge_Times := Merge_Times_OV_T(Export_CombinationTypes,Dest);

	Template Merge_Times_OV_T
	{
		parameter<string> Export_CombinationTypes;
		parameter<string> Dest_str;
		//

		unit<uint32> Merged := ='union_unit('+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/domain')+')'
		{
			attribute<string>  OrgName    := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/OrgName')+')';
			attribute<string>  DestName   := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/DestName')+')';
			attribute<string>  DepTime    := ='union_data(.,'+asList('const('+quote(Advanced/MeasureMoments/Name)+',Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/domain)',',')+')';
			attribute<min_f>   Traveltime := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/Traveltime')+')';
			attribute<string>  ModeUsed   := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/ModeUsed')+')';
			attribute<string>  NeedsCar   := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/NeedsCar')+')';
			attribute<string>  NeedsBike  := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/NeedsBike')+')';
			attribute<string>  Price      := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/Price')+')';
			// Sinds 2026-10-02 ook de reistijd en de prijs per onderdeel, zoals in de bestanden per vertrekmoment.
			attribute<string>  WaitingTime    := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/WaitingTime')+')';
			attribute<string>  PretransTime   := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PretransTime')+')';
			attribute<string>  PTTime         := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PTTime')+')';
			attribute<string>  PosttransTime  := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PosttransTime')+')';
			attribute<string>  PretransPrice  := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PretransPrice')+')';
			attribute<string>  PTPrice        := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PTPrice')+')';
			attribute<string>  PosttransPrice := ='union_data(.,'+AsItemList('Read_Times/PerTime/'+Advanced/MeasureMoments/Name+'/data/PosttransPrice')+')';
			attribute<string>  Label      := OrgName +'_'+DestName, DialogType = "LabelText";
		}

		container LongFormat
		{
			unit<uint32> File_fullOD := Merged
			,	StorageName = "='%LocalDataProjDir%/Output/tt'+fileNameSuffix+'.csv'"
			,	StorageType = "gdalwrite.vect"
			{
				attribute<string> OrgName    := Merged/OrgName;
				attribute<string> DestName   := Merged/DestName;
				attribute<string> DepTime    := Merged/DepTime;
				attribute<string> Traveltime := MakeDefined(string(Merged/Traveltime), '');
				attribute<string> ModeUsed   := Merged/ModeUsed;
				attribute<string> NeedsCar   := Merged/NeedsCar;
				attribute<string> NeedsBike  := Merged/NeedsBike;
				attribute<string> Price      := Merged/Price;
				attribute<string> WaitingTime    := Merged/WaitingTime;
				attribute<string> PretransTime   := Merged/PretransTime;
				attribute<string> PTTime         := Merged/PTTime;
				attribute<string> PosttransTime  := Merged/PosttransTime;
				attribute<string> PretransPrice  := Merged/PretransPrice;
				attribute<string> PTPrice        := Merged/PTPrice;
				attribute<string> PosttransPrice := Merged/PosttransPrice;
			}
		}

		parameter<string> fileNameSuffix :=
			'_' + ModelParameters/Analysis_Date +
			'_ORG-' + ModelParameters/Advanced/OrgSet_string +
			ModelParameters/Advanced/PT_OutputFileTail;
	}
}
