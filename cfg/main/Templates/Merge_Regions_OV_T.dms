Template Merge_Regions_OV_T : Descr = "Merges the public transport output of all origin blocks for one departure moment into one csv file."
{
	parameter<string> Export_CombinationTypes;
	parameter<string> Time;
	parameter<string> Dest_str;
	//
	// Merges the public transport output of all origin blocks for a departure moment into <OutputDir>/tt_<date>_<moment>.csv, written with
	// GDAL, with the column names without the departure moment and with distance, travel time and price per category (PreTransport, PT,
	// PostTransport; walking, bike, car); GDAL writes the numbers without quotes and an empty value as an empty field (ReadExport_OV_perTime_T).
	parameter<string> inTime_str_short := rjoin(Time, ModelParameters/Impl/MeasureMoments/Name , ModelParameters/Impl/MeasureMoments/TemplatableTextShrt);

	unit<uint32> Merged := ='union_unit('+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/domain')+')'
	{
		attribute<string>  OrgName            := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/OrgName')+')';
		attribute<string>  DestName           := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/DestName')+')';
		attribute<float64> Traveltime         := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/Traveltime')+')';
		attribute<string>  ModeUsed           := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/ModeUsed')+')';
		attribute<uint8>   NeedsCar           := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/NeedsCar')+')';
		attribute<uint8>   NeedsBike          := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/NeedsBike')+')';
		attribute<float64> Price              := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/Price')+')';
		attribute<float64> WaitingTime        := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/WaitingTime')+')';
		attribute<float64> PretransTime       := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PretransTime')+')';
		attribute<float64> PTTime             := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PTTime')+')';
		attribute<float64> PosttransTime      := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PosttransTime')+')';
		attribute<float64> PretransPrice      := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PretransPrice')+')';
		attribute<float64> PTPrice            := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PTPrice')+')';
		attribute<float64> PosttransPrice     := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/PosttransPrice')+')';
		attribute<float64> TravelDist_V       := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_V')+')';
		attribute<float64> TravelDist_PT      := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_PT')+')';
		attribute<float64> TravelDist_N       := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_N')+')';
		attribute<float64> TravelDist_Walking := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_Walking')+')';
		attribute<float64> TravelDist_Cycling := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_Cycling')+')';
		attribute<float64> TravelDist_Car     := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/TravelDist_Car')+')';
		attribute<float64> WalkingTime        := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/WalkingTime')+')';
		attribute<float64> CyclingTime        := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/CyclingTime')+')';
		attribute<float64> CarTime            := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/CarTime')+')';
		attribute<float64> WalkingPrice       := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/WalkingPrice')+')';
		attribute<float64> CyclingPrice       := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/CyclingPrice')+')';
		attribute<float64> CarPrice           := ='union_data(.,'+AsItemList('Read_Regions/'+Impl/OrgBlockDomain/name+'/PerTime/'+Time+'/data/CarPrice')+')';
		attribute<string>  Label            := OrgName +'_'+DestName, DialogType = "LabelText";
	}

	container LongFormat
	{
		unit<uint32> File_fullOD := Merged
		,	StorageName = "=/NetworkSetup/GenerateOutput/Output_Sig/ForReading+'/tt'+fileNameSuffix+'.csv'"
		,	StorageType = "gdalwrite.vect"
		{
			attribute<string>  OrgName            := Merged/OrgName;
			attribute<string>  DestName           := Merged/DestName;
			attribute<float64> Traveltime         := Merged/Traveltime;
			attribute<string>  ModeUsed           := Merged/ModeUsed;
			attribute<uint8>   NeedsCar           := Merged/NeedsCar;
			attribute<uint8>   NeedsBike          := Merged/NeedsBike;
			attribute<float64> Price              := Merged/Price;
			attribute<float64> WaitingTime        := Merged/WaitingTime;
			attribute<float64> PretransTime       := Merged/PretransTime;
			attribute<float64> PTTime             := Merged/PTTime;
			attribute<float64> PosttransTime      := Merged/PosttransTime;
			attribute<float64> PretransPrice      := Merged/PretransPrice;
			attribute<float64> PTPrice            := Merged/PTPrice;
			attribute<float64> PosttransPrice     := Merged/PosttransPrice;
			attribute<float64> TravelDist_V       := Merged/TravelDist_V;
			attribute<float64> TravelDist_PT      := Merged/TravelDist_PT;
			attribute<float64> TravelDist_N       := Merged/TravelDist_N;
			attribute<float64> TravelDist_Walking := Merged/TravelDist_Walking;
			attribute<float64> TravelDist_Cycling := Merged/TravelDist_Cycling;
			attribute<float64> TravelDist_Car     := Merged/TravelDist_Car;
			attribute<float64> WalkingTime        := Merged/WalkingTime;
			attribute<float64> CyclingTime        := Merged/CyclingTime;
			attribute<float64> CarTime            := Merged/CarTime;
			attribute<float64> WalkingPrice       := Merged/WalkingPrice;
			attribute<float64> CyclingPrice       := Merged/CyclingPrice;
			attribute<float64> CarPrice           := Merged/CarPrice;
		}
	}

	parameter<string> fileNameSuffix :=
		'_' + ModelParameters/Impl/Analysis_date +
		'_' + inTime_str_short;
}
