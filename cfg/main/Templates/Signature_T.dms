// Names of stores and output (NetworkModel_PBL#118).
//
// The name of a store or output folder holds only what must be readable (date, time window or departure moment, origin and destination
// set, block), and for the caches a hash of 8 characters over the signature: the text with all parameters that determine the content.
// For a store the name is the cache key: a store that exists is read. Putting all those parameters in the name itself would bring the
// longest path close to the 259 characters Windows allows. The signature is in signature.txt in the folder of the store or output.
// A writer writes it when it is not there yet and refuses to write when another one is there; a reader refuses to read when it is
// missing or different. A hash collision thus gives an error instead of silently a wrong store.

// Polynomial hash of a text: the sum over the characters of code(character) x 16807^position, modulo 2^31 - 1, as 8 hexadecimal characters.
// GeoDMS has no string hash; this one uses only plain integer arithmetic, so it is stable across versions and platforms, which a cache key
// needs. code(character) is the position in Alphabet plus 1, and 0 for a character that is not in it (the signatures consist of letters,
// digits and punctuation; the single quote and the backslash cannot be written in a GeoDMS text without escape and do not occur). 16807
// is a primitive root modulo 2^31 - 1, so the powers are distinct; two different texts of n characters collide with a probability of
// order n / 2^31. The powers follow from the bits of the position (B1 up to B1024), so that everything can be calculated per element;
// hence at most 2047 characters. A Python implementation of the same formula gives 57154c6e for 'Ab_9-x,=;'.
Template StringHash_T : Descr = "Calculates a hash of 8 hexadecimal characters over Text, for short names of stores and output folders."
{
	parameter<string> Text;
	///
	parameter<string> Alphabet  := ' !"#$%&()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~';
	parameter<uint64> P         := uint64(2147483647), Descr = "2^31 - 1, a prime.";
	parameter<uint64> B         := uint64(16807);
	unit<uint32> Chars := range(uint32, 0, strlen(Alphabet))
	{
		attribute<string> Char := substr(const(Alphabet, .), id(.), 1);
	}
	parameter<uint64> B1    := B;
	parameter<uint64> B2    := B1   * B1   % P;
	parameter<uint64> B4    := B2   * B2   % P;
	parameter<uint64> B8    := B4   * B4   % P;
	parameter<uint64> B16   := B8   * B8   % P;
	parameter<uint64> B32   := B16  * B16  % P;
	parameter<uint64> B64   := B32  * B32  % P;
	parameter<uint64> B128  := B64  * B64  % P;
	parameter<uint64> B256  := B128 * B128 % P;
	parameter<uint64> B512  := B256 * B256 % P;
	parameter<uint64> B1024 := B512 * B512 % P;
	unit<uint32> Pos := range(uint32, 0, strlen(Text))
	{
		attribute<string> Char := substr(const(Text, .), id(.), 1);
		attribute<uint64> Code := uint64(MakeDefined(rlookup(Char, Chars/Char) + 1, 0));
		attribute<uint64> W0   :=      ((id(.) /    1) % 2 == 1 ? B1    : uint64(1));
		attribute<uint64> W1   := W0 * ((id(.) /    2) % 2 == 1 ? B2    : uint64(1)) % P;
		attribute<uint64> W2   := W1 * ((id(.) /    4) % 2 == 1 ? B4    : uint64(1)) % P;
		attribute<uint64> W3   := W2 * ((id(.) /    8) % 2 == 1 ? B8    : uint64(1)) % P;
		attribute<uint64> W4   := W3 * ((id(.) /   16) % 2 == 1 ? B16   : uint64(1)) % P;
		attribute<uint64> W5   := W4 * ((id(.) /   32) % 2 == 1 ? B32   : uint64(1)) % P;
		attribute<uint64> W6   := W5 * ((id(.) /   64) % 2 == 1 ? B64   : uint64(1)) % P;
		attribute<uint64> W7   := W6 * ((id(.) /  128) % 2 == 1 ? B128  : uint64(1)) % P;
		attribute<uint64> W8   := W7 * ((id(.) /  256) % 2 == 1 ? B256  : uint64(1)) % P;
		attribute<uint64> W9   := W8 * ((id(.) /  512) % 2 == 1 ? B512  : uint64(1)) % P;
		attribute<uint64> W    := W9 * ((id(.) / 1024) % 2 == 1 ? B1024 : uint64(1)) % P, Descr = "16807^position modulo P.";
		attribute<uint64> Term := Code * W;
	}
	parameter<uint32> Value     := uint32(sum(Pos/Term) % P), IntegrityCheck = "strlen(Text) < 2048";
	parameter<string> HexDigits := '0123456789abcdef';
	parameter<string> Hex       :=
		  substr(HexDigits, (Value / 268435456) % 16, 1) + substr(HexDigits, (Value / 16777216) % 16, 1)
		+ substr(HexDigits, (Value /   1048576) % 16, 1) + substr(HexDigits, (Value /    65536) % 16, 1)
		+ substr(HexDigits, (Value /      4096) % 16, 1) + substr(HexDigits, (Value /      256) % 16, 1)
		+ substr(HexDigits, (Value /        16) % 16, 1) + substr(HexDigits,  Value             % 16, 1)
	,	Descr = "The hash as 8 hexadecimal characters, for use in the name of a store.";
}

// The signature of a store or output folder: writing, reading and checking it, plus the path length check beforehand.
// - A writer includes ForWriting in its ExplicitSuppliers. If SignatureFile does not exist, ForWriting writes it with Signature; if it
//   exists, it must equal Signature. The longest path (PathLength) must also stay within ModelParameters/Advanced/MaxPathLength, so that
//   a path that is too long fails before anything is calculated.
// - A reader builds its StorageName with ForReading: that is Path if SignatureFile exists and equals Signature, and an error otherwise.
// Writing must go through ExplicitSuppliers: a StorageName expression does calculate Written, but does not write the file. And the
// IntegrityCheck is on a supplier (EnsureGate, CheckGate) and not on the item in the StorageName expression, because only then does a
// mismatch stop the reading.
Template Signature_T : Descr = "Writes, reads and checks the signature of a store or output folder, and checks the path length beforehand."
{
	parameter<string> Path;             // the store or folder that the signature protects, with %LocalDataProjDir%
	parameter<string> SignatureFile;    // the text file with the signature
	parameter<string> Signature;        // the signature of the current parameters
	parameter<uint32> MaxSubPathLength; // the length of the longest part after Path: the files in the store or folder
	///
	parameter<uint32> PathLength := strlen(expand(., Path)) + MaxSubPathLength
	,	Descr = "Length of the longest file path in the store or folder; Windows allows 259 characters (ModelParameters/Advanced/MaxPathLength).";
	parameter<bool>   Exists     := ExistingFile('', expand(., SignatureFile)) != '';
	parameter<string> Written    := Signature, StorageName = "=SignatureFile", StorageType = "str"
	,	Descr = "Writes the signature; only through IsEnsured, when SignatureFile does not exist yet.";
	parameter<string> Stored     : StorageName = "=SignatureFile", StorageType = "str", StorageReadOnly = "true"
	,	Descr = "The signature as it is in SignatureFile.";
	parameter<bool>   IsEnsured  := = Exists ? 'Stored == Signature' : 'Written == Signature';
	parameter<bool>   IsChecked  := = Exists ? 'Stored == Signature' : 'false';
	parameter<string> PathGate   := PathLength <= /ModelParameters/Advanced/MaxPathLength ? 'ok' : 'te lang'
	,	IntegrityCheck = "PathLength <= /ModelParameters/Advanced/MaxPathLength"
	,	Descr = "Fails when the longest path (PathLength) is longer than Windows allows; then make LocalDataDir or OutputLabel shorter.";
	parameter<string> EnsureGate := IsEnsured ? 'ok' : 'andere handtekening'
	,	IntegrityCheck = "IsEnsured"
	,	Descr = "Fails when SignatureFile holds another signature than Signature (Stored against Signature): for output choose another OutputLabel or empty the output folder (batch/UpdateAll.cmd output does that), for a cache it means a hash collision or a file changed by hand.";
	parameter<string> CheckGate  := IsChecked ? 'ok' : 'geen of andere handtekening'
	,	IntegrityCheck = "IsChecked"
	,	Descr = "Fails when SignatureFile is missing or holds another signature than Signature (Stored against Signature): the store or output was not made, or made with other parameters, so make it first or restore the parameters.";
	parameter<string> ForWriting := PathGate == 'ok' && EnsureGate == 'ok' ? Path : ''
	,	Descr = "For the ExplicitSuppliers of a writer: writes the signature when it is not there yet, and fails on a path that is too long or on another signature.";
	parameter<string> ForReading := CheckGate == 'ok' ? Path : ''
	,	Descr = "For the StorageName of a reader: Path, or an error when the signature is missing or different.";
}
