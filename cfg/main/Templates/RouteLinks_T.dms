// THE LINKS OF ROUTES (#129; only in the OD pair mode, ModelParameters/Impl/IsOD): from the LinkSet of an impedance_matrix, per route
// the links in the order of the trip, with the node where each link begins and ends, and per route a line along those nodes. The LinkSet
// runs from the end of the route to its start (GeoDMS, Dijkstra.cpp WriteLinkSets); Volgnr counts from the start. A link ends in the node it
// shares with the next link; the last link ends in EndNode, the end node of the route. This way the direction is also right on a two-way
// network, where F1 and F2 say nothing about the driving direction.
Template RouteLinks_T : Descr = "Lists the links of each route of an impedance_matrix in the order of the trip, with the node where each link begins and ends, and draws a line per route (#129)."
{
	unit<uint64>      Routes;
	attribute<uint32> LinkSet   (arc, Routes);
	unit<uint32>      Links;
	unit<uint32>      Nodes;
	attribute<Nodes>  F1        (Links);
	attribute<Nodes>  F2        (Links);
	attribute<rdc>    NodePoint (Nodes);
	attribute<Nodes>  EndNode   (Routes);
	///
	unit<uint32> Rows := sequence2points(LinkSet)
	, Descr = "One row per link of a route, in the order of the LinkSet, from the end of the route to its start."
	{
		attribute<Routes> Route_rel     := Sequence_rel;
		attribute<Links>  Link_rel      := value(point, Links);
		attribute<uint32> NrLinks       := pcount_uint32(Route_rel)[Route_rel];
		attribute<uint32> Volgnr        := NrLinks - 1 - Ordinal, Descr = "The position of the link in the trip, counted from 0.";
		attribute<.>      Volgende_rel  := Ordinal > 0 ? value(sub_or_null(id(.), 1u), .) : value(null_u, .), Descr = "The link that follows in the trip: the previous row, because the LinkSet runs backwards.";
		attribute<Nodes>  A             := F1[Link_rel];
		attribute<Nodes>  B             := F2[Link_rel];
		attribute<Nodes>  EindKnoop     := Ordinal == 0 ? EndNode[Route_rel] : (A == A[Volgende_rel] || A == B[Volgende_rel] ? A : B), Descr = "The node where the trip leaves the link: the node it shares with the next link, or EndNode for the last link.";
		attribute<Nodes>  BeginKnoop    := A == EindKnoop ? B : A, Descr = "The node where the trip enters the link.";
		attribute<bool>   IsVooruit     := B == EindKnoop, Descr = "Does the trip run over the link from F1 to F2?";
		attribute<rdc>    geometry (arc) := points2sequence(LinkPunten/Point, LinkPunten/Rij_rel, LinkPunten/Ordinal), Descr = "A straight line from the begin node to the end node of the link.";

		unit<uint32> LinkPunten := union_unit(., .)
		{
			attribute<..>     Rij_rel  := union_data(., id(..), id(..));
			attribute<rdc>    Point    := union_data(., NodePoint[../BeginKnoop], NodePoint[../EindKnoop]);
			attribute<uint32> Ordinal  := union_data(., const(0, .., uint32), const(1, .., uint32));
		}
	}
	// The line per route: the begin node of the first link, then the end node of each link.
	unit<uint32> Eerste := select_with_org_rel(Rows/Volgnr == 0);
	unit<uint32> RoutePunten := union_unit(Eerste, Rows)
	{
		attribute<Routes> Route_rel := union_data(., Rows/Route_rel[Eerste/org_rel], Rows/Route_rel);
		attribute<rdc>    Point     := union_data(., NodePoint[Rows/BeginKnoop[Eerste/org_rel]], NodePoint[Rows/EindKnoop]);
		attribute<uint32> Ordinal   := union_data(., const(0, Eerste, uint32), Rows/Volgnr + 1);
	}
	attribute<rdc> geometry (arc, Routes) := points2sequence(RoutePunten/Point, RoutePunten/Route_rel, RoutePunten/Ordinal);
}

// The placeholder for RouteLinks_T outside the OD pair mode: the searches then do not request a LinkSet.
Template GeenRouteLinks_T
{
	parameter<string> Toelichting := 'Links worden alleen bijgehouden in de HB-paarmodus (ModelParameters/Impl/IsOD).';
}
