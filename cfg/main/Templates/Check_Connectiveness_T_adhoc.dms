Template Check_Connectiveness_T_adhoc : Descr = "A variant of Check_Connectiveness_T without geometry for the unconnected nodes; CreateNetwork_Efficient_T uses it on its final link set."
{
	unit<uint32> LinkSet_domain;
	unit<uint32> NodeSet_domain;
	attribute<NodeSet_domain> F1 (LinkSet_domain);
	attribute<NodeSet_domain> F2 (LinkSet_domain);
	///
	
	attribute<bool> IsInMainNetwork (LinkSet_domain) := Networks/IsConnected[F1] && Networks/IsConnected[F2], Descr = "Is the link part of the relevant network, with both its nodes in Main?";
	unit<uint32> Networks := connected_parts(LinkSet_domain/F1, LinkSet_domain/F2) // The set of all networks, including the subnetworks.
	{
		attribute<uint32>   Nr_Nodes                     := pcount(part_rel);
		parameter<Networks> Main                         := max_index(Nr_Nodes); // assumption: the network with the most nodes is the relevant network
		attribute<bool>     IsConnected (NodeSet_domain) := part_rel == Main;
	}

	unit<uint32> NodesNotConnected := select_with_org_rel(!Networks/Isconnected)
	{
	}
}

