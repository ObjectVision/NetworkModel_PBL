Template ReadExport_OV_perTime_T : Descr = "Reads the public transport output of one origin block, or the output merged over all blocks, for every departure moment (PerTime)."
{
	parameter<string> Export_CombinationTypes;
	parameter<string> Org_str;
	parameter<string> Dest_str;
	///
	// Reads the public transport output of an origin block (Org_str = block) or the output merged per departure moment (Org_str = 'All'),
	// from ModelParameters/Impl/OutputDir (NetworkModel_PBL#118), with only date, departure moment and block in the name, and only if the
	// signature of that folder matches (NetworkSetup/GenerateOutput/Output_Sig/ForReading). It uses the file names and column names of the
	// writer, reads Price only when the file has that column (without Export_PriceInformation it does not), and reads through GDAL instead
	// of as one string, because a departure moment merged over all blocks has tens of millions of rows.
	parameter<bool> IsRegionMerged := Org_str == 'All', Descr = "Is this the output merged over all origin blocks (Org_str = 'All')?";

	container PerTime :=
		for_each_ne(
			ModelParameters/Impl/MeasureMoments/name
			, 'ReadCSV_T('+quote(ModelParameters/Impl/MeasureMoments/name)+')'
		);

	Template ReadCSV_T
	{
		parameter<string> Time;
		///
		parameter<string> inTime_str_short := rjoin(Time, ModelParameters/Impl/MeasureMoments/Name , ModelParameters/Impl/MeasureMoments/TemplatableTextShrt);
		parameter<string> fileNamePrefix   := /NetworkSetup/GenerateOutput/Output_Sig/ForReading + (IsRegionMerged ? '/' : '/PerBlock/');
		parameter<string> fileNameSuffix   := // per block without the date, like PerDepartureMoment_T
			(IsRegionMerged ? '_' + ModelParameters/Impl/Analysis_date : '') +
			'_' + inTime_str_short +
			(IsRegionMerged ? '' : '_' + rjoin(Org_str, /NetworkSetup/Impl/OrgBlockDomain/name, /NetworkSetup/Impl/OrgBlockDomain/FileName));
		parameter<string> filename         := fileNamePrefix + 'tt' + fileNameSuffix + '.csv';
		parameter<string> ColSuffix        := IsRegionMerged ? '' : '_' + inTime_str_short, Descr = "The output per block puts the departure moment in the column names, the merged output puts it in the file name.";

		unit<uint32> domain
		:	StorageName     = "=filename"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "true";
		unit<uint32> field := SubItem_PropValues(domain, 'name');

		container data
		{
			// The numbers are read as float64 and the ownership criteria as uint8, not as text: that saves most memory when merging, and float64
			// writes the text of the output per block back unchanged (7.35 stays 7.35). A column the file does not have becomes empty: Price and
			// the price parts without Export_PriceInformation, the distances without Export_TravelledDistance, and the columns that output of an
			// older model version lacks.
			attribute<string>  OrgName            (domain) := domain/OrgName;
			attribute<string>  DestName           (domain) := domain/DestName;
			attribute<string>  OrgDestName        (domain) := OrgName + '_' + DestName;
			attribute<string>  ModeUsed           (domain) := ='domain/ModeUsed' + ColSuffix;
			attribute<uint8>   NeedsCar           (domain) := =IsDefined(rlookup('NeedsCar' + ColSuffix, field/name)) ? 'uint8(domain/NeedsCar' + ColSuffix + ')' : 'const(null_b, domain, uint8)';
			attribute<uint8>   NeedsBike          (domain) := =IsDefined(rlookup('NeedsBike' + ColSuffix, field/name)) ? 'uint8(domain/NeedsBike' + ColSuffix + ')' : 'const(null_b, domain, uint8)';
			attribute<float64> Traveltime         (domain) := =IsDefined(rlookup('Traveltime' + ColSuffix, field/name)) ? 'float64(domain/Traveltime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> Price              (domain) := =IsDefined(rlookup('Price' + ColSuffix, field/name)) ? 'float64(domain/Price' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> WaitingTime        (domain) := =IsDefined(rlookup('WaitingTime' + ColSuffix, field/name)) ? 'float64(domain/WaitingTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PretransTime       (domain) := =IsDefined(rlookup('PretransTime' + ColSuffix, field/name)) ? 'float64(domain/PretransTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PTTime             (domain) := =IsDefined(rlookup('PTTime' + ColSuffix, field/name)) ? 'float64(domain/PTTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PosttransTime      (domain) := =IsDefined(rlookup('PosttransTime' + ColSuffix, field/name)) ? 'float64(domain/PosttransTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PretransPrice      (domain) := =IsDefined(rlookup('PretransPrice' + ColSuffix, field/name)) ? 'float64(domain/PretransPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PTPrice            (domain) := =IsDefined(rlookup('PTPrice' + ColSuffix, field/name)) ? 'float64(domain/PTPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> PosttransPrice     (domain) := =IsDefined(rlookup('PosttransPrice' + ColSuffix, field/name)) ? 'float64(domain/PosttransPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_V       (domain) := =IsDefined(rlookup('TravelDist_V' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_V' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_PT      (domain) := =IsDefined(rlookup('TravelDist_PT' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_PT' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_N       (domain) := =IsDefined(rlookup('TravelDist_N' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_N' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_Walking (domain) := =IsDefined(rlookup('TravelDist_Walking' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_Walking' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_Cycling (domain) := =IsDefined(rlookup('TravelDist_Cycling' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_Cycling' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> TravelDist_Car     (domain) := =IsDefined(rlookup('TravelDist_Car' + ColSuffix, field/name)) ? 'float64(domain/TravelDist_Car' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> WalkingTime        (domain) := =IsDefined(rlookup('WalkingTime' + ColSuffix, field/name)) ? 'float64(domain/WalkingTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> CyclingTime        (domain) := =IsDefined(rlookup('CyclingTime' + ColSuffix, field/name)) ? 'float64(domain/CyclingTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> CarTime            (domain) := =IsDefined(rlookup('CarTime' + ColSuffix, field/name)) ? 'float64(domain/CarTime' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> WalkingPrice       (domain) := =IsDefined(rlookup('WalkingPrice' + ColSuffix, field/name)) ? 'float64(domain/WalkingPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> CyclingPrice       (domain) := =IsDefined(rlookup('CyclingPrice' + ColSuffix, field/name)) ? 'float64(domain/CyclingPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
			attribute<float64> CarPrice           (domain) := =IsDefined(rlookup('CarPrice' + ColSuffix, field/name)) ? 'float64(domain/CarPrice' + ColSuffix + ')' : 'const(null_d, domain, float64)';
		}
	}
}
