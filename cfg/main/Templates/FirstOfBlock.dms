// THE FIRST TRIP OF EACH BLOCK AMONG THE TRIPS THAT RUN (#171). The thinning of the flex options keeps per trip pattern and block of
// ModelParameters/Advanced/FlexMinInterval only the trip that departs first. This function compares only the trips that run (Runs), so
// it gives the thinning of one service day: LoadFeeds/FlexOptions calls it for D-1, D and D+1, and Output/PT_NetworkExport for the days
// around its own ExportDay, so that the export marks the same trips as the model.
function FirstOfBlock(
	unit<uint32>      Trips;
	unit<uint32>      Blocks;
	attribute<Blocks> Block_rel (Trips);
	attribute<uint32> StartSec  (Trips);
	attribute<bool>   Runs      (Trips)
)
-> attribute<bool> (Trips) := IsFirst
{
	attribute<Trips> First   (Blocks) := min_index(Runs ? StartSec : null_u, Block_rel), Descr = "Per block the trip that runs and departs first, with equal departure times the first in Trips; null for a block without a trip that runs.";
	attribute<bool>  IsFirst (Trips)  := First[Block_rel] == id(Trips), Descr = "Is the trip the first of its block? False for a trip that does not run.";
}
