container Classifications: Using = "Units"
{
	unit<uint32> Transfer_Directions : NrOfRows = 5
	{
		attribute<string> Label    : ['Top', 'Right', 'Bottom', 'Left', 'Centre'];
		attribute<int16>  row      : [0,1,0,-1,0];
		attribute<int16>  col      : [1,0,-1,0,0];
		attribute<spoint> geometry := point_xy(row, col, spoint);
	}
	
	container Chains
	{
		parameter<uint16> max_Chains     := ModelParameters/Max_transfers + 1w;
		
		unit<uint16> Chain_range := range(0w, ModelParameters/Max_transfers)
		{
			attribute<string> name      := 'r'+string(id(.)+1w);
			attribute<string> prev_name := MakeDefined(name[sub_or_null(id(.),1w)]+'/Result','FareGroup');
		}
		
		unit<uint16> FareGroup := range(0w, 2w)
		{
			attribute<string> name          : ['R', 'L'];
			attribute<string> left          := name;
			attribute<string> right         := const('', .);
			attribute<string> transfer_name := const('xxx', .);
		}

		container Generate_Chain_Range :=
			for_each_ne(
				Chain_range/name
				, 'Chain_T('+Chain_range/prev_name+')'
			)
		{
			container r0
			{
				unit<uint16> Result := FareGroup;
			}
		}
		
		Template Chain_T
		{
			unit<uint16> Prev;
			///
			unit<uint16> Result := combine_uint16(Prev, FareGroup), Descr = "*"
			{
				attribute<string> name := Prev/name[first_rel] + FareGroup/Name[second_rel];
			}
		}
		
		unit<uint16> Chain := ='union_unit_uint16(FareGroup, '+asList('Generate_Chain_Range/'+Chain_range/name+'/Result', ',')+')'
		{
			attribute<string> name                 := ='union_data(.,FareGroup/name, '+asList('Generate_Chain_Range/'+Chain_range/name+'/Result/name', ',')+')';
			attribute<string> label                := name;
			attribute<uint32> chain_breakpoint_pos := strlen(name) <= 2 ? 1 : sub_or_null(strlen(name),1); // from the left
			
			attribute<string> left                 := left(name, chain_breakpoint_pos);
			attribute<string> right                := right(name, strlen(name) - chain_breakpoint_pos);
			attribute<string> transfer_name        := 'Transfers_'+right(left, 1)+'_'+left(right, 1);
			
			attribute<uint32> pos_first_R          := strpos(name, 'R');
		}
		
		//NOTE: this could later fail due to missing indirect calculated needs. 
		unit<uint16>      ToBeCalculated := Chain , Descr = "All chains needed to build longer chains or to choose trips from.";
		unit<uint16>      Allowed        := Chain , Descr = "The chains without those from which no trips can be composed.";
	}
	
	
	unit<uint8> TimeInvariantTypes := combine_uint8(TimeInvariant_ConnectionTypes, TimeInvariant_Modes)
	{
		attribute<string> ConnectionType := TimeInvariant_ConnectionTypes/name[first_rel];
		attribute<string> Mode           := TimeInvariant_Modes/Name[second_rel];
		attribute<string> Mode_abbrev    := TimeInvariant_Modes/Name_abbrev[second_rel];
		attribute<string> NetworkType    := TimeInvariant_Modes/NetworkType[second_rel];
		attribute<string> OriginSet      := TimeInvariant_ConnectionTypes/OriginSet[first_rel];
		attribute<string> DestinationSet := TimeInvariant_ConnectionTypes/DestinationSet[first_rel];
		attribute<string> VN_Transport   := TimeInvariant_ConnectionTypes/VN_Transport[first_rel];
		attribute<string> StopClass      := TimeInvariant_ConnectionTypes/StopClass[first_rel];
		attribute<string> Label          := ConnectionType + '_' + Mode;
		attribute<string> Name           := AsItemName(label);
		attribute<string> Name_short     := ConnectionType + '_' + Mode_abbrev;
		attribute<GTFS_Modes/Selection> Mode_rel := rlookup(Mode_Abbrev, GTFS_Modes/Selection/name_abbr);
		attribute<bool>   IsOVfiets      := lowercase(StopClass) == lowercase('OVf');
		attribute<bool>   NeedsOwnBike   := Mode_abbrev == 'C' && NOT(IsOVfiets), Descr = "Does this leg need an own bike (NetworkModel_PBL#117): yes for cycling, also in the PostTransport with an own bike at the last stop, except with a rented OV-fiets.";
		attribute<min_f>  MaxTime        := ='union_data(.,'+asList('ModelParameters/' + (Mode == 'Walking' && ConnectionType != 'Org2Stops' && ConnectionType != 'Stops2Dest' ? 'Advanced/' : '') + 'Max'+Mode+'Time_'+ConnectionType, ',')+')';
		
		
		container         V              := for_each_nedv(Name, String(ID(.))+'[..]', void, .);
	}
	
	unit<uint32> TimeInvariant_ConnectionTypes : NrOfRows = 8
	, Descr = "RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station"
	{
		unit<uint32> Matrix := Range(uint32, 0, nrAttr*#.)
		{
			attribute<string> Values :
			[
			//from      , to            , V/N, TypeClassname
			'Org'       , 'Stops'       ,'V', '',
			'Stops'     , 'Dest'        ,'N', '',
			'Org'       , 'RMT_Stops'   ,'V', 'RMT', //RMT_Stops=Rail+Metro+Tram
			'Org'       , 'RM_Stops'    ,'V', 'RM',  //RM_Stops=Rail+Metro
			'OVF_Stops' , 'Dest'        ,'N', 'OVf', //OVF_Stops=OV-fiets stops
			'RMT_Stops' , 'Dest'        ,'N', 'RMT', //RMT_Stops=Rail+Metro+Tram
			'Org'       , 'Ric_Stops'   ,'V', 'Ric', //IC_Stops=IC_station_stops
			'RM_Stops'  , 'Dest'        ,'N', 'RM'   //RM_Stops=Rail+Metro, PostTransport RM_C; last, so that the existing types keep their number
			];
		}
		
		// Chains: https://github.com/ObjectVision/NetworkModel_PBL/issues/31
		
		attribute<string> OriginSet      := Matrix/Values[value(id(.)* nrAttr + 0, Matrix)];
		attribute<string> DestinationSet := Matrix/Values[value(id(.)* nrAttr + 1, Matrix)];
		attribute<string> VN_Transport   := Matrix/Values[value(id(.)* nrAttr + 2, Matrix)];
		attribute<string> StopClass      := Matrix/Values[value(id(.)* nrAttr + 3, Matrix)];
		attribute<string> Label          := OriginSet + '2' + DestinationSet;
		attribute<string> Name           := AsItemName(label);
		parameter<uint32> nrAttr         := 4;
	}
	
	
	
	unit<uint8> TimeInvariant_Modes : NrOfRows = 2
	{
		attribute<string> Label       : ['Walking', 'Cycling'];
		attribute<string> Name_abbrev : ['W','C'];
		attribute<string> Name        := AsItemName(label);
		attribute<string> NetworkType : ['Walking', 'Cycling'];
	}
	
	unit<uint8> VN_ModeClasses := union_unit_uint8(/ModelParameters/Impl/PT_PreTransport_Types,/ModelParameters/Impl/PT_PostTransport_Types)
	{
		attribute<string> name         := union_data(., ModelParameters/Impl/PT_PreTransport_Types/ExportName, ModelParameters/Impl/PT_PostTransport_Types/ExportName);
		attribute<TimeInvariantTypes> TimeInvariantTypes_rel := union_data(., ModelParameters/Impl/PT_PreTransport_Types/TimeInvariantTypes_rel, ModelParameters/Impl/PT_PostTransport_Types/TimeInvariantTypes_rel);
		attribute<bool>   NeedsBike    := TimeInvariantTypes/NeedsOwnBike[TimeInvariantTypes_rel];
		attribute<uq>     uq_rel       := rlookup(name, uq/values);

		unit<uint8> uq := unique_uint8(name)
		{
			attribute<string> name      := values;
			attribute<string> label     := values;
			attribute<bool>   NeedsBike := any(VN_ModeClasses/NeedsBike, VN_ModeClasses/uq_rel), Descr = "Does a pre- or post-transport leg of this class need an own bike (NetworkModel_PBL#117)?";
		}
		parameter<bool>   AnyNeedsBike := any(uq/NeedsBike), Descr = "Does any of the pre- or post-transport types need an own bike; if not, no public transport chain needs a bike.";
	}

	// COMPONENTS (#117): a component is a direct trip (WW, CC or Car) or a public transport trip <pre-transport>_PT_<post-transport>,
	// with a type from PreTransportTypes and one from PostTransportTypes; all 25 combinations exist. The switches of the variant in
	// ModelParameters (PreTransport, PostTransport, DirectWalking, DirectCycling, DirectCar) select the components (Selected), and a
	// GeoDmsRun step calculates one of them (Impl/ComponentName). Merging is not a component but a step that merges the selected
	// components, with car and bike ownership as criteria.
	unit<uint8> PreTransportTypes : nrofrows = 5
	, Descr = "The pre-transport types of the public transport components: walking to every stop (W), cycling to every stop (C), to a rail or metro stop (C_RM), to a rail, metro or tram stop (C_RMT) or to an intercity station (C_Ric)."
	{
		attribute<string> name             : ['Org2Stops_Walking', 'Org2Stops_Cycling', 'Org2RM_Stops_Cycling', 'Org2RMT_Stops_Cycling', 'Org2Ric_Stops_Cycling'], IntegrityCheck = "IsDefined(rlookup(this, /Classifications/TimeInvariantTypes/name))";
		attribute<uint32> BlocksPerPortion : [50, 25, 25, 25, 25], Descr = "Origin blocks per GeoDmsRun in the output step (batch/WriteOutputBlocks.ps1) of the public transport components with this pre-transport: smaller portions use less memory, 0 puts all blocks in one portion.";
		attribute</Classifications/TimeInvariantTypes> TimeInvariantTypes_rel := rlookup(name, /Classifications/TimeInvariantTypes/name);
		attribute<string> code             := /Classifications/TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel] + (/Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] != '' ? '_' + /Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] : ''), Descr = "W, C, C_RM, C_RMT or C_Ric, as in ModeUsed.";
		attribute<bool>   Selected         := ='union_data(., ' + asList('/ModelParameters/PreTransport/' + name, ', ') + ')', Descr = "Is the type on in the variant (ModelParameters/PreTransport, a switch per name)?";
	}
	unit<uint8> PostTransportTypes : nrofrows = 5
	, Descr = "The post-transport types of the public transport components: walking (W), cycling from every stop (C), from a rail or metro stop (RM_C), from a rail, metro or tram stop (RMT_C), or the OV-fiets (OVf_C) from a stop at an OV-fiets location."
	{
		attribute<string> name : ['Stops2Dest_Walking', 'Stops2Dest_Cycling', 'RM_Stops2Dest_Cycling', 'RMT_Stops2Dest_Cycling', 'OVF_Stops2Dest_Cycling'], IntegrityCheck = "IsDefined(rlookup(this, /Classifications/TimeInvariantTypes/name))";
		attribute</Classifications/TimeInvariantTypes> TimeInvariantTypes_rel := rlookup(name, /Classifications/TimeInvariantTypes/name);
		attribute<string> code := (/Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] != '' ? /Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] + '_' : '') + /Classifications/TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel], Descr = "W, C, RM_C, RMT_C or OVf_C, as in ModeUsed.";
		attribute<bool>   Selected := ='union_data(., ' + asList('/ModelParameters/PostTransport/' + name, ', ') + ')', Descr = "Is the type on in the variant (ModelParameters/PostTransport, a switch per name)?";
	}
	unit<uint8> PT_Components := combine_uint8(PreTransportTypes, PostTransportTypes)
	, Descr = "The public transport components: every combination of a pre- and a post-transport type."
	{
		attribute<string> name             := PreTransportTypes/code[first_rel] + '_PT_' + PostTransportTypes/code[second_rel];
		attribute<string> PreTransport     := PreTransportTypes/name[first_rel];
		attribute<string> PostTransport    := PostTransportTypes/name[second_rel];
		attribute<uint32> BlocksPerPortion := PreTransportTypes/BlocksPerPortion[first_rel];
		attribute<bool>   NeedsBike        := /Classifications/TimeInvariantTypes/NeedsOwnBike[PreTransportTypes/TimeInvariantTypes_rel[first_rel]] || /Classifications/TimeInvariantTypes/NeedsOwnBike[PostTransportTypes/TimeInvariantTypes_rel[second_rel]], Descr = "Does the component need an own bike, cycling in the pre-transport or in the post-transport other than the OV-fiets?";
		attribute<bool>   UsesCycling      := /Classifications/TimeInvariantTypes/NetworkType[PreTransportTypes/TimeInvariantTypes_rel[first_rel]] == 'Cycling' || /Classifications/TimeInvariantTypes/NetworkType[PostTransportTypes/TimeInvariantTypes_rel[second_rel]] == 'Cycling', Descr = "Does the component use the cycling network, in pre- or post-transport, the OV-fiets included?";
		attribute<bool>   Selected         := PreTransportTypes/Selected[first_rel] && PostTransportTypes/Selected[second_rel], Descr = "Is the component in the variant: are both its pre- and its post-transport type on?";
	}
	unit<uint8> DirectComponents : nrofrows = 3
	, Descr = "The direct trips as components: WW walking, CC cycling and Car (AA in ModeUsed)."
	{
		attribute<string> name          : ['WW', 'CC', 'Car'];
		attribute<bool>   DirectWalking : [TRUE, FALSE, FALSE];
		attribute<bool>   DirectCycling : [FALSE, TRUE, FALSE];
		attribute<bool>   DirectCar     : [FALSE, FALSE, TRUE];
		// one switch per element, in the order of name
		attribute<bool>   Selected      := union_data(., /ModelParameters/DirectWalking, /ModelParameters/DirectCycling, /ModelParameters/DirectCar), Descr = "Is the direct trip in the variant (ModelParameters/DirectWalking, DirectCycling, DirectCar)?";
	}
	unit<uint8> Components := union_unit_uint8(DirectComponents, PT_Components)
	, Descr = "All components, of which the switches of the variant select some (Selected): the direct trips and the public transport components (#117)."
	{
		attribute<string> name                      := union_data(., DirectComponents/name, PT_Components/name);
		attribute<string> PreTransport              := union_data(., const('Org2Stops_Walking', DirectComponents), PT_Components/PreTransport), Descr = "The pre-transport type; not used for a direct trip.";
		attribute<string> PostTransport             := union_data(., const('Stops2Dest_Walking', DirectComponents), PT_Components/PostTransport), Descr = "The post-transport type; not used for a direct trip.";
		attribute<bool>   DirectWalking             := union_data(., DirectComponents/DirectWalking, const(FALSE, PT_Components));
		attribute<bool>   DirectCycling             := union_data(., DirectComponents/DirectCycling, const(FALSE, PT_Components));
		attribute<bool>   DirectCar                 := union_data(., DirectComponents/DirectCar, const(FALSE, PT_Components));
		attribute<bool>   WithPT                    := union_data(., const(FALSE, DirectComponents), const(TRUE, PT_Components)), Descr = "Does the component use the public transport chains? Without them the final front reads only the direct trips and no chain cache is needed.";
		attribute<bool>   UsesCycling               := union_data(., DirectComponents/DirectCycling, PT_Components/UsesCycling), Descr = "Does the component use the cycling network of CyclingNetwork, as CC and a public transport component with cycling in pre- or post-transport do, the OV-fiets included?";
		attribute<string> OutputSuffix              := '_' + name + (UsesCycling ? /ModelParameters/Impl/CyclingNetwork_DirTag : ''), Descr = "Suffix after OutputLabel in the name of the output folder: _ and the component name, with _fb when the component cycles on the Fietsersbond network; merging finds the components by it.";
		attribute<uint32> BlocksPerPortion          := union_data(., const(50, DirectComponents, uint32), PT_Components/BlocksPerPortion), Descr = "Origin blocks per GeoDmsRun in the output step: 50 for a direct trip, for a public transport component that of its pre-transport type.";
		attribute<bool>   SingleDepartureMoment     := union_data(., const(TRUE, DirectComponents), const(FALSE, PT_Components)), Descr = "Does this component calculate one departure moment, that of the congestion moment of the part of the day, instead of four, as WW and CC that do not depend on it and Car with a cache per congestion moment (#132)?";
		attribute<bool>   SingleDepartureMoment_Eff := SingleDepartureMoment && !(DirectCar && /ModelParameters/Impl/CarTimeDependent), Descr = "SingleDepartureMoment, except for the time-dependent car trip, whose departure moments really differ.";
		attribute<string> ExportClass               := union_data(., DirectComponents/name == 'Car' ? 'Car' : 'Direct', const('PT', PT_Components)), Descr = "The kind of columns of the parquet output of the component: Direct (WW, CC), Car or PT; merging reads them that way.";
		attribute<bool>   NeedsCar                  := DirectCar, Descr = "Does the component need a car? Only Car.";
		attribute<bool>   NeedsBike                 := union_data(., DirectComponents/DirectCycling, PT_Components/NeedsBike), Descr = "Does the component need an own bike: CC, and a public transport component with cycling in pre- or post-transport other than the OV-fiets?";
		attribute<bool>   Selected                  := union_data(., DirectComponents/Selected, PT_Components/Selected), Descr = "Is the component in the variant, so that batch/UpdateAll.cmd calculates it and the merge takes it along?";
	}
	unit<uint8> DirectModes : nrofrows = 3
	, Descr = "The direct modes that can join public transport in the front per OD pair, with their switch; the name is that of the source under NetworkSetup/PublicTransport_Prep/Direct."
	{
		attribute<string> name    : ['Walking', 'Cycling', 'Car'];
		attribute<string> abbrev  : ['W', 'C', 'A'], Descr = "Letter of the mode in ModeUsed; a direct trip is called WW, CC or AA in the output.";
		attribute<bool>   Allowed := union_data(., /ModelParameters/Impl/AllowDirectWalking, /ModelParameters/Impl/AllowDirectCycling, /ModelParameters/Impl/AllowDirectCar);
	}

	// FLEX LINES (#113, #116): the terms by which the model recognises a flex line by its name; the switches are in
	// ModelParameters/Advanced (IncludeFlex and further).
	unit<uint8> FlexRouteTerms : nrofrows = 4
	, Descr = "Search terms (lower case) that make a GTFS route a flex line, matched in route_short_name and route_long_name; deliberately narrow, see the explanation per term."
	{
		attribute<string> term        : ['flex', 'texelhopper', 'opstapper', 'belbus'];
		attribute<string> Explanation : ['Bravoflex (Arriva), Connexxion FLEX, Overal Flex, FlexRRReis, SyntusFlex, U-flex', 'Texelhopper (TXL)', 'Opstapper Fryslan (Arriva/Qbuzz)', 'belbus, generiek'];
	}
	unit<uint8> FlexNearMissTerms : nrofrows = 5, Descr = "Terms that look like flex but do not count as flex; only for /Output/FlexLines/NearMiss."
	{
		attribute<string> term : ['buurtbus', 'wijkbus', 'hopper', 'vlinder', 'taxi'];
	}

	// The rows of the counts next to the public transport output: <OutputDir>/od_tellingen.csv and unieke_od_tellingen.csv, see
	// NetworkSetup/ConfigurationPerBlock/Generate_Output/OD_Counts.
	unit<uint8> OD_Counts_Kind : nrofrows = 5
	, Descr = "Rows of the public transport output per kind of option: all, a public transport chain (with pre- and post-transport), and the direct trips walking (WW), bike (CC) and car (AA)."
	{
		attribute<string> name  : ['alle', 'OV_keten', 'WW', 'CC', 'AA'];
		attribute<string> label : ['alle', 'OV-keten', 'WW', 'CC', 'AA'];
	}
	unit<uint8> OD_Counts_Group : nrofrows = 7
	, Descr = "Unique OD pairs with at least one option of this kind, or with an option for this group of travellers: without a car (NeedsCar 0), and without a car and a bike (NeedsCar and NeedsBike 0)."
	{
		attribute<string> name  : ['alle', 'OV_keten', 'WW', 'CC', 'AA', 'zonder_auto', 'zonder_auto_en_fiets'];
		attribute<string> label : ['alle', 'OV-keten', 'WW', 'CC', 'AA', 'zonder auto', 'zonder auto en fiets'];
	}

	#include<modes.dms>
	#include<osm.dms>
	
	unit<uint32> Directions_TomTom : NrOfRows = 4
	{
		attribute<string> code  : ['','N','FT','TF'];
		attribute<string> Label : ['dual', 'nocars', 'forwards', 'backwards'];
		
		container         V     := for_each_nedv(Label, String(ID(.))+'[..]', void, .);
	}
	unit<uint32> Directions_OSM : NrOfRows = 3
	{
		attribute<string> code  : ['B','F','T'];
		attribute<string> Label : ['dual', 'forwards', 'backwards'];
		
		container         V     := for_each_nedv(Label, String(ID(.))+'[..]', void, .);
	}

	unit<uint8> FuncRoadClass_EK    := range(uint8, 0b, 9b);
	unit<uint8> FuncRoadClass : nrofrows = 10
	{
		attribute<string> Label : ['Not Applicable', 'Motorway, Freeway, or Other Major Road', 'Major Road Less Important than a Motorway', 'Other Major Road','Secondary Road','Local Connecting Road','Local Road of High Importance','Local Road','Local Road of Minor Importance','Other Road'];
		attribute<string> name  := AsItemName(label);
		container         V     := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	
	unit<uint32> LinkTypes : NrOfRows = 7
	{
		attribute<string> Name     : ['Undefined','Scheduled','Transfer','Stop_to_Dest','Org_to_Stop','Waiting_at_Stop','Waiting_at_Org'];
		attribute<string> Label    := Name;
		attribute<uint32> PenColor : [rgb(128,128,128), rgb(200,0,0), rgb(129,129,0), rgb(0,0,128),rgb(0,0,255), rgb(128,128,128), rgb(128,128,128)], DialogType = "PenColor";
		attribute<int16>  PenStyle : [4,0,1,2,2,0], DialogType = "PenStyle";
		
		container         v        := for_each_nedv(Name, string(id(.)), void, .);
	}
	
 	unit<uint32> Agencies := unique(lowercase(SourceData/Infrastructure/GTFS/LoadFeeds/Read/Agency/data/agency_name))
	{
		attribute<string> name              := AsItemName(values);
		attribute<string> label             := values;
		
		attribute<bool>   IsForeign         := name == 'de_lijn' || name == 'db'  || name == 'eurobahn' || name == 'niag' || name == 'nmbs' || name == 'vias' || name == 'ns_international' || name == 'ns_int' || name == 'eu_sleeper' || name == 'european_sleeper' || name == 'tcs_ov' || name == 'govolta';
						// agencies that are in the GTFS but operate abroad (De Lijn, DB, Eurobahn, NIAG, NMBS, VIAS, TCS OV, GoVolta)
						// mind feed drift: 'NS International' is called 'NS Int' from feed 20251008 on, and 'Eu Sleeper' is called 'European Sleeper' from feed
						// 20260316 on; both variants are therefore listed.

		attribute<bool>   IsNS              := name == 'ns' || name == 'ns_international' || name == 'ns_int' || name == 'eu_sleeper' || name == 'european_sleeper'; // do not select these agencies as regional transport (L-net or excluded). DB and Eurobahn (regional cross-border stopping trains Enschede-Dortmund / Hengelo-Bielefeld / Venlo-Hamm) deliberately do NOT belong here: they route like VIAS/NMBS over the R-net and are priced through the FareTable; in IsNS their legs would drop out of the network entirely.
		attribute<bool>   IsRO              := not(IsNS);
		attribute<bool>   IsNSInternational := name == 'ns_international' || name == 'ns_int';
		attribute<bool>   IsLnet            := name == 'ns' || (IsNSInternational && ModelParameters/Advanced/IsNSInternationalInLnet), Descr = "Agencies of the NS network (L-net, NS fare): NS and, for domestic trips, NS International (#3, ModelParameters/Advanced/IsNSInternationalInLnet); Eurostar and Nightjet still do not run domestically (SourceData/Infrastructure/OVprijzen/NS/TrainsWithoutNSTicket, and pickup_type/drop_off_type in the GTFS), and European Sleeper is left out because it takes reservations only and no NS tickets.";
		container         V                 := for_each_nedv(Name, string(id(.)), void, .);
	}
 
	unit<uint8> ImpedanceTypes : nrofrows = 10
	{
		attribute<string> name : ['max_walking','max_cycling','max_e_bike','max_car','max_limit_car','congested_morning_car','congested_noon_car','congested_late_car','congested_cycling','congested_e_bike'];
	}
	
	unit<uint8> pand_status : nrofrows = 10
	{
		attribute<string> label : ['Bouw gestart','Bouwvergunning verleend','Niet gerealiseerd pand','Pand buiten gebruik','Pand gesloopt','Pand in gebruik','Pand in gebruik (niet ingemeten)','Sloopvergunning verleend','Pand ten onrechte opgevoerd','Verbouwing pand'], DialogType = "LabelText";
		attribute<string> name  := replace(label, ' ', '_', '-', '_', '(', '', ')', '');
		container         V     := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	
	unit<uint8> vbo_status : nrofrows = 8
	{
		attribute<string> label : ['Niet gerealiseerd verblijfsobject','Verblijfsobject buiten gebruik','Verblijfsobject gevormd','Verblijfsobject in gebruik','Verblijfsobject in gebruik (niet ingemeten)','Verblijfsobject ingetrokken','Verblijfsobject ten onrechte opgevoerd', 'Verbouwing verblijfsobject'], DialogType = "LabelText";
		attribute<string> name  := replace(label, ' ', '_', '-', '_', '(', '', ')', '');
		container         V     := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	unit<uint8> vbo_gebruiksdoel : nrofrows = 11
	{
		attribute<uint8>  ID         := ID(.);
		attribute<string> label      :
		[
			'bijeenkomstfunctie',
			'celfunctie',
			'gezondheidszorgfunctie',
			'industriefunctie',
			'kantoorfunctie',
			'logiesfunctie',
			'onderwijsfunctie',
			'overige gebruiksfunctie',
			'sportfunctie',
			'winkelfunctie',
			'woonfunctie'
		];
		
		attribute<string> name       := replace(replace(label,' ','_'), 'functie','');
		attribute<uint32> BrushColor : DialogType = "BrushColor",[rgb(255,255,255), rgb(  0,129,  0),rgb(  0,  0,255),rgb(255,220,  0),rgb(255,  0,  0)];
		container         V          := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	
	unit<uint8> WPSrc : nrofrows = 6
	{
		attribute<string> label : ['geen woonpand','vrijstaand','twee onder 1 kap','hoekwoning','tussenwoning','appartement'], DialogType = "LabelText";
		attribute<string> name  := replace(label, ' ', '_');
		
		container         V     := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	// The criteria of the chain joiner. A group of the chain joiner has the same boarding and alighting time stop and the same first NS
	// station of the ongoing NS journey (ChainJoiner_T, Part_rel). The chain joiner chooses on the price of the final front (Price, or
	// Price_augm when MinimiseCriteria names it) and on the remaining times that determine whether a chain can still be extended at a
	// through fare. With a final front on Price, Price_augm (price plus time costs of transfers) only decides between chains that are
	// otherwise equal (relative epsilon 1, no extra front rows); only pareto_optimal_eps can do that. The travel time is equal within a group,
	// except with a time penalty (GradeSeparatedTransferPenalty, or FlexExtraWaitingTime for flex legs): then TravelTime is also a criterion.
	// The order: price first (the reporting theme is accessibility poverty). With the relative epsilon of pareto_optimal_eps (GeoDMS #1282)
	// the first criterion sets the order and the cheapest chain of a group always stays; a more expensive one stays only if it is better
	// on another criterion than every cheaper one that stays, on the travel time by more than ChainParetoTimeEpsilon. An epsilon on the
	// price therefore has no effect and is 0.
	unit<uint8> ChainJoinerParetoAttr_Candidates : nrofrows = 6
	{
		parameter<bool>   IsPriceFinal   := CandidateParetoAttr/IsFinalParetoSelection[CandidateParetoAttr/V/Price];
		parameter<bool>   HasTimePenalty := ModelParameters/Advanced/GradeSeparatedTransferPenalty > 0[min_f] || ModelParameters/Impl/FlexHasTimePenalty || ModelParameters/Impl/TripSurchargeHasTimePenalty;
		attribute<string> Name           : [ 'Price', 'Price_augm', 'remaining_time_excl_RO_transfer', 'remaining_time_excl_NS_transfer', 'TravelTime', 'Price_augm' ];
		attribute<bool>   IsTieBreakOnly : [ FALSE, FALSE, FALSE, FALSE, FALSE, TRUE ];
		attribute<string> EpsilonExpr    : [ '0.0', '0.0', '0.0', '0.0', '/ModelParameters/Advanced/ChainParetoTimeEpsilon', '1.0' ], Descr = "Per criterion the relative epsilon for pareto_optimal_eps (GeoDMS #1282): 0 for the first criterion, where it has no effect, and for the remaining times, which are exact; 1.0 for the tie-break Price_augm, which only sets the order.";
		attribute<bool>   IsSelected     := switch(
		                                      case(id(.) == 0b, IsPriceFinal)
		                                    , case(id(.) == 1b, NOT(IsPriceFinal))
		                                    , case(id(.) == 4b, HasTimePenalty && CandidateParetoAttr/IsFinalParetoSelection[CandidateParetoAttr/V/TravelTime])
		                                    , case(id(.) == 5b, IsPriceFinal)
		                                    , TRUE);
	}
	unit<uint8> ChainJoinerParetoAttr := select_with_attr_by_cond(ChainJoinerParetoAttr_Candidates, ChainJoinerParetoAttr_Candidates/IsSelected)
	{
		attribute<string> ParetoArgs := Name + (id(.) > 0b && EpsilonExpr != '' ? ', ' + EpsilonExpr : ''), Descr = "The arguments of this criterion for pareto_optimal_eps(part, crit1, crit2, eps2, ...): the first criterion only sets the order and gets no epsilon, and neither does a bool (GeoDMS #1282).";
	}

	unit<uint8> CandidateParetoAttr : nrofrows = 3
	{
		// Price first, then the travel time (accessibility poverty): with the relative epsilon (GeoDMS #1282) the cheapest option of an OD pair
		// always stays, and a more expensive one only if it is more than ChainParetoTimeEpsilon faster than the fastest cheaper option that
		// stays. Every option that drops out thus has a cheaper one that stays and is at most ChainParetoTimeEpsilon slower. Then the ownership
		// criteria (OwnershipParetoAttr), exact.
		attribute<string> Name                   : [ 'Price', 'Price_augm', 'TravelTime']; // can be regulated here; the selection depends on MinimiseCriteria (IsCriteriaInList)
		attribute<string> FileNameElement        : [ 'Price', 'Price_augm', 'Time'];       // code for use in a composed file name
		attribute<string> EpsilonExpr            : [ '0.0', '0.0', '/ModelParameters/Advanced/ChainParetoTimeEpsilon' ], Descr = "Per criterion the relative epsilon for pareto_optimal_eps (GeoDMS #1282); the price comes first, and on the first criterion an epsilon has no effect, so 0.";
		attribute<bool>   IsCriteriaInList       := IsDefined(strpos(lowercase(ModelParameters/Impl/IsMerged ? ModelParameters/MergeCriteria : ModelParameters/MinimiseCriteria), lowercase(CandidateParetoAttr/FileNameElement))), Descr = "Does MinimiseCriteria, or MergeCriteria when merging, name this criterion, regardless of upper or lower case?";
		parameter<bool>   IsBothPriceAndAugm     := IsCriteriaInList[v/Price] && IsCriteriaInList[v/Price_augm];
		
		attribute<bool>   IsFinalParetoSelection := switch(
		                                                  case(id(.) == v/Price && IsBothPriceAndAugm, FALSE)
		                                                , case(id(.) == v/Price && NOT(IsBothPriceAndAugm) && IsCriteriaInList, TRUE)
		                                                , IsCriteriaInList
		                                            );
		
		container         V                      := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	
	
	
	unit<uint8> FinalParetoAttr := select_with_attr_by_cond(CandidateParetoAttr, CandidateParetoAttr/IsFinalParetoSelection)
	{
		attribute<string> ParetoArgs := Name + (id(.) > 0b && EpsilonExpr != '' ? ', ' + EpsilonExpr : ''), Descr = "The arguments of this criterion for pareto_optimal_eps(part, crit1, crit2, eps2, ...): the first criterion only sets the order and gets no epsilon, and neither does a bool (GeoDMS #1282).";
	}

	// Car ownership and bike ownership as criteria in the final Pareto selection (NetworkModel_PBL#117): an option that needs no car or
	// bike stays next to a cheaper and faster option that does. Only in the condensations per departure moment
	// (NetworkSetup/PublicTransport/PerDepartureMoment_T); the chain joiner only calculates public transport and keeps FinalParetoAttr,
	// so that the chain cache stays the same. Bool criteria, minimised (false before true) and without epsilon: GeoDMS #1287.
	unit<uint8> OwnershipParetoAttr_Candidates : nrofrows = 2
	{
		attribute<string> Name             : [ 'NeedsCar', 'NeedsBike' ];
		attribute<string> CriteriaName     : [ 'Car', 'Bike' ], Descr = "The element in MinimiseCriteria.";
		attribute<string> FileNameElement  : [ 'A', 'C' ], Descr = "The element in the signature of the output (PT_Output_ParamTag): the letter of car or bike in ModeUsed (NetworkModel_PBL#118).";
		attribute<string> EpsilonExpr      : [ '', '' ], Descr = "Empty: a bool criterion has no epsilon in pareto_optimal_eps.";
		attribute<bool>   IsCriteriaInList := IsDefined(strpos(lowercase(ModelParameters/Impl/IsMerged ? ModelParameters/MergeCriteria : ModelParameters/MinimiseCriteria), lowercase(CriteriaName))), Descr = "Does MinimiseCriteria, or MergeCriteria when merging, name the criterion?";
		attribute<bool>   IsRelevant       := union_data(., ModelParameters/Impl/AllowDirectCar, ModelParameters/Impl/IsMerged ? any(Classifications/Components/Selected && Classifications/Components/NeedsBike) : ModelParameters/Impl/AllowDirectCycling || VN_ModeClasses/AnyNeedsBike)
		,	Descr = "Can an option need a car or a bike: a car only for the direct car trip (there is no P+R pre-transport), a bike for the direct cycling route and for pre- or post-transport with an own bike; a criterion that is equal for all options does not change the front and is left out.";
		attribute<bool>   IsSelected       := IsCriteriaInList && IsRelevant;
	}
	unit<uint8> OwnershipParetoAttr := select_with_attr_by_cond(OwnershipParetoAttr_Candidates, OwnershipParetoAttr_Candidates/IsSelected);

	unit<uint8> OutputParetoAttr := union_unit_uint8(FinalParetoAttr, OwnershipParetoAttr)
	, Descr = "The criteria of the final Pareto selection per departure moment: FinalParetoAttr plus the selected ownership criteria."
	{
		attribute<string> Name            := union_data(., FinalParetoAttr/Name, OwnershipParetoAttr/Name);
		attribute<string> FileNameElement := union_data(., FinalParetoAttr/FileNameElement, OwnershipParetoAttr/FileNameElement);
		attribute<string> EpsilonExpr     := union_data(., FinalParetoAttr/EpsilonExpr, OwnershipParetoAttr/EpsilonExpr);
		attribute<string> ParetoArgs      := Name + (id(.) > 0b && EpsilonExpr != '' ? ', ' + EpsilonExpr : ''), Descr = "The arguments of this criterion for pareto_optimal_eps(part, crit1, crit2, eps2, ...): the first criterion only sets the order and gets no epsilon, and neither does a bool (GeoDMS #1282).";
	}
}