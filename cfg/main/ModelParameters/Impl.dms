container Impl : using = "classifications"
,	Descr = "What follows from the settings and is not set by hand: the effective dates and years, the selections of this run, and the tags, signatures, folders and file names of the stores and the output."
{
	// AFGELEID UIT DE INSTELLINGEN BOVENAAN, niet zelf in te stellen
	parameter<string>   GTFS_file_date                            := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/GTFS_file_date)
	, Descr = "De GTFS-feed (map en mmd-store onder %NetworkModel_Dir%/Infrastructuur/GTFS) van de peildatum, uit Advanced/AnalysisMomentPresets (#125). De feed moet de dienstdagen D-1, D en D+1 van Analysis_date dekken (LoadFeeds/ServiceDays)."
	, IntegrityCheck = "strlen(this) == 8";
	parameter<string>   Analysis_date                             := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/Analysis_date)
	, Descr = "De dag van de OV-analyse: de peildatum van AnalysisMoment, uit Advanced/AnalysisMomentPresets (#125). Het net bevat de dienstdagen D-1, D en D+1 op een tijdas; LoadFeeds/ServiceDays controleert dat de feed elke dag die het analysevenster nodig heeft compleet heeft."
	, IntegrityCheck = "strlen(this) == 8";
	//Directe ritten naast het OV. De ketenrijger voegt per HB-paar de directe rit(ten) bij de OV-ketens en houdt
	//het Pareto-front op Advanced/MinimiseCriteria (prijs, tijd) over; zie NetworkSetup/PublicTransport_Prep/Direct_OD.
	//De drie schakelaars volgen uit Component (#117).
	parameter<bool>     AllowDirectWalking                        := Impl/IsMerged ? any(Advanced/Components/InMerge && Advanced/Components/DirectWalking) : rjoin(Impl/ComponentName, Advanced/Components/name, Advanced/Components/DirectWalking), Descr = "Doet de directe looprit (OSM-loopnetwerk, tot MaxWalkingTime_Org2Dest) mee in het front per HB-paar? Uit Component (Advanced/Components/DirectWalking, #117); bij het samenvoegen: of een samengevoegde component hem heeft.";
	parameter<bool>     AllowDirectCycling                        := Impl/IsMerged ? any(Advanced/Components/InMerge && Advanced/Components/DirectCycling) : rjoin(Impl/ComponentName, Advanced/Components/name, Advanced/Components/DirectCycling), Descr = "Doet de directe fietsrit (het net van Advanced/CyclingNetwork, tot MaxCyclingTime_Org2Dest) mee in het front per HB-paar? Uit Component (Advanced/Components/DirectCycling, #117); bij het samenvoegen: of een samengevoegde component hem heeft.";
	parameter<bool>     AllowDirectCar                            := Impl/IsMerged ? any(Advanced/Components/InMerge && Advanced/Components/DirectCar) : rjoin(Impl/ComponentName, Advanced/Components/name, Advanced/Components/DirectCar), Descr = "Doet de directe autorit (TomTom of OSM, zie UseTomTomNetworkForCars, tot MaxCarTime) mee in het front per HB-paar? Uit Component (Advanced/Components/DirectCar, #117); bij het samenvoegen: of een samengevoegde component hem heeft. De autoprijs is afstand x Car_CostPerKm.";
	parameter<string>   Car_CongestionMoment_ForDirect            := UseTomTomNetworkForCars ? rjoin(PartOfDay, Advanced/PartsOfDay/name, Advanced/PartsOfDay/CongestionMoment) : 'MaxSpeed'
	, Descr = "Welke reistijd van de auto de directe rit gebruikt: 'MorningRush' (07:30), 'NoonRush' (12:30), 'LateEveningRush' (19:30) of 'Freeflow' (alleen TomTom; bij OSM 'MaxSpeed'). Volgt uit PartOfDay (Advanced/PartsOfDay/CongestionMoment, #125): het midden van het uur van de vertrekmomenten."
	, IntegrityCheck = "UseTomTomNetworkForCars ? Car_CongestionMoment_ForDirect != 'MaxSpeed' : Car_CongestionMoment_ForDirect == 'MaxSpeed'"; // TomTom kent Freeflow/MorningRush/NoonRush/LateEveningRush; OSM alleen MaxSpeed, want de OSM-spitsen zijn null-placeholders
	parameter<bool>     CarTimeDependent                          := UseTomTomNetworkForCars
	, Descr = "Rekent de directe autorit met tijdafhankelijke linktijden (#132)? Dan is er per vertrekmoment een autostore (PublicTransport_Prep/Direct/CarPerMoment/TD<moment>), waarin elk wegvak de TomTom-snelheid heeft van het moment waarop de rit het binnenrijdt. FALSE: een momentopname per congestiemoment. Vereist TomTom en een weekdag als Advanced/CongestionSpeed_DaySelection."
	, IntegrityCheck = "!this || UseTomTomNetworkForCars";
	parameter<Advanced/Buurtsets> Buurtset_Org                             := rlookup(lowercase(/ModelParameters/Orgset), lowercase(Advanced/Buurtsets/name)), Descr = "De buurtvariant van de herkomsten, of null.";
	parameter<Advanced/Buurtsets> Buurtset_Dest                            := rlookup(lowercase(/ModelParameters/Destset), lowercase(Advanced/Buurtsets/name)), Descr = "De buurtvariant van de bestemmingen, of null.";
	parameter<Advanced/Buurtsets> Buurtset                                 := MakeDefined(Buurtset_Org, Buurtset_Dest)
	,	Descr = "De buurtvariant van de run: die van de herkomsten, anders die van de bestemmingen, anders null (dan gelden de presets van AnalysisMoment). Er is een BAG en een gebiedsindeling per run, dus herkomsten en bestemmingen kunnen geen verschillende buurtvarianten zijn."
	,	IntegrityCheck = "!IsDefined(Buurtset_Org) || !IsDefined(Buurtset_Dest) || Buurtset_Org == Buurtset_Dest";
	parameter<string>   BAG_snapshot                              := IsDefined(Buurtset) ? Advanced/Buurtsets/BAG_snapshot[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/BAG_snapshot)
	,	Descr = "Naam van de BAG-snapshotmap onder %NetworkModel_Dir%/RegioIndelingen/BAG: die van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders die van AnalysisMoment in de presettabel. Los van RegioIndelingen_year, want de BAG-standdatum en de CBS-gebiedsindeling lopen niet gelijk.";
	parameter<string>   BAG_year                                  := substr(BAG_snapshot, 0, 4)
	,	Descr = "Het jaar van de BAG-snapshot, uit BAG_snapshot. Wordt gebruikt om bouwjaren na de standdatum af te kappen en in de exportnamen.";
	parameter<string>   RegioIndelingen_year                      := IsDefined(Buurtset) ? Advanced/Buurtsets/RegioIndelingen_year[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/RegioIndelingen_year)
	,	Descr = "Het jaar van de CBS-gebiedsindeling: dat van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders per AnalysisMoment in de presettabel.";
	// HET HB-PAAR (#129): zie groep 6 bovenaan.
	parameter<bool>     IsOD                                      := /ModelParameters/OD_Origin != '' && /ModelParameters/OD_Destination != ''
	,	Descr = "Rekent deze run een HB-paar (OD_Origin en OD_Destination)? Dan zijn de herkomsten en bestemmingen elk een element (PublicTransport_Prep/impl/OD_Org, OD_Dest), staan de tussenresultaten en de uitvoer in eigen mappen (OD_Tag) en houden de routes hun links bij."
	,	IntegrityCheck = "(/ModelParameters/OD_Origin == '') == (/ModelParameters/OD_Destination == '') && (this || /ModelParameters/OD_DepartureTime == '')";
	parameter<string>   OD_Tag                                    := IsOD ? '_' + /ModelParameters/OD_Origin + '_' + /ModelParameters/OD_Destination : ''
	,	Descr = "Achter IntermediateResults en Output in de namen van de mappen van een HB-paar: _<O>_<D>, bijvoorbeeld _BU04020501_BU0363KP03; leeg in het generieke model."
	,	IntegrityCheck = "strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
	parameter<bool>     IsODMoment                                := IsOD && /ModelParameters/OD_DepartureTime != '', Descr = "Kiest het HB-paar een vertrekmoment (OD_DepartureTime)?";
	parameter<uint32>   OD_Minute                                 := IsODMoment ? uint32(substr(/ModelParameters/OD_DepartureTime, 3, 2)) : 0
	,	Descr = "De minuut van OD_DepartureTime; het uur moet dat van PartOfDay zijn en de minuut een van Advanced/PT_DepartureMinutes_All."
	,	IntegrityCheck = "!IsODMoment || (uint32(substr(/ModelParameters/OD_DepartureTime, 0, 2)) == rjoin(/ModelParameters/PartOfDay, Advanced/PartsOfDay/name, Advanced/PartsOfDay/DepartureHour) && any(Advanced/PT_DepartureMinutes_All/values == this))";
	parameter<string>   IntermediateResultsDir                    := '%LocalDataProjDir%/IntermediateResults' + OD_Tag
	,	Descr = "De map van de stores van de autoritten, de benen en de ketens (PublicTransport_Prep); bij een HB-paar IntermediateResults_<O>_<D> (#129).";
	parameter<string>   OutputDir                                 := '%LocalDataProjDir%/Output' + OD_Tag + '/' + Analysis_date + '_' + /ModelParameters/OutputLabel + (IsMerged ? '_Merged' + string(/ModelParameters/MergeRunNr) + (any(Advanced/Components/InMerge && Advanced/Components/UsesCycling) ? CyclingNetwork_DirTag : '') : rjoin(ComponentName, Advanced/Components/name, Advanced/Components/OutputSuffix))
	,	Descr = "De map met de OV-uitvoer van deze run (#118): <Analysis_date>_<OutputLabel> met het achtervoegsel van de component (Advanced/Components/OutputSuffix) of _Merged<MergeRunNr>, met _fb als een samengevoegde component over de Fietsersbond fietst; met PerBlock/tt_<moment>_<n>of<N> en signature.txt.";
	parameter<string>   fileNamePrefix                            := OutputDir + '/PerBlock/', Descr = "De map van de OV-uitvoer per herkomstblok (en van de exports van lopen, fiets en auto).";
	parameter<string>   OutputExt                                 := '.' + OutputFormat, Descr = "De extensie van de bestanden in PerBlock en Mediaan.";
	parameter<string>   ExportClass                              := IsMerged ? 'Merged' : ComponentName == 'WW' || ComponentName == 'CC' ? 'Direct' : ComponentName == 'Car' ? 'Car' : 'PT', Descr = "Welke kolommen de parquet-uitvoer van deze component heeft (PerDepartureMoment_T, CreateExports/LongFormat/Parquet_<ExportClass>): alleen die binnen de component variëren en niet lineair uit andere volgen. 'Direct' (WW, CC): Traveltime; 'Car': ook TravelDist_Car; 'PT': ook de prijzen, ModeUsed, de wacht-, voor- en natransporttijd en de afstanden per OV-modaliteit.";
	parameter<string>   Concessiegebied_year                      := value(FareTable_year, uint32) < 2020 ? 'Y2020' : 'Y'+FareTable_year , Descr = "Which year of the concession areas would you like to use? Relevant for public transport price determination. Concessie-shapes bestaan alleen 2020-2026; voor FareTable_year < 2020 (o.a. DOVA-prijzen terug tot 2013) wordt Y2020 als proxy gebruikt.";
	parameter<string>   FareTable_year                            := substr(GTFS_file_date, 0, 4), Descr = "Prijsjaar: het jaar van GTFS_file_date, zodat de agency-labels van de FareTable bij de geladen feed horen (data/FareTable_dekkingsrapport.md). Detailed-FareTables bestaan voor 2023-2026; voor eerdere jaren rekent de prijs met DOVA (Impl/PriceMethod_effective).";
	parameter<string>   PriceMethod_effective                     := value(FareTable_year, uint32) < 2023 ? 'DOVA' : Advanced/PriceMethod, Descr = "Effectieve prijsmethode: Detailed-FareTables bestaan alleen voor 2023-2026, dus voor FareTable_year < 2023 (oudere GTFS-feeds) wordt altijd DOVA gebruikt, ongeacht Advanced/PriceMethod.";
	parameter<string>   DOVA_year                                 := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaarkolom in het DOVA-overzicht (y2013..y2026); geklemd op dat bereik (bv. feed 20120917 -> 2013-prijzen).";
	parameter<string>   NS_prijzen_year                           := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaargang van de NS-tarieven-csv (data/Tarieven_NS/NS tarieven <jaar>.csv, 2013-2026 aanwezig); geklemd op dat bereik.";
	parameter<string>   NS_tariefnet_year                         := value(NS_prijzen_year, uint32) >= 2016 ? '2016' : '2013', Descr = "Jaargang van het NS-tariefnet (data/Tarieven_NS/NS_tariefnet_<jaar>.csv) bij NS_prijzen_year (#121): 2013 het NDOV-net met de gezamenlijke tariefpunten (stations met 0 TE ertussen), 2016 zonder die punten (elk stationspaar minstens 1 TE).";
	parameter<string>   OVFiets_year                              := rjoin(/ModelParameters/AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/OVFiets_year);
	parameter<string>   OVFiets_File                              := rjoin(OVFiets_year, Advanced/OVFiets_Locations/year, Advanced/OVFiets_Locations/file), Descr = "Het bestand van de OV-fietslocaties van deze peildatum (SourceData/Infrastructure/OV_Fiets_Stations).";
	parameter<string>   OVFiets_FileTag                           := OVFiets_year == '2023' ? '' : '_ovf' + OVFiets_year, Descr = "In de handtekening van de OV-uitvoer als het PostTransport de OV-fiets heeft (PT_Output_ParamTag); leeg bij de locaties van 2023.";
	parameter<Time>     PT_FirstDepartureMoment                   := first(MeasureMoments/Moment), Descr = "Begin van het analysevenster van het OV: het eerste vertrekmoment, in seconden sinds 00:00 van Analysis_date.";
	parameter<Time>     PT_LastArrivalMoment                      := last(MeasureMoments/Moment) + convert(ModelParameters/MaxPTTime, s_f)[Time] + uint32(NOT(Advanced/IncludeWaitingAtHomeInTravelTime)) * Advanced/MaxWaitingTimeAtOrigin
	, Descr = "Einde van het analysevenster van het OV: het laatste vertrekmoment plus MaxPTTime en de wachttijd thuis. Voorbij 24:00 (86400) loopt het venster door in de volgende dag, en gebruikt het netwerk ook de ritten van de dienstdag na Analysis_date.";
	parameter<min_f>    PT_Max_V_Time                             := max(OV_PreTransport_Typen/MaxTime) + Cycling_StartTime + Advanced/Cycling_PreTransport_Penalty + Cycling_ParkingTime_IC_Station
	, Descr = "Langste voortransportbeen dat nog geldig kan zijn: de grootste Max*Time-grens (op netwerktijd) plus de start- en parkeertijden in het been. Begrenst per vertrekmoment het venster van OV-vertrekken (PerDepartureMoment_T) en het laatste instapmoment van de ketens.";
	parameter<Time>     PT_LastBoardingMoment                     := last(MeasureMoments/Moment) + convert(PT_Max_V_Time, s_f)[Time] + Advanced/MaxWaitingTimeAtOrigin
	, Descr = "Laatste instapmoment waarop een keten nog gebruikt kan worden: het laatste vertrekmoment plus het langste PreTransport en de wachttijd thuis, de bovengrens van Within_VW_Window. De ketenstap begint geen ketens die later instappen.";
	parameter<Time>     PrevServiceDayTailEnd                     := 21600[Time]           , Descr = "De ritten van de dienstdag voor Analysis_date die na middernacht doorrijden (GTFS-tijd 24:00 en later) vertrekken vrijwel alle voor 06:00; begint het analysevenster eerder, dan moet die dag compleet in de feed staan.";
	parameter<uint32>   FlexMinInterval_sec                       := uint32(round(convert(Advanced/FlexMinInterval, s_f))), Descr = "Advanced/FlexMinInterval in hele seconden, voor de blokken van LoadFeeds/FlexOptions.";
	parameter<bool>     FlexHasTimePenalty                        := Advanced/IncludeFlex && Advanced/FlexExtraWaitingTime > 0[min_f], Descr = "Krijgt een flexbeen extra wachttijd bij zijn reistijd?";
	parameter<string>   Flex_FileTag                              := not(Advanced/IncludeFlex) ? '_noflex' : (Advanced/FlexMinInterval > 0[min_f] || Advanced/FlexExtraWaitingTime > 0[min_f] || Advanced/FlexCallCosts > 0[Euro] ? '_flex' + string(round(Advanced/FlexMinInterval)) + 'i' + string(round(Advanced/FlexExtraWaitingTime)) + 'w' + string(round(Advanced/FlexCallCosts * 100f)) + 'ct' : ''), Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/PT_Chains_Signature) en van de OV-uitvoer (PT_Output_ParamTag): '_noflex' zonder flex, '_flex<interval>i<wachttijd>w<belkosten in ct>ct' met de flexparameters, leeg als die alle drie 0 zijn.";
	parameter<string>   FlexRoutePattern                          := asList(Advanced/FlexRouteTerms/term, '|');
	parameter<string>   FlexNearMissPattern                       := asList(Advanced/FlexNearMissTerms/term, '|');
	parameter<bool>     TripSurchargeHasTimePenalty                   := Advanced/IncludeTripSurcharge && max(Advanced/TripSurchargeTrains/ExtraTijd) > 0[min_f], Descr = "Krijgt een been met rit-opslag extra reistijd?";
	parameter<string>   TripSurcharge_Flags                           := (Advanced/IsNSInternationalInLnet ? '' : 'I') + (Advanced/IncludeTripSurcharge ? (TripSurchargeHasTimePenalty ? 'w' + string(round(sum(Advanced/TripSurchargeTrains/ExtraTijd))) : '') : 'R');
	parameter<string>   TripSurcharge_FileTag                         := TripSurcharge_Flags == '' ? '' : '_' + TripSurcharge_Flags
	, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/PT_Chains_Signature) en van de OV-uitvoer (PT_Output_ParamTag): leeg met de standaard (NS International mee, rit-opslag mee, geen extra tijd), anders '_' met I (zonder NS International), R (zonder rit-opslag) of w<min> (extra tijd in minuten); kort vanwege de padlengte (#118).";
	parameter<bool>     IsMerged                                   := /ModelParameters/MergeOutput, Descr = "Voegt deze run de Components samen (MergeOutput)?";
	parameter<bool>     WithPT                                     := !IsMerged && /ModelParameters/Component == 'PT', Descr = "Doen de OV-ketens mee in deze run (Advanced/Components/WithPT)? Niet bij een directe rit en niet bij het samenvoegen.";
	parameter<string>   ComponentName                             := /ModelParameters/Component == 'PT' ? Advanced/PreTransportTypes/code[rlookup(/ModelParameters/PreTransport, Advanced/PreTransportTypes/TimeInvariantTypes_rel)] + '_PT_' + Advanced/PostTransportTypes/code[rlookup(/ModelParameters/PostTransport, Advanced/PostTransportTypes/TimeInvariantTypes_rel)] : /ModelParameters/Component
	,	Descr = "De naam van de component van deze run: WW, CC, Car, of bij Component 'PT' <PreTransport>_PT_<PostTransport> uit PreTransport en PostTransport, bijvoorbeeld W_PT_W of C_RM_PT_OVf_C.", IntegrityCheck = "IsDefined(rlookup(this, Advanced/Components/name))";
	parameter<string>   Component_PreTransport                   := TimeInvariantTypes/name[/ModelParameters/PreTransport], Descr = "De naam van het voortransporttype (/ModelParameters/PreTransport); bij een directe rit niet gebruikt.";
	parameter<string>   Component_PostTransport                     := TimeInvariantTypes/name[/ModelParameters/PostTransport], Descr = "De naam van het natransporttype (/ModelParameters/PostTransport); bij een directe rit niet gebruikt.";
	parameter<bool>     SingleDepartureMoment                          := !IsMerged && rjoin(ComponentName, Advanced/Components/name, Advanced/Components/SingleDepartureMoment_Eff), Descr = "Rekent deze run een vertrekmoment, dat van het congestiemoment (Advanced/Components/SingleDepartureMoment; de directe ritten, Car niet met CarTimeDependent)?";
	parameter<uint32>   CongestionMinute                          := MakeDefined(uint32(substr(rjoin(rjoin(/ModelParameters/PartOfDay, Advanced/PartsOfDay/name, Advanced/PartsOfDay/CongestionMoment), Advanced/CongestionTimes/name, Advanced/CongestionTimes/Time), 2, 2)), 30), Descr = "De minuut van het congestiemoment van het PartOfDay (Advanced/CongestionTimes/Time, bij de ochtendspits 0730): het vertrekmoment van een component met SingleDepartureMoment.";
	parameter<string>   SingleDepartureMoment_Shrt                     := (rjoin(/ModelParameters/PartOfDay, Advanced/PartsOfDay/name, Advanced/PartsOfDay/DepartureHour) < 10 ? '0' : '') + string(rjoin(/ModelParameters/PartOfDay, Advanced/PartsOfDay/name, Advanced/PartsOfDay/DepartureHour)) + 'h' + (SingleDepartureMoment_Minute < 10 ? '0' : '') + string(SingleDepartureMoment_Minute) + 'm', Descr = "De korte naam van dat vertrekmoment, als Time/TemplatableTextShrt (07h30m): zo heet het bestand per blok van een component met SingleDepartureMoment, dat ComponentMerge voor elk vertrekmoment leest.";
	parameter<uint32>   SingleDepartureMoment_Minute                   := IsODMoment ? OD_Minute : CongestionMinute, Descr = "De minuut van het ene vertrekmoment van een component met SingleDepartureMoment: CongestionMinute, of bij een HB-paar met OD_DepartureTime dat (OD_Minute).";
	parameter<uint32>   BlocksPerPortion                          := IsMerged ? 10 : rjoin(ComponentName, Advanced/Components/name, Advanced/Components/BlocksPerPortion), Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap van deze run (Advanced/Components/BlocksPerPortion); bij het samenvoegen 10: in een opvraging ongeveer 7 GB per blok.";
	unit<uint8> DirectModes_Selected := select_with_attr_by_cond(Advanced/DirectModes, Advanced/DirectModes/Allowed), Descr = "De toegestane directe modaliteiten.";
	parameter<string>   Direct_str                                := asList(DirectModes_Selected/abbrev + DirectModes_Selected/abbrev, ',')
	,	Descr = "De directe modaliteiten zoals ze in de handtekening staan (V-<Direct_str>,<PreTransport>_N-<PostTransport>): WW, CC en/of AA, in de volgorde van Advanced/DirectModes."
	,	IntegrityCheck = "Direct_str != '' || WithPT || IsMerged" // minstens een van AllowDirectWalking/Cycling/Car, behalve met OV (sinds 2026-10-19 de _OVf-Components: alleen ketens, Direct_OD leeg via PublicTransport_Prep/HasDirectTI) en bij Merged
	;
	parameter<bool>     PriceExportsAndIntegrityChecksNeeded      := IsDefined(strpos(lowercase(Advanced/MinimiseCriteria), 'price')) || Export_PriceInformation;
	parameter<km>       CarFrontMaxDistance                       := value(MaxCarTime / 1[min_f] * 2.5f, km), Descr = "De grens op het eerste criterium van de zoektocht op afstand eerst (Advanced/CarFrontEpsilon), die de engine verplicht stelt: de afstand die in MaxCarTime met 150 km/u te halen is, zodat hij niets afsnijdt; de echte grens is MaxCarTime op de reistijd, het tweede criterium.";
	parameter<string>   Car_PriceTag                              := AllowDirectCar ? '_car' + (Advanced/IncludeCarCostsInPrice ? string(round(Car_CostPerKm * 100f)) + 'ctkm' + (Car_FixedCosts_PerTrip > 0[Euro] ? '-p' + string(round(Car_FixedCosts_PerTrip * 100f)) + 'ct' : '') : '0') : '', Descr = "Deel van de handtekening van de OV-uitvoer (PT_Output_ParamTag, #88): de prijs van de directe autorit, in ct per km en, als dat niet 0 is, per rit; _car0 als Advanced/IncludeCarCostsInPrice uit staat. De autostore bevat alleen reistijd en afstand, dus de prijs staat niet in zijn handtekening.";
	parameter<string>   ChainPareto_FileTag                       := Advanced/ChainParetoTimeEpsilon > 0f ? '_chainrel' + string(Advanced/ChainParetoTimeEpsilon * 100f) + 'pct' : '', Descr = "Deel van de handtekening van de ketenstore en van de OV-uitvoer: de relatieve epsilon op de reistijd in procenten, leeg als die 0 is.";
	parameter<string>   PT_Chains_ParamTag                       :=
		  '_' + lowercase(PriceMethod_effective)
		+ (Advanced/NS_TariffChoice == 'Price_20pct_Discount' ? '-ns20' : (Advanced/NS_TariffChoice == 'Price_40pct_Discount' ? '-ns40' : ''))
		+ (PriceExportsAndIntegrityChecksNeeded ? '' : '-noprice')
		+ '_ov' + string(round(Advanced/MaxTransferDist)) + '-' + string(round(Advanced/TransferEffectiveSpeed * 3600f)) + '-' + string(round(Transfer_Walking_Time_Costs * 100f)) + '-' + string(round(Transfer_Waiting_Time_Costs * 100f)) + '-' + string(round(Advanced/GradeSeparatedTransferPenalty)) + '-' + string(round(Advanced/MaxTransferTimeForBoardingSurcharge))
		+ '_h' + string(round(Advanced/DistanceStopClusters)) + '-' + string(round(Advanced/DistanceTrainStationsSelection))
		+ '_v' + string(round(PT_Max_V_Time))
		+ (Advanced/IFF_Overstaptijd ? '_iff' + Advanced/IFF_file_date : '')
	, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/PT_Chains_Signature) met de parameters waar de ketens van afhangen en die de rest van de handtekening niet noemt: de prijsmethode (dova of detailed, met -ns20/-ns40 bij NS-korting en -noprice als de prijzen niet worden bewaard), _ov<Advanced/MaxTransferDist m>-<Advanced/TransferEffectiveSpeed m/uur>-<Transfer_Walking_Time_Costs ct/min>-<Transfer_Waiting_Time_Costs ct/min>-<Advanced/GradeSeparatedTransferPenalty min>-<Advanced/MaxTransferTimeForBoardingSurcharge min> en _h<Advanced/DistanceStopClusters m>-<Advanced/DistanceTrainStationsSelection m>. Het prijsjaar volgt uit GTFS_file_date, dat de handtekening noemt als het van Analysis_date afwijkt.";
	parameter<string>   CarNetwork_Revision                       := '_r3'
	, Descr = "Revisie van het TomTom-autonet in de handtekening van de autostores (en zo in de hash in hun naam): verhoog hem bij elke codewijziging die het autonet verandert, anders wordt de oude store gelezen. Wat per revisie veranderde, staat in de commits en in #88.";
	parameter<string>   PT_Chains_Revision                       := '_r12'
	, Descr = "Revisie van de ketenopbouw in de handtekening van de ketenstore (en zo in de hash in zijn naam): verhoog hem bij elke codewijziging die de ketens verandert, anders wordt de oude store gelezen. Wat per revisie veranderde, staat in de commits en in de issues.";
	parameter<string>   ParetoLegs_Car_FileTag                    := Advanced/ParetoLegs_Car ? '_paretoCar' + (Advanced/CarFrontEpsilon > 0f ? 'D-r'+string(Advanced/CarFrontEpsilon * 100f)+'pct' : (Advanced/CarLegDistanceQuantum > 0[km] ? 'q'+string(round(Advanced/CarLegDistanceQuantum * 1000f))+'m' : '')) : '', Descr = "Deel van de handtekening van de autostores en van de OV-uitvoer, want het front met de directe autorit hangt van deze parameters af (#88): 'D-r1pct', afstand eerst met de relatieve epsilon in procenten, of de kwantisatie in m; leeg als Advanced/ParetoLegs_Car uit staat.";
	parameter<string>   CyclingNetwork_FileTag                    := Advanced/CyclingNetwork == 'OSM' ? '' : '_fb' + Advanced/Fietsersbond_file_date + '-veer' + string(round(Advanced/Fietsersbond_MaxVeerpontLengte / 1[m])) + 'm' + string(round(Advanced/Fietsersbond_VeerpontExtraTijd / 1[min_f])) + 'min', Descr = "In de handtekening van de OV-uitvoer als een fietsbeen of de directe fietsrit meedoet (PT_Output_ParamTag); leeg met OSM.";
	parameter<string>   CyclingNetwork_DirTag                     := Advanced/CyclingNetwork == 'Fietsersbond' ? '_fb' : '', Descr = "Achter de naam van de uitvoermap van een component over het fietsnet (Advanced/Components/OutputSuffix): '_fb' met de Fietsersbond, leeg met OSM, zodat de uitvoer over beide netten naast elkaar staat; WW, W_PT_W en Car hebben een map voor beide (#124).";
	parameter<string>   OrgSet_SelectionTag                       := IsOD ? '-' + lowercase(/ModelParameters/OD_Origin) : switch(case(lowercase(Orgset) == 'buurt_enkele_buurt', '-' + lowercase(Orgset_EnkeleBuurt_Selection)), case(lowercase(Orgset) == 'buurt_enkele_gemeente' || lowercase(Orgset) == 'gemeente_enkele_gemeente', '-' + lowercase(Orgset_EnkeleGem_Selection)), case(lowercase(Orgset) == 'buurt_enkele_prov', '-' + lowercase(Orgset_EnkeleProv_Selection)), case(lowercase(Orgset) == 'buurt_enkele_corop', '-' + lowercase(Orgset_EnkeleCorop_Selection)), '')
	, Descr = "Het gekozen gebied van een enkele-gebied-herkomstenset in de bestandsnamen, zodat twee selecties geen autostore of uitvoerbestand delen. Bij een HB-paar (IsOD) de herkomst, zodat ook de handtekeningen het paar noemen en WalkingMirror niet geldt.";
	parameter<string>   DestSet_SelectionTag                      := IsOD ? '-' + lowercase(/ModelParameters/OD_Destination) : switch(case(lowercase(Destset) == 'buurt_enkele_buurt', '-' + lowercase(Destset_Enkele_Selection)), case(lowercase(Destset) == 'buurt_enkele_prov', '-' + lowercase(Destset_EnkeleProv_Selection)), case(lowercase(Destset) == 'buurt_enkele_corop', '-' + lowercase(Destset_EnkeleCorop_Selection)), '')
	, Descr = "Het gekozen gebied van een enkele-gebied-bestemmingenset in de bestandsnamen; bij een HB-paar (IsOD) de bestemming.";
	parameter<string>   DestSet_DateTag                           := lowercase(Destset) == 'ov_knooppunten' ? '_' + Analysis_date + (GTFS_file_date == Analysis_date ? '' : '_gtfs' + GTFS_file_date) : ''
	, Descr = "Datum van de bestemmingsset in de bestandsnamen, als die uit de dienstregeling volgt: de OV-knooppunten hangen af van de feed en van de vertrekken op Analysis_date, dus een andere datum krijgt een eigen autostore.";
	parameter<string>   DestSet_string_nodate                     := (Advanced/Dests_geclusterd ? lowercase(Destset) + '_' + lowercase(Advanced/Dest_location_scale) : lowercase(Destset)) + DestSet_SelectionTag
	, Descr = "De bestemmingsset zonder DestSet_DateTag, in de handtekening van de OV-uitvoer (PT_Output_ParamTag), die Analysis_date al noemt.";
	parameter<string>   PT_CombinationType                        := 'V-' + Direct_str + (WithPT ? (Direct_str != '' ? ',' : '') + asList(OV_PreTransport_Typen/ExportName, ',') + '_N-' + asList(OV_PostTransport_Typen/ExportName, ',') : '')
	, Descr = "De directe modaliteiten en de voor- en PostTransportTypes zoals ze in de handtekening van de OV-uitvoer staan; zonder OV (Car) alleen de directe modaliteiten.";
	parameter<bool>     UsesCycling                               := AllowDirectCycling || (WithPT && (IsDefined(strpos(Component_PreTransport, 'Cycling')) || IsDefined(strpos(Component_PostTransport, 'Cycling'))))
	, Descr = "Doet een fietsbeen of de directe fietsrit mee? Dan noemt de handtekening van de OV-uitvoer het fietsnet (CyclingNetwork_FileTag).";
	parameter<string>   PT_Output_ParamTag                        := '_DEST-' + DestSet_string_nodate + '_' + PT_CombinationType + (WithPT ? '_Trsf-' + string(Max_transfers) : '') + '_MinCrit-' + asList(/Classifications/OutputParetoAttr/FileNameElement, '_') + (WithPT ? '_MaxPT-' + string(/ModelParameters/MaxPTTime) + 'min' + Flex_FileTag + TripSurcharge_FileTag : '') + (AllowDirectCar ? ParetoLegs_Car_FileTag : '') + Car_PriceTag + ChainPareto_FileTag + (WithPT && IsDefined(strpos(Component_PostTransport, 'OVF')) ? OVFiets_FileTag : '') + (UsesCycling ? CyclingNetwork_FileTag : '')
	, Descr = "De parameters van de OV-uitvoer na datum en herkomstset, voor de handtekening van de uitvoer (NetworkSetup/GenerateOutput/Output_Signature, #118): bestemmingenset, modaliteiten, criteria en de tags; de OV-tags (overstappen, MaxPT, flex, rit-opslag) alleen als het OV meedoet, de autotags alleen als de directe autorit meedoet (#117).";
	parameter<string>   DestSet_string                            := (Advanced/Dests_geclusterd 
																		? lowercase(Destset) + '_' + lowercase(Advanced/Dest_location_scale)
																		: lowercase(Destset)) + DestSet_SelectionTag + DestSet_DateTag, Descr = "De bestemmingsset zoals hij in de bestandsnamen staat, met DestSet_SelectionTag en DestSet_DateTag."; 
	parameter<string>   OrgSet_string                             := (strcount(Orgset, 'Clustered') > 0
												? lowercase(Orgset) + '_' + lowercase(Advanced/Org_location_scale)
												: lowercase(Orgset)) + OrgSet_SelectionTag
	,	Descr = "De herkomstenset zoals hij in de bestandsnamen staat, met OrgSet_SelectionTag bij een enkel gebied. Bij een geclusterde set hoort de celmaat erbij, anders overschrijft een 500m-run de uitvoer van een 100m-run, net zoals DestSet_string dat voor de bestemmingen doet.";
	parameter<string>   OrgSet_PathTag                            := replace(OrgSet_string, 'buurt', 'b'), Descr = "De herkomstenset in de namen van stores en bestanden, kort voor de padlengte: OrgSet_string met b voor buurt, bijvoorbeeld b2025 voor buurt2025. De handtekeningen houden OrgSet_string.";
	parameter<string>   DestSet_PathTag                           := replace(DestSet_string, 'buurt', 'b'), Descr = "De bestemmingenset in de namen van stores en bestanden: DestSet_string met b voor buurt. De handtekeningen houden DestSet_string.";
	parameter<string>   OrgSet_NameTag                            := UpperCase(substr(OrgSet_PathTag, 0, 1)) + substr(OrgSet_PathTag, 1, strlen(OrgSet_PathTag)), Descr = "De herkomstenset in de naam van een benen-store, met een hoofdletter: Legs_B2025toStops_Walking.";
	parameter<string>   DestSet_NameTag                           := UpperCase(substr(DestSet_PathTag, 0, 1)) + substr(DestSet_PathTag, 1, strlen(DestSet_PathTag)), Descr = "De bestemmingenset in de naam van een benen-store, met een hoofdletter: Legs_Stops2B2025_Walking.";
	
	unit<uint8> OV_PreTransport_Typen := select_with_org_rel(TimeInvariantTypes/name == Component_PreTransport)
	, Descr = "Het voortransporttype van deze run: dat van Component (Advanced/Components/PreTransport, #117). RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
	{
		attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
		attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
		attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
		attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
		attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
		
		attribute<string> StopClass_  := StopClass != '' ? '_'+StopClass : '';
		attribute<string> ExportName  := Mode_abbrev + StopClass_;
	}
	unit<uint8> OV_PostTransport_Typen := select_with_org_rel(TimeInvariantTypes/name == Component_PostTransport)
	, Descr = "Het natransporttype van deze run: dat van Component (Advanced/Components/PostTransport, #117). RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
	{
		attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
		attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
		attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
		attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
		attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
		
		attribute<string> StopClass_  := StopClass != '' ? StopClass+'_' : '';
		attribute<string> ExportName  := StopClass_ + Mode_abbrev;
	}
	unit<uint8> PT_DepartureMinutes := range(uint8, 0b, SingleDepartureMoment || IsODMoment ? 1b : uint8(#Advanced/PT_DepartureMinutes_All))
	, Descr = "De minuten van de vertrekmomenten van deze run: alle van Advanced/PT_DepartureMinutes_All, bij SingleDepartureMoment alleen die van het congestiemoment (CongestionMinute, #132), en bij een HB-paar met OD_DepartureTime alleen dat (OD_Minute, #129), ook voor een component met SingleDepartureMoment."
	{
		attribute<uint32> values := IsODMoment ? const(OD_Minute, .) : SingleDepartureMoment ? const(CongestionMinute, .) : Advanced/PT_DepartureMinutes_All/values[value(id(.), Advanced/PT_DepartureMinutes_All)];
	}
	
	unit<uint32> SampleDay := select_with_attr_by_org_rel(Time, Time/Day = 0) //Hier worden de analyse tijdstippen opgegeven. LET OP: Verander je deze dan zul je ook de NDW_meetmomenten/time moeten aanpassen. En de ChosenMoments ook wanneer er meer/minder momenten opgegeven zijn.
	, Descr = ""
	{
		attribute<bool>    ChosenMoments   := =asList(HoursMinutes/str,' || ');
		attribute<Time>    Time_rel        := org_rel;
		unit<uint8> ChosenHours    := Advanced/PT_DepartureHours;
		unit<uint8> ChosenMinutes  := PT_DepartureMinutes;
		unit<uint8> HoursMinutes   := combine_uint8(ChosenHours, ChosenMinutes)
		{
			attribute<uint32> Hours     := ChosenHours/values[first_rel];
			attribute<uint32> Minutes   := ChosenMinutes/values[second_rel];
			attribute<string> str       := '(hour == '+string(Hours)+' && minute == '+string(Minutes)+' && second == 0)';
		}
	}
	
	unit<uint32> MeasureMoments := select_with_attr_by_cond(SampleDay, SampleDay/ChosenMoments)
	, Descr = ""
	{
		attribute<Time>    Moment := Time_rel;
		attribute<string>  Name   := Time/TemplatableText[Moment];
	}
}
