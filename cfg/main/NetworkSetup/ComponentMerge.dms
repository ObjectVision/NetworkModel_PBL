container ComponentMerge_Def
: Descr = "The components, the signature and the folder of the merge (#117, #145), kept apart from ComponentMerge because ModelParameters/Impl/OutputDir and the writers there request this folder and signature."
{
	unit<uint8>       Comps              := /ModelParameters/Impl/VariantComponents
	,	Descr = "The components that are merged: those of the variant, in the order of Classifications/Components.";
	parameter<string> BaseDir            := '%LocalDataProjDir%/Output' + /ModelParameters/Impl/OD_Tag + '/' + /ModelParameters/Impl/Analysis_date + '_' + /ModelParameters/OutputLabel
	,	Descr = "The output folder of the variant without the suffix of the merge.";

	// The output of every component: its signature, hash and folder as its own run computes them (NetworkSetup/GenerateOutput/CompOutput_T). The
	// merge reads a component only when the signature.txt in its folder equals that signature (CompDir), so that output with other settings or
	// with the parquet of before #144 is never merged.
	container         PerComp            := for_each_ne(Comps/name, '/NetworkSetup/GenerateOutput/CompOutput_T(' + quote(Comps/name) + ')');
	attribute<string> CompDir (Comps)    := ='union_data(Comps, ' + asList('PerComp/' + Comps/name + '/Sig/ForReading', ', ') + ')'
	,	Descr = "The output folder of every component; an error names the component whose signature.txt is missing or differs, which then has not been calculated with the current settings.";

	// The mode of the pre- and post-transport of every component (Classifications/Components/PreNetworkType, PostNetworkType), for the split
	// per mode in MergeMoment_T (#144).
	attribute<bool>   PreIsWalking  (Comps) := Comps/PreNetworkType == 'Walking';
	attribute<bool>   PreIsCycling  (Comps) := Comps/PreNetworkType == 'Cycling';
	attribute<bool>   PreIsCar      (Comps) := Comps/PreNetworkType == 'Car';
	attribute<bool>   PostIsWalking (Comps) := Comps/PostNetworkType == 'Walking';
	attribute<bool>   PostIsCycling (Comps) := Comps/PostNetworkType == 'Cycling';

	parameter<string> CompHashes         := =asList('''[' + Comps/name + ':'' + PerComp/' + Comps/name + '/Hash/Hex + '']''', ' + ')
	,	Descr = "The components with the hash of the signature of their output, each as [name:hash]; the full signatures are in the folders of the components, and in full they would make the signature too long for the hash.";
	parameter<string> Signature          :=
		  'tt_' + /ModelParameters/Impl/Analysis_date + '_ORG-' + /ModelParameters/Impl/OrgSet_string
		+ '_samen-' + asList(Comps/name, ',')
		+ '_MinCrit-' + asList(/Classifications/OutputParetoAttr/FileNameElement, '_') + /ModelParameters/Impl/ChainPareto_FileTag
		+ '_' + /ModelParameters/OutputFormat + '-m6'
		+ '_' + CompHashes
	,	Descr = "The signature of the merged output: date, set of origins, Components, criteria (MergeCriteria) and epsilons, format (-m6: read from the parquet of the Components, with the times in whole seconds, the split per part and per mode of #144 and that of the public transport time of #146; written with the times in minutes as float32, #149) and the hashes of the signatures of the Components, so that it changes when a component is calculated with other settings.";
	container         Hash               := /Templates/StringHash_T(Signature);
	parameter<string> Dir                := BaseDir + '_Merged' + string(/ModelParameters/MergeRunNr) + (any(Comps/UsesCycling) ? /ModelParameters/Impl/CyclingNetwork_DirTag : '') + '_' + Hash/Hex
	,	Descr = "The output folder of the merge (#145): _Merged<MergeRunNr>, with _fb when a component cycles on the Fietsersbond network, and the hash of Signature.";
}

// MERGING THE COMPONENTS OF THE VARIANT (#117). Per origin block and departure moment it reads the parquet of the components
// (Output/<Analysis_date>_<OutputLabel>_<component>_<hash>/PerBlock, ComponentMerge_Def/CompDir), each with the columns of its kind (Classifications/Components/ExportClass), and fills
// in what is constant there or follows from the columns:
// - WW and CC: the price from the travel time (Direct_Walking_Time_Costs, Direct_Cycling_Time_Costs, as in PublicTransport_Prep/Direct),
//   ModeUsed WW or CC; they apply to every departure moment (SingleDepartureMoment);
// - Car: the price from the distance (Car_FixedCosts_PerTrip + Car_CostPerKm), ModeUsed AA;
// - a direct trip is its own pre-transport, as in the csv of a component: PretransTime, TravelDist_V and PretransPrice hold its time, distance
//   and price;
// - a public transport component: everything is in the file.
// Then per OD pair the rows that are not dominated on the criteria of the merge (Classifications/OutputParetoAttr, from
// ModelParameters/MergeCriteria), with the same epsilons and operator (pareto_optimal_eps) as in a run, with price and time in Ct and s;
// NeedsCar and NeedsBike follow from the component (Classifications/Components). Of the rows that stay it splits time, price and distance per
// part and per mode, as the csv of a component does (#144): PTTime, PTPrice and TravelDist_PT, and per mode walking, cycling and car from
// the pre- and post-transport with that mode. The result is written in ModelParameters/OutputFormat, csv or parquet, to
// Output/<Analysis_date>_<OutputLabel>_Merged<MergeRunNr>_<hash>/PerBlock (ComponentMerge_Def/Dir), with the column Component (where the row comes from), and the counts per
// block to Tellingen (GenerateOutput/OD_Counts_FromFiles adds them up).
container ComponentMerge
: Descr = "Merges the components of the variant into one Pareto front from their parquet, as the comment above describes; Generate, or batch/UpdateAll.cmd with the component Merged runs it."
{
	container         PerBlock                  := for_each_ne(/NetworkSetup/impl/OrgBlockDomain/name, 'MergeBlock_T(' + string(id(/NetworkSetup/impl/OrgBlockDomain)) + ')');
	parameter<string> Generate                  := =asList('PerBlock/' + /NetworkSetup/impl/OrgBlockDomain/name + '/Fence/Generate', ' + ')
	,	Descr = "Merges all blocks and departure moments, one block per phase, so that its intermediate results are freed afterwards.";
	parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';

	Template MergeBlock_T : Descr = "The merge of one origin block over all departure moments, with the counts of the block."
	{
		parameter</NetworkSetup/impl/OrgBlockDomain> BlockDomain_id;
		///
		parameter<string> BlockFile := /NetworkSetup/impl/OrgBlockDomain/FileName[BlockDomain_id];
		container Work
		{
			container         PerMoment := for_each_ne(/ModelParameters/Impl/MeasureMoments/Name, 'MergeMoment_T(' + quote(/ModelParameters/Impl/MeasureMoments/Name) + ')');

			// The counts of this block, Tellingen/tellingen_<n>of<N>.csv, as a component run writes them (PublicTransport/Generate_Output/
			// Traveltime_ForEachDepTime/Counts): rows per kind and unique OD pairs per group, per departure moment, and the pairs over all moments.
			container Counts
			{
				unit<uint32> AllPairs := ='union_unit(' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs', ',') + ')'
				{
					attribute<string> OrgDest              := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/values', ',') + ')';
					attribute<bool>   PT_chain             := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/PT_chain', ',') + ')';
					attribute<bool>   WW                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/WW', ',') + ')';
					attribute<bool>   CC                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/CC', ',') + ')';
					attribute<bool>   AA                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/AA', ',') + ')';
					attribute<bool>   without_car          := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/without_car', ',') + ')';
					attribute<bool>   without_car_and_bike := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/without_car_and_bike', ',') + ')';
				}
				unit<uint32>           UniquePairs           := unique(AllPairs/OrgDest);
				attribute<UniquePairs> Unique_rel (AllPairs) := rlookup(AllPairs/OrgDest, UniquePairs/values);
				attribute<uint64>      PairCounts_AllMoments (/Classifications/OD_Counts_Group) := union_data(/Classifications/OD_Counts_Group
				                                                                                   , uint64(#UniquePairs)
				                                                                                   , sum_uint64(any(AllPairs/PT_chain, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/WW, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/CC, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/AA, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/without_car, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/without_car_and_bike, Unique_rel)));
				attribute<uint64>      RowCounts_Total (/Classifications/OD_Counts_Kind) := =asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/RowCounts', ' + ');
				attribute<string>      RowCountsLine (/Classifications/OD_Counts_Kind) := ='''rijen;'' + /Classifications/OD_Counts_Kind/label + ' + asList(''';'' + string(PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/RowCounts)', ' + ') + ' + '';'' + string(RowCounts_Total)';
				attribute<string>      PairCountsLine (/Classifications/OD_Counts_Group) := ='''paren;'' + /Classifications/OD_Counts_Group/label + ' + asList(''';'' + string(PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/PairCounts)', ' + ') + ' + '';'' + string(PairCounts_AllMoments)';
				parameter<string>      File                  := 'tabel;naam;' + asList(/ModelParameters/Impl/MeasureMoments/TemplatableTextShrt, ';') + ';totaal\n' + asList(RowCountsLine, '\n') + '\n' + asList(PairCountsLine, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Impl/OutputDir + '/Tellingen/tellingen_' + BlockFile + '.csv'", StorageType = "str"
				,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			}
			parameter<string> Generate  := 'Ready', ExplicitSuppliers = "=asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Write', ';') + ';Counts/File'"
			,	Descr = "Writes the merged output per departure moment and the counts of the block, and returns only 'Ready'.";
		}
		container         Fence     := PhaseContainer(Work, 'Samengevoegd: ' + /NetworkSetup/impl/OrgBlockDomain/name[BlockDomain_id]);

		Template MergeMoment_T : Descr = "The merge of one departure moment of the block: reads the files of the Components, keeps the Pareto front per OD pair and writes it."
		{
			parameter<string> Moment;
			///
			parameter<string> MomentShort                         := rjoin(Moment, /ModelParameters/Impl/MeasureMoments/Name, /ModelParameters/Impl/MeasureMoments/TemplatableTextShrt);
			parameter<string> FileTail                            := '_' + MomentShort + '_' + BlockFile
			,	Descr = "The name of the file after tt, without extension: tt_<moment>_<n>of<N>; the date and the component or merge are in the name of the folder.";

			// The file of every component in this block and departure moment; a component with SingleDepartureMoment (WW, CC, and Car without
			// CarTimeDependent) has one per block, that of the congestion moment, which applies to every departure moment.
			attribute<string> CompFile (ComponentMerge_Def/Comps) := ComponentMerge_Def/CompDir + '/PerBlock/tt_'
			                                                         + (ComponentMerge_Def/Comps/SingleDepartureMoment_Eff ? /ModelParameters/Impl/SingleDepartureMoment_Shrt : MomentShort) + '_' + BlockFile + '.parquet';
			container         PerComp                             := for_each_ne(ComponentMerge_Def/Comps/name
			                                                         , 'Read' + ComponentMerge_Def/Comps/ExportClass + '_T(' + quote(ComponentMerge_Def/Comps/name) + ', ' + string(id(ComponentMerge_Def/Comps)) + 'b)'); // b: Comps is uint8

			// Per kind of component (Classifications/Components/ExportClass) a reader that reads the columns of its writer (PerDepartureMoment_T,
			// CreateExports/LongFormat/Parquet_<ExportClass>) and completes the others to the common schema.
			// WW and CC: OrgName, DestName, Traveltime, TravelDist_V.
			Template ReadDirect_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<s>       Traveltime;
					attribute<uint32>  TravelDist_V;
				}
				parameter<bool>   IsWalking                 := CompName == 'WW';
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<s>      Traveltime       (domain) := domain/Traveltime;
				// As in PublicTransport_Prep/Direct: the costs per minute (Direct_*_Time_Costs), which count in Price only with Include*CostsInPrice.
				attribute<Euro>   Price_Augm       (domain) := convert(rounded_convert(convert(Traveltime, min_f) * (IsWalking ? /ModelParameters/Direct_Walking_Time_Costs : /ModelParameters/Direct_Cycling_Time_Costs), Ct), Euro);
				attribute<Euro>   Price            (domain) := (IsWalking ? /ModelParameters/Advanced/IncludeWalkingCostsInPrice : /ModelParameters/Advanced/IncludeCyclingCostsInPrice) ? Price_Augm : const(0[Euro], domain);
				attribute<string> ModeUsed         (domain) := const(CompName, domain);
				attribute<uint8>  NeedsCar         (domain) := const(0b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(ComponentMerge_Def/Comps/NeedsBike[Comp_id] ? 1b : 0b, domain);
				attribute<s>      WaitingTime      (domain) := const(0[s], domain);
				attribute<s>      PretransTime     (domain) := Traveltime;
				attribute<s>      PosttransTime    (domain) := const(0[s], domain);
				attribute<uint32> TravelDist_Bus   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Metro (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Tram  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Rail  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Ferry (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Car   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_V     (domain) := domain/TravelDist_V;
				attribute<uint32> TravelDist_N     (domain) := const(0, domain, uint32);
				attribute<Euro>   PretransPrice    (domain) := Price;
				attribute<Euro>   PosttransPrice   (domain) := const(0[Euro], domain);
				attribute<s>      TransferWalkTime (domain) := const(0[s], domain);
				attribute<s>      PTWaitTime       (domain) := const(0[s], domain);
			}
			// Car: OrgName, DestName, Traveltime, TravelDist_Car.
			Template ReadCar_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<s>       Traveltime;
					attribute<uint32>  TravelDist_Car;
				}
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<s>      Traveltime       (domain) := domain/Traveltime;
				// As in PublicTransport_Prep/Direct/Car: Car_FixedCosts_PerTrip + distance x Car_CostPerKm; the distance is in whole metres in the file.
				attribute<Euro>   Price            (domain) := /ModelParameters/Advanced/IncludeCarCostsInPrice ? convert(rounded_convert(/ModelParameters/Car_FixedCosts_PerTrip + value(float32(domain/TravelDist_Car) / 1000f, km) * /ModelParameters/Car_CostPerKm, Ct), Euro) : const(0[Euro], domain);
				attribute<Euro>   Price_Augm       (domain) := Price;
				attribute<string> ModeUsed         (domain) := const('AA', domain);
				attribute<uint8>  NeedsCar         (domain) := const(1b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(0b, domain);
				attribute<s>      WaitingTime      (domain) := const(0[s], domain);
				attribute<s>      PretransTime     (domain) := Traveltime;
				attribute<s>      PosttransTime    (domain) := const(0[s], domain);
				attribute<uint32> TravelDist_Bus   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Metro (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Tram  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Rail  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Ferry (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Car   (domain) := domain/TravelDist_Car;
				attribute<uint32> TravelDist_V     (domain) := domain/TravelDist_Car;
				attribute<uint32> TravelDist_N     (domain) := const(0, domain, uint32);
				attribute<Euro>   PretransPrice    (domain) := Price;
				attribute<Euro>   PosttransPrice   (domain) := const(0[Euro], domain);
				attribute<s>      TransferWalkTime (domain) := const(0[s], domain);
				attribute<s>      PTWaitTime       (domain) := const(0[s], domain);
			}
			// A public transport component: the columns of Parquet_PT; NeedsBike follows from pre-transport and post-transport (Classifications/Components/NeedsBike).
			Template ReadPT_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<s>       Traveltime;
					attribute<float32> Price;
					attribute<float32> Price_Augm;
					attribute<string>  ModeUsed;
					attribute<s>       WaitingTime;
					attribute<s>       PretransTime;
					attribute<s>       PosttransTime;
					attribute<uint32>  TravelDist_Bus;
					attribute<uint32>  TravelDist_Metro;
					attribute<uint32>  TravelDist_Tram;
					attribute<uint32>  TravelDist_Rail;
					attribute<uint32>  TravelDist_Ferry;
					attribute<uint32>  TravelDist_V;
					attribute<uint32>  TravelDist_N;
					attribute<float32> PretransPrice;
					attribute<float32> PosttransPrice;
					attribute<s>       TransferWalkTime;
					attribute<s>       PTWaitTime;
				}
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<s>      Traveltime       (domain) := domain/Traveltime;
				attribute<Euro>   Price            (domain) := value(domain/Price, Euro);
				attribute<Euro>   Price_Augm       (domain) := value(domain/Price_Augm, Euro);
				attribute<string> ModeUsed         (domain) := domain/ModeUsed;
				attribute<uint8>  NeedsCar         (domain) := const(0b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(ComponentMerge_Def/Comps/NeedsBike[Comp_id] ? 1b : 0b, domain);
				attribute<s>      WaitingTime      (domain) := domain/WaitingTime;
				attribute<s>      PretransTime     (domain) := domain/PretransTime;
				attribute<s>      PosttransTime    (domain) := domain/PosttransTime;
				attribute<uint32> TravelDist_Bus   (domain) := domain/TravelDist_Bus;
				attribute<uint32> TravelDist_Metro (domain) := domain/TravelDist_Metro;
				attribute<uint32> TravelDist_Tram  (domain) := domain/TravelDist_Tram;
				attribute<uint32> TravelDist_Rail  (domain) := domain/TravelDist_Rail;
				attribute<uint32> TravelDist_Ferry (domain) := domain/TravelDist_Ferry;
				attribute<uint32> TravelDist_Car   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_V     (domain) := domain/TravelDist_V;
				attribute<uint32> TravelDist_N     (domain) := domain/TravelDist_N;
				attribute<Euro>   PretransPrice    (domain) := value(domain/PretransPrice, Euro);
				attribute<Euro>   PosttransPrice   (domain) := value(domain/PosttransPrice, Euro);
				attribute<s>      TransferWalkTime (domain) := domain/TransferWalkTime;
				attribute<s>      PTWaitTime       (domain) := domain/PTWaitTime;
			}

			unit<uint32> Rows := ='union_unit(' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/domain', ',') + ')'
			,	Descr = "The rows of all Components, in the order of Comps; with a tie on all criteria the first wins (pareto_optimal_eps)."
			{
				attribute<string> OrgName          := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/OrgName', ',') + ')';
				attribute<string> DestName         := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/DestName', ',') + ')';
				attribute<s>      TravelTime       := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Traveltime', ',') + ')';
				attribute<Euro>   Price_euro       := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Price', ',') + ')';
				attribute<Euro>   Price_Augm_euro  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Price_Augm', ',') + ')';
				attribute<string> ModeUsed         := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/ModeUsed', ',') + ')';
				attribute<uint8>  NeedsCar_u8      := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/NeedsCar', ',') + ')';
				attribute<uint8>  NeedsBike_u8     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/NeedsBike', ',') + ')';
				attribute<s>      WaitingTime      := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/WaitingTime', ',') + ')';
				attribute<s>      PretransTime     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PretransTime', ',') + ')';
				attribute<s>      PosttransTime    := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PosttransTime', ',') + ')';
				attribute<uint32> TravelDist_Bus   := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Bus', ',') + ')';
				attribute<uint32> TravelDist_Metro := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Metro', ',') + ')';
				attribute<uint32> TravelDist_Tram  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Tram', ',') + ')';
				attribute<uint32> TravelDist_Rail  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Rail', ',') + ')';
				attribute<uint32> TravelDist_Ferry := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Ferry', ',') + ')';
				attribute<uint32> TravelDist_Car   := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Car', ',') + ')';
				attribute<uint32> TravelDist_V     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_V', ',') + ')';
				attribute<uint32> TravelDist_N     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_N', ',') + ')';
				attribute<Euro>   PretransPrice_euro  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PretransPrice', ',') + ')';
				attribute<Euro>   PosttransPrice_euro := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PosttransPrice', ',') + ')';
				attribute<s>      TransferWalkTime := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TransferWalkTime', ',') + ')';
				attribute<s>      PTWaitTime       := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PTWaitTime', ',') + ')';
				attribute<ComponentMerge_Def/Comps> Comp_rel := ='union_data(., ' + asList('const(' + string(id(ComponentMerge_Def/Comps)) + '[ComponentMerge_Def/Comps], PerComp/' + ComponentMerge_Def/Comps/name + '/domain)', ',') + ')', Descr = "The component the row comes from.";

				// The criteria (Classifications/OutputParetoAttr) in the units of the final front, Ct and s, so that the epsilons work as in a run.
				attribute<Ct>     Price            := rounded_convert(Price_euro, Ct);
				attribute<Ct>     Price_augm       := rounded_convert(Price_Augm_euro, Ct);
				attribute<bool>   NeedsCar         := NeedsCar_u8 == 1b;
				attribute<bool>   NeedsBike        := NeedsBike_u8 == 1b;

				attribute<string> OrgDest          := OrgName + ';' + DestName;
				unit<uint32>      OD               := unique(OrgDest);
				attribute<OD>     OD_rel           := rlookup(OrgDest, OD/values);
				attribute<bool>   keep             := ='pareto_optimal_eps(OD_rel, ' + asList(/Classifications/OutputParetoAttr/ParetoArgs, ', ') + ')'
				,	Descr = "With one criterion (MergeCriteria 'Time' or 'Price') the one fastest or cheapest row per pair, because the first criterion has no epsilon.";
			}
			unit<uint32> Kept := select_with_org_rel(Rows/keep)
			{
				attribute<string> OrgName          := Rows/OrgName[org_rel];
				attribute<string> DestName         := Rows/DestName[org_rel];
				attribute<s>      Traveltime       := Rows/TravelTime[org_rel];
				attribute<Euro>   Price            := Rows/Price_euro[org_rel];
				attribute<Euro>   Price_Augm       := Rows/Price_Augm_euro[org_rel];
				attribute<string> ModeUsed         := Rows/ModeUsed[org_rel];
				attribute<uint8>  NeedsCar         := Rows/NeedsCar_u8[org_rel];
				attribute<uint8>  NeedsBike        := Rows/NeedsBike_u8[org_rel];
				attribute<s>      WaitingTime      := Rows/WaitingTime[org_rel];
				attribute<s>      PretransTime     := Rows/PretransTime[org_rel];
				attribute<s>      PosttransTime    := Rows/PosttransTime[org_rel];
				attribute<uint32> TravelDist_Bus   := Rows/TravelDist_Bus[org_rel];
				attribute<uint32> TravelDist_Metro := Rows/TravelDist_Metro[org_rel];
				attribute<uint32> TravelDist_Tram  := Rows/TravelDist_Tram[org_rel];
				attribute<uint32> TravelDist_Rail  := Rows/TravelDist_Rail[org_rel];
				attribute<uint32> TravelDist_Ferry := Rows/TravelDist_Ferry[org_rel];
				attribute<uint32> TravelDist_Car   := Rows/TravelDist_Car[org_rel];
				attribute<uint32> TravelDist_V     := Rows/TravelDist_V[org_rel];
				attribute<uint32> TravelDist_N     := Rows/TravelDist_N[org_rel];
				attribute<Euro>   PretransPrice    := Rows/PretransPrice_euro[org_rel];
				attribute<Euro>   PosttransPrice   := Rows/PosttransPrice_euro[org_rel];
				attribute<ComponentMerge_Def/Comps> Comp_rel := Rows/Comp_rel[org_rel];
				attribute<string> Component        := ComponentMerge_Def/Comps/name[Comp_rel];

				// The split per part and per mode (#144), as in the csv of a component (PerDepartureMoment_T/BlockResult): public transport is the
				// chain, including walking and waiting at transfers; walking, cycling and car are the pre- and post-transport with that mode, and a
				// direct trip, which is its own pre-transport. The wait at home belongs to none of them. The prices are split in Ct, so that the parts
				// add up to Price exactly.
				attribute<s>      PTTime           := Traveltime - PretransTime - PosttransTime - uint16(/ModelParameters/Advanced/IncludeWaitingAtHomeInTravelTime) * WaitingTime;
				attribute<s>      TransferWalkTime := Rows/TransferWalkTime[org_rel];
				attribute<s>      PTWaitTime       := Rows/PTWaitTime[org_rel];
				attribute<s>      InVehicleTime    := PTTime - TransferWalkTime - PTWaitTime, Descr = "The time in the vehicles of the chain: PTTime without the walking and waiting at transfers; 0 for a direct trip (#146).";
				attribute<Ct>     Price_ct         := Rows/Price[org_rel];
				attribute<Ct>     Price_V_ct       := rounded_convert(PretransPrice, Ct);
				attribute<Ct>     Price_N_ct       := rounded_convert(PosttransPrice, Ct);
				attribute<Euro>   PTPrice          := convert(Price_ct - Price_V_ct - Price_N_ct, Euro);
				attribute<uint32> TravelDist_PT    := TravelDist_Bus + TravelDist_Metro + TravelDist_Tram + TravelDist_Rail + TravelDist_Ferry;
				attribute<bool>   V_IsWalking      := ComponentMerge_Def/PreIsWalking[Comp_rel];
				attribute<bool>   V_IsCycling      := ComponentMerge_Def/PreIsCycling[Comp_rel];
				attribute<bool>   V_IsCar          := ComponentMerge_Def/PreIsCar[Comp_rel];
				attribute<bool>   N_IsWalking      := ComponentMerge_Def/PostIsWalking[Comp_rel];
				attribute<bool>   N_IsCycling      := ComponentMerge_Def/PostIsCycling[Comp_rel];
				attribute<uint32> TravelDist_Walking := (V_IsWalking ? TravelDist_V : 0u) + (N_IsWalking ? TravelDist_N : 0u);
				attribute<uint32> TravelDist_Cycling := (V_IsCycling ? TravelDist_V : 0u) + (N_IsCycling ? TravelDist_N : 0u);
				attribute<s>      WalkingTime      := (V_IsWalking ? PretransTime : 0[s]) + (N_IsWalking ? PosttransTime : 0[s]);
				attribute<s>      CyclingTime      := (V_IsCycling ? PretransTime : 0[s]) + (N_IsCycling ? PosttransTime : 0[s]);
				attribute<s>      CarTime          := V_IsCar ? PretransTime : 0[s];
				attribute<Euro>   WalkingPrice     := convert((V_IsWalking ? Price_V_ct : 0[Ct]) + (N_IsWalking ? Price_N_ct : 0[Ct]), Euro);
				attribute<Euro>   CyclingPrice     := convert((V_IsCycling ? Price_V_ct : 0[Ct]) + (N_IsCycling ? Price_N_ct : 0[Ct]), Euro);
				attribute<Euro>   CarPrice         := convert(V_IsCar ? Price_V_ct : 0[Ct], Euro);
			}

			// The counts of this departure moment, for Counts in the block; a public transport chain has an _ in ModeUsed (W_BBR_W).
			attribute<bool>   IsChain                      (Kept) := IsDefined(strpos(Kept/ModeUsed, '_'));
			attribute<uint64> RowCounts (/Classifications/OD_Counts_Kind) := union_data(/Classifications/OD_Counts_Kind
			                                                                 , uint64(#Kept)
			                                                                 , sum_uint64(IsChain)
			                                                                 , sum_uint64(Kept/ModeUsed == 'WW')
			                                                                 , sum_uint64(Kept/ModeUsed == 'CC')
			                                                                 , sum_uint64(Kept/ModeUsed == 'AA'));
			unit<uint32> Pairs := unique(Kept/OrgName + ';' + Kept/DestName)
			{
				attribute<bool> PT_chain             := any(../IsChain, ../Pairs_rel);
				attribute<bool> WW                   := any(Kept/ModeUsed == 'WW', ../Pairs_rel);
				attribute<bool> CC                   := any(Kept/ModeUsed == 'CC', ../Pairs_rel);
				attribute<bool> AA                   := any(Kept/ModeUsed == 'AA', ../Pairs_rel);
				attribute<bool> without_car          := any(Kept/NeedsCar == 0b, ../Pairs_rel);
				attribute<bool> without_car_and_bike := any(Kept/NeedsCar == 0b && Kept/NeedsBike == 0b, ../Pairs_rel);
			}
			attribute<Pairs>  Pairs_rel                    (Kept) := rlookup(Kept/OrgName + ';' + Kept/DestName, Pairs/values);
			attribute<uint64> PairCounts (/Classifications/OD_Counts_Group) := union_data(/Classifications/OD_Counts_Group
			                                                                   , uint64(#Pairs)
			                                                                   , sum_uint64(Pairs/PT_chain)
			                                                                   , sum_uint64(Pairs/WW)
			                                                                   , sum_uint64(Pairs/CC)
			                                                                   , sum_uint64(Pairs/AA)
			                                                                   , sum_uint64(Pairs/without_car)
			                                                                   , sum_uint64(Pairs/without_car_and_bike));

			// The output according to ModelParameters/OutputFormat: parquet, typed, with the times in minutes as float32 and without the departure
			// moment in the column names (it is in the file name), or csv, with the departure moment after the column names, the times in minutes and an
			// unknown value empty. Both have the same columns in the same order, whatever the components of the variant; a column that does not apply
			// to a row is 0. The split per part and per mode comes after Component, so that a reader that reads the csv by position keeps the earlier
			// columns.
			container Parquet : StorageName = "=/ModelParameters/Impl/OutputDir + '/PerBlock/tt' + FileTail + '.parquet'", StorageType = "gdalwrite.vect"
			{
				unit<uint32> tt := Kept, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
				{
					attribute<string> OrgName          := Kept/OrgName;
					attribute<string> DestName         := Kept/DestName;
					attribute<min_f>  Traveltime       := convert(Kept/Traveltime, min_f);
					attribute<Euro>   Price            := Kept/Price;
					attribute<Euro>   Price_Augm       := Kept/Price_Augm;
					attribute<string> ModeUsed         := Kept/ModeUsed;
					attribute<uint8>  NeedsCar         := Kept/NeedsCar;
					attribute<uint8>  NeedsBike        := Kept/NeedsBike;
					attribute<min_f>  WaitingTime      := convert(Kept/WaitingTime, min_f);
					attribute<min_f>  PretransTime     := convert(Kept/PretransTime, min_f);
					attribute<min_f>  PosttransTime    := convert(Kept/PosttransTime, min_f);
					attribute<uint32> TravelDist_Bus   := Kept/TravelDist_Bus;
					attribute<uint32> TravelDist_Metro := Kept/TravelDist_Metro;
					attribute<uint32> TravelDist_Tram  := Kept/TravelDist_Tram;
					attribute<uint32> TravelDist_Rail  := Kept/TravelDist_Rail;
					attribute<uint32> TravelDist_Ferry := Kept/TravelDist_Ferry;
					attribute<uint32> TravelDist_Car   := Kept/TravelDist_Car;
					attribute<string> Component        := Kept/Component;
					attribute<uint32> TravelDist_V     := Kept/TravelDist_V;
					attribute<uint32> TravelDist_N     := Kept/TravelDist_N;
					attribute<min_f>  PTTime           := convert(Kept/PTTime, min_f);
					attribute<Euro>   PretransPrice    := Kept/PretransPrice;
					attribute<Euro>   PTPrice          := Kept/PTPrice;
					attribute<Euro>   PosttransPrice   := Kept/PosttransPrice;
					attribute<uint32> TravelDist_PT    := Kept/TravelDist_PT;
					attribute<uint32> TravelDist_Walking := Kept/TravelDist_Walking;
					attribute<uint32> TravelDist_Cycling := Kept/TravelDist_Cycling;
					attribute<min_f>  WalkingTime      := convert(Kept/WalkingTime, min_f);
					attribute<min_f>  CyclingTime      := convert(Kept/CyclingTime, min_f);
					attribute<min_f>  CarTime          := convert(Kept/CarTime, min_f);
					attribute<Euro>   WalkingPrice     := Kept/WalkingPrice;
					attribute<Euro>   CyclingPrice     := Kept/CyclingPrice;
					attribute<Euro>   CarPrice         := Kept/CarPrice;
					attribute<min_f>  InVehicleTime    := convert(Kept/InVehicleTime, min_f);
					attribute<min_f>  TransferWalkTime := convert(Kept/TransferWalkTime, min_f);
					attribute<min_f>  PTWaitTime       := convert(Kept/PTWaitTime, min_f);
				}
			}
			// The csv: per column of Parquet/tt after OrgName and DestName its text, an item named after the column, with the times in minutes.
			container CsvText
			{
				attribute<string> Traveltime         (Kept) := MakeDefined(string(convert(Kept/Traveltime, min_f)), '');
				attribute<string> Price              (Kept) := MakeDefined(string(Kept/Price), '');
				attribute<string> Price_Augm         (Kept) := MakeDefined(string(Kept/Price_Augm), '');
				attribute<string> ModeUsed           (Kept) := Kept/ModeUsed;
				attribute<string> NeedsCar           (Kept) := MakeDefined(string(Kept/NeedsCar), '');
				attribute<string> NeedsBike          (Kept) := MakeDefined(string(Kept/NeedsBike), '');
				attribute<string> WaitingTime        (Kept) := MakeDefined(string(convert(Kept/WaitingTime, min_f)), '');
				attribute<string> PretransTime       (Kept) := MakeDefined(string(convert(Kept/PretransTime, min_f)), '');
				attribute<string> PosttransTime      (Kept) := MakeDefined(string(convert(Kept/PosttransTime, min_f)), '');
				attribute<string> TravelDist_Bus     (Kept) := MakeDefined(string(Kept/TravelDist_Bus), '');
				attribute<string> TravelDist_Metro   (Kept) := MakeDefined(string(Kept/TravelDist_Metro), '');
				attribute<string> TravelDist_Tram    (Kept) := MakeDefined(string(Kept/TravelDist_Tram), '');
				attribute<string> TravelDist_Rail    (Kept) := MakeDefined(string(Kept/TravelDist_Rail), '');
				attribute<string> TravelDist_Ferry   (Kept) := MakeDefined(string(Kept/TravelDist_Ferry), '');
				attribute<string> TravelDist_Car     (Kept) := MakeDefined(string(Kept/TravelDist_Car), '');
				attribute<string> Component          (Kept) := Kept/Component;
				attribute<string> TravelDist_V       (Kept) := MakeDefined(string(Kept/TravelDist_V), '');
				attribute<string> TravelDist_N       (Kept) := MakeDefined(string(Kept/TravelDist_N), '');
				attribute<string> PTTime             (Kept) := MakeDefined(string(convert(Kept/PTTime, min_f)), '');
				attribute<string> PretransPrice      (Kept) := MakeDefined(string(Kept/PretransPrice), '');
				attribute<string> PTPrice            (Kept) := MakeDefined(string(Kept/PTPrice), '');
				attribute<string> PosttransPrice     (Kept) := MakeDefined(string(Kept/PosttransPrice), '');
				attribute<string> TravelDist_PT      (Kept) := MakeDefined(string(Kept/TravelDist_PT), '');
				attribute<string> TravelDist_Walking (Kept) := MakeDefined(string(Kept/TravelDist_Walking), '');
				attribute<string> TravelDist_Cycling (Kept) := MakeDefined(string(Kept/TravelDist_Cycling), '');
				attribute<string> WalkingTime        (Kept) := MakeDefined(string(convert(Kept/WalkingTime, min_f)), '');
				attribute<string> CyclingTime        (Kept) := MakeDefined(string(convert(Kept/CyclingTime, min_f)), '');
				attribute<string> CarTime            (Kept) := MakeDefined(string(convert(Kept/CarTime, min_f)), '');
				attribute<string> WalkingPrice       (Kept) := MakeDefined(string(Kept/WalkingPrice), '');
				attribute<string> CyclingPrice       (Kept) := MakeDefined(string(Kept/CyclingPrice), '');
				attribute<string> CarPrice           (Kept) := MakeDefined(string(Kept/CarPrice), '');
				attribute<string> InVehicleTime      (Kept) := MakeDefined(string(convert(Kept/InVehicleTime, min_f)), '');
				attribute<string> TransferWalkTime   (Kept) := MakeDefined(string(convert(Kept/TransferWalkTime, min_f)), '');
				attribute<string> PTWaitTime         (Kept) := MakeDefined(string(convert(Kept/PTWaitTime, min_f)), '');
			}
			unit<uint8> CsvColumns : nrofrows = 34, Descr = "The columns of the csv after OrgName and DestName, in the order of Parquet/tt; each is an item of CsvText."
			{
				attribute<string> name : ['Traveltime', 'Price', 'Price_Augm', 'ModeUsed', 'NeedsCar', 'NeedsBike', 'WaitingTime', 'PretransTime', 'PosttransTime', 'TravelDist_Bus', 'TravelDist_Metro', 'TravelDist_Tram', 'TravelDist_Rail', 'TravelDist_Ferry', 'TravelDist_Car', 'Component'
				                         , 'TravelDist_V', 'TravelDist_N', 'PTTime', 'PretransPrice', 'PTPrice', 'PosttransPrice', 'TravelDist_PT', 'TravelDist_Walking', 'TravelDist_Cycling', 'WalkingTime', 'CyclingTime', 'CarTime', 'WalkingPrice', 'CyclingPrice', 'CarPrice'
				                         , 'InVehicleTime', 'TransferWalkTime', 'PTWaitTime'];
			}
			attribute<string> Line                         (Kept) := ='Kept/OrgName + '';'' + Kept/DestName + '';'' + ' + asList('CsvText/' + CsvColumns/name, ' + '';'' + ');
			parameter<string> File                                := 'OrgName;DestName;' + asList(CsvColumns/name + '_' + MomentShort, ';') + '\n' + asList(Line, '\n')
			,	StorageName = "=/ModelParameters/Impl/OutputDir + '/PerBlock/tt' + FileTail + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			parameter<string> Write                               := 'Ready', ExplicitSuppliers = "=/ModelParameters/OutputFormat == 'parquet' ? 'Parquet/tt' : 'File'"
			,	Descr = "Writes the merged output of this block and departure moment as parquet or csv (OutputFormat).";
		}
	}
}
