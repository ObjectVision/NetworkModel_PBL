container ComponentMerge_Def
: Descr = "The components and the signature of the merge (#117), kept apart from ComponentMerge because the writers there request this signature through NetworkSetup/GenerateOutput/Output_Sig."
{
	unit<uint8>       Comps              := /ModelParameters/Impl/VariantComponents
	,	Descr = "The components that are merged: those of the variant, in the order of Classifications/Components.";
	parameter<string> BaseDir            := '%LocalDataProjDir%/Output' + /ModelParameters/Impl/OD_Tag + '/' + /ModelParameters/Impl/Analysis_date + '_' + /ModelParameters/OutputLabel
	,	Descr = "The output folder of the variant without the suffix of the component.";

	// The signature of every component, as its output wrote it.
	container         PerComp            := for_each_ne(Comps/name, 'CompSignature_T(' + quote(Comps/OutputSuffix) + ')');
	Template CompSignature_T : Descr = "Reads the signature that the output of one component wrote."
	{
		parameter<string> Suffix;
		///
		parameter<string> Stored : StorageName = "=BaseDir + Suffix + '/signature.txt'", StorageType = "str", StorageReadOnly = "true"
		,	Descr = "The signature of the output of this component; if it is missing, the component has not been calculated (yet).";
	}

	parameter<string> CompSignatures     := =asList('''['' + PerComp/' + Comps/name + '/Stored + '']''', ' + ')
	,	Descr = "The signatures of the Components in a row, each between [ and ].";
	parameter<string> Signature          :=
		  'tt_' + /ModelParameters/Impl/Analysis_date + '_ORG-' + /ModelParameters/Impl/OrgSet_string
		+ '_samen-' + asList(Comps/name, ',')
		+ '_MinCrit-' + asList(/Classifications/OutputParetoAttr/FileNameElement, '_') + /ModelParameters/Impl/ChainPareto_FileTag
		+ '_' + /ModelParameters/OutputFormat + '-m2'
		+ '_' + CompSignatures
	,	Descr = "The signature of the merged output: date, set of origins, Components, criteria (MergeCriteria) and epsilons, format (-m2: read from the parquet of the Components) and the signatures of the Components, so that it changes when a component is recalculated with other parameters.";
}

// MERGING THE COMPONENTS OF THE VARIANT (#117). Per origin block and departure moment it reads the parquet of the components
// (Output/<Analysis_date>_<OutputLabel>_<component>/PerBlock), each with the columns of its kind (Classifications/Components/ExportClass), and fills
// in what is constant there or follows from the columns:
// - WW and CC: the price from the travel time (Direct_Walking_Time_Costs, Direct_Cycling_Time_Costs, as in PublicTransport_Prep/Direct),
//   ModeUsed WW or CC, PretransTime = Traveltime; they apply to every departure moment (SingleDepartureMoment);
// - Car: the price from the distance (Car_FixedCosts_PerTrip + Car_CostPerKm), ModeUsed AA, PretransTime = Traveltime;
// - a public transport component: everything is in the file.
// Then per OD pair the rows that are not dominated on the criteria of the merge (Classifications/OutputParetoAttr, from
// ModelParameters/MergeCriteria), with the same epsilons and operator (pareto_optimal_eps) as in a run, with price and time in Ct and s;
// NeedsCar and NeedsBike follow from the component (Classifications/Components). The result is written in ModelParameters/OutputFormat, csv or
// parquet, to Output/<Analysis_date>_<OutputLabel>_Merged<MergeRunNr>/PerBlock, with the column Component (where the row comes from), and
// the counts per block to Tellingen (batch/OdTellingen.py adds them up).
container ComponentMerge
: Descr = "Merges the components of the variant into one Pareto front from their parquet, as the comment above describes; Generate, or batch/UpdateAll.cmd with the component MergedergeOutput runs it."
{
	container         PerBlock                  := for_each_ne(/NetworkSetup/impl/OrgBlockDomain/name, 'MergeBlock_T(' + string(id(/NetworkSetup/impl/OrgBlockDomain)) + ')');
	parameter<string> Generate                  := =asList('PerBlock/' + /NetworkSetup/impl/OrgBlockDomain/name + '/Fence/Generate', ' + ')
	,	Descr = "Merges all blocks and departure moments, one block per phase, so that its intermediate results are freed afterwards.";
	parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';

	Template MergeBlock_T : Descr = "The merge of one origin block over all departure moments, with the counts of the block."
	{
		parameter</NetworkSetup/impl/OrgBlockDomain> BlockDomain_id;
		///
		parameter<string> BlockFile := /NetworkSetup/impl/OrgBlockDomain/FileName[BlockDomain_id];
		container Work
		{
			container         PerMoment := for_each_ne(/ModelParameters/Impl/MeasureMoments/Name, 'MergeMoment_T(' + quote(/ModelParameters/Impl/MeasureMoments/Name) + ')');

			// The counts of this block, Tellingen/tellingen_<n>of<N>.csv, as a component run writes them (PublicTransport/Generate_Output/
			// Traveltime_ForEachDepTime/Counts): rows per kind and unique OD pairs per group, per departure moment, and the pairs over all moments.
			container Counts
			{
				unit<uint32> AllPairs := ='union_unit(' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs', ',') + ')'
				{
					attribute<string> OrgDest              := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/values', ',') + ')';
					attribute<bool>   PT_chain             := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/PT_chain', ',') + ')';
					attribute<bool>   WW                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/WW', ',') + ')';
					attribute<bool>   CC                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/CC', ',') + ')';
					attribute<bool>   AA                   := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/AA', ',') + ')';
					attribute<bool>   without_car          := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/without_car', ',') + ')';
					attribute<bool>   without_car_and_bike := ='union_data(., ' + asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Pairs/without_car_and_bike', ',') + ')';
				}
				unit<uint32>           UniquePairs           := unique(AllPairs/OrgDest);
				attribute<UniquePairs> Unique_rel (AllPairs) := rlookup(AllPairs/OrgDest, UniquePairs/values);
				attribute<uint64>      PairCounts_AllMoments (/Classifications/OD_Counts_Group) := union_data(/Classifications/OD_Counts_Group
				                                                                                   , uint64(#UniquePairs)
				                                                                                   , sum_uint64(any(AllPairs/PT_chain, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/WW, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/CC, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/AA, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/without_car, Unique_rel))
				                                                                                   , sum_uint64(any(AllPairs/without_car_and_bike, Unique_rel)));
				attribute<uint64>      RowCounts_Total (/Classifications/OD_Counts_Kind) := =asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/RowCounts', ' + ');
				attribute<string>      RowCountsLine (/Classifications/OD_Counts_Kind) := ='''rijen;'' + /Classifications/OD_Counts_Kind/label + ' + asList(''';'' + string(PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/RowCounts)', ' + ') + ' + '';'' + string(RowCounts_Total)';
				attribute<string>      PairCountsLine (/Classifications/OD_Counts_Group) := ='''paren;'' + /Classifications/OD_Counts_Group/label + ' + asList(''';'' + string(PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/PairCounts)', ' + ') + ' + '';'' + string(PairCounts_AllMoments)';
				parameter<string>      File                  := 'tabel;naam;' + asList(/ModelParameters/Impl/MeasureMoments/TemplatableTextShrt, ';') + ';totaal\n' + asList(RowCountsLine, '\n') + '\n' + asList(PairCountsLine, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Impl/OutputDir + '/Tellingen/tellingen_' + BlockFile + '.csv'", StorageType = "str"
				,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			}
			parameter<string> Generate  := 'Ready', ExplicitSuppliers = "=asList('PerMoment/' + /ModelParameters/Impl/MeasureMoments/Name + '/Write', ';') + ';Counts/File'"
			,	Descr = "Writes the merged output per departure moment and the counts of the block, and returns only 'Ready'.";
		}
		container         Fence     := PhaseContainer(Work, 'Samengevoegd: ' + /NetworkSetup/impl/OrgBlockDomain/name[BlockDomain_id]);

		Template MergeMoment_T : Descr = "The merge of one departure moment of the block: reads the files of the Components, keeps the Pareto front per OD pair and writes it."
		{
			parameter<string> Moment;
			///
			parameter<string> MomentShort                         := rjoin(Moment, /ModelParameters/Impl/MeasureMoments/Name, /ModelParameters/Impl/MeasureMoments/TemplatableTextShrt);
			parameter<string> FileTail                            := '_' + MomentShort + '_' + BlockFile
			,	Descr = "The name of the file after tt, without extension: tt_<moment>_<n>of<N>; the date and the component or merge are in the name of the folder.";

			// The file of every component in this block and departure moment; a component with SingleDepartureMoment (WW, CC, and Car without
			// CarTimeDependent) has one per block, that of the congestion moment, which applies to every departure moment.
			attribute<string> CompFile (ComponentMerge_Def/Comps) := ComponentMerge_Def/BaseDir + ComponentMerge_Def/Comps/OutputSuffix + '/PerBlock/tt_'
			                                                         + (ComponentMerge_Def/Comps/SingleDepartureMoment_Eff ? /ModelParameters/Impl/SingleDepartureMoment_Shrt : MomentShort) + '_' + BlockFile + '.parquet';
			container         PerComp                             := for_each_ne(ComponentMerge_Def/Comps/name
			                                                         , 'Read' + ComponentMerge_Def/Comps/ExportClass + '_T(' + quote(ComponentMerge_Def/Comps/name) + ', ' + string(id(ComponentMerge_Def/Comps)) + 'b)'); // b: Comps is uint8

			// Per kind of component (Classifications/Components/ExportClass) a reader that reads the columns of its writer (PerDepartureMoment_T,
			// CreateExports/LongFormat/Parquet_<ExportClass>) and completes the others to the common schema.
			// WW and CC: OrgName, DestName, Traveltime.
			Template ReadDirect_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<float32> Traveltime;
				}
				parameter<bool>   IsWalking                 := CompName == 'WW';
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<min_f>  Traveltime       (domain) := value(domain/Traveltime, min_f);
				// As in PublicTransport_Prep/Direct: the time valuation, which counts in Price only with Include*CostsInPrice.
				attribute<Euro>   Price_Augm       (domain) := convert(rounded_convert(Traveltime * (IsWalking ? /ModelParameters/Direct_Walking_Time_Costs : /ModelParameters/Direct_Cycling_Time_Costs), Ct), Euro);
				attribute<Euro>   Price            (domain) := (IsWalking ? /ModelParameters/Advanced/IncludeWalkingCostsInPrice : /ModelParameters/Advanced/IncludeCyclingCostsInPrice) ? Price_Augm : const(0[Euro], domain);
				attribute<string> ModeUsed         (domain) := const(CompName, domain);
				attribute<uint8>  NeedsCar         (domain) := const(0b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(ComponentMerge_Def/Comps/NeedsBike[Comp_id] ? 1b : 0b, domain);
				attribute<min_f>  WaitingTime      (domain) := const(0[min_f], domain);
				attribute<min_f>  PretransTime     (domain) := Traveltime;
				attribute<min_f>  PosttransTime    (domain) := const(0[min_f], domain);
				attribute<uint32> TravelDist_Bus   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Metro (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Tram  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Rail  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Ferry (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Car   (domain) := const(0, domain, uint32);
			}
			// Car: OrgName, DestName, Traveltime, TravelDist_Car.
			Template ReadCar_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<float32> Traveltime;
					attribute<uint32>  TravelDist_Car;
				}
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<min_f>  Traveltime       (domain) := value(domain/Traveltime, min_f);
				// As in PublicTransport_Prep/Direct/Car: Car_FixedCosts_PerTrip + distance x Car_CostPerKm; the distance is in whole metres in the file.
				attribute<Euro>   Price            (domain) := /ModelParameters/Advanced/IncludeCarCostsInPrice ? convert(rounded_convert(/ModelParameters/Car_FixedCosts_PerTrip + value(float32(domain/TravelDist_Car) / 1000f, km) * /ModelParameters/Car_CostPerKm, Ct), Euro) : const(0[Euro], domain);
				attribute<Euro>   Price_Augm       (domain) := Price;
				attribute<string> ModeUsed         (domain) := const('AA', domain);
				attribute<uint8>  NeedsCar         (domain) := const(1b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(0b, domain);
				attribute<min_f>  WaitingTime      (domain) := const(0[min_f], domain);
				attribute<min_f>  PretransTime     (domain) := Traveltime;
				attribute<min_f>  PosttransTime    (domain) := const(0[min_f], domain);
				attribute<uint32> TravelDist_Bus   (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Metro (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Tram  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Rail  (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Ferry (domain) := const(0, domain, uint32);
				attribute<uint32> TravelDist_Car   (domain) := domain/TravelDist_Car;
			}
			// A public transport component: the columns of Parquet_PT; NeedsBike follows from pre-transport and post-transport (Classifications/Components/NeedsBike).
			Template ReadPT_T
			{
				parameter<string> CompName;
				parameter<ComponentMerge_Def/Comps> Comp_id;
				///
				parameter<string> FileName                  := CompFile[Comp_id];
				unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
				{
					attribute<string>  OrgName;
					attribute<string>  DestName;
					attribute<float32> Traveltime;
					attribute<float32> Price;
					attribute<float32> Price_Augm;
					attribute<string>  ModeUsed;
					attribute<float32> WaitingTime;
					attribute<float32> PretransTime;
					attribute<float32> PosttransTime;
					attribute<uint32>  TravelDist_Bus;
					attribute<uint32>  TravelDist_Metro;
					attribute<uint32>  TravelDist_Tram;
					attribute<uint32>  TravelDist_Rail;
					attribute<uint32>  TravelDist_Ferry;
				}
				attribute<string> OrgName          (domain) := domain/OrgName;
				attribute<string> DestName         (domain) := domain/DestName;
				attribute<min_f>  Traveltime       (domain) := value(domain/Traveltime, min_f);
				attribute<Euro>   Price            (domain) := value(domain/Price, Euro);
				attribute<Euro>   Price_Augm       (domain) := value(domain/Price_Augm, Euro);
				attribute<string> ModeUsed         (domain) := domain/ModeUsed;
				attribute<uint8>  NeedsCar         (domain) := const(0b, domain);
				attribute<uint8>  NeedsBike        (domain) := const(ComponentMerge_Def/Comps/NeedsBike[Comp_id] ? 1b : 0b, domain);
				attribute<min_f>  WaitingTime      (domain) := value(domain/WaitingTime, min_f);
				attribute<min_f>  PretransTime     (domain) := value(domain/PretransTime, min_f);
				attribute<min_f>  PosttransTime    (domain) := value(domain/PosttransTime, min_f);
				attribute<uint32> TravelDist_Bus   (domain) := domain/TravelDist_Bus;
				attribute<uint32> TravelDist_Metro (domain) := domain/TravelDist_Metro;
				attribute<uint32> TravelDist_Tram  (domain) := domain/TravelDist_Tram;
				attribute<uint32> TravelDist_Rail  (domain) := domain/TravelDist_Rail;
				attribute<uint32> TravelDist_Ferry (domain) := domain/TravelDist_Ferry;
				attribute<uint32> TravelDist_Car   (domain) := const(0, domain, uint32);
			}

			unit<uint32> Rows := ='union_unit(' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/domain', ',') + ')'
			,	Descr = "The rows of all Components, in the order of Comps; with a tie on all criteria the first wins (pareto_optimal_eps)."
			{
				attribute<string> OrgName          := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/OrgName', ',') + ')';
				attribute<string> DestName         := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/DestName', ',') + ')';
				attribute<min_f>  Traveltime_min   := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Traveltime', ',') + ')';
				attribute<Euro>   Price_euro       := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Price', ',') + ')';
				attribute<Euro>   Price_Augm_euro  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/Price_Augm', ',') + ')';
				attribute<string> ModeUsed         := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/ModeUsed', ',') + ')';
				attribute<uint8>  NeedsCar_u8      := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/NeedsCar', ',') + ')';
				attribute<uint8>  NeedsBike_u8     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/NeedsBike', ',') + ')';
				attribute<min_f>  WaitingTime      := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/WaitingTime', ',') + ')';
				attribute<min_f>  PretransTime     := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PretransTime', ',') + ')';
				attribute<min_f>  PosttransTime    := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/PosttransTime', ',') + ')';
				attribute<uint32> TravelDist_Bus   := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Bus', ',') + ')';
				attribute<uint32> TravelDist_Metro := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Metro', ',') + ')';
				attribute<uint32> TravelDist_Tram  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Tram', ',') + ')';
				attribute<uint32> TravelDist_Rail  := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Rail', ',') + ')';
				attribute<uint32> TravelDist_Ferry := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Ferry', ',') + ')';
				attribute<uint32> TravelDist_Car   := ='union_data(., ' + asList('PerComp/' + ComponentMerge_Def/Comps/name + '/TravelDist_Car', ',') + ')';
				attribute<string> Component        := ='union_data(., ' + asList('const(' + quote(ComponentMerge_Def/Comps/name) + ', PerComp/' + ComponentMerge_Def/Comps/name + '/domain)', ',') + ')';

				// The criteria (Classifications/OutputParetoAttr) in the units of the final front, Ct and s, so that the epsilons work as in a run; GeoDMS
				// names are case-insensitive, hence TravelTime next to Traveltime_min.
				attribute<Ct>     Price            := rounded_convert(Price_euro, Ct);
				attribute<Ct>     Price_augm       := rounded_convert(Price_Augm_euro, Ct);
				attribute<s>      TravelTime       := rounded_convert(Traveltime_min, s);
				attribute<bool>   NeedsCar         := NeedsCar_u8 == 1b;
				attribute<bool>   NeedsBike        := NeedsBike_u8 == 1b;

				attribute<string> OrgDest          := OrgName + ';' + DestName;
				unit<uint32>      OD               := unique(OrgDest);
				attribute<OD>     OD_rel           := rlookup(OrgDest, OD/values);
				attribute<bool>   keep             := ='pareto_optimal_eps(OD_rel, ' + asList(/Classifications/OutputParetoAttr/ParetoArgs, ', ') + ')'
				,	Descr = "With one criterion (MergeCriteria 'Time' or 'Price') the one fastest or cheapest row per pair, because the first criterion has no epsilon.";
			}
			unit<uint32> Kept := select_with_org_rel(Rows/keep)
			{
				attribute<string> OrgName          := Rows/OrgName[org_rel];
				attribute<string> DestName         := Rows/DestName[org_rel];
				attribute<min_f>  Traveltime       := Rows/Traveltime_min[org_rel];
				attribute<Euro>   Price            := Rows/Price_euro[org_rel];
				attribute<Euro>   Price_Augm       := Rows/Price_Augm_euro[org_rel];
				attribute<string> ModeUsed         := Rows/ModeUsed[org_rel];
				attribute<uint8>  NeedsCar         := Rows/NeedsCar_u8[org_rel];
				attribute<uint8>  NeedsBike        := Rows/NeedsBike_u8[org_rel];
				attribute<min_f>  WaitingTime      := Rows/WaitingTime[org_rel];
				attribute<min_f>  PretransTime     := Rows/PretransTime[org_rel];
				attribute<min_f>  PosttransTime    := Rows/PosttransTime[org_rel];
				attribute<uint32> TravelDist_Bus   := Rows/TravelDist_Bus[org_rel];
				attribute<uint32> TravelDist_Metro := Rows/TravelDist_Metro[org_rel];
				attribute<uint32> TravelDist_Tram  := Rows/TravelDist_Tram[org_rel];
				attribute<uint32> TravelDist_Rail  := Rows/TravelDist_Rail[org_rel];
				attribute<uint32> TravelDist_Ferry := Rows/TravelDist_Ferry[org_rel];
				attribute<uint32> TravelDist_Car   := Rows/TravelDist_Car[org_rel];
				attribute<string> Component        := Rows/Component[org_rel];
			}

			// The counts of this departure moment, for Counts in the block; a public transport chain has an _ in ModeUsed (W_BBR_W).
			attribute<bool>   IsChain                      (Kept) := IsDefined(strpos(Kept/ModeUsed, '_'));
			attribute<uint64> RowCounts (/Classifications/OD_Counts_Kind) := union_data(/Classifications/OD_Counts_Kind
			                                                                 , uint64(#Kept)
			                                                                 , sum_uint64(IsChain)
			                                                                 , sum_uint64(Kept/ModeUsed == 'WW')
			                                                                 , sum_uint64(Kept/ModeUsed == 'CC')
			                                                                 , sum_uint64(Kept/ModeUsed == 'AA'));
			unit<uint32> Pairs := unique(Kept/OrgName + ';' + Kept/DestName)
			{
				attribute<bool> PT_chain             := any(../IsChain, ../Pairs_rel);
				attribute<bool> WW                   := any(Kept/ModeUsed == 'WW', ../Pairs_rel);
				attribute<bool> CC                   := any(Kept/ModeUsed == 'CC', ../Pairs_rel);
				attribute<bool> AA                   := any(Kept/ModeUsed == 'AA', ../Pairs_rel);
				attribute<bool> without_car          := any(Kept/NeedsCar == 0b, ../Pairs_rel);
				attribute<bool> without_car_and_bike := any(Kept/NeedsCar == 0b && Kept/NeedsBike == 0b, ../Pairs_rel);
			}
			attribute<Pairs>  Pairs_rel                    (Kept) := rlookup(Kept/OrgName + ';' + Kept/DestName, Pairs/values);
			attribute<uint64> PairCounts (/Classifications/OD_Counts_Group) := union_data(/Classifications/OD_Counts_Group
			                                                                   , uint64(#Pairs)
			                                                                   , sum_uint64(Pairs/PT_chain)
			                                                                   , sum_uint64(Pairs/WW)
			                                                                   , sum_uint64(Pairs/CC)
			                                                                   , sum_uint64(Pairs/AA)
			                                                                   , sum_uint64(Pairs/without_car)
			                                                                   , sum_uint64(Pairs/without_car_and_bike));

			// The output according to ModelParameters/OutputFormat: parquet, typed and without the departure moment in the column names (it is in the
			// file name), or csv, with the departure moment after the column names like the csv of a component, and an unknown value empty.
			container Parquet : StorageName = "=/ModelParameters/Impl/OutputDir + '/PerBlock/tt' + FileTail + '.parquet'", StorageType = "gdalwrite.vect"
			{
				unit<uint32> tt := Kept, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
				{
					attribute<string> OrgName          := Kept/OrgName;
					attribute<string> DestName         := Kept/DestName;
					attribute<min_f>  Traveltime       := Kept/Traveltime;
					attribute<Euro>   Price            := Kept/Price;
					attribute<Euro>   Price_Augm       := Kept/Price_Augm;
					attribute<string> ModeUsed         := Kept/ModeUsed;
					attribute<uint8>  NeedsCar         := Kept/NeedsCar;
					attribute<uint8>  NeedsBike        := Kept/NeedsBike;
					attribute<min_f>  WaitingTime      := Kept/WaitingTime;
					attribute<min_f>  PretransTime     := Kept/PretransTime;
					attribute<min_f>  PosttransTime    := Kept/PosttransTime;
					attribute<uint32> TravelDist_Bus   := Kept/TravelDist_Bus;
					attribute<uint32> TravelDist_Metro := Kept/TravelDist_Metro;
					attribute<uint32> TravelDist_Tram  := Kept/TravelDist_Tram;
					attribute<uint32> TravelDist_Rail  := Kept/TravelDist_Rail;
					attribute<uint32> TravelDist_Ferry := Kept/TravelDist_Ferry;
					attribute<uint32> TravelDist_Car   := Kept/TravelDist_Car;
					attribute<string> Component        := Kept/Component;
				}
			}
			unit<uint8> CsvColumns : nrofrows = 16, Descr = "The columns of the csv after OrgName and DestName, in the order of Parquet/tt."
			{
				attribute<string> name : ['Traveltime', 'Price', 'Price_Augm', 'ModeUsed', 'NeedsCar', 'NeedsBike', 'WaitingTime', 'PretransTime', 'PosttransTime', 'TravelDist_Bus', 'TravelDist_Metro', 'TravelDist_Tram', 'TravelDist_Rail', 'TravelDist_Ferry', 'TravelDist_Car', 'Component'];
			}
			attribute<string> Line                         (Kept) := Kept/OrgName + ';' + Kept/DestName
			                                                         + ';' + MakeDefined(string(Kept/Traveltime), '') + ';' + MakeDefined(string(Kept/Price), '') + ';' + MakeDefined(string(Kept/Price_Augm), '') + ';' + Kept/ModeUsed
			                                                         + ';' + MakeDefined(string(Kept/NeedsCar), '') + ';' + MakeDefined(string(Kept/NeedsBike), '') + ';' + MakeDefined(string(Kept/WaitingTime), '') + ';' + MakeDefined(string(Kept/PretransTime), '')
			                                                         + ';' + MakeDefined(string(Kept/PosttransTime), '') + ';' + MakeDefined(string(Kept/TravelDist_Bus), '') + ';' + MakeDefined(string(Kept/TravelDist_Metro), '') + ';' + MakeDefined(string(Kept/TravelDist_Tram), '')
			                                                         + ';' + MakeDefined(string(Kept/TravelDist_Rail), '') + ';' + MakeDefined(string(Kept/TravelDist_Ferry), '') + ';' + MakeDefined(string(Kept/TravelDist_Car), '') + ';' + Kept/Component;
			parameter<string> File                                := 'OrgName;DestName;' + asList(CsvColumns/name + '_' + MomentShort, ';') + '\n' + asList(Line, '\n')
			,	StorageName = "=/ModelParameters/Impl/OutputDir + '/PerBlock/tt' + FileTail + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			parameter<string> Write                               := 'Ready', ExplicitSuppliers = "=/ModelParameters/OutputFormat == 'parquet' ? 'Parquet/tt' : 'File'"
			,	Descr = "Writes the merged output of this block and departure moment as parquet or csv (OutputFormat).";
		}
	}
}
