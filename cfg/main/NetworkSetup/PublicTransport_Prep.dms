container PublicTransport_Prep
{
	container impl
	{
		// Sinds 2026-10-21 (#129): bij een HB-paar (ModelParameters/Advanced/IsOD) zijn de herkomsten en de bestemmingen elk het ene element
		// van Orgset en Destset met de naam OD_Herkomst en OD_Bestemming (OD_Org, OD_Dest). Alles erna (de plaatsen, de herkomstblokken, de
		// benen, de directe ritten en de auto) heeft dan een herkomst en een bestemming. De buurtvariant blijft die van de sets (Advanced/Buurtset).
		parameter<string> Org_domain        := rjoin(lowercase(ModelParameters/Orgset),  lowercase(Advanced/org_domain_list/label),  Advanced/org_domain_list/path);
		parameter<string> Dest_domain       := rjoin(lowercase(ModelParameters/DestSet), lowercase(Advanced/dest_domain_list/label), Advanced/dest_domain_list/path);
		parameter<string> Org_unit          := ModelParameters/Advanced/IsOD ? '/NetworkSetup/PublicTransport_Prep/impl/OD_Org' : Org_domain, Descr = "Het pad van de herkomsten: Orgset (Org_domain), of bij een HB-paar de ene herkomst daarvan (OD_Org).";
		parameter<string> Dest_unit         := ModelParameters/Advanced/IsOD ? '/NetworkSetup/PublicTransport_Prep/impl/OD_Dest' : Dest_domain, Descr = "Het pad van de bestemmingen: Destset (Dest_domain), of bij een HB-paar de ene bestemming daarvan (OD_Dest).";
		// Met select_with_org_rel en de attributen die het model leest: select_with_attr_by_cond zou alle attributen van de set meenemen,
		// ook die van bronnen die er niet zijn (de inwoners per 100 m-vierkant bij de buurten).
		unit<uint32> OD_Org  := ='select_with_org_rel(' + Org_domain + '/name == ModelParameters/OD_Herkomst)'
		, Descr = "De herkomst van het HB-paar: het element van Orgset met de naam OD_Herkomst."
		{
			attribute<rdc>                   geometry       := =impl/Org_domain + '/geometry[org_rel]';
			attribute<string>                name           := =impl/Org_domain + '/name[org_rel]';
			attribute<float32>               nr_inwoners    := =impl/Org_domain + '/nr_inwoners[float32][org_rel]';
		}
		unit<uint32> OD_Dest := ='select_with_org_rel(' + Dest_domain + '/name == ModelParameters/OD_Bestemming)'
		, Descr = "De bestemming van het HB-paar: het element van Destset met de naam OD_Bestemming."
		{
			attribute<uint32>                nr_items_of_interest := =impl/Dest_domain + '/' + Advanced/items_of_interest + '[org_rel]';
			attribute<rdc>                   geometry             := =impl/Dest_domain + '/geometry[org_rel]';
			attribute<string>                name                 := =impl/Dest_domain + '/name[org_rel]';
			attribute<string>                label                := =impl/Dest_domain + '/label[org_rel]';
		}

		unit<uint32> org := =Org_unit
		{
			attribute<rdc>                   geometry       := =impl/Org_unit+'/geometry';
			attribute<string>                name           := =impl/Org_unit+'/name', IntegrityCheck = "!ModelParameters/Advanced/IsOD || #impl/org == 1", Descr = "Bij een HB-paar precies een herkomst, met de naam OD_Herkomst.";
			attribute<float32>               nr_inwoners    := =impl/Org_unit+'/nr_inwoners[float32]';
		}
		
		unit<uint32> dest := impl/dest_src
		{
			attribute<rdc>                   geometry       := impl/dest_src/geometry;
		}
		
		unit<uint32> dest_src := =Dest_unit
		{
			attribute<uint32>                nr_items_of_interest := =Dest_unit+'/'+(ModelParameters/Advanced/IsOD ? 'nr_items_of_interest' : Advanced/items_of_interest);
			attribute<rdc>                   geometry             := =Dest_unit+'/geometry';
			attribute<string>                name                 := =Dest_unit+'/name', IntegrityCheck = "!ModelParameters/Advanced/IsOD || #impl/dest_src == 1", Descr = "Bij een HB-paar precies een bestemming, met de naam OD_Bestemming.";
			attribute<string>                label                := =Dest_unit+'/label';
		}
		
		parameter<string>   PT_path_str           := 'SourceData/Infrastructure/GTFS/PublicTransportNet'; 
		unit<uint32>        PT_net                := =PT_path_str+''; //indirection, want dan kun je die later gebruiken in een select_with_attr_by_cond waarbij alle attributen worden opgehaald.
		
		unit<uint32>        Places             := union_unit(PT_net/SL_Places, org, dest)
		, Descr = "All stops, orgs and dests"
		{
			attribute<rdc>                                     geometry        := union_data(., PT_net/SL_Places/geometry, org/geometry, dest/geometry);
			attribute<string>                                  label           := union_data(., PT_net/SL_Places/label, org/name, dest/name);
			attribute<org>                                     Origin_rel      := union_data(., const(null_u, PT_net/SL_Places), id(org), const(null_u, dest));
			attribute<dest>                                    Dest_rel        := union_data(., const(null_u, PT_net/SL_Places), const(null_u, org), id(dest));
			attribute<PT_net/SL_Places>                        SL_Places_rel   := union_data(., id(PT_net/SL_Places), const(null_u, org), const(null_u, dest));
			attribute<Stops>                                   Stop_rel        := PT_net/SL_Places/Stop_rel[SL_Places_rel];
			attribute<Infrastructure/OVprijzen/NS/NS_stations> NS_Stations_rel := Stops/NS_Stations_rel[Stop_rel];
			attribute<RMT_Stops>                               RMT_Stop_rel    := invert(RMT_Stops/Place_rel);
			attribute<RM_Stops>                                RM_Stop_rel     := invert(RM_Stops/Place_rel);
			attribute<Ric_Stops>                               Ric_Stop_rel    := invert(Ric_Stops/Place_rel);
			attribute<R_Stops>                                 R_Stop_rel      := invert(T_Stops/Place_rel);
			
			attribute<Stops>                                   Stops_rel       := Stop_rel;
			attribute<R_Stops>                                 R_Stops_rel     := R_Stop_rel;
			attribute<Ric_Stops>                               Ric_Stops_rel   := Ric_Stop_rel;
			attribute<RMT_Stops>                               RMT_Stops_rel   := RMT_Stop_rel;
			attribute<RM_Stops>                                RM_Stops_rel    := RM_Stop_rel;
			attribute<OVF_Stops>                               OVF_Stops_rel   := invert(OVF_Stops/Place_rel);
			
			attribute<RegioIndelingen/CoropP>                  CoropP_rel      := point_in_polygon(geometry, RegioIndelingen/CoropP/geometry);
		}
		
		unit<uint64> c_Time_Stop_Routes    := combine_unit_uint64(c_Time_Stops,Routes);
		unit<uint64> c_Time_Stops          := /SourceData/Infrastructure/GTFS/c_Time_Stops;
		unit<uint64> c_Time_Places         := combine_unit_uint64(Time, Places);
	
		unit<uint32>        Stops                 := =PT_path_str+'/Stops'
		{
			attribute<string> name      := =PT_path_str+'/Stops/name';
			attribute<rdc>    geometry  := =PT_path_str+'/Stops/geometry';
			attribute<RegioIndelingen/CoropP> CoropP_rel := point_in_polygon(geometry, RegioIndelingen/CoropP/geometry);
			attribute<Places> Place_rel := invert(Places/stop_rel);
			// #123: het NS-station van een halte (ook van een bushalte bij een station) en, voor een treinhalte, de IFF-overstaptijd van dat
			// station; null voor andere haltes en met IFF_Overstaptijd uit. CreateTransfers_T legt hem op als ondergrens.
			attribute</SourceData/Infrastructure/OVprijzen/NS/NS_Stations> NS_Stations_rel := =PT_path_str+'/Stops/NS_Stations_rel';
			attribute<Time>   IFF_Overstaptijd_rel := =ModelParameters/Advanced/IFF_Overstaptijd
				? PT_path_str + '/Stops/Mode_rel == GTFS_Modes/Selection/V/Rail ? rjoin(/SourceData/Infrastructure/OVprijzen/NS/NS_Stations/code[NS_Stations_rel], /SourceData/Infrastructure/Infrastructure/IFF_Stations/code_l, /SourceData/Infrastructure/Infrastructure/IFF_Stations/Overstaptijd_rel) : value(null_u, Time)'
				: 'const(value(null_u, Time), .)';
		}
		unit<uint32>        RMT_Stops              := select_with_attr_by_cond(Stops, Stops/Mode_rel == GTFS_Modes/Selection/V/Rail || Stops/Mode_rel == GTFS_Modes/Selection/V/Metro || Stops/Mode_rel == GTFS_Modes/Selection/V/Tram);
		unit<uint32>        RM_Stops               := select_with_attr_by_cond(Stops, Stops/Mode_rel == GTFS_Modes/Selection/V/Rail || Stops/Mode_rel == GTFS_Modes/Selection/V/Metro);
		unit<uint32>        R_Stops                := select_with_attr_by_cond(Stops, Stops/Mode_rel == GTFS_Modes/Selection/V/Rail);
		unit<uint32>        Ric_Stops              := select_with_attr_by_cond(Stops, Stops/IsNSICStation);
		unit<uint32>        OVF_Stops              := select_with_attr_by_cond(Stops, Stops/IsOVFietsStation);
		
		parameter<Time>     FirstDepartureMoment    := Advanced/PT_FirstDepartureMoment;
		parameter<Time>     LastDepartureMoment   := last(Advanced/MeasureMoments/Moment);
		parameter<Time>     LastArrivalMoment  := Advanced/PT_LastArrivalMoment;
		parameter<Time>     LastBoardingMoment := Advanced/PT_LastBoardingMoment;
		unit<uint32>        Routes                 := =PT_path_str+'/Routes';
		unit<uint32>        NS_Stations            := SourceData/Infrastructure/OVprijzen/NS/NS_Stations;
		unit<uint8>         Modes                  := GTFS_Modes/Selection;
		unit<uint8>         FareTable             := SourceData/Infrastructure/OVprijzen/FareTable;
		unit<uint32>        Provincie              := SourceData/RegioIndelingen/Provincie;
		unit<uint8>         Concessiegebied        := SourceData/RegioIndelingen/Concessiegebied;
		unit<uint32>        CoropP                 := SourceData/RegioIndelingen/CoropP;
		unit<uint32>        c_NS_start_end         := /SourceData/Infrastructure/OVprijzen/NS/NS_TariffUnits_matrix/c_NS_start_end;
		unit<uint32>        TariffUnitsMatrix   := Infrastructure/OVprijzen/NS/NS_TariffUnits_matrix/ODMatrix;
		unit<uint16>        ToBeCalculated_Chains  := /Classifications/Chains/ToBeCalculated;
		unit<uint16>        Allowed_ChainsK        := /Classifications/Chains/Allowed;
		
		unit<uint32> PTnet_prep := =impl/PT_path_str+''
		{
			attribute<bool>   IsSub_from := From_Time_rel >= impl/FirstDepartureMoment ;
			attribute<bool>   IsSub_to   := To_Time_rel   < impl/LastArrivalMoment;
			attribute<bool>   IsSub_dur  := duration <= convert(ModelParameters/MaxPTTime , s_f);
			attribute<bool>   IsFlexLink := MakeDefined(Routes/IsFlex[Route_rel], false), Descr = "#113: link van een flex-lijn; wachtlinks dragen Route_rel van hun rit en vallen dus mee. MakeDefined: een null-conditie telt in select_with_attr_by_cond stil als false.";
		}

		// #113: zonder flex (ModelParameters/Advanced/IsFlexMeenemen = FALSE) gaan alle links van flex-lijnen uit beide netten (Set_L laat wachtlinks van
		// flexritten bij stations toe, vandaar ook daar). Leeg als flex meedoet, zodat de select-expressie
		// van Set_R/Set_L letterlijk gelijk blijft aan die van voor #113. Exact, want in Set_R/Set zijn de
		// samenhangende componenten per route (NodeSet = (tijd, halte, route)): flex-links weglaten verwijdert
		// precies de flex-componenten en raakt geen enkel ander been.
		parameter<string> FlexSelection_str := ModelParameters/Advanced/IsFlexMeenemen ? '' : ' && not(PTnet_prep/IsFlexLink)';

		container Set_R := Get_Windowed_Agency_Set_T(' &&  '+impl/PT_path_str+'/Agency_rel->IsRO &&  '+impl/PT_path_str+'/Duration > 0f' + impl/FlexSelection_str), Descr = "subset of public transport net for the relevant time windows and agency-set.", using = "impl";
		// Het L-net: de vervoerders met NS-tarief (Agencies/IsLnet: NS en, sinds 2026-10-02 (#3), NS International) zonder de
		// treinen waarop een NS-kaartje nooit geldt (Routes/IsZonderNSKaartje: Eurostar, Nightjet), plus de stilstandlinks op NS-stations.
		container Set_L := Get_Windowed_Agency_Set_T(' && (('+impl/PT_path_str+'/Agency_rel->IsLnet && not('+impl/PT_path_str+'/Route_rel->IsZonderNSKaartje)) || ('+impl/PT_path_str+'/Mode_rel == impl/Modes/V/Waiting && IsDefined('+impl/PT_path_str+'/c_NS_start_end_rel))) && '+impl/PT_path_str+'/Duration > 0f' + impl/FlexSelection_str);
		
		unit<uint32> All_Time_Stops := union_unit_uint32(OD_L/Result, OD_R/Result)
		{
			attribute<impl/c_Time_Stops>       c_FromTime_Stop_rel       := union_data(., OD_L/Result/c_FromTime_Stop_rel, OD_R/Result/c_FromTime_Stop_rel);
			attribute<impl/c_Time_Stops>       c_ToTime_Stop_rel         := union_data(., OD_L/Result/c_ToTime_Stop_rel  , OD_R/Result/c_ToTime_Stop_rel  );
		}
		#include<MakeODs.dms>
		
		unit<uint32> BlockSelections := Impl/Stops
		{
			attribute<.>      rnd_rel       := rnd_permutation(0, .);
			attribute<BlockDomain> Block_rel := =ModelParameters/Advanced/IsOD
				? '/NetworkSetup/PublicTransport_Prep/OD_Haltes/IsVStop[/NetworkSetup/PublicTransport_Prep/impl/Stops/Place_rel] ? value(0, BlockDomain) : value(null_u, BlockDomain)'
				: 'value(rnd_rel / ModelParameters/Advanced/MaxStopBlockSize, BlockDomain)'
			, Descr = "Het haltenblok van de ketenstap waarin een keten vanaf deze halte instapt: een random blok van MaxStopBlockSize haltes, of bij een HB-paar (sinds 2026-10-21, #129) het ene blok van de haltes van de herkomst (OD_Haltes/IsVStop) en anders geen.";
		}	
		unit<uint32>      BlockDomain   := range(0, ModelParameters/Advanced/NumberOfStopBlocks)
		{
			attribute<string> name          := 'Block_'+string(id(.)+1)+'of'+string(max(id(.))+1);
			attribute<string> StoreName     := string(id(.)+1)+'of'+string(max(id(.))+1), Descr = "Naam van de blokstore in StorageBlockDir_Str (sinds 2026-09-30 zonder 'Block_', voor de padlengte).";
			attribute<uint64> BlockOffset   := min_elem(uint64(id(.)) * uint64(ModelParameters/Advanced/MaxStopBlockSize), uint64(#BlockSelections));
			attribute<uint64> BlockEnd      := min_elem(BlockOffset + uint64(ModelParameters/Advanced/MaxStopBlockSize), uint64(#BlockSelections));
			attribute<uint32> BlockSize     := uint32(BlockEnd - BlockOffset);
		}
	} 

	container Create_Optimised_Network_Walking  := Templates/CreateNetwork_Efficient_T(impl/Org, impl/Dest, SourceData/Infrastructure/OSM/Network_Walking, 'Walking', TRUE), Descr = "Network for pre- and post-transport.";
	container Create_Optimised_Network_Cycling  := Templates/CreateNetwork_Efficient_T(impl/Org, impl/Dest, SourceData/Infrastructure/Network_Cycling, 'Cycling', TRUE), Descr = "Network for pre- and post-transport. Sinds 2026-10-13 (#124) het fietsnet van ModelParameters/Advanced/CyclingNetwork (standaard de Fietsersbond), tot dan OSM.";
	container Create_Optimised_Network_EBike    := Templates/CreateNetwork_Efficient_T(impl/Org, impl/Dest, SourceData/Infrastructure/Network_Cycling, 'E_Biking', TRUE), Descr = "Network for pre- and post-transport.";

	// Directe ritten naast het OV. Per toegestane modaliteit (ModelParameters/Advanced/AllowDirectWalking, -Cycling,
	// -Car; de lijst staat in Advanced/DirectModes) de volledige HB-tabel uit /NetworkSetup/PrivateTransport,
	// samengevoegd tot een tabel met dezelfde kolommen. De ketenrijger (PublicTransport/PerDepartureMoment_T,
	// Union_with_DirectOD) voegt per blok deze rijen bij de OV-ketens en houdt per HB-paar het Pareto-front op
	// MinimiseCriteria (prijs, tijd) over. Tot 2026-09-23 deed of lopen of fietsen mee en de auto niet.
	//
	// Prijs per modaliteit: lopen en fietsen krijgen een tijdwaardering (Direct_*_Time_Costs), die alleen in
	// Price meetelt als Include*CostsInPrice aan staat; de auto krijgt een kostprijs: Car_FixedCosts_PerTrip plus
	// afstand x Car_CostPerKm (sinds 2026-10-05, #88; tot dan de som van linkkosten). Price_Augm is voor
	// lopen en fietsen de tijdwaardering zelf en voor de auto gelijk aan Price: een tijdwaardering voor
	// autorijden is er niet. De autoreistijd is die van Car_CongestionMoment_ForDirect.
	unit<uint8> DirectModes_Selected := select_with_attr_by_cond(/ModelParameters/Advanced/DirectModes, /ModelParameters/Advanced/DirectModes/Allowed)
	,	Descr = "De directe modaliteiten die meedoen; minstens een moet aan staan.";
	
	container Direct
	{
		unit<uint64> Walking := /NetworkSetup/PrivateTransport/Walking/Calc_Traveltimes_maxspeed_Walking/Traveltimes
		{
			attribute<s>          Duration_seconds := convert(impedance, s);
			attribute<dam>        Distance         := alt_imp[dam];
			attribute<Ct>         Price_Augm       := rounded_convert(Duration_seconds[min_f] * /ModelParameters/Direct_Walking_Time_Costs, Ct);
			attribute<Ct>         Price            := =/ModelParameters/Advanced/IncludeWalkingCostsInPrice ? 'Price_Augm' : 'const(0, ., Ct)';
			attribute<impl/Modes> Mode_rel         := const(impl/Modes/V/Walking, .);
		}
		
		unit<uint64> Cycling := /NetworkSetup/PrivateTransport/Cycling/Calc_Traveltimes_maxspeed_Cycling/Traveltimes
		{
			attribute<s>          Duration_seconds := convert(impedance[min_f] + /ModelParameters/Cycling_StartTime, s);
			attribute<dam>        Distance         := alt_imp[dam];
			attribute<Ct>         Price_Augm       := rounded_convert(Duration_seconds[min_f] * /ModelParameters/Direct_Cycling_Time_Costs, Ct);
			attribute<Ct>         Price            := =/ModelParameters/Advanced/IncludeCyclingCostsInPrice ? 'Price_Augm' : 'const(0, ., Ct)';
			attribute<impl/Modes> Mode_rel         := const(impl/Modes/V/Cycling, .);
		}
		
		// De auto-HB-tabel met afstand (de _w_AltImp-variant van PrivateTransport_Car_T: alt_imp is de afstand in km),
		// TomTom of OSM. Met ParetoLegs_Car de _pareto-variant: per HB-paar het (reistijd, afstand)-front, dus meerdere
		// rijen per paar; de eindafweging houdt daarvan per paar het niet-gedomineerde deel over. De prijs volgt bij het
		// lezen: afstand x Car_CostPerKm + Car_FixedCosts_PerTrip (sinds 2026-10-05, #88). Tot dan droeg de store de
		// linkkosten (kilometerprijs per wegklasse en optrekkosten) als tweede criterium, en was de afstand onbekend.
		//
		// Per congestiemoment een store volgens de MMD-regels van 20.19.0 (#1245), zoals de ketens: Calc_Car is de
		// rekenkant, Write_Car de holder die alleen de vier kolommen bewaart, Read_Car de kale lezer (declareert
		// niets, de dictionary van de mmd levert de kolommen) en Car (CarFront_T) de afgeleiden, de samenvatting per
		// HB-paar en het uitgedunde front (Car/Front). De handtekening (Signature) draagt alles wat de inhoud bepaalt; de naam sinds 2026-10-03
		// alleen het moment, de herkomst- en bestemmingenset en een hash van de handtekening (NetworkModel_PBL#118). Eerst Write_Car berekenen
		// (40 min scalair, langer met pareto; batch/UpdateAll.cmd cars doet alle momenten), dan herladen.
		unit<uint8> CarMoments := range(uint8, 0b, uint8(4 + (/ModelParameters/Advanced/CarTimeDependent ? #/ModelParameters/Advanced/MeasureMoments : 0)))
		,	Descr = "De congestiemomenten waarvoor een store van de directe autorit bestaat: de drie spitsen en de vrije stroom (TomTom: Freeflow, OSM: MaxSpeed); Car_CongestionMoment_ForDirect kiest er een. Met CarTimeDependent (sinds 2026-10-09, #132) daarnaast per vertrekmoment een tijdafhankelijke store, TD<moment> (TD07h00m), waaruit de eindafweging van dat moment per blok haar rijen leest (PerDepartureMoment_T, CarRows)."
		{
			attribute<string> name := ='union_data(., ''MorningRush'', ''NoonRush'', ''LateEveningRush'', '+quote(/ModelParameters/UseTomTomNetworkForCars ? 'Freeflow' : 'MaxSpeed')
				+ (/ModelParameters/Advanced/CarTimeDependent ? ', ' + asList(quote('TD' + /ModelParameters/Advanced/MeasureMoments/TemplatableTextShrt), ', ') : '') + ')';
		}
		container CarPerMoment := for_each_ne(CarMoments/name, 'DirectCarStore_T('+quote(CarMoments/name)+')')
		,	Descr = "Per congestiemoment: Write_Car (schrijft de store), Read_Car (leest hem) en Car (met prijs, Summary per HB-paar en het front, Car/Front).";

		Template DirectCarStore_T
		{
			parameter<string> Moment;
			///
			parameter<bool>   IsTD := substr(Moment, 0, 2) == 'TD', Descr = "Een tijdafhankelijke store van een vertrekmoment (CarTimeDependent, sinds 2026-10-09)?";
			unit<uint64> Calc_Car := = IsTD
				? '/NetworkSetup/PrivateTransport/Car/Traveltimes/TD/' + Moment + '/impedanceMatrix'
				: '/NetworkSetup/PrivateTransport/Car/Traveltimes/'+Moment+(/ModelParameters/UseTomTomNetworkForCars ? '_TomTom' : '_OSM')+'_w_AltImp'+(/ModelParameters/Advanced/ParetoLegs_Car ? '_pareto' : '')+'/impedanceMatrix'
			,	Descr = "Rekenkant: de (pareto-)afstandsmatrix van PrivateTransport_Car_T op dit moment, of de tijdafhankelijke zoektocht van dit vertrekmoment (Traveltimes/TD). Niet zelf gebruiken; Write_Car schrijft hem weg en Car leest hem terug.";
			parameter<km_hr>  MaxSpeed        := MakeDefined(rjoin(IsTD ? /ModelParameters/Advanced/Car_CongestionMoment_ForDirect : Moment, /ModelParameters/Advanced/CongestionTimes/name, /ModelParameters/Advanced/CongestionTimes/MaxSpeed), 0[km_hr]), Descr = "Het snelheidsplafond van dit moment (0 = geen), voor de storenaam; bij een tijdafhankelijke store dat van het congestiemoment.";
			parameter<string> TD_Tag          := IsTD
				? '_td-' + /ModelParameters/Advanced/Car_CongestionMoment_ForDirect + '-' + string(/ModelParameters/Advanced/CarTD_WindowStart / 60) + 'min-' + string(/ModelParameters/Advanced/CarTD_NrSlots) + 'x300s-st' + string(/ModelParameters/Car_StartTime) + (/ModelParameters/Advanced/CarTD_Search == 'scalar' ? '-scalar' : '')
				: ''
			,	Descr = "Deel van de handtekening van een tijdafhankelijke store: de referentie, het venster (begin in minuten, aantal tijdvakken), Car_StartTime (die verschuift de vertrektijd op het netwerk) en de zoektocht.";
			parameter<string> Signature := 'DirectCar_' + Moment
				+ (/ModelParameters/UseTomTomNetworkForCars
					? '_TomTom-' + /SourceData/Infrastructure/TomTom/file_date + '_' + /ModelParameters/Advanced/CongestionSpeed_DaySelection
					: '_OSM-' + /SourceData/Infrastructure/OSM/file_date)
				+ '_MaxTime-' + string(/ModelParameters/MaxCarTime) + 'min'
				+ '_ORG-' + /ModelParameters/Advanced/OrgSet_string + '_DEST-' + /ModelParameters/Advanced/DestSet_string
				+ (MaxSpeed > 0[km_hr] ? '_vmax' + string(round(MaxSpeed)) : '')
				+ /ModelParameters/Advanced/ParetoLegs_Car_FileTag + TD_Tag + /ModelParameters/Advanced/CarNetwork_Revision
			,	Descr = "Handtekening van de store: congestiemoment, net en editie, MaxCarTime, herkomst- en bestemmingenset, snelheidsplafond, pareto-tag en revisie. De kosten staan er sinds 2026-10-05 niet meer in (#88): de store bevat reistijd en afstand, de prijs volgt bij het lezen. Tot 2026-10-03 (NetworkModel_PBL#118) was dit de naam; nu staat hij als hash in de naam en voluit in signature.txt in de map van de store (sinds 2026-10-06; tot dan in <naam>.signature.txt ernaast).";
			container Hash := /Templates/StringHash_T(Signature);
			parameter<string> NetTag          := /ModelParameters/UseTomTomNetworkForCars
				? 'TT' + replace(/SourceData/Infrastructure/TomTom/file_date, 'yr', '', '_', '-')
				: 'OSM' + /SourceData/Infrastructure/OSM/file_date
			,	Descr = "Het wegennet in de naam van de store (sinds 2026-10-21): TT en de TomTom-editie (TT2025-12 voor yr2025_12) of OSM en de datum van de OSM-extractie. Een autostore hangt van de editie af, niet van de peildatum: Y2025 en Y2026 delen yr2025_12.";
			parameter<string> StorageBase_Str := /ModelParameters/Advanced/IntermediateResultsDir + '/DirectCar_' + NetTag + '_' + Moment + '_' + /ModelParameters/Advanced/OrgSet_PathTag + '_' + /ModelParameters/Advanced/DestSet_PathTag + '_' + Hash/Hex
			,	Descr = "Naam van de store zonder extensie: het wegennet (NetTag, sinds 2026-10-21), het congestiemoment, de herkomst- en bestemmingenset leesbaar (sinds 2026-10-20 kort, OrgSet_PathTag: b2025 voor buurt2025), de rest als hash van Signature. Bijvoorbeeld DirectCar_TT2025-12_TD07h00m_b2025_b2025_3dc99b97.mmd.";
			parameter<string> StorageName_Str := StorageBase_Str + '.mmd';
			container Sig := /Templates/StoreSignature_T(StorageName_Str, StorageName_Str + '/signature.txt', Signature, strlen('/0Dictionary.dms'))
			,	Descr = "De handtekening in de map van de store (signature.txt, naast 0Dictionary.dms; sinds 2026-10-06, tot dan <naam>.signature.txt ernaast in IntermediateResults): Write_Car schrijft hem, Read_Car controleert hem.";
			unit<uint64> Write_Car := Calc_Car, StorageName = "=StorageName_Str", ExplicitSuppliers = "='Sig/ForWriting' + (/ModelParameters/Advanced/IsOD && IsTD ? ';Write_CarLinks/links' : '')"
			,	Descr = "Schrijft de afstandsmatrix van de directe autorit op dit moment naar StorageName_Str, en de handtekening ernaast (Sig); bereken dit item om de store (opnieuw) te maken."
			{
				attribute<s_f>        impedance   := Calc_Car/Car_Time, Descr = "De reistijd van de route; met de relatieve epsilon (sinds 2026-10-05) het tweede zoekcriterium, de afstand het eerste.";
				attribute<km>         alt_imp     := Calc_Car/Car_Distance, Descr = "De afstand van de route (sinds 2026-10-05, #88; tot dan de linkkosten in euro).";
				attribute<impl/org>   OrgZone_rel := Calc_Car/OrgZone_rel;
				attribute<impl/dest>  DstZone_rel := Calc_Car/DstZone_rel;
			}
			// DE LINKS VAN DE ROUTES (sinds 2026-10-21, #129), alleen in de HB-paarmodus met een tijdafhankelijke store: per route (een rij van de
			// store) de links in de volgorde van de rit, met de vorm van de weg uit TomTom.
			parameter<string> Links_Src     := '/NetworkSetup/PrivateTransport/Car/Traveltimes/TD/' + Moment;
			parameter<string> LinksName_Str := StorageBase_Str + '_links.gpkg';
			container Write_CarLinks : StorageName = "=LinksName_Str", StorageType = "gdalwrite.vect"
			,	Descr = "Schrijft de links van de routes naar LinksName_Str; bereken Write_CarLinks/links. Alleen in de HB-paarmodus, bij een tijdafhankelijke store."
			{
				unit<uint32> links := =Links_Src + '/Links/Rows', ExplicitSuppliers = "Sig/ForWriting"
				{
					attribute<uint32> Route    := ='uint32(' + Links_Src + '/Links/Rows/Route_rel)', Descr = "De rij van de store (Write_Car).";
					attribute<uint32> Volgnr   := =Links_Src + '/Links/Rows/Volgnr';
					attribute<rdc>    geometry (arc) := =Links_Src + '/LinkGeometrie';
				}
			}
			container Read_CarLinks : StorageName = "=LinksName_Str", StorageType = "gdal.vect", StorageReadOnly = "true"
			{
				unit<uint32> links
				{
					attribute<uint32> Route;
					attribute<uint32> Volgnr;
					attribute<rdc>    geometry (arc);
				}
			}
			unit<uint64> Read_Car : StorageName = "=Sig/ForReading", StorageReadOnly = "true"
			,	Descr = "Kale lezer van de store; declareert niets. Faalt als de handtekening ontbreekt of afwijkt (Sig/CheckGate); bestaat de store niet, bereken dan eerst Write_Car.";
			container Car := CarFront_T(Read_Car, Read_Car/impedance, Read_Car/alt_imp, Read_Car/OrgZone_rel, Read_Car/DstZone_rel)
			,	Descr = "De directe autorit uit de hele store: per HB-paar de snelste route (scalair) of het (reistijd, afstand)-front (ParetoLegs_Car), met prijs, de samenvatting per HB-paar in Summary en het uitgedunde front in Front (tot 2026-10-12 Car_Front, naast Car).";
		}

		// De directe autorit uit (een deel van) een autostore: Rows met de vier kolommen van de store, de afgeleiden per rit, de samenvatting
		// per HB-paar en het uitgedunde front (Front). DirectCarStore_T neemt de hele store; met CarTimeDependent neemt de eindafweging van elk
		// blok en vertrekmoment alleen de rijen van de herkomsten van haar blok (PerDepartureMoment_T, DirectCar; sinds 2026-10-12, #132).
		// Een HB-paar ligt binnen een herkomst, en pareto_optimal_eps beslist per paar, in de volgorde van de rijen, dus het front van een paar
		// is in beide hetzelfde. De paden zijn absoluut: in een blok heet de herkomstenset van het blok ook impl/org.
		Template CarFront_T
		{
			unit<uint64>                                            Rows;
			attribute<s_f>                                          impedance   (Rows);
			attribute<km>                                           alt_imp     (Rows);
			attribute</NetworkSetup/PublicTransport_Prep/impl/org>  OrgZone_rel (Rows);
			attribute</NetworkSetup/PublicTransport_Prep/impl/dest> DstZone_rel (Rows);
			///
			attribute<string>     Org_Dest         (Rows) := string(OrgZone_rel) + '_' + string(DstZone_rel);
			attribute<s>          Duration_seconds (Rows) := convert(impedance[min_f] + /ModelParameters/Car_StartTime + /ModelParameters/Car_ParkingTime, s);
			attribute<dam>        Distance         (Rows) := convert(alt_imp, dam), Descr = "De afstand van de route; tot 2026-10-05 onbekend (leeg), toen de matrix de kosten droeg.";
			attribute<Euro>       Cost_Euro        (Rows) := /ModelParameters/Car_FixedCosts_PerTrip + alt_imp * /ModelParameters/Car_CostPerKm, Descr = "Afstand x Car_CostPerKm plus het bedrag per rit (#88).";
			attribute<Ct>         Price            (Rows) := =/ModelParameters/Advanced/IncludeCarCostsInPrice ? 'rounded_convert(Cost_Euro, Ct)' : 'const(0, Rows, Ct)';
			attribute<Ct>         Price_Augm       (Rows) := Price;
			attribute</NetworkSetup/PublicTransport_Prep/impl/Modes> Mode_rel (Rows) := const(/NetworkSetup/PublicTransport_Prep/impl/Modes/V/Car, Rows);

			// Samenvatting per HB-paar (Org_Dest): aantal routes in het front, kortste en langste reistijd, kortste en
			// langste afstand. Scalair is nr_routes overal 1 en zijn min en max gelijk.
			attribute<uint64>     od_key           (Rows) := uint64(OrgZone_rel) * uint64(#/NetworkSetup/PublicTransport_Prep/impl/dest) + uint64(DstZone_rel);
			unit<uint64>          Summary          := unique(od_key)
			,	Descr = "Per HB-paar: nr_routes, min_impedance, max_impedance, min_alt_imp, max_alt_imp."
			{
				attribute</NetworkSetup/PublicTransport_Prep/impl/org> OrgZone_rel := value(values / uint64(#/NetworkSetup/PublicTransport_Prep/impl/dest), /NetworkSetup/PublicTransport_Prep/impl/org);
				attribute</NetworkSetup/PublicTransport_Prep/impl/dest> DstZone_rel := value(mod(values, uint64(#/NetworkSetup/PublicTransport_Prep/impl/dest)), /NetworkSetup/PublicTransport_Prep/impl/dest);
				attribute<string>     Org_Dest      := string(OrgZone_rel) + '_' + string(DstZone_rel);
				attribute<uint32>     nr_routes     := uint32(pcount(../Summary_rel)), Descr = "pcount over een uint64-domein levert uint64, vandaar de conversie.";
				attribute<s_f>        min_impedance := min(../impedance, ../Summary_rel);
				attribute<s_f>        max_impedance := max(../impedance, ../Summary_rel);
				attribute<km>         min_alt_imp   := min(../alt_imp, ../Summary_rel);
				attribute<km>         max_alt_imp   := max(../alt_imp, ../Summary_rel);
			}
			attribute<Summary>    Summary_rel      (Rows) := rlookup(od_key, Summary/values);
			parameter<uint32>     stat_rows        := sum(Summary/nr_routes);
			parameter<uint64>     stat_od_pairs    := #Summary;
			parameter<uint32>     stat_front_max   := max(Summary/nr_routes);
			parameter<float32>    stat_front_mean  := float32(stat_rows) / float32(stat_od_pairs);

			// Uitdunning bij het lezen (GeoDMS >= 20.21.0, pareto_optimal_eps), sinds 2026-10-05 met de relatieve CarFrontEpsilon (GeoDMS #1282):
			// in volgorde van afstand (de prijs) blijft een langere route alleen als ze meer dan die fractie sneller is dan de kortere routes die
			// blijven, de regel van de zoektocht zelf; met dezelfde epsilon als de store dunt dit niets meer uit. De kortste route blijft altijd.
			// Eerder op 2026-10-05 reistijd eerst, met tijdbakken van 60 s en afstandsbakken van 400 m, waarin een kortere route de snelste kon vervangen.
			attribute<bool>       keep             (Rows) := = /ModelParameters/Advanced/CarFrontEpsilon > 0f
			                                                 ? 'pareto_optimal_eps(Summary_rel, alt_imp, impedance, /ModelParameters/Advanced/CarFrontEpsilon)'
			                                                 : 'const(TRUE, Rows, bool)';
			unit<uint64> Front := select_with_org_rel(keep)
			,	Descr = "Het uitgedunde front (keep), wat meedoet in Direct_OD. Zonder epsilon, of op een engine voor 20.21.0, gelijk aan Rows."
			{
				attribute<s_f>        impedance        := ../impedance[org_rel];
				attribute<km>         alt_imp          := ../alt_imp[org_rel];
				attribute</NetworkSetup/PublicTransport_Prep/impl/org> OrgZone_rel := ../OrgZone_rel[org_rel];
				attribute</NetworkSetup/PublicTransport_Prep/impl/dest> DstZone_rel := ../DstZone_rel[org_rel];
				attribute<s>          Duration_seconds := ../Duration_seconds[org_rel];
				attribute<dam>        Distance         := ../Distance[org_rel];
				attribute<Ct>         Price            := ../Price[org_rel];
				attribute<Ct>         Price_Augm       := ../Price_Augm[org_rel];
				attribute</NetworkSetup/PublicTransport_Prep/impl/Modes> Mode_rel := ../Mode_rel[org_rel];
				parameter<uint64>     stat_rows        := #Front;
				parameter<float32>    stat_front_mean  := float32(stat_rows) / float32(../stat_od_pairs), Descr = "Routes per HB-paar na de uitdunning; vergelijk met ../stat_front_mean.";
			}
		}

		// De directe autorit die meedoet in het front: het moment van Car_CongestionMoment_ForDirect.
		unit<uint64> Car := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front'
		,	Descr = "De directe autorit op het congestiemoment Car_CongestionMoment_ForDirect, uit de store van CarPerMoment/<moment>; bekijk het front en de samenvatting daar."
		{
			attribute<s>          Duration_seconds := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/Duration_seconds';
			attribute<dam>        Distance         := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/Distance';
			attribute<Ct>         Price            := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/Price';
			attribute<Ct>         Price_Augm       := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/Price_Augm';
			attribute<impl/Modes> Mode_rel         := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/Mode_rel';
			attribute<impl/org>   OrgZone_rel      := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/OrgZone_rel';
			attribute<impl/dest>  DstZone_rel      := ='CarPerMoment/'+/ModelParameters/Advanced/Car_CongestionMoment_ForDirect+'/Car/Front/DstZone_rel';
		}
	}
	
	// Met CarTimeDependent (sinds 2026-10-09, #132) hangt de autorit van het vertrekmoment af: hij staat dan niet in Direct_OD, maar per moment in
	// een eigen store (Direct/CarPerMoment/TD<moment>), en de eindafweging van elk blok en moment leest daaruit de rijen van haar herkomsten en
	// voegt ze toe (PerDepartureMoment_T, CarRows en Direct_OD_M). Zonder andere directe modaliteit (Component Auto) is Direct_OD dan leeg.
	unit<uint8> DirectModes_TI := select_with_attr_by_cond(DirectModes_Selected, not(/ModelParameters/Advanced/CarTimeDependent && DirectModes_Selected/name == 'Car'))
	,	Descr = "De directe modaliteiten die niet van het vertrekmoment afhangen: alle toegestane, behalve de auto met CarTimeDependent.";
	parameter<bool> HasDirectTI := #DirectModes_TI > 0;
	unit<uint64> Direct_OD := = HasDirectTI ? 'union_unit_uint64('+asList('Direct/'+DirectModes_TI/name, ',')+')' : 'range(uint64, 0u64, 0u64)'
	,	Descr = "Alle directe ritten van de toegestane modaliteiten die niet van het vertrekmoment afhangen, volledige HB-tabel; per blok gefilterd in PublicTransport/Direct_OD."
	{
		attribute<impl/org>   OrgZone_rel      := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/OrgZone_rel', ',')+')' : 'const(value(null_u, impl/org), .)';
		attribute<impl/dest>  DstZone_rel      := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/DstZone_rel', ',')+')' : 'const(value(null_u, impl/dest), .)';
		attribute<s>          Duration_seconds := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/Duration_seconds', ',')+')' : 'const(0[s], .)';
		attribute<dam>        Distance         := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/Distance', ',')+')' : 'const(0[dam], .)';
		attribute<Ct>         Price            := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/Price', ',')+')' : 'const(0[Ct], .)';
		attribute<Ct>         Price_Augm       := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/Price_Augm', ',')+')' : 'const(0[Ct], .)';
		attribute<impl/Modes> Mode_rel         := = HasDirectTI ? 'union_data(., '+asList('Direct/'+DirectModes_TI/name+'/Mode_rel', ',')+')' : 'const(impl/Modes/V/Car, .)';
	}
	
	container TimeInvariantConnections := 
		for_each_ne(
			TimeInvariantTypes/name
			, 'Create_TimeInvariantConnection_T('+string(id(TimeInvariantTypes))+'[TimeInvariantTypes])'
		), Descr = "i.e. voor/na transport";
	
	Template Create_TimeInvariantConnection_T  : using = "/SourceData/Infrastructure/GTFS/RelevantSelection"
	{
		parameter<TimeInvariantTypes> TimeInvariantTypes_rel;
		///
		parameter<string> ConnectionType := TimeInvariantTypes/ConnectionType[TimeInvariantTypes_rel];
		parameter<string> Mode           := TimeInvariantTypes/Mode[TimeInvariantTypes_rel];
		parameter<string> OriginSet      := TimeInvariantTypes/OriginSet[TimeInvariantTypes_rel];
		parameter<string> DestinationSet := TimeInvariantTypes/DestinationSet[TimeInvariantTypes_rel];
		parameter<string> Mode_abbrev    := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
		parameter<Modes>  Mode_rel       := TimeInvariantTypes/Mode_rel[TimeInvariantTypes_rel];
		parameter<string> NetworkType    := TimeInvariantTypes/NetworkType[TimeInvariantTypes_rel];
		parameter<string> VN_Transport   := TimeInvariantTypes/VN_Transport[TimeInvariantTypes_rel];
		unit<uint32>      Network        := =NetworkType == 'Cycling' ? 'SourceData/Infrastructure/Network_Cycling' : 'SourceData/Infrastructure/OSM/Network_'+NetworkType;
		
		container Create_Routes      := ='Templates/CreateNetwork_Pedestrian_Bike_T(
												PublicTransport_Prep/Impl/'+OriginSet+ //inStart
												', PublicTransport_Prep/Impl/'+DestinationSet+ //inEind
												', Network' //Roads
												', Mode' //TravelMode
												', NetworkType' //NetworkType
												', ConnectionType' //ConnectionType
												', Create_Optimised_Network_'+Mode+ //Optimised_Network
											')';
	}

	// DE BENEN VAN HET VOOR- EN NATRANSPORT IN STORES (sinds 2026-10-19): een keer per peildatum, herkomstenset en bestemmingenset
	// de basissets, lopen en fietsen naar elke halte en fietsen van elke halte, elk een parquet-bestand in IntermediateResults
	// (LegStores/<type>/Write_Legs; batch/UpdateAll.cmd legs), zodat ze ook buiten het model bruikbaar zijn: per been de buurt
	// (CBS-code), de halte (GTFS stop_id en stop_name), de netwerkreistijd in minuten en de afstand in meter (float64, zodat het
	// model ze exact terugleest). De naam noemt de buurtset: Legs_B2025toStops_Walking_<hash>.parquet, Legs_Stops2B2025_Cycling_
	// <hash>.parquet; de handtekening staat ernaast in <naam>.signature.txt. Lopen van een halte naar de bestemmingen is het
	// spiegelbeeld van lopen van de buurten naar de haltes als herkomsten en bestemmingen dezelfde set zijn (WalkingMirror): het
	// loopnet heeft geen eenrichting. Fietsen niet: het fietsnet van de Fietsersbond heeft eenrichtingsfietspaden. Ze hangen niet af
	// van het dagdeel of de component. De andere typen zijn een selectie daaruit (Legs/<type>/ODMatrix): de route naar een halte is
	// dezelfde, welke haltes er ook doelen zijn, dus C_RM, C_RMT en C_Ric zijn C_ naar die haltes, RM_C, RMT_C en OVf_C zijn _C van
	// die haltes, met hun eigen maximale tijd (die niet langer mag zijn dan die van de basisset). Start- en parkeertijd en de prijs
	// volgen bij het lezen, zoals in Templates/CreateNetwork_Pedestrian_Bike_T. Tot 2026-10-20 waren de stores mmd, tot 2026-10-19
	// rekende elke run (elke portie blokken) de benen van zijn component opnieuw.
	parameter<bool> WalkingMirror := /ModelParameters/Advanced/OrgSet_string == /ModelParameters/Advanced/DestSet_string
	,	Descr = "Zijn herkomsten en bestemmingen dezelfde set? Dan is lopen van een halte naar een bestemming het spiegelbeeld van lopen van die buurt naar de halte, en komt er geen store voor Stops2Dest_Walking (sinds 2026-10-20; gemeten voor Buurt2025: op 56 van de 149.164 benen na in beide richtingen, met dezelfde reistijd).";
	unit<uint8> AllBaseLegTypes : nrofrows = 4
	{
		attribute<string> name : ['Org2Stops_Walking', 'Org2Stops_Cycling', 'Stops2Dest_Walking', 'Stops2Dest_Cycling'];
	}
	unit<uint8> BaseLegTypes := select_with_attr_by_cond(AllBaseLegTypes, not(WalkingMirror && AllBaseLegTypes/name == 'Stops2Dest_Walking'))
	,	Descr = "De basissets van de benen met een store, elk een Dijkstra over het hele netwerk met de maximale tijd van het type.";
	container LegStores := for_each_ne(BaseLegTypes/name, 'LegStore_T(' + quote(BaseLegTypes/name) + ')')
	,	Descr = "Per base set: Calc_Legs, Write_Legs, Read_Legs, and Legs, the one the model uses (ModelParameters/Advanced/LegsDecoupled).";
	parameter<string> LegStores_Write := 'Ready', ExplicitSuppliers = "=/ModelParameters/Advanced/LegsDecoupled ? asList('LegStores/' + BaseLegTypes/name + '/Write_Legs/legs', ';') + (/ModelParameters/Advanced/IsOD ? ';' + asList('LegStores/' + BaseLegTypes/name + '/Write_Links/links', ';') : '') : ''"
	,	Descr = "Writes the stores of the legs (batch/UpdateAll.cmd legs), in the OD pair mode also their links; writes nothing without ModelParameters/Advanced/LegsDecoupled.";

	Template LegStore_T
	{
		parameter<string> TypeName;
		///
		parameter<TimeInvariantTypes> TimeInvariantTypes_rel := rlookup(TypeName, TimeInvariantTypes/name);
		parameter<bool>   IsPre      := TimeInvariantTypes/VN_Transport[TimeInvariantTypes_rel] == 'V';
		parameter<string> NetworkTag := TimeInvariantTypes/NetworkType[TimeInvariantTypes_rel] == 'Cycling'
			? 'cycling' + string(/ModelParameters/CyclingSpeed_kmhr) + 'kmh' + (/ModelParameters/Advanced/CyclingNetwork_FileTag != '' ? /ModelParameters/Advanced/CyclingNetwork_FileTag : '_osm' + /SourceData/Infrastructure/OSM/file_date + /SourceData/Infrastructure/OSM/StoreRevision)
			: 'walking' + string(/ModelParameters/WalkingSpeed_kmhr) + 'kmh_osm' + /SourceData/Infrastructure/OSM/file_date + /SourceData/Infrastructure/OSM/StoreRevision
		,	Descr = "Het netwerk en de snelheid, voor de handtekening: het Fietsersbond-fietsnet (CyclingNetwork_FileTag) of de OSM-netwerkstore.";
		parameter<string> Signature := 'Legs_' + TypeName + '_' + NetworkTag
			+ '_MaxTime-' + string(TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel]) + 'min'
			+ '_ORG-' + /ModelParameters/Advanced/OrgSet_string + '_DEST-' + /ModelParameters/Advanced/DestSet_string
			+ '_' + /ModelParameters/Advanced/Analysis_date + (/ModelParameters/Advanced/GTFS_file_date == /ModelParameters/Advanced/Analysis_date ? '' : '_gtfs' + /ModelParameters/Advanced/GTFS_file_date)
			+ '_places' + string(#impl/Places) + '-stops' + string(#impl/Stops)
			+ '_parquet_r2'
		,	Descr = "Handtekening van de store: het type, netwerk en snelheid, de maximale tijd, de herkomsten, de bestemmingen en de haltes (feed en peildatum; het aantal plaatsen en haltes ter controle), het formaat en de revisie.";
		container Hash := /Templates/StringHash_T(Signature);
		parameter<string> StorageBase_Str := /ModelParameters/Advanced/IntermediateResultsDir + '/Legs_' + replace(TypeName, 'Org2', /ModelParameters/Advanced/OrgSet_NameTag + 'to', 'Dest', /ModelParameters/Advanced/DestSet_NameTag) + '_' + Hash/Hex
		,	Descr = "Naam van de store zonder extensie: het type met de herkomsten- of bestemmingenset (OrgSet_NameTag: Legs_B2025toStops_Walking, Legs_Stops2B2025_Cycling), de rest als hash van Signature.";
		parameter<string> StorageName_Str := StorageBase_Str + '.parquet';
		container Sig := /Templates/StoreSignature_T(StorageName_Str, StorageBase_Str + '.signature.txt', Signature, strlen('.signature.txt') - strlen('.parquet'))
		,	Descr = "De handtekening naast de store, in <naam>.signature.txt: Write_Legs schrijft hem, Legs_store controleert hem.";
		unit<uint64> Src := ='TimeInvariantConnections/' + TypeName + '/Create_Routes/ODMatrix';
		attribute<impl/Places> Buurt_Place_rel (Src) := = IsPre ? 'Src/From_Place_rel' : 'Src/To_Place_rel';
		attribute<impl/Places> Stop_Place_rel  (Src) := = IsPre ? 'Src/To_Place_rel' : 'Src/From_Place_rel';
		parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';
		unit<uint32> Calc_Legs := range(uint32, 0, uint32(#Src))
		,	Descr = "The legs of this base set as calculated in the run: per leg the neighbourhood, the stop, the network travel time and the distance."
		{
			attribute<Src>     Src_rel    := value(id(.), Src);
			attribute<string>  BuurtCode  := impl/Places/label[Buurt_Place_rel[Src_rel]];
			attribute<string>  stop_id    := /SourceData/Infrastructure/GTFS/PublicTransportNet/Stops/stop_id[impl/Places/Stop_rel[Stop_Place_rel[Src_rel]]];
			attribute<string>  stop_name  := impl/Stops/name[impl/Places/Stop_rel[Stop_Place_rel[Src_rel]]];
			attribute<float64> Traveltime := float64(Src/impedance[Src_rel]) / 60d, Descr = "Network travel time of the leg in minutes, without start and parking time.";
			attribute<float64> TravelDist := float64(Src/alt_imp[Src_rel]) * 1000d, Descr = "Distance of the leg in metres.";
		}
		container Write_Legs : StorageName = "=StorageName_Str", StorageType = "gdalwrite.vect"
		,	Descr = "Writes Calc_Legs as parquet to StorageName_Str, with the signature beside it (Sig); calculate Write_Legs/legs to make the store."
		{
			unit<uint32> legs := Calc_Legs, ExplicitSuppliers = "Sig/ForWriting"
			{
				attribute<string>  BuurtCode  := Calc_Legs/BuurtCode;
				attribute<string>  stop_id    := Calc_Legs/stop_id;
				attribute<string>  stop_name  := Calc_Legs/stop_name;
				attribute<float64> Traveltime := Calc_Legs/Traveltime;
				attribute<float64> TravelDist := Calc_Legs/TravelDist;
			}
		}
		unit<uint32> Read_Legs : StorageName = "=Sig/ForReading", StorageType = "gdal.vect", StorageReadOnly = "true"
		,	Descr = "Reads the store of Write_Legs; fails when the signature is missing or differs (Sig/CheckGate)."
		{
			attribute<string>  BuurtCode;
			attribute<string>  stop_id;
			attribute<float64> Traveltime;
			attribute<float64> TravelDist;
		}
		unit<uint32> Legs := = /ModelParameters/Advanced/LegsDecoupled ? 'Read_Legs' : 'Calc_Legs'
		,	Descr = "The legs the model uses: read from the store with ModelParameters/Advanced/LegsDecoupled, otherwise calculated in the run.";

		// DE LINKS VAN DE BENEN (#129), alleen in de HB-paarmodus (ModelParameters/Advanced/IsOD): per been, in de volgorde van
		// de reis, de links van zijn route over het vereenvoudigde net (Create_Routes/Links), elk met zijn rechte lijn, als gpkg naast de store.
		parameter<string> LinksName_Str := StorageBase_Str + '_links.gpkg';
		container Calc_Links
		{
			unit<uint32> links := ='TimeInvariantConnections/' + TypeName + '/Create_Routes/Links/Rows'
			{
				attribute<Src>     Leg_rel    := ='TimeInvariantConnections/' + TypeName + '/Create_Routes/Links/Rows/Route_rel';
				attribute<string>  BuurtCode  := impl/Places/label[Buurt_Place_rel[Leg_rel]];
				attribute<string>  stop_id    := /SourceData/Infrastructure/GTFS/PublicTransportNet/Stops/stop_id[impl/Places/Stop_rel[Stop_Place_rel[Leg_rel]]];
				attribute<uint32>  Volgnr     := ='TimeInvariantConnections/' + TypeName + '/Create_Routes/Links/Rows/Volgnr';
				attribute<rdc>     geometry (arc) := ='TimeInvariantConnections/' + TypeName + '/Create_Routes/Links/Rows/geometry';
			}
		}
		container Write_Links : StorageName = "=LinksName_Str", StorageType = "gdalwrite.vect"
		,	Descr = "Writes the links of the legs to LinksName_Str; calculate Write_Links/links. Only in the OD pair mode."
		{
			unit<uint32> links := Calc_Links/links, ExplicitSuppliers = "Sig/ForWriting"
			{
				attribute<string>  BuurtCode      := Calc_Links/links/BuurtCode;
				attribute<string>  stop_id        := Calc_Links/links/stop_id;
				attribute<uint32>  Volgnr         := Calc_Links/links/Volgnr;
				attribute<rdc>     geometry (arc) := Calc_Links/links/geometry;
			}
		}
		container Read_Links : StorageName = "=LinksName_Str", StorageType = "gdal.vect", StorageReadOnly = "true"
		,	Descr = "Reads the links of Write_Links; only in the OD pair mode."
		{
			unit<uint32> links
			{
				attribute<string>  BuurtCode;
				attribute<string>  stop_id;
				attribute<uint32>  Volgnr;
				attribute<rdc>     geometry (arc);
			}
		}
		container Links := = /ModelParameters/Advanced/LegsDecoupled ? 'Read_Links' : 'Calc_Links'
		,	Descr = "The links the model uses: read with ModelParameters/Advanced/LegsDecoupled, otherwise calculated in the run.";
	}

	container Legs :=
		for_each_ne(
			TimeInvariantTypes/name
			, 'Legs_T(' + string(id(TimeInvariantTypes)) + '[TimeInvariantTypes])'
		), Descr = "Per type van voor- of natransport de benen uit de store van zijn basisset (sinds 2026-10-19), met dezelfde kolommen als TimeInvariantConnections/<type>/Create_Routes/ODMatrix.";
	Template Legs_T
	{
		parameter<TimeInvariantTypes> TimeInvariantTypes_rel;
		///
		parameter<string>  Mode           := TimeInvariantTypes/Mode[TimeInvariantTypes_rel];
		parameter<bool>    IsPreTransport := TimeInvariantTypes/VN_Transport[TimeInvariantTypes_rel] == 'V';
		parameter<bool>    IsCycling      := Mode == 'Cycling';
		parameter<bool>    IsMirror       := !IsPreTransport && Mode == 'Walking' && WalkingMirror, Descr = "Lopen naar de bestemmingen als spiegelbeeld van lopen van de buurten naar de haltes (WalkingMirror).";
		parameter<string>  BaseType       := IsMirror ? 'Org2Stops_Walking' : (IsPreTransport ? 'Org2Stops_' : 'Stops2Dest_') + Mode;
		parameter<string>  StopSet        := IsPreTransport ? TimeInvariantTypes/DestinationSet[TimeInvariantTypes_rel] : TimeInvariantTypes/OriginSet[TimeInvariantTypes_rel]
		,	Descr = "De haltes van dit type: Stops (alle), RM_Stops, RMT_Stops, Ric_Stops of OVF_Stops.";
		parameter<min_f>   MaxTime        := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel]
		,	IntegrityCheck = "MaxTime <= TimeInvariantTypes/MaxTime[rlookup(BaseType, TimeInvariantTypes/name)]";
		unit<uint32> Src := ='LegStores/' + BaseType + '/Legs';
		// de buurt is een herkomst in het voortransport en een bestemming in het natransport, ook bij het spiegelbeeld
		attribute<impl/Places> Buurt_Place_rel (Src) := = IsPreTransport
		                                               ? 'invert(impl/Places/Origin_rel)[rlookup(Src/BuurtCode, impl/org/name)]'
		                                               : 'invert(impl/Places/Dest_rel)[rlookup(Src/BuurtCode, impl/dest/name)]';
		attribute<impl/Places> Stop_Place_rel  (Src) := impl/Stops/Place_rel[rlookup(Src/stop_id, /SourceData/Infrastructure/GTFS/PublicTransportNet/Stops/stop_id)];
		attribute<s_f>         Src_impedance   (Src) := value(float32(Src/Traveltime * 60d), s_f);
		attribute<km>          Src_alt_imp     (Src) := value(float32(Src/TravelDist / 1000d), km);
		attribute<bool>        InStopSet       (Src) := = StopSet == 'Stops' ? 'const(TRUE, Src)' : 'IsDefined(impl/Places/' + StopSet + '_rel[Stop_Place_rel])';
		attribute<bool>        Keep            (Src) := InStopSet && Src_impedance <= convert(MaxTime, s_f);
		unit<uint32> ODMatrix := select_with_org_rel(Keep)
		{
			attribute<impl/Places> From_Place_rel       := = IsPreTransport ? 'Buurt_Place_rel[org_rel]' : 'Stop_Place_rel[org_rel]';
			attribute<impl/Places> To_Place_rel         := = IsPreTransport ? 'Stop_Place_rel[org_rel]' : 'Buurt_Place_rel[org_rel]';
			attribute<s_f>         impedance            := Src_impedance[org_rel];
			attribute<dam>         Distance             := Src_alt_imp[org_rel][dam];
			// start- en parkeertijd en prijs zoals in Templates/CreateNetwork_Pedestrian_Bike_T
			attribute<bool>        EndsAtICStation      := IsPreTransport && IsDefined(impl/Places/Ric_Stop_rel[To_Place_rel]);
			parameter<min_f>       ExtraTime_min        := (IsCycling ? ModelParameters/Cycling_StartTime : 0[min_f])
			                                             + (IsCycling && IsPreTransport ? ModelParameters/Advanced/Cycling_PreTransport_Penalty : 0[min_f]);
			attribute<s_f>         ExtraTime_seconds    := = IsCycling && IsPreTransport
			                                             ? 'convert(ExtraTime_min, s_f) + (EndsAtICStation ? convert(ModelParameters/Cycling_ParkingTime_IC_Station, s_f) : 0[s_f])'
			                                             : 'const(convert(ExtraTime_min, s_f), .)';
			attribute<s_f>         Duration_seconds_ext := impedance + ExtraTime_seconds;
			attribute<ct>          Price                := = TimeInvariantTypes/IsOVfiets[TimeInvariantTypes_rel]
			                                             ? 'const(rounded_convert(ModelParameters/OVFiets_RentalPrice, ct), .)'
			                                             : 'rounded_convert(Duration_seconds_ext[min_f] * ModelParameters/' + (IsPreTransport ? 'PreTransport' : 'PostTransport') + '_' + Mode + '_Time_Costs, ct)';
			attribute<impl/Modes>  Mode_rel             := const(TimeInvariantTypes/Mode_rel[TimeInvariantTypes_rel], .);
		}
	}


	// Sinds 2026-10-20 ook de plaats en de (tijd, plaats) van elke in- en uitstapgebeurtenis, zoals PT ze per keten rekent: de ketens van
	// een herkomstblok (PublicTransport/PT_InBlock) zoeken ze hier op, in plaats van dat PT ze voor alle ketens uitrekent.
	unit<uint64> uq_c_FromTime_Stop := unique_uint64(impl/All_Time_Stops/c_FromTime_Stop_rel), using = "impl"
	{
		attribute<impl/c_Time_Stops> c_FromTime_Stop_rel      := values;
		attribute<Time>              From_Time_rel            := value(c_FromTime_Stop_rel / uint64(#Stops), Time);
		attribute<Stops>             From_Stop_rel            := value(c_FromTime_Stop_rel % uint64(#Stops), Stops);
		attribute<Places>            From_Place_rel           := Stops/Place_rel[From_Stop_rel];
		attribute<c_Time_Places>     c_FromTime_Place_rel     := combine_data(c_Time_Places, From_Time_rel, From_Place_rel);
		attribute<string>            Label                    := Stops/name[From_Stop_rel]+' @ '+Time/TemplatableText[From_Time_rel];
		attribute<bool>              IsVBoarding              := /NetworkSetup/impl/IsVStop[From_Place_rel], Descr = "Instappen bij een halte waar een voortransportbeen van de component eindigt (NetworkSetup/impl/IsVStop)? Alleen zulke ketens kan de uitvoer gebruiken (PT_V).";
	}
	unit<uint64> uq_c_ToTime_Stop   := unique_uint64(impl/All_Time_Stops/c_ToTime_Stop_rel), using = "impl"
	{
		attribute<impl/c_Time_Stops> c_ToTime_Stop_rel        := values;
		attribute<Time>              To_Time_rel              := value(c_ToTime_Stop_rel / uint64(#Stops), Time);
		attribute<Stops>             To_Stop_rel              := value(c_ToTime_Stop_rel % uint64(#Stops), Stops);
		attribute<Places>            To_Place_rel             := Stops/Place_rel[To_Stop_rel];
		attribute<c_Time_Places>     c_ToTime_Place_rel       := combine_data(c_Time_Places, To_Time_rel, To_Place_rel);
		attribute<string>            Label                    := Stops/name[To_Stop_rel]+' @ '+Time/TemplatableText[To_Time_rel];
	}
	
	unit<uint64> c_FromTS_ToTS      := combine_unit_uint64(uq_c_FromTime_Stop, uq_c_ToTime_Stop);
	
	#include<Transfers.dms>


	container ChainGeneration_PerBlock :=
		for_each_ne(
			impl/BlockDomain/name
			, 'ChainGeneration_PerBlock_T('+string(id(impl/BlockDomain))+')'
		), using = "impl";
		
	Template ChainGeneration_PerBlock_T
	{
		parameter<BlockDomain> BlockDomain_id;
		///
		container StartCalc0{parameter<string> BlockDomain_name := BlockDomain/name[../BlockDomain_id], IntegrityCheck = "ModelParameters/Advanced/IsOD || uint64(ModelParameters/Advanced/MaxStopBlockSize) * uint64(ModelParameters/Advanced/NumberOfStopBlocks) > uint64(#BlockSelections)";}
		container StartCalc := PhaseContainer(StartCalc0, 'Start calculating '+string(StartCalc0/BlockDomain_name)+', with block size of '+string(BlockDomain/BlockSize[BlockDomain_id]));
		
		container Chain_Generation := 
			for_each_ne(iif(impl/ToBeCalculated_Chains/right == '', '',  impl/ToBeCalculated_Chains/name) // skip the monodial chains as they are defined explicitly below
			,  'ChainJoiner_T(
					'+impl/ToBeCalculated_Chains/left+'/Result' //left unit
					',OD_'+impl/ToBeCalculated_Chains/right+'/Result' //right unit
					+ (ModelParameters/Advanced/IsOD && strlen(impl/ToBeCalculated_Chains/name) == uint32(/Classifications/Chains/max_Chains) ? '_ToD' : '') + // bij een HB-paar het laatste been van de langste ketens alleen naar de haltes van de bestemming (sinds 2026-10-21, #129)
					',Transfers/'+impl/ToBeCalculated_Chains/transfer_name+'/Result' //transfer unit
					','+Quote(impl/ToBeCalculated_Chains/Left)+ //left name str
					','+Quote(impl/ToBeCalculated_Chains/Right)+ //right name str
				')' 
			)
		{
			container L  
			{
				unit<uint32> result := select_with_attr_by_cond(OD_L/Result, BlockSelections/Block_rel[OD_L/Result/From_Stop_rel] == BlockDomain_id && OD_L/Result/From_Time_rel <= impl/LastBoardingMoment)
				{
					parameter<uint32> ModeFactor := OD_L/Result/ModeFactor;
				}
			}
			container R 
			{
				unit<uint32> result := select_with_attr_by_cond(OD_R/Result, BlockSelections/Block_rel[OD_R/Result/From_Stop_rel] == BlockDomain_id && OD_R/Result/From_Time_rel <= impl/LastBoardingMoment)
				{
					parameter<uint32> ModeFactor := OD_R/Result/ModeFactor;
				}
			}
		}
		
		unit<uint64> Allowed_Chains := ='union_unit_uint64('+AsItemList('Chain_Generation/'+impl/Allowed_ChainsK/name+'/Result')+')', using = "impl"
		{
			attribute<Allowed_ChainsK>      Allowed_ChainsK_rel           := ='union_data(., '+asList('const('+string(id(Allowed_ChainsK))+'[Allowed_ChainsK], Chain_Generation/'+Allowed_ChainsK/name+'/Result)', ',')+')';
			attribute<ct>                   Price                          := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Price')+')';
			attribute<ct>                   Price_augm                     := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Price_augm')+')';
			attribute<ct>                   Price_S                        := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Price_S')+')', Descr = "Rit-opslag van de keten (#3), het deel van Price dat per been geldt (ICD/ICE-toeslag); voor validatie tegen 9292 (#53), dat de toeslag niet in de prijs telt.";
			attribute<s>                    Traveltime                     := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Traveltime')+')';
			attribute<uint32>               ModeCode                       := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/ModeCode')+')';
			attribute<uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel         := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/uq_c_FromTime_Stop_rel')+')';
			attribute<uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel           := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/uq_c_ToTime_Stop_rel')+')';
			attribute<Stops>                From_Stop_rel                  := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/uq_c_FromTime_Stop_rel->From_Stop_rel')+')';
			attribute<Stops>                To_Stop_rel                    := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/uq_c_ToTime_Stop_rel->To_Stop_rel')+')';
			// om een keten terug te leiden naar zijn benen (sinds 2026-10-21, #129; alleen gevraagd in de HB-paarmodus, OD_Ketens)
			attribute<uint32>               Chain_rel                      := ='union_data(., '+AsItemList('id(Chain_Generation/'+Allowed_ChainsK/name+'/Result)')+')', Descr = "Het rijnummer van de keten in Chain_Generation/<Allowed_ChainsK_rel>/Result.";
			attribute<bool>                 EindigtBijD                    := /NetworkSetup/PublicTransport_Prep/OD_Haltes/IsNStop[Stops/Place_rel[To_Stop_rel]], Descr = "Alleen in de HB-paarmodus: stapt de keten uit bij een halte vanwaar de bestemming te bereiken is (OD_Haltes/IsNStop)?";

			attribute<dam>                  TravelDist_Bus                 := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/TravelDist_Bus')+')';
			attribute<dam>                  Traveldist_Metro               := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Traveldist_Metro')+')';
			attribute<dam>                  Traveldist_Tram                := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Traveldist_Tram')+')';
			attribute<dam>                  Traveldist_Rail                := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Traveldist_Rail')+')';
			attribute<dam>                  Traveldist_Ferry               := ='union_data(., '+AsItemList('Chain_Generation/'+Allowed_ChainsK/name+'/Result/Traveldist_Ferry')+')';
			
			unit<uint64>                    StarEvent2Stop                 := combine_unit_uint64(uq_c_FromTime_Stop, Stops), Descr = "(instaptijdhalte, bestemmingshalte). Tot 2026-09-27 union_unit_uint64(Stops, Stops): dezelfde sleutelwaarden, maar een unit van 2 x #Stops elementen voor een sleutel tot #uq_c_FromTime_Stop x #Stops (audit 6.7).";
			attribute<StarEvent2Stop>       OD_pair_key                    := combine_data(StarEvent2Stop, uq_c_FromTime_Stop_rel, To_Stop_rel); //fka OD_key
			unit<uint32>                    OD_pair                        := unique_uint32(OD_pair_key);
			attribute<OD_pair>              OD_pair_rel                    := rlookup(OD_pair_key, OD_pair/values);
			unit<uint8> ParetoAttr := Classifications/FinalParetoAttr;
			// pareto_optimal_eps keeps per group the rows that no other row dominates, with a relative epsilon per criterion (Classifications/../EpsilonExpr; 0 = exact).
			attribute<bool>                 pareto_condition               := ='pareto_optimal_eps(OD_pair_rel, ' + asList(ParetoAttr/ParetoArgs, ', ') + ')';
		} 

		container BlockResultContainer
		: Descr = "hack om deadlock te omzeilen"
		, URL = "https://github.com/ObjectVision/GeoDMS/issues/965"
		{
			unit<uint64> Result := ='select(Allowed_Chains/pareto_condition' + (ModelParameters/Advanced/IsOD ? ' && Allowed_Chains/EindigtBijD' : '') + ')' //fka uq_OD_key; bij een HB-paar alleen de ketens naar de haltes van de bestemming (sinds 2026-10-21, #129)
			{
				attribute<Allowed_Chains>       Allowed_Chains_rel          := collect_by_cond(., id(Allowed_Chains)), Descr = "De keten in Allowed_Chains, om hem terug te leiden naar zijn benen (alleen gevraagd in de HB-paarmodus, OD_Ketens)."; 
				attribute<ct>                   Price                       := =ModelParameters/Advanced/PriceExportsAndIntegrityChecksNeeded ? 'collect_by_cond(., Allowed_Chains/Price)' : 'const(null_f, ., ct)';
				attribute<ct>                   Price_augm                  := =ModelParameters/Advanced/PriceExportsAndIntegrityChecksNeeded ? 'collect_by_cond(., Allowed_Chains/Price_augm)' : 'const(null_f, ., ct)';
				attribute<ct>                   Price_S                     := =ModelParameters/Advanced/PriceExportsAndIntegrityChecksNeeded ? 'collect_by_cond(., Allowed_Chains/Price_S)' : 'const(null_f, ., ct)';
				attribute<s>                    Traveltime                  := collect_by_cond(., Allowed_Chains/Traveltime);
				attribute<uint32>               ModeCode                    := collect_by_cond(., Allowed_Chains/ModeCode);

				attribute<Allowed_ChainsK>      Allowed_ChainsK_rel         := collect_by_cond(., Allowed_Chains/Allowed_ChainsK_rel);
				attribute<uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel      := collect_by_cond(., Allowed_Chains/uq_c_FromTime_Stop_rel);
				attribute<uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel        := collect_by_cond(., Allowed_Chains/uq_c_ToTime_Stop_rel);
				
				attribute<dam>                  TravelDist_Bus              := collect_by_cond(., Allowed_Chains/TravelDist_Bus);
				attribute<dam>                  Traveldist_Metro            := collect_by_cond(., Allowed_Chains/Traveldist_Metro);
				attribute<dam>                  Traveldist_Tram             := collect_by_cond(., Allowed_Chains/Traveldist_Tram);
				attribute<dam>                  Traveldist_Rail             := collect_by_cond(., Allowed_Chains/Traveldist_Rail);
				attribute<dam>                  Traveldist_Ferry            := collect_by_cond(., Allowed_Chains/Traveldist_Ferry);
			}
		}
	 	container Fence := PhaseContainer(BlockResultContainer, 'Calculated: '+string(StartCalc/BlockDomain_name));
		// Sinds 2026-09-29 schrijft elk blok zijn ketens in een eigen store (StorageBlockDir_Str/<n>of<N>.mmd), zodat de resultaten
		// niet tot het eind in het geheugen blijven en een onderbroken ketenstap bij het eerste ontbrekende blok verder kan
		// (batch/WriteChainBlocks.ps1, PT_Chains_Blocks/ToDo).
		unit<uint64> Write := Fence/Result
		, StorageName = "=/NetworkSetup/PublicTransport_Prep/StorageBlockDir_Str + '/' + BlockDomain/StoreName[BlockDomain_id] + '.mmd'"
		, ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/PT_Chains_Sig/ForWriting"
		{
			attribute<uint32> ModeCode := Fence/Result/ModeCode;
			attribute<Ct> Price := Fence/Result/Price;
			attribute<Ct> Price_augm := Fence/Result/Price_augm;
			attribute<Ct> Price_S := Fence/Result/Price_S;
			attribute<s> Traveltime := Fence/Result/Traveltime;
			attribute<dam> TravelDist_Bus := Fence/Result/TravelDist_Bus;
			attribute<dam> Traveldist_Metro := Fence/Result/Traveldist_Metro;
			attribute<dam> Traveldist_Tram := Fence/Result/Traveldist_Tram;
			attribute<dam> Traveldist_Rail := Fence/Result/Traveldist_Rail;
			attribute<dam> Traveldist_Ferry := Fence/Result/Traveldist_Ferry;
			attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := Fence/Result/uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := Fence/Result/uq_c_ToTime_Stop_rel;
		}
	}
	
	container ChainGeneration_Single
	:	Descr = "The chains of all stop blocks in one store, the variant of ModelParameters/Advanced/PT_Chains_PerBlock FALSE: Calc unites the blocks, Write writes the store, Read reads it."
	{
		// De traceer-attributen Block_rel en result_rel staan BUITEN de store: sinds GeoDMS 20.19.0
		// (issue #1245) weigert de MMD-writer elk item met DisableStorage onder zijn holder, want alles
		// onder de holder hoort bij de store. Calc is de rekenkant met die twee erbij;
		// Write houdt de naam en de StorageName en schrijft alleen de resultaatkolommen.
		unit<uint64> Calc   := ='union_unit_uint64('+AsItemList('ChainGeneration_PerBlock/'+impl/BlockDomain/name+'/Fence/Result')+')'
		, Descr = "Rekenkant van de geunionede ketenresultaten per block (niet opgeslagen)."
		, using = "impl"
		{
			// for tracing back resulting values
			attribute<impl/BlockDomain>    Block_rel                  := ='union_data(.,'+AsItemList('const('+String(Id(BlockDomain))+'[impl/BlockDomain], ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result)')+')'; 
			attribute<uint64>              result_rel                 := ='union_data(.,'+AsItemList('ID(ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result)')+')';
			attribute<uint32>              ModeCode                   := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/ModeCode')+')';
			attribute<Ct>                  Price                      := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Price')+')';
			attribute<Ct>                  Price_augm                 := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Price_augm')+')';
			attribute<Ct>                  Price_S                    := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Price_S')+')';
			attribute<s>                   Traveltime                 := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Traveltime')+')';
			attribute<dam>                 TravelDist_Bus             := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/TravelDist_Bus')+')';
			attribute<dam>                 Traveldist_Metro           := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Traveldist_Metro')+')';
			attribute<dam>                 Traveldist_Tram            := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Traveldist_Tram')+')';
			attribute<dam>                 Traveldist_Rail            := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Traveldist_Rail')+')';
			attribute<dam>                 Traveldist_Ferry           := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/Traveldist_Ferry')+')';
		
			attribute<uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel      := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/uq_c_FromTime_Stop_rel')+')';
			attribute<uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel        := ='union_data(.,'+AsItemList('ChainGeneration_PerBlock/'+BlockDomain/name+'/Fence/Result/uq_c_ToTime_Stop_rel')+')';
		} 

		unit<uint64> Write := Calc
		, StorageName = "=StorageName_Str"
		, ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/PT_Chains_Sig/ForWriting"
		, Descr = "Deze set bevat de geunionede resultaten per block."
		, using = "impl"
		{
			attribute<uint32>                ModeCode                   := Calc/ModeCode;
			attribute<Ct>                    Price                      := Calc/Price;
			attribute<Ct>                    Price_augm                 := Calc/Price_augm;
			attribute<Ct>                    Price_S                    := Calc/Price_S;
			attribute<s>                     Traveltime                 := Calc/Traveltime;
			attribute<dam>                   TravelDist_Bus             := Calc/TravelDist_Bus;
			attribute<dam>                   Traveldist_Metro           := Calc/Traveldist_Metro;
			attribute<dam>                   Traveldist_Tram            := Calc/Traveldist_Tram;
			attribute<dam>                   Traveldist_Rail            := Calc/Traveldist_Rail;
			attribute<dam>                   Traveldist_Ferry           := Calc/Traveldist_Ferry;
			attribute<uq_c_FromTime_Stop>    uq_c_FromTime_Stop_rel     := Calc/uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop>      uq_c_ToTime_Stop_rel       := Calc/uq_c_ToTime_Stop_rel;
		}

		// Een read-only MMD-lezer mag zelf niets declareren (#1245): de dictionary van de store bepaalt de
		// kolommen. Read is de kale lezer, PT geeft ze door en houdt de afgeleide relaties.
		unit<uint64> Read
		: StorageName = "=PT_Chains_Sig/ForReading"
		, StorageReadOnly = "true"
		, Descr = "Kale lezer van de ketenstore; declareert niets. Faalt als de handtekening ontbreekt of afwijkt (PT_Chains_Sig/CheckGate)."
		;
	}
	
	// De ketenstore per blok (sinds 2026-09-29, ModelParameters/Advanced/PT_Chains_PerBlock): een lezer per blok, de blokken
	// waarvan de store nog ontbreekt (0Dictionary.dms wordt als laatste geschreven) en de lijst van hun schrijvers voor
	// batch/WriteChainBlocks.ps1.
	container PT_Chains_Blocks
	{
		Template ReadBlock_T
		{
			parameter<string> BlockName;
			parameter<string> StoreName;
			///
			unit<uint64> Read : StorageName = "=/NetworkSetup/PublicTransport_Prep/PT_Chains_Sig/ForReading + '/' + StoreName + '.mmd'", StorageReadOnly = "true";
			parameter<bool> IsWritten := ExistingFile('', /NetworkSetup/PublicTransport_Prep/StorageBlockDir_Str + '/' + StoreName + '.mmd/0Dictionary.dms') != '';

			// De ketens van dit haltenblok die de uitvoer kan gebruiken (sinds 2026-10-20, voor PT_V): die instappen bij een halte waar een
			// voortransportbeen van de component eindigt, met de kolommen die de vertrekmomenten lezen. collect_by_cond leest de store per tegel.
			attribute<bool> IsVBoarding (Read) := /NetworkSetup/PublicTransport_Prep/uq_c_FromTime_Stop/IsVBoarding[Read/uq_c_FromTime_Stop_rel];
			unit<uint64> VBoarding := select(IsVBoarding)
			{
				attribute<uint32>                                                ModeCode               := collect_by_cond(., ../IsVBoarding, ../Read/ModeCode);
				attribute<ct>                                                    Price                  := collect_by_cond(., ../IsVBoarding, ../Read/Price);
				attribute<ct>                                                    Price_augm             := collect_by_cond(., ../IsVBoarding, ../Read/Price_augm);
				attribute<s>                                                     Traveltime             := collect_by_cond(., ../IsVBoarding, ../Read/Traveltime);
				attribute<dam>                                                   TravelDist_Bus         := collect_by_cond(., ../IsVBoarding, ../Read/TravelDist_Bus);
				attribute<dam>                                                   Traveldist_Metro       := collect_by_cond(., ../IsVBoarding, ../Read/Traveldist_Metro);
				attribute<dam>                                                   Traveldist_Tram        := collect_by_cond(., ../IsVBoarding, ../Read/Traveldist_Tram);
				attribute<dam>                                                   Traveldist_Rail        := collect_by_cond(., ../IsVBoarding, ../Read/Traveldist_Rail);
				attribute<dam>                                                   Traveldist_Ferry       := collect_by_cond(., ../IsVBoarding, ../Read/Traveldist_Ferry);
				attribute</NetworkSetup/PublicTransport_Prep/uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := collect_by_cond(., ../IsVBoarding, ../Read/uq_c_FromTime_Stop_rel);
				attribute</NetworkSetup/PublicTransport_Prep/uq_c_ToTime_Stop>   uq_c_ToTime_Stop_rel   := collect_by_cond(., ../IsVBoarding, ../Read/uq_c_ToTime_Stop_rel);
				attribute<uint64>                                                Keten                  := collect_by_cond(., ../IsVBoarding, id(../Read)), Descr = "Het rijnummer van de keten in de store van het blok, zoals OD_Ketens/Benen_store/Keten (sinds 2026-10-21, #129; alleen gevraagd in de HB-paarmodus).";
			}
		}
		container PerBlock := for_each_ne(impl/BlockDomain/name, 'ReadBlock_T(' + quote(impl/BlockDomain/name) + ', ' + quote(impl/BlockDomain/StoreName) + ')');

		attribute<bool>   IsWritten (impl/BlockDomain) := ='union_data(impl/BlockDomain, ' + AsItemList('PerBlock/' + impl/BlockDomain/name + '/IsWritten') + ')';
		parameter<uint32> NrBlocks  := #impl/BlockDomain;
		parameter<uint32> NrWritten := sum(uint32(IsWritten));
		unit<uint32> ToDo := select_with_attr_by_cond(impl/BlockDomain, NOT(IsWritten))
		{
			attribute<string> Item := ModelParameters/Advanced/IsOD ? '/NetworkSetup/PublicTransport_Prep/OD_Ketens/Write' : '/NetworkSetup/PublicTransport_Prep/ChainGeneration_PerBlock/' + name + '/Write', Descr = "De schrijver van het blok; bij een HB-paar (sinds 2026-10-21, #129) OD_Ketens/Write, die ook de benen en links van de ketens schrijft, in dezelfde opvraging.";
		}
		parameter<string> ToDo_List := AsList(ToDo/Item, '\n'), StorageName = "%ConfigDir%/../../batch/log/chain_blocks_todo.txt", StorageType = "str"
		, ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/PT_Chains_Sig/ForWriting"
		, Descr = "De schrijvers van de blokken die nog geen store hebben, een per regel; batch/WriteChainBlocks.ps1 leest dit bestand. Het is het eerste wat dat script opvraagt, dus via PT_Chains_Sig/ForWriting schrijft of controleert het hier de handtekening en het langste pad (PT_Chains_Sig/PathLength), voordat er gerekend wordt. Tot 2026-10-03 deed PT_Chains_Blocks/PathLength dat laatste: op 2026-09-30 maakte de flextag _flex5i5w15ct het langste pad 265 tekens, waarna elk blok pas bij het schrijven faalde.";
	}


	// PT leest de ketens uit de store per blok (PT_Chains_PerBlock) of uit de ene store van voor 2026-09-29 (ChainGeneration_Single/Read).
	unit<uint64> PT := = ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_unit_uint64(' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read') + ')' : 'ChainGeneration_Single/Read'
	, using = "impl"
	{ 
		attribute<uint32>                ModeCode                 := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/ModeCode') + ')' : 'ChainGeneration_Single/Read/ModeCode';
		attribute<ct>                    Price                    := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Price') + ')' : 'ChainGeneration_Single/Read/Price';
		attribute<ct>                    Price_augm               := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Price_augm') + ')' : 'ChainGeneration_Single/Read/Price_augm';
		attribute<ct>                    Price_S                  := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Price_S') + ')' : 'ChainGeneration_Single/Read/Price_S';
		attribute<s>                     Traveltime               := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Traveltime') + ')' : 'ChainGeneration_Single/Read/Traveltime';
		attribute<dam>                   TravelDist_Bus           := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/TravelDist_Bus') + ')' : 'ChainGeneration_Single/Read/TravelDist_Bus';
		attribute<dam>                   Traveldist_Metro         := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Traveldist_Metro') + ')' : 'ChainGeneration_Single/Read/Traveldist_Metro';
		attribute<dam>                   Traveldist_Tram          := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Traveldist_Tram') + ')' : 'ChainGeneration_Single/Read/Traveldist_Tram';
		attribute<dam>                   Traveldist_Rail          := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Traveldist_Rail') + ')' : 'ChainGeneration_Single/Read/Traveldist_Rail';
		attribute<dam>                   Traveldist_Ferry         := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/Traveldist_Ferry') + ')' : 'ChainGeneration_Single/Read/Traveldist_Ferry';
		attribute<uq_c_FromTime_Stop>    uq_c_FromTime_Stop_rel   := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/uq_c_FromTime_Stop_rel') + ')' : 'ChainGeneration_Single/Read/uq_c_FromTime_Stop_rel';
		attribute<uq_c_ToTime_Stop>      uq_c_ToTime_Stop_rel     := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/Read/uq_c_ToTime_Stop_rel') + ')' : 'ChainGeneration_Single/Read/uq_c_ToTime_Stop_rel';

	
	
		
		attribute<c_Time_Stops>         c_FromTime_Stop_rel      := uq_c_FromTime_Stop_rel->values;
		attribute<c_Time_Stops>         c_ToTime_Stop_rel        := uq_c_ToTime_Stop_rel  ->values;
		
		attribute<Time>                 From_Time_rel            := value(c_FromTime_Stop_rel / uint64(#Stops), Time);
		attribute<Stops>                From_Stop_rel            := value(c_FromTime_Stop_rel % uint64(#Stops), Stops);
		attribute<Time>                 To_Time_rel              := value(c_ToTime_Stop_rel / uint64(#Stops), Time);
		attribute<Stops>                To_Stop_rel              := value(c_ToTime_Stop_rel % uint64(#Stops), Stops); 
	
		attribute<Stops/c_Stop_Stop>    c_Stop_Stop_rel          := combine_data(Stops/c_Stop_Stop, From_Stop_rel, To_Stop_rel);
		attribute<Places>               From_Place_rel           := Stops/Place_rel[From_Stop_rel];
		attribute<Places>               To_Place_rel             := Stops/Place_rel[To_Stop_rel];
		attribute<c_Time_Places>        c_FromTime_Place_rel     := combine_data(c_Time_Places, From_Time_rel, From_Place_rel);
		attribute<c_Time_Places>        c_ToTime_Place_rel       := combine_data(c_Time_Places, To_Time_rel, To_Place_rel);
	}

	// De ketens die de uitvoer kan gebruiken (sinds 2026-10-20): die instappen bij een halte waar een voortransportbeen van de component
	// eindigt (NetworkSetup/impl/IsVStop), alleen met de kolommen die de vertrekmomenten lezen, uit de store per haltenblok
	// (PT_Chains_Blocks/PerBlock/<blok>/VBoarding). Elk herkomstblok kiest hieruit de ketens van zijn eigen voortransport
	// (PublicTransport/PT_InBlock), en elk vertrekmoment daaruit zijn venster (PerDepartureMoment_T/Within_VW_Window). Tot dan kozen de
	// vertrekmomenten uit PT: alle ketens met hun afgeleide relaties in het geheugen, voor Y2025, Buurt2025 naar Buurt2025, 572 miljoen
	// ketens en een piek van ±99 GB vastgelegd geheugen in elke portie van de uitvoerstap (W_PT_OVf_C, 2026-10-20), ongeacht de grootte van
	// de portie. Een keten staat in de store van het haltenblok van zijn instaphalte, dus de delen overlappen niet.
	attribute<bool> IsVBoarding_PT (PT) := uq_c_FromTime_Stop/IsVBoarding[PT/uq_c_FromTime_Stop_rel], Descr = "Alleen met de ene store van voor 2026-09-29 (PT_Chains_PerBlock FALSE): de ketens van PT_V.";
	unit<uint64> PT_V := = ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_unit_uint64(' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding') + ')' : 'select(IsVBoarding_PT)'
	, using = "impl"
	{
		attribute<uint32>                ModeCode                 := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/ModeCode') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/ModeCode)';
		attribute<ct>                    Price                    := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Price') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Price)';
		attribute<ct>                    Price_augm               := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Price_augm') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Price_augm)';
		attribute<s>                     Traveltime               := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Traveltime') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Traveltime)';
		attribute<dam>                   TravelDist_Bus           := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/TravelDist_Bus') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/TravelDist_Bus)';
		attribute<dam>                   Traveldist_Metro         := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Traveldist_Metro') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Traveldist_Metro)';
		attribute<dam>                   Traveldist_Tram          := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Traveldist_Tram') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Traveldist_Tram)';
		attribute<dam>                   Traveldist_Rail          := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Traveldist_Rail') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Traveldist_Rail)';
		attribute<dam>                   Traveldist_Ferry         := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Traveldist_Ferry') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/Traveldist_Ferry)';
		attribute<uq_c_FromTime_Stop>    uq_c_FromTime_Stop_rel   := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/uq_c_FromTime_Stop_rel') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/uq_c_FromTime_Stop_rel)';
		attribute<uq_c_ToTime_Stop>      uq_c_ToTime_Stop_rel     := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/uq_c_ToTime_Stop_rel') + ')' : 'collect_by_cond(., IsVBoarding_PT, PT/uq_c_ToTime_Stop_rel)';
		attribute<uint64>                Keten                    := =ModelParameters/Advanced/PT_Chains_PerBlock ? 'union_data(., ' + AsItemList('PT_Chains_Blocks/PerBlock/' + impl/BlockDomain/name + '/VBoarding/Keten') + ')' : 'collect_by_cond(., IsVBoarding_PT, id(PT))', Descr = "Het rijnummer van de keten in de store van zijn blok (sinds 2026-10-21, #129; alleen gevraagd in de HB-paarmodus, met een blok: OD_Ketens/Benen_store/Keten).";
	}

	// De handtekening van de ketenstore: alle parameters waar de ketens van afhangen. Tot 2026-10-03 was dit de naam van de store
	// (zonder .mmd); sinds NetworkModel_PBL#118 staat hij als hash in de naam (StorageBase_Str) en voluit in signature.txt in de map
	// van de store (sinds 2026-10-06; tot dan in <naam>.signature.txt ernaast).
	parameter<string>     PT_Chains_Window := Time/TemplatableTextShrt[impl/FirstDepartureMoment] + '-' + Time/TemplatableTextShrt[impl/LastArrivalMoment]
	, Descr = "Het tijdvenster van de ketens, bijvoorbeeld 07h00m-09h29m: van het eerste vertrekmoment tot de laatste aankomst.";
	parameter<string>     PT_Chains_Signature :=
		'PT_Chains_'+Time/TemplatableTextShrt[impl/FirstDepartureMoment]+
		'_to_'+Time/TemplatableTextShrt[impl/LastArrivalMoment]+
		'_'+/ModelParameters/Advanced/Analysis_date+
		(/ModelParameters/Advanced/GTFS_file_date == /ModelParameters/Advanced/Analysis_date ? '' : '_gtfs'+/ModelParameters/Advanced/GTFS_file_date)+
		'_min-'+asList(Classifications/FinalParetoAttr/FileNameElement, '_')+
		'_maxtransf-'+string(ModelParameters/Max_transfers)+
		'_MaxOV-' + string(ModelParameters/MaxPTTime) + 'min'+
		// De pareto-benen (ObjectVision/NetworkModel_PBL#115) veranderen de inhoud van dit bestand,
		// dus moeten ze in de handtekening staan: anders overschrijft een pareto-run stilzwijgend het
		// scalaire resultaat waarmee hij vergeleken moet worden.
		(ModelParameters/Advanced/ParetoLegs_R ? '_paretoR' : '')+
		ModelParameters/Advanced/ChainPareto_FileTag+ // '_chainrel1pct': de relatieve epsilon op de reistijd in de ketenrijging (GeoDMS #1282; tot 2026-10-05 '_chaineps10ct60s'), leeg als die uit staan
		(ModelParameters/Advanced/ParetoLegs_L ? '_paretoL' : '')+
		// Flexvervoer (ObjectVision/NetworkModel_PBL#113, #116): '_noflex', of '_flex<i>i<w>w<c>ct' met de flexparameters; leeg als die alle drie 0 zijn.
		ModelParameters/Advanced/Flex_FileTag+
		// NS International en rit-opslag (ObjectVision/NetworkModel_PBL#3): leeg met de standaard, anders '_' met I, R of w<min>.
		ModelParameters/Advanced/RitOpslag_FileTag+
		// Prijs-, overstap- en halteparameters (audit 3.4): zonder deze tag las een gewijzigde parameter stil de oude ketens terug.
		ModelParameters/Advanced/PT_Chains_ParamTag+
		// Een HB-paar (sinds 2026-10-21, #129): de ketens van de haltes van de herkomst naar die van de bestemming, met de maximale tijden van het natransport.
		(ModelParameters/Advanced/IsOD ? '_od' + ModelParameters/Advanced/OD_Tag + OD_Haltes/TypeTag + string(ModelParameters/MaxWalkingTime_Stops2Dest) + '-' + string(ModelParameters/MaxCyclingTime_Stops2Dest) : '')+
		ModelParameters/Advanced/PT_Chains_Revision; // '_r2' sinds audit 3.5 (2026-09-25)
	container PT_Chains_Hash := /Templates/StringHash_T(PT_Chains_Signature);
	parameter<string>     StorageBase_Str := /ModelParameters/Advanced/IntermediateResultsDir + '/PT_Chains_' + /ModelParameters/Advanced/Analysis_date + '_' + PT_Chains_Window + '_' + PT_Chains_Hash/Hex
	, Descr = "Naam van de ketenstore zonder extensie (sinds 2026-10-03, NetworkModel_PBL#118): datum en tijdvenster leesbaar, de rest als hash van PT_Chains_Signature. Bijvoorbeeld PT_Chains_20261006_07h00m-09h29m_11a52bac; tot dan stond de hele handtekening in de naam en was het langste pad 252 tekens.";
	parameter<string>     StorageName_Str := StorageBase_Str + '.mmd', Descr = "De ene ketenstore van ChainGeneration_Single/Write (PT_Chains_PerBlock FALSE).";
	parameter<string>     StorageBlockDir_Str := StorageBase_Str
	, Descr = "Map van de ketenstore per blok (sinds 2026-09-29): de naam van de ene store zonder .mmd (tot 2026-09-30 met _blocks erachter), met daarin <n>of<N>.mmd per blok.";
	container PT_Chains_Sig := /Templates/StoreSignature_T(
		  ModelParameters/Advanced/PT_Chains_PerBlock ? StorageBlockDir_Str : StorageName_Str
		, (ModelParameters/Advanced/PT_Chains_PerBlock ? StorageBlockDir_Str : StorageName_Str) + '/signature.txt'
		, PT_Chains_Signature
		, ModelParameters/Advanced/PT_Chains_PerBlock ? max(strlen('/' + impl/BlockDomain/StoreName + '.mmd/uq_c_FromTime_Stop_rel')) : strlen('/uq_c_FromTime_Stop_rel')
		)
	, Descr = "De handtekening in de map van de ketenstore (signature.txt; sinds 2026-10-06, tot dan <naam>.signature.txt ernaast in IntermediateResults): Write_Block, ChainGeneration_Single/Write en PT_Chains_Blocks/ToDo_List schrijven hem (en controleren het langste pad, met uq_c_FromTime_Stop_rel als langste attribuutnaam), ChainGeneration_Single/Read en PT_Chains_Blocks/Read controleren hem.";
		
	#include<OD_Ketens.dms>
	#include<ChainJoiner_T.dms>
	#include<CreateTransfers_T.dms>
	#include<Get_Windowed_Agency_Set_T.dms>
}
