 attribute<c_Time_Stops>        c_FromTime_Stop_rel       := ThisSet/NodeSet/c_Time_Stop_rel[OrgZone_rel];
 attribute<c_Time_Stops>        c_ToTime_Stop_rel         := ThisSet/NodeSet/c_Time_Stop_rel[DstZone_rel];

attribute<rdc>                 From_Point                 := ThisSet/NodeSet/geometry[OrgZone_rel];
attribute<rdc>                 To_Point                   := ThisSet/NodeSet/geometry[DstZone_rel];

//debug
attribute<rdc>                  geometry (arc)                 := points2sequence(PointSet/Point, PointSet/SeqNr, PointSet/Ordinal);
unit<uint32> PointSet := union_unit(.,.)
{
	attribute<rdc>    Point   := Union_Data(., ../From_Point, ../To_Point);
	attribute<..>     SeqNr   := value(id(.) % nrofrows(..), ..);
	attribute<uint32> Ordinal := id(.) / nrofrows(..);
}

attribute<Stops>               From_Stop_rel              := ThisSet/NodeSet/Stop_rel[OrgZone_rel];
attribute<Stops>               To_Stop_rel                := ThisSet/NodeSet/Stop_rel[DstZone_rel];
attribute<Time>                From_Time_rel              := ThisSet/NodeSet/Time_rel[OrgZone_rel];
attribute<Time>                To_Time_rel                := ThisSet/NodeSet/Time_rel[DstZone_rel];
attribute<Routes>              Route_rel                  := ThisSet/NodeSet/Route_rel[OrgZone_rel];
attribute<Agencies>            Agency_rel                 := ThisSet/NodeSet/Agency_rel[OrgZone_rel];
// #113: a ride lies on one route (NodeSet is per route), so a ride is exactly one boarding, and the flex surcharge belongs to the ride
// and not to the links. Adding it afterwards is exact: Dijkstra does not choose between routes within an OD pair; the competition
// between routes happens in the chain joiner, which has this Traveltime as a criterion as soon as there is a time penalty
// (Classifications/ChainJoinerParetoAttr_Candidates). Without extra waiting time for flex (ModelParameters/Impl/FlexHasTimePenalty)
// the expression stays literally 'Impedance[s]' (CalcCache).
attribute<bool>                IsFlexRide                 := MakeDefined(Routes/IsFlex[Route_rel], false), Descr = "#113: is this ride on a flex line, and so exactly one boarding on a flex line?";
// #3: the extra time of the trip surcharge (SourceData/Infrastructure/OVprijzen/NS/TripSurchargeTrains/ExtraTime) is in TripSurcharge_ExtraTime of
// OD_L (0 in OD_R) and is added only when it is greater than 0 somewhere, so that the expression otherwise stays the same.
attribute<s>                   Traveltime                 := ='Impedance[s]'
                                                              + (ModelParameters/Impl/FlexHasTimePenalty      ? ' + (IsFlexRide ? convert(ModelParameters/Advanced/FlexExtraWaitingTime, s) : 0[s])' : '')
                                                              + (ModelParameters/Impl/TripSurchargeHasTimePenalty ? ' + TripSurcharge_ExtraTime' : '');
// #146: the chain joiner adds up the walking and the waiting at the transfers of a chain beside its travel time, so that the output splits the
// public transport time into the time in the vehicle, walking at transfers and waiting. A ride is one boarding: it walks no transfer, and its
// waiting is the extra time per boarding of a flex line or a train with a trip surcharge, which Traveltime holds as well.
attribute<s>                   TransferWalkTime           := const(0[s], .), Descr = "Walking at transfers within the ride: none, a ride is one boarding (#146).";
attribute<s>                   PTWaitTime                 := ='const(0[s], .)'
                                                              + (ModelParameters/Impl/FlexHasTimePenalty      ? ' + (IsFlexRide ? convert(ModelParameters/Advanced/FlexExtraWaitingTime, s) : 0[s])' : '')
                                                              + (ModelParameters/Impl/TripSurchargeHasTimePenalty ? ' + TripSurcharge_ExtraTime' : '')
, Descr = "Waiting within the ride: the extra time per boarding of a flex line (Advanced/FlexExtraWaitingTime) or a train with a trip surcharge (TripSurchargeTrains/ExtraTime), which Traveltime holds as well; 0 for other rides (#146).";
// #3: may one board at the start of this ride and alight at its end (GTFS pickup_type and drop_off_type, see Set/NodeSet/CanBoard and
// CanAlight)? OD_L/Result and OD_R/Result keep only these rides.
attribute<bool>                IsBoardAlightAllowed       := ThisSet/NodeSet/CanBoard[OrgZone_rel] && ThisSet/NodeSet/CanAlight[DstZone_rel];
attribute<Modes>               Mode_rel                   := Routes/mode_rel[Route_rel];
attribute<uint32>              ModeCode                   := uint32(Mode_rel) + 1u, Descr = "The mode of the ride as a digit of ModeCode (Classifications/GTFS_Modes/CodeDigits): the mode id plus 1.";

unit<uint32> impl := .
{
	attribute<Stops/c_Stop_Stop> c_FromStop_ToStop_rel := combine_data(Stops/c_Stop_Stop, From_Stop_rel, To_Stop_rel);
	attribute<bool>        IsStartEndWithinSameStopCluster := IsDefined(rlookup(c_FromStop_ToStop_rel, Stops/Find_StopClusters/c_Stop_Stop_rel));
	
	attribute<Concessiegebied> Start_Concessiegebied_rel := point_in_polygon(From_Point, Concessiegebied/geometry);
	attribute<Concessiegebied> End_Concessiegebied_rel := point_in_polygon(To_Point, Concessiegebied/geometry);
	attribute<Concessiegebied> Concessiegebied_rel := Route_Concessiegebied_rel[Route_rel], Descr = "The concession area of the line of the ride (Route_Concessiegebied_rel, #150), in which the ride finds its fare rule and its DOVA fare.";
	attribute<bool>        IsOD_completely_foreign         := Agencies/IsForeign[Agency_rel] && IsNull(Start_Concessiegebied_rel) && IsNull(End_Concessiegebied_rel)
	, Descr = "Is the ride abroad: of an agency that runs abroad (Classifications/Agencies/IsForeign), with neither its boarding nor its alighting stop in a concession area (#150)? A ride of a Dutch agency stays, also a crossing of a ferry whose piers lie outside the areas.";
	attribute<km>          PT_TravelledDistance            := alt_imp;
	attribute<string>      RouteName_short                 := Routes/route_short_name[Route_rel];
	attribute<string>      FareLine                        := Routes/FareLine[Route_rel], Descr = "The line of the fare tables of a route that the feed does not name in route_short_name, such as an island bus (#55); null for the other routes.";
	attribute<string>      Mode_Agency_CG_Line_identifier  := Modes/name[Mode_rel] +'_'+ Agencies/name[Agency_rel] +'_'+ Concessiegebied/name[Concessiegebied_rel] + '_' + RouteName_short;
	attribute<string>      Mode_Agency_CG_identifier       := Modes/name[Mode_rel] +'_'+ Agencies/name[Agency_rel] +'_'+ Concessiegebied/name[Concessiegebied_rel];
	attribute<string>      Mode_Agency_identifier          := Modes/name[Mode_rel] +'_'+ Agencies/name[Agency_rel];

	attribute<NS_Stations> From_NS_Stations_rel            := Stops/NS_Stations_rel[From_Stop_rel];
	attribute<NS_Stations> To_NS_Stations_rel              := Stops/NS_Stations_rel[To_Stop_rel];
	attribute<c_NS_start_end> c_NS_start_end_rel := combine_data(c_NS_start_end, From_NS_Stations_rel, To_NS_Stations_rel);
	attribute<uint32>      TariffUnits                     := rjoin(c_NS_start_end_rel, TariffUnitsMatrix/c_NS_start_end_rel, TariffUnitsMatrix/impedance);
	attribute<bool>        IsPricedOnTariffUnits           := Agencies/IsPricedOnTariffUnits[Agency_rel] && Modes/name[Mode_rel] == 'Rail' && IsDefined(TariffUnits), Descr = "Does the ride pay its kilometre fare over the tariff units of its station pair: a train of an agency that charges so, between two stations with tariff units (#168, #176)?";
	attribute<km>          MinFareDistance                 := MakeDefined(rjoin(ModelParameters/Impl/FareTable_year + '|' + FareTable/Mode_Agency_CG_Line_identifier[FareTable_rel], /SourceData/Infrastructure/OVprijzen/MinimumFareDistance/key, /SourceData/Infrastructure/OVprijzen/MinimumFareDistance/MinFareDistance), 0[km])
	, Descr = "The minimum distance of the kilometre fare of the rule of the ride (OVprijzen/MinimumFareDistance, #176), 0 for the other rules.";
	attribute<km>          PT_FareDistance                 := max_elem(IsPricedOnTariffUnits ? float32(TariffUnits)[km] : PT_TravelledDistance, MinFareDistance)
	, Descr = "The distance over which the ride pays its kilometre fare: the NS tariff units of its station pair for a train of an agency that charges so (Agencies/IsPricedOnTariffUnits, #168, #176), else the distance travelled, and at least the minimum of its rule.";
	
	// The rule of the detailed fare table for this ride (#55), from specific to general: a rule for its line in its concession (FareLine, a line
	// recognised by its name, then route_short_name), a rule for its line without a concession (route_short_name only), the general rule of
	// its agency in its concession, the general rule of its agency without a concession, and the fare of its agency where that is the same in
	// all its concessions (FareTable_AgencyWide). A rule of one line never prices another line; a ride without any of these gets the DOVA fare
	// of its concession. In the keys of the fare table a rule without a concession has an empty concession: '<mode>_<agency>__<line>' and
	// '<mode>_<agency>_'. A key with a null part is null and matches nothing.
	attribute<FareTable>   FareTable_rel_FareLine          := rlookup(Mode_Agency_CG_identifier + '_' + FareLine, FareTable/Mode_Agency_CG_Line_identifier);
	attribute<FareTable>   FareTable_rel_Line              := rlookup(Mode_Agency_CG_Line_identifier, FareTable/Mode_Agency_CG_Line_identifier);
	attribute<FareTable>   FareTable_rel_Line_AnyCG        := rlookup(Mode_Agency_identifier + '__' + RouteName_short, FareTable/Mode_Agency_CG_Line_identifier);
	attribute<FareTable>   FareTable_rel_General           := rlookup(Mode_Agency_CG_identifier, FareTable/Mode_Agency_CG_Line_identifier);
	attribute<FareTable>   FareTable_rel_General_AnyCG     := rlookup(Mode_Agency_identifier + '_', FareTable/Mode_Agency_CG_Line_identifier);
	attribute<FareTable>   FareTable_rel_AgencyWide        := FareTable_AgencyWide/Rule_rel[rlookup(Mode_Agency_identifier, FareTable_AgencyWide/values)];
	attribute<FareTable>   FareTable_rel_Detailed          := MakeDefined(
	                                                              MakeDefined(MakeDefined(FareTable_rel_FareLine, FareTable_rel_Line), FareTable_rel_Line_AnyCG)
	                                                            , MakeDefined(MakeDefined(FareTable_rel_General, FareTable_rel_General_AnyCG), FareTable_rel_AgencyWide));
	// DOVA mode: the key is the mode class (BTM/Rail/Ferry) + '_' + the concession area of the line. NS trains are in the L network and do
	// not come here. The rides of a line without a concession area, none of whose rides boards in one (a line abroad, or a ferry whose piers
	// lie outside the areas), get 'Buitenland' and match the fallback rows in FareTable_DOVA, so that every ride has a DOVA fare.
	attribute<string>      Mode_class_DOVA                 := Modes/name[Mode_rel] == 'Rail' ? 'Rail' : (Modes/name[Mode_rel] == 'Ferry' ? 'Ferry' : 'BTM');
	attribute<string>      MC_CG_key_DOVA                  := Agencies/HasOwnDOVA_Row[Agency_rel]
	                                                          ? /SourceData/Infrastructure/OVprijzen/DB/MC_CG_key
	                                                          : Mode_class_DOVA + '_' + MakeDefined(Concessiegebied/name[Concessiegebied_rel], 'Buitenland')
	, Descr = "The key of the ride in FareTable_DOVA: its mode class and the concession area of its line, 'Buitenland' without one, and for DB its own row (#168).";
	attribute<FareTable>   FareTable_rel                   := =ModelParameters/Impl/PriceMethod_effective == 'DOVA'
	                                                          ? 'rlookup(MC_CG_key_DOVA, FareTable/MC_CG_key)'
	                                                          : 'FareTable_rel_Detailed';
	attribute<FareTable_DOVA> FareTable_DOVA_rel           := rlookup(MC_CG_key_DOVA, FareTable_DOVA/MC_CG_key);
	// The prices of the ride: those of its rule, and in the detailed method for a ride without a rule the DOVA fare of its concession and mode class.
	attribute<Euro>        FixedPrice                      := IsDefined(FareTable_rel) ? FareTable/FixedPrice[FareTable_rel]    : FareTable_DOVA/FixedPrice[FareTable_DOVA_rel];
	attribute<Euro_km>     VariablePrice                   := IsDefined(FareTable_rel) ? FareTable/VariablePrice[FareTable_rel] : FareTable_DOVA/VariablePrice[FareTable_DOVA_rel];
	attribute<Euro>        RideSurcharge                   := IsDefined(FareTable_rel) ? FareTable/RideSurcharge[FareTable_rel] : FareTable_DOVA/RideSurcharge[FareTable_DOVA_rel];

	// Check that the ride has prices: a matched rule with an empty price would otherwise silently give null prices.
	attribute<bool>        Price_IntegrityCheck            := =ModelParameters/Impl/PriceExportsAndIntegrityChecksNeeded
	                                                          ? 'IsDefined(impl/FixedPrice) && IsDefined(impl/VariablePrice) && IsDefined(impl/RideSurcharge)'
	                                                          : 'const(TRUE,.)';

	// The rides of the detailed method without a rule, which get the DOVA fare, per combination of mode, agency, concession and line, with
	// the number of rides (view on demand, for checking the fare tables).
	unit<uint32> DOVAFallback := select_with_org_rel(IsNull(FareTable_rel))
	{
		attribute<string> combo := MakeDefined(Mode_Agency_CG_Line_identifier[org_rel], Mode_Agency_identifier[org_rel] + '__' + RouteName_short[org_rel]);
		unit<uint32> UniqueCombos := unique(combo)
		{
			attribute<uint32> NrRides := pcount(rlookup(../combo, values));
		}
	}

	// Diagnosis when Price_IntegrityCheck fails (expensive, view only on demand): the unique combinations without a FareTable match or
	// with a row without price, with the number of affected rides per combination.
	unit<uint32> Unpriced := select_with_org_rel(not(Price_IntegrityCheck))
	{
		attribute<string> combo := =ModelParameters/Impl/PriceMethod_effective == 'DOVA' ? 'MC_CG_key_DOVA[org_rel]' : 'Mode_Agency_CG_Line_identifier[org_rel]';
		unit<uint32> UniqueCombos := unique(combo)
		{
			attribute<uint32> NrRides := pcount(rlookup(../combo, values));
		}
	}
}
