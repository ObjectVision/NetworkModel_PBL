// OD_L and OD_R search per (departure moment, stop) the rides within one fare group. Without the pareto option impedance_matrix gives per OD
// pair exactly the fastest ride, with the distance travelled as a by-product; a slower but shorter ride, and so a cheaper one in the R network,
// then no longer exists for the chain joiner (#19). With ';pareto' the same operator does a bi-criteria label-setting search on (Duration,
// Length) and gives one row per Pareto-optimal route; the first row per OD pair is guaranteed to still carry the scalar minimum travel time
// (ObjectVision/GeoDMS#856, doc/bicriteria-impedance.md). See /ModelParameters/Advanced/ParetoLegs_R and ParetoLegs_L.
unit<uint32> OD_L := =
	'impedance_matrix(''directed;cut(OrgZone_max_imp);alternative(link_imp):alt_imp'
	+ (ModelParameters/Advanced/ParetoLegs_L ? ';pareto' : '')
	+ ';od:impedance,OrgZone_rel,DstZone_rel''
		, Set_L/Set/Duration
		, Set_L/Set/F1
		, Set_L/Set/F2

		, convert(ModelParameters/MaxPTTime, s_f)
		, Set_L/Set/'
	+ 'Length
	)'
	, using = "impl"
{
	unit<uint32>      ThisSet                         := Set_L/Set;
	
	#include<../OD_extra_attributen.dms>
	
	// NS specific.
	// Every ride with NS must have a price, not only a pair of start and end station: a ride with a pair that is not in TariffUnitsMatrix would get
	// Price_L null, and a row with a null criterion is never optimal in pareto_optimal_eps, so that the ride and every chain over it would silently
	// drop out of the chains. The trains of NS International also run in the L network (#3); their rides to or from abroad have no NS price and
	// drop out of Result (IsDomesticRide), so the check applies to the rides of NS itself.
	attribute<bool>   NS_Station_Price_IntegrityCheck := =ModelParameters/Impl/PriceExportsAndIntegrityChecksNeeded
	                                                     ? 'Agency_rel == Agencies/V/ns ? IsDefined(rjoin(impl/c_NS_start_end_rel, TariffUnitsMatrix/c_NS_start_end_rel, TariffUnitsMatrix/Price_ct)) : TRUE'
	                                                     : 'const(TRUE, .)';
	attribute<Ct>     Price_L                         := rjoin(impl/c_NS_start_end_rel, TariffUnitsMatrix/c_NS_start_end_rel, TariffUnitsMatrix/Price_ct)
																, IntegrityCheck = "all(NS_Station_Price_IntegrityCheck)";
	attribute<bool>   IsDomesticRide                   := Agency_rel == Agencies/V/ns
	                                                     || (IsDefined(Price_L) && NS_Stations/IsInNL[impl/From_NS_Stations_rel] && NS_Stations/IsInNL[impl/To_NS_Stations_rel])
																, Descr = "Whether the ride counts as domestic: a ride of NS, or a ride between two NS stations in the Netherlands with an NS price, such as NS International within the country (#3).";

	// TRIP SURCHARGE (#3). The surcharge of a special train (SourceData/Infrastructure/OVprijzen/NS/TripSurchargeTrains) depends on the trip, not on the station
	// pair. A ride lies on a route, and because the waiting links are standstill within a trip, in practice on one trip: that of the link with
	// which it departs from its begin node (NodeSet/DepTrip_rel). A product with a section (HSL: Schiphol-Rotterdam) costs the surcharge if that
	// trip passes both stations between boarding and alighting time, also without stopping or transferring there; a product without a section
	// (ICE) costs it on every ride. The surcharge is kept apart in Price_S, so that the chain joiner does not lose it with a through NS fare (which
	// recalculates Price_L).
	unit<uint8>       TripSurchargeTrains             := SourceData/Infrastructure/OVprijzen/NS/TripSurchargeTrains;
	attribute<TripSurchargeTrains> TripSurcharge_rel := Routes/TripSurcharge_rel[Route_rel];
	attribute<uint32> Ride_Trip_rel                    := ThisSet/NodeSet/DepTrip_rel[OrgZone_rel];

	// The passages of the trips with a section product along the stations of their section: per scheduled link its begin and end.
	unit<uint32> SectionLinks := select_with_org_rel(ThisSet/LinkType_rel == LinkTypes/V/Scheduled && MakeDefined(/SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/HasSection[Routes/TripSurcharge_rel[ThisSet/Route_rel]], false))
	{
		attribute<TripSurchargeTrains> TripSurcharge_rel := Routes/TripSurcharge_rel[ThisSet/Route_rel[org_rel]];
	}
	unit<uint32> SectionPassages := union_unit(SectionLinks, SectionLinks)
	{
		attribute<uint32>              Trip_rel          := union_data(., ThisSet/Trip_rel[SectionLinks/org_rel], ThisSet/Trip_rel[SectionLinks/org_rel]);
		attribute<Time>                Time_rel          := union_data(., ThisSet/From_Time_rel[SectionLinks/org_rel], ThisSet/To_Time_rel[SectionLinks/org_rel]);
		attribute<NS_Stations>         Station_rel       := union_data(., ThisSet/NS_StartPoint_rel[SectionLinks/org_rel], ThisSet/NS_EndPoint_rel[SectionLinks/org_rel]);
		attribute<TripSurchargeTrains> TripSurcharge_rel := union_data(., SectionLinks/TripSurcharge_rel, SectionLinks/TripSurcharge_rel);
		attribute<bool>                IsA               := IsDefined(Station_rel) && Station_rel == /SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/StationA_rel[TripSurcharge_rel];
		attribute<bool>                IsB               := IsDefined(Station_rel) && Station_rel == /SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/StationB_rel[TripSurcharge_rel];
	}
	unit<uint32> SectionRides := select_with_org_rel(MakeDefined(/SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/HasSection[TripSurcharge_rel], false))
	{
		attribute<uint32> Trip_rel      := ../Ride_Trip_rel[org_rel];
		attribute<Time>   From_Time_rel := ../From_Time_rel[org_rel];
		attribute<Time>   To_Time_rel   := ../To_Time_rel[org_rel];
	}
	unit<uint32> SectionPairs := join_equal_values_uint32(SectionRides/Trip_rel, SectionPassages/Trip_rel)
	{
		attribute<bool> InRide := SectionPassages/Time_rel[second_rel] >= SectionRides/From_Time_rel[first_rel] && SectionPassages/Time_rel[second_rel] <= SectionRides/To_Time_rel[first_rel];
		attribute<bool> IsA   := InRide && SectionPassages/IsA[second_rel];
		attribute<bool> IsB   := InRide && SectionPassages/IsB[second_rel];
	}
	attribute<bool>   RidesSection      (SectionRides) := any(SectionPairs/IsA, SectionPairs/first_rel) && any(SectionPairs/IsB, SectionPairs/first_rel);
	attribute<bool>   IsTripSurchargeRide              := IsDefined(TripSurcharge_rel) && (not(MakeDefined(/SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/HasSection[TripSurcharge_rel], false)) || MakeDefined(RidesSection[invert(SectionRides/org_rel)], false))
	, Descr = "Does this ride cost the trip surcharge of its product?";
	attribute<Ct>     Price_S                         := =ModelParameters/Advanced/IncludeTripSurcharge ? 'IsTripSurchargeRide ? rounded_convert(/SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/Surcharge[TripSurcharge_rel], Ct) : 0[Ct]' : 'const(0[Ct], .)'
	, Descr = "Trip surcharge of this ride (#3), which the chain joiner adds next to the NS fare.";
	attribute<s>      TripSurcharge_ExtraTime         := =ModelParameters/Impl/TripSurchargeHasTimePenalty ? 'IsTripSurchargeRide ? /SourceData/Infrastructure/OVprijzen/NS/TripSurcharge/ExtraTime[TripSurcharge_rel] : 0[s]' : 'const(0[s], .)'
	, Descr = "Extra travel time of the trip surcharge (TripSurchargeTrains/ExtraTime), added through Traveltime in OD_extra_attributen.";
	attribute<Ct>     Price                           := Price_L + Price_S;

	unit<uint32> Result := =ModelParameters/Impl/TripSurchargeHasTimePenalty
	                       ? 'select_with_org_rel_with_attr_by_cond(., !impl/IsStartEndWithinSameStopCluster && IsBoardAlightAllowed && IsDomesticRide && Traveltime <= convert(ModelParameters/MaxPTTime, s))'
	                       : 'select_with_org_rel_with_attr_by_cond(., !impl/IsStartEndWithinSameStopCluster && IsBoardAlightAllowed && IsDomesticRide)'
	{
		parameter<uint32>      ModeFactor         := 16u, Descr = "16 to the power of the number of rides of this chain (one ride): a chain joiner with this chain on the right shifts the ModeCode of the left chain by ModeFactor (ChainJoiner_T).";
		attribute<Time>        BoardingTime_RO    := const(null_u,.);
		attribute<Time>        BoardingTime_NS    := From_time_rel;
		attribute<Ct>          Price_F            := const(0[Ct],.), Descr = "Final costs, not subject to subsequent recalculation";
		attribute<Ct>          Price_T            := const(0[Ct],.), Descr = "Augmented costs for transfers";
		attribute<Ct>          Price_augm         := Price_L + Price_S;
		
		attribute<NS_Stations> First_NS_Station   := impl/From_NS_Stations_rel[org_rel];
		attribute<NS_Stations> Last_NS_Station    := impl/To_NS_Stations_rel[org_rel];
		attribute<Time>        Last_NS_AlightTime := To_Time_rel;
		attribute<Time>        Last_RO_AlightTime := const(null_u,.), Descr = "The last alighting time from a regional ride, kept through rides with NS (fare group L), to check whether a following regional ride continues the same fare journey (ChainJoiner_T, RO_continuation_allowed).";

		#include<../OD_traveldist.dms>
		attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := rlookup(c_FromTime_Stop_rel, uq_c_FromTime_Stop/c_FromTime_Stop_rel);
		attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := rlookup(c_ToTime_Stop_rel, uq_c_ToTime_Stop/c_ToTime_Stop_rel);
	}
	// For an OD pair (#129): the rides to a stop from which the destination can be reached (OD_Stops/IsNStop), as the last ride of the longest
	// chains (ChainGeneration_PerBlock_T); org_rel still refers to OD_L.
	unit<uint32> Result_ToD := select_with_attr_by_cond(Result, /NetworkSetup/PublicTransport_Prep/OD_Stops/IsNStop[Stops/Place_rel[Result/To_Stop_rel]])
	{
		parameter<uint32> ModeFactor := Result/ModeFactor;
	}
}

unit<uint32> OD_R := =
	'impedance_matrix(''directed;cut(OrgZone_max_imp);alternative(link_imp):alt_imp'
	+ (ModelParameters/Advanced/ParetoLegs_R ? ';pareto' : '')
	+ ';od:impedance,OrgZone_rel,DstZone_rel''
		, Set_R/Set/Duration
		, Set_R/Set/F1
		, Set_R/Set/F2

		, convert(ModelParameters/MaxPTTime, s_f)
		, Set_R/Set/'
	+ 'Length
	)'
	, using = "impl"
{
	unit<uint32>  ThisSet                 := Set_R/Set;
	
	// R specific
	// #55: a rule of the detailed fare table without a price per kilometre and without a surcharge per ride is a fixed fare per ride (island
	// buses, ferries, De Lijn, KeukenhofBuzz). That fare goes in Price_S, which the chain joiner adds for every ride, and not in Price_I, of
	// which it takes the highest within an OV-chip journey: a ferry after a bus would otherwise cost the ferry only. Such a ride is no OV-chip
	// ride (Result/Last_RO_AlightTime). #164: a rule with a surcharge per ride, such as the Parkshuttle Rivium, is an OV-chip ride with its
	// boarding fare in Price_I, shared within the journey, and its surcharge in Price_S.
	attribute<bool> IsFixedFareRide        := =ModelParameters/Impl/PriceMethod_effective == 'DOVA' ? 'const(false, .)' : 'IsDefined(impl/FareTable_rel) && impl/VariablePrice == 0[Euro_km] && impl/RideSurcharge == 0[Euro]'
		, Descr = "Is the rule of the ride a fixed fare, a rule of the detailed fare table without a price per kilometre and without a surcharge per ride (#55, #164)? The DOVA fares have no rules per line.";
	attribute<Ct> Price_I                 := IsFixedFareRide ? 0[Ct] : rounded_convert(impl/FixedPrice, Ct), IntegrityCheck = "all(impl/Price_IntegrityCheck)", Descr = "The boarding fare of the ride, of which the chain joiner takes the highest within an OV-chip journey; 0 for a fixed fare per ride, which is in Price_S.";
	attribute<Ct> Price_O                 := ='(IsDefined(impl/TariffUnitFare) ? rounded_convert(impl/TariffUnitFare, Ct) - Price_I : rounded_convert(impl/VariablePrice * impl/PT_FareDistance, Ct))'
	                                         + (ModelParameters/Advanced/IncludeFlex && ModelParameters/Advanced/FlexCallCosts > 0[Euro] ? ' + (IsFlexRide ? rounded_convert(ModelParameters/Advanced/FlexCallCosts, Ct) : 0[Ct])' : '')
		, IntegrityCheck = "all(impl/Price_IntegrityCheck)", Descr = "Variable part of the price plus the call costs per boarding on a flex line (ModelParameters/Advanced/FlexCallCosts); for a train with a fare table per tariff unit (impl/TariffUnitFare, #181) the fare of the table minus the boarding fare. The chain joiner adds Price_O at every transfer and takes the maximum of Price_I within a journey, so call costs belong here.";
	attribute<Ct> Price_F                 := const(0[Ct],.), Descr = "Final costs, not subject to subsequent recalculation";
	attribute<Ct> Price_T                 := const(0[Ct],.), Descr = "Augmented costs for transfers";
	attribute<Ct> Price_S                 := rounded_convert(IsFixedFareRide ? impl/FixedPrice : impl/RideSurcharge, Ct), Descr = "The fixed fare of the ride (#55) or its surcharge per ride (#164), which the chain joiner adds for every ride, apart from the boarding fare; 0 for other rides.";
	attribute<s>  TripSurcharge_ExtraTime := const(0[s],.), Descr = "Extra time of the trip surcharge (#3), only in the L network.";
	attribute<Route_CG> Route_CG_rel      := IsBoardAlightAllowed ? combine_data(Route_CG, Route_rel, impl/Start_Concessiegebied_rel) : value(null_u, Route_CG), Descr = "The line of the ride and the concession area in which it boards, for a ride that may board and alight (Route_CG, #150).";
	attribute<Ct> Price                   := Price_I + Price_O + Price_S;
	attribute<Ct> Price_augm              := Price;

	#include<../OD_extra_attributen.dms>

	// #113: with extra waiting time for flex (ModelParameters/Impl/FlexHasTimePenalty) the same limit here as IsJourneyLongerThanAllowed in the
	// chain joiner, because the cut of impedance_matrix works on the raw impedance and the single chain R does not pass the chain joiner. This is
	// equivalent to a cut of MaxPTTime minus the penalty on the flex links only (Components are per route).
	// #3: only rides where the GTFS allows boarding and alighting (IsBoardAlightAllowed); this drops, among others, GoVolta within the Netherlands
	// (at its Dutch stops boarding only, with reservation; alighting only in Germany).
	unit<uint32> Result := =ModelParameters/Impl/FlexHasTimePenalty
	                       ? 'select_with_org_rel_with_attr_by_cond(., !impl/IsOD_completely_foreign && !impl/IsStartEndWithinSameStopCluster && IsBoardAlightAllowed && Traveltime <= convert(ModelParameters/MaxPTTime, s))'
	                       : 'select_with_org_rel_with_attr_by_cond(., !impl/IsOD_completely_foreign && !impl/IsStartEndWithinSameStopCluster && IsBoardAlightAllowed)'
	{
		parameter<uint32>      ModeFactor         := 16u, Descr = "16 to the power of the number of rides of this chain (one ride): a chain joiner with this chain on the right shifts the ModeCode of the left chain by ModeFactor (ChainJoiner_T).";
		attribute<Time>        BoardingTime_NS    := const(null_u,.);
		attribute<Time>        BoardingTime_RO    := From_time_rel;
		attribute<Time>        Last_NS_AlightTime := const(null_u,.);
		attribute<Time>        Last_RO_AlightTime := IsFixedFareRide ? value(null_u, Time) : To_Time_rel, Descr = "The last alighting time from a regional ride with the OV-chip, kept through rides with NS and rides on a fixed fare, to check whether a following regional ride continues the fare journey (ChainJoiner_T); null for a ride on a fixed fare (#55).";
		attribute<NS_Stations> First_NS_Station   := const(null_u,.);
		attribute<NS_Stations> Last_NS_Station    := const(null_u,.);

		#include<../OD_traveldist.dms>
		attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := rlookup(c_FromTime_Stop_rel, uq_c_FromTime_Stop/c_FromTime_Stop_rel);
		attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := rlookup(c_ToTime_Stop_rel, uq_c_ToTime_Stop/c_ToTime_Stop_rel);
	}
	// For an OD pair (#129): the rides to a stop from which the destination can be reached (OD_Stops/IsNStop), as the last ride of the longest
	// chains (ChainGeneration_PerBlock_T); org_rel still refers to OD_R.
	unit<uint32> Result_ToD := select_with_attr_by_cond(Result, /NetworkSetup/PublicTransport_Prep/OD_Stops/IsNStop[Stops/Place_rel[Result/To_Stop_rel]])
	{
		parameter<uint32> ModeFactor := Result/ModeFactor;
	}
}

// #150: a concession applies to lines, not to stops; on Leiden Centraal buses of two concessions stop. A line therefore gets one concession
// area, in which each of its rides finds its fare rule and its DOVA fare: the area where most of its rides in OD_R board, counted over the
// areas in which the fare table has a rule for its agency and mode, and over all areas when none of its rides boards in such an area. A line
// whose rides all board outside the concession areas, such as a ferry whose piers lie outside them, has none and finds only the rules
// without a concession area.
unit<uint32> Route_CG := combine_unit_uint32(Routes, Concessiegebied), Descr = "The pairs of a line and a concession area (#150)."
{
	attribute<Routes>          Route_rel   := first_rel(id(.));
	attribute<Concessiegebied> CG_rel      := second_rel(id(.));
	attribute<uint32>          NrBoardings := pcount(OD_R/Route_CG_rel), Descr = "The rides of the line in OD_R that board in the area and may board and alight.";
	attribute<bool>            HasRule     := =ModelParameters/Impl/PriceMethod_effective == 'DOVA'
	                                          ? 'const(true, .)'
	                                          : 'IsDefined(rlookup(Modes/name[Routes/Mode_rel[Route_rel]] + ''_'' + Agencies/name[Routes/Agency_rel[Route_rel]] + ''_'' + Concessiegebied/name[CG_rel], FareTable/Mode_Agency_CG_identifier))'
	, Descr = "Does the fare table have a rule for the agency and mode of the line in the area? With the DOVA fares every area counts.";
	attribute<uint32>          Score       := NrBoardings > 0 && HasRule ? NrBoardings + #OD_R : NrBoardings, Descr = "The boardings, raised by the number of rides of OD_R for an area with a rule, so that such an area comes first.";
}
attribute<Route_CG>        Route_CG_best             (Routes) := max_index(Route_CG/Score, Route_CG/Route_rel);
attribute<Concessiegebied> Route_Concessiegebied_rel (Routes) := Route_CG/Score[Route_CG_best] > 0 ? Route_CG/CG_rel[Route_CG_best] : value(null_b, Concessiegebied)
, Descr = "The concession area of the line (#150): the area where most of its rides board among those with a rule for its agency and mode, else among all areas; none when no ride of the line boards in a concession area.";
