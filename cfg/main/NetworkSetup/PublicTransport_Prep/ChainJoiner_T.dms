Template ChainJoiner_T : Descr = "Joins the chains of type LeftStr through a transfer to the rides (or chains) of type RightStr into chains of type LeftStr+RightStr, with their price, and keeps the Pareto front per pair of boarding and alighting event and first NS station."
{
	unit<uint32>      Left;
	unit<uint32>      Right;
	unit<uint32>      Transfers;
	
	parameter<string> LeftStr;
	parameter<string> RightStr;
	////
	parameter<bool>   HasLeft_RO                       := IsDefined(strpos(LeftStr , 'R'));
	parameter<bool>   HasRight_RO                      := IsDefined(strpos(RightStr, 'R'));
	parameter<bool>   HasLeft_NS                       := IsDefined(strpos(LeftStr , 'L'));
	parameter<bool>   HasRight_NS                      := IsDefined(strpos(RightStr, 'L'));
	parameter<bool>   Has_RO                           := HasLeft_RO || HasRight_RO;
	parameter<bool>   Has_NS                           := HasLeft_NS || HasRight_NS;
	parameter<bool>   HasBoth                          := Has_RO && Has_NS;
	
	parameter<bool>   NS_transfer_possible             := HasLeft_NS && HasRight_NS;
	parameter<bool>   NS_through_fare_certain          := right(LeftStr, 1)=='L' && left(RightStr, 1)=='L';
	parameter<bool>   RO_transfer_possible             := HasLeft_RO && HasRight_RO;

	parameter<Time>   MaxTransferTimeWithinFareJourney := convert(/ModelParameters/Advanced/MaxTransferTimeForBoardingSurcharge,s_f)[Time];
	// #55: until when the left chain can continue its OV-chip journey, measured at the arrival of the right ride: 0 when that moment has passed
	// or when the left chain has no OV-chip ride (Last_RO_AlightTime null, a chain of rides on a fixed fare only).
	parameter<string> Left_RO_WindowEnd                := 'iif(MakeDefined(left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time]) > right_rel->To_Time_rel, left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time])';


	container StartCalc0 {parameter<string> ChainName := Leftstr+RightStr;}
	container         StartCalc                        := PhaseContainer(StartCalc0, 'Start calculating '+string(StartCalc0/ChainName)+' for '+BlockDomain/name[BlockDomain_id]);
	
	// The combinations of left chain and transfer that already exceed MaxPTTime with the shortest right ride are dropped before the second join,
	// with the same valid chains as a result (IsJourneyLongerThanAllowed tests the same sum plus a possible penalty).
	unit<uint64> Join_Left_Transf0 := join_equal_values_uint64(Left/uq_c_ToTime_Stop_rel, Transfers/uq_c_Exit_rel)
	, Descr = "Joins every left chain to the transfers that start at its arrival (time and stop)."
	{
		attribute<Left>      Left_rel           := first_rel;
		attribute<Transfers> Transfers_rel      := second_rel;
		attribute<bool>      CanStayWithinMaxPT := Left_rel -> traveltime + Transfers_rel -> Transfer_Time + MinRightTraveltime <= convert(/ModelParameters/MaxPTTime, s);
	}
	parameter<s>      MinRightTraveltime               := #Right > 0 ? min(Right/traveltime) : 0[s]
	, Descr = "The shortest right ride, for the early cutoff on MaxPTTime. With an empty Right, as for an OD pair when no ride of this type reaches the stops of the destination, it is 0 instead of the largest value, so that the sum does not overflow; the join with Right is empty then anyway.";
	unit<uint64> Join_Left_Transf := select_with_org_rel(Join_Left_Transf0/CanStayWithinMaxPT)
	{
		attribute<Left>      Left_rel      := org_rel -> Left_rel;
		attribute<Transfers> Transfers_rel := org_rel -> Transfers_rel;

		// #151: a preselection before the join with Right. The rows of a group board the same right rides at the same moment, from the same
		// boarding event; they differ only in what the chain has paid, in its travel time (a flex ride or a trip surcharge adds time) and in
		// how its fare journeys can still continue. A row that another row of its group beats or equals on all of that gives no better chain
		// with any right ride. Price_S, Price_O and Price_F are only ever added, so their sum suffices, with the time costs Price_T when the
		// front chooses on Price_augm; when it chooses on Price, Price_T only breaks ties and stays out. The boarding fare Price_I is not added
		// (RO_continuation_allowed takes the highest). A chain with an open NS journey is compared only with chains with the same NS fare and
		// the same last NS alighting time (NS_key and its mirror), because whether a next NS ride continues the journey or starts a new one
		// depends on both, and the two outcomes land in different Pareto groups. With GradeSeparatedTransferPenalty the level of the last ride
		// is part of the group as well. At most six criteria: pareto_optimal_eps takes eight.
		attribute<uint64>    Group_key     := ='uint64(combine_data(c_FromTS_ReboardTS, Left_rel -> uq_c_FromTime_Stop_rel, Transfers_rel -> uq_c_Reboard_rel)) * uint64(#NS_Stations + 1) + uint64(MakeDefined(uint32(Left_rel -> First_NS_Station), #NS_Stations))'
		                                       + (ModelParameters/Advanced/GradeSeparatedTransferPenalty > 0[min_f] ? ' * 2u64 + uint64(Modes/IsStreetLevel[Left_rel -> Mode_rel] == 1b)' : '')
		, IntegrityCheck = "float64(#uq_c_FromTime_Stop) * float64(#uq_c_FromTime_Stop) * float64(#NS_Stations + 1) * 2.0 < 1.8e19";
		attribute<s>         TravelTime    := Left_rel -> traveltime + Transfers_rel -> Transfer_Time;
		attribute<Ct>        Price_Added   := ='Left_rel -> Price_S + Left_rel -> Price_F' + (HasLeft_RO ? ' + Left_rel -> Price_O' : '') + (/Classifications/ChainJoinerParetoAttr_Candidates/IsPriceFinal ? '' : ' + Left_rel -> Price_T + Transfers_rel -> Time_cost')
		, Descr = "The parts of the price that later rides only add to: Price_S, Price_F, with a regional ride Price_O, and when the front chooses on Price_augm the time costs of the chain and its transfer.";
		attribute<Ct>        Price_I       := =HasLeft_RO ? 'Left_rel -> Price_I' : 'const(0[Ct], .)';
		attribute<Time>      RO_state      := MakeDefined(sub_or_null(impl/LastArrivalMoment, Left_rel -> Last_RO_AlightTime), impl/LastArrivalMoment), Descr = "The time from the last alighting from a regional ride with the OV-chip to the end of the time window, or the whole window without such a ride; less is better, because a next regional ride can then continue the fare journey.";
		attribute<uint32>    NS_key        := =HasLeft_NS ? 'value(Left_rel -> Price_L, uint32) * 65536u + value(sub_or_null(impl/LastArrivalMoment, Left_rel -> Last_NS_AlightTime), uint32)' : 'const(0u, .)'
		, Descr = "The NS fare of the open NS journey and the time from its last NS alighting to the end of the time window, in one number; NS_key and NS_key_rev together keep only rows with the same value."
		, IntegrityCheck = "not(HasLeft_NS) || all(value(sub_or_null(impl/LastArrivalMoment, Left_rel -> Last_NS_AlightTime), uint32) < 65536u)";
		attribute<uint32>    NS_key_rev    := Max_NS_key - NS_key;
		attribute<bool>      IsParetoOptimal := ='pareto_optimal_eps(Group_key, TravelTime, Price_Added, 0.0'
		                                       + (HasLeft_RO ? ', Price_I, 0.0, RO_state, 0.0' : '')
		                                       + (HasLeft_NS ? ', NS_key, 0.0, NS_key_rev, 0.0' : '')
		                                       + ')';
	}
	parameter<uint32> Max_NS_key                       := #Join_Left_Transf > 0u64 ? max(Join_Left_Transf/NS_key) : 0u;
	unit<uint64>      c_FromTS_ReboardTS               := combine_unit_uint64(uq_c_FromTime_Stop, uq_c_FromTime_Stop), Descr = "The key of a pair (boarding event of a left chain, reboard event of its transfer), #151.";
	unit<uint64> Join_Left_Transf_Pareto := select_with_org_rel(Join_Left_Transf/IsParetoOptimal), Descr = "The left chains with a transfer that no other row of their group beats (Join_Left_Transf/IsParetoOptimal, #151)."
	{
		attribute<Left>      Left_rel      := org_rel -> Left_rel;
		attribute<Transfers> Transfers_rel := org_rel -> Transfers_rel;
	}

	unit<uint64> Join_LeftT_Right := join_equal_values_uint64(Join_Left_Transf_Pareto/transfers_rel->uq_c_Reboard_rel, Right/uq_c_FromTime_Stop_rel), Descr = "Joins every left chain plus transfer to the right rides that board where the transfer ends; this set holds all possible paths, from which Valid1 keeps the Pareto front per pair of boarding and alighting event and first NS station."
	{
		attribute<Left>      Left_rel                   := first_rel -> Left_rel;
		attribute<Transfers> Transfers_rel              := first_rel -> Transfers_rel;
		attribute<Right>     Right_rel                  := second_rel;
					
		attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := left_rel -> uq_c_FromTime_Stop_rel;
		attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := right_rel -> uq_c_ToTime_Stop_rel;
		attribute<Stops>     From_Stop_rel              := value(uq_c_FromTime_Stop_rel -> values % uint64(#Stops), Stops);
		attribute<Stops>     To_Stop_rel                := value(uq_c_ToTime_Stop_rel   -> Values % uint64(#Stops), Stops);
		
		attribute<s>         Traveltime_wo_Penalty      := Left_rel -> traveltime + Transfers_rel -> Transfer_Time + Right_rel -> traveltime;
		attribute<Modes>     from_Mode_rel              := Left_rel -> Mode_rel;
		attribute<Modes>     to_Mode_rel                := Right_rel -> Mode_rel;
		attribute<Modes>     Mode_rel                   := to_Mode_rel, Descr = "Last mode_rel";
		
		attribute<bool>      NeedsTranferTimePenalty    := IsDefined(Modes/IsStreetLevel[from_Mode_rel]) && IsDefined(Modes/IsStreetLevel[to_Mode_rel])
		                                                   && !(Modes/IsStreetLevel[from_Mode_rel] == 1b && Modes/IsStreetLevel[to_Mode_rel] == 1b)
		, Descr = "Does the transfer get GradeSeparatedTransferPenalty? Yes, unless both rides are boarded at street level (Modes/IsStreetLevel: tram, bus, walking); no penalty when the level of a ride is unknown.";
		attribute<s>         Traveltime                 := NeedsTranferTimePenalty
		                                                   ? Traveltime_wo_Penalty + convert(ModelParameters/Advanced/GradeSeparatedTransferPenalty, s)
		                                                   : Traveltime_wo_Penalty;
		
		attribute<bool>      IsTravelToSameStop         := from_Stop_rel == To_Stop_rel;
		attribute<bool>      IsJourneyLongerThanAllowed := Traveltime > convert(/ModelParameters/MaxPTTime, s);
		attribute<bool>      Is_valid_connection        := NOT(IsTravelToSameStop) && NOT(IsJourneyLongerThanAllowed);

		unit<uint64> Valid1 := select(is_valid_connection)
		{
			attribute<s>             TravelTime                      := collect_by_cond(., Join_LeftT_Right/TravelTime);
			
			attribute<Left>          Left_rel                        := collect_by_cond(., Join_LeftT_Right/Left_rel);
			attribute<Transfers>     Transfers_rel                   := collect_by_cond(., Join_LeftT_Right/Transfers_rel);
			attribute<Right>         Right_rel                       := collect_by_cond(., Join_LeftT_Right/Right_rel);
			
			attribute<bool>          RO_continuation_allowed         := =RO_transfer_possible ? 'Left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney >= Right_rel->BoardingTime_RO' : 'const(false,. )';
			attribute<Ct>            Price_I                         :=
					= RO_transfer_possible ? 'RO_continuation_allowed ? max_elem(Left_rel->price_I, Right_rel->price_I) : Left_rel->price_I + Right_rel->price_I'
					: HasLeft_RO           ? 'Left_rel->price_I' 
					: HasRight_RO          ? 'Right_rel->price_I' 
					: 'const(0[Ct], .)';
			attribute<Ct>            Price_O                         :=
					= RO_transfer_possible ? 'Left_rel->Price_O + Right_rel->Price_O'
					: HasLeft_RO  ? 'Left_rel->Price_O' 
					: HasRight_RO ? 'Right_rel->Price_O' 
					: 'const(0[Ct], .)';
			attribute<Ct>            Price_T                         := Left_rel->Price_T + Transfers_rel->Time_cost + Right_rel->Price_T;
			attribute<Ct>            Price_S                         := Left_rel->Price_S + Right_rel->Price_S, Descr = "The prices per ride of the chain, apart from the boarding fare and the through NS fare: the trip surcharge of special trains (#3, OD_L/Price_S) and the fixed fares per ride (#55, OD_R/Price_S).";
			
			// These intermediate steps are only needed with NS_transfer_possible, to recalculate the train ticket.
			attribute<c_NS_start_end> c_NS_start_end_rel := =NS_transfer_possible  ? 'combine_data(c_NS_start_end, left_rel ->First_NS_Station, right_rel-> Last_NS_Station)' : 'const(null_u, .)';
					
			attribute<Ct>            Price_NS                        := =NS_transfer_possible  ? 'rjoin(c_NS_start_end_rel, TariffUnitsMatrix/c_NS_start_end_rel, TariffUnitsMatrix/Price_ct)' : 'const(0[Ct], .)' ;
																			
			attribute<bool>          NS_transfer_allowed             := =NS_transfer_possible ? 'Left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney >= Right_rel->BoardingTime_NS' : 'const(false,. )';
			attribute<bool>          NS_through_fare_cheaper         := =NS_transfer_possible ? NS_through_fare_certain ?'const(true, .)':'NS_transfer_allowed && IsDefined(Price_NS) && Price_NS < Left_rel->Price_L + Right_rel->Price_L' : 'const(false,. )';
			attribute<Ct>            Price_L                         := =NS_through_fare_certain ? 'Price_NS' : NS_transfer_possible ? 'NS_through_fare_cheaper ? Price_NS : Right_rel->Price_L' : HasLeft_NS ? 'Left_rel->Price_L' : HasRight_NS ? 'Right_rel->Price_L' :'const(0[Ct], .)';
			attribute<Ct>            Price_F_inherited               := ='Left_rel->Price_F' + (strlen(RightStr) > 1 ? '+ Right_rel->Price_F' : ''), Descr = "Final costs inherited from left and right sources";
			attribute<Ct>            Price_F                         := =NS_through_fare_certain or not(NS_transfer_possible) ? 'Price_F_inherited' : 'NS_through_fare_cheaper ? Price_F_inherited : Price_F_inherited + Left_rel->Price_L', Descr = "Final costs, not subject to subsequent recalculation";
			attribute<Ct>            Price                           := = (Has_RO ? 'Price_O + Price_I ':'')+(HasBoth?'+':'')+(Has_NS?'Price_L':'')+(HasLeft_NS?' + Price_F':'')+' + Price_S', Descr = "The price to pay.";
			attribute<Ct>            Price_augm                      := Price + Price_T;
					
			attribute<Time>          remaining_time_excl_NS_transfer :=
				= HasRight_NS ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, right_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney), 0[Time])'
				: HasLeft_NS ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, iif(left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney > right_rel->To_Time_rel, left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time])), 0[Time])'
				: 'const(impl/LastArrivalMoment, .)';
				
			// A right ride on a fixed fare (Last_RO_AlightTime null, #55) passes the OV-chip journey of the left chain on, like a ride with NS.
			attribute<Time>          remaining_time_excl_RO_transfer :=
				= RO_transfer_possible ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, IsDefined(right_rel->Last_RO_AlightTime) ? right_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney : ' + Left_RO_WindowEnd + '), 0[Time])'
				: HasRight_RO ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, MakeDefined(right_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time])), 0[Time])'
				: HasLeft_RO ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, ' + Left_RO_WindowEnd + '), 0[Time])'
				: 'const(impl/LastArrivalMoment, .)';
			
			attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := Left_rel ->uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := Right_rel->uq_c_ToTime_Stop_rel;
			attribute<c_FromTS_ToTS> OD_pair_key                     := combine_data(c_FromTS_ToTS, uq_c_FromTime_Stop_rel, uq_c_ToTime_Stop_rel);


			// The first NS station of the current NS journey; the NS price of an extension at a through fare depends on it.
			attribute<NS_Stations>   First_NS_Station                :=
				= NS_through_fare_certain ? 'left_rel ->First_NS_Station'
				: NS_transfer_possible    ? 'NS_through_fare_cheaper ? left_rel ->First_NS_Station : Right_rel->First_NS_Station'
				: HasRight_NS             ? 'right_rel->First_NS_Station'
				: HasLeft_NS              ? 'left_rel->First_NS_Station'
				: 'const(null_u,.)';
			// The group of the Pareto selection: the OD pair and the first NS station. Two chains with a different first station can swap order in price
			// after an extension with NS, because the through fare is degressive, so grouping on the OD pair alone would keep block fronts that are too
			// expensive. A chain without NS station counts as a station of its own. The grouping is a 64-bit key that pareto_optimal_eps uses directly.
			attribute<uint64>        Part_key                        := uint64(OD_pair_key) * uint64(#NS_Stations + 1) + uint64(MakeDefined(uint32(First_NS_Station), #NS_Stations))
			, IntegrityCheck = "float64(#uq_c_FromTime_Stop) * float64(#uq_c_ToTime_Stop) * float64(#NS_Stations + 1) < 1.8e19";

			unit<uint8>              ParetoAttr                      := ChainJoinerParetoAttr;
			// pareto_optimal_eps keeps per group the rows that no other row dominates, with a relative epsilon per criterion (Classifications/../EpsilonExpr; 0 = exact).
			attribute<bool>          Pareto_condition                := ='pareto_optimal_eps(Part_key, ' + asList(ParetoAttr/ParetoArgs, ', ') + ')';
		}
		attribute<bool>      Valid_pareto_optimal       := recollect_by_cond(is_valid_connection,  Valid1/pareto_condition, false);
		attribute<Valid1>    Valid1_rel                 := recollect_by_cond(is_valid_connection, ID(Valid1));
	}

	container x
	: Descr = "Workaround for a deadlock (ObjectVision/GeoDMS#965)."
	, URL = "https://github.com/ObjectVision/GeoDMS/issues/965"
	{
		unit<uint32> Result := select_uint32(Join_LeftT_Right/valid_pareto_optimal)
		, Descr = "The valid chains of this type that are Pareto-optimal per pair of boarding and alighting event and first NS station."
		{
			attribute<Left>        Left_rel                := collect_by_cond(., Join_LeftT_Right/Left_rel);
			attribute<Right>       Right_rel               := collect_by_cond(., Join_LeftT_Right/Right_rel);
			attribute<Join_LeftT_Right/Valid1> Valid1_rel := collect_by_cond(., Join_LeftT_Right/Valid1_rel);
			
			parameter<uint32>      ModeFactor              := Left/ModeFactor * Right/ModeFactor, Descr = "16 to the power of the number of rides of this chain, the product of left and right (16 for one ride, OD_R/Result and OD_L/Result); a next chain joiner with this chain on the right shifts the ModeCode of the left chain by ModeFactor.";
			attribute<uint32>      ModeCode                := Left_rel -> ModeCode * Right/ModeFactor + Right_rel -> ModeCode, Descr = "The modes of the rides (Classifications/GTFS_Modes/CodeDigits) as a uint32, the left part shifted by the ModeFactor of the right, composed only for the remaining chains to save calculation time.";
			attribute<Modes>       Mode_rel                := Right_rel -> Mode_rel;

			attribute<NS_Stations> First_NS_Station        : Descr = "The first NS station of the chain, kept to recalculate the NS fare afterwards.",
			                                                 = Valid1_rel->First_NS_Station;
			attribute<NS_Stations> Last_NS_Station         : Descr = "The last NS station of the chain, kept to recalculate the NS fare afterwards.",
			                                                 =	= HasRight_NS ? 'Right_rel->Last_NS_Station'
			                                                     : HasLeft_NS ? 'Left_rel->Last_NS_Station'
			                                                     : 'const(null_u,.)';
			
			attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := Left_rel ->uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := Right_rel->uq_c_ToTime_Stop_rel;
			
			attribute<s>           TravelTime              := collect_by_cond(., Join_LeftT_Right/TravelTime);
			
			attribute<Ct>          Price_I                 := Valid1_rel->Price_I;
			attribute<Ct>          Price_O                 := Valid1_rel->Price_O;
			attribute<Ct>          Price_F                 := Valid1_rel->Price_F;
			attribute<Ct>          Price_L                 := Valid1_rel->Price_L;
			attribute<Ct>          Price_T                 := Valid1_rel->Price_T;
			attribute<Ct>          Price_S                 := Valid1_rel->Price_S;
			attribute<Ct>          Price                   := Valid1_rel->Price  ;
			
			attribute<Ct>          Price_augm              := Price + Price_T, Descr = "The price to pay plus the costs of travel and waiting time that has no price.";
			attribute<dam>         TravelDist_Bus          := Left_rel -> TravelDist_Bus   + Right_rel -> TravelDist_Bus;
			attribute<dam>         TravelDist_Metro        := Left_rel -> Traveldist_Metro + Right_rel -> Traveldist_Metro;
			attribute<dam>         TravelDist_Tram         := Left_rel -> Traveldist_Tram  + Right_rel -> Traveldist_Tram;
			attribute<dam>         TravelDist_Rail         := Left_rel -> Traveldist_Rail  + Right_rel -> Traveldist_Rail;
			attribute<dam>         TravelDist_Ferry        := Left_rel -> Traveldist_Ferry + Right_rel -> Traveldist_Ferry;
			// #146: TravelTime is the time of the rides plus that of the transfers between them, walking and waiting (Transfers/Walking_time and
			// WaitingAtStop_time), plus GradeSeparatedTransferPenalty when the transfer needs it; the penalty counts as walking. The rest of
			// TravelTime is the time in the vehicle and the extra time per boarding of a flex ride or a trip surcharge, which is in PTWaitTime
			// (OD_extra_attributen).
			attribute<Transfers>   Transfers_rel           := Valid1_rel -> Transfers_rel, Descr = "The transfer between the left chain and the right ride.";
			attribute<s>           Transfer_Penalty        := TravelTime - Left_rel -> TravelTime - Transfers_rel -> Transfer_Time - Right_rel -> TravelTime, Descr = "GradeSeparatedTransferPenalty of the transfer, or 0.";
			attribute<s>           TransferWalkTime        := Left_rel -> TransferWalkTime + Transfers_rel -> Walking_time + Transfer_Penalty + Right_rel -> TransferWalkTime, Descr = "Walking at the transfers of the chain, with the penalty for a transfer with a height difference.";
			attribute<s>           PTWaitTime              := Left_rel -> PTWaitTime + Transfers_rel -> WaitingAtStop_time + Right_rel -> PTWaitTime, Descr = "Waiting at the transfers of the chain, and the extra time per boarding of its flex rides and trains with a trip surcharge.";

			attribute<Time>        Last_NS_AlightTime      := =HasRight_NS ? 'Right_rel->Last_NS_AlightTime' : 'Left_rel->Last_NS_AlightTime', Descr = "The last alighting time from a ride with NS, kept through regional rides, to check whether a following ride with NS continues the same fare journey (NS_transfer_allowed).";
			attribute<Time>        Last_RO_AlightTime      := =RO_transfer_possible ? 'MakeDefined(Right_rel->Last_RO_AlightTime, Left_rel->Last_RO_AlightTime)' : HasRight_RO ? 'Right_rel->Last_RO_AlightTime' : 'Left_rel->Last_RO_AlightTime'
			, Descr = "The last alighting time from a regional ride with the OV-chip, kept through NS rides and rides on a fixed fare (#55), to check whether a following regional ride continues the same fare journey (RO_continuation_allowed).";
		}
	}
	
	container         Fence                            := PhaseContainer(x, 'Calculated: '+StartCalc/ChainName+' for keten '+BlockDomain/name[BlockDomain_id]);
	unit<uint32>      Result                           := Fence/Result;
}