Template ChainJoiner_T : Descr = "Joins the chains of type LeftStr through a transfer to the legs (or chains) of type RightStr into chains of type LeftStr+RightStr, with their price, and keeps the Pareto front per OD pair and first NS station."
{
	unit<uint32> Left; 
	unit<uint32> Right;
	unit<uint32> Transfers;
	
	parameter<string> LeftStr;
	parameter<string> RightStr;
	////
	parameter<bool>   HasLeft_RO    := IsDefined(strpos(LeftStr , 'R'));
	parameter<bool>   HasRight_RO   := IsDefined(strpos(RightStr, 'R'));
	parameter<bool>   HasLeft_NS    := IsDefined(strpos(LeftStr , 'L')) || IsDefined(strpos(LeftStr, 'K'));
	parameter<bool>   HasRight_NS   := IsDefined(strpos(RightStr, 'L')) || IsDefined(strpos(RightStr, 'K'));
	parameter<bool>   Has_RO        := HasLeft_RO || HasRight_RO;
	parameter<bool>   Has_NS        := HasLeft_NS || HasRight_NS;
	parameter<bool>   HasBoth       := Has_RO && Has_NS;
	
	parameter<bool>   NS_transfer_possible := HasLeft_NS && HasRight_NS;
	parameter<bool>   NS_through_fare_certain    := right(LeftStr, 1)=='L' && left(RightStr, 1)=='L';
	parameter<bool>   RO_transfer_possible := HasLeft_RO && HasRight_RO;

	parameter<Time>   MaxTransferTimeWithinFareJourney  := convert(/ModelParameters/Advanced/MaxTransferTimeForBoardingSurcharge,s_f)[Time]; // MOVE to ModelParameters/Advanced


	container StartCalc0{parameter<string> ChainName := Leftstr+RightStr;}
	container StartCalc := PhaseContainer(StartCalc0, 'Start calculating '+string(StartCalc0/ChainName)+' for '+BlockDomain/name[BlockDomain_id]);
	
	// The combinations of left chain and transfer that already exceed MaxPTTime with the shortest right leg are dropped before the second join,
	// with the same valid chains as a result (IsJourneyLongerThanAllowed tests the same sum plus a possible penalty).
	unit<uint64> Join_Left_Transf0  := join_equal_values_uint64(Left/uq_c_ToTime_Stop_rel, Transfers/uq_c_Exit_rel)
	, Descr = "Joins every left chain to the transfers that start at its arrival (time and stop)."
	{
		attribute<Left>      Left_rel      := first_rel;
		attribute<Transfers> Transfers_rel := second_rel;
		attribute<bool>      CanStayWithinMaxPT := Left_rel -> traveltime + Transfers_rel -> Transfer_Time + MinRightTraveltime <= convert(/ModelParameters/MaxPTTime, s);
	}
	parameter<s>  MinRightTraveltime := #Right > 0 ? min(Right/traveltime) : 0[s]
	, Descr = "The shortest right leg, for the early cutoff on MaxPTTime. With an empty Right, as for an OD pair when no leg of this type reaches the stops of the destination, it is 0 instead of the largest value, so that the sum does not overflow; the join with Right is empty then anyway.";
	unit<uint64> Join_Left_Transf   := select_with_org_rel(Join_Left_Transf0/CanStayWithinMaxPT)
	{
		attribute<Left>      Left_rel      := org_rel -> Left_rel;
		attribute<Transfers> Transfers_rel := org_rel -> Transfers_rel;
	}

	unit<uint64> Join_LeftT_Right   := join_equal_values_uint64(Join_Left_Transf/transfers_rel->uq_c_Reboard_rel, Right/uq_c_FromTime_Stop_rel), Descr = "Joins every left chain plus transfer to the right legs that board where the transfer ends; this set holds all possible paths, from which Valid1 keeps the Pareto front per OD pair."
	{
		attribute<Left>               Left_rel                        := first_rel -> Left_rel;
		attribute<Transfers>          Transfers_rel                   := first_rel -> Transfers_rel;
		attribute<Right>              Right_rel                       := second_rel;
					
		attribute<uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel          := left_rel -> uq_c_FromTime_Stop_rel;
		attribute<uq_c_ToTime_Stop>   uq_c_ToTime_Stop_rel            := right_rel -> uq_c_ToTime_Stop_rel;
		attribute<Stops>              From_Stop_rel                   := value(uq_c_FromTime_Stop_rel -> values % uint64(#Stops), Stops);
		attribute<Stops>              To_Stop_rel                     := value(uq_c_ToTime_Stop_rel   -> Values % uint64(#Stops), Stops);
		
		attribute<s>                  Traveltime_wo_Penalty           := Left_rel -> traveltime + Transfers_rel -> Transfer_Time + Right_rel -> traveltime;
		attribute<Modes>              from_Mode_rel                   := Left_rel -> Mode_rel;
		attribute<Modes>              to_Mode_rel                     := Right_rel -> Mode_rel;
		attribute<Modes>              Mode_rel                        := to_Mode_rel, Descr = "Last mode_rel";
		attribute<uint32>             ModeCode                        := Left_rel -> ModeCode * Right/ModeFactor + Right_rel -> ModeCode;
		
		attribute<bool>               NeedsTranferTimePenalty         := Modes/IsStreetLevel[from_Mode_rel] == 1b && Modes/IsStreetLevel[to_Mode_rel] == 1b // from: bus, tram, walk to bus, tram, walk --> no penalty
																			? False
																			: Modes/IsStreetLevel[from_Mode_rel] == 1b && Modes/IsStreetLevel[to_Mode_rel] == 0b // from: bus, tram, walk to metro, rail, ferry --> penalty
																				? TRUE
																				: Modes/IsStreetLevel[from_Mode_rel] == 0b && Modes/IsStreetLevel[to_Mode_rel] == 0b // from: metro, rail, ferry to metro, rail, ferry --> penalty
																					? TRUE
																					: Modes/IsStreetLevel[from_Mode_rel] == 0b && Modes/IsStreetLevel[to_Mode_rel] == 1b // from: metro, rail, ferry to bus, tram, walk --> penalty
																						? TRUE
																						: (0/0)[bool];
		attribute<s>                  Traveltime                      := NeedsTranferTimePenalty 
																			? Traveltime_wo_Penalty + convert(ModelParameters/Advanced/GradeSeparatedTransferPenalty, s) 
																			: Traveltime_wo_Penalty;
		
		attribute<bool>               IsTravelToSameStop              := from_Stop_rel == To_Stop_rel;
		attribute<bool>               IsJourneyLongerThanAllowed      := Traveltime > convert(/ModelParameters/MaxPTTime, s);
		attribute<bool>               Is_valid_connection             := NOT(IsTravelToSameStop) && NOT(IsJourneyLongerThanAllowed);

		unit<uint64> Valid1 := select(is_valid_connection)
		{
			attribute<s>  TravelTime           := collect_by_cond(., Join_LeftT_Right/TravelTime);
			
			attribute<Left>             Left_rel                        := collect_by_cond(., Join_LeftT_Right/Left_rel);
			attribute<Transfers>        Transfers_rel                   := collect_by_cond(., Join_LeftT_Right/Transfers_rel);
			attribute<Right>            Right_rel                       := collect_by_cond(., Join_LeftT_Right/Right_rel);
			
			attribute<bool>             RO_continuation_allowed          := =RO_transfer_possible ? 'Left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney >= Right_rel->BoardingTime_RO' : 'const(false,. )';
			attribute<Ct>               Price_I                         := 
					= RO_transfer_possible ? 'RO_continuation_allowed ? max_elem(Left_rel->price_I, Right_rel->price_I) : Left_rel->price_I + Right_rel->price_I'
					: HasLeft_RO           ? 'Left_rel->price_I' 
					: HasRight_RO          ? 'Right_rel->price_I' 
					: 'const(9999[Ct], .)';
			attribute<Ct>               Price_O                         :=
					= RO_transfer_possible ? 'Left_rel->Price_O + Right_rel->Price_O'
					: HasLeft_RO  ? 'Left_rel->Price_O' 
					: HasRight_RO ? 'Right_rel->Price_O' 
					: 'const(9999[Ct], .)';
			attribute<Ct>               Price_T                         := Left_rel->Price_T + Transfers_rel->Time_cost + Right_rel->Price_T;
			attribute<Ct>               Price_S                         := Left_rel->Price_S + Right_rel->Price_S, Descr = "Trip surcharge of the special trains in the chain (#3, MakeODs/OD_L/Price_S), per leg and so apart from the through NS fare in Price_L.";
			
			// These intermediate steps are only needed with NS_transfer_possible, to recalculate the train ticket.
			attribute<c_NS_start_end>   c_NS_start_end_rel              := =NS_transfer_possible  ? 'combine_data(c_NS_start_end, left_rel ->First_NS_Station, right_rel-> Last_NS_Station)' : 'const(null_u, .)';
					
			attribute<Ct>               Price_NS                        := =NS_transfer_possible  ? 'rjoin(c_NS_start_end_rel, TariffUnitsMatrix/c_NS_start_end_rel, TariffUnitsMatrix/Price_ct)' : 'const(9999[Ct], .)' ;
																			
			attribute<bool>             NS_transfer_allowed          := =NS_transfer_possible ? 'Left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney >= Right_rel->BoardingTime_NS' : 'const(false,. )';
			attribute<bool>             NS_through_fare_cheaper           := =NS_transfer_possible ? NS_through_fare_certain ?'const(true, .)':'NS_transfer_allowed && IsDefined(Price_NS) && Price_NS < Left_rel->Price_L + Right_rel->Price_L' : 'const(false,. )';
			attribute<Ct>               Price_L                         := =NS_through_fare_certain ? 'Price_NS' : NS_transfer_possible ? 'NS_through_fare_cheaper ? Price_NS : Right_rel->Price_L' : HasLeft_NS ? 'Left_rel->price_L' : HasRight_NS ? 'Right_rel->price_L' : 'const(0[Ct], .)';
			attribute<Ct>               Price_F_inherited               := ='Left_rel->Price_F' + (strlen(RightStr) > 1 ? '+ Right_rel->Price_F' : ''), Descr = "Final costs inherited from left and right sources";
			attribute<Ct>               Price_F                         := =NS_through_fare_certain or not(NS_transfer_possible) ? 'Price_F_inherited' : 'NS_through_fare_cheaper ? Price_F_inherited : Price_F_inherited + Left_rel->Price_L', Descr = "Final costs, not subject to subsequent recalculation";
			attribute<Ct>               Price                           := = (Has_RO ? 'Price_O + Price_I ':'')+(HasBoth?'+':'')+(Has_NS?'Price_L':'')+(HasLeft_NS?' + Price_F':'')+(Has_NS?' + Price_S':''), Descr = "The price to pay.";
			attribute<Ct>               Price_augm                      := Price + Price_T;
					
			attribute<Time> remaining_time_excl_NS_transfer := 
				= HasRight_NS ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, right_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney), 0[Time])'
				: HasLeft_NS ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, iif(left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney > right_rel->To_Time_rel, left_rel->Last_NS_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time])), 0[Time])'
				: 'const(impl/LastArrivalMoment, .)';
				
			attribute<Time> remaining_time_excl_RO_transfer :=
				= HasRight_RO ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, right_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney), 0[Time])'
				: HasLeft_RO ? 'MakeDefined(sub_or_null(impl/LastArrivalMoment, iif(left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney > right_rel->To_Time_rel, left_rel->Last_RO_AlightTime + MaxTransferTimeWithinFareJourney, 0[Time])), 0[Time])'
				: 'const(impl/LastArrivalMoment, .)';
			
			attribute<uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel      := Left_rel ->uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel        := Right_rel->uq_c_ToTime_Stop_rel;
			attribute<c_FromTS_ToTS>        OD_pair_key                 := combine_data(c_FromTS_ToTS, uq_c_FromTime_Stop_rel, uq_c_ToTime_Stop_rel);


			// The first NS station of the current NS journey; the NS price of an extension at a through fare depends on it.
			attribute<NS_Stations> First_NS_Station :=
				= NS_through_fare_certain ? 'left_rel ->First_NS_Station'
				: NS_transfer_possible    ? 'NS_through_fare_cheaper ? left_rel ->First_NS_Station : Right_rel->First_NS_Station'
				: HasRight_NS             ? 'right_rel->First_NS_Station'
				: HasLeft_NS              ? 'left_rel->First_NS_Station'
				: 'const(null_u,.)';
			// The group of the Pareto selection: the OD pair and the first NS station. Two chains with a different first station can swap order in price
			// after an extension with NS, because the through fare is degressive, so grouping on the OD pair alone would keep block fronts that are too
			// expensive. A chain without NS station counts as a station of its own. The grouping is a 64-bit key that pareto_optimal_eps uses directly.
			attribute<uint64>     Part_key                         := uint64(OD_pair_key) * uint64(#NS_Stations + 1) + uint64(MakeDefined(uint32(First_NS_Station), #NS_Stations))
			, IntegrityCheck = "float64(#uq_c_FromTime_Stop) * float64(#uq_c_ToTime_Stop) * float64(#NS_Stations + 1) < 1.8e19";

			unit<uint8>  ParetoAttr := ChainJoinerParetoAttr;
			// pareto_optimal_eps keeps per group the rows that no other row dominates, with a relative epsilon per criterion (Classifications/../EpsilonExpr; 0 = exact).
			attribute<bool> Pareto_condition                 := ='pareto_optimal_eps(Part_key, ' + asList(ParetoAttr/ParetoArgs, ', ') + ')';
		}
		attribute<bool>     Valid_pareto_optimal             := recollect_by_cond(is_valid_connection,  Valid1/pareto_condition, false);
		attribute<Valid1>   Valid1_rel                       := recollect_by_cond(is_valid_connection, ID(Valid1));
	}

	container x
	: Descr = "Workaround for a deadlock (ObjectVision/GeoDMS#965)."
	, URL = "https://github.com/ObjectVision/GeoDMS/issues/965"
	{
		unit<uint32> Result := select_uint32(Join_LeftT_Right/valid_pareto_optimal)
		, Descr = "The valid chains of this type that are Pareto-optimal per OD pair and first NS station."
		{
			attribute<Left>                    Left_rel                        := collect_by_cond(., Join_LeftT_Right/Left_rel);
			attribute<Right>                   Right_rel                       := collect_by_cond(., Join_LeftT_Right/Right_rel);
			attribute<Join_LeftT_Right/Valid1> Valid1_rel                      := collect_by_cond(., Join_LeftT_Right/Valid1_rel);
			
			parameter<uint32>                  ModeFactor                      := Left/ModeFactor * Right/ModeFactor, Descr = "16 to the power of the number of legs of this chain, the product of left and right (16 for one leg, OD_R/Result and OD_L/Result); a next chain joiner with this chain on the right shifts the ModeCode of the left chain by ModeFactor.";
			attribute<uint32>                  ModeCode                        := Left_rel -> ModeCode * Right/ModeFactor + Right_rel -> ModeCode, Descr = "The modes of the legs (Classifications/GTFS_Modes/CodeDigits) as a uint32, the left part shifted by the ModeFactor of the right, composed only for the remaining chains to save calculation time.";
			attribute<Modes>                   Mode_rel                        := Right_rel -> Mode_rel;
			attribute<bool>                    NS_through_fare_cheaper           := Valid1_rel->NS_through_fare_cheaper;

			attribute<NS_Stations>             First_NS_Station                : Descr = "The first NS station of the chain, kept to recalculate the NS fare afterwards.",
				= Valid1_rel->First_NS_Station;
			attribute<NS_Stations>             Last_NS_Station                 : Descr = "The last NS station of the chain, kept to recalculate the NS fare afterwards.",
				=	= HasRight_NS ? 'Right_rel->Last_NS_Station' 
					: HasLeft_NS ? 'Left_rel->Last_NS_Station' 
					: 'const(null_u,.)';
			
			attribute<uq_c_FromTime_Stop>      uq_c_FromTime_Stop_rel          := Left_rel ->uq_c_FromTime_Stop_rel;
			attribute<uq_c_ToTime_Stop>        uq_c_ToTime_Stop_rel            := Right_rel->uq_c_ToTime_Stop_rel;
			
			attribute<s>                       TravelTime                      := collect_by_cond(., Join_LeftT_Right/TravelTime);		
			
			attribute<Ct>                      Price_I                         := Valid1_rel->Price_I;
			attribute<Ct>                      Price_O                         := Valid1_rel->Price_O;
			attribute<Ct>                      Price_F                         := Valid1_rel->Price_F;
			attribute<Ct>                      Price_L                         := Valid1_rel->Price_L;
			attribute<Ct>                      Price_T                         := Valid1_rel->Price_T;
			attribute<Ct>                      Price_S                         := Valid1_rel->Price_S;
			attribute<Ct>                      Price                           := Valid1_rel->Price  ;
			
			attribute<Ct>                      Price_augm                      := Price + Price_T, Descr = "The price to pay plus the costs of travel and waiting time that has no price."; 
			attribute<dam>                     TravelDist_Bus                  := Left_rel -> TravelDist_Bus   + Right_rel -> TravelDist_Bus;
			attribute<dam>                     TravelDist_Metro                := Left_rel -> Traveldist_Metro + Right_rel -> Traveldist_Metro;
			attribute<dam>                     TravelDist_Tram                 := Left_rel -> Traveldist_Tram  + Right_rel -> Traveldist_Tram;
			attribute<dam>                     TravelDist_Rail                 := Left_rel -> Traveldist_Rail  + Right_rel -> Traveldist_Rail;
			attribute<dam>                     TravelDist_Ferry                := Left_rel -> Traveldist_Ferry + Right_rel -> Traveldist_Ferry;
					
			attribute<Time>                    Last_NS_AlightTime         := =HasRight_NS ? 'Right_rel->Last_NS_AlightTime' : 'Left_rel->Last_NS_AlightTime', Descr = "The last alighting time from an NS leg, kept through regional legs, to check whether a following NS leg continues the same fare journey (NS_transfer_allowed).";
			attribute<Time>                    Last_RO_AlightTime         := =HasRight_RO ? 'Right_rel->Last_RO_AlightTime' : 'Left_rel->Last_RO_AlightTime', Descr = "The last alighting time from a regional leg, kept through NS legs (K or L), to check whether a following regional leg continues the same fare journey (RO_continuation_allowed).";			
		}
	}
	
	container Fence := PhaseContainer(x, 'Calculated: '+StartCalc/ChainName+' for keten '+BlockDomain/name[BlockDomain_id]);
	unit<uint32> Result := Fence/Result;
}