// THE OPTIONS OF AN OD PAIR WITH THEIR PARTS AND LINKS (#129; only in the OD pair mode, ModelParameters/Impl/IsOD).
// Per departure moment the options of the front (Result_AfterSecondCondensation), each traced back to the row of the final front it comes
// from: a public transport journey (pre-transport leg, chain, post-transport leg) or a direct trip. Onderdelen describes each option in the
// order of the journey; Links gives each part its links, with one line per link:
// - pre-transport and post-transport: the links of the leg from the leg store (PublicTransport_Prep/LegStores/<base type>/Links);
// - a public transport leg: the stop-to-stop links within the trip, from a search in Set_L or Set_R between the begin and end node of the leg
//   (OD_Ketens/Read_Benen), which on the time-expanded network gives the same path as the leg (every path between two nodes takes equally
//   long, and with ParetoLegs the choice at equal time is the shortest, Length);
// - a transfer: the straight walking line between the stops;
// - the direct walking and cycling trip: the links of the search (PrivateTransport/<mode>/Calc_Traveltimes_maxspeed_<mode>/Links);
// - the direct car trip of the moment: the links of its route from the car store of the moment (see AutoOpties).
// Write writes them as three layers of <OutputDir>/PerBlock/od_<moment>.gpkg (od_opties, od_onderdelen and od_links; GeoDMS names are
// case-insensitive, so a layer opties := Opties would refer to itself), in the request of the output (Results_Traveltime/Generate).
container OD_Uitvoer : Descr = "The options of the OD pair per departure moment with their parts and links, written as three layers of a gpkg (only in the OD pair mode, #129)."
{
	unit<uint64> Opties := Result_AfterSecondCondensation
	{
		attribute<uint32>                         Optie        := uint32(id(.)) + 1, Descr = "The number of the option of this departure moment, from 1.";
		attribute<Union_with_DirectOD>            Union_rel    := Result_AfterFirstCondensation/Union_rel[Result_AfterSecondCondensation/First_rel];
		attribute<bool>                           IsDirect     := Union_with_DirectOD/IsDirectTravel[Union_rel];
		attribute<uint64>                         Bron_rel     := Union_with_DirectOD/Bron_rel[Union_rel];
		attribute<string>                         Vertrek      := const(Time/Label[inTime[Time]], .);
		attribute<min_f>                          Reistijd     := convert(Result_AfterSecondCondensation/Traveltime, min_f);
		attribute<Euro>                           Prijs        := convert(Result_AfterSecondCondensation/Price, Euro);
		attribute<string>                         ModeUsed     := Result_AfterSecondCondensation/ModeUsed;
		attribute<string>                         label        := string(Optie) + ' ' + Vertrek + ' ' + ModeUsed + ' ' + string(Reistijd) + ' min ' + string(Prijs) + ' euro';
	}

	// THE PUBLIC TRANSPORT OPTIONS: each traced back through the final front to the chain in the chain store of the pair.
	unit<uint64> PT := = WithPT ? 'select_with_org_rel(!Opties/IsDirect)' : 'range(uint64, 0u64, 0u64)'
	{
		attribute<Opties> Optie_rel := = WithPT ? 'org_rel' : 'const(value(null_u, Opties), .)';
		attribute<uint64> VPTN_Res  := Opties/Bron_rel[Optie_rel], Descr = "The row of Add_N_to_VPT/Result.";
		attribute<uint64> VPTN      := = WithPT ? 'uint64(Add_N_to_VPT/Result/VPTN_rel[value(VPTN_Res, Add_N_to_VPT/Result)])' : 'const(0u64, .)';
		attribute<uint64> N_row     := = WithPT ? 'uint64(Add_N_to_VPT/N_rel[value(VPTN, Add_N_to_VPT)])' : 'const(0u64, .)';
		attribute<uint64> VPT_Res   := = WithPT ? 'uint64(Add_N_to_VPT/PT_rel[value(VPTN, Add_N_to_VPT)])' : 'const(0u64, .)';
		attribute<uint64> VPT       := = WithPT ? 'uint64(Add_V_to_PT/Result/VPT_rel[value(VPT_Res, Add_V_to_PT/Result)])' : 'const(0u64, .)';
		attribute<uint64> V_row     := = WithPT ? 'uint64(Add_V_to_PT/V_rel[value(VPT, Add_V_to_PT)])' : 'const(0u64, .)';
		attribute<uint64> W_row     := = WithPT ? 'uint64(Add_V_to_PT/PT_rel[value(VPT, Add_V_to_PT)])' : 'const(0u64, .)';
		attribute<uint64> Keten     := = WithPT ? '/NetworkSetup/PublicTransport_Prep/PT_V/Keten[PT_InBlock/PT_V_rel[Within_VW_Window/PT_InBlock_rel[value(W_row, Within_VW_Window)]]]' : 'const(0u64, .)'
		,	Descr = "The row number of the chain in the chain store of the pair, as OD_Ketens/Read_Benen/Keten.";
		attribute<Places> V_Stop_Place := = WithPT ? 'V/To_Place_rel[value(V_row, V)]' : 'const(value(null_u, Places), .)';
		attribute<Places> N_Stop_Place := = WithPT ? 'N/From_Place_rel[value(N_row, N)]' : 'const(value(null_u, Places), .)';
		attribute<Modes>  V_Mode       := = WithPT ? 'V/Mode_rel[value(V_row, V)]' : 'const(value(null_b, Modes), .)';
		attribute<Modes>  N_Mode       := = WithPT ? 'N/Mode_rel[value(N_row, N)]' : 'const(value(null_b, Modes), .)';
		attribute<Time>   V_Vertrek    := = WithPT ? 'Add_V_to_PT/V_From_Time_rel[value(VPT, Add_V_to_PT)]' : 'const(value(null_u, Time), .)';
		attribute<s>      V_Duur       := = WithPT ? 'Add_V_to_PT/V_time[value(VPT, Add_V_to_PT)]' : 'const(0[s], .)';
		attribute<Time>   N_Vertrek    := = WithPT ? 'Add_N_to_VPT/PT_To_Time_rel[value(VPTN, Add_N_to_VPT)]' : 'const(value(null_u, Time), .)';
		attribute<s>      N_Duur       := = WithPT ? 'Add_N_to_VPT/N_time[value(VPTN, Add_N_to_VPT)]' : 'const(0[s], .)';
		attribute<dam>    V_Afstand    := = WithPT ? 'V/Distance[value(V_row, V)]' : 'const(0[dam], .)';
		attribute<dam>    N_Afstand    := = WithPT ? 'N/Distance[value(N_row, N)]' : 'const(0[dam], .)';
		attribute<ct>     V_Prijs      := Result_AfterSecondCondensation/Price_V[Optie_rel];
		attribute<ct>     N_Prijs      := Result_AfterSecondCondensation/Price_N[Optie_rel];
	}
	// The parts of the chain of every public transport option, from the legs of the chain store of the pair.
	unit<uint64> Benen := = WithPT ? '/NetworkSetup/PublicTransport_Prep/OD_Ketens/Read_Benen' : '/NetworkSetup/PublicTransport_Prep/OD_Ketens/Benen_leeg', Descr = "The legs of the chain store of the pair, or without public transport the empty legs, because then there is no chain store.";
	unit<uint64> PT_Delen := join_equal_values_uint64(PT/Keten, Benen/Keten)
	{
		attribute<PT>     PT_rel   := first_rel;
		attribute<Benen>  Been_rel := second_rel;
	}
	attribute<uint32> NrDelen (PT) := pcount_uint32(PT_Delen/PT_rel);
	attribute<bool>   PT_IsWalkingV (PT) := PT/V_Mode == Modes/V/Walking;
	attribute<bool>   PT_IsWalkingN (PT) := PT/N_Mode == Modes/V/Walking;
	unit<uint64> Direct := select_with_org_rel(Opties/IsDirect)
	{
		attribute<Modes> Mode_rel := Result_AfterSecondCondensation/V_mode_rel[org_rel];
	}

	// ONDERDELEN (parts): per option in the order of the journey; a direct trip is one part, a public transport journey the pre-transport, the
	// legs and transfers of the chain and the post-transport.
	unit<uint64> Onderdelen := union_unit_uint64(Direct, PT, PT_Delen, PT)
	{
		attribute<Opties>   Optie_rel   := union_data(., Direct/org_rel, PT/Optie_rel, PT/Optie_rel[PT_Delen/PT_rel], PT/Optie_rel);
		attribute<uint32>   Optie       := Opties/Optie[Optie_rel];
		attribute<uint32>   Volgnr      := union_data(., const(0, Direct, uint32), const(0, PT, uint32), Benen/Volgnr[PT_Delen/Been_rel] + 1, NrDelen + 1);
		attribute<string>   Soort       := union_data(., const('direct', Direct), const('voortransport', PT), Benen/IsOverstap[PT_Delen/Been_rel] ? 'overstap' : 'OV', const('natransport', PT));
		attribute<Modes>    Mode_rel    := union_data(., Direct/Mode_rel, PT/V_Mode, Benen/Mode_rel[PT_Delen/Been_rel], PT/N_Mode);
		attribute<string>   Modaliteit  := Modes/name[Mode_rel];
		attribute<string>   Van         := union_data(., Places/label[Result_AfterSecondCondensation/From_Place_rel[Direct/org_rel]], Places/label[Result_AfterSecondCondensation/From_Place_rel[PT/Optie_rel]], Stops/name[Benen/From_Stop_rel[PT_Delen/Been_rel]], Places/label[PT/N_Stop_Place]);
		attribute<string>   Naar        := union_data(., Places/label[Result_AfterSecondCondensation/To_Place_rel[Direct/org_rel]], Places/label[PT/V_Stop_Place], Stops/name[Benen/To_Stop_rel[PT_Delen/Been_rel]], Places/label[Result_AfterSecondCondensation/To_Place_rel[PT/Optie_rel]]);
		// A public transport leg runs from its departure to its arrival in the timetable (Rit_Vertrek, Rit_Aankomst), not from its begin to its end
		// node: those can include a minute of standstill at boarding or alighting (boarding at 07:52, departure at 07:53).
		attribute<Time>     Vertrek_rel := union_data(., const(inTime[Time], Direct), PT/V_Vertrek, MakeDefined(Rit_Vertrek, Benen/From_Time_rel[PT_Delen/Been_rel]), PT/N_Vertrek);
		attribute<s>        Duur        := union_data(., Result_AfterSecondCondensation/V_time[Direct/org_rel], PT/V_Duur, MakeDefined((Rit_Aankomst - Rit_Vertrek)[s], Benen/Duur[PT_Delen/Been_rel]), PT/N_Duur);
		attribute<Time>     Aankomst_rel := Vertrek_rel + Duur[Time];
		attribute<string>   Vertrek     := Time/Label[Vertrek_rel];
		attribute<string>   Aankomst    := Time/Label[Aankomst_rel];
		attribute<min_f>    Minuten     := convert(Duur, min_f);
		attribute<dam>      Afstand     := union_data(., Result_AfterSecondCondensation/TravelDist_V[Direct/org_rel], PT/V_Afstand, Benen/Afstand[PT_Delen/Been_rel], PT/N_Afstand);
		attribute<Euro>     Prijs       := convert(union_data(., Result_AfterSecondCondensation/Price[Direct/org_rel], PT/V_Prijs, Benen/Prijs[PT_Delen/Been_rel], PT/N_Prijs), Euro);
		attribute<string>   Lijn        := union_data(., const('', Direct), const('', PT), MakeDefined(Routes/route_short_name[Benen/Route_rel[PT_Delen/Been_rel]], ''), const('', PT));
		attribute<string>   Vervoerder  := union_data(., const('', Direct), const('', PT), MakeDefined(Agencies/name[Benen/Agency_rel[PT_Delen/Been_rel]], ''), const('', PT));
		attribute<string>   label       := string(Optie) + '.' + string(Volgnr) + ' ' + Soort + ' ' + Modaliteit + ' ' + Lijn + ': ' + Van + ' ' + Vertrek + ' -> ' + Naar + ' ' + Aankomst;
	}

	// LINKS
	// Pre-transport and post-transport: the links of the leg from the leg store of its base type, joined on the stop.
	Template LegLinks_T
	{
		parameter<string> BaseType;
		parameter<bool>   IsPre;
		parameter<bool>   IsWalking;
		///
		unit<uint32> Src := ='/NetworkSetup/PublicTransport_Prep/LegStores/' + BaseType + '/Links/links';
		attribute<Stops> Stop_rel (Src) := rlookup(Src/stop_id, /SourceData/Infrastructure/GTFS/PublicTransportNet/Stops/stop_id);
		attribute<Stops> PT_Stop  (PT)  := Places/Stop_rel[IsPre ? PT/V_Stop_Place : PT/N_Stop_Place];
		attribute<bool>  PT_Mee   (PT)  := (IsPre ? PT/V_Mode : PT/N_Mode) == (IsWalking ? Modes/V/Walking : Modes/V/Cycling);
		unit<uint64> Rows := join_equal_values_uint64(PT_Stop, Stop_rel)
		{
			attribute<PT>     PT_rel  := first_rel;
			attribute<Src>    Src_rel := second_rel;
			attribute<bool>   IsMee   := PT_Mee[PT_rel];
		}
		unit<uint64> Sel := select_with_org_rel(Rows/IsMee)
		{
			attribute<Opties> Optie_rel  := PT/Optie_rel[Rows/PT_rel[org_rel]];
			attribute<uint32> Onderdeel  := IsPre ? const(0, ., uint32) : NrDelen[Rows/PT_rel[org_rel]] + 1;
			attribute<uint32> Volgnr     := Src/Volgnr[Rows/Src_rel[org_rel]];
			attribute<Modes>  Mode_rel   := const(IsWalking ? Modes/V/Walking : Modes/V/Cycling, .);
			attribute<rdc>    geometry (arc) := Src/geometry[Rows/Src_rel[org_rel]];
		}
	}
	container V_Lopen  := LegLinks_T('Org2Stops_Walking',  TRUE,  TRUE);
	container V_Fietsen := LegLinks_T('Org2Stops_Cycling', TRUE,  FALSE);
	container N_Lopen  := LegLinks_T('Stops2Dest_Walking', FALSE, TRUE);
	container N_Fietsen := LegLinks_T('Stops2Dest_Cycling', FALSE, FALSE);

	// A public transport leg: the links within the trip, from a search in its network between the begin and end node of the leg.
	Template PTLinks_T
	{
		parameter<string> Letter;
		///
		unit<uint32>   Set      := ='/NetworkSetup/PublicTransport_Prep/impl/Set_' + Letter + '/Set';
		parameter<bool> IsPareto := ='/ModelParameters/Advanced/ParetoLegs_' + Letter;
		attribute<bool> IsMee (PT_Delen) := !Benen/IsOverstap[PT_Delen/Been_rel] && Benen/IsL[PT_Delen/Been_rel] == (Letter == 'L');
		unit<uint32>   Delen    := select_uint32(IsMee), Descr = "A uint32 domain, because the start and end points of impedance_matrix need one."
		{
			attribute<PT_Delen>    org_rel := collect_by_cond(., IsMee, id(PT_Delen));
			attribute<Set/NodeSet> Begin := value(Benen/BeginKnoop[PT_Delen/Been_rel[org_rel]], Set/NodeSet);
			attribute<Set/NodeSet> Eind  := value(Benen/EindKnoop[PT_Delen/Been_rel[org_rel]], Set/NodeSet);
		}
		unit<uint64> od := ='impedance_matrix_od64(''directed;startPoint(Node_rel);endPoint(Node_rel);od:impedance,OrgZone_rel,DstZone_rel,LinkSet'', Set/' + (IsPareto ? 'Length' : 'Duration') + ', Set/F1, Set/F2, Delen/Begin, Delen/Eind)';
		unit<uint64> Eigen := select_with_org_rel(od/OrgZone_rel == od/DstZone_rel), Descr = "The rows of the search from the begin node of each leg to its own end node.";
		attribute<uint32> LinkSet (arc, Eigen) := od/LinkSet[Eigen/org_rel];
		container R := /Templates/RouteLinks_T(Eigen, LinkSet, Set, Set/NodeSet, Set/F1, Set/F2, Set/NodeSet/geometry, Delen/Eind[od/DstZone_rel[Eigen/org_rel]]);
		unit<uint32> Rows := R/Rows
		{
			attribute<Delen>    Delen_rel := od/DstZone_rel[Eigen/org_rel[R/Rows/Route_rel]];
			attribute<PT_Delen> Deel_rel  := Delen/org_rel[Delen_rel];
			attribute<Opties>   Optie_rel := PT/Optie_rel[PT_Delen/PT_rel[Deel_rel]];
			attribute<uint32>   Onderdeel := Benen/Volgnr[PT_Delen/Been_rel[Deel_rel]] + 1;
			attribute<uint32>   Volgnr    := R/Rows/Volgnr;
			attribute<Modes>    Mode_rel  := Benen/Mode_rel[PT_Delen/Been_rel[Deel_rel]];
			attribute<rdc>      geometry (arc) := Set/geometry[R/Rows/Link_rel];
		}
		// The timetable times of the leg: the departure of its first and the arrival of its last scheduled link. The begin and end node can be the
		// arrival and departure node of a stop where the trip stands still (boarding at arrival, alighting at departure), so that their times can
		// include a minute of standstill. Within a trip the times increase (Time covers 48 hours, without wrap-around), so the first departure is
		// the smallest and the last arrival the largest.
		unit<uint32> Gepland := select_with_org_rel(Set/LinkType_rel[R/Rows/Link_rel] == /Classifications/LinkTypes/V/Scheduled)
		{
			attribute<Delen> Delen_rel := Rows/Delen_rel[org_rel];
		}
		attribute<Time> Vertrek  (Delen) := min(Set/From_Time_rel[R/Rows/Link_rel[Gepland/org_rel]], Gepland/Delen_rel);
		attribute<Time> Aankomst (Delen) := max(Set/To_Time_rel[R/Rows/Link_rel[Gepland/org_rel]], Gepland/Delen_rel);
	}
	container PT_L := PTLinks_T('L');
	container PT_R := PTLinks_T('R');
	// The timetable times of every public transport leg (a transfer has none), for Onderdelen; without public transport nothing, so that a run
	// without public transport does not request Set_L and Set_R.
	attribute<Time> Rit_Vertrek  (PT_Delen) := = WithPT ? 'MakeDefined(PT_L/Vertrek[invert(PT_L/Delen/org_rel)], PT_R/Vertrek[invert(PT_R/Delen/org_rel)])' : 'const(value(null_u, Time), PT_Delen)';
	attribute<Time> Rit_Aankomst (PT_Delen) := = WithPT ? 'MakeDefined(PT_L/Aankomst[invert(PT_L/Delen/org_rel)], PT_R/Aankomst[invert(PT_R/Delen/org_rel)])' : 'const(value(null_u, Time), PT_Delen)';

	// A transfer: the straight walking line.
	unit<uint64> Overstappen := select_with_org_rel(Benen/IsOverstap[PT_Delen/Been_rel])
	{
		attribute<Opties> Optie_rel := PT/Optie_rel[PT_Delen/PT_rel[org_rel]];
		attribute<uint32> Onderdeel := Benen/Volgnr[PT_Delen/Been_rel[org_rel]] + 1;
		attribute<rdc>    Van       := Stops/geometry[Benen/From_Stop_rel[PT_Delen/Been_rel[org_rel]]];
		attribute<rdc>    Naar      := Stops/geometry[Benen/To_Stop_rel[PT_Delen/Been_rel[org_rel]]];
		attribute<rdc>    geometry (arc) := points2sequence(Punten/Point, Punten/Rij_rel, Punten/Ordinal);
		unit<uint64> Punten := union_unit_uint64(., .)
		{
			attribute<..>     Rij_rel := union_data(., id(..), id(..));
			attribute<rdc>    Point   := union_data(., ../Van, ../Naar);
			attribute<uint32> Ordinal := union_data(., const(0, .., uint32), const(1, .., uint32));
		}
	}

	// The direct walking and cycling trip: the links of the search of the OD pair, for every direct option of that mode (there is one route).
	Template DirectLinks_T
	{
		parameter<string> Modaliteit;
		///
		container C := ='/NetworkSetup/PrivateTransport/' + Modaliteit + '/Calc_Traveltimes_maxspeed_' + Modaliteit + '/Links';
		attribute<uint32> Sleutel_D (Direct) := Direct/Mode_rel == (Modaliteit == 'Walking' ? Modes/V/Walking : Modes/V/Cycling) ? 0u : null_u;
		attribute<uint32> Sleutel_L (C/Rows) := const(0u, C/Rows);
		unit<uint64> Rows := join_equal_values_uint64(Sleutel_D, Sleutel_L)
		{
			attribute<Opties> Optie_rel := Direct/org_rel[first_rel];
			attribute<uint32> Onderdeel := const(0, ., uint32);
			attribute<uint32> Volgnr    := C/Rows/Volgnr[second_rel];
			attribute<Modes>  Mode_rel  := Direct/Mode_rel[first_rel];
			attribute<rdc>    geometry (arc) := C/Rows/geometry[second_rel];
		}
	}
	container D_Lopen   := DirectLinks_T('Walking');
	container D_Fietsen := DirectLinks_T('Cycling');

	// The direct car trip of this departure moment (CarTD): the links of its route from the car store of the moment (Read_CarLinks), joined on
	// the row of the store: option -> Direct_OD_M -> DirectCar_M = DirectCar/Front -> CarRows -> row of the store.
	unit<uint64> AutoOpties := = CarTD ? 'select_with_org_rel(Opties/IsDirect && Direct_OD_M/IsCarTD[value(Opties/Bron_rel, Direct_OD_M)])' : 'range(uint64, 0u64, 0u64)'
	{
		attribute<Opties> Optie_rel := = CarTD ? 'org_rel' : 'const(value(null_u, Opties), .)';
		attribute<uint32> StoreRij  := = CarTD ? 'uint32(CarRows/Store_rel[DirectCar/Front/org_rel[value(Direct_OD_M/Bron_rel[value(Opties/Bron_rel[Optie_rel], Direct_OD_M)], DirectCar/Front)]])' : 'const(0, ., uint32)';
	}
	unit<uint32> AutoLinks_Src := = CarTD ? '/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links' : 'range(uint32, 0, 0)'
	{
		attribute<uint32> Route  := = CarTD ? '/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/Route' : 'const(0, ., uint32)';
	}
	unit<uint64> A_Auto := join_equal_values_uint64(AutoOpties/StoreRij, AutoLinks_Src/Route)
	{
		attribute<Opties> Optie_rel := AutoOpties/Optie_rel[first_rel];
		attribute<uint32> Onderdeel := const(0, ., uint32);
		attribute<uint32> Volgnr    := ='/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/Volgnr[second_rel]';
		attribute<Modes>  Mode_rel  := const(Modes/V/Car, .);
		attribute<rdc>    geometry (arc) := ='/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/geometry[second_rel]';
	}

	// The parts of Links that this run has: public transport with WithPT, the direct trips of the allowed modes, and pre-transport and
	// post-transport of the types of the component (the others give no rows, but this way the run does not read their store).
	unit<uint8> LinkDelen : nrofrows = 10
	{
		attribute<string> name  : ['V_Lopen/Sel', 'V_Fietsen/Sel', 'PT_L/Rows', 'PT_R/Rows', 'Overstappen', 'N_Lopen/Sel', 'N_Fietsen/Sel', 'D_Lopen/Rows', 'D_Fietsen/Rows', 'A_Auto'];
		attribute<bool>   IsMee := union_data(., WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PreTransport, 'Walking')), WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PreTransport, 'Cycling')), WithPT, WithPT, WithPT, WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PostTransport, 'Walking')), WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PostTransport, 'Cycling')), /ModelParameters/Impl/AllowDirectWalking, /ModelParameters/Impl/AllowDirectCycling, CarTD);
		attribute<string> Volgnr := name == 'Overstappen' ? 'const(0, Overstappen, uint32)' : name + '/Volgnr';
		attribute<string> Mode   := name == 'Overstappen' ? 'const(Modes/V/Walking, Overstappen)' : name + '/Mode_rel';
	}
	unit<uint8> LinkDelen_Mee := select_with_attr_by_cond(LinkDelen, LinkDelen/IsMee);

	unit<uint64> Links := ='union_unit_uint64(' + asList(LinkDelen_Mee/name, ', ') + ')'
	{
		attribute<Opties> Optie_rel := ='union_data(., ' + asList(LinkDelen_Mee/name + '/Optie_rel', ', ') + ')';
		attribute<uint32> Optie     := Opties/Optie[Optie_rel];
		attribute<uint32> Onderdeel := ='union_data(., ' + asList(LinkDelen_Mee/name + '/Onderdeel', ', ') + ')';
		attribute<uint32> Volgnr    := ='union_data(., ' + asList(LinkDelen_Mee/Volgnr, ', ') + ')';
		attribute<Modes>  Mode_rel  := ='union_data(., ' + asList(LinkDelen_Mee/Mode, ', ') + ')';
		attribute<string> Modaliteit := Modes/name[Mode_rel];
		attribute<rdc>    geometry (arc) := ='union_data(., ' + asList(LinkDelen_Mee/name + '/geometry', ', ') + ')';
	}

	parameter<string> FileName := fileNamePrefix + 'od_' + inTime_str_short + '.gpkg';
	container Write_gpkg : StorageName = "=FileName", StorageType = "gdalwrite.vect"
	{
		unit<uint64> od_opties := Opties, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
		{
			attribute<uint32> Optie      := Opties/Optie;
			attribute<string> OrgName    := Result_AfterSecondCondensation/OrgName;
			attribute<string> DestName   := Result_AfterSecondCondensation/DestName;
			attribute<string> Component  := const(/ModelParameters/Impl/ComponentName, .);
			attribute<string> Vertrek    := Opties/Vertrek;
			attribute<float32> Reistijd  := float32(Opties/Reistijd);
			attribute<float32> Prijs     := float32(Opties/Prijs);
			attribute<string> ModeUsed   := Opties/ModeUsed;
		}
		unit<uint64> od_onderdelen := Onderdelen
		{
			attribute<uint32>  Optie      := Onderdelen/Optie;
			attribute<uint32>  Volgnr     := Onderdelen/Volgnr;
			attribute<string>  Soort      := Onderdelen/Soort;
			attribute<string>  Modaliteit := Onderdelen/Modaliteit;
			attribute<string>  Lijn       := Onderdelen/Lijn;
			attribute<string>  Vervoerder := Onderdelen/Vervoerder;
			attribute<string>  Van        := Onderdelen/Van;
			attribute<string>  Naar       := Onderdelen/Naar;
			attribute<string>  Vertrek    := Onderdelen/Vertrek;
			attribute<string>  Aankomst   := Onderdelen/Aankomst;
			attribute<float32> Minuten    := float32(Onderdelen/Minuten);
			attribute<uint32>  Afstand_m  := uint32(convert(Onderdelen/Afstand, m));
			attribute<float32> Prijs      := float32(Onderdelen/Prijs);
		}
		unit<uint64> od_links := Links
		{
			attribute<uint32>  Optie      := Links/Optie;
			attribute<uint32>  Onderdeel  := Links/Onderdeel;
			attribute<uint32>  Volgnr     := Links/Volgnr;
			attribute<string>  Modaliteit := Links/Modaliteit;
			attribute<rdc>     geometry (arc) := Links/geometry;
		}
	}
	parameter<string> Write := 'Ready', ExplicitSuppliers = "Write_gpkg/od_opties;Write_gpkg/od_onderdelen;Write_gpkg/od_links";
}
