// THE OPTIONS OF AN OD PAIR WITH THEIR PARTS AND LINKS (#129; only in the OD pair mode, ModelParameters/Impl/IsOD).
// Per departure moment the options of the front (Result_AfterSecondCondensation), each traced back to the row of AllOptions it comes
// from: a public transport journey (pre-transport leg, chain, post-transport leg) of a public transport component, or the direct trip
// of a direct component. Parts describes each option in the
// order of the journey; Links gives each part its links, with one line per link:
// - pre-transport and post-transport: the links of the leg from its base set (PublicTransport_Prep/PrePostTransport/<base set>/Links);
// - a public transport leg: the stop-to-stop links within the trip, from a search in Set_L or Set_R between the begin and end node of the leg
//   (OD_Chains/Read_ChainLegs), which on the time-expanded network gives the same path as the leg (every path between two nodes takes equally
//   long, and with ParetoLegs the choice at equal time is the shortest, Length);
// - a transfer: the straight walking line between the stops;
// - the direct walking and cycling trip: the links of the search (PrivateTransport/<mode>/Calc_Traveltimes_maxspeed_<mode>/Links);
// - the direct car trip of the moment: the links of its route from the car cache of the moment (see CarOptions).
// Write writes them as three layers of <OutputDir>/PerBlock/od_<moment>.gpkg (od_opties, od_onderdelen and od_links; GeoDMS names are
// case-insensitive, so a layer opties := Options would refer to itself), in the request of the output (Results_Traveltime/Generate).
container OD_Output : Descr = "The options of the OD pair per departure moment with their parts and links, written as three layers of a gpkg (only in the OD pair mode, #129)."
{
	unit<uint64> Options := Result_AfterSecondCondensation
	{
		attribute<uint32> Option         := uint32(id(.)) + 1, Descr = "The number of the option of this departure moment, from 1.";
		attribute<AllOptions> AllOptions_rel := Result_AfterFirstCondensation/AllOptions_rel[Result_AfterSecondCondensation/First_rel];
		attribute<string> Departure      := const(Time/Label[inTime[Time]], .);
		attribute<min_f>  Traveltime_min := convert(Result_AfterSecondCondensation/Traveltime, min_f);
		attribute<Euro>   Price_euro     := convert(Result_AfterSecondCondensation/Price, Euro);
		attribute<string> ModeUsed       := Result_AfterSecondCondensation/ModeUsed;
		attribute<string> label          := string(Option) + ' ' + Departure + ' ' + ModeUsed + ' ' + string(Traveltime_min) + ' min ' + string(Price_euro) + ' euro';
	}

	// THE PUBLIC TRANSPORT OPTIONS: each traced back through the final front to the chain in the chain cache of the pair. Without
	// WithPT there are none, and nothing below refers to Add_N_to_VPT.
	unit<uint64> PT := select_with_org_rel(const(WithPT, Options))
	{
		attribute<Options> Option_rel   := org_rel;
		attribute<uint64>  VPTN_Res     := uint64(Options/AllOptions_rel[Option_rel]), Descr = "The row of Add_N_to_VPT/Result.";
		attribute<uint64>  VPTN         := = WithPT ? 'uint64(Add_N_to_VPT/Result/VPTN_rel[value(VPTN_Res, Add_N_to_VPT/Result)])' : 'const(0u64, .)';
		attribute<uint64>  N_row        := = WithPT ? 'uint64(Add_N_to_VPT/N_rel[value(VPTN, Add_N_to_VPT)])' : 'const(0u64, .)';
		attribute<uint64>  VPT_Res      := = WithPT ? 'uint64(Add_N_to_VPT/PT_rel[value(VPTN, Add_N_to_VPT)])' : 'const(0u64, .)';
		attribute<uint64>  VPT          := = WithPT ? 'uint64(Add_V_to_PT/Result/VPT_rel[value(VPT_Res, Add_V_to_PT/Result)])' : 'const(0u64, .)';
		attribute<uint64>  V_row        := = WithPT ? 'uint64(Add_V_to_PT/V_rel[value(VPT, Add_V_to_PT)])' : 'const(0u64, .)';
		attribute<uint64>  W_row        := = WithPT ? 'uint64(Add_V_to_PT/PT_rel[value(VPT, Add_V_to_PT)])' : 'const(0u64, .)';
		attribute<uint64>  ChainRow     := = WithPT ? '/NetworkSetup/PublicTransport_Prep/PT_V/ChainRow[PT_InBlock/PT_V_rel[Within_VW_Window/PT_InBlock_rel[value(W_row, Within_VW_Window)]]]' : 'const(0u64, .)'
		,	Descr = "The row number of the chain in the chain cache of the pair, as OD_Chains/Read_ChainLegs/Keten.";
		attribute<Places>  V_Stop_Place := = WithPT ? 'V/To_Place_rel[value(V_row, V)]' : 'const(value(null_u, Places), .)';
		attribute<Places>  N_Stop_Place := = WithPT ? 'N/From_Place_rel[value(N_row, N)]' : 'const(value(null_u, Places), .)';
		attribute<Modes>   V_Mode       := = WithPT ? 'V/Mode_rel[value(V_row, V)]' : 'const(value(null_b, Modes), .)';
		attribute<Modes>   N_Mode       := = WithPT ? 'N/Mode_rel[value(N_row, N)]' : 'const(value(null_b, Modes), .)';
		attribute<Time>    V_Departure  := = WithPT ? 'Add_V_to_PT/V_From_Time_rel[value(VPT, Add_V_to_PT)]' : 'const(value(null_u, Time), .)';
		attribute<s>       V_Duration   := = WithPT ? 'Add_V_to_PT/V_time[value(VPT, Add_V_to_PT)]' : 'const(0[s], .)';
		attribute<Time>    N_Departure  := = WithPT ? 'Add_N_to_VPT/PT_To_Time_rel[value(VPTN, Add_N_to_VPT)]' : 'const(value(null_u, Time), .)';
		attribute<s>       N_Duration   := = WithPT ? 'Add_N_to_VPT/N_time[value(VPTN, Add_N_to_VPT)]' : 'const(0[s], .)';
		attribute<dam>     V_Distance   := = WithPT ? 'V/Distance[value(V_row, V)]' : 'const(0[dam], .)';
		attribute<dam>     N_Distance   := = WithPT ? 'N/Distance[value(N_row, N)]' : 'const(0[dam], .)';
		attribute<ct>      V_price      := Result_AfterSecondCondensation/Price_V[Option_rel];
		attribute<ct>      N_price      := Result_AfterSecondCondensation/Price_N[Option_rel];
	}
	// The parts of the chain of every public transport option, from the legs of the chain cache of the pair.
	unit<uint64>      ChainLegs                 := = WithPT ? '/NetworkSetup/PublicTransport_Prep/OD_Chains/Read_ChainLegs' : '/NetworkSetup/PublicTransport_Prep/OD_Chains/ChainLegs_Empty', Descr = "The legs of the chain cache of the pair, or without public transport the empty legs, because then there is no chain cache.";
	unit<uint64> PT_Parts := join_equal_values_uint64(PT/ChainRow, ChainLegs/Keten)
	{
		attribute<PT>        PT_rel       := first_rel;
		attribute<ChainLegs> ChainLeg_rel := second_rel;
	}
	attribute<uint32> NrParts              (PT) := pcount_uint32(PT_Parts/PT_rel);
	attribute<bool>   PT_IsWalkingV        (PT) := PT/V_Mode == Modes/V/Walking;
	attribute<bool>   PT_IsWalkingN        (PT) := PT/N_Mode == Modes/V/Walking;
	unit<uint64> Direct := select_with_org_rel(const(!WithPT, Options))
	{
		attribute<Modes> Mode_rel := Result_AfterSecondCondensation/V_mode_rel[org_rel];
	}

	// PARTS: per option in the order of the journey; a direct trip is one part, a public transport journey the pre-transport, the
	// legs and transfers of the chain and the post-transport.
	unit<uint64> Parts := union_unit_uint64(Direct, PT, PT_Parts, PT)
	{
		attribute<Options> Option_rel    := union_data(., Direct/org_rel, PT/Option_rel, PT/Option_rel[PT_Parts/PT_rel], PT/Option_rel);
		attribute<uint32>  Option        := Options/Option[Option_rel];
		attribute<uint32>  Volgnr        := union_data(., const(0, Direct, uint32), const(0, PT, uint32), ChainLegs/Volgnr[PT_Parts/ChainLeg_rel] + 1, NrParts + 1);
		attribute<string>  PartKind      := union_data(., const('direct', Direct), const('voortransport', PT), ChainLegs/IsOverstap[PT_Parts/ChainLeg_rel] ? 'overstap' : 'OV', const('natransport', PT));
		attribute<Modes>   Mode_rel      := union_data(., Direct/Mode_rel, PT/V_Mode, ChainLegs/Mode_rel[PT_Parts/ChainLeg_rel], PT/N_Mode);
		attribute<string>  ModeName      := Modes/name[Mode_rel];
		attribute<string>  FromName      := union_data(., Places/label[Result_AfterSecondCondensation/From_Place_rel[Direct/org_rel]], Places/label[Result_AfterSecondCondensation/From_Place_rel[PT/Option_rel]], Stops/name[ChainLegs/From_Stop_rel[PT_Parts/ChainLeg_rel]], Places/label[PT/N_Stop_Place]);
		attribute<string>  ToName        := union_data(., Places/label[Result_AfterSecondCondensation/To_Place_rel[Direct/org_rel]], Places/label[PT/V_Stop_Place], Stops/name[ChainLegs/To_Stop_rel[PT_Parts/ChainLeg_rel]], Places/label[Result_AfterSecondCondensation/To_Place_rel[PT/Option_rel]]);
		// A public transport leg runs from its departure to its arrival in the timetable (Trip_Departure, Trip_Arrival), not from its begin to its end
		// node: those can include a minute of standstill at boarding or alighting (boarding at 07:52, departure at 07:53).
		attribute<Time>    Departure_rel := union_data(., const(inTime[Time], Direct), PT/V_Departure, MakeDefined(Trip_Departure, ChainLegs/From_Time_rel[PT_Parts/ChainLeg_rel]), PT/N_Departure);
		attribute<s>       Duration      := union_data(., Result_AfterSecondCondensation/V_time[Direct/org_rel], PT/V_Duration, MakeDefined((Trip_Arrival - Trip_Departure)[s], ChainLegs/Duur[PT_Parts/ChainLeg_rel]), PT/N_Duration);
		attribute<Time>    Arrival_rel   := Departure_rel + Duration[Time];
		attribute<string>  Departure     := Time/Label[Departure_rel];
		attribute<string>  Arrival       := Time/Label[Arrival_rel];
		attribute<min_f>   Minutes       := convert(Duration, min_f);
		attribute<dam>     Distance      := union_data(., Result_AfterSecondCondensation/TravelDist_V[Direct/org_rel], PT/V_Distance, ChainLegs/Afstand[PT_Parts/ChainLeg_rel], PT/N_Distance);
		attribute<Euro>    Price_euro    := convert(union_data(., Result_AfterSecondCondensation/Price[Direct/org_rel], PT/V_price, ChainLegs/Prijs[PT_Parts/ChainLeg_rel], PT/N_price), Euro);
		attribute<string>  LineName      := union_data(., const('', Direct), const('', PT), MakeDefined(Routes/route_short_name[ChainLegs/Route_rel[PT_Parts/ChainLeg_rel]], ''), const('', PT));
		attribute<string>  AgencyName    := union_data(., const('', Direct), const('', PT), MakeDefined(Agencies/name[ChainLegs/Agency_rel[PT_Parts/ChainLeg_rel]], ''), const('', PT));
		attribute<string>  label         := string(Option) + '.' + string(Volgnr) + ' ' + PartKind + ' ' + ModeName + ' ' + LineName + ': ' + FromName + ' ' + Departure + ' -> ' + ToName + ' ' + Arrival;
	}

	// LINKS
	// Pre-transport and post-transport: the links of the leg from its base set (PrePostTransport), joined on the stop.
	Template LegLinks_T
	{
		parameter<string> BaseType;
		parameter<bool>   IsPre;
		parameter<bool>   IsWalking;
		///
		unit<uint32>     Src            := ='/NetworkSetup/PublicTransport_Prep/PrePostTransport/' + BaseType + '/Links/links';
		attribute<Stops> Stop_rel (Src) := rlookup(Src/stop_id, /SourceData/Infrastructure/GTFS/PublicTransportNet/Stops/stop_id);
		attribute<Stops> PT_Stop   (PT) := Places/Stop_rel[IsPre ? PT/V_Stop_Place : PT/N_Stop_Place];
		attribute<bool>  PT_Used   (PT) := (IsPre ? PT/V_Mode : PT/N_Mode) == (IsWalking ? Modes/V/Walking : Modes/V/Cycling);
		unit<uint64> Rows := join_equal_values_uint64(PT_Stop, Stop_rel)
		{
			attribute<PT>   PT_rel  := first_rel;
			attribute<Src>  Src_rel := second_rel;
			attribute<bool> IsUsed  := PT_Used[PT_rel];
		}
		unit<uint64> Sel := select_with_org_rel(Rows/IsUsed)
		{
			attribute<Options> Option_rel     := PT/Option_rel[Rows/PT_rel[org_rel]];
			attribute<uint32>  Part           := IsPre ? const(0, ., uint32) : NrParts[Rows/PT_rel[org_rel]] + 1;
			attribute<uint32>  Volgnr         := Src/Volgnr[Rows/Src_rel[org_rel]];
			attribute<Modes>   Mode_rel       := const(IsWalking ? Modes/V/Walking : Modes/V/Cycling, .);
			attribute<rdc>     geometry (arc) := Src/geometry[Rows/Src_rel[org_rel]];
		}
	}
	container         V_Walking                 := LegLinks_T('Org2Stops_Walking',  TRUE,  TRUE);
	container         V_Cycling                 := LegLinks_T('Org2Stops_Cycling', TRUE,  FALSE);
	container         N_Walking                 := LegLinks_T('Stops2Dest_Walking', FALSE, TRUE);
	container         N_Cycling                 := LegLinks_T('Stops2Dest_Cycling', FALSE, FALSE);

	// A public transport leg: the links within the trip, from a search in its network between the begin and end node of the leg.
	Template PTLinks_T
	{
		parameter<string> Letter;
		///
		unit<uint32>      Set                    := ='/NetworkSetup/PublicTransport_Prep/impl/Set_' + Letter + '/Set';
		parameter<bool>   IsPareto               := ='/ModelParameters/Advanced/ParetoLegs_' + Letter;
		attribute<bool>   IsUsed      (PT_Parts) := !ChainLegs/IsOverstap[PT_Parts/ChainLeg_rel] && ChainLegs/IsL[PT_Parts/ChainLeg_rel] == (Letter == 'L');
		unit<uint32> LegParts := select_uint32(IsUsed), Descr = "A uint32 domain, because the start and end points of impedance_matrix need one."
		{
			attribute<PT_Parts>    org_rel  := collect_by_cond(., IsUsed, id(PT_Parts));
			attribute<Set/NodeSet> FromNode := value(ChainLegs/BeginKnoop[PT_Parts/ChainLeg_rel[org_rel]], Set/NodeSet);
			attribute<Set/NodeSet> ToNode   := value(ChainLegs/EindKnoop[PT_Parts/ChainLeg_rel[org_rel]], Set/NodeSet);
		}
		unit<uint64>      od                     := ='impedance_matrix_od64(''directed;startPoint(Node_rel);endPoint(Node_rel);od:impedance,OrgZone_rel,DstZone_rel,LinkSet'', Set/' + (IsPareto ? 'Length' : 'Duration') + ', Set/F1, Set/F2, LegParts/FromNode, LegParts/ToNode)';
		unit<uint64>      OwnRows                := select_with_org_rel(od/OrgZone_rel == od/DstZone_rel), Descr = "The rows of the search from the begin node of each leg to its own end node.";
		attribute<uint32> LinkSet (arc, OwnRows) := od/LinkSet[OwnRows/org_rel];
		container         R                      := /Templates/RouteLinks_T(OwnRows, LinkSet, Set, Set/NodeSet, Set/F1, Set/F2, Set/NodeSet/geometry, LegParts/ToNode[od/DstZone_rel[OwnRows/org_rel]]);
		unit<uint32> Rows := R/Rows
		{
			attribute<LegParts> LegParts_rel   := od/DstZone_rel[OwnRows/org_rel[R/Rows/Route_rel]];
			attribute<PT_Parts> PT_Part_rel    := LegParts/org_rel[LegParts_rel];
			attribute<Options>  Option_rel     := PT/Option_rel[PT_Parts/PT_rel[PT_Part_rel]];
			attribute<uint32>   Part           := ChainLegs/Volgnr[PT_Parts/ChainLeg_rel[PT_Part_rel]] + 1;
			attribute<uint32>   Volgnr         := R/Rows/Volgnr;
			attribute<Modes>    Mode_rel       := ChainLegs/Mode_rel[PT_Parts/ChainLeg_rel[PT_Part_rel]];
			attribute<rdc>      geometry (arc) := Set/geometry[R/Rows/Link_rel];
		}
		// The timetable times of the leg: the departure of its first and the arrival of its last scheduled link. The begin and end node can be the
		// arrival and departure node of a stop where the trip stands still (boarding at arrival, alighting at departure), so that their times can
		// include a minute of standstill. Within a trip the times increase (Time covers 48 hours, without wrap-around), so the first departure is
		// the smallest and the last arrival the largest.
		unit<uint32> ScheduledRows := select_with_org_rel(Set/LinkType_rel[R/Rows/Link_rel] == /Classifications/LinkTypes/V/Scheduled)
		{
			attribute<LegParts> LegParts_rel := Rows/LegParts_rel[org_rel];
		}
		attribute<Time>   Departure   (LegParts) := min(Set/From_Time_rel[R/Rows/Link_rel[ScheduledRows/org_rel]], ScheduledRows/LegParts_rel);
		attribute<Time>   Arrival     (LegParts) := max(Set/To_Time_rel[R/Rows/Link_rel[ScheduledRows/org_rel]], ScheduledRows/LegParts_rel);
	}
	container         PT_L                      := PTLinks_T('L');
	container         PT_R                      := PTLinks_T('R');
	// The timetable times of every public transport leg (a transfer has none), for Parts; without public transport nothing, so that a run
	// without public transport does not request Set_L and Set_R.
	attribute<Time>   Trip_Departure (PT_Parts) := = WithPT ? 'MakeDefined(PT_L/Departure[invert(PT_L/LegParts/org_rel)], PT_R/Departure[invert(PT_R/LegParts/org_rel)])' : 'const(value(null_u, Time), PT_Parts)';
	attribute<Time>   Trip_Arrival   (PT_Parts) := = WithPT ? 'MakeDefined(PT_L/Arrival[invert(PT_L/LegParts/org_rel)], PT_R/Arrival[invert(PT_R/LegParts/org_rel)])' : 'const(value(null_u, Time), PT_Parts)';

	// A transfer: the straight walking line.
	unit<uint64> TransferLinks := select_with_org_rel(ChainLegs/IsOverstap[PT_Parts/ChainLeg_rel])
	{
		attribute<Options> Option_rel     := PT/Option_rel[PT_Parts/PT_rel[org_rel]];
		attribute<uint32>  Part           := ChainLegs/Volgnr[PT_Parts/ChainLeg_rel[org_rel]] + 1;
		attribute<rdc>     FromPoint      := Stops/geometry[ChainLegs/From_Stop_rel[PT_Parts/ChainLeg_rel[org_rel]]];
		attribute<rdc>     ToPoint        := Stops/geometry[ChainLegs/To_Stop_rel[PT_Parts/ChainLeg_rel[org_rel]]];
		attribute<rdc>     geometry (arc) := points2sequence(LinePoints/Point, LinePoints/Row_rel, LinePoints/Ordinal);
		unit<uint64> LinePoints := union_unit_uint64(., .)
		{
			attribute<..>     Row_rel := union_data(., id(..), id(..));
			attribute<rdc>    Point   := union_data(., ../FromPoint, ../ToPoint);
			attribute<uint32> Ordinal := union_data(., const(0, .., uint32), const(1, .., uint32));
		}
	}

	// The direct walking and cycling trip: the links of the search of the OD pair, for every direct option of that mode (there is one route).
	Template DirectLinks_T
	{
		parameter<string> ModeName;
		///
		container         C              := ='/NetworkSetup/PrivateTransport/' + ModeName + '/Calc_Traveltimes_maxspeed_' + ModeName + '/Links';
		attribute<uint32> Key_D (Direct) := Direct/Mode_rel == (ModeName == 'Walking' ? Modes/V/Walking : Modes/V/Cycling) ? 0u : null_u;
		attribute<uint32> Key_L (C/Rows) := const(0u, C/Rows);
		unit<uint64> Rows := join_equal_values_uint64(Key_D, Key_L)
		{
			attribute<Options> Option_rel     := Direct/org_rel[first_rel];
			attribute<uint32>  Part           := const(0, ., uint32);
			attribute<uint32>  Volgnr         := C/Rows/Volgnr[second_rel];
			attribute<Modes>   Mode_rel       := Direct/Mode_rel[first_rel];
			attribute<rdc>     geometry (arc) := C/Rows/geometry[second_rel];
		}
	}
	container         D_Walking                 := DirectLinks_T('Walking');
	container         D_Cycling                 := DirectLinks_T('Cycling');

	// The direct car trip of this departure moment (CarTD): the links of its route from the car cache of the moment (Read_CarLinks), joined on
	// the row of the cache: option -> AllOptions = DirectCar_M = DirectCar/Front -> CarRows -> row of the cache.
	unit<uint64> CarOptions := select_with_org_rel(const(CarTD, Options))
	{
		attribute<Options> Option_rel := org_rel;
		attribute<uint32>  CacheRow   := = CarTD ? 'uint32(CarRows/Cache_rel[DirectCar/Front/org_rel[Options/AllOptions_rel[Option_rel]]])' : 'const(0, ., uint32)';
	}
	unit<uint32> CarLinks_Src := = CarTD ? '/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links' : 'range(uint32, 0, 0)'
	{
		attribute<uint32> Route := = CarTD ? '/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/Route' : 'const(0, ., uint32)';
	}
	unit<uint64> A_Car := join_equal_values_uint64(CarOptions/CacheRow, CarLinks_Src/Route)
	{
		attribute<Options> Option_rel     := CarOptions/Option_rel[first_rel];
		attribute<uint32>  Part           := const(0, ., uint32);
		attribute<uint32>  Volgnr         := ='/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/Volgnr[second_rel]';
		attribute<Modes>   Mode_rel       := const(Modes/V/Car, .);
		attribute<rdc>     geometry (arc) := ='/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + TDName + '/Read_CarLinks/links/geometry[second_rel]';
	}

	// The parts of Links that this run has: for a public transport component (WithPT) the public transport and the pre-transport and
	// post-transport of its types, for a direct component its direct trip (the others give no rows, but this way the run does not read
	// their cache).
	unit<uint8> LinkParts : nrofrows = 10
	{
		attribute<string> name   : ['V_Walking/Sel', 'V_Cycling/Sel', 'PT_L/Rows', 'PT_R/Rows', 'TransferLinks', 'N_Walking/Sel', 'N_Cycling/Sel', 'D_Walking/Rows', 'D_Cycling/Rows', 'A_Car'];
		attribute<bool>   IsUsed := union_data(., WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PreTransport, 'Walking')), WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PreTransport, 'Cycling')), WithPT, WithPT, WithPT, WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PostTransport, 'Walking')), WithPT && IsDefined(strpos(/ModelParameters/Impl/Component_PostTransport, 'Cycling')), /ModelParameters/Impl/AllowDirectWalking, /ModelParameters/Impl/AllowDirectCycling, CarTD);
		attribute<string> Volgnr := name == 'TransferLinks' ? 'const(0, TransferLinks, uint32)' : name + '/Volgnr';
		attribute<string> Mode   := name == 'TransferLinks' ? 'const(Modes/V/Walking, TransferLinks)' : name + '/Mode_rel';
	}
	unit<uint8>       LinkParts_Used            := select_with_attr_by_cond(LinkParts, LinkParts/IsUsed);

	unit<uint64> Links := ='union_unit_uint64(' + asList(LinkParts_Used/name, ', ') + ')'
	{
		attribute<Options> Option_rel     := ='union_data(., ' + asList(LinkParts_Used/name + '/Option_rel', ', ') + ')';
		attribute<uint32>  Option         := Options/Option[Option_rel];
		attribute<uint32>  Part           := ='union_data(., ' + asList(LinkParts_Used/name + '/Part', ', ') + ')';
		attribute<uint32>  Volgnr         := ='union_data(., ' + asList(LinkParts_Used/Volgnr, ', ') + ')';
		attribute<Modes>   Mode_rel       := ='union_data(., ' + asList(LinkParts_Used/Mode, ', ') + ')';
		attribute<string>  ModeName       := Modes/name[Mode_rel];
		attribute<rdc>     geometry (arc) := ='union_data(., ' + asList(LinkParts_Used/name + '/geometry', ', ') + ')';
	}

	parameter<string> FileName                  := fileNamePrefix + 'od_' + inTime_str_short + '.gpkg';
	container Write_gpkg : StorageName = "=FileName", StorageType = "gdalwrite.vect"
	{
		unit<uint64> od_opties := Options, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
		{
			attribute<uint32>  Optie     := Options/Option;
			attribute<string>  OrgName   := Result_AfterSecondCondensation/OrgName;
			attribute<string>  DestName  := Result_AfterSecondCondensation/DestName;
			attribute<string>  Component := const(/ModelParameters/Impl/ComponentName, .);
			attribute<string>  Vertrek   := Options/Departure;
			attribute<float32> Reistijd  := float32(Options/Traveltime_min);
			attribute<float32> Prijs     := float32(Options/Price_euro);
			attribute<string>  ModeUsed  := Options/ModeUsed;
		}
		unit<uint64> od_onderdelen := Parts
		{
			attribute<uint32>  Optie      := Parts/Option;
			attribute<uint32>  Volgnr     := Parts/Volgnr;
			attribute<string>  Soort      := Parts/PartKind;
			attribute<string>  Modaliteit := Parts/ModeName;
			attribute<string>  Lijn       := Parts/LineName;
			attribute<string>  Vervoerder := Parts/AgencyName;
			attribute<string>  Van        := Parts/FromName;
			attribute<string>  Naar       := Parts/ToName;
			attribute<string>  Vertrek    := Parts/Departure;
			attribute<string>  Aankomst   := Parts/Arrival;
			attribute<float32> Minuten    := float32(Parts/Minutes);
			attribute<uint32>  Afstand_m  := uint32(convert(Parts/Distance, m));
			attribute<float32> Prijs      := float32(Parts/Price_euro);
		}
		unit<uint64> od_links := Links
		{
			attribute<uint32> Optie          := Links/Option;
			attribute<uint32> Onderdeel      := Links/Part;
			attribute<uint32> Volgnr         := Links/Volgnr;
			attribute<string> Modaliteit     := Links/ModeName;
			attribute<rdc>    geometry (arc) := Links/geometry;
		}
	}
	parameter<string> Write                     := 'Ready', ExplicitSuppliers = "Write_gpkg/od_opties;Write_gpkg/od_onderdelen;Write_gpkg/od_links";
}
