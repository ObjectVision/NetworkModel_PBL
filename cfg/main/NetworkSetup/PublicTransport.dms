container Generate_Output
{
	container Traveltime_ForEachDepTime
	{ 
		// parameter<string>   Generate  := ='add('+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/File_fullOD',',')+')';
		parameter<string>   Generate  := ='add('+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Generate',',')+(Advanced/MaakMediaan ? ', Mediaan/Generate' : '')+', Tellingen/Generate)';

		// Tellingen van dit blok voor <OutputDir>/od_tellingen.csv en unieke_od_tellingen.csv (sinds 2026-10-04), uit de kleine
		// resultaten achter het hek van elk vertrekmoment (PerDepartureMoment_T, LongFormat/Results_Traveltime/Tellingen). De blokken
		// hebben elk hun eigen herkomsten, dus NetworkSetup/ConfigurationPerBlock/Generate_Output/OD_Tellingen telt ze op.
		container Tellingen
		{
			container Rijen := for_each_nedv(Advanced/MeasureMoments/Name
				, 'PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Rijen'
				, Classifications/OD_Tellingen_Soort, uint64)
			, Descr = "Per vertrekmoment de rijen per soort optie.";
			container Paren := for_each_nedv(Advanced/MeasureMoments/Name
				, 'PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren_Telling'
				, Classifications/OD_Tellingen_Groep, uint64)
			, Descr = "Per vertrekmoment de unieke HB-paren per groep.";

			// De unieke paren over alle vertrekmomenten samen: de paren van de momenten onder elkaar, dan per paar of een van de
			// momenten het paar in de groep heeft.
			unit<uint64> AlleParen := ='union_unit_uint64('+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren', ',')+')'
			{
				attribute<OD_code> OD_key              := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/values', ',')+')';
				attribute<bool>   OV_keten             := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/OV_keten', ',')+')';
				attribute<bool>   WW                   := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/WW', ',')+')';
				attribute<bool>   CC                   := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/CC', ',')+')';
				attribute<bool>   AA                   := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/AA', ',')+')';
				attribute<bool>   zonder_auto          := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/zonder_auto', ',')+')';
				attribute<bool>   zonder_auto_en_fiets := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/zonder_auto_en_fiets', ',')+')';
				attribute<min_f>  Traveltime           := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/Traveltime', ',')+')', Descr = "De reistijd van de snelste optie van het paar op dit vertrekmoment.";
				attribute<m>      TravelDist           := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/TravelDist', ',')+')';
				attribute<Euro>   Price                := ='union_data(., '+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/Price', ',')+')';
				attribute<UniekeParen> Uniek_rel       := rlookup(OD_key, UniekeParen/values);
			}
			unit<uint64> UniekeParen := unique(AlleParen/OD_key)
			{
				attribute<bool> OV_keten             := any(AlleParen/OV_keten, AlleParen/Uniek_rel);
				attribute<bool> WW                   := any(AlleParen/WW, AlleParen/Uniek_rel);
				attribute<bool> CC                   := any(AlleParen/CC, AlleParen/Uniek_rel);
				attribute<bool> AA                   := any(AlleParen/AA, AlleParen/Uniek_rel);
				attribute<bool> zonder_auto          := any(AlleParen/zonder_auto, AlleParen/Uniek_rel);
				attribute<bool> zonder_auto_en_fiets := any(AlleParen/zonder_auto_en_fiets, AlleParen/Uniek_rel);

				// De goedkoopste optie van elk vertrekmoment over de momenten met een optie (sinds 2026-10-19; van 2026-10-08 tot
				// 2026-10-19 de snelste, #53), voor Mediaan/File: de mediaan van de reistijd (rth_element interpoleert, dus bij een even
				// aantal het gemiddelde van de twee middelste), de snelste en de traagste reistijd, en de afstand en de prijs, elk apart.
				attribute<min_f>  Traveltime_median  := rth_element(AlleParen/Traveltime, 0.5f, AlleParen/Uniek_rel);
				attribute<min_f>  Traveltime_min     := min(AlleParen/Traveltime, AlleParen/Uniek_rel);
				attribute<min_f>  Traveltime_max     := max(AlleParen/Traveltime, AlleParen/Uniek_rel);
				attribute<m>      TravelDist_median  := rth_element(AlleParen/TravelDist, 0.5f, AlleParen/Uniek_rel);
				attribute<Euro>   Price_median       := rth_element(AlleParen/Price, 0.5f, AlleParen/Uniek_rel);
				attribute<uint32> NrMoments          := uint32(pcount(AlleParen/Uniek_rel)), Descr = "pcount over een uint64-domein levert uint64, vandaar de conversie.";
				// OD_code is combine_unit_uint64(Places, Places): de eerste factor, de herkomst, varieert het langzaamst.
				attribute<Places> From_Place_rel     := value(uint64(values) / uint64(#Places), Places);
				attribute<Places> To_Place_rel       := value(uint64(values) % uint64(#Places), Places);
			}
			attribute<uint64> Paren_Samen (Classifications/OD_Tellingen_Groep) := union_data(Classifications/OD_Tellingen_Groep
				, #UniekeParen
				, sum_uint64(UniekeParen/OV_keten)
				, sum_uint64(UniekeParen/WW)
				, sum_uint64(UniekeParen/CC)
				, sum_uint64(UniekeParen/AA)
				, sum_uint64(UniekeParen/zonder_auto)
				, sum_uint64(UniekeParen/zonder_auto_en_fiets))
			, Descr = "De unieke HB-paren per groep over alle vertrekmomenten samen.";

			// De tellingen van dit blok in een klein bestand (sinds 2026-10-16), Tellingen/tellingen_<n>of<N>.csv: batch/OdTellingen.py
			// telt die van de blokken op tot od_tellingen.csv en unieke_od_tellingen.csv, zonder de uitvoer opnieuw te lezen (die kan
			// parquet zijn, ModelParameters/OutputFormat). Per regel de tabel (rijen of paren), de soort of groep, de tellingen per
			// vertrekmoment en het totaal: bij rijen de som, bij paren de unieke paren over de momenten samen.
			attribute<uint64> Rijen_Totaal (Classifications/OD_Tellingen_Soort) := =asList('Rijen/' + Advanced/MeasureMoments/Name, ' + ');
			attribute<string> RijenRegel   (Classifications/OD_Tellingen_Soort) := ='''rijen;'' + Classifications/OD_Tellingen_Soort/label + ' + asList(''';'' + string(Rijen/' + Advanced/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(Rijen_Totaal)';
			attribute<string> ParenRegel   (Classifications/OD_Tellingen_Groep) := ='''paren;'' + Classifications/OD_Tellingen_Groep/label + ' + asList(''';'' + string(Paren/' + Advanced/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(Paren_Samen)';
			parameter<string> File := 'tabel;naam;' + asList(Advanced/MeasureMoments/TemplatableTextShrt, ';') + ';totaal\n' + asList(RijenRegel, '\n') + '\n' + asList(ParenRegel, '\n') + '\n'
			,	StorageName = "=ModelParameters/Advanced/OutputDir + '/Tellingen/tellingen_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/Output_Sig/ForWriting";
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "File";
		}

		// De mediaan per HB-paar over de vertrekmomenten (sinds 2026-10-08, #53), alleen met ModelParameters/Advanced/MaakMediaan
		// (sinds 2026-10-19 standaard uit; de medianen worden niet opgeleverd). Per vertrekmoment de goedkoopste optie (de laagste
		// prijs, bij gelijke prijs de laagste reistijd; Tellingen/Paren achter het hek van het moment; tot 2026-10-19 de snelste, zoals
		// geleverd voor Y2023), dan per paar de mediaan over de momenten met een optie (Tellingen/UniekeParen). Een bestand per blok,
		// Mediaan/tt_<datum>_mediaan_<n>of<N>.csv (sinds 2026-10-09 in een eigen map; tot dan in PerBlock), in dezelfde opvraging als
		// de uitvoer. Tot 2026-10-08 las een Python-script (75a0884) daarvoor de csv's opnieuw (Auto, Buurt2023: 284 GB).
		container Mediaan
		{
			unit<uint64>      P                 := Tellingen/UniekeParen;
			attribute<string> Line          (P) := Places/label[P/From_Place_rel] + ';' + Places/label[P/To_Place_rel]
				+ ';' + string(P/Traveltime_median) + ';' + string(P/Traveltime_min) + ';' + string(P/Traveltime_max)
				+ ';' + string(P/TravelDist_median) + ';' + string(P/Price_median) + ';' + string(P/NrMoments);
			parameter<string> File              := 'OrgName;DestName;Traveltime_median;Traveltime_min;Traveltime_max;TravelDist_median;Price_median;NrMoments\n' + asList(Line, '\n')
			,	StorageName = "=ModelParameters/Advanced/OutputDir + '/Mediaan/tt_' + ModelParameters/Advanced/Analysis_Date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/Output_Sig/ForWriting"
			,	Descr = "Per HB-paar: herkomst en bestemming, van de goedkoopste optie van elk vertrekmoment de mediane, snelste en traagste reistijd (min), de mediane afstand (m) en prijs (euro), en het aantal vertrekmomenten met een optie.";

			// Hetzelfde als parquet (sinds 2026-10-16, ModelParameters/OutputFormat 'parquet'), met zstd; zie
			// PerDepartureMoment_T, CreateExports/LongFormat/Parquet.
			parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';
			container Parquet
			:	StorageName = "=ModelParameters/Advanced/OutputDir + '/Mediaan/tt_' + ModelParameters/Advanced/Analysis_Date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.parquet'", StorageType = "gdalwrite.vect"
			{
				unit<uint64> tt := P, ExplicitSuppliers = "/NetworkSetup/Output_Sig/ForWriting"
				{
					attribute<string> OrgName           := Places/label[P/From_Place_rel];
					attribute<string> DestName          := Places/label[P/To_Place_rel];
					attribute<min_f>  Traveltime_median := P/Traveltime_median;
					attribute<min_f>  Traveltime_min    := P/Traveltime_min;
					attribute<min_f>  Traveltime_max    := P/Traveltime_max;
					attribute<m>      TravelDist_median := P/TravelDist_median;
					attribute<Euro>   Price_median      := P/Price_median;
					attribute<uint32> NrMoments         := P/NrMoments;
				}
			}
			parameter<string> Generate          := 'Ready', ExplicitSuppliers = "=ModelParameters/OutputFormat == 'parquet' ? 'Parquet/tt' : 'File'";
		}
		// parameter<string>   Generate  := ='add('+asList('PerVertrekmoment/'+Advanced/MeasureMoments/Name+'/CreateExports/Generate_FSS',',')+')'; 
	}
	container Traveltime_ForEachDepTime_Fence := PhaseContainer(Traveltime_ForEachDepTime, 'Results for all departure times in '+NetworkSetup/Impl/OrgBlockDomain/name[BlockDomain_id]+' are finished calculating'); //
}

unit<uint8>         Modes             := GTFS_Modes/Selection;

unit<uint32>        Places            := PublicTransport_Prep/Impl/Places, Descr = "Alle plaatsen (haltes, herkomsten, bestemmingen). Tot 2026-10-07 met origin_sub_rel, de herkomst in het blok, waarop V en Direct_OD hun rijen kozen; nu kiezen die op het herkomstblok (NetworkSetup/impl/OrgBlockSelections/OrgBlock_rel).";
unit<uint64>        OD_code           := combine_unit_uint64(Places, Places), Descr = "Een element per paar (herkomst, bestemming) van Places; voor de unieke HB-paren van de tellingen.";


unit<uint16>        Allowed_ChainsK := /Classifications/Chains/Allowed;

// Het voor- en natransport van dit blok (sinds 2026-10-07): de voortransportbenen van NetworkSetup/impl/V_org met dit herkomstblok,
// met de tekst OrgName alleen voor die benen, en alle natransportbenen (NetworkSetup/impl/N). Tot dan verenigde elk blok alle benen
// opnieuw en koos het de voortransportbenen waarvan de herkomst in het blok lag (IsRelevantForOrgSubset): dezelfde benen, in
// dezelfde volgorde.
unit<uint64> V := select_with_attr_by_cond(/NetworkSetup/impl/V_org, /NetworkSetup/impl/V_org/OrgBlock_rel == BlockDomain_id)
, Descr = "PreTransport"
{
	attribute<string>            OrgName                   := Places/label[From_Place_rel]; //debug
}

// De OV-ketens van dit blok (sinds 2026-10-20): die van PublicTransport_Prep/PT_V die instappen bij een halte waar een voortransportbeen
// van dit blok eindigt, met de relaties die de vertrekmomenten lezen; elk vertrekmoment kiest hieruit zijn venster
// (PerDepartureMoment_T/Within_VW_Window). Andere ketens koppelt Add_V_to_PT aan geen enkel been, dus het front verandert niet. Een halte
// die meer herkomsten van het blok bereiken, telt een keer; de koppeling per herkomst komt pas in Add_V_to_PT.
attribute<bool> IsBlockVStop    (Places)                                := pcount(V/To_Place_rel) > 0u64;
attribute<bool> IsBlockBoarding (PublicTransport_Prep/uq_c_FromTime_Stop) := IsBlockVStop[PublicTransport_Prep/uq_c_FromTime_Stop/From_Place_rel];
attribute<bool> IsInBlock       (PublicTransport_Prep/PT_V)              := IsBlockBoarding[PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel];
unit<uint64> PT_InBlock := select(IsInBlock)
{
	attribute<uint32>                                    ModeCode               := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/ModeCode);
	attribute<ct>                                        Price                  := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price);
	attribute<ct>                                        Price_augm             := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price_augm);
	attribute<s>                                         Traveltime             := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveltime);
	attribute<dam>                                       TravelDist_Bus         := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/TravelDist_Bus);
	attribute<dam>                                       Traveldist_Metro       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Metro);
	attribute<dam>                                       Traveldist_Tram        := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Tram);
	attribute<dam>                                       Traveldist_Rail        := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Rail);
	attribute<dam>                                       Traveldist_Ferry       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Ferry);
	attribute<PublicTransport_Prep/uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel);
	attribute<PublicTransport_Prep/uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel   := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_ToTime_Stop_rel);

	attribute<Time>                                      From_Time_rel          := PublicTransport_Prep/uq_c_FromTime_Stop/From_Time_rel[uq_c_FromTime_Stop_rel];
	attribute<PublicTransport_Prep/impl/c_Time_Places>   c_FromTime_Place_rel   := PublicTransport_Prep/uq_c_FromTime_Stop/c_FromTime_Place_rel[uq_c_FromTime_Stop_rel];
	attribute<PublicTransport_Prep/impl/c_Time_Places>   c_ToTime_Place_rel     := PublicTransport_Prep/uq_c_ToTime_Stop/c_ToTime_Place_rel[uq_c_ToTime_Stop_rel];
	attribute<PublicTransport_Prep/PT_V>                 PT_V_rel               := collect_by_cond(., IsInBlock, id(PublicTransport_Prep/PT_V)), Descr = "De keten in PT_V, om een optie terug te leiden (sinds 2026-10-21, #129; alleen gevraagd in de HB-paarmodus).";
}

unit<uint64> N := /NetworkSetup/impl/N, Descr = "PostTransport";

// De directe ritten van de herkomsten van dit blok: de rijen van NetworkSetup/impl/Direct_OD met dit herkomstblok, met de tekst
// ModeUsed alleen voor die rijen. Tot 2026-10-07 rekende elk blok de plaatsen, het bezit en de tekst over de hele tabel
// (Direct_OD_all) en koos het daarna de rijen waarvan de herkomst in het blok lag (IsRelevantForOrgSubset): dezelfde rijen, in
// dezelfde volgorde, want elke herkomst is een plaats en het blok kiest zijn herkomsten op OrgBlockSelections/OrgBlock_rel.
unit<uint64> Direct_OD := select_with_attr_by_cond(/NetworkSetup/impl/Direct_OD, /NetworkSetup/impl/Direct_OD/OrgBlock_rel == BlockDomain_id)
{
	attribute<string>  ModeUsed                         := Modes/name_abbr[Mode_rel] + Modes/name_abbr[Mode_rel];
}

/////===========================================================================//////

container PerVertrekmoment := 
	for_each_ne(
		Advanced/MeasureMoments/Name
		, 'PerDepartureMoment_T('+string(Advanced/MeasureMoments/Moment)+', '+quote(Advanced/MeasureMoments/name)+')'
	), using = "impl";

#include<PerDepartureMoment_T.dms>

