// The writers and counts of this block are those of its first part (PerPart, below), which write the union of all parts.
parameter<string> WriterPart := 'PerPart/' + first(/NetworkSetup/impl/OrgParts/name), Descr = "The part of this block whose writers write the output of the whole block (PerDepartureMoment_T/BlockResult).";

container Generate_Output
{
	container Traveltime_ForEachDepTime
	{ 
		parameter<string> Generate := ='add('+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Generate',',')+(Advanced/MakeMedian ? ', Median/Generate' : '')+', Counts/Generate)';

		// The counts of this block for <OutputDir>/od_tellingen.csv and unieke_od_tellingen.csv, from the small results behind the fence of
		// each departure moment (PerDepartureMoment_T, LongFormat/Results_Traveltime/Counts). Each block has its own origins, so
		// NetworkSetup/ConfigurationPerBlock/Generate_Output/OD_Counts adds them up.
		container Counts
		{
			container         RowCounts  := for_each_nedv(ModelParameters/Impl/MeasureMoments/Name
			                                , WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/RowCounts'
			                                , Classifications/OD_Counts_Kind, uint64)
			, Descr = "Per departure moment, the number of rows per kind of option.";
			container         PairCounts := for_each_nedv(ModelParameters/Impl/MeasureMoments/Name
			                                , WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/PairCounts'
			                                , Classifications/OD_Counts_Group, uint64)
			, Descr = "Per departure moment, the number of unique OD pairs per group.";

			// The unique pairs over all departure moments together: the pairs of the moments stacked, then per pair whether any of the moments
			// has the pair in the group.
			unit<uint64> AllPairs := ='union_unit_uint64('+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs', ',')+')'
			{
				attribute<OD_code>     OD_key               := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/values', ',')+')';
				attribute<bool>        PT_chain             := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/PT_chain', ',')+')';
				attribute<bool>        WW                   := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/WW', ',')+')';
				attribute<bool>        CC                   := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/CC', ',')+')';
				attribute<bool>        AA                   := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/AA', ',')+')';
				attribute<bool>        without_car          := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/without_car', ',')+')';
				attribute<bool>        without_car_and_bike := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/without_car_and_bike', ',')+')';
				attribute<min_f>       Traveltime           := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/Traveltime', ',')+')', Descr = "The travel time of the cheapest option of the pair at this departure moment (the lowest price, at equal price the lowest travel time).";
				attribute<m>           TravelDist           := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/TravelDist', ',')+')';
				attribute<Euro>        Price                := ='union_data(., '+asList(WriterPart+'/PerDepartureMoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Counts/Pairs/Price', ',')+')';
				attribute<UniquePairs> Unique_rel           := rlookup(OD_key, UniquePairs/values);
			}
			unit<uint64> UniquePairs := unique(AllPairs/OD_key)
			{
				attribute<bool>   PT_chain             := any(AllPairs/PT_chain, AllPairs/Unique_rel);
				attribute<bool>   WW                   := any(AllPairs/WW, AllPairs/Unique_rel);
				attribute<bool>   CC                   := any(AllPairs/CC, AllPairs/Unique_rel);
				attribute<bool>   AA                   := any(AllPairs/AA, AllPairs/Unique_rel);
				attribute<bool>   without_car          := any(AllPairs/without_car, AllPairs/Unique_rel);
				attribute<bool>   without_car_and_bike := any(AllPairs/without_car_and_bike, AllPairs/Unique_rel);

				// Of the cheapest option of each departure moment, over the moments with an option, for Median/File (#53): the median travel time
				// (rth_element interpolates, so with an even count it is the mean of the two middle values), the fastest and the slowest travel
				// time, and the distance and the price, each with its own median.
				attribute<min_f>  Traveltime_median    := rth_element(AllPairs/Traveltime, 0.5f, AllPairs/Unique_rel);
				attribute<min_f>  Traveltime_min       := min(AllPairs/Traveltime, AllPairs/Unique_rel);
				attribute<min_f>  Traveltime_max       := max(AllPairs/Traveltime, AllPairs/Unique_rel);
				attribute<m>      TravelDist_median    := rth_element(AllPairs/TravelDist, 0.5f, AllPairs/Unique_rel);
				attribute<Euro>   Price_median         := rth_element(AllPairs/Price, 0.5f, AllPairs/Unique_rel);
				attribute<uint32> NrMoments            := uint32(pcount(AllPairs/Unique_rel)), Descr = "The number of departure moments with an option for this pair; converted because pcount over a uint64 domain gives uint64.";
				// OD_code is combine_unit_uint64(Places, Places): the first factor, the origin, varies slowest.
				attribute<Places> From_Place_rel       := value(uint64(values) / uint64(#Places), Places);
				attribute<Places> To_Place_rel         := value(uint64(values) % uint64(#Places), Places);
			}
			attribute<uint64> PairCounts_AllMoments (Classifications/OD_Counts_Group) := union_data(Classifications/OD_Counts_Group
			                                                                             , #UniquePairs
			                                                                             , sum_uint64(UniquePairs/PT_chain)
			                                                                             , sum_uint64(UniquePairs/WW)
			                                                                             , sum_uint64(UniquePairs/CC)
			                                                                             , sum_uint64(UniquePairs/AA)
			                                                                             , sum_uint64(UniquePairs/without_car)
			                                                                             , sum_uint64(UniquePairs/without_car_and_bike))
			, Descr = "The number of unique OD pairs per group over all departure moments together.";

			// The counts of this block in a small file, Tellingen/tellingen_<n>of<N>.csv: batch/OdTellingen.py adds those of the blocks up to
			// od_tellingen.csv and unieke_od_tellingen.csv without reading the output again (which can be parquet, ModelParameters/OutputFormat).
			// Each line holds the table (rows or pairs), the kind or group, the counts per departure moment and the total: for rows the sum, for
			// pairs the unique pairs over the moments together.
			attribute<uint64> RowCounts_Total (Classifications/OD_Counts_Kind) := =asList('RowCounts/' + ModelParameters/Impl/MeasureMoments/Name, ' + ');
			attribute<string> RowCountsLine (Classifications/OD_Counts_Kind) := ='''rijen;'' + Classifications/OD_Counts_Kind/label + ' + asList(''';'' + string(RowCounts/' + ModelParameters/Impl/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(RowCounts_Total)';
			attribute<string> PairCountsLine (Classifications/OD_Counts_Group) := ='''paren;'' + Classifications/OD_Counts_Group/label + ' + asList(''';'' + string(PairCounts/' + ModelParameters/Impl/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(PairCounts_AllMoments)';
			parameter<string> File       := 'tabel;naam;' + asList(ModelParameters/Impl/MeasureMoments/TemplatableTextShrt, ';') + ';totaal\n' + asList(RowCountsLine, '\n') + '\n' + asList(PairCountsLine, '\n') + '\n'
			,	StorageName = "=ModelParameters/Impl/OutputDir + '/Tellingen/tellingen_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			parameter<string> Generate   := 'Ready', ExplicitSuppliers = "File";
		}

		// The median per OD pair over the departure moments (#53), only with ModelParameters/Advanced/MakeMedian, which is off by default;
		// the medians are not part of the delivered output. Per departure moment the cheapest option (the lowest price, at equal price the
		// lowest travel time; Counts/Pairs behind the fence of the moment), then per pair the median over the moments with an option
		// (Counts/UniquePairs). One file per block, Mediaan/tt_<date>_mediaan_<n>of<N>.csv, in the same request as the output.
		container Median
		{
			unit<uint64>      P                         := Counts/UniquePairs;
			attribute<string> Line                  (P) := Places/label[P/From_Place_rel] + ';' + Places/label[P/To_Place_rel]
			                                               + ';' + string(P/Traveltime_median) + ';' + string(P/Traveltime_min) + ';' + string(P/Traveltime_max)
			                                               + ';' + string(P/TravelDist_median) + ';' + string(P/Price_median) + ';' + string(P/NrMoments);
			parameter<string> File                      := 'OrgName;DestName;Traveltime_median;Traveltime_min;Traveltime_max;TravelDist_median;Price_median;NrMoments\n' + asList(Line, '\n')
			,	StorageName = "=ModelParameters/Impl/OutputDir + '/Mediaan/tt_' + ModelParameters/Impl/Analysis_date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
			,	Descr = "Per OD pair the origin and destination and, of the cheapest option of each departure moment, the median, fastest and slowest travel time (min), the median distance (m) and price (euro), and the number of departure moments with an option.";

			// The same as parquet (ModelParameters/OutputFormat 'parquet'), with zstd; see PerDepartureMoment_T, CreateExports/LongFormat/Parquet.
			parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';
			container Parquet
			:	StorageName = "=ModelParameters/Impl/OutputDir + '/Mediaan/tt_' + ModelParameters/Impl/Analysis_date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.parquet'", StorageType = "gdalwrite.vect"
			{
				unit<uint64> tt := P, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
				{
					attribute<string> OrgName           := Places/label[P/From_Place_rel];
					attribute<string> DestName          := Places/label[P/To_Place_rel];
					attribute<min_f>  Traveltime_median := P/Traveltime_median;
					attribute<min_f>  Traveltime_min    := P/Traveltime_min;
					attribute<min_f>  Traveltime_max    := P/Traveltime_max;
					attribute<m>      TravelDist_median := P/TravelDist_median;
					attribute<Euro>   Price_median      := P/Price_median;
					attribute<uint32> NrMoments         := P/NrMoments;
				}
			}
			parameter<string> Generate                  := 'Ready', ExplicitSuppliers = "=ModelParameters/OutputFormat == 'parquet' ? 'Parquet/tt' : 'File'";
		}
	}
	container Traveltime_ForEachDepTime_Fence := PhaseContainer(Traveltime_ForEachDepTime, 'Results for all departure times in '+NetworkSetup/Impl/OrgBlockDomain/name[BlockDomain_id]+' are finished calculating'); //
}

unit<uint8>         Modes             := GTFS_Modes/Selection;

unit<uint32>        Places            := PublicTransport_Prep/Impl/Places, Descr = "All places: stops, origins and destinations.";
unit<uint64>        OD_code           := combine_unit_uint64(Places, Places), Descr = "One element per ordered pair of Places: an OD pair of the counts, or an origin and the arrival place of a chain (the front before the post-transport in PerDepartureMoment_T).";


unit<uint16>        Allowed_ChainsK := /Classifications/Chains/Allowed;

// THE PARTS OF THIS BLOCK (#117). The output step calculates the block in ModelParameters/Impl/OrgBlockParts parts of its origins
// (NetworkSetup/impl/OrgParts), each with its own pre-transport, chains and direct trips, and per departure moment its own final set behind its
// own fence (PerDepartureMoment_T/Result_Fence), so that the memory of the intermediate results of one part is freed before the next. The
// first part (WriterPart) writes the union of the final sets of all parts as the output of the block. One part is the whole block.
unit<uint64> N := /NetworkSetup/impl/N, Descr = "All post-transport legs (NetworkSetup/impl/N), the same for every origin block and part.";

container PerPart := for_each_ne(/NetworkSetup/impl/OrgParts/name, 'BlockPart_T(' + string(id(/NetworkSetup/impl/OrgParts)) + 'b)')
, Descr = "The parts of this origin block, each an instance of BlockPart_T.";

Template BlockPart_T : Descr = "One part of an origin block: its pre-transport legs, chains and direct trips, and its results per departure moment."
{
	parameter<uint8> Part_id;
	///
	parameter</NetworkSetup/impl/OrgParts> Part_rel := value(Part_id, /NetworkSetup/impl/OrgParts);

	// The pre-transport of this part: the pre-transport legs of NetworkSetup/impl/V_org with this origin block and part, with the text
	// OrgName only for those legs; the post-transport (N) takes all post-transport legs of NetworkSetup/impl/N.
	unit<uint64> V := select_with_attr_by_cond(/NetworkSetup/impl/V_org, /NetworkSetup/impl/V_org/OrgBlock_rel == BlockDomain_id && /NetworkSetup/impl/V_org/OrgPart_rel == Part_rel)
	, Descr = "The pre-transport legs of the origins of this part of the block."
	{
		attribute<string> OrgName := Places/label[From_Place_rel]; //debug
	}

	// The public transport chains of this part: those of PublicTransport_Prep/PT_V that board at a stop where a pre-transport leg of
	// this part ends, with the relations the departure moments read; each departure moment picks its window from these
	// (PerDepartureMoment_T/Within_VW_Window). Add_V_to_PT links other chains to no leg at all, so the front does not change. A stop
	// that several origins of the part reach counts once; the link per origin comes only in Add_V_to_PT.
	attribute<bool> IsBlockVStop    (Places)                                := pcount(V/To_Place_rel) > 0u64;
	attribute<bool> IsBlockBoarding (PublicTransport_Prep/uq_c_FromTime_Stop) := IsBlockVStop[PublicTransport_Prep/uq_c_FromTime_Stop/From_Place_rel];
	attribute<bool> IsInBlock       (PublicTransport_Prep/PT_V)              := IsBlockBoarding[PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel];
	unit<uint64> PT_InBlock := select(IsInBlock)
	{
		attribute<uint32> ModeCode         := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/ModeCode);
		attribute<ct>     Price            := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price);
		attribute<ct>     Price_augm       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price_augm);
		attribute<s>      Traveltime       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveltime);
		attribute<dam>    TravelDist_Bus   := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/TravelDist_Bus);
		attribute<dam>    Traveldist_Metro := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Metro);
		attribute<dam>    Traveldist_Tram  := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Tram);
		attribute<dam>    Traveldist_Rail  := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Rail);
		attribute<dam>    Traveldist_Ferry := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Ferry);
		attribute<PublicTransport_Prep/uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel);
		attribute<PublicTransport_Prep/uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_ToTime_Stop_rel);

		attribute<Time>   From_Time_rel    := PublicTransport_Prep/uq_c_FromTime_Stop/From_Time_rel[uq_c_FromTime_Stop_rel];
		attribute<PublicTransport_Prep/impl/c_Time_Places> c_FromTime_Place_rel := PublicTransport_Prep/uq_c_FromTime_Stop/c_FromTime_Place_rel[uq_c_FromTime_Stop_rel];
		attribute<PublicTransport_Prep/impl/c_Time_Places> c_ToTime_Place_rel := PublicTransport_Prep/uq_c_ToTime_Stop/c_ToTime_Place_rel[uq_c_ToTime_Stop_rel];
		attribute<PublicTransport_Prep/PT_V> PT_V_rel := collect_by_cond(., IsInBlock, id(PublicTransport_Prep/PT_V)), Descr = "The chain in PT_V, to trace an option back to its chain (#129); only requested in the OD pair mode.";
	}

	// The direct trips of the origins of this part: the rows of NetworkSetup/impl/Direct_OD with this origin block and part, with the text
	// ModeUsed only for those rows.
	unit<uint64> Direct_OD := select_with_attr_by_cond(/NetworkSetup/impl/Direct_OD, /NetworkSetup/impl/Direct_OD/OrgBlock_rel == BlockDomain_id && /NetworkSetup/impl/Direct_OD/OrgPart_rel == Part_rel)
	{
		attribute<string> ModeUsed := Modes/name_abbr[Mode_rel] + Modes/name_abbr[Mode_rel];
	}

	/////===========================================================================//////

	container PerDepartureMoment :=
		for_each_ne(
			ModelParameters/Impl/MeasureMoments/Name
			, 'PerDepartureMoment_T('+string(ModelParameters/Impl/MeasureMoments/Moment)+', '+quote(ModelParameters/Impl/MeasureMoments/name)+')'
		), using = "impl", Descr = "The results per departure moment of ModelParameters/Impl/MeasureMoments, each an instance of PerDepartureMoment_T.";
}

#include<PerDepartureMoment_T.dms>

