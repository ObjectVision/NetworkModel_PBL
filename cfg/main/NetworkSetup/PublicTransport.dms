container Generate_Output
{
	container Traveltime_ForEachDepTime
	{ 
		parameter<string>   Generate  := ='add('+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Generate',',')+(Advanced/MakeMedian ? ', Mediaan/Generate' : '')+', Tellingen/Generate)';

		// The counts of this block for <OutputDir>/od_tellingen.csv and unieke_od_tellingen.csv, from the small results behind the fence of
		// each departure moment (PerDepartureMoment_T, LongFormat/Results_Traveltime/Tellingen). Each block has its own origins, so
		// NetworkSetup/ConfigurationPerBlock/Generate_Output/OD_Tellingen adds them up.
		container Tellingen
		{
			container Rijen := for_each_nedv(ModelParameters/Impl/MeasureMoments/Name
				, 'PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Rijen'
				, Classifications/OD_Tellingen_Soort, uint64)
			, Descr = "Per departure moment, the number of rows per kind of option.";
			container Paren := for_each_nedv(ModelParameters/Impl/MeasureMoments/Name
				, 'PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren_Telling'
				, Classifications/OD_Tellingen_Groep, uint64)
			, Descr = "Per departure moment, the number of unique OD pairs per group.";

			// The unique pairs over all departure moments together: the pairs of the moments stacked, then per pair whether any of the moments
			// has the pair in the group.
			unit<uint64> AlleParen := ='union_unit_uint64('+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren', ',')+')'
			{
				attribute<OD_code> OD_key              := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/values', ',')+')';
				attribute<bool>   OV_keten             := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/OV_keten', ',')+')';
				attribute<bool>   WW                   := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/WW', ',')+')';
				attribute<bool>   CC                   := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/CC', ',')+')';
				attribute<bool>   AA                   := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/AA', ',')+')';
				attribute<bool>   zonder_auto          := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/zonder_auto', ',')+')';
				attribute<bool>   zonder_auto_en_fiets := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/zonder_auto_en_fiets', ',')+')';
				attribute<min_f>  Traveltime           := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/Traveltime', ',')+')', Descr = "The travel time of the cheapest option of the pair at this departure moment (the lowest price, at equal price the lowest travel time).";
				attribute<m>      TravelDist           := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/TravelDist', ',')+')';
				attribute<Euro>   Price                := ='union_data(., '+asList('PerVertrekmoment/'+ModelParameters/Impl/MeasureMoments/Name+'/CreateExports/LongFormat/Results_Traveltime_Fence/Tellingen/Paren/Price', ',')+')';
				attribute<UniekeParen> Uniek_rel       := rlookup(OD_key, UniekeParen/values);
			}
			unit<uint64> UniekeParen := unique(AlleParen/OD_key)
			{
				attribute<bool> OV_keten             := any(AlleParen/OV_keten, AlleParen/Uniek_rel);
				attribute<bool> WW                   := any(AlleParen/WW, AlleParen/Uniek_rel);
				attribute<bool> CC                   := any(AlleParen/CC, AlleParen/Uniek_rel);
				attribute<bool> AA                   := any(AlleParen/AA, AlleParen/Uniek_rel);
				attribute<bool> zonder_auto          := any(AlleParen/zonder_auto, AlleParen/Uniek_rel);
				attribute<bool> zonder_auto_en_fiets := any(AlleParen/zonder_auto_en_fiets, AlleParen/Uniek_rel);

				// Of the cheapest option of each departure moment, over the moments with an option, for Mediaan/File (#53): the median travel time
				// (rth_element interpolates, so with an even count it is the mean of the two middle values), the fastest and the slowest travel
				// time, and the distance and the price, each with its own median.
				attribute<min_f>  Traveltime_median  := rth_element(AlleParen/Traveltime, 0.5f, AlleParen/Uniek_rel);
				attribute<min_f>  Traveltime_min     := min(AlleParen/Traveltime, AlleParen/Uniek_rel);
				attribute<min_f>  Traveltime_max     := max(AlleParen/Traveltime, AlleParen/Uniek_rel);
				attribute<m>      TravelDist_median  := rth_element(AlleParen/TravelDist, 0.5f, AlleParen/Uniek_rel);
				attribute<Euro>   Price_median       := rth_element(AlleParen/Price, 0.5f, AlleParen/Uniek_rel);
				attribute<uint32> NrMoments          := uint32(pcount(AlleParen/Uniek_rel)), Descr = "The number of departure moments with an option for this pair; converted because pcount over a uint64 domain gives uint64.";
				// OD_code is combine_unit_uint64(Places, Places): the first factor, the origin, varies slowest.
				attribute<Places> From_Place_rel     := value(uint64(values) / uint64(#Places), Places);
				attribute<Places> To_Place_rel       := value(uint64(values) % uint64(#Places), Places);
			}
			attribute<uint64> Paren_Samen (Classifications/OD_Tellingen_Groep) := union_data(Classifications/OD_Tellingen_Groep
				, #UniekeParen
				, sum_uint64(UniekeParen/OV_keten)
				, sum_uint64(UniekeParen/WW)
				, sum_uint64(UniekeParen/CC)
				, sum_uint64(UniekeParen/AA)
				, sum_uint64(UniekeParen/zonder_auto)
				, sum_uint64(UniekeParen/zonder_auto_en_fiets))
			, Descr = "The number of unique OD pairs per group over all departure moments together.";

			// The counts of this block in a small file, Tellingen/tellingen_<n>of<N>.csv: batch/OdTellingen.py adds those of the blocks up to
			// od_tellingen.csv and unieke_od_tellingen.csv without reading the output again (which can be parquet, ModelParameters/OutputFormat).
			// Each line holds the table (rows or pairs), the kind or group, the counts per departure moment and the total: for rows the sum, for
			// pairs the unique pairs over the moments together.
			attribute<uint64> Rijen_Totaal (Classifications/OD_Tellingen_Soort) := =asList('Rijen/' + ModelParameters/Impl/MeasureMoments/Name, ' + ');
			attribute<string> RijenRegel   (Classifications/OD_Tellingen_Soort) := ='''rijen;'' + Classifications/OD_Tellingen_Soort/label + ' + asList(''';'' + string(Rijen/' + ModelParameters/Impl/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(Rijen_Totaal)';
			attribute<string> ParenRegel   (Classifications/OD_Tellingen_Groep) := ='''paren;'' + Classifications/OD_Tellingen_Groep/label + ' + asList(''';'' + string(Paren/' + ModelParameters/Impl/MeasureMoments/Name + ')', ' + ') + ' + '';'' + string(Paren_Samen)';
			parameter<string> File := 'tabel;naam;' + asList(ModelParameters/Impl/MeasureMoments/TemplatableTextShrt, ';') + ';totaal\n' + asList(RijenRegel, '\n') + '\n' + asList(ParenRegel, '\n') + '\n'
			,	StorageName = "=ModelParameters/Impl/OutputDir + '/Tellingen/tellingen_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting";
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "File";
		}

		// The median per OD pair over the departure moments (#53), only with ModelParameters/Advanced/MakeMedian, which is off by default;
		// the medians are not part of the delivered output. Per departure moment the cheapest option (the lowest price, at equal price the
		// lowest travel time; Tellingen/Paren behind the fence of the moment), then per pair the median over the moments with an option
		// (Tellingen/UniekeParen). One file per block, Mediaan/tt_<date>_mediaan_<n>of<N>.csv, in the same request as the output.
		container Mediaan
		{
			unit<uint64>      P                 := Tellingen/UniekeParen;
			attribute<string> Line          (P) := Places/label[P/From_Place_rel] + ';' + Places/label[P/To_Place_rel]
				+ ';' + string(P/Traveltime_median) + ';' + string(P/Traveltime_min) + ';' + string(P/Traveltime_max)
				+ ';' + string(P/TravelDist_median) + ';' + string(P/Price_median) + ';' + string(P/NrMoments);
			parameter<string> File              := 'OrgName;DestName;Traveltime_median;Traveltime_min;Traveltime_max;TravelDist_median;Price_median;NrMoments\n' + asList(Line, '\n')
			,	StorageName = "=ModelParameters/Impl/OutputDir + '/Mediaan/tt_' + ModelParameters/Impl/Analysis_date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.csv'", StorageType = "str"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
			,	Descr = "Per OD pair the origin and destination and, of the cheapest option of each departure moment, the median, fastest and slowest travel time (min), the median distance (m) and price (euro), and the number of departure moments with an option.";

			// The same as parquet (ModelParameters/OutputFormat 'parquet'), with zstd; see PerDepartureMoment_T, CreateExports/LongFormat/Parquet.
			parameter<string> GDAL_LayerCreationOptions := 'COMPRESSION=ZSTD';
			container Parquet
			:	StorageName = "=ModelParameters/Impl/OutputDir + '/Mediaan/tt_' + ModelParameters/Impl/Analysis_date + '_mediaan_' + NetworkSetup/Impl/OrgBlockDomain/FileName[BlockDomain_id] + '.parquet'", StorageType = "gdalwrite.vect"
			{
				unit<uint64> tt := P, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
				{
					attribute<string> OrgName           := Places/label[P/From_Place_rel];
					attribute<string> DestName          := Places/label[P/To_Place_rel];
					attribute<min_f>  Traveltime_median := P/Traveltime_median;
					attribute<min_f>  Traveltime_min    := P/Traveltime_min;
					attribute<min_f>  Traveltime_max    := P/Traveltime_max;
					attribute<m>      TravelDist_median := P/TravelDist_median;
					attribute<Euro>   Price_median      := P/Price_median;
					attribute<uint32> NrMoments         := P/NrMoments;
				}
			}
			parameter<string> Generate          := 'Ready', ExplicitSuppliers = "=ModelParameters/OutputFormat == 'parquet' ? 'Parquet/tt' : 'File'";
		}
	}
	container Traveltime_ForEachDepTime_Fence := PhaseContainer(Traveltime_ForEachDepTime, 'Results for all departure times in '+NetworkSetup/Impl/OrgBlockDomain/name[BlockDomain_id]+' are finished calculating'); //
}

unit<uint8>         Modes             := GTFS_Modes/Selection;

unit<uint32>        Places            := PublicTransport_Prep/Impl/Places, Descr = "All places: stops, origins and destinations.";
unit<uint64>        OD_code           := combine_unit_uint64(Places, Places), Descr = "One element per pair (origin, destination) of Places, for the unique OD pairs of the counts.";


unit<uint16>        Allowed_ChainsK := /Classifications/Chains/Allowed;

// The pre-transport of this block: the pre-transport legs of NetworkSetup/impl/V_org with this origin block, with the text OrgName
// only for those legs; the post-transport (N) takes all post-transport legs of NetworkSetup/impl/N.
unit<uint64> V := select_with_attr_by_cond(/NetworkSetup/impl/V_org, /NetworkSetup/impl/V_org/OrgBlock_rel == BlockDomain_id)
, Descr = "The pre-transport legs of the origins of this block."
{
	attribute<string>            OrgName                   := Places/label[From_Place_rel]; //debug
}

// The public transport chains of this block: those of PublicTransport_Prep/PT_V that board at a stop where a pre-transport leg of
// this block ends, with the relations the departure moments read; each departure moment picks its window from these
// (PerDepartureMoment_T/Within_VW_Window). Add_V_to_PT links other chains to no leg at all, so the front does not change. A stop
// that several origins of the block reach counts once; the link per origin comes only in Add_V_to_PT.
attribute<bool> IsBlockVStop    (Places)                                := pcount(V/To_Place_rel) > 0u64;
attribute<bool> IsBlockBoarding (PublicTransport_Prep/uq_c_FromTime_Stop) := IsBlockVStop[PublicTransport_Prep/uq_c_FromTime_Stop/From_Place_rel];
attribute<bool> IsInBlock       (PublicTransport_Prep/PT_V)              := IsBlockBoarding[PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel];
unit<uint64> PT_InBlock := select(IsInBlock)
{
	attribute<uint32>                                    ModeCode               := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/ModeCode);
	attribute<ct>                                        Price                  := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price);
	attribute<ct>                                        Price_augm             := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Price_augm);
	attribute<s>                                         Traveltime             := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveltime);
	attribute<dam>                                       TravelDist_Bus         := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/TravelDist_Bus);
	attribute<dam>                                       Traveldist_Metro       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Metro);
	attribute<dam>                                       Traveldist_Tram        := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Tram);
	attribute<dam>                                       Traveldist_Rail        := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Rail);
	attribute<dam>                                       Traveldist_Ferry       := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/Traveldist_Ferry);
	attribute<PublicTransport_Prep/uq_c_FromTime_Stop>   uq_c_FromTime_Stop_rel := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_FromTime_Stop_rel);
	attribute<PublicTransport_Prep/uq_c_ToTime_Stop>     uq_c_ToTime_Stop_rel   := collect_by_cond(., IsInBlock, PublicTransport_Prep/PT_V/uq_c_ToTime_Stop_rel);

	attribute<Time>                                      From_Time_rel          := PublicTransport_Prep/uq_c_FromTime_Stop/From_Time_rel[uq_c_FromTime_Stop_rel];
	attribute<PublicTransport_Prep/impl/c_Time_Places>   c_FromTime_Place_rel   := PublicTransport_Prep/uq_c_FromTime_Stop/c_FromTime_Place_rel[uq_c_FromTime_Stop_rel];
	attribute<PublicTransport_Prep/impl/c_Time_Places>   c_ToTime_Place_rel     := PublicTransport_Prep/uq_c_ToTime_Stop/c_ToTime_Place_rel[uq_c_ToTime_Stop_rel];
	attribute<PublicTransport_Prep/PT_V>                 PT_V_rel               := collect_by_cond(., IsInBlock, id(PublicTransport_Prep/PT_V)), Descr = "The chain in PT_V, to trace an option back to its chain (#129); only requested in the OD pair mode.";
}

unit<uint64> N := /NetworkSetup/impl/N, Descr = "All post-transport legs (NetworkSetup/impl/N), the same for every origin block.";

// The direct trips of the origins of this block: the rows of NetworkSetup/impl/Direct_OD with this origin block, with the text
// ModeUsed only for those rows.
unit<uint64> Direct_OD := select_with_attr_by_cond(/NetworkSetup/impl/Direct_OD, /NetworkSetup/impl/Direct_OD/OrgBlock_rel == BlockDomain_id)
{
	attribute<string>  ModeUsed                         := Modes/name_abbr[Mode_rel] + Modes/name_abbr[Mode_rel];
}

/////===========================================================================//////

container PerVertrekmoment := 
	for_each_ne(
		ModelParameters/Impl/MeasureMoments/Name
		, 'PerDepartureMoment_T('+string(ModelParameters/Impl/MeasureMoments/Moment)+', '+quote(ModelParameters/Impl/MeasureMoments/name)+')'
	), using = "impl", Descr = "The results per departure moment of ModelParameters/Impl/MeasureMoments, each an instance of PerDepartureMoment_T.";

#include<PerDepartureMoment_T.dms>

