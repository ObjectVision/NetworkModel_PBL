container ModelParameters : using = "units"
{   
	//Generieke instellingen
	parameter<string>   AnalysisMoment                    := 'Y2026'                , Descr = "De peildatum: een jaar uit Advanced/AnalysisMomentPresets, met de bijbehorende dag (Analysis_date, sinds 2026-10-05 de tweede dinsdag van oktober, #125), GTFS-feed, OSM, TomTom, CBS-gebiedsindeling en BAG-snapshot. Peildata: Y2015, Y2023, Y2024, Y2025 en Y2026.";
	parameter<string>   Dagdeel                           := 'Ochtendspits'         , Descr = "Het dagdeel van de vertrekmomenten, uit Advanced/Dagdelen (overleg PBL 5-10-2026, #125): 'Ochtendspits' 07:00-07:45, 'Middag' 12:00-12:45 (ter controle) of 'Avond' 19:00-19:45, elk vier momenten per kwartier (PT_DepartureMinutes). Bepaalt ook het congestiemoment van de directe autorit (Car_CongestionMoment_ForDirect). De ochtendspits heeft voorrang.", IntegrityCheck = "IsDefined(rlookup(this, Advanced/Dagdelen/name))";
	parameter<string>   Component                         := 'Lopen'                , Descr = "De component van deze run, uit Advanced/Componenten (overleg PBL 5-10-2026, #117): 'Lopen' (lopen + OV + lopen, en direct lopen), 'Fiets' (fiets + OV + lopen of OV-fiets, en direct fietsen; geen lopen als voortransport), 'Auto' (alleen de directe autorit, met starten en parkeren) of 'Alles' (lopen + OV + lopen naast direct lopen, fietsen en autorijden in een run, zoals tot 2026-10-05). 'Samen' rekent niet maar voegt de uitvoer van de componenten in MergeComponents samen tot een Pareto-front, met autobezit en fietsbezit als criteria (NetworkSetup/ComponentMerge). Bepaalt het voor- en natransport (Advanced/OV_PreTransport_Typen, OV_PostTransport_Typen), de directe ritten (AllowDirectWalking, -Cycling, -Car), of het OV meedoet (Advanced/MetOV) en de uitvoermap (Advanced/OutputDir, met _lopen, _fiets, _auto of _samen achter het label). Voor- en natransport hoogstens 15 min en directe en totale rit hoogstens 90 min, zonder wachten thuis, gelden voor elke component.", IntegrityCheck = "IsDefined(rlookup(this, Advanced/Componenten/name))";
	parameter<string>   MergeComponents                   := 'Lopen,Fiets,Auto'     , Descr = "De componenten die Component 'Samen' samenvoegt, gescheiden door komma's: een deel van Lopen, Fiets en Auto (overleg PBL 5-10-2026, #117). Hun uitvoer moet er zijn, met hetzelfde OutputLabel, dezelfde peildatum, hetzelfde dagdeel en dezelfde herkomsten en bestemmingen, en met Export_PriceInformation.";
	parameter<string>   Orgset                            := 'BAG_woonpanden_Clustered'                , Descr = "Select the origin set, defined in Advanced/org_domain_list.";              
	parameter<string>   Destset                           := 'OV_Knooppunten'                , Descr = "Select the destination set, defined in Advanced/dest_domain_list.";       
	parameter<string>   CentroidWeightType                := 'Addresses'            , Descr = "If you want to use weighted centroids for origins, how would you like to weigh the values comprsing the coentroid? Via addresses or population?";
	parameter<string>   Orgset_EnkeleBuurt_Selection      := 'BU0363AD05'           , Descr = "If you choose 'enkele_buurt' in the OrgSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Orgset_EnkeleGem_Selection        := 'Dronten'              , Descr = "If you choose 'enkele_gem' in the OrgSet, which municipality would you like? Use the municipality name.";
	parameter<string>   Orgset_EnkeleProv_Selection       := 'Zuid_Holland'         , Descr = "If you choose 'enkele_prov' in the OrgSet, which provincie would you like? Use the province name.";
	parameter<string>   Orgset_EnkeleCorop_Selection      := 'Kop_van_Noord_Holland', Descr = "If you choose 'enkele_corop' in the OrgSet, which COROP would you like? Use the corop name.";
	
	parameter<string>   Destset_Enkele_Selection          := 'BU0363ET02'           , Descr = "If you choose 'enkele_buurt' in the DestSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Destset_EnkeleCorop_Selection     := 'Twente'               , Descr = "If you choose 'enkele_corop' in the DestSet, which COROP would you like? Use the corop name.";
	parameter<string>   Destset_EnkeleProv_Selection      := 'Zuid_Holland'         , Descr = "If you choose 'enkele_prov' in the DestSet, which province would you like? Use the province name.";
	parameter<bool>     Export_TravelledDistance          := TRUE                   , Descr = "Would you like to export the travelled distance along with the other attributes in the case of private and public transport?";
	parameter<string>   OutputLabel                       := 'basis'                , Descr = "Korte naam van de variant waarvan de OV-uitvoer is (sinds 2026-10-03, NetworkModel_PBL#118). De uitvoer staat in %LocalDataProjDir%/Output/<Analysis_date>_<OutputLabel> (Advanced/OutputDir), met in de bestandsnamen alleen datum, vertrekmoment en blok; de parameters staan in signature.txt in die map. Een andere parameterset onder hetzelfde label faalt bij het schrijven op die handtekening: kies dan een ander label, of laat batch/UpdateAll.cmd output de map leegmaken. Alleen letters, cijfers, - en _, hoogstens 20 tekens.", IntegrityCheck = "strlen(this) >= 1 && strlen(this) <= 20 && strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
	parameter<bool>     Export_PriceInformation           := TRUE                   , Descr ="Would you like to export the price information along with the other attributes in the case of public transport? Since 2026-10-02 this includes Price split into pre-transport, public transport and post-transport (PretransPrice, PTPrice, PosttransPrice), like the travel time, and since 2026-10-03 per mode (WalkingPrice, CyclingPrice, CarPrice). TRUE since 2026-10-03 (was FALSE).";
	
	//OV-berekening instellingen
	parameter<string>   GTFS_file_date                    := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/GTFS_file_date)
	, Descr = "De GTFS-feed (map en mmd-store onder %NetworkModel_Dir%/Infrastructuur/GTFS) van de peildatum, sinds 2026-10-05 uit Advanced/AnalysisMomentPresets (#125); tot dan een eigen waarde, die een runkopie naast Analysis_date zette. De feed moet de dienstdagen D-1, D en D+1 van Analysis_date dekken (LoadFeeds/ServiceDays). Zie de wiki, How to run the model, step 2."
	, IntegrityCheck = "strlen(this) == 8";
	parameter<string>   Analysis_date                     := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/Analysis_date)
	, Descr = "De dag van de OV-analyse, sinds 2026-10-05 uit Advanced/AnalysisMomentPresets: de peildatum van AnalysisMoment (#125). Since 2026-09-25 the network is built from the service days D-1, D and D+1 of this date on one time axis, and SourceData/Infrastructure/GTFS/LoadFeeds/ServiceDays checks that the feed has a complete timetable on each day the analysis window needs (see Advanced/MinServiceDayTripShare). Until then the date had to lie within GTFS_file_date + 100, computed on the digits (audit 3.5)."
	, IntegrityCheck = "strlen(this) == 8";

	parameter<min_f>    MaxWalkingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum walking time from origin towards destination";
	parameter<min_f>    MaxWalkingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum walking time from origin towards first stop";
	parameter<min_f>    MaxWalkingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum walking time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxWalkingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum walking time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxWalkingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum walking time from origin towards first InterCity train station";
	parameter<min_f>    MaxWalkingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum walking time from last stop towards destination";
	parameter<min_f>    MaxWalkingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum walking time from last stop which is an OV-fiets station towards destination";
	parameter<min_f>    MaxWalkingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum walking time from last stop which is a RMT station towards destination";
	
	parameter<min_f>    MaxCyclingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum cycling time from origin towards destination";
	parameter<min_f>    MaxCyclingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxCyclingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxCyclingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first InterCity train station";
	parameter<min_f>    MaxCyclingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is an OV-fiets station towards destination";
	parameter<min_f>    MaxCyclingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is a RMT station towards destination";
	
	parameter<min_f>    MaxPTTime                         := 90[min_f]              , Descr = "Maximum travel time using public transport, including transfers and waiting. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<min_f>    MaxTravelTime                     := 90[min_f]              , Descr = "Maximum travel time of the complete journey. Only relevant for public transport analysis. Note that limiting this value might result in not being able to reach all destinations.";
	
	parameter<string>   MinimiseCriteria                  := 'Price,Time'             , Descr = "Would you like to find the fastest or cheapest public transport journey? Choices: 'Price', 'Price_Augm' or 'Time' or both, i.e. 'Price,Time'. Sinds 2026-10-01 ook 'Car' en 'Bike' (NetworkModel_PBL#117): autobezit en fietsbezit als criteria in de eindafweging per vertrekmoment (Classifications/OwnershipParetoAttr), niet in de ketenrijger. Zonder 'Car' valt een OV-keten af die duurder en langzamer is dan de directe autorit. Sinds 2026-10-05 weer 'Price,Time' (was 'Price,Time,Car,Bike'): elke component (Component) rekent op prijs en tijd, de bezitscriteria horen bij het samenvoegen van de componenten (overleg PBL 5-10-2026, #117). Met Component 'Alles' geeft 'Price,Time,Car,Bike' de eindafweging van 2026-10-01 tot 2026-10-05.";
	
	parameter<euro_min> Transfer_Walking_Time_Costs       := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Transfer_Waiting_Time_Costs       := 0.05[euro_min]         , Descr = "To attach a value to waiting, the cost thereof (or the time it takes) is incorporated.";
	parameter<euro_min> PreTransport_Walking_Time_Costs   := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> PostTransport_Walking_Time_Costs  := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Walking_Time_Costs         := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Cycling_Time_Costs         := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PreTransport_Cycling_Time_Costs   := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PostTransport_Cycling_Time_Costs  := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	
	//Auto berekening instellingen
	parameter<min_f>    MaxCarTime                        := 90[min_f]              , Descr = "Maximum travel time using car transport. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<bool>     UseTomTomNetworkForCars           := TRUE                   , Descr = "Would you like to use the TomTom network car analysis? Or if not, the OSM network is used.";
	
	//Directe ritten naast het OV. De ketenrijger voegt per HB-paar de directe rit(ten) bij de OV-ketens en houdt
	//het Pareto-front op MinimiseCriteria (prijs, tijd) over; zie NetworkSetup/PublicTransport_Prep/Direct_OD.
	//Tot 2026-09-23 deed of lopen of fietsen mee (AllowDirectCyclingOverWalking) en de auto helemaal niet. Sinds 2026-10-05 volgen de drie schakelaars uit Component (#117).
	parameter<bool>     AllowDirectWalking                := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectWalking) : rjoin(Component, Advanced/Componenten/name, Advanced/Componenten/DirectWalking), Descr = "Doet de directe looproute (OSM-loopnetwerk, tot MaxWalkingTime_Org2Dest) mee in het front per HB-paar? Sinds 2026-10-05 uit Component (Advanced/Componenten/DirectWalking, #117), bij Samen: of een van de samengevoegde componenten hem heeft; tot dan TRUE.";
	parameter<bool>     AllowDirectCycling                := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectCycling) : rjoin(Component, Advanced/Componenten/name, Advanced/Componenten/DirectCycling), Descr = "Doet de directe fietsroute (OSM-fietsnetwerk, tot MaxCyclingTime_Org2Dest) mee in het front per HB-paar? Sinds 2026-10-05 uit Component (Advanced/Componenten/DirectCycling, #117), bij Samen: of een van de samengevoegde componenten hem heeft; tot dan TRUE.";
	parameter<bool>     AllowDirectCar                    := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectCar) : rjoin(Component, Advanced/Componenten/name, Advanced/Componenten/DirectCar), Descr = "Doet de directe autorit (TomTom of OSM, zie UseTomTomNetworkForCars, tot MaxCarTime) mee in het front per HB-paar? Sinds 2026-10-05 uit Component (Advanced/Componenten/DirectCar, #117), bij Samen: of een van de samengevoegde componenten hem heeft; tot dan TRUE. De autoprijs is afstand x Car_CostPerKm (hieronder).";
	parameter<string>   Car_CongestionMoment_ForDirect    := UseTomTomNetworkForCars ? rjoin(Dagdeel, Advanced/Dagdelen/name, Advanced/Dagdelen/CongestionMoment) : 'MaxSpeed'
	, Descr = "Welke reistijd van de auto de directe rit gebruikt: 'MorningRush' (07:30), 'NoonRush' (12:30), 'LateEveningRush' (19:30) of 'Freeflow' (alleen TomTom; bij OSM heet dat 'MaxSpeed'). Sinds 2026-10-05 (#125) volgt het moment uit Dagdeel (Advanced/Dagdelen/CongestionMoment): het midden van het uur van de vier vertrekmomenten. Tot dan stond het vast op MorningRush en zette een runkopie voor de middag hier NoonRush."
	, IntegrityCheck = "UseTomTomNetworkForCars ? Car_CongestionMoment_ForDirect != 'MaxSpeed' : Car_CongestionMoment_ForDirect == 'MaxSpeed'"; // TomTom kent Freeflow/MorningRush/NoonRush/LateEveningRush; OSM alleen MaxSpeed, want de OSM-spitsen zijn null-placeholders
	parameter<Euro_km>  Car_CostPerKm                     := 0.24[Euro_km]          , Descr = "Autokosten per km (overleg PBL 5-10-2026, #88): de prijs van de directe autorit is zijn afstand maal Car_CostPerKm, plus Car_FixedCosts_PerTrip. Vervangt Car_VariableCosts_PerKm (0,20), Car_FixedCosts_PerKm (0,21) en Advanced/IncludeCarFixedCostsInPrice, en de kilometerprijs per wegklasse en de optrekkosten op kruispunten (2026-09-23 tot 2026-10-05).";
	parameter<Euro>     Car_FixedCosts_PerTrip            := 0[Euro]                , Descr = "Vast bedrag per autorit, bijvoorbeeld parkeren; 0 tot daar een waarde voor is.";
	parameter<min_f>    Car_StartTime                     := 2[min_f]               , Descr = "Starttijd van een autorit: naar de auto lopen, instappen, wegrijden. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	parameter<min_f>    Car_ParkingTime                   := 3[min_f]               , Descr = "Parkeertijd aan het eind van een autorit: parkeerplek zoeken en naar de bestemming lopen. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	// HET AUTOFRONT (sinds 2026-10-05, #88). De directe autorit is per HB-paar een Pareto-front op reistijd en afstand
	// (Advanced/ParetoLegs_Car: impedance_matrix_od64 met de pareto-optie, de afstand als alternatieve impedantie), en
	// de kosten volgen achteraf: afstand x Car_CostPerKm + Car_FixedCosts_PerTrip. Met een prijs per km is dat front
	// ook het front op reistijd en kosten. Tot dan was het tweede criterium de som van linkkosten, met een kilometerprijs
	// per TomTom-wegklasse en optrekkosten op kruispunten (eeb5c5b, cc725b1, 0af2a3d, b33d315, 18e9368), en droeg het
	// front de afstand niet.

	container Advanced : using = "classifications"
	{
		/// GENERAL
		// BUURT NAAR BUURT (overleg PBL 5-10-2026, #126): twee buurtvarianten, elk met de CBS-buurtgrenzen en de BAG van
		// hetzelfde jaar, en met hetzelfde punt als herkomst en als bestemming: het zwaartepunt van de woonadressen van de
		// buurt (SourceData/RegioIndelingen/Buurt/address_weighted_centroid; een buurt zonder woningen krijgt het midden van
		// zijn vlak). Buurt2023 hoort bij de peildata 2015, 2023 en 2024, Buurt2025 bij 2025 en 2026; de presets van die
		// peildata hebben dezelfde Regios en BAG_snapshot, zodat ook 'Buurt' en de BAG-herkomsten die variant volgen.
		unit<uint8> Buurtsets : nrofrows = 2
		, Descr = "De buurtvarianten (#126). Kies er een als Orgset en Destset (org_domain_list, dest_domain_list): dan gelden zijn RegioIndelingen_year en BAG_snapshot, welke peildatum ook gekozen is."
		{
			attribute<string> name                 : ['Buurt2023', 'Buurt2025'];
			attribute<string> RegioIndelingen_year : ['2023', '2025'];
			attribute<string> BAG_snapshot         : ['20230101.new', '20250101.new'];
		}
		parameter<Buurtsets> Buurtset_Org                             := rlookup(lowercase(/ModelParameters/Orgset), lowercase(Buurtsets/name)), Descr = "De buurtvariant van de herkomsten, of null.";
		parameter<Buurtsets> Buurtset_Dest                            := rlookup(lowercase(/ModelParameters/Destset), lowercase(Buurtsets/name)), Descr = "De buurtvariant van de bestemmingen, of null.";
		parameter<Buurtsets> Buurtset                                 := MakeDefined(Buurtset_Org, Buurtset_Dest)
		,	Descr = "De buurtvariant van de run: die van de herkomsten, anders die van de bestemmingen, anders null (dan gelden de presets van AnalysisMoment). Er is een BAG en een gebiedsindeling per run, dus herkomsten en bestemmingen kunnen geen verschillende buurtvarianten zijn."
		,	IntegrityCheck = "!IsDefined(Buurtset_Org) || !IsDefined(Buurtset_Dest) || Buurtset_Org == Buurtset_Dest";
		parameter<string>   BAG_snapshot                              := IsDefined(Buurtset) ? Buurtsets/BAG_snapshot[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/BAG_snapshot)
		,	Descr = "Naam van de BAG-snapshotmap onder %BAG_DataDir%/BAG/snapshots.ext: die van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders per AnalysisMoment in de presettabel. Stond tot 2026-09-22 vast aan RegioIndelingen_year, maar de BAG-standdatum en de CBS-gebiedsindeling lopen niet gelijk: voor Y2026 is er een BAG-snapshot per 1-1-2026 terwijl de gebiedsindeling 2026 nog geen buurt- en wijkkaart heeft.";
		parameter<string>   BAG_year                                  := substr(BAG_snapshot, 0, 4)
		,	Descr = "Het jaar van de BAG-snapshot, uit BAG_snapshot. Wordt gebruikt om bouwjaren na de standdatum af te kappen en in de exportnamen.";
		parameter<string>   RegioIndelingen_year                      := IsDefined(Buurtset) ? Buurtsets/RegioIndelingen_year[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/RegioIndelingen_year)
		,	Descr = "Het jaar van de CBS-gebiedsindeling: dat van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders per AnalysisMoment in de presettabel.";
		parameter<string>   LISA_year                                 := '2018'                 , Descr = "Which year of the LISA-dataset would you like to use?";
		parameter<bool>     Dests_geclusterd                          := FALSE                  , Descr = "Would you like to cluster destinations? For example useful for firm destinations, with many firms at the same location. To determine the area of clustering look at Dest_location_scale";
		parameter<string>   Dest_location_scale                       := '100m'                 , Descr = "If clustering the destination, at which scale would you like to cluster? Options: '100m', '500m', '1000m', '5000m', '10000m', '50000m'";
		parameter<string>   Org_location_scale                        := '500m'                 , Descr = "Celmaat waarop de BAG-herkomsten geclusterd worden (BAG_woonpanden_Clustered).\n"
						"Opties zijn de celmaten uit geometries/Gridsizes: '25m', '100m', '500m', '1000m', '5000m', '10000m', '50000m'.\n"
						"Stond tot 2026-09-22 vast aan Dest_location_scale; op 100m levert de BAG-snapshot van 1-1-2026 588.903 herkomsten, wat de blokindeling en de OD-omvang onwerkbaar maakt.\n"
						"Losgekoppeld omdat de bestemmingen hun eigen maat mogen houden.";
		parameter<string>   items_of_interest                         := rjoin(lowercase(DestSet), lowercase(Advanced/dest_domain_list/label), Advanced/dest_domain_list/items_of_interest), Descr = "What is the item of interest in the analysis? Such as number of jobs. Decided via the dest_set.";
		parameter<bool>     ExcludeOrgBuurtCentroidsWithoutAddressPop := FALSE                  , Descr = "Would yo like to exclude buurt centroid that do not contain addresses or population (depending on CentroidWeightType).";
		parameter<uint32>   MaxPathLength                             := 259                    , Descr = "Het langste bestandspad dat Windows zonder longPathAware toestaat; GeoDMS vraagt geen lange paden aan. Elke storefamilie controleert er vooraf op (Templates/StoreSignature_T/PathGate), zodat een te lang pad faalt voordat er gerekend wordt (NetworkModel_PBL#118).";
		parameter<string>   OutputDir                                 := '%LocalDataProjDir%/Output/' + Analysis_date + '_' + /ModelParameters/OutputLabel + rjoin(/ModelParameters/Component, Componenten/name, Componenten/UitvoerAchtervoegsel)
		,	Descr = "De map met de OV-uitvoer van deze variant (sinds 2026-10-03, NetworkModel_PBL#118; sinds 2026-10-05 met _lopen, _fiets of _auto erachter, de component, #117): PerBlock/tt_<datum>_<moment>_<n>of<N>.csv per herkomstblok en vertrekmoment, tt_<datum>_<moment>.csv per vertrekmoment, tt_<datum>.csv over de vertrekmomenten en signature.txt met de parameters (NetworkSetup/Output_Signature). Tot dan Output/PerBlock en Output, met alle parameters in de bestandsnaam.";
		parameter<string>   fileNamePrefix                            := OutputDir + '/PerBlock/', Descr = "De map van de OV-uitvoer per herkomstblok (en van de exports van lopen, fiets en auto).";
		parameter<uint8>    NumberOfItersForNetworkCleanUp            := 10b                    , Descr = "In the network clean up method, how many iternations should be used?";

		// PUBLIC TRANSPORT
		parameter<string>   NS_TariffChoice                           := 'Price_FullFare'      , Descr = "Which tarif class for NS would you like to use. Full fare, or a discounted fare? Choices: 'Price_FullFare', 'Price_20pct_Discount' of 'Price_40pct_Discount'. Tot 2026-09-25 werkte alleen 'Price_FullFare': de kortingen lazen kolommen die niet bestaan (audit 3.1).";
		parameter<m>        MaxTransferDist                           := 500[m]                 , Descr = "Maximum Euclidean distance between public transport stops that is allowed to be walked for transfers.";
		parameter<string>   Concessiegebied_year                      := value(FareTable_year, uint32) < 2020 ? 'Y2020' : 'Y'+FareTable_year , Descr = "Which year of the concession areas would you like to use? Relevant for public transport price determination. Concessie-shapes bestaan alleen 2020-2026; voor FareTable_year < 2020 (o.a. DOVA-prijzen terug tot 2013) wordt Y2020 als proxy gebruikt.";
		parameter<string>   Concessiegebied_source                    := 'manual'               , Descr = "Use manual creation of concessiegebieden (based on CROW poster), or shapefile from CROW. Options:  manual, shape";
		parameter<string>   FareTable_year                            := substr(GTFS_file_date, 0, 4), Descr = "Prijsjaar; volgt automatisch het jaar van GTFS_file_date, zodat de FareTable-agency-labels altijd bij de geladen feed horen (elke FareTable_<jaar> is uitgelijnd op de agency-set van de feed van dat jaar, zie data/FareTable_dekkingsrapport.md). Detailed-FareTables bestaan voor 2023-2026; voor eerdere jaren schakelt de prijsbepaling automatisch op DOVA (zie Advanced/PriceMethod_effective).";
		parameter<string>   PriceMethod                               := 'DOVA'             , Descr = "OV-prijsmethode: 'Detailed' (handmatige FareTable per Mode/Agency/Concessie/Lijn, zie OVprijzen/FareTable_2023) of 'DOVA' (concessie-brede km-tarieven uit DOVA-overzicht, terug tot 2013). Bij 'DOVA' bepaalt FareTable_year welk jaar (2013-2026) wordt gebruikt.";
		parameter<string>   PriceMethod_effective                     := value(FareTable_year, uint32) < 2023 ? 'DOVA' : PriceMethod, Descr = "Effectieve prijsmethode: Detailed-FareTables bestaan alleen voor 2023-2026, dus voor FareTable_year < 2023 (oudere GTFS-feeds) wordt altijd DOVA gebruikt, ongeacht PriceMethod.";
		parameter<string>   DOVA_year                                 := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaarkolom in het DOVA-overzicht (y2013..y2026); geklemd op dat bereik (bv. feed 20120917 -> 2013-prijzen).";
		parameter<string>   NS_prijzen_year                           := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaargang van de NS-tarieven-csv (data/Tarieven_NS/NS tarieven <jaar>.csv, 2013-2026 aanwezig); geklemd op dat bereik.";
		parameter<string>   NS_tariefnet_year                         := value(NS_prijzen_year, uint32) >= 2016 ? '2016' : '2013', Descr = "Jaargang van het NS-tariefnet (data/Tarieven_NS/NS_tariefnet_<jaar>.csv) bij NS_prijzen_year, sinds 2026-10-04 (NetworkModel_PBL#121). 2013: het NDOV-net (tariefnet.dat) met de gezamenlijke tariefpunten van NS (stations met 0 TE ertussen); 2016: zonder die punten, zoals NS ze per de tarieven van 2016 afschafte (elk stationspaar minstens 1 TE).";
		parameter<m>        DistanceTrainStationsSelection            := 350[m]                 , Descr = "To find out which GTFS-stops relate to which trainstation a geographic search distance is used.";
		parameter<m>        DistanceStopClusters                      := 100[m]                 , Descr = "To cluster stops which belong to the same 'stop' a geographic search distance is used. Stops in opposite directions should be considered the same stop cluster. Travelling from stops within a cluster is non-sensical.";
		parameter<m>        DistanceOVFietsStops                      := 200[m]                 , Descr = "Maximale zoekafstand om OVfiets stations te koppelen aan GTFS haltes.";
		parameter<m>        DistanceKnooppuntClusters                 := 150[m]                 , Descr = "Clusterafstand om GTFS-haltes samen te voegen tot een OV-knooppunt (single linkage via connected_parts). Perrons/haltekommen van hetzelfde knooppunt vallen zo samen.";
		parameter<uint32>   Knooppunt_MinLijnen_BTM                   := 8                      , Descr = "Minimaal aantal unieke bus/tram/metro-lijnen op een haltecluster om als BTM-knooppunt te gelden (kruisende lijnen). Treinstations zijn altijd knooppunt; een solitaire metrohalte niet (die telt via de BTM-lijnen mee). Bij 8 lijnen ca. 270 BTM-knopen excl. metro (GTFS 20260316), schaal TBOV-actieagenda (~700 knooppunten totaal); bij 5 lijnen ca. 780.";
		parameter<uint32>   Knooppunt_MinVertrekken_BTM               := 150                    , Descr = "Minimaal aantal bus+tram+metro-vertrekken per dag (Analysis_date) op een haltecluster om als BTM-knooppunt te gelden. 150/dag komt overeen met ca. 8-10 vertrekken/uur overdag.";
		parameter<float32>  Knooppunt_BedrijfsurenPerDag              := 18f                    , Descr = "Aantal bedrijfsuren per dag waarmee vertrekken/dag wordt omgerekend naar frequentie/uur, t.b.v. de ontsluitingswaarde (vlindermodel).";
		parameter<m>        Knooppunt_DominantieRadius                := 1500[m]                , Descr = "Niet verhogen naar 2000m: dan valt o.a. busstation Drachten weg onder een sterkere kandidaat-halte in de buurt. Dominantiefilter (competitie, vgl. Goudappel 2024): een BTM-knooppunt vervalt als binnen deze straal een kandidaat met hogere netwerkwaarde ligt. Voorkomt reeksen knopen langs HOV-corridors (Zuidas, Uithoflijn), meerdere punten per groot complex (Schiphol) en corridorhaltes zonder eigen regiofunctie naast een station (Anderlechtlaan bij Station Zuid, De Hoek bij Hoofddorp). Een sterke BTM-knoop naast een zwak station blijft gewoon staan (Zoetermeer Centrum West naast Zoetermeer station); treinstations zelf vervallen nooit onder BTM-knopen.";
		parameter<m>        Knooppunt_DedupRadiusTrein                := 400[m]                 , Descr = "Twee treinclusters binnen deze straal (bv. NS-perrons en stadshaltes van hetzelfde station die net buiten de clusterafstand vallen, zoals Sloterdijk) worden ontdubbeld: het cluster met de meeste treinvertrekken blijft. Kortste afstand tussen twee echte NL-stations is ca. 800m, dus 400m is veilig.";
		parameter<uint32>   Knooppunt_MinRichtingen_BTM               := 3                      , Descr = "Minimaal aantal windrichtingen (4 sectoren: O/W/N/Z op basis van de richting naar de volgende halte) waarin BTM-vertrekken het cluster verlaten. Een corridor-bundel (R-net over een as, bv. Ilpendam) heeft er 2; een echt knooppunt met kruisende of uitwaaierende lijnen 3-4. Operationaliseert 'aantal richtingen' uit het vlindermodel.";
		parameter<float32>  Knooppunt_MinNetwerkwaarde_BTM            := 0f                     , Descr = "Optionele extra drempel op de netwerkwaarde (vlindermodel) voor BTM-knooppunten; 0 = uit. Ter referentie (GTFS 20260316): Amsterdam CS 3400, Station Noord 988, Zoetermeer Centrum West 501, Hoofddorp De Hoek 331, Anderlechtlaan 194, Lemmer busstation 111, Zierikzee busstation 78. Let op: een hoge drempel (bv. 500) schrapt vrijwel alle busstations in spoorloze kernen (Zierikzee, Lemmer, Drachten) - precies de knopen waarvoor deze laag is toegevoegd.";
		parameter<min_f>    MaxTransferTimeForBoardingSurcharge       := 35[min_f]              , Descr = "Maximale overstap tijd om binnen opstap basistarief te blijven. Dit is door Nederlands OV-prijs model bepaald. Dus niet zomaar aanpassen.";
		// AllowDirectCyclingOverWalking (of lopen, of fietsen) is op 2026-09-23 vervangen door
		// /ModelParameters/AllowDirectWalking, AllowDirectCycling en AllowDirectCar: de directe ritten doen
		// naast elkaar mee in het front per HB-paar.
		parameter<m_s>      TransferEffectiveSpeed                    := value(4.5[km_hr] / 1.2f, m_s), Descr = "De loopsnelheid tijdens het overstappen. X km/uur / 1.2 (correctie voor Manhattan distances) en dan geconverteerd naar meter/sec.";
		parameter<bool>     IncludeWaitingAtHomeInTravelTime          := FALSE                  , Descr = "Wil je dat de wachttijd thuis wordt meegenomen in de totale reisduur, bij vertrektijd vanaf bepaald moment?";
		parameter<Time>     PT_FirstDepartureMoment                   := first(MeasureMoments/Moment), Descr = "Begin van het analysevenster van het OV: het eerste vertrekmoment, in seconden sinds 00:00 van Analysis_date.";
		parameter<Time>     PT_LastArrivalMoment                      := last(MeasureMoments/Moment) + convert(ModelParameters/MaxPTTime, s_f)[Time] + uint32(NOT(IncludeWaitingAtHomeInTravelTime)) * MaxWaitingTimeAtOrigin
		, Descr = "Einde van het analysevenster van het OV: het laatste vertrekmoment plus MaxPTTime en de wachttijd thuis. Voorbij 24:00 (86400) loopt het venster door in de volgende dag, en gebruikt het netwerk ook de ritten van de dienstdag na Analysis_date.";
		parameter<min_f>    PT_Max_V_Time                             := max(OV_PreTransport_Typen/MaxTime) + Cycling_StartTime + Cycling_PreTransport_Penalty + Cycling_ParkingTime_IC_Station
		, Descr = "Langste voortransportbeen dat nog geldig kan zijn: de grootste Max*Time-grens (op netwerktijd) plus de start- en parkeertijden in het been. Begrenst per vertrekmoment het venster van OV-vertrekken (PerDepartureMoment_T) en het laatste instapmoment van de ketens.";
		parameter<Time>     PT_LastBoardingMoment                     := last(MeasureMoments/Moment) + convert(PT_Max_V_Time, s_f)[Time] + MaxWaitingTimeAtOrigin
		, Descr = "Laatste instapmoment waarop een keten nog gebruikt kan worden: het laatste vertrekmoment plus het langste voortransport en de wachttijd thuis, de bovengrens van Within_VW_Window. Sinds 2026-09-29 begint de ketenstap geen ketens meer die later instappen (bij 07:00-07:45 op haltenblok 1: 9,9% van de frontrijen, die de uitvoerstap nooit gebruikte).";
		parameter<Time>     PrevServiceDayTailEnd                     := 21600[Time]           , Descr = "De ritten van de dienstdag voor Analysis_date die na middernacht doorrijden (GTFS-tijd 24:00 en later) vertrekken vrijwel alle voor 06:00 (in de feed 20260316 99,9%); begint het analysevenster eerder, dan moet die dag compleet in de feed staan.";
		parameter<float32>  MinServiceDayTripShare                    := 0.95f                  , Descr = "Minimaal aandeel ritten van elke dienstdag die het analysevenster nodig heeft, ten opzichte van de drukste dag van dezelfde weekdag in de feed. Een feed is na een paar weken onvolledig (20260316: -6% na drie weken, -9% na vier, vanaf juli minder dan de helft) en een feestdag rijdt een zondagsdienst; verlaag dit alleen bewust.";
		parameter<Time>     MaxWaitingTimeAtOrigin                    := 899[Time]             , Descr = "Maximale wachttijd thuis. Zet je dit hoog, zonder dat dit in de reistijd zit (WeighingWaitingAtOriginPreTransport = 0) dan kun je ongemerkt veel later vertrekken dan je denkt.";
		parameter<min_f>    GradeSeparatedTransferPenalty             := 0[min_f]               , Descr = "Does a public transport stop have a lot of vertical distance to traverse? In that case a time penalty will be given when traffering through that stop.";
		parameter<min_f>    Cycling_StartTime                         := 1[min_f]               , Descr = "Starttijd van elke fietsrit: fiets pakken en wegrijden. Opgeteld bij de reistijd van de directe fietsrit, van elk fietsbeen in het voortransport en van elk fietsbeen in het natransport. Eerste aanname, door PBL te zetten.";
		parameter<min_f>    Cycling_PreTransport_Penalty              := 0[min_f]               , Descr = "Parkeertijd van de fiets aan het eind van ELK fietsbeen in het voortransport (bij een halte of station). Sinds 2026-09-23 opgeteld in de OD-matrix van het been zelf (CreateNetwork_Pedestrian_Bike_T/ODMatrix/ExtraTime_seconds), niet meer apart in de ketenrijger.";
		parameter<min_f>    Cycling_ParkingTime_IC_Station            := 3[min_f]               , Descr = "EXTRA parkeertijd, bovenop Cycling_PreTransport_Penalty, voor een fietsbeen in het voortransport dat eindigt op een IC-station (een halte in PublicTransport_Prep/Impl/Ric_Stops; sinds 2026-10-05 bij elk type fietsvoortransport, ook Org2Stops_Cycling in de component Fiets, #117; tot dan alleen bij het type Org2Ric_Stops_Cycling, StopClass 'Ric'): grote stallingen, langer lopen naar het perron. Punt 3 van de planning van week 38. Eerste aanname, door PBL te zetten.";

		// FLEXVERVOER: GEBIEDSVERVOER OP AFROEP EN BELBUSSEN (ObjectVision/NetworkModel_PBL#113, #116)
		// Bravoflex, U-flex, SyntusFlex, FlexRRReis, Overal Flex, Texelhopper, Opstapper en belbussen staan in de
		// GTFS-feeds als gewone lijnen met ritten, maar moeten 30-60 min vooraf geboekt worden. NeTEx heeft er geen
		// gebiedsgeometrie voor (alleen de BISON flex-markering), dus de herkenning loopt op lijnnaam
		// (SourceData/Infrastructure/GTFS/RelevantSelection/Routes/IsFlex).
		// Sinds 2026-09-30 vier parameters in plaats van FlexMode ('asis', 'exclude', 'penalty') en FlexBoardingPenalty:
		// IsFlexMeenemen = FALSE is het oude 'exclude'; meenemen met FlexMinInterval, FlexExtraWaitingTime en FlexCallCosts
		// alle drie 0 is het oude 'asis' (dezelfde cache-namen); alleen FlexExtraWaitingTime > 0 is het oude 'penalty'.
		// Standaard sinds 2026-10-05 (overleg PBL, #116): meenemen, met 15 min, 30 min en 0,00 euro; tot dan 5 min, 5 min en
		// 0,15 euro. De flextag van ketenstore en uitvoer (Flex_FileTag) is daarmee '_flex15i30w0ct'.
		parameter<bool>     IsFlexMeenemen                            := TRUE                   , Descr = "Neemt het model het flexvervoer (Routes/IsFlex: gebiedsvervoer op afroep en belbussen) mee? FALSE = alle links (rit- en wachtlinks) van flexlijnen uit het OV-net (tot 2026-09-30 FlexMode 'exclude'). De OV-knooppunten tellen de flexvertrekken hoe dan ook mee.";
		parameter<min_f>    FlexMinInterval                           := 15[min_f]              , Descr = "Minimum tijdsinterval tussen de ritten (opties) van een flexlijn. Per ritpatroon (route, eerste en laatste halte, aantal haltes) blijft per blok van dit interval, geteld vanaf 00:00 van de GTFS-dag, alleen de eerste rit in het OV-net (SourceData/Infrastructure/GTFS/LoadFeeds/FlexOptions). De feeds van 2026 roosteren U-flex Maarssen/Utrecht-Noordwest en Houten-Schalkwijk deels als rit per minuut in (296 tot 728 ritten per richting per dag); dat gaf ~550 OV-benen per vertrek en haltenblokken van 150-200 GB. Patronen die al ruimer rijden raakt het niet. 0 = niet dunnen. 15 min sinds 2026-10-05 (overleg PBL, #116), tot dan 5.", IntegrityCheck = "this >= 0[min_f]";
		parameter<uint32>   FlexMinInterval_sec                       := uint32(round(convert(FlexMinInterval, s_f))), Descr = "FlexMinInterval in hele seconden, voor de blokken van LoadFeeds/FlexOptions.";
		parameter<min_f>    FlexExtraWaitingTime                      := 30[min_f]              , Descr = "Extra wachttijd per instap op een flexlijn, opgeteld bij de reistijd van het been: de beltijd en de onzekerheid over het aanrijtijdstip. Telt mee in de MaxPTTime-grens, net als GradeSeparatedTransferPenalty, en maakt TravelTime een criterium van de ketenrijger (Classifications/ChainJoinerParetoAttr_Candidates/HasTimePenalty). Tot 2026-09-30 FlexBoardingPenalty bij FlexMode 'penalty' (standaard 20 min). 30 min sinds 2026-10-05 (overleg PBL, #116), tot dan 5.", IntegrityCheck = "this >= 0[min_f]";
		parameter<Euro>     FlexCallCosts                             := 0.00[Euro]             , Descr = "Belkosten per instap op een flexlijn, opgeteld bij de prijs van het been (in Price_O, want dat deel telt de ketenrijger bij elke overstap op; Price_I wordt binnen een reis gemaximeerd). 0,00 sinds 2026-10-05 (overleg PBL, #116), tot dan 0,15.", IntegrityCheck = "this >= 0[Euro]";
		parameter<bool>     FlexHasTimePenalty                        := IsFlexMeenemen && FlexExtraWaitingTime > 0[min_f], Descr = "Krijgt een flexbeen extra wachttijd bij zijn reistijd?";
		parameter<string>   Flex_FileTag                              := not(IsFlexMeenemen) ? '_noflex' : (FlexMinInterval > 0[min_f] || FlexExtraWaitingTime > 0[min_f] || FlexCallCosts > 0[Euro] ? '_flex' + string(round(FlexMinInterval)) + 'i' + string(round(FlexExtraWaitingTime)) + 'w' + string(round(FlexCallCosts * 100f)) + 'ct' : ''), Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature) en van de OV-uitvoer (PT_Output_ParamTag): '_noflex' zonder flex, '_flex<interval>i<wachttijd>w<belkosten in ct>ct' met de flexparameters, leeg als die alle drie 0 zijn. Tot 2026-09-30 FlexMode_FileTag ('_noflex', '_flexpen<n>min' of leeg).";
		unit<uint8> FlexRouteTerms : nrofrows = 4
		, Descr = "Zoektermen (kleine letters, regex-alternatieven) waarop een GTFS-route als flex geldt; gezocht in lowercase(route_short_name + ' ' + route_long_name). Bewust smal: 'buurtbus'/'wijkbus' (dienstregeling), 'hopper' (Spijkhopper/Maasvlaktehopper zijn gewone EBS-lijnen), 'vlinder' (Arriva-kleinbussen op dienstregeling en de plaatsnaam 'Zaandam De Vlinder') en 'taxibus i.p.v. trein' (treinvervangend) horen er NIET in; die staan als bijna-treffers in FlexNearMissTerms en /FlexReport/NearMiss."
		{
			attribute<string> term        : ['flex', 'texelhopper', 'opstapper', 'belbus'];
			attribute<string> toelichting : ['Bravoflex (Arriva), Connexxion FLEX, Overal Flex, FlexRRReis, SyntusFlex, U-flex', 'Texelhopper (TXL)', 'Opstapper Fryslan (Arriva/Qbuzz)', 'belbus, generiek'];
		}
		parameter<string>   FlexRoutePattern                          := asList(FlexRouteTerms/term, '|');
		unit<uint8> FlexNearMissTerms : nrofrows = 5, Descr = "Termen die op flex lijken maar (nu) niet als flex gelden; alleen voor /FlexReport/NearMiss."
		{
			attribute<string> term : ['buurtbus', 'wijkbus', 'hopper', 'vlinder', 'taxi'];
		}
		parameter<string>   FlexNearMissPattern                       := asList(FlexNearMissTerms/term, '|');

		// RIT-OPSLAG VOOR SPECIALE TREINEN EN NS INTERNATIONAL (ObjectVision/NetworkModel_PBL#3, sinds 2026-10-02)
		// De NS-prijs van een reis volgt uit de tariefeenheden van het stationspaar (begin en eind van de NS-reis), over de
		// klassieke route: de HSL telt voor het tarief niet mee (SourceData/Infrastructure/OVprijzen/NS/Tariefnet_UitgeslotenKanten).
		// Wie tussen Schiphol en Rotterdam over de HSL reist (Intercity direct, Eurocity Direct) of binnenlands de ICE neemt,
		// betaalt daarbovenop per rit een toeslag. Die hangt van de rit af, niet van het stationspaar: hij komt per NS-been bij
		// de prijs (Price_S in PublicTransport_Prep/OD_L) en de ketenrijger telt hem los van het doorgaande NS-tarief op.
		parameter<bool>     IsRitOpslagMeenemen                       := TRUE                   , Descr = "Telt de rit-opslag van de treinen in RitOpslagTreinen mee in de prijs, en hun ExtraTijd in de reistijd? FALSE = geen toeslag, zoals tot 2026-10-02.";
		parameter<bool>     IsNSInternationalInLnet                   := TRUE                   , Descr = "Doen de treinen van NS International (Eurocity Direct, EuroCity, ICE, IC Berlijn) mee in het NS-net (L-net) voor binnenlandse reizen, met het NS-tarief en hun rit-opslag? Treinen waarop een NS-kaartje nooit geldt (Eurostar, Nightjet) vallen er toch uit: zie TreinenZonderNSKaartje, en de GTFS staat op hun NL-haltes meestal geen in- of uitstappen toe (pickup_type of drop_off_type 1). FALSE = alle NS International-treinen buiten het net, zoals tot 2026-10-02.";
		unit<uint8> RitOpslagTreinen : nrofrows = 2
		, Descr = "Treinproducten met een rit-opslag. Station_A en Station_B: NS-stationscodes van het traject waarover de opslag geldt; een been betaalt hem als zijn rit tussen in- en uitstappen beide stations aandoet. Leeg: elk been op het product betaalt hem. ExtraTijd: extra reistijd per instap, zoals FlexExtraWaitingTime (bijvoorbeeld voor reserveren). Het bedrag per jaar staat in SourceData/Infrastructure/OVprijzen/NS/RitOpslag; welke routes bij een product horen in RitOpslagRouteNamen."
		{
			attribute<string> name        : ['HSL_Schiphol_Rotterdam', 'ICE_binnenland'];
			attribute<string> Station_A   : ['shl', ''];
			attribute<string> Station_B   : ['rtd', ''];
			attribute<min_f>  ExtraTijd   : [0, 0];
			attribute<string> toelichting : ['NS-toeslag ICE/IC direct tussen Schiphol Airport en Rotterdam Centraal (sinds 15-12-2013 alleen dit traject), ook in de Eurocity Direct; Breda-Rotterdam over de HSL is toeslagvrij', 'NS-toeslag ICE/IC direct op elk binnenlands traject van de ICE (Amsterdam-Utrecht-Arnhem, Amsterdam-Amersfoort-Hengelo)'];
		}
		unit<uint8> RitOpslagRouteNamen : nrofrows = 4
		, Descr = "De route_short_name's (kleine letters, exact) waaraan een route van het L-net een product van RitOpslagTreinen herkent; zie SourceData/Infrastructure/GTFS/RelevantSelection/Routes/RitOpslag_rel. 'Intercity direct' heet zo bij NS en NS International (2024: HSN-treinen, 2025-2026: ICD-treinen), de ICE heet 'ICE International' (2024-2025) of 'ICE' (2026)."
		{
			attribute<string>           route_short_name : ['intercity direct', 'eurocity direct', 'ice', 'ice international'];
			attribute<RitOpslagTreinen> RitOpslag_rel    : [0, 0, 1, 1];
		}
		unit<uint8> TreinenZonderNSKaartje : nrofrows = 4
		, Descr = "Treinproducten van het L-net waarop een NS-kaartje nooit geldt (alleen een eigen kaartje met reservering), op route_short_name (kleine letters, exact); hun ritten doen niet mee in het L-net (PublicTransport_Prep/Set_L, GTFS/RelevantSelection/Routes/IsZonderNSKaartje). Nodig naast pickup_type/drop_off_type: in de feed van 20241001 laten 4 van de 30 Eurostar-ritten Amsterdam-Parijs uitstappen in Rotterdam toe, met een Eurostar-kaartje."
		{
			attribute<string> route_short_name : ['eurostar', 'thalys', 'nightjet', 'european sleeper'];
		}
		parameter<bool>     RitOpslagHasTimePenalty                   := IsRitOpslagMeenemen && max(RitOpslagTreinen/ExtraTijd) > 0[min_f], Descr = "Krijgt een been met rit-opslag extra reistijd?";
		parameter<string>   RitOpslag_Flags                           := (IsNSInternationalInLnet ? '' : 'I') + (IsRitOpslagMeenemen ? (RitOpslagHasTimePenalty ? 'w' + string(round(sum(RitOpslagTreinen/ExtraTijd))) : '') : 'R');
		parameter<string>   RitOpslag_FileTag                         := RitOpslag_Flags == '' ? '' : '_' + RitOpslag_Flags
		, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature) en van de OV-uitvoer (PT_Output_ParamTag): leeg met de standaard (NS International mee, rit-opslag mee, geen extra tijd), anders '_' met I (zonder NS International), R (zonder rit-opslag) of w<min> (extra tijd in minuten). Zo kort omdat het langste uitvoerpad toen de tags nog in de bestandsnamen stonden al 256 van de 259 tekens was (NetworkModel_PBL#118).";

		parameter<bool>     IncludeWalkingCostsInPrice                := FALSE                  , Descr = "Wil je reistijdkosten van lopen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCyclingCostsInPrice                := TRUE                   , Descr = "Wil je reistijdkosten van fietsen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCarCostsInPrice                    := TRUE                   , Descr = "Telt de kostprijs van de directe autorit (Car_FixedCosts_PerTrip + afstand x Car_CostPerKm) mee in Price? Zo niet, dan is de auto in het front gratis en wint hij op prijs altijd.";
		
		// COMPONENTEN (overleg PBL 5-10-2026, #117): lopen, fiets en auto als aparte runs, elk met een eigen uitvoermap. Elke
		// component kiest op MinimiseCriteria (prijs en tijd); autobezit en fietsbezit horen bij het samenvoegen. De OV-fiets vraagt
		// geen eigen fiets (Classifications/TimeInvariantTypes/NeedsOwnBike); een e-bike is in te stellen met de fietsparameters.
		unit<uint8> Componenten : nrofrows = 5
		, Descr = "De componenten, te kiezen met /ModelParameters/Component. Voortransport en Natransport zijn namen uit Classifications/TimeInvariantTypes, gescheiden door een ;. Bij Auto doet het OV niet mee (MetOV), en tellen voor- en natransport niet; de lijst mag toch niet leeg zijn. Alles is de run van 2026-09-23 tot 2026-10-05: lopen + OV + lopen naast alle directe ritten. Samen rekent niets zelf: het voegt de uitvoer van de componenten in MergeComponents samen (NetworkSetup/ComponentMerge)."
		{
			attribute<string> name                 : ['Lopen', 'Fiets', 'Auto', 'Alles', 'Samen'];
			attribute<string> Voortransport        : ['Org2Stops_Walking', 'Org2Stops_Cycling', 'Org2Stops_Walking', 'Org2Stops_Walking', 'Org2Stops_Walking'];
			attribute<string> Natransport          : ['Stops2Dest_Walking', 'Stops2Dest_Walking;OVF_Stops2Dest_Cycling', 'Stops2Dest_Walking', 'Stops2Dest_Walking', 'Stops2Dest_Walking'];
			attribute<bool>   DirectWalking        : [TRUE, FALSE, FALSE, TRUE, FALSE];
			attribute<bool>   DirectCycling        : [FALSE, TRUE, FALSE, TRUE, FALSE];
			attribute<bool>   DirectCar            : [FALSE, FALSE, TRUE, TRUE, FALSE];
			attribute<bool>   MetOV                : [TRUE, TRUE, FALSE, TRUE, FALSE], Descr = "Doen de OV-ketens mee? Zonder OV leest de eindafweging per vertrekmoment alleen de directe ritten, en hoeft er geen ketenstore te zijn. Samen rekent niets.";
			attribute<string> UitvoerAchtervoegsel : ['_lopen', '_fiets', '_auto', '', '_samen'], Descr = "Achter OutputLabel in de naam van de uitvoermap (OutputDir); leeg bij Alles, zodat die de map van voor 2026-10-05 houdt.";
			attribute<bool>   IsMergeable          : [TRUE, TRUE, TRUE, FALSE, FALSE], Descr = "Kan deze component in MergeComponents staan?";
			attribute<uint32> BlokkenPerPortie     : [50, 50, 50, 50, 10], Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap (batch/WriteOutputBlocks.ps1, sinds 2026-10-07); 0 = alle blokken in een portie. Elke portie betaalt de opstart opnieuw (Y2023, Buurt2023 naar Buurt2023: tot het eerste blok 2,5 min bij Auto, 5 bij Fiets, 6 bij Lopen, 1,5 bij Samen); een kleinere portie houdt het geheugen lager als dat per blok groeit (Samen: ongeveer 7 GB per blok, vandaar 10). De omgevingsvariabele OUTPUT_BATCHSIZE gaat hier boven.";
			attribute<bool>   InMerge              := IsMergeable && IsDefined(strpos(',' + lowercase(/ModelParameters/MergeComponents) + ',', ',' + lowercase(name) + ',')), Descr = "Staat deze component in MergeComponents?";
		}
		parameter<bool>     IsSamen                                   := /ModelParameters/Component == 'Samen', Descr = "Voegt deze run de componenten samen (Component 'Samen')?";
		parameter<bool>     MetOV                                     := rjoin(/ModelParameters/Component, Componenten/name, Componenten/MetOV), Descr = "Doen de OV-ketens mee in deze run (Componenten/MetOV)? Niet bij de component Auto.";
		parameter<string>   Component_Voortransport                   := rjoin(/ModelParameters/Component, Componenten/name, Componenten/Voortransport);
		parameter<string>   Component_Natransport                     := rjoin(/ModelParameters/Component, Componenten/name, Componenten/Natransport);
		parameter<uint32>   BlokkenPerPortie                          := rjoin(/ModelParameters/Component, Componenten/name, Componenten/BlokkenPerPortie), Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap van deze component (Componenten/BlokkenPerPortie).";

		unit<uint8> DirectModes : nrofrows = 3
		, Descr = "De directe modaliteiten die naast het OV in het front per HB-paar kunnen meedoen, met hun schakelaar. De naam is de naam van de bron onder NetworkSetup/PublicTransport_Prep/Direct."
		{
			attribute<string> name    : ['Walking', 'Cycling', 'Car'];
			attribute<string> abbrev  : ['W', 'C', 'A'], Descr = "Letter van de modaliteit in ModeUsed (Modes/Selection/name_abbr); een directe rit heet in de uitvoer WW, CC of AA.";
			attribute<bool>   Allowed := union_data(., /ModelParameters/AllowDirectWalking, /ModelParameters/AllowDirectCycling, /ModelParameters/AllowDirectCar);
		}
		unit<uint8> DirectModes_Selected := select_with_attr_by_cond(DirectModes, DirectModes/Allowed), Descr = "De toegestane directe modaliteiten.";
		parameter<string>   Direct_str                                := asList(DirectModes_Selected/abbrev + DirectModes_Selected/abbrev, ',')
		,	Descr = "De directe modaliteiten zoals ze in de uitvoernamen staan (V-<Direct_str>,<voortransport>_N-<natransport>): WW, CC en/of AA, in de volgorde van DirectModes. Verving op 2026-09-23 de keuze 'CC' of 'WW' uit AllowDirectCyclingOverWalking."
		,	IntegrityCheck = "Direct_str != ''" // minstens een van AllowDirectWalking/Cycling/Car moet aan staan: Direct_OD is een union over de toegestane modaliteiten
		;
		parameter<uint32>   NumberOfStopBlocks                        := 500                    , Descr = "In the generation of the unlinked PT-network, how many stop blocks should be used in the Ketenrijger? Less means more memory usage per unit of time.";
		parameter<uint32>   MaxStopBlockSize                          := 104                     , Descr = "In the generation of the unlinked PT-network, what is maximum stop block size? Make sure that the product of this value and the NumberOfStopBlocks is sufficient to include all stops";
		parameter<uint32>   NumberOfOrgBlocks                         := 450                    , Descr = "In the generation of PT-output files, how many origin blocks should be used? Less means more memory use, but less overhead. Het product met MaxOrgBlockSize moet minstens het aantal herkomsten zijn, zie ChecksBeforeRunning/Check_OriginBlocks: 450 x 200 = 90.000 dekt de 88.126 herkomsten van de 500m-clustering (441 gevulde blokken). Bij een nieuwe BAG-snapshot met meer herkomsten meldt die check precies welk getal nodig is.";
		parameter<uint32>   MaxOrgBlockSize                           := IsDefined(Buurtset_Org) ? 33 : 200, Descr = "In the generation of PT-output files, what is maximum origin block size? Make sure that this number times the number of blocks is larger than the number of origins. 200 herkomsten per blok houdt een blok behapbaar; bij de oude buurt-herkomsten stond dit op 30. Sinds 2026-10-05 (#126) 33 bij een buurtvariant als Orgset: 450 x 33 = 14.850 dekt de 14.421 buurten van 2023 en 14.729 van 2025, zodat alle blokken gevuld zijn; met buurten als bestemming (14.729 in plaats van 460 knooppunten) heeft een blok van 33 herkomsten zo'n 5 keer zoveel HB-paren als een blok van 200 cellen naar de knooppunten. Gemeten op 2026-10-05 (Buurt2025 naar Buurt2025, blok 1, de ketenstore van 6-10-2026, zonder de auto): per vertrekmoment 86.626 rijen en 31.415 HB-paren (een blok van de basisrun, 200 cellen naar de knooppunten met de auto: 98.643 en 31.907), zo'n 50 s per vertrekmoment (basisrun 13 s), en hoogstens 49,5 GB voor het hele proces, met het bouwen van de loop- en fietsnetwerken. 450 blokken zijn zo ongeveer 22 uur per dagdeel.";
		parameter<uint16>   Max_transfers                             := 3w                     , Descr = "How many transfers are allowed?", IntegrityCheck = "this >= 1w && this <= 4w";
		parameter<bool>     PriceExportsAndIntegrityChecksNeeded      := IsDefined(strpos(lowercase(MinimiseCriteria), 'price')) || Export_PriceInformation;
		// PARETO-BENEN (ObjectVision/NetworkModel_PBL#115, ObjectVision/GeoDMS#856)
		// De pareto-optie van impedance_matrix doet een bi-criteria label-setting zoektocht op
		// (Duration, Length) in plaats van min-Duration met Length als bijproduct. Voor het R-net is
		// prijs = FixedPrice + VariablePrice * afstand en dus monotoon in Length: het (tijd,afstand)-
		// front IS daar het (tijd,prijs)-front. Voor het L-net (NS) volgt de prijs uit de
		// TariffUnits-matrix over (eerste,laatste) station en dus uit het OD-paar zelf; een front
		// levert daar geen extra prijsopties op, alleen meer rijen. Vandaar twee schakelaars.
		// De vier schakelaars zelf staan in een eigen bestand, zodat de meetharnas van #115 per
		// arm EEN bestand in zijn geheel kan herschrijven in plaats van regels in dit bestand te
		// moeten patchen: welke arm draait is dan af te lezen aan `git diff cfg/main/ParetoArm.dms`.
		#include<ParetoArm.dms>
		// PARETO-FRONT VOOR DE DIRECTE AUTORIT (vervolg op #115; sinds 2026-10-05 op reistijd en afstand, #88). De auto-Dijkstra
		// levert per HB-paar EEN route, de snelste. Met de pareto-optie levert dezelfde operator per HB-paar het (reistijd,
		// afstand)-front: de snelle snelwegroute naast de korte binnenweg. De prijs is afstand x Car_CostPerKm, dus dat is ook
		// het (tijd, prijs)-front dat de eindafweging per HB-paar tegen OV, lopen en fietsen afweegt. Alleen de directe rit
		// (PublicTransport_Prep/Direct/Car) gebruikt de pareto-variant; de auto-exports blijven scalair. Tot 2026-10-05 was het
		// tweede criterium de som van linkkosten (kilometerprijs per wegklasse en optrekkosten), met een kostenepsilon van 10 ct.
		parameter<bool>     ParetoLegs_Car                            := TRUE                   , Descr = "Gebruik de pareto-optie van impedance_matrix_od64 voor de directe autorit in het front per HB-paar: per HB-paar alle (reistijd, afstand)-optimale routes in plaats van alleen de snelste. Kost meer rekentijd en geheugen dan de scalaire Dijkstra; zie CarFrontEpsilon.";
		parameter<km>       CarLegDistanceQuantum                     := 0.04[km]               , Descr = "Alleen op een engine voor GeoDMS 20.21.0 (zonder pareto(imp2_epsilon)): kwantisatie van het tweede pareto-criterium, de afstand per link, met dithering (ImpedanceMatrix_with_AltImp_pareto_T/AltImp_q: een vaste pseudo-toevallige drempel per link uit het link-id, dan naar beneden afgerond; de som over een route is onvertekend). Zonder kwantisatie (0[km]) ontsporen de fronten op een wegennet met continue lengtes (GeoDMS doc/bicriteria-impedance.md 5.5). 40 m is 1 ct bij 0,24 euro per km. Tot 2026-10-05 CarLegCostQuantum, 1 ct op de linkkosten.";
		parameter<bool>     EngineHasParetoEpsilon                    := GeoDmsMajorVersionNumber() > 20 || (GeoDmsMajorVersionNumber() == 20 && GeoDmsMinorVersionNumber() >= 21), Descr = "Sinds GeoDMS 20.21.0 kent impedance_matrix_od64 de optie pareto(imp2_epsilon) en bestaat pareto_optimal_eps (GeoDMS #1281, #1282). Op een oudere engine valt de directe autorit terug op de kwantisatie per link met dithering (CarLegDistanceQuantum) en blijft het front bij het lezen ongefilterd.";
		parameter<float32>  CarFrontEpsilon                           := 0.01f                  , Descr = "Relatieve epsilon van het autofront (sinds 2026-10-05, #88; GeoDMS #1282): het front loopt in volgorde van afstand (de prijs: afstand x Car_CostPerKm, bereikbaarheidsarmoede), de kortste route eerst, en een langere route blijft alleen als haar reistijd meer dan deze fractie onder die van de snelste kortere route ligt die blijft: reistijd < (1 - CarFrontEpsilon) x die reistijd. 0.01: een route die minder dan 1% sneller is maar langer, is geen echt alternatief. Omdat de zoektocht de reistijd begrenst (MaxCarTime, pareto(OrgZone_max_imp2)), past de engine de epsilon alleen per bestemmingszone toe en zoekt hij exact (GeoDMS c1d0aacbb): per knoop kon een deelroute die minder dan 1% sneller is, de enige zijn die binnen de grens blijft (gemeten: met de epsilon per knoop was de goedkoopste route bij 13,6% van de paren langer dan exact, tot 40%). Zo is het front per HB-paar het exacte front, uitgedund met deze regel, zonder opstapeling: de kortste route exact, de snelste route die blijft hoogstens 1% trager dan de snelste. Car_Front past dezelfde regel toe met pareto_optimal_eps en dunt daarmee niets meer uit. 0 = reistijd eerst met de gekwantiseerde afstand (CarLegDistanceQuantum). Eerder op 2026-10-05 reistijd eerst met CarFrontDistanceEpsilon, bakken van 400 m in de zoektocht en bij het lezen, en CarFrontTimeEpsilon, tijdbakken van 60 s bij het lezen, waarin een kortere route de snelste kon vervangen.", IntegrityCheck = "this >= 0f && this <= 1f && (!EngineHasParetoEpsilon || EngineHasRelativeParetoEpsilon)";
		parameter<km>       CarFrontMaxDistance                       := value(MaxCarTime / 1[min_f] * 2.5f, km), Descr = "De grens op het eerste criterium van de zoektocht op afstand eerst (CarFrontEpsilon), die de engine verplicht stelt: de afstand die in MaxCarTime met 150 km/u te halen is, zodat hij niets afsnijdt; de echte grens is MaxCarTime op de reistijd, het tweede criterium.";
		parameter<bool>     EngineHasRelativeParetoEpsilon            := = EngineHasParetoEpsilon ? '#ParetoEpsilonProbe/od == 1' : 'FALSE'
		, Descr = "Rekent de engine de epsilon van pareto(imp2_epsilon) en pareto_optimal_eps relatief (GeoDMS #1282, builds na 2026-10-05)? De builds van 20.21.0 tot die dag namen hem als bakbreedte in de eenheid van het criterium en lazen 0.01 dus als bakken van 0,01 km of 0,01 ct, zonder fout. De proef ParetoEpsilonProbe onderscheidt ze met impedance_matrix, waarvan de schrijfwijze gelijk bleef: twee routes naar een bestemming, (1, 10) en (2, 9,95); relatief is 9,95 niet 1% onder 10 en blijft een rij over, met bakken van 0,01 (995 onder 1000) blijven er twee. pareto_optimal_eps zelf weigert op zo'n build de schrijfwijze van dcba9d9e0, met een melding.";
		container ParetoEpsilonProbe: Descr = "Een netwerkje van drie knopen voor EngineHasRelativeParetoEpsilon."
		{
			unit<uint32> PNode : nrofrows = 3;
			unit<uint32> PLink : nrofrows = 3
			{
				attribute<PNode>   F1 : [0, 0, 2];
				attribute<PNode>   F2 : [1, 2, 1];
				attribute<float64> t  : [1.0, 1.0, 1.0];
				attribute<float64> c  : [10.0, 5.0, 4.95];
			}
			unit<uint32> PZone : nrofrows = 1;
			unit<uint32> PStart : nrofrows = 1
			{
				attribute<PNode> node_rel : [0];
				attribute<PZone> zone_rel : [0];
			}
			unit<uint32> PEnd : nrofrows = 1
			{
				attribute<PNode> node_rel : [1];
				attribute<PZone> zone_rel : [0];
			}
			unit<uint32> od := impedance_matrix(
				  'directed;startPoint(Node_rel,OrgZone_rel);endPoint(Node_rel,DstZone_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;pareto(imp2_epsilon);od:impedance'
				, PLink/t, PLink/F1, PLink/F2, PStart/node_rel, PStart/zone_rel, PEnd/node_rel, PEnd/zone_rel, const(100.0, PZone), PLink/c, 0.01);
		}
		parameter<string>   Car_PriceTag                              := AllowDirectCar ? '_car' + (IncludeCarCostsInPrice ? string(round(Car_CostPerKm * 100f)) + 'ctkm' + (Car_FixedCosts_PerTrip > 0[Euro] ? '-p' + string(round(Car_FixedCosts_PerTrip * 100f)) + 'ct' : '') : '0') : '', Descr = "Deel van de handtekening van de OV-uitvoer (PT_Output_ParamTag), sinds 2026-10-05 (#88): de prijs van de directe autorit, in ct per km en, als dat niet 0 is, per rit; _car0 als IncludeCarCostsInPrice uit staat. De autostore bevat alleen reistijd en afstand, dus de prijs staat niet meer in zijn handtekening (Car_CostTag tot 2026-10-05).";
		parameter<float32>  ChainParetoTimeEpsilon                    := 0.01f                  , Descr = "Relatieve epsilon op de reistijd in de eindafweging per vertrekmoment, bij het samenvoegen van de componenten en, met een tijdpenalty, in de ketenrijger (GeoDMS #1282, relatief sinds 2026-10-05): de prijs staat voorop (bereikbaarheidsarmoede, besluit 2026-10-05), en een duurdere optie blijft alleen als ze meer dan deze fractie sneller is dan de snelste goedkopere optie die blijft. 0.01: 1%. 0 = exact. Op het eerste criterium, de prijs, werkt een epsilon niet; ChainParetoPriceEpsilon (sinds 2026-10-05 even 0.01, tot dan 10 ct, een bakbreedte) is daarom vervallen. Tot 2026-10-05 60 s, een bakbreedte, ook op de resttijden van de ketenrijger; die zijn een afstand tot het einde van het analysevenster en geen reisduur, dus daar is de vergelijking sindsdien exact (Classifications/ChainJoinerParetoAttr_Candidates).", IntegrityCheck = "this >= 0f && this <= 1f && (!EngineHasParetoEpsilon || EngineHasRelativeParetoEpsilon)";
		parameter<string>   ChainPareto_FileTag                       := EngineHasParetoEpsilon && ChainParetoTimeEpsilon > 0f ? '_chainrel' + string(ChainParetoTimeEpsilon * 100f) + 'pct' : '', Descr = "Deel van de handtekening van de ketenstore en van de OV-uitvoer: de relatieve epsilon op de reistijd in procenten, leeg als die 0 is of de engine hem niet kent. Tot 2026-10-05 '_chaineps10ct60s', de bakbreedtes.";
		parameter<string>   ChainStore_ParamTag                       :=
			  '_' + lowercase(PriceMethod_effective)
			+ (NS_TariffChoice == 'Price_20pct_Discount' ? '-ns20' : (NS_TariffChoice == 'Price_40pct_Discount' ? '-ns40' : ''))
			+ (PriceExportsAndIntegrityChecksNeeded ? '' : '-noprice')
			+ '_ov' + string(round(MaxTransferDist)) + '-' + string(round(TransferEffectiveSpeed * 3600f)) + '-' + string(round(Transfer_Walking_Time_Costs * 100f)) + '-' + string(round(Transfer_Waiting_Time_Costs * 100f)) + '-' + string(round(GradeSeparatedTransferPenalty)) + '-' + string(round(MaxTransferTimeForBoardingSurcharge))
			+ '_h' + string(round(DistanceStopClusters)) + '-' + string(round(DistanceTrainStationsSelection))
			+ '_v' + string(round(PT_Max_V_Time))
		, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature, tot 2026-10-03 de naam) met de parameters waar de ketens van afhangen en die de rest van de handtekening niet noemt (audit 3.4): de prijsmethode (dova of detailed, met -ns20/-ns40 bij NS-korting en -noprice als de prijzen niet worden bewaard), _ov<MaxTransferDist m>-<TransferEffectiveSpeed m/uur>-<Transfer_Walking_Time_Costs ct/min>-<Transfer_Waiting_Time_Costs ct/min>-<GradeSeparatedTransferPenalty min>-<MaxTransferTimeForBoardingSurcharge min> en _h<DistanceStopClusters m>-<DistanceTrainStationsSelection m>. Het prijsjaar volgt uit GTFS_file_date, dat de handtekening zelf noemt als het van Analysis_date afwijkt. Voegt een parameter toe aan de ketenrijging, zet hem dan hier bij.";
		parameter<string>   CarNetwork_Revision                       := '_r3'
		, Descr = "Revisie van het TomTom-autonet in de handtekening van de autostores (en zo in de hash in hun naam); verhoog hem bij elke codewijziging die het autonet verandert, anders wordt de oude store gelezen. _r2 (2026-09-25): alleen wegelementen en veerverbindingen, elk NW_ID een keer (audit 4.4 en 4.5). _r3 (2026-10-05, #88): de stores van de directe autorit bevatten de afstand als tweede criterium in plaats van de linkkosten (alt_imp in km).";
		parameter<m>        ExtraLink_MaxSnapDistance                 := 250[m]                 , Descr = "Maximale afstand van een eindpunt van een handmatige verbinding (OSM/NetworkPreperation/ExtraVerbindingen) tot het wegennet; een verbinding met een verder eindpunt doet niet mee (audit 4.11).";
		parameter<float32>  OSM_MaxSpeedQuantile                      := 0.5f
		, Descr = "Kwantiel van de getagde maxspeed per wegtype en land, voor OSM-wegen zonder bruikbare maxspeed-tag. Sinds 2026-09-25 (audit 4.10) over de getagde wegen alleen; tot dan was het het 90e percentiel over alle wegen inclusief de 75% zonder tag (maxspeed 0). De mediaan beschrijft een typische ongetagde weg; het 90e percentiel van de getagde wegen gaf servicewegen 50 km/u (6% getagd, de snellere).";
		parameter<bool>     ChainStore_PerBlock                       := TRUE
		, Descr = "De ketenstap schrijft elk haltenblok in een eigen store (PublicTransport_Prep/StorageBlockDir_Str, sinds 2026-09-29) en de uitvoerstap leest ze samen; FALSE: de ene store van Write_Result, zoals voor die datum. Per blok blijven de resultaten niet tot het eind in het geheugen, en een onderbroken ketenstap gaat bij het eerste ontbrekende blok verder (batch/WriteChainBlocks.ps1).";
		parameter<string>   ChainStore_Revision                       := '_r10'
		, Descr = "Revisie van de ketenopbouw in de handtekening van de ketenstore (en zo in de hash in zijn naam); verhoog hem bij elke codewijziging die de ketens verandert, anders wordt de oude store gelezen. _r2 (2026-09-25): de dienstdagen D-1 en D+1 via een dagnummer (audit 3.5); daarmee verandert ook de haltenummering waar de ketens naar verwijzen. _r3 (2026-09-25): de ketenrijger snoeit ook op Price als het eindfront op Price kiest (audit 6.1). _r4 (2026-09-26): de ketenrijger kiest op de prijs van het eindfront met Price_augm alleen als tiebreak (6.1), op TravelTime bij een tijdpenalty (6.2) en groepeert ook op het eerste NS-station (6.3). _r5 (2026-09-29): geen ketens meer die na PT_LastBoardingMoment instappen (de handtekening draagt daarom ook _v<PT_Max_V_Time>); de ketens zelf zijn verder gelijk. _r6 (2026-10-02, #3): NS-tariefeenheden zonder de HSL-kanten, rit-opslag voor HSL en ICE (Price_S), NS International in het L-net en geen in- of uitstappen waar de GTFS pickup_type of drop_off_type 1 heeft. _r7 (2026-10-02, #53): de store bewaart ook Price_S (rit-opslag), voor de validatie tegen 9292; de ketens zijn verder gelijk aan _r6. _r8 (2026-10-04, #121): vanaf NS_prijzen_year 2016 het NS-tariefnet zonder gezamenlijke tariefpunten (NS_tariefnet_year), dus andere NS-prijzen voor 16% van de stationsparen. _r9 (2026-10-05, GeoDMS #1282): de epsilons van de ketenrijger relatief (1% op de reistijd, geen op de prijs, die voorop staat) en op de resttijden exact, in plaats van bakken van 10 ct en 60 s. _r10 (2026-10-06): de modes van de benen als uint32 ModeCode (Classifications/GTFS_Modes/CodeDigits) in plaats van de string ModeUsed; de ketens zijn verder gelijk aan _r9.";
		parameter<string>   ParetoLegs_Car_FileTag                    := ParetoLegs_Car ? '_paretoCar' + (EngineHasParetoEpsilon && CarFrontEpsilon > 0f ? 'D-r'+string(CarFrontEpsilon * 100f)+'pct' : (CarLegDistanceQuantum > 0[km] ? 'q'+string(round(CarLegDistanceQuantum * 1000f))+'m' : '')) : '', Descr = "Deel van de handtekening van de autostores en van de OV-uitvoer, want het front met de directe autorit hangt van deze parameters af; leeg als ParetoLegs_Car uit staat. Sinds 2026-10-05 (#88) 'D-r1pct': afstand eerst met de relatieve epsilon in procenten (GeoDMS #1282), of de kwantisatie in m; even daarvoor de afstandsbak ('e400m'), tot dan in ct.";

		parameter<euro>     OVFiets_RentalPrice                       := 4.45[euro]             , Descr = "Prijs voor de huur van de fiets voor de eerste 24u. 2023=4.45 euro";
		parameter<bool>     UseOVFietsPriceForAllCyclingPostTransport := TRUE                   , Descr = "Wil je voor al het fiets-PostTransport het vaste bedrang van de OV-fiets gebruiken? En dus de km-prijs niet gebruiken.";
		
		// PRIVATE TRANSPORT
		parameter<bool>     UseActualCyclingSpeeds                    := FALSE                  , Descr = "In the case of cycling, would you like to use actual cycling speeds (from Fietstelweek) or a constant speed (as defined in BikingSpeed_kmhr)?";
		parameter<string>   CongestionSpeed_DaySelection              := 'tuesday'              , Descr = "Which day (or day selection) do you choose to use TomTom congenstion data from. Options: 'Weekday' 'Weekend' 'Week' 'monday' 'tuesday' 'wednesday' 'thursday' 'friday' 'saturday' 'sunday' ";
		parameter<string>   TomTom_StreetTypeSelection                 := 'FuncRoadClass/V/Local_Road_of_Minor_Importance', Descr = "This setting gives to option to exclude certain roadtypes in the TomTom network. Options: 7 FuncRoadClass/V/Local_Road   8 FuncRoadClass/V/Secondary_Road Local_Road_of_Minor_Importance  Local_Road_of_High_Importance ";
		parameter<m>        Fietstel_OSM_link_dist                    := 8[m]                   , Descr = "De maximale afstand tussen OSM en FietsTelWeek data om te linken ";
		parameter<float64>  ConnectSearchDist                         := 100d*100d              , Descr = "Zoek gebied voor connect_info operaties, zoals linken NDW aan NWB en NWB aan OSM, en FietsTelWeek aan OSM. Float64: connect_info op dpoint-rdc verwacht een float64 zoekafstand (kwadratisch).";
		parameter<km_hr>    WalkingSpeed_kmhr                         := 4.5[km_hr]             , Descr = "";
		parameter<km_hr>    CyclingSpeed_kmhr                         := 14[km_hr]              , Descr = "";
		parameter<km_hr>    E_BikingSpeed_kmhr                        := 20[km_hr]              , Descr = "";
		parameter<km_hr>    E_BikingSpeed_actualspeed_addition_kmhr   := 10[km_hr]              , Descr = "";
		parameter<km_hr>    CarSpeed_kmhr                             := 130[km_hr]             , Descr = "Alleen relevant bij OSM";
		parameter<km_hr>    CarSpeed_limit_kmhr                       := 100[km_hr]             , Descr = "Bijvoorbeeld bij 100kmpu op snelwegen overdag. Alleen relevant bij OSM";
		parameter<km_hr>    CarDefaultSpeed                           := 50[km_hr]              , Descr = "";
		parameter<km_hr>    CarDefaultSpeed_low                       := 30[km_hr]              , Descr = "";
		parameter<km_hr>    Ferry_Speed                               := 25[km_hr]              , Descr = "";
		parameter<bool>     InterpretAllRoadsAsBidirectional          := FALSE                  , Descr = "Should car(!) roads be interpreted as bidirectional, or should the OneDirection property be guiding?";//
		parameter<string>   OrgSet_SelectionTag                       := switch(case(lowercase(Orgset) == 'buurt_enkele_buurt', '-' + lowercase(Orgset_EnkeleBuurt_Selection)), case(lowercase(Orgset) == 'buurt_enkele_gemeente' || lowercase(Orgset) == 'gemeente_enkele_gemeente', '-' + lowercase(Orgset_EnkeleGem_Selection)), case(lowercase(Orgset) == 'buurt_enkele_prov', '-' + lowercase(Orgset_EnkeleProv_Selection)), case(lowercase(Orgset) == 'buurt_enkele_corop', '-' + lowercase(Orgset_EnkeleCorop_Selection)), '')
		, Descr = "Het gekozen gebied van een enkele-gebied-herkomstenset in de bestandsnamen (sinds 2026-09-25, bij audit 3.8): anders delen twee selecties een autostore of uitvoerbestand.";
		parameter<string>   DestSet_SelectionTag                      := switch(case(lowercase(Destset) == 'buurt_enkele_buurt', '-' + lowercase(Destset_Enkele_Selection)), case(lowercase(Destset) == 'buurt_enkele_prov', '-' + lowercase(Destset_EnkeleProv_Selection)), case(lowercase(Destset) == 'buurt_enkele_corop', '-' + lowercase(Destset_EnkeleCorop_Selection)), '')
		, Descr = "Het gekozen gebied van een enkele-gebied-bestemmingenset in de bestandsnamen (sinds 2026-09-25, bij audit 3.8).";
		parameter<string>   DestSet_DateTag                           := lowercase(Destset) == 'ov_knooppunten' ? '_' + Analysis_date + (GTFS_file_date == Analysis_date ? '' : '_gtfs' + GTFS_file_date) : ''
		, Descr = "Datum van de bestemmingsset in de bestandsnamen, als die uit de dienstregeling volgt: de OV-knooppunten hangen af van de feed en van de vertrekken op Analysis_date. Sinds 2026-09-25; daarvoor las een autostore of loop- en fietsuitvoer voor een andere datum stil die van de vorige.";
		parameter<string>   DestSet_string_nodate                     := (Dests_geclusterd ? lowercase(Destset) + '_' + lowercase(Dest_location_scale) : lowercase(Destset)) + DestSet_SelectionTag
		, Descr = "De bestemmingsset zonder DestSet_DateTag, in de handtekening van de OV-uitvoer (PT_Output_ParamTag), die Analysis_date al noemt. Tot 2026-10-03 stond hij zo in de bestandsnamen van de uitvoer, zonder datum om onder de 260 tekens van Windows te blijven.";
		parameter<string>   PT_CombinationType                        := 'V-' + Direct_str + (MetOV ? ',' + asList(OV_PreTransport_Typen/ExportName, ',') + '_N-' + asList(OV_PostTransport_Typen/ExportName, ',') : '')
		, Descr = "De directe modaliteiten en de voor- en natransporttypen zoals ze in de handtekening van de OV-uitvoer staan (tot 2026-10-03 in de bestandsnamen); zonder OV (component Auto) alleen de directe modaliteiten.";
		parameter<string>   PT_Output_ParamTag                        := '_DEST-' + DestSet_string_nodate + '_' + PT_CombinationType + (MetOV ? '_Trsf-' + string(Max_transfers) : '') + '_MinCrit-' + asList(/Classifications/OutputParetoAttr/FileNameElement, '_') + (MetOV ? '_MaxPT-' + string(/ModelParameters/MaxPTTime) + 'min' + Flex_FileTag + RitOpslag_FileTag : '') + (AllowDirectCar ? ParetoLegs_Car_FileTag : '') + Car_PriceTag + ChainPareto_FileTag
		, Descr = "De parameters van de OV-uitvoer na datum en herkomstset, voor de handtekening van de uitvoer (NetworkSetup/Output_Signature): bestemmingenset, modaliteiten, overstappen, criteria, MaxPT en de tags. Tot 2026-10-03 (NetworkModel_PBL#118) heette hij PT_OutputFileTail en was hij de staart van de naam van elk uitvoerbestand; zo werd het langste uitvoerpad 252 tot 261 tekens. Sinds 2026-10-05 (#117) alleen de OV-tags (overstappen, MaxPT, flex, rit-opslag) als het OV meedoet en de autotags als de directe autorit meedoet.";
		parameter<string>   DestSet_string                            := (Dests_geclusterd 
																			? lowercase(Destset) + '_' + lowercase(Dest_location_scale)
																			: lowercase(Destset)) + DestSet_SelectionTag + DestSet_DateTag, Descr = "De bestemmingsset zoals hij in de bestandsnamen staat, met DestSet_SelectionTag en DestSet_DateTag."; 
		parameter<string>   OrgSet_string                             := (strcount(Orgset, 'Clustered') > 0
													? lowercase(Orgset) + '_' + lowercase(Org_location_scale)
													: lowercase(Orgset)) + OrgSet_SelectionTag
		,	Descr = "De herkomstenset zoals hij in de bestandsnamen staat, met OrgSet_SelectionTag bij een enkel gebied. Bij een geclusterde set hoort de celmaat erbij, anders overschrijft een 500m-run de uitvoer van een 100m-run, net zoals DestSet_string dat voor de bestemmingen doet.";
		
		unit<uint8> OV_PreTransport_Typen := select_with_org_rel(IsDefined(strpos(';' + Component_Voortransport + ';', ';' + TimeInvariantTypes/name + ';')))
		, Descr = "De voortransporttypen van deze run: die van Component (Componenten/Voortransport, sinds 2026-10-05, #117), in de volgorde van Classifications/TimeInvariantTypes. Tot dan een vaste lijst hier, Org2Stops_Walking. RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? '_'+StopClass : '';
			attribute<string> ExportName  := Mode_abbrev + StopClass_;
		}
		unit<uint8> OV_PostTransport_Typen := select_with_org_rel(IsDefined(strpos(';' + Component_Natransport + ';', ';' + TimeInvariantTypes/name + ';')))
		, Descr = "De natransporttypen van deze run: die van Component (Componenten/Natransport, sinds 2026-10-05, #117), in de volgorde van Classifications/TimeInvariantTypes. Tot dan een vaste lijst hier, Stops2Dest_Walking. RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? StopClass+'_' : '';
			attribute<string> ExportName  := StopClass_ + Mode_abbrev;
		}
				
		
		unit<uint8> PT_DepartureHours : nrofrows = 1
		, Descr = "Het uur van de vertrekmomenten: dat van Dagdeel (sinds 2026-10-05, #125; tot dan vast 7, en zette een runkopie hier 12 voor de middag). Meer uren in een run: nrofrows ophogen en de uren als lijst geven, bijvoorbeeld [7, 12, 19]; Car_CongestionMoment_ForDirect volgt dan nog steeds Dagdeel."
		{
			attribute<uint32> values := const(rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour), .);
		}
		unit<uint8> PT_DepartureMinutes : nrofrows = 4
		, Descr = ""
		{
			// attribute<uint32> values : [0]; 
			// attribute<uint32> values : [0,30]; 
			attribute<uint32> values : [0,15,30,45];										   
			// attribute<uint32> values : [0,5,10,15,20,25,30];  //7 stuks
			// attribute<uint32> values : [0,5,10,15,20,25,30,35,40,45,50,55];  //12 stuks
			// attribute<uint32> values : [0,5,10,55];  //4 stuks
		}
		
		unit<uint8>  AnalysisMomentPresets : nrofrows = 11
		, Descr = "Per peildatum (AnalysisMoment) de bronnen: OSM, CBS-gebiedsindeling, TomTom, BAG-snapshot, en sinds 2026-10-05 (#125) de dag van de OV-analyse en de GTFS-feed. Een jaar zonder Analysis_date of GTFS_file_date is geen peildatum en draait niet (de IntegrityCheck van Analysis_date en GTFS_file_date)."
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// name, OSM date , Regios, OSM_perProv, CarCongestionSpeed_date_TomTom, BAG_snapshot, Analysis_date, GTFS_file_date
				[
				'Y2012','20221201', '2012', 'TRUE',  'yr2021_12', '20120101',     '',         '',      //20140101
				'Y2013','20140101', '2022', 'FALSE', 'yr2021_12', '20130101',     '',         '',
				'Y2015','20240524', '2023', 'TRUE',  'yr2021_12', '20230101.new', '20151013', '',
				'Y2018','20190101', '2020', 'FALSE', 'yxx2021_12','20180101',     '',         '',
				'Y2020','20200117', '2020', 'FALSE', 'yr2021_12', '20200101',     '',         '',
				'Y2021','20211221', '2021', 'TRUE',  'yr2021_12', '20210101',     '',         '',
				'Y2022','20221201', '2022', 'TRUE',  'yr2022_12', '20220101',     '',         '',
				'Y2023','20240524', '2023', 'TRUE',  'yr2025_12', '20230101.new', '20231010', '20231003',
				'Y2024','20240524', '2023', 'TRUE',  'yr2025_12', '20230101.new', '20241008', '20241001',
				'Y2025','20240524', '2025', 'TRUE',  'yr2025_12', '20250101.new', '20251014', '20250930',
				'Y2026','20260601', '2025', 'TRUE',  'yr2025_12', '20250101.new', '20261013', '20260925'
				];
				// PEILDATA (overleg PBL 5-10-2026, #125): de tweede dinsdag van oktober, 13-10-2015, 10-10-2023, 8-10-2024,
				// 14-10-2025 en 13-10-2026. Ze vervangen 1-10-2024, 30-9-2025, 16-6-2026 en 6-10-2026 (op 6-10-2026 waren er
				// werkzaamheden rond Amsterdam C). De feed per peildatum dekt de dienstdagen D-1 tot D+1 met minstens
				// MinServiceDayTripShare van de ritten van de drukste dag van dezelfde weekdag (LoadFeeds/ServiceDays/Days/TripShare,
				// 2026-10-05): 20231003 100%, 20241001 100%, 20250930 97%, 20260925 98%. De feed 20231003 is die dag gekopieerd uit
				// F:/SourceData/NetworkModel/Infrastructuur/GTFS, met zijn mmd-store erbij (LoadFeeds/Write). Voor 2015 is er
				// lokaal geen feed (20131002 loopt tot 13-12-2014, 20170929 begint op 29-9-2017); Y2015 draait pas als er een
				// feed van oktober 2015 in %NetworkModel_Dir%/Infrastructuur/GTFS staat en hier zijn datum.
				// OSM: de oudste lokale uitsnede is 20240524; Y2015 en Y2023 rekenen daarmee (Y2023 noemde 20240101, die
				// er niet is).
				// TomTom: voor 2023 was yr2023_12 besloten, maar die editie is er alleen als oude fss (zie hieronder) en is zonder
				// het ruwe materiaal niet opnieuw in te richten. Sinds 2026-10-05 rekent 2023 daarom voorlopig met yr2025_12,
				// zoals 2024 (er is geen 2024); 2015 voorlopig met yr2021_12 (er is geen oudere). Een nieuwe levering van
				// 2023 en 2024 is nog op te vragen.
				// Regios en BAG_snapshot (sinds 2026-10-05, #126): die van de buurtvariant van de peildatum (Advanced/Buurtsets),
				// CBS 2023 en BAG 1-1-2023 voor 2015, 2023 en 2024, CBS 2025 en BAG 1-1-2025 voor 2025 en 2026. Tot dan had
				// Y2024 Regios 2024 en BAG 20240101_RS, Y2025 BAG 20250101 (die er niet was) en Y2026 BAG 20260101.new. Ook de
				// BAG-herkomsten (BAG_woonpanden_Clustered) van een peildatum rekenen zo met de BAG van zijn buurtvariant.
				// BAG_snapshot = de mapnaam onder %BAG_DataDir%/BAG/snapshots.ext, want die namen zijn
				// onregelmatig. Aanwezig op F: (2026-09-22): 20120101 t/m 20200101 en 20180401/20170701/
				// 20170908 (oude Ruimtescanner-snapshots, de drieslag vbo/pand/adres.fss), 20240101_RS
				// (idem, met de mmd-kopieen die deze config ernaast zet) en 20260101.new (een volledige
				// bag.mmd van BAG-Tools, uit het historiebestand van 2026-08-08). Voor 2021, 2022, 2023 en
				// 2025 staat er geen snapshot; die jaren kunnen dus geen BAG-herkomsten leveren.
				// Sinds 2026-10-05 (#126) ook 20230101.new en 20250101.new, met BAG-Tools (BAG20_MakeSnaphot,
				// nl_status_sel_with_strangevalues_no_height_mmd) uit dezelfde historie 20260808/mmd_ge als 20260101.new;
				// 2023: 14.421 buurten, 13.990 met woningen, 8.125.113 woningen; 2025: 14.729, 14.281, 8.274.308.
				//
				// Regios blijft voor Y2026 op 2025: cbsgebiedsindelingen2026.gpkg is een voorlopige uitgave
				// van 2,9 MB met alleen landsdeel, provincie, COROP(plus/sub) en gemeente, en labelpoints die
				// '_voorlopig' heten; buurt en wijk ontbreken, en daarop staan de herkomstensets en de
				// regio-aggregaties. Zet dit op 2026 zodra CBS de buurt- en wijkkaart 2026 publiceert.
				// CarCongestionSpeed_date = de map %NetworkModel_PrivDir%/TomTom/<naam>/ met multinet/ en
				// speedprofiles/ (ruw) en de vier stores Roads/Junctions/Speednetworks/Speedprofiles.mmd
				// (verwerkt). Aanwezig op F: (2026-09-22): yr2021_12 en yr2025_12 met ruw materiaal en
				// mmd-stores (MultiNet 2021.12 van Jip, 2025.12 NL+BE van Marnix Breedijk, PBL; ingericht
				// met batch/ExtractTomTomEdition.py). yr2022_12 en yr2023_12 hebben alleen de oude fss van
				// Jip: die zijn in het fpoint-tijdperk geschreven, worden onder de huidige dpoint-rdc STIL
				// verkeerd gelezen en zijn niet herbouwbaar omdat het ruwe materiaal ontbreekt; Y2022 kan
				// dus niet draaien, en Y2023 rekent sinds 2026-10-05 met yr2025_12. Een yr2024_12-editie is
				// nooit geleverd; Y2024 rekent ook met yr2025_12.
			}
			
			attribute<string>        name                    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        OSM_file_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
			attribute<string>        RegioIndelingen_year    := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			attribute<bool>          OSM_NL_prov             := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)][bool];
			attribute<string>        CarCongestionSpeed_date := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)];
			attribute<string>        BAG_snapshot            := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)];
			attribute<string>        Analysis_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 6, Elements)], Descr = "De peildatum (yyyymmdd), sinds 2026-10-05 (#125); leeg = geen peildatum.";
			attribute<string>        GTFS_file_date          := Elements/Text[value(UInt32(ID(.))* nrAttr + 7, Elements)], Descr = "De GTFS-feed van de peildatum (yyyymmdd), sinds 2026-10-05 (#125); leeg = (nog) geen feed.";

			parameter<uint32> nrAttr := 8;
		}

		unit<uint8> Dagdelen : nrofrows = 3
		, Descr = "De dagdelen van een peildatum (overleg PBL 5-10-2026, #125), te kiezen met /ModelParameters/Dagdeel: vier vertrekmomenten per kwartier vanaf DepartureHour (PT_DepartureMinutes), en het congestiemoment van de directe autorit (CongestionTimes), in het midden van dat uur. Ochtendspits heeft voorrang; middag en avond zijn ter controle. De avond was tot dan 21:00."
		{
			attribute<string> name             : ['Ochtendspits', 'Middag', 'Avond'];
			attribute<uint32> DepartureHour    : [7, 12, 19];
			attribute<string> CongestionMoment : ['MorningRush', 'NoonRush', 'LateEveningRush'];
		}
	
		unit<uint32> org_domain_list : nrofrows = 23 // Hier worden de paden voor elke org set opgegeven. En wanneer er nieuwe bij komen dat hier ook toegevoegd worden.
		, Descr = ""
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				'Buurt'                               ,'SourceData/RegioIndelingen/Buurt/Centroiden',
				'Buurt2023'                           ,'SourceData/RegioIndelingen/Buurt/Centroiden', // #126: CBS 2023 en BAG 1-1-2023 (Buurtsets)
				'Buurt2025'                           ,'SourceData/RegioIndelingen/Buurt/Centroiden', // #126: CBS 2025 en BAG 1-1-2025
				'Buurt_perProvincie'                  ,'SourceData/RegioIndelingen/Buurt/Per_Prov/@REGIO@/sub',
				'Buurt_perCOROP'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROP/@REGIO@/sub',
				'Buurt_perCOROPp'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROPp/@REGIO@/sub',
				'Buurt_enkele_buurt'                  ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt',
				'Buurt_enkele_Gemeente'               ,'SourceData/RegioIndelingen/Buurt/Enkele_Gemeente',
				'Buurt_enkele_Prov'                   ,'SourceData/RegioIndelingen/buurt/Enkele_Prov',
				'Buurt_enkele_Corop'                  ,'SourceData/RegioIndelingen/buurt/Enkele_Corop',
				
				'Wijk'                                ,'SourceData/RegioIndelingen/Wijk/Centroiden',
				'Wijk_perProvincie'                   ,'SourceData/RegioIndelingen/Wijk/Per_Prov/@REGIO@/sub',
				'Wijk_perCOROP'                       ,'SourceData/RegioIndelingen/Wijk/Per_COROP/@REGIO@/sub',
				
				'Gemeente'                            ,'SourceData/RegioIndelingen/Gemeente/Centroiden',
				'Gemeente_perProvincie'               ,'SourceData/RegioIndelingen/Gemeente/Per_Prov/@REGIO@/sub',
				'Gemeente_perCOROP'                   ,'SourceData/RegioIndelingen/Gemeente/Per_COROP/@REGIO@/sub',
				'Gemeente_enkele_gemeente'            ,'SourceData/RegioIndelingen/Gemeente/Enkele_gemeente',
				
				'PC4'                                 ,'SourceData/BAG/Adressen/Woon_Voorraad/PC4_centroids',
				'PC4_perCOROP'                        ,'SourceData/BAG/Adressen/Woon_Voorraad/PC4_centroids/Per_COROP/@REGIO@/sub',
				
				'PC6'                                 ,'SourceData/BAG/Adressen/Woon_Voorraad/PC6_centroids',
				'PC6_sub'                             ,'SourceData/BAG/Adressen/Woon_Voorraad/PC6_centroids/sub',
				
				'BAG_woonpanden'                      ,'SourceData/BAG/Panden/pand/pand_woon_vbo',
				'BAG_woonpanden_Clustered'            ,'SourceData/BAG/Panden/pand/pand_woon_vbo/HeeftPanden'
				]; 
			}
			
			attribute<uint32>        id              := id(.);
			attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        path           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], DialogType = "LabelText";
			
			parameter<uint32> nrAttr := 2;
		}
		
		unit<uint32> dest_domain_list : nrofrows = 9 // Hier worden de paden voor elke dest set opgegeven. En wanneer er nieuwe bij komen dat hier ook toegevoegd worden.
		, Descr = ""
		{ 
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				 'LISA'                                                           ,'SourceData/locaties/LISA/ReadFSS/y@LISAJAAR@/PerYear/HeeftBanen'                                                  , 'nr_banen'
				,'Buurt'                                                          ,'SourceData/RegioIndelingen/Buurt/Centroiden'                                                                      , 'nr_banen'
				,'Buurt2023'                                                      ,'SourceData/RegioIndelingen/Buurt/Centroiden'                                                                      , 'nr_banen'
				,'Buurt2025'                                                      ,'SourceData/RegioIndelingen/Buurt/Centroiden'                                                                      , 'nr_banen'
				,'Buurt_enkele_Buurt'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt_Dest'                                                               , 'nr_banen'
				,'Buurt_enkele_Prov'                                              ,'SourceData/RegioIndelingen/Buurt/Enkele_Prov_dest'                                                                   , 'nr_banen'
				,'Buurt_enkele_Corop'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_Corop_dest'                                                                  , 'nr_banen'
				,'Wijk'                                                           ,'SourceData/RegioIndelingen/Wijk/Centroiden'                                                                       , 'nr_banen'
				,'OV_Knooppunten'                                                 ,'SourceData/Infrastructure/GTFS/OV_Knooppunten/Export_Knooppunten'                                                                       , 'nr_stops'
				];  
				// items_of_interest is het gewicht w_j in de interactiebepaling (NetworkSetup.dms, de Decay met
				// dist_logit). Dat veronderstelt ULTIEME bestemmingen: de keten loopt van de primaire herkomst
				// via voortransport (Org2Stops) over het OV-netwerk en natransport (Stops2Dest) naar de
				// bestemming, en pas daarover wordt de interactie bepaald. LISA (banen) en de regioindelingen
				// (nr_banen) zijn zulke bestemmingen.
				//
				// OV_Knooppunten is dat NIET: een knooppunt is een doorgaanspunt in de keten, geen eindbestemming.
				// Die rij is bedoeld voor bereikbaarheidsvragen OVER de knooppunten zelf (hoe lang doe je erover
				// om er een te bereiken, zie GTFS/OV_Knooppunten/Bereikbaarheid_Auto), niet voor een
				// interactiebepaling. Het gewicht staat daarom op nr_stops, een echt kenmerk van het knooppunt;
				// er bestaat geen nr_banen op die laag en een decay-uitkomst over knooppunten is inhoudelijk
				// niet te lezen als bereikbaarheid van bestemmingen.
			}
			
			attribute<uint32>        id                := id(.);
			attribute<string>        label             := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        path              := replace(Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], '@LISAJAAR@', LISA_year), DialogType = "LabelText";
			attribute<string>        items_of_interest := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			
			parameter<uint32> nrAttr := 3;
		}
		
		unit<uint8> CongestionTimes : nrofrows = 3
		, Descr = ""
		{
			attribute<string> name : ['MorningRush','NoonRush','LateEveningRush'];
			attribute<string> Time : ['0730', '1230', '1930'];
			attribute<km_hr>  MaxSpeed : [100, 100, 0], Descr = "Plafond op de autosnelheid per congestiemoment, voor TomTom en OSM; 0 = geen plafond. Overdag (06-19 uur) is de maximumsnelheid op de snelweg sinds 2020 100 km/u, 's avonds en 's nachts mag op sommige wegen harder; Freeflow heeft geen plafond. Sinds 2026-09-25.";
		}
		
		container Distance_decay //distance decay parameters, calculated and provided by PBL
		: Descr = ""
		{
			parameter<float32> car_a   := -8.65786f;
			parameter<float32> car_b   := 2.492099f;
			parameter<float32> car_c   := 0.011641f;
			parameter<float32> bike_a  := -7.95686f;
			parameter<float32> bike_b  := 2.675059f;
			parameter<float32> bike_c  := 0.011981f;
			// Voor lopen heeft PBL (nog) geen parameters geleverd; voorlopig die van de fiets, door PBL te zetten (audit 3.2).
			parameter<float32> walk_a  := bike_a;
			parameter<float32> walk_b  := bike_b;
			parameter<float32> walk_c  := bike_c;
			parameter<float32> ov_a    := -12.3301f;
			parameter<float32> ov_b    := 2.907621f;
			parameter<float32> ov_c    := 0.012824f;
		}
	
		
		container Junction_Penalties
		: Descr = "bij het reizen over door een netwerk kun je meestal niet zonder vertraging voorbij een kruispunt komen. Daarom geven we hiervoor een penalty afhankelijk van het aantal benen van het kruispunt.
					De set met lower in de prefix, gaat erom dat je andere penalties hanteerd wanneer het kruis benen heeft waarop de snelheid relatief laag is. In dat geval zou de penalty lager kunnen zijn. 
					Neem een kruispunt in een bloemkoolwijk, dan hoef je wellicht niet voor elke zijstraat te stoppen. Nu (sept '25) staat dit op roadType <= 30kmpu (/Classifications/OSM/roadType/IsSlowTrafficRoad)." 
		{
			parameter<s>        with_2Links_Walking                  := 0[s]; // 0
			parameter<s>        with_3Links_Walking                  := 2[s]; // 1
			parameter<s>        with_4Links_Walking                  := 5[s]; // 2
			parameter<s>        with_gt4Links_Walking                := 6[s]; // 3
			
			parameter<s>        with_2Links_Cycling                  := 0[s]; // 0
			parameter<s>        with_3Links_Cycling                  := 2[s]; // 1
			parameter<s>        with_4Links_Cycling                  := 5[s]; // 2
			parameter<s>        with_gt4Links_Cycling                := 6[s]; // 3
			
			parameter<s>        with_2Links_E_Biking                 := 0[s]; // 0
			parameter<s>        with_3Links_E_Biking                 := 2[s]; // 1
			parameter<s>        with_4Links_E_Biking                 := 5[s]; // 2
			parameter<s>        with_gt4Links_E_Biking               := 6[s]; // 3
			
			parameter<s>        with_2Links_Car                      := 0[s]; // 0
			parameter<s>        with_3Links_Car                      := 2[s]; // 2
			parameter<s>        with_4Links_Car                      := 5[s]; // 5
			parameter<s>        with_gt4Links_Car                    := 6[s]; // 6
			
			parameter<s>        with_2_lowerSpeedLinks_Walking       := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Walking       := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Walking       := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Walking     := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_Cycling       := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Cycling       := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Cycling       := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Cycling     := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_E_Biking      := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_E_Biking      := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_E_Biking      := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_E_Biking    := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_Car           := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Car           := 0[s]; // 2
			parameter<s>        with_4_lowerSpeedLinks_Car           := 0[s]; // 5
			parameter<s>        with_gt4_lowerSpeedLinks_Car         := 0[s]; // 6
		}
		
		container OSM_impl
		: Descr = ""
		{
			unit<uint32> InEenBestand : nrofrows = 4
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Regio             , OrgSet , OrgPath, Land, Type, 
					[
					'Netherlands'             ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Nordrhein-Westfalen'     ,'DE', 'OD'
					]; 
				}
				
				attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string>        name           := replace(label, '-', '_');
				attribute<string>        Country        := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string>        Type_src       := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
				
				parameter<uint32> nrAttr := 3;
			}
			unit<uint32> InProvincies : nrofrows = 17
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Regio             , OrgSet , OrgPath, Land, Type, 
					[
					'Drenthe'                 ,'NL', 'OD',
					'Flevoland'               ,'NL', 'OD',
					'Friesland'               ,'NL', 'OD',
					'Gelderland'              ,'NL', 'OD',
					'Groningen'               ,'NL', 'OD',
					'Limburg'                 ,'NL', 'OD',
					'Noord-Brabant'           ,'NL', 'OD',
					'Noord-Holland'           ,'NL', 'OD',
					'Overijssel'              ,'NL', 'OD',
					'Utrecht'                 ,'NL', 'OD',
					'Zeeland'                 ,'NL', 'OD',
					'Zuid-Holland'            ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Duesseldorf-regbez'       ,'DE', 'OD',
					'Koeln-regbez'             ,'DE', 'OD',
					'Muenster-regbez'          ,'DE', 'OD'
					]; 
				}
				
				attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string>        name           := replace(label, '-', '_');
				attribute<string>        Country        := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string>        Type_src       := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
				
				parameter<uint32> nrAttr := 3;
			}
		}
		
		unit<uint32> SampleDay := select_with_attr_by_org_rel(Time, Time/Day = 0) //Hier worden de analyse tijdstippen opgegeven. LET OP: Verander je deze dan zul je ook de NDW_meetmomenten/time moeten aanpassen. En de ChosenMoments ook wanneer er meer/minder momenten opgegeven zijn.
		, Descr = ""
		{
			attribute<bool>    ChosenMoments   := =asList(HoursMinutes/str,' || ');
			attribute<Time>    Time_rel        := org_rel;
			unit<uint8> ChosenHours    := PT_DepartureHours;
			unit<uint8> ChosenMinutes  := PT_DepartureMinutes;
			unit<uint8> HoursMinutes   := combine_uint8(ChosenHours, ChosenMinutes)
			{
				attribute<uint32> Hours     := ChosenHours/values[first_rel];
				attribute<uint32> Minutes   := ChosenMinutes/values[second_rel];
				attribute<string> str       := '(hour == '+string(Hours)+' && minute == '+string(Minutes)+' && second == 0)';
			}
		}
		
		unit<uint32> MeasureMoments := select_with_attr_by_cond(SampleDay, SampleDay/ChosenMoments)
		, Descr = ""
		{
			attribute<Time>    Moment := Time_rel;
			attribute<string>  Name   := Time/TemplatableText[Moment];
		}
	}
}
