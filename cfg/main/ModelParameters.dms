// The syntax of this configuration (items, units, expressions and operators) is described on the GeoDMS wiki: https://github.com/ObjectVision/GeoDMS/wiki
container ModelParameters : using = "units"
{
	// THE SETTINGS OF A RUN: what a run calculates and the assumptions PBL may vary. Agreed and technical choices and the tables are in Advanced,
	// what follows from the settings is in Impl. Each group of assumptions says whether it only changes the output, or also the stores in
	// %LocalDataProjDir%/IntermediateResults, which the model then makes again.

	// 1. WHAT: analysis moment, part of the day, origins and destinations, and the output
	parameter<string>   AnalysisMoment                    := 'Y2025'                , Descr = "The analysis moment, a year in Advanced/AnalysisMomentPresets (Y2015, Y2023 to Y2026), which sets the analysis day, the GTFS feed, OSM, TomTom, the CBS area division and the BAG (#125).";
	parameter<string>   PartOfDay                         := 'Ochtendspits'         , Descr = "The part of the day of the departure moments, from Advanced/PartsOfDay: 'Ochtendspits', 'Middag' or 'Avond', each with four moments a quarter of an hour apart (#125).", IntegrityCheck = "IsDefined(rlookup(this, Advanced/PartsOfDay/name))";
	parameter<string>   Orgset                            := 'Buurt2025'            , Descr = "The origin set, one of Advanced/org_domain_list.";
	parameter<string>   Destset                           := 'Buurt2025'            , Descr = "The destination set, one of Advanced/dest_domain_list.";
	parameter<string>   Orgset_EnkeleBuurt_Selection      := 'BU0363AD05'           , Descr = "The neighbourhood code (BU_CODE) when Orgset is a single neighbourhood.";
	parameter<string>   Orgset_EnkeleGem_Selection        := 'Dronten'              , Descr = "The municipality name when Orgset is a single municipality.";
	parameter<string>   Orgset_EnkeleProv_Selection       := 'Zuid_Holland'         , Descr = "The province name when Orgset is a single province.";
	parameter<string>   Orgset_EnkeleCorop_Selection      := 'Kop_van_Noord_Holland', Descr = "The COROP name when Orgset is a single COROP area.";
	parameter<string>   Destset_Enkele_Selection          := 'BU0363ET02'           , Descr = "The neighbourhood code (BU_CODE) when Destset is a single neighbourhood.";
	parameter<string>   Destset_EnkeleCorop_Selection     := 'Twente'               , Descr = "The COROP name when Destset is a single COROP area.";
	parameter<string>   Destset_EnkeleProv_Selection      := 'Zuid_Holland'         , Descr = "The province name when Destset is a single province.";
	parameter<string>   OutputLabel                       := 'basis'                , Descr = "Short name of the variant in the name of the output folder, Output/<analysis date>_<OutputLabel>_<component>: letters, digits, - and _, at most 20 characters (#118).", IntegrityCheck = "strlen(this) >= 1 && strlen(this) <= 20 && strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
	parameter<string>   OutputFormat                      := 'parquet'              , Descr = "Format of the output per origin block and departure moment: 'parquet', typed and with only the columns that vary within the component, or 'csv' with all columns.", IntegrityCheck = "OutputFormat == 'csv' || OutputFormat == 'parquet'";
	parameter<bool>     Export_TravelledDistance          := TRUE                   , Descr = "Does the output include the travelled distance?";
	parameter<bool>     Export_PriceInformation           := TRUE                   , Descr = "Does the output include the price, split into pre-transport, public transport and post-transport and per mode?";

	// 2. THE COMPONENT OF THIS RUN (#117): a direct trip (WW, CC or Car) or a public transport trip (PT) with a pre-transport and a
	// post-transport. Every component has its own output folder; Advanced/Components lists all combinations.
	parameter<string>   Component                         := 'PT'                   , Descr = "What this run calculates: 'WW' direct walking, 'CC' direct cycling, 'Car' the direct car trip with start and parking time, or 'PT' public transport with PreTransport and PostTransport (#117).", IntegrityCheck = "this == 'WW' || this == 'CC' || this == 'Car' || this == 'PT'";
	parameter</Classifications/TimeInvariantTypes> PreTransport := /Classifications/TimeInvariantTypes/V/Org2Stops_Walking // W: walking to every stop
		// /Classifications/TimeInvariantTypes/V/Org2Stops_Cycling      // C: cycling to every stop
		// /Classifications/TimeInvariantTypes/V/Org2RM_Stops_Cycling   // C_RM: cycling to a rail or metro stop
		// /Classifications/TimeInvariantTypes/V/Org2RMT_Stops_Cycling  // C_RMT: cycling to a rail, metro or tram stop
		// /Classifications/TimeInvariantTypes/V/Org2Ric_Stops_Cycling  // C_Ric: cycling to an intercity station
	, Descr = "The pre-transport of a public transport trip (Component 'PT'), one of Advanced/PreTransportTypes; the alternatives are listed below the value."
	, IntegrityCheck = "Component != 'PT' || IsDefined(rlookup(this, Advanced/PreTransportTypes/TimeInvariantTypes_rel))";
	parameter</Classifications/TimeInvariantTypes> PostTransport := /Classifications/TimeInvariantTypes/V/Stops2Dest_Walking // W: walking
		// /Classifications/TimeInvariantTypes/V/Stops2Dest_Cycling     // C: cycling from every stop
		// /Classifications/TimeInvariantTypes/V/RM_Stops2Dest_Cycling  // RM_C: cycling from a rail or metro stop
		// /Classifications/TimeInvariantTypes/V/RMT_Stops2Dest_Cycling // RMT_C: cycling from a rail, metro or tram stop
		// /Classifications/TimeInvariantTypes/V/OVF_Stops2Dest_Cycling // OVf_C: the OV-fiets, only from a stop at an OV-fiets location
	, Descr = "The post-transport of a public transport trip (Component 'PT'), one of Advanced/PostTransportTypes; only OVf_C rents a bike, the other cycling types use an own bike at the last stop."
	, IntegrityCheck = "Component != 'PT' || IsDefined(rlookup(this, Advanced/PostTransportTypes/TimeInvariantTypes_rel))";

	// 3. MERGING components into one front (NetworkSetup/ComponentMerge)
	parameter<bool>     MergeOutput                       := FALSE                  , Descr = "Does this run merge the output of MergeComponents into one Pareto front on MergeCriteria, instead of calculating a component (#117)?";
	parameter<string>   MergeComponents                   := 'WW,W_PT_W,CC,C_PT_W,C_PT_OVf_C,Car', Descr = "The components to merge, separated by commas, from Advanced/Components/name; their output must have the same OutputLabel, analysis moment, part of the day, origins and destinations (#117).";
	parameter<uint32>   MergeRunNr                        := 1                      , Descr = "Number of the merge in the name of its output folder (_Merged<MergeRunNr>); give a different set of components or criteria a different number.";
	parameter<string>   MergeCriteria                     := 'Price,Time,Car,Bike'  , Descr = "Criteria of the merged front: Price or Price_Augm, Time, Car (needs a car) and Bike (needs a bike); without Car and Bike an option with a car or bike can push out one without.", IntegrityCheck = "IsDefined(strpos(lowercase(this), 'price')) || IsDefined(strpos(lowercase(this), 'time'))";

	// 4. ASSUMPTIONS THAT ONLY CHANGE THE OUTPUT; the stores stay valid
	parameter<min_f>    MaxTravelTime                     := 90[min_f]              , Descr = "Maximum travel time of the whole public transport journey.";
	parameter<min_f>    MaxWalkingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum time of the direct walking trip.";
	parameter<min_f>    MaxCyclingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum time of the direct cycling trip.";
	parameter<euro_min> PreTransport_Walking_Time_Costs   := 0.19[euro_min]         , Descr = "Cost per minute of walking in the pre-transport, so that the cheapest journey does not simply walk as far as possible.";
	parameter<euro_min> PostTransport_Walking_Time_Costs  := 0.19[euro_min]         , Descr = "Cost per minute of walking in the post-transport, so that the cheapest journey does not simply walk as far as possible.";
	parameter<euro_min> Direct_Walking_Time_Costs         := 0.19[euro_min]         , Descr = "Cost per minute of the direct walking trip.";
	parameter<euro_min> Direct_Cycling_Time_Costs         := 0.09[euro_km] * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "Cost per minute of the direct cycling trip: 0.09 euro per km at CyclingSpeed_kmhr.";
	parameter<euro_min> PreTransport_Cycling_Time_Costs   := 0.09[euro_km] * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "Cost per minute of cycling in the pre-transport: 0.09 euro per km at CyclingSpeed_kmhr.";
	parameter<euro_min> PostTransport_Cycling_Time_Costs  := PreTransport_Cycling_Time_Costs, Descr = "Cost per minute of cycling on an own bike in the post-transport, the same as in the pre-transport; the OV-fiets costs OVFiets_RentalPrice instead.";
	parameter<euro>     OVFiets_RentalPrice               := 4.45[euro]             , Descr = "Rent of an OV-fiets for the first 24 hours.", Source = "NS, OV-fiets tariff 2023";
	parameter<Euro_km>  Car_CostPerKm                     := 0.24[Euro_km]          , Descr = "Cost of the direct car trip per km (#88).";
	parameter<Euro>     Car_FixedCosts_PerTrip            := 0[Euro]                , Descr = "Fixed cost per car trip, for example for parking.";
	parameter<min_f>    Car_StartTime                     := 2[min_f]               , Descr = "Time to walk to the car and drive off, added to the travel time of the direct car trip.";
	parameter<min_f>    Car_ParkingTime                   := 3[min_f]               , Descr = "Time to find a parking place and walk to the destination, added to the travel time of the direct car trip.";
	// The direct car trip is a Pareto front on travel time and distance per OD pair (Advanced/ParetoLegs_Car). Its cost follows from the distance,
	// distance x Car_CostPerKm + Car_FixedCosts_PerTrip, so the same front is also the front on travel time and cost (#88).

	// 5. ASSUMPTIONS THAT MAKE STORES AGAIN; the signature of a store contains them, so the model does not read a store made with other values
	// the legs (only with Advanced/LegsDecoupled, batch/UpdateAll.cmd legs)
	parameter<min_f>    MaxWalkingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum walking time from the origin to the first stop.";
	parameter<min_f>    MaxWalkingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum walking time from the last stop to the destination.";
	parameter<min_f>    MaxCyclingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum cycling time from the origin to the first stop.";
	parameter<min_f>    MaxCyclingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum cycling time from the origin to the first rail, metro or tram stop.";
	parameter<min_f>    MaxCyclingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum cycling time from the origin to the first rail or metro stop.";
	parameter<min_f>    MaxCyclingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum cycling time from the origin to the first intercity station.";
	parameter<min_f>    MaxCyclingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum cycling time from the last stop to the destination.";
	parameter<min_f>    MaxCyclingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from the last stop, at an OV-fiets location, to the destination.";
	parameter<min_f>    MaxCyclingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from the last rail, metro or tram stop to the destination.";
	parameter<min_f>    MaxCyclingTime_RM_Stops2Dest      := 15[min_f]              , Descr = "Maximum cycling time from the last rail or metro stop to the destination.";
	parameter<km_hr>    WalkingSpeed_kmhr                 := 4.5[km_hr]             , Descr = "Walking speed on the network.";
	parameter<km_hr>    CyclingSpeed_kmhr                 := 14[km_hr]              , Descr = "Cycling speed on the network.";
	// the chain store (batch/UpdateAll.cmd chains); the maximum pre-transport times above and the start and parking time of the bike also count
	// here, because they set the longest pre-transport (Impl/PT_Max_V_Time) and so the last boarding moment of the chains
	parameter<min_f>    Cycling_StartTime                 := 1[min_f]               , Descr = "Time to take the bike and ride off, added to every direct cycling trip and every cycling leg.";
	parameter<min_f>    Cycling_ParkingTime_IC_Station    := 3[min_f]               , Descr = "Extra parking time for a cycling pre-transport leg that ends at an intercity station, on top of Advanced/Cycling_PreTransport_Penalty (#117).";
	parameter<min_f>    MaxPTTime                         := 90[min_f]              , Descr = "Maximum travel time in public transport, including transfers and waiting.";
	parameter<uint16>   Max_transfers                     := 3w                     , Descr = "Maximum number of transfers.", IntegrityCheck = "this >= 1w && this <= 4w";
	parameter<euro_min> Transfer_Walking_Time_Costs       := 0.19[euro_min]         , Descr = "Cost per minute of walking during a transfer.";
	parameter<euro_min> Transfer_Waiting_Time_Costs       := 0.05[euro_min]         , Descr = "Cost per minute of waiting.";
	// the car stores (batch/UpdateAll.cmd cars)
	parameter<min_f>    MaxCarTime                        := 90[min_f]              , Descr = "Maximum travel time of the direct car trip.";
	parameter<bool>     UseTomTomNetworkForCars           := TRUE                   , Descr = "Does the car use the TomTom network with its congested speeds, or else the OSM network?";

	// 6. ONE OD PAIR (#129): with OD_Origin and OD_Destination the whole model calculates only that pair, with the same steps, and keeps the
	// links of the route of every option. Its stores go to IntermediateResults_<O>_<D>, its output to Output_<O>_<D>, and /Output/OD_PairRoutes
	// shows them on a map, in a table and in a chart. Empty: the whole model, without links.
	parameter<string>   OD_Origin                         := ''                     , Descr = "The origin of the OD pair, a name from Orgset such as the CBS neighbourhood code 'BU04020501'; empty for all origins.";
	parameter<string>   OD_Destination                    := ''                     , Descr = "The destination of the OD pair, a name from Destset such as 'BU0363KP03'; empty for all destinations.";
	parameter<string>   OD_DepartureTime                  := ''                     , Descr = "With an OD pair, one departure moment of PartOfDay as hh:mm, for example '07:30'; empty for all moments of the part of the day.", IntegrityCheck = "this == '' || (strlen(this) == 5 && substr(this, 2, 1) == ':')";
	parameter<uint32>   OD_Option                         := 0                      , Descr = "The option that the map of /Output/OD_PairRoutes shows separately, numbered from 1; 0 for all options.";

	#include<Advanced.dms>
	#include<Impl.dms>
}
