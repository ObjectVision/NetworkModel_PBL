container ModelParameters : using = "units"
{   
	//Generieke instellingen
	parameter<string>   AnalysisMoment                    := 'Y2026'                , Descr = "Select a year in order to automatically select the accompanying date values for other datasets, defined in Advanced/AnalysisMomentPresets";
	parameter<string>   Orgset                            := 'BAG_woonpanden_Clustered'                , Descr = "Select the origin set, defined in Advanced/org_domain_list.";              
	parameter<string>   Destset                           := 'OV_Knooppunten'                , Descr = "Select the destination set, defined in Advanced/dest_domain_list.";       
	parameter<string>   CentroidWeightType                := 'Addresses'            , Descr = "If you want to use weighted centroids for origins, how would you like to weigh the values comprsing the coentroid? Via addresses or population?";
	parameter<string>   Orgset_EnkeleBuurt_Selection      := 'BU0363AD05'           , Descr = "If you choose 'enkele_buurt' in the OrgSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Orgset_EnkeleGem_Selection        := 'Dronten'              , Descr = "If you choose 'enkele_gem' in the OrgSet, which municipality would you like? Use the municipality name.";
	parameter<string>   Orgset_EnkeleProv_Selection       := 'Zuid_Holland'         , Descr = "If you choose 'enkele_prov' in the OrgSet, which provincie would you like? Use the province name.";
	parameter<string>   Orgset_EnkeleCorop_Selection      := 'Kop_van_Noord_Holland', Descr = "If you choose 'enkele_corop' in the OrgSet, which COROP would you like? Use the corop name.";
	
	parameter<string>   Destset_Enkele_Selection          := 'BU0363ET02'           , Descr = "If you choose 'enkele_buurt' in the DestSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Destset_EnkeleCorop_Selection     := 'Twente'               , Descr = "If you choose 'enkele_corop' in the DestSet, which COROP would you like? Use the corop name.";
	parameter<string>   Destset_EnkeleProv_Selection      := 'Zuid_Holland'         , Descr = "If you choose 'enkele_corop' in the DestSet, which COROP would you like? Use the corop name.";
	parameter<bool>     Export_TravelledDistance          := TRUE                   , Descr = "Would you like to export the travelled distance along with the other attributes in the case of private and public transport?";
	parameter<bool>     Export_PriceInformation           := FALSE                   , Descr = "Would you like to export the price information along with the other attributes in the case of public transport?";
	
	//OV-berekening instellingen
	parameter<string>   GTFS_file_date                    := '20241001'             , Descr = "Which file date for the GTFS file would you like to use? Only relevant for public transport analysis."; // 20241001 20251008 20260316
	parameter<string>   Analysis_date                     := '20241001'             , Descr = "What is the date of interest for the public transport analysis? Make sure this date is equal or later than GTFS_file_date, and should be no later than a month after the GTFS_file_date.", IntegrityCheck = "uint32(this) >= uint32(GTFS_file_date) && uint32(this) <= uint32(GTFS_file_date) + 100"; 

	parameter<min_f>    MaxWalkingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum walking time from origin towards destination";
	parameter<min_f>    MaxWalkingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum walking time from origin towards first stop";
	parameter<min_f>    MaxWalkingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum walking time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxWalkingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum walking time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxWalkingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum walking time from origin towards first InterCity train station";
	parameter<min_f>    MaxWalkingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum walking time from last stop towards destination";
	parameter<min_f>    MaxWalkingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum walking time from last stop which is an OV-fiets station towards destination";
	parameter<min_f>    MaxWalkingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum walking time from last stop which is a RMT station towards destination";
	
	parameter<min_f>    MaxCyclingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum cycling time from origin towards destination";
	parameter<min_f>    MaxCyclingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxCyclingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxCyclingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first InterCity train station";
	parameter<min_f>    MaxCyclingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is an OV-fiets station towards destination";
	parameter<min_f>    MaxCyclingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is a RMT station towards destination";
	
	parameter<min_f>    MaxPTTime                         := 90[min_f]              , Descr = "Maximum travel time using public transport, including transfers and waiting. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<min_f>    MaxTravelTime                     := 90[min_f]              , Descr = "Maximum travel time of the complete journey. Only relevant for public transport analysis. Note that limiting this value might result in not being able to reach all destinations.";
	
	parameter<string>   MinimiseCriteria                  := 'Price,Time'                 , Descr = "Would you like to find the fastest or cheapest public transport journey? Choices: 'Price', 'Price_Augm' or 'Time' or both, i.e. 'Price,Time'";
	
	parameter<euro_min> Transfer_Walking_Time_Costs       := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Transfer_Waiting_Time_Costs       := 0.05[euro_min]         , Descr = "To attach a value to waiting, the cost thereof (or the time it takes) is incorporated.";
	parameter<euro_min> PreTransport_Walking_Time_Costs   := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> PostTransport_Walking_Time_Costs  := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Walking_Time_Costs         := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Cycling_Time_Costs         := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PreTransport_Cycling_Time_Costs   := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PostTransport_Cycling_Time_Costs  := 0.09[euro_km] * Advanced/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	
	//Auto berekening instellingen
	parameter<min_f>    MaxCarTime                        := 90[min_f]              , Descr = "Maximum travel time using car transport. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<bool>     UseTomTomNetworkForCars           := TRUE                   , Descr = "Would you like to use the TomTom network car analysis? Or if not, the OSM network is used.";
	
	//Directe ritten naast het OV. De ketenrijger voegt per HB-paar de directe rit(ten) bij de OV-ketens en houdt
	//het Pareto-front op MinimiseCriteria (prijs, tijd) over; zie NetworkSetup/PublicTransport_Prep/Direct_OD.
	//Tot 2026-09-23 deed of lopen of fietsen mee (AllowDirectCyclingOverWalking) en de auto helemaal niet.
	parameter<bool>     AllowDirectWalking                := TRUE                   , Descr = "Doet de directe looproute (OSM-loopnetwerk, tot MaxWalkingTime_Org2Dest) mee in het front per HB-paar?";
	parameter<bool>     AllowDirectCycling                := TRUE                   , Descr = "Doet de directe fietsroute (OSM-fietsnetwerk, tot MaxCyclingTime_Org2Dest) mee in het front per HB-paar?";
	parameter<bool>     AllowDirectCar                    := TRUE                   , Descr = "Doet de directe autorit (TomTom of OSM, zie UseTomTomNetworkForCars, tot MaxCarTime) mee in het front per HB-paar? De autoprijs volgt uit de TCO-parameters hieronder.";
	parameter<string>   Car_CongestionMoment_ForDirect    := 'MorningRush'          , Descr = "Welke reistijd van de auto de directe rit gebruikt: 'MorningRush' (07:30), 'NoonRush' (12:30), 'LateEveningRush' (19:30) of 'Freeflow' (alleen TomTom; bij OSM heet dat 'MaxSpeed'). Een koppeling per vertrekmoment is er nog niet; met de huidige vertrekmomenten (07:00 t/m 07:45) is MorningRush de juiste.", IntegrityCheck = "UseTomTomNetworkForCars ? Car_CongestionMoment_ForDirect != 'MaxSpeed' : Car_CongestionMoment_ForDirect == 'MaxSpeed'"; // TomTom kent Freeflow/MorningRush/NoonRush/LateEveningRush; OSM alleen MaxSpeed, want de OSM-spitsen zijn null-placeholders
	parameter<Euro_km>  Car_VariableCosts_PerKm           := 0.20[Euro_km]          , Descr = "Variabele autokosten per km (brandstof, banden, onderhoud). Samen met Car_FixedCosts_PerKm de TCO van 41 ct/km uit de planning van week 38; de verdeling 20/21 is een eerste aanname en is nog door PBL te zetten.";
	parameter<Euro_km>  Car_FixedCosts_PerKm              := 0.21[Euro_km]          , Descr = "Vaste autokosten (afschrijving, verzekering, belasting) omgeslagen per km. Telt alleen mee als Advanced/IncludeCarFixedCostsInPrice aan staat.";
	parameter<Euro_km>  Car_TCO_PerKm                     := Car_VariableCosts_PerKm + Car_FixedCosts_PerKm, Descr = "Total cost of ownership per km, de som van variabel en vast: 41 ct/km.";
	parameter<Euro>     Car_FixedCosts_PerTrip            := 0[Euro]                , Descr = "Vast bedrag per autorit, bijvoorbeeld parkeren; 0 tot daar een waarde voor is.";
	parameter<min_f>    Car_StartTime                     := 2[min_f]               , Descr = "Starttijd van een autorit: naar de auto lopen, instappen, wegrijden. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	parameter<min_f>    Car_ParkingTime                   := 3[min_f]               , Descr = "Parkeertijd aan het eind van een autorit: parkeerplek zoeken en naar de bestemming lopen. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	// KOSTEN PER LINK. De prijs van de directe autorit is de som over de gereden links van lengte x kilometerprijs
	// (Car_VariableCosts_PerKm x Car_VariableCosts_RoadTypeFactor[wegklasse], plus Car_FixedCosts_PerKm als
	// IncludeCarFixedCostsInPrice aan staat) plus de optrekkosten op kruispunten (de penalty-seconden van beide
	// linkuiteinden x Car_TurnCosts_PerPenaltyMinute x Car_TurnCosts_RoadTypeFactor[wegklasse]), plus
	// Car_FixedCosts_PerTrip. Reistijd en kosten zijn zo
	// niet lineair gekoppeld, dus is die linkkost het tweede criterium van het pareto-front (ParetoLegs_Car).
	// Alleen het TomTom-net kent per link de wegklasse (FRC) en de kruispuntpenalty apart; het OSM-autonet rekent
	// lengte x Advanced/Car_CostsInPrice_PerKm, want de contractie in CreateNetwork_Efficient_T houdt wegtype en
	// penalty niet per link bij.
	// Eerste aanname per wegklasse (index = Classifications/FuncRoadClass): het variabele deel per km volgt het
	// verbruik, dat het laagst is bij 60-80 km/u en oploopt op de snelweg (luchtweerstand) en in de stad (lage
	// versnelling); WLTP-fasen laag/midden/hoog/extra hoog ~ 7,5/5,5/5,0/6,5 l/100 km voor een gemiddelde
	// benzineauto. Het stop-and-go-deel van het stadsverbruik zit apart in Car_TurnCosts_PerPenaltyMinute, dus de
	// stadsfactoren zijn gematigd. Zo geschaald dat het kilometergewogen gemiddelde (ca. 45% snelweg, 30%
	// provinciaal, 25% stedelijk) op 1 blijft: Car_VariableCosts_PerKm is dan nog steeds het gemiddelde.
	//                                                                          NA    FRC0  FRC1  FRC2  FRC3  FRC4  FRC5  FRC6  FRC7  FRC8
	attribute<float32>  Car_VariableCosts_RoadTypeFactor (Classifications/FuncRoadClass) : [1.00, 1.05, 0.95, 0.85, 0.90, 0.95, 1.00, 1.10, 1.20, 1.20]
	,	Descr = "Factor op Car_VariableCosts_PerKm per TomTom-wegklasse, in de volgorde van Classifications/FuncRoadClass/Label: Not Applicable 1,00 (ook de OD-koppellinks), Motorway 1,05 (100-130 km/u, luchtweerstand), Major Road 0,95 (autoweg 100), Other Major Road 0,85 (provinciale weg 80, het zuinigste bereik), Secondary Road 0,90, Local Connecting Road 0,95, Local Road of High Importance 1,00, Local Road 1,10 (50), Local Road of Minor Importance 1,20 (30, woonstraten), Other Road 1,20. Eerste aanname uit de WLTP-verbruiksfasen, kilometergewogen gemiddelde 1; door PBL te zetten.";
	parameter<Euro_min> Car_TurnCosts_PerPenaltyMinute    := 0.30[Euro_min]          , Descr = "Optrekkosten: extra brandstof door afremmen en weer optrekken op kruispunten, uitgedrukt per minuut kruispuntpenalty (Advanced/Junction_Penalties, aan beide linkuiteinden geteld) op een weg van 50 km/u; per wegklasse vermenigvuldigd met Car_TurnCosts_RoadTypeFactor. 0,30 Euro/min = 0,5 ct per penalty-seconde: een kruising van 4 wegen kost bij 50 km/u 2 x 5 s = 5 ct, een zijweg 2 x 2 s = 2 ct. Eerste aanname (optrekken naar 50 km/u kost ongeveer 3 ct brandstof), door PBL te zetten.";
	// De energie om na een stop weer op snelheid te komen schaalt met het kwadraat van die snelheid; de factor is
	// (typische snelheid van de wegklasse / 50)^2: 130 -> 6,76, 100 -> 4,00, 80 -> 2,56, 70 -> 1,96, 60 -> 1,44,
	// 50 -> 1,00, 40 -> 0,64, 30 -> 0,36. Op de snelweg zijn kruispuntpenalty's zeldzaam (op- en afritten).
	//                                                                      NA    FRC0  FRC1  FRC2  FRC3  FRC4  FRC5  FRC6  FRC7  FRC8
	attribute<float32>  Car_TurnCosts_RoadTypeFactor (Classifications/FuncRoadClass) : [1.00, 6.76, 4.00, 2.56, 1.96, 1.44, 1.00, 0.64, 0.36, 0.36]
	,	Descr = "Factor op Car_TurnCosts_PerPenaltyMinute per TomTom-wegklasse, in de volgorde van Classifications/FuncRoadClass/Label: Not Applicable 1,00 (ook de OD-koppellinks), Motorway 6,76 (130 km/u), Major Road 4,00 (100), Other Major Road 2,56 (80), Secondary Road 1,96 (70), Local Connecting Road 1,44 (60), Local Road of High Importance 1,00 (50), Local Road 0,64 (40), Local Road of Minor Importance 0,36 (30), Other Road 0,36. Eerste aanname: (typische snelheid / 50 km/u) in het kwadraat, de kinetische energie die na een stop opnieuw opgebouwd wordt; door PBL te zetten.";
	
	container Advanced : using = "classifications"
	{
		/// GENERAL
		parameter<string>   BAG_snapshot                              := rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/BAG_snapshot)
		,	Descr = "Naam van de BAG-snapshotmap onder %BAG_DataDir%/BAG/snapshots.ext, per AnalysisMoment in de presettabel. Stond tot 2026-09-22 vast aan RegioIndelingen_year, maar de BAG-standdatum en de CBS-gebiedsindeling lopen niet gelijk: voor Y2026 is er een BAG-snapshot per 1-1-2026 terwijl de gebiedsindeling 2026 nog geen buurt- en wijkkaart heeft.";
		parameter<string>   BAG_year                                  := substr(BAG_snapshot, 0, 4)
		,	Descr = "Het jaar van de BAG-snapshot, uit BAG_snapshot. Wordt gebruikt om bouwjaren na de standdatum af te kappen en in de exportnamen.";
		parameter<string>   RegioIndelingen_year                      := rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/RegioIndelingen_year), Descr = "Which year for the adminstrative boundaries would you like to use? This is now decided via AnalysisMoment.";
		parameter<string>   LISA_year                                 := '2018'                 , Descr = "Which year of the LISA-dataset would you like to use?";
		parameter<bool>     Dests_geclusterd                          := FALSE                  , Descr = "Would you like to cluster destinations? For example useful for firm destinations, with many firms at the same location. To determine the area of clustering look at Dest_location_scale";
		parameter<string>   Dest_location_scale                       := '100m'                 , Descr = "If clustering the destination, at which scale would you like to cluster? Options: '100m', '500m', '1000m', '5000m', '10000m', '50000m'";
		parameter<string>   Org_location_scale                        := '500m'                 , Descr = "Celmaat waarop de BAG-herkomsten geclusterd worden (BAG_woonpanden_Clustered).\n"
						"Opties zijn de celmaten uit geometries/Gridsizes: '25m', '100m', '500m', '1000m', '5000m', '10000m', '50000m'.\n"
						"Stond tot 2026-09-22 vast aan Dest_location_scale; op 100m levert de BAG-snapshot van 1-1-2026 588.903 herkomsten, wat de blokindeling en de OD-omvang onwerkbaar maakt.\n"
						"Losgekoppeld omdat de bestemmingen hun eigen maat mogen houden.";
		parameter<string>   items_of_interest                         := rjoin(lowercase(DestSet), lowercase(Advanced/dest_domain_list/label), Advanced/dest_domain_list/items_of_interest), Descr = "What is the item of interest in the analysis? Such as number of jobs. Decided via the dest_set.";
		parameter<bool>     ExcludeOrgBuurtCentroidsWithoutAddressPop := FALSE                  , Descr = "Would yo like to exclude buurt centroid that do not contain addresses or population (depending on CentroidWeightType).";
		parameter<string>   fileNamePrefix                            := '%LocalDataProjDir%/Output/PerBlock/', Descr = "Location where output files will be saved.";
		parameter<uint8>    NumberOfItersForNetworkCleanUp            := 10b                    , Descr = "In the network clean up method, how many iternations should be used?";

		// PUBLIC TRANSPORT
		parameter<string>   NS_TariffChoice                           := 'Price_FullFare'      , Descr = "Which tarif class for NS would you like to use. Full fare, or a discounted fare? Choices: 'Price_40pct_Discount' 'Price_20pct_Discount' 'Prijs_voltarief'";
		parameter<m>        MaxTransferDist                           := 500[m]                 , Descr = "Maximum Euclidean distance between public transport stops that is allowed to be walked for transfers.";
		parameter<string>   Concessiegebied_year                      := value(FareTable_year, uint32) < 2020 ? 'Y2020' : 'Y'+FareTable_year , Descr = "Which year of the concession areas would you like to use? Relevant for public transport price determination. Concessie-shapes bestaan alleen 2020-2026; voor FareTable_year < 2020 (o.a. DOVA-prijzen terug tot 2013) wordt Y2020 als proxy gebruikt.";
		parameter<string>   Concessiegebied_source                    := 'manual'               , Descr = "Use manual creation of concessiegebieden (based on CROW poster), or shapefile from CROW. Options:  manual, shape";
		parameter<string>   FareTable_year                            := substr(GTFS_file_date, 0, 4), Descr = "Prijsjaar; volgt automatisch het jaar van GTFS_file_date, zodat de FareTable-agency-labels altijd bij de geladen feed horen (elke FareTable_<jaar> is uitgelijnd op de agency-set van de feed van dat jaar, zie data/FareTable_dekkingsrapport.md). Detailed-FareTables bestaan voor 2023-2026; voor eerdere jaren schakelt de prijsbepaling automatisch op DOVA (zie Advanced/PriceMethod_effective).";
		parameter<string>   PriceMethod                               := 'DOVA'             , Descr = "OV-prijsmethode: 'Detailed' (handmatige FareTable per Mode/Agency/Concessie/Lijn, zie OVprijzen/FareTable_2023) of 'DOVA' (concessie-brede km-tarieven uit DOVA-overzicht, terug tot 2013). Bij 'DOVA' bepaalt FareTable_year welk jaar (2013-2026) wordt gebruikt.";
		parameter<string>   PriceMethod_effective                     := value(FareTable_year, uint32) < 2023 ? 'DOVA' : PriceMethod, Descr = "Effectieve prijsmethode: Detailed-FareTables bestaan alleen voor 2023-2026, dus voor FareTable_year < 2023 (oudere GTFS-feeds) wordt altijd DOVA gebruikt, ongeacht PriceMethod.";
		parameter<string>   DOVA_year                                 := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaarkolom in het DOVA-overzicht (y2013..y2026); geklemd op dat bereik (bv. feed 20120917 -> 2013-prijzen).";
		parameter<string>   NS_prijzen_year                           := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaargang van de NS-tarieven-csv (data/Tarieven_NS/NS tarieven <jaar>.csv, 2013-2026 aanwezig); geklemd op dat bereik.";
		parameter<m>        DistanceTrainStationsSelection            := 350[m]                 , Descr = "To find out which GTFS-stops relate to which trainstation a geographic search distance is used.";
		parameter<m>        DistanceStopClusters                      := 100[m]                 , Descr = "To cluster stops which belong to the same 'stop' a geographic search distance is used. Stops in opposite directions should be considered the same stop cluster. Travelling from stops within a cluster is non-sensical.";
		parameter<m>        DistanceOVFietsStops                      := 200[m]                 , Descr = "Maximale zoekafstand om OVfiets stations te koppelen aan GTFS haltes.";
		parameter<m>        DistanceKnooppuntClusters                 := 150[m]                 , Descr = "Clusterafstand om GTFS-haltes samen te voegen tot een OV-knooppunt (single linkage via connected_parts). Perrons/haltekommen van hetzelfde knooppunt vallen zo samen.";
		parameter<uint32>   Knooppunt_MinLijnen_BTM                   := 8                      , Descr = "Minimaal aantal unieke bus/tram/metro-lijnen op een haltecluster om als BTM-knooppunt te gelden (kruisende lijnen). Treinstations zijn altijd knooppunt; een solitaire metrohalte niet (die telt via de BTM-lijnen mee). Bij 8 lijnen ca. 270 BTM-knopen excl. metro (GTFS 20260316), schaal TBOV-actieagenda (~700 knooppunten totaal); bij 5 lijnen ca. 780.";
		parameter<uint32>   Knooppunt_MinVertrekken_BTM               := 150                    , Descr = "Minimaal aantal bus+tram+metro-vertrekken per dag (Analysis_date) op een haltecluster om als BTM-knooppunt te gelden. 150/dag komt overeen met ca. 8-10 vertrekken/uur overdag.";
		parameter<float32>  Knooppunt_BedrijfsurenPerDag              := 18f                    , Descr = "Aantal bedrijfsuren per dag waarmee vertrekken/dag wordt omgerekend naar frequentie/uur, t.b.v. de ontsluitingswaarde (vlindermodel).";
		parameter<m>        Knooppunt_DominantieRadius                := 1500[m]                , Descr = "Niet verhogen naar 2000m: dan valt o.a. busstation Drachten weg onder een sterkere kandidaat-halte in de buurt. Dominantiefilter (competitie, vgl. Goudappel 2024): een BTM-knooppunt vervalt als binnen deze straal een kandidaat met hogere netwerkwaarde ligt. Voorkomt reeksen knopen langs HOV-corridors (Zuidas, Uithoflijn), meerdere punten per groot complex (Schiphol) en corridorhaltes zonder eigen regiofunctie naast een station (Anderlechtlaan bij Station Zuid, De Hoek bij Hoofddorp). Een sterke BTM-knoop naast een zwak station blijft gewoon staan (Zoetermeer Centrum West naast Zoetermeer station); treinstations zelf vervallen nooit onder BTM-knopen.";
		parameter<m>        Knooppunt_DedupRadiusTrein                := 400[m]                 , Descr = "Twee treinclusters binnen deze straal (bv. NS-perrons en stadshaltes van hetzelfde station die net buiten de clusterafstand vallen, zoals Sloterdijk) worden ontdubbeld: het cluster met de meeste treinvertrekken blijft. Kortste afstand tussen twee echte NL-stations is ca. 800m, dus 400m is veilig.";
		parameter<uint32>   Knooppunt_MinRichtingen_BTM               := 3                      , Descr = "Minimaal aantal windrichtingen (4 sectoren: O/W/N/Z op basis van de richting naar de volgende halte) waarin BTM-vertrekken het cluster verlaten. Een corridor-bundel (R-net over een as, bv. Ilpendam) heeft er 2; een echt knooppunt met kruisende of uitwaaierende lijnen 3-4. Operationaliseert 'aantal richtingen' uit het vlindermodel.";
		parameter<float32>  Knooppunt_MinNetwerkwaarde_BTM            := 0f                     , Descr = "Optionele extra drempel op de netwerkwaarde (vlindermodel) voor BTM-knooppunten; 0 = uit. Ter referentie (GTFS 20260316): Amsterdam CS 3400, Station Noord 988, Zoetermeer Centrum West 501, Hoofddorp De Hoek 331, Anderlechtlaan 194, Lemmer busstation 111, Zierikzee busstation 78. Let op: een hoge drempel (bv. 500) schrapt vrijwel alle busstations in spoorloze kernen (Zierikzee, Lemmer, Drachten) - precies de knopen waarvoor deze laag is toegevoegd.";
		parameter<min_f>    MaxTransferTimeForBoardingSurcharge       := 35[min_f]              , Descr = "Maximale overstap tijd om binnen opstap basistarief te blijven. Dit is door Nederlands OV-prijs model bepaald. Dus niet zomaar aanpassen.";
		// AllowDirectCyclingOverWalking (of lopen, of fietsen) is op 2026-09-23 vervangen door
		// /ModelParameters/AllowDirectWalking, AllowDirectCycling en AllowDirectCar: de directe ritten doen
		// naast elkaar mee in het front per HB-paar.
		parameter<m_s>      TransferEffectiveSpeed                    := value(4.5[km_hr] / 1.2f, m_s), Descr = "De loopsnelheid tijdens het overstappen. X km/uur / 1.2 (correctie voor Manhattan distances) en dan geconverteerd naar meter/sec.";
		parameter<bool>     IncludeWaitingAtHomeInTravelTime          := FALSE                  , Descr = "Wil je dat de wachttijd thuis wordt meegenomen in de totale reisduur, bij vertrektijd vanaf bepaald moment?";
		parameter<Time>     MaxWaitingTimeAtOrigin                    := 899[Time]             , Descr = "Maximale wachttijd thuis. Zet je dit hoog, zonder dat dit in de reistijd zit (WeighingWaitingAtOriginPreTransport = 0) dan kun je ongemerkt veel later vertrekken dan je denkt.";
		parameter<min_f>    GradeSeparatedTransferPenalty             := 0[min_f]               , Descr = "Does a public transport stop have a lot of vertical distance to traverse? In that case a time penalty will be given when traffering through that stop.";
		parameter<min_f>    Cycling_StartTime                         := 1[min_f]               , Descr = "Starttijd van elke fietsrit: fiets pakken en wegrijden. Opgeteld bij de reistijd van de directe fietsrit, van elk fietsbeen in het voortransport en van elk fietsbeen in het natransport. Eerste aanname, door PBL te zetten.";
		parameter<min_f>    Cycling_PreTransport_Penalty              := 0[min_f]               , Descr = "Parkeertijd van de fiets aan het eind van ELK fietsbeen in het voortransport (bij een halte of station). Sinds 2026-09-23 opgeteld in de OD-matrix van het been zelf (CreateNetwork_Pedestrian_Bike_T/ODMatrix/ExtraTime_seconds), niet meer apart in de ketenrijger.";
		parameter<min_f>    Cycling_ParkingTime_IC_Station            := 3[min_f]               , Descr = "EXTRA parkeertijd, bovenop Cycling_PreTransport_Penalty, voor een fietsbeen in het voortransport dat eindigt op een IC-station (het type Org2Ric_Stops_Cycling, StopClass 'Ric'): grote stallingen, langer lopen naar het perron. Punt 3 van de planning van week 38. Eerste aanname, door PBL te zetten.";

		// FLEX-/BELBUSLIJNEN (ObjectVision/NetworkModel_PBL#113)
		// Bravoflex, U-flex, SyntusFlex, FlexRRReis, Overal Flex, Texelhopper, Opstapper en belbussen staan in de
		// GTFS-feeds als gewone lijnen met ritten, maar moeten 30-60 min vooraf geboekt worden. NeTEx heeft er geen
		// gebiedsgeometrie voor (alleen de BISON flex-markering), dus de herkenning loopt op lijnnaam
		// (SourceData/Infrastructure/GTFS/RelevantSelection/Routes/IsFlex). 'asis' = gedrag van voor #113: de
		// expressies en cache-namen blijven letterlijk gelijk, dus bestaande CalcCache en PT_Chains-fss blijven geldig.
		parameter<string>   FlexMode                                  := 'asis'                 , Descr = "Omgang met flex-/belbuslijnen: 'asis' = als gewone lijn (huidig gedrag); 'exclude' = alle links (rit- en wachtlinks) van flex-lijnen uit het OV-net; 'penalty' = FlexBoardingPenalty optellen bij de reistijd van elk been op een flex-lijn (een been = precies een instap, want NodeSet = (tijd, halte, route)). Welke lijnen: /FlexReport/Report.", IntegrityCheck = "this == 'asis' || this == 'exclude' || this == 'penalty'";
		parameter<min_f>    FlexBoardingPenalty                       := 20[min_f]              , Descr = "Boekings-/wachttoeslag per instap op een flex-lijn; alleen gebruikt bij FlexMode = 'penalty' (PBL-keuze, 15-30 min). Telt mee in de MaxPTTime-grens, net als GradeSeparatedTransferPenalty.", IntegrityCheck = "this >= 0[min_f]";
		parameter<string>   FlexMode_FileTag                          := FlexMode == 'exclude' ? '_noflex' : (FlexMode == 'penalty' ? '_flexpen'+string(FlexBoardingPenalty)+'min' : ''), Descr = "Naamsuffix voor de PT_Chains-cache (PublicTransport_Prep/StorageName_Str); leeg bij 'asis', zodat bestaande caches en de #115-vergelijking geldig blijven.";
		unit<uint8> FlexRouteTerms : nrofrows = 4
		, Descr = "Zoektermen (kleine letters, regex-alternatieven) waarop een GTFS-route als flex geldt; gezocht in lowercase(route_short_name + ' ' + route_long_name). Bewust smal: 'buurtbus'/'wijkbus' (dienstregeling), 'hopper' (Spijkhopper/Maasvlaktehopper zijn gewone EBS-lijnen), 'vlinder' (Arriva-kleinbussen op dienstregeling en de plaatsnaam 'Zaandam De Vlinder') en 'taxibus i.p.v. trein' (treinvervangend) horen er NIET in; die staan als bijna-treffers in FlexNearMissTerms en /FlexReport/NearMiss."
		{
			attribute<string> term        : ['flex', 'texelhopper', 'opstapper', 'belbus'];
			attribute<string> toelichting : ['Bravoflex (Arriva), Connexxion FLEX, Overal Flex, FlexRRReis, SyntusFlex, U-flex', 'Texelhopper (TXL)', 'Opstapper Fryslan (Arriva/Qbuzz)', 'belbus, generiek'];
		}
		parameter<string>   FlexRoutePattern                          := asList(FlexRouteTerms/term, '|');
		unit<uint8> FlexNearMissTerms : nrofrows = 5, Descr = "Termen die op flex lijken maar (nu) niet als flex gelden; alleen voor /FlexReport/NearMiss."
		{
			attribute<string> term : ['buurtbus', 'wijkbus', 'hopper', 'vlinder', 'taxi'];
		}
		parameter<string>   FlexNearMissPattern                       := asList(FlexNearMissTerms/term, '|');

		parameter<bool>     IncludeWalkingCostsInPrice                := FALSE                  , Descr = "Wil je reistijdkosten van lopen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCyclingCostsInPrice                := TRUE                   , Descr = "Wil je reistijdkosten van fietsen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCarCostsInPrice                    := TRUE                   , Descr = "Telt de kostprijs van de directe autorit (Car_FixedCosts_PerTrip + km x Car_CostsInPrice_PerKm) mee in Price? Zo niet, dan is de auto in het front gratis en wint hij op prijs altijd.";
		parameter<bool>     IncludeCarFixedCostsInPrice               := TRUE                   , Descr = "Telt het vaste deel van de TCO (Car_FixedCosts_PerKm) mee in de autoprijs, of alleen het variabele deel?";
		parameter<Euro_km>  Car_CostsInPrice_PerKm                    := /ModelParameters/Car_VariableCosts_PerKm + (IncludeCarFixedCostsInPrice ? /ModelParameters/Car_FixedCosts_PerKm : 0[Euro_km]), Descr = "De kilometerprijs die de directe autorit in het front krijgt: variabel, plus vast als IncludeCarFixedCostsInPrice aan staat.";
		
		unit<uint8> DirectModes : nrofrows = 3
		, Descr = "De directe modaliteiten die naast het OV in het front per HB-paar kunnen meedoen, met hun schakelaar. De naam is de naam van de bron onder NetworkSetup/PublicTransport_Prep/Direct."
		{
			attribute<string> name    : ['Walking', 'Cycling', 'Car'];
			attribute<string> abbrev  : ['W', 'C', 'A'], Descr = "Letter van de modaliteit in ModeUsed (Modes/Selection/name_abbr); een directe rit heet in de uitvoer WW, CC of AA.";
			attribute<bool>   Allowed := union_data(., /ModelParameters/AllowDirectWalking, /ModelParameters/AllowDirectCycling, /ModelParameters/AllowDirectCar);
		}
		unit<uint8> DirectModes_Selected := select_with_attr_by_cond(DirectModes, DirectModes/Allowed), Descr = "De toegestane directe modaliteiten.";
		parameter<string>   Direct_str                                := asList(DirectModes_Selected/abbrev + DirectModes_Selected/abbrev, ',')
		,	Descr = "De directe modaliteiten zoals ze in de uitvoernamen staan (V-<Direct_str>,<voortransport>_N-<natransport>): WW, CC en/of AA, in de volgorde van DirectModes. Verving op 2026-09-23 de keuze 'CC' of 'WW' uit AllowDirectCyclingOverWalking."
		,	IntegrityCheck = "Direct_str != ''" // minstens een van AllowDirectWalking/Cycling/Car moet aan staan: Direct_OD is een union over de toegestane modaliteiten
		;
		parameter<uint32>   NumberOfStopBlocks                        := 500                    , Descr = "In the generation of the unlinked PT-network, how many stop blocks should be used in the Ketenrijger? Less means more memory usage per unit of time.";
		parameter<uint32>   MaxStopBlockSize                          := 104                     , Descr = "In the generation of the unlinked PT-network, what is maximum stop block size? Make sure that the product of this value and the NumberOfStopBlocks is sufficient to include all stops";
		parameter<uint32>   NumberOfOrgBlocks                         := 450                    , Descr = "In the generation of PT-output files, how many origin blocks should be used? Less means more memory use, but less overhead. Het product met MaxOrgBlockSize moet minstens het aantal herkomsten zijn, zie ChecksBeforeRunning/Check_OriginBlocks: 450 x 200 = 90.000 dekt de 88.126 herkomsten van de 500m-clustering (441 gevulde blokken). Bij een nieuwe BAG-snapshot met meer herkomsten meldt die check precies welk getal nodig is.";
		parameter<uint32>   MaxOrgBlockSize                           := 200                    , Descr = "In the generation of PT-output files, what is maximum origin block size? Make sure that this number times the number of blocks is larger than the number of origins. 200 herkomsten per blok houdt een blok behapbaar; bij de oude buurt-herkomsten stond dit op 30.";
		parameter<uint16>   Max_transfers                             := 3w                     , Descr = "How many transfers are allowed?", IntegrityCheck = "this >= 1w && this <= 4w";
		parameter<bool>     PriceExportsAndIntegrityChecksNeeded      := IsDefined(strpos(lowercase(MinimiseCriteria), 'price')) || Export_PriceInformation;
		// PARETO-BENEN (ObjectVision/NetworkModel_PBL#115, ObjectVision/GeoDMS#856)
		// De pareto-optie van impedance_matrix doet een bi-criteria label-setting zoektocht op
		// (Duration, Length) in plaats van min-Duration met Length als bijproduct. Voor het R-net is
		// prijs = FixedPrice + VariablePrice * afstand en dus monotoon in Length: het (tijd,afstand)-
		// front IS daar het (tijd,prijs)-front. Voor het L-net (NS) volgt de prijs uit de
		// TariffUnits-matrix over (eerste,laatste) station en dus uit het OD-paar zelf; een front
		// levert daar geen extra prijsopties op, alleen meer rijen. Vandaar twee schakelaars.
		// De vier schakelaars zelf staan in een eigen bestand, zodat de meetharnas van #115 per
		// arm EEN bestand in zijn geheel kan herschrijven in plaats van regels in dit bestand te
		// moeten patchen: welke arm draait is dan af te lezen aan `git diff cfg/main/ParetoArm.dms`.
		#include<ParetoArm.dms>
		// PARETO-FRONT VOOR DE DIRECTE AUTORIT (vervolg op #115 en #88). De auto-Dijkstra levert per HB-paar
		// EEN route, de snelste, en de prijs volgt uit de afstand van die route. Met de pareto-optie levert
		// dezelfde operator per HB-paar het (reistijd, kosten)-front: de snelle snelwegroute naast de korte
		// binnenweg. Het tweede criterium is de kostprijs per link (zie de KOSTEN PER LINK hierboven), dus dat
		// is precies het (tijd, prijs)-front dat de ketenrijger per HB-paar tegen OV, lopen en fietsen afweegt. Alleen de
		// directe rit (PublicTransport_Prep/Direct/Car) gebruikt de pareto-variant; de auto-exports blijven scalair.
		parameter<bool>     ParetoLegs_Car                            := TRUE                   , Descr = "Gebruik de pareto-optie van impedance_matrix_od64 voor de directe autorit in het front per HB-paar: per HB-paar alle (reistijd, linkkosten)-optimale routes in plaats van alleen de snelste. Kost meer rekentijd en geheugen dan de scalaire Dijkstra; zie CarLegCostQuantum.";
		parameter<Euro>     CarLegCostQuantum                         := 0.10[Euro]             , Descr = "Kwantisatie van het tweede pareto-criterium (de kosten per link, in euro). Zonder kwantisatie (0[Euro]) ontsporen de fronten op een wegennet met continue kosten (GeoDMS doc/bicriteria-impedance.md 5.5), en het aantal labels per knoop in de zoektocht schaalt met (maximale ritkosten / kwantum): met 1 ct gaf MorningRush op 88.126 herkomsten 12 routes per HB-paar en een telpas van 12 uur, met 10 ct fronten van enkele routes en een rit van uren. Omdat de meeste TomTom-links korter zijn dan het kwantum (gemiddeld 87 m = 3,6 ct) wordt niet naar het dichtstbijzijnde veelvoud afgerond (dan valt alles onder een half kwantum weg, 6 procent van het net bij 4 ct) maar met een vaste pseudo-toevallige drempel per link (dithering, zie ImpedanceMatrix_with_Cost_T/Cost_q): de som over een route is dan onvertekend, met ruis van ongeveer een half kwantum maal de wortel van het aantal links (3 procent op een rit van 300 links). Het front onderscheidt dus kostenverschillen vanaf ongeveer een euro.";
		parameter<string>   ParetoLegs_Car_FileTag                    := ParetoLegs_Car ? '_paretoCar' + (CarLegCostQuantum > 0[Euro] ? 'q'+string(CarLegCostQuantum * 100f)+'ct' : '') : '', Descr = "Naamsuffix voor de OV-uitvoer per blok en vertrekmoment, want het front met de directe autorit hangt van deze twee parameters af; leeg als ParetoLegs_Car uit staat.";
		parameter<string>   Car_CostTag                               := '_c' + string(/ModelParameters/Car_VariableCosts_PerKm * 100f) + '-' + string(/ModelParameters/Car_FixedCosts_PerKm * 100f) + (IncludeCarFixedCostsInPrice ? 'f' : 'v')
		                                                             + '-t' + string(/ModelParameters/Car_TurnCosts_PerPenaltyMinute * 100f)
		                                                             + '-r' + string(sum(/ModelParameters/Car_VariableCosts_RoadTypeFactor) * 100f) + '-' + string(sum(/ModelParameters/Car_TurnCosts_RoadTypeFactor) * 100f)
		                                                             + '-p' + string(/ModelParameters/Car_FixedCosts_PerTrip * 100f)
		,	Descr = "Samenvatting van de kostenparameters van de auto voor de naam van de stores van de directe autorit (PublicTransport_Prep/Direct/CarPerMoment/<moment>/Write_Car): centen variabel en vast per km (v/f = vast deel niet/wel in de prijs), optrekkosten per penalty-minuut, de sommen van de twee factortabellen x 100, en het bedrag per rit. Andere kosten geven zo een andere store in plaats van stil een oude.";

		parameter<euro>     OVFiets_RentalPrice                       := 4.45[euro]             , Descr = "Prijs voor de huur van de fiets voor de eerste 24u. 2023=4.45 euro";
		parameter<bool>     UseOVFietsPriceForAllCyclingPostTransport := TRUE                   , Descr = "Wil je voor al het fiets-PostTransport het vaste bedrang van de OV-fiets gebruiken? En dus de km-prijs niet gebruiken.";
		
		// PRIVATE TRANSPORT
		parameter<bool>     UseActualCyclingSpeeds                    := FALSE                  , Descr = "In the case of cycling, would you like to use actual cycling speeds (from Fietstelweek) or a constant speed (as defined in BikingSpeed_kmhr)?";
		parameter<string>   CongestionSpeed_DaySelection              := 'tuesday'              , Descr = "Which day (or day selection) do you choose to use TomTom congenstion data from. Options: 'Weekday' 'Weekend' 'Week' 'monday' 'tuesday' 'wednesday' 'thursday' 'friday' 'saturday' 'sunday' ";
		parameter<string>   TomTom_StreetTypeSelection                 := 'FuncRoadClass/V/Local_Road_of_Minor_Importance', Descr = "This setting gives to option to exclude certain roadtypes in the TomTom network. Options: 7 FuncRoadClass/V/Local_Road   8 FuncRoadClass/V/Secondary_Road Local_Road_of_Minor_Importance  Local_Road_of_High_Importance ";
		parameter<m>        Fietstel_OSM_link_dist                    := 8[m]                   , Descr = "De maximale afstand tussen OSM en FietsTelWeek data om te linken ";
		parameter<float64>  ConnectSearchDist                         := 100d*100d              , Descr = "Zoek gebied voor connect_info operaties, zoals linken NDW aan NWB en NWB aan OSM, en FietsTelWeek aan OSM. Float64: connect_info op dpoint-rdc verwacht een float64 zoekafstand (kwadratisch).";
		parameter<km_hr>    WalkingSpeed_kmhr                         := 4.5[km_hr]             , Descr = "";
		parameter<km_hr>    CyclingSpeed_kmhr                         := 14[km_hr]              , Descr = "";
		parameter<km_hr>    E_BikingSpeed_kmhr                        := 20[km_hr]              , Descr = "";
		parameter<km_hr>    E_BikingSpeed_actualspeed_addition_kmhr   := 10[km_hr]              , Descr = "";
		parameter<km_hr>    CarSpeed_kmhr                             := 130[km_hr]             , Descr = "Alleen relevant bij OSM";
		parameter<km_hr>    CarSpeed_limit_kmhr                       := 100[km_hr]             , Descr = "Bijvoorbeeld bij 100kmpu op snelwegen overdag. Alleen relevant bij OSM";
		parameter<km_hr>    CarDefaultSpeed                           := 50[km_hr]              , Descr = "";
		parameter<km_hr>    CarDefaultSpeed_low                       := 30[km_hr]              , Descr = "";
		parameter<km_hr>    Ferry_Speed                               := 25[km_hr]              , Descr = "";
		parameter<bool>     InterpretAllRoadsAsBidirectional          := FALSE                  , Descr = "Should car(!) roads be interpreted as bidirectional, or should the OneDirection property be guiding?";//
		parameter<string>   DestSet_string                            := Dests_geclusterd 
																			? lowercase(Destset) + '_' + lowercase(Dest_location_scale)
																			: lowercase(Destset), Descr = ""; 
		parameter<string>   OrgSet_string                             := strcount(Orgset, 'Clustered') > 0
													? lowercase(Orgset) + '_' + lowercase(Org_location_scale)
													: lowercase(Orgset)
		,	Descr = "De herkomstenset zoals hij in de bestandsnamen staat. Bij een geclusterde set hoort de celmaat erbij, anders overschrijft een 500m-run de uitvoer van een 100m-run, net zoals DestSet_string dat voor de bestemmingen doet.";
		
		unit<uint8> OV_PreTransport_Typen : nrofrows = 1
		, Descr = "Select here the to be considered pre-transport options. 
					RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station"
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel := 
				union_data(.,
					TimeInvariantTypes/V/Org2Stops_Walking
					// TimeInvariantTypes/V/Org2Stops_Cycling
					// ,TimeInvariantTypes/V/Org2RMT_Stops_Cycling
					// ,TimeInvariantTypes/V/Org2RM_Stops_Cycling
					// ,TimeInvariantTypes/V/Org2Ric_Stops_Cycling
				);
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? '_'+StopClass : '';
			attribute<string> ExportName  := Mode_abbrev + StopClass_;
		}
		unit<uint8> OV_PostTransport_Typen : nrofrows = 1
		, Descr = "Select here the to be considered post-transport options. 
					RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station"
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel :=
				union_data(.,
					TimeInvariantTypes/V/Stops2Dest_Walking
					// ,TimeInvariantTypes/V/Stops2Dest_Cycling
					// TimeInvariantTypes/V/RMT_Stops2Dest_Cycling
					// ,TimeInvariantTypes/V/OVF_Stops2Dest_Cycling
				);
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? StopClass+'_' : '';
			attribute<string> ExportName  := StopClass_ + Mode_abbrev;
		}
				
		
		unit<uint8> PT_DepartureHours : nrofrows = 1 
		, Descr = ""
		{
			attribute<uint32> values : [7];
			// attribute<uint32> values : [19];
			// attribute<uint32> values : [7,8,12,13,21,22]; // 6 stuks
		}
		unit<uint8> PT_DepartureMinutes : nrofrows = 4
		, Descr = ""
		{
			// attribute<uint32> values : [0]; 
			// attribute<uint32> values : [0,30]; 
			attribute<uint32> values : [0,15,30,45];										   
			// attribute<uint32> values : [0,5,10,15,20,25,30];  //7 stuks
			// attribute<uint32> values : [0,5,10,15,20,25,30,35,40,45,50,55];  //12 stuks
			// attribute<uint32> values : [0,5,10,55];  //4 stuks
		}
		
		unit<uint8>  AnalysisMomentPresets : nrofrows = 10
		, Descr = ""
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// name, OSM date , Regios, OSM_perProv, CarCongestionSpeed_date_TomTom, BAG_snapshot
				[
				'Y2012','20221201', '2012', 'TRUE',  'yr2021_12', '20120101',      //20140101
				'Y2013','20140101', '2022', 'FALSE', 'yr2021_12', '20130101',
				'Y2018','20190101', '2020', 'FALSE', 'yxx2021_12','20180101',
				'Y2020','20200117', '2020', 'FALSE', 'yr2021_12', '20200101',
				'Y2021','20211221', '2021', 'TRUE',  'yr2021_12', '20210101',
				'Y2022','20221201', '2022', 'TRUE',  'yr2022_12', '20220101',
				'Y2023','20240101', '2023', 'TRUE',  'yr2023_12', '20230101',
				'Y2024','20240524', '2024', 'TRUE',  'yr2024_12', '20240101_RS',
				'Y2025','20240524', '2025', 'TRUE',  'yr2025_12', '20250101',
				'Y2026','20260601', '2025', 'TRUE',  'yr2025_12', '20260101.new'
				];
				// BAG_snapshot = de mapnaam onder %BAG_DataDir%/BAG/snapshots.ext, want die namen zijn
				// onregelmatig. Aanwezig op F: (2026-09-22): 20120101 t/m 20200101 en 20180401/20170701/
				// 20170908 (oude Ruimtescanner-snapshots, de drieslag vbo/pand/adres.fss), 20240101_RS
				// (idem, met de mmd-kopieen die deze config ernaast zet) en 20260101.new (een volledige
				// bag.mmd van BAG-Tools, uit het historiebestand van 2026-08-08). Voor 2021, 2022, 2023 en
				// 2025 staat er geen snapshot; die jaren kunnen dus geen BAG-herkomsten leveren.
				//
				// Regios blijft voor Y2026 op 2025: cbsgebiedsindelingen2026.gpkg is een voorlopige uitgave
				// van 2,9 MB met alleen landsdeel, provincie, COROP(plus/sub) en gemeente, en labelpoints die
				// '_voorlopig' heten; buurt en wijk ontbreken, en daarop staan de herkomstensets en de
				// regio-aggregaties. Zet dit op 2026 zodra CBS de buurt- en wijkkaart 2026 publiceert.
				// CarCongestionSpeed_date = de map %NetworkModel_PrivDir%/TomTom/<naam>/ met multinet/ en
				// speedprofiles/ (ruw) en de vier stores Roads/Junctions/Speednetworks/Speedprofiles.mmd
				// (verwerkt). Aanwezig op F: (2026-09-22): yr2021_12 en yr2025_12 met ruw materiaal en
				// mmd-stores (MultiNet 2021.12 van Jip, 2025.12 NL+BE van Marnix Breedijk, PBL; ingericht
				// met batch/ExtractTomTomEdition.py). yr2022_12 en yr2023_12 hebben alleen de oude fss van
				// Jip: die zijn in het fpoint-tijdperk geschreven, worden onder de huidige dpoint-rdc STIL
				// verkeerd gelezen en zijn niet herbouwbaar omdat het ruwe materiaal ontbreekt; Y2022 en
				// Y2023 kunnen dus niet draaien. Een yr2024_12-editie is nooit geleverd; Y2024 wijst er
				// nog naar en kan dus ook niet draaien.
			}
			
			attribute<string>        name                    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        OSM_file_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
			attribute<string>        RegioIndelingen_year    := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			attribute<bool>          OSM_NL_prov             := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)][bool];
			attribute<string>        CarCongestionSpeed_date := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)];
			attribute<string>        BAG_snapshot            := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)];
			
			parameter<uint32> nrAttr := 6;
		}
	
		unit<uint32> org_domain_list : nrofrows = 21 // Hier worden de paden voor elke org set opgegeven. En wanneer er nieuwe bij komen dat hier ook toegevoegd worden.
		, Descr = ""
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				'Buurt'                               ,'SourceData/RegioIndelingen/Buurt/Centroiden',
				'Buurt_perProvincie'                  ,'SourceData/RegioIndelingen/Buurt/Per_Prov/@REGIO@/sub',
				'Buurt_perCOROP'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROP/@REGIO@/sub',
				'Buurt_perCOROPp'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROPp/@REGIO@/sub',
				'Buurt_enkele_buurt'                  ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt',
				'Buurt_enkele_Gemeente'               ,'SourceData/RegioIndelingen/Buurt/Enkele_Gemeente',
				'Buurt_enkele_Prov'                   ,'SourceData/RegioIndelingen/buurt/Enkele_Prov',
				'Buurt_enkele_Corop'                  ,'SourceData/RegioIndelingen/buurt/Enkele_Corop',
				
				'Wijk'                                ,'SourceData/RegioIndelingen/Wijk/Centroiden',
				'Wijk_perProvincie'                   ,'SourceData/RegioIndelingen/Wijk/Per_Prov/@REGIO@/sub',
				'Wijk_perCOROP'                       ,'SourceData/RegioIndelingen/Wijk/Per_COROP/@REGIO@/sub',
				
				'Gemeente'                            ,'SourceData/RegioIndelingen/Gemeente/Centroiden',
				'Gemeente_perProvincie'               ,'SourceData/RegioIndelingen/Gemeente/Per_Prov/@REGIO@/sub',
				'Gemeente_perCOROP'                   ,'SourceData/RegioIndelingen/Gemeente/Per_COROP/@REGIO@/sub',
				'Gemeente_enkele_gemeente'            ,'SourceData/RegioIndelingen/Gemeente/Enkele_gemeente',
				
				'PC4'                                 ,'SourceData/BAG/Adressen/Woon_Voorraad/PC4_centroids',
				'PC4_perCOROP'                        ,'SourceData/BAG/Adressen/Woon_Voorraad/PC4_centroids/Per_COROP/@REGIO@/sub',
				
				'PC6'                                 ,'SourceData/BAG/Adressen/Woon_Voorraad/PC6_centroids',
				'PC6_sub'                             ,'SourceData/BAG/Adressen/Woon_Voorraad/PC6_centroids/sub',
				
				'BAG_woonpanden'                      ,'SourceData/BAG/Panden/pand/pand_woon_vbo',
				'BAG_woonpanden_Clustered'            ,'SourceData/BAG/Panden/pand/pand_woon_vbo/HeeftPanden'
				]; 
			}
			
			attribute<uint32>        id              := id(.);
			attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        path           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], DialogType = "LabelText";
			
			parameter<uint32> nrAttr := 2;
		}
		
		unit<uint32> dest_domain_list : nrofrows = 7 // Hier worden de paden voor elke dest set opgegeven. En wanneer er nieuwe bij komen dat hier ook toegevoegd worden.
		, Descr = ""
		{ 
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				 'LISA'                                                           ,'SourceData/locaties/LISA/ReadFSS/y@LISAJAAR@/PerYear/HeeftBanen'                                                  , 'nr_banen'
				,'Buurt'                                                          ,'SourceData/RegioIndelingen/Buurt/Centroiden'                                                                      , 'nr_banen'
				,'Buurt_enkele_Buurt'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt_Dest'                                                               , 'nr_banen'
				,'Buurt_enkele_Prov'                                              ,'SourceData/RegioIndelingen/Buurt/Enkele_Prov'                                                                     , 'nr_banen'
				,'Buurt_enkele_Corop'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_Corop'                                                                    , 'nr_banen'
				,'Wijk'                                                           ,'SourceData/RegioIndelingen/Wijk/Centroiden'                                                                       , 'nr_banen'
				,'OV_Knooppunten'                                                 ,'SourceData/Infrastructure/GTFS/OV_Knooppunten/Export_Knooppunten'                                                                       , 'nr_stops'
				];  
				// items_of_interest is het gewicht w_j in de interactiebepaling (NetworkSetup.dms, de Decay met
				// dist_logit). Dat veronderstelt ULTIEME bestemmingen: de keten loopt van de primaire herkomst
				// via voortransport (Org2Stops) over het OV-netwerk en natransport (Stops2Dest) naar de
				// bestemming, en pas daarover wordt de interactie bepaald. LISA (banen) en de regioindelingen
				// (nr_banen) zijn zulke bestemmingen.
				//
				// OV_Knooppunten is dat NIET: een knooppunt is een doorgaanspunt in de keten, geen eindbestemming.
				// Die rij is bedoeld voor bereikbaarheidsvragen OVER de knooppunten zelf (hoe lang doe je erover
				// om er een te bereiken, zie GTFS/OV_Knooppunten/Bereikbaarheid_Auto), niet voor een
				// interactiebepaling. Het gewicht staat daarom op nr_stops, een echt kenmerk van het knooppunt;
				// er bestaat geen nr_banen op die laag en een decay-uitkomst over knooppunten is inhoudelijk
				// niet te lezen als bereikbaarheid van bestemmingen.
			}
			
			attribute<uint32>        id                := id(.);
			attribute<string>        label             := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        path              := replace(Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], '@LISAJAAR@', LISA_year), DialogType = "LabelText";
			attribute<string>        items_of_interest := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			
			parameter<uint32> nrAttr := 3;
		}
		
		unit<uint8> CongestionTimes : nrofrows = 3
		, Descr = ""
		{
			attribute<string> name : ['MorningRush','NoonRush','LateEveningRush'];
			attribute<string> Time : ['0730', '1230', '1930'];
		}
		
		container Distance_decay //distance decay parameters, calculated and provided by PBL
		: Descr = ""
		{
			parameter<float32> car_a   := -8.65786f;
			parameter<float32> car_b   := 2.492099f;
			parameter<float32> car_c   := 0.011641f;
			parameter<float32> bike_a  := -7.95686f;
			parameter<float32> bike_b  := 2.675059f;
			parameter<float32> bike_c  := 0.011981f;
			parameter<float32> ov_a    := -12.3301f;
			parameter<float32> ov_b    := 2.907621f;
			parameter<float32> ov_c    := 0.012824f;
		}
	
		
		container Junction_Penalties
		: Descr = "bij het reizen over door een netwerk kun je meestal niet zonder vertraging voorbij een kruispunt komen. Daarom geven we hiervoor een penalty afhankelijk van het aantal benen van het kruispunt.
					De set met lower in de prefix, gaat erom dat je andere penalties hanteerd wanneer het kruis benen heeft waarop de snelheid relatief laag is. In dat geval zou de penalty lager kunnen zijn. 
					Neem een kruispunt in een bloemkoolwijk, dan hoef je wellicht niet voor elke zijstraat te stoppen. Nu (sept '25) staat dit op roadType <= 30kmpu (/Classifications/OSM/roadType/IsSlowTrafficRoad)." 
		{
			parameter<s>        with_2Links_Walking                  := 0[s]; // 0
			parameter<s>        with_3Links_Walking                  := 2[s]; // 1
			parameter<s>        with_4Links_Walking                  := 5[s]; // 2
			parameter<s>        with_gt4Links_Walking                := 6[s]; // 3
			
			parameter<s>        with_2Links_Cycling                  := 0[s]; // 0
			parameter<s>        with_3Links_Cycling                  := 2[s]; // 1
			parameter<s>        with_4Links_Cycling                  := 5[s]; // 2
			parameter<s>        with_gt4Links_Cycling                := 6[s]; // 3
			
			parameter<s>        with_2Links_E_Biking                 := 0[s]; // 0
			parameter<s>        with_3Links_E_Biking                 := 2[s]; // 1
			parameter<s>        with_4Links_E_Biking                 := 5[s]; // 2
			parameter<s>        with_gt4Links_E_Biking               := 6[s]; // 3
			
			parameter<s>        with_2Links_Car                      := 0[s]; // 0
			parameter<s>        with_3Links_Car                      := 2[s]; // 2
			parameter<s>        with_4Links_Car                      := 5[s]; // 5
			parameter<s>        with_gt4Links_Car                    := 6[s]; // 6
			
			parameter<s>        with_2_lowerSpeedLinks_Walking       := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Walking       := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Walking       := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Walking     := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_Cycling       := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Cycling       := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Cycling       := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Cycling     := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_E_Biking      := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_E_Biking      := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_E_Biking      := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_E_Biking    := 0[s]; // 3
			
			parameter<s>        with_2_lowerSpeedLinks_Car           := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Car           := 0[s]; // 2
			parameter<s>        with_4_lowerSpeedLinks_Car           := 0[s]; // 5
			parameter<s>        with_gt4_lowerSpeedLinks_Car         := 0[s]; // 6
		}
		
		container OSM_impl
		: Descr = ""
		{
			unit<uint32> InEenBestand : nrofrows = 4
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Regio             , OrgSet , OrgPath, Land, Type, 
					[
					'Netherlands'             ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Nordrhein-Westfalen'     ,'DE', 'OD'
					]; 
				}
				
				attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string>        name           := replace(label, '-', '_');
				attribute<string>        Country        := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string>        Type_src       := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
				
				parameter<uint32> nrAttr := 3;
			}
			unit<uint32> InProvincies : nrofrows = 17
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Regio             , OrgSet , OrgPath, Land, Type, 
					[
					'Drenthe'                 ,'NL', 'OD',
					'Flevoland'               ,'NL', 'OD',
					'Friesland'               ,'NL', 'OD',
					'Gelderland'              ,'NL', 'OD',
					'Groningen'               ,'NL', 'OD',
					'Limburg'                 ,'NL', 'OD',
					'Noord-Brabant'           ,'NL', 'OD',
					'Noord-Holland'           ,'NL', 'OD',
					'Overijssel'              ,'NL', 'OD',
					'Utrecht'                 ,'NL', 'OD',
					'Zeeland'                 ,'NL', 'OD',
					'Zuid-Holland'            ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Duesseldorf-regbez'       ,'DE', 'OD',
					'Koeln-regbez'             ,'DE', 'OD',
					'Muenster-regbez'          ,'DE', 'OD'
					]; 
				}
				
				attribute<string>        label          := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string>        name           := replace(label, '-', '_');
				attribute<string>        Country        := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string>        Type_src       := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
				
				parameter<uint32> nrAttr := 3;
			}
		}
		
		unit<uint32> SampleDay := select_with_attr_by_org_rel(Time, Time/Day = 0) //Hier worden de analyse tijdstippen opgegeven. LET OP: Verander je deze dan zul je ook de NDW_meetmomenten/time moeten aanpassen. En de ChosenMoments ook wanneer er meer/minder momenten opgegeven zijn.
		, Descr = ""
		{
			attribute<bool>    ChosenMoments   := =asList(HoursMinutes/str,' || ');
			attribute<Time>    Time_rel        := org_rel;
			unit<uint8> ChosenHours    := PT_DepartureHours;
			unit<uint8> ChosenMinutes  := PT_DepartureMinutes;
			unit<uint8> HoursMinutes   := combine_uint8(ChosenHours, ChosenMinutes)
			{
				attribute<uint32> Hours     := ChosenHours/values[first_rel];
				attribute<uint32> Minutes   := ChosenMinutes/values[second_rel];
				attribute<string> str       := '(hour == '+string(Hours)+' && minute == '+string(Minutes)+' && second == 0)';
			}
		}
		
		unit<uint32> MeasureMoments := select_with_attr_by_cond(SampleDay, SampleDay/ChosenMoments)
		, Descr = ""
		{
			attribute<Time>    Moment := Time_rel;
			attribute<string>  Name   := Time/TemplatableText[Moment];
		}
	}
}
