// De syntax van deze configuratie (items, eenheden, expressies en operatoren) staat in de GeoDMS-wiki: https://github.com/ObjectVision/GeoDMS/wiki
container ModelParameters : using = "units"
{   
	// DE INSTELLINGEN VAN DE GEBRUIKER: wat een run kiest, en de aannames die PBL wil kunnen variëren.
	// Wat volgt uit andere instellingen, met PBL is afgesproken of de techniek betreft, staat in Advanced. Bij elke aanname staat of hij
	// alleen de uitvoer verandert, of de tussenresultaten in %LocalDataProjDir%/IntermediateResults, die het model dan opnieuw rekent.

	// 1. WAT: peildatum, dagdeel, herkomsten en bestemmingen, en de uitvoer
	parameter<string>   AnalysisMoment                    := 'Y2025'                , Descr = "De peildatum: een jaar uit Advanced/AnalysisMomentPresets (Y2015, Y2023, Y2024, Y2025 of Y2026), met de dag van de analyse (de tweede dinsdag van oktober, #125), de GTFS-feed, OSM, TomTom, de CBS-gebiedsindeling en de BAG.";
	parameter<string>   Dagdeel                           := 'Ochtendspits'         , Descr = "Het dagdeel van de vertrekmomenten, uit Advanced/Dagdelen (#125): 'Ochtendspits' 07:00-07:45, 'Middag' 12:00-12:45 of 'Avond' 19:00-19:45, elk vier momenten per kwartier. Bepaalt ook het congestiemoment van de directe autorit (Car_CongestionMoment_ForDirect).", IntegrityCheck = "IsDefined(rlookup(this, Advanced/Dagdelen/name))";
	parameter<string>   Orgset                            := 'Buurt2025'            , Descr = "Select the origin set, defined in Advanced/org_domain_list.";
	parameter<string>   Destset                           := 'Buurt2025'            , Descr = "Select the destination set, defined in Advanced/dest_domain_list.";       
	parameter<string>   Orgset_EnkeleBuurt_Selection      := 'BU0363AD05'           , Descr = "If you choose 'enkele_buurt' in the OrgSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Orgset_EnkeleGem_Selection        := 'Dronten'              , Descr = "If you choose 'enkele_gem' in the OrgSet, which municipality would you like? Use the municipality name.";
	parameter<string>   Orgset_EnkeleProv_Selection       := 'Zuid_Holland'         , Descr = "If you choose 'enkele_prov' in the OrgSet, which provincie would you like? Use the province name.";
	parameter<string>   Orgset_EnkeleCorop_Selection      := 'Kop_van_Noord_Holland', Descr = "If you choose 'enkele_corop' in the OrgSet, which COROP would you like? Use the corop name.";
	parameter<string>   Destset_Enkele_Selection          := 'BU0363ET02'           , Descr = "If you choose 'enkele_buurt' in the DestSet, which neighbourhood would you like? Use the BU_CODE.";
	parameter<string>   Destset_EnkeleCorop_Selection     := 'Twente'               , Descr = "If you choose 'enkele_corop' in the DestSet, which COROP would you like? Use the corop name.";
	parameter<string>   Destset_EnkeleProv_Selection      := 'Zuid_Holland'         , Descr = "If you choose 'enkele_prov' in the DestSet, which province would you like? Use the province name.";
	parameter<string>   OutputLabel                       := 'basis'                , Descr = "Korte naam van de variant (#118): de uitvoer staat in %LocalDataProjDir%/Output/<Analysis_date>_<OutputLabel>_<component> (Advanced/OutputDir), met de parameters in signature.txt; een andere parameterset onder hetzelfde label stopt op die handtekening. Letters, cijfers, - en _, hoogstens 20 tekens.", IntegrityCheck = "strlen(this) >= 1 && strlen(this) <= 20 && strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
	parameter<string>   OutputFormat                      := 'parquet'
	,	IntegrityCheck = "OutputFormat == 'csv' || OutputFormat == 'parquet'"
	,	Descr = "Het formaat van de OV-uitvoer per blok en vertrekmoment: 'parquet' (getypt, zstd, per soort component alleen de variërende kolommen, ExportKlasse) of 'csv' (alle kolommen). De tellingen per blok zijn altijd csv; het samenvoegen leest de parquet van de componenten en schrijft in dit formaat.";
	parameter<bool>     Export_TravelledDistance          := TRUE                   , Descr = "Would you like to export the travelled distance along with the other attributes in the case of private and public transport?";
	parameter<bool>     Export_PriceInformation           := TRUE                   , Descr ="Exporteert de OV-uitvoer ook de prijs, uitgesplitst naar voortransport, OV en natransport (PretransPrice, PTPrice, PosttransPrice) en per modaliteit (WalkingPrice, CyclingPrice, CarPrice)?";

	// 2. DE COMPONENT VAN DEZE RUN (#117): een
	// directe rit, WW, CC of Car, of een OV-reis, PT, met een voortransport en een natransport. De directe ritten zijn aparte
	// componenten, want ze gaan anders om met sommige Pareto-attributen en met het front (de auto houdt per HB-paar meer routes).
	// Elke component heeft een eigen uitvoermap; samenvoegen doet een run met MergeOutput (hieronder). Alle combinaties staan in
	// Advanced/Componenten.
	parameter<string>   Component                         := 'PT'                   , Descr = "Wat deze run rekent: 'WW' (de directe looprit), 'CC' (de directe fietsrit), 'Car' (de directe autorit, met starten en parkeren) of 'PT' (een OV-reis: Voortransport + OV + Natransport). De naam van de component (Advanced/ComponentName) staat achter het label in de uitvoermap (#117, #118).", IntegrityCheck = "this == 'WW' || this == 'CC' || this == 'Car' || this == 'PT'";
	parameter</Classifications/TimeInvariantTypes> Voortransport := /Classifications/TimeInvariantTypes/V/Org2Stops_Walking // W: lopen naar elke halte
		// /Classifications/TimeInvariantTypes/V/Org2Stops_Cycling      // C: fietsen naar elke halte
		// /Classifications/TimeInvariantTypes/V/Org2RM_Stops_Cycling   // C_RM: fietsen naar een trein- of metrohalte
		// /Classifications/TimeInvariantTypes/V/Org2RMT_Stops_Cycling  // C_RMT: fietsen naar een trein-, metro- of tramhalte
		// /Classifications/TimeInvariantTypes/V/Org2Ric_Stops_Cycling  // C_Ric: fietsen naar een IC-station
	, Descr = "Het voortransport van de OV-reis (Component 'PT'): een van Advanced/VoortransportTypen; de alternatieven staan als commentaar eronder."
	, IntegrityCheck = "Component != 'PT' || IsDefined(rlookup(this, Advanced/VoortransportTypen/TimeInvariantTypes_rel))";
	parameter</Classifications/TimeInvariantTypes> Natransport := /Classifications/TimeInvariantTypes/V/Stops2Dest_Walking // W: lopen
		// /Classifications/TimeInvariantTypes/V/Stops2Dest_Cycling     // C: fietsen van elke halte
		// /Classifications/TimeInvariantTypes/V/RM_Stops2Dest_Cycling  // RM_C: fietsen van een trein- of metrohalte
		// /Classifications/TimeInvariantTypes/V/RMT_Stops2Dest_Cycling // RMT_C: fietsen van een trein-, metro- of tramhalte
		// /Classifications/TimeInvariantTypes/V/OVF_Stops2Dest_Cycling // OVf_C: de OV-fiets, alleen van een halte bij een OV-fietslocatie
	, Descr = "Het natransport van de OV-reis (Component 'PT'): een van Advanced/NatransportTypen. Alleen de OV-fiets (OVf_C) wordt gehuurd; bij de andere fietsnatransporten staat een eigen fiets bij de laatste halte (PostTransport_Cycling_Time_Costs)."
	, IntegrityCheck = "Component != 'PT' || IsDefined(rlookup(this, Advanced/NatransportTypen/TimeInvariantTypes_rel))";

	// 3. SAMENVOEGEN van componenten tot een front (MergeOutput, NetworkSetup/ComponentMerge)
	parameter<bool>     MergeOutput                       := FALSE                  , Descr = "Voegt deze run, in plaats van te rekenen, de uitvoer van de componenten in MergeComponents samen tot een Pareto-front op MergeCriteria (NetworkSetup/ComponentMerge)? Uitvoer in Output/<Analysis_date>_<OutputLabel>_Merged<MergeRunNr>; Component, Voortransport en Natransport tellen dan niet.";
	parameter<string>   MergeComponents                   := 'WW,W_PT_W,CC,C_PT_W,C_PT_OVf_C,Car', Descr = "De componenten die MergeOutput samenvoegt, gescheiden door komma's, uit Advanced/Componenten/name; de standaard geeft de opties van de levering van 2023 (#117). Hun uitvoer moet er zijn, met hetzelfde OutputLabel, dezelfde peildatum, hetzelfde dagdeel en dezelfde herkomsten en bestemmingen.";
	parameter<uint32>   MergeRunNr                        := 1                      , Descr = "Het nummer van de samenvoeging in de naam van de uitvoermap (_Merged<MergeRunNr>); de samengevoegde componenten staan in signature.txt. Geef een andere set MergeComponents of MergeCriteria een ander nummer: onder hetzelfde nummer stopt de run op de handtekening.";
	parameter<string>   MergeCriteria                     := 'Price,Time,Car,Bike'  , Descr = "De criteria van het samenvoegen: Price of Price_Augm, Time, Car (NeedsCar) en Bike (NeedsBike). Een duurdere optie blijft alleen als ze meer dan ChainParetoTimeEpsilon sneller is; zonder Car en Bike kan een optie met auto of fiets er een zonder verdringen, en 'Time' of 'Price' alleen geeft een optie per paar.", IntegrityCheck = "IsDefined(strpos(lowercase(this), 'price')) || IsDefined(strpos(lowercase(this), 'time'))";

	// 4. AANNAMES DIE ALLEEN DE UITVOER VERANDEREN: de tussenresultaten blijven geldig
	parameter<min_f>    MaxTravelTime                     := 90[min_f]              , Descr = "Maximum travel time of the complete journey. Only relevant for public transport analysis. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<min_f>    MaxWalkingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum walking time from origin towards destination";
	parameter<min_f>    MaxCyclingTime_Org2Dest           := 90[min_f]              , Descr = "Maximum cycling time from origin towards destination";
	parameter<euro_min> PreTransport_Walking_Time_Costs   := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> PostTransport_Walking_Time_Costs  := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Walking_Time_Costs         := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Direct_Cycling_Time_Costs         := 0.09[euro_km] * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PreTransport_Cycling_Time_Costs   := 0.09[euro_km] * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "To attach a value to cycling, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you cycle as much as possible.";
	parameter<euro_min> PostTransport_Cycling_Time_Costs  := PreTransport_Cycling_Time_Costs, Descr = "De kosten van fietsen in het natransport (C, RM_C, RMT_C): een eigen fiets bij de laatste halte, met dezelfde kosten als de eigen fiets in het voortransport. De OV-fiets (OVf_C) kost OVFiets_RentalPrice.";
	parameter<euro>     OVFiets_RentalPrice               := 4.45[euro]             , Descr = "Prijs voor de huur van de fiets voor de eerste 24u. 2023=4.45 euro";
	parameter<Euro_km>  Car_CostPerKm                     := 0.24[Euro_km]          , Descr = "Autokosten per km (#88): de prijs van de directe autorit is zijn afstand maal Car_CostPerKm, plus Car_FixedCosts_PerTrip.";
	parameter<Euro>     Car_FixedCosts_PerTrip            := 0[Euro]                , Descr = "Vast bedrag per autorit, bijvoorbeeld parkeren; 0 tot daar een waarde voor is.";
	parameter<min_f>    Car_StartTime                     := 2[min_f]               , Descr = "Starttijd van een autorit: naar de auto lopen, instappen, wegrijden. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	parameter<min_f>    Car_ParkingTime                   := 3[min_f]               , Descr = "Parkeertijd aan het eind van een autorit: parkeerplek zoeken en naar de bestemming lopen. Opgeteld bij de reistijd van de directe autorit in het front. Eerste aanname, door PBL te zetten.";
	// HET AUTOFRONT (#88). De directe autorit is per HB-paar een Pareto-front op reistijd en afstand
	// (Advanced/ParetoLegs_Car: impedance_matrix_od64 met de pareto-optie, de afstand als alternatieve impedantie), en
	// de kosten volgen achteraf: afstand x Car_CostPerKm + Car_FixedCosts_PerTrip. Met een prijs per km is dat front
	// ook het front op reistijd en kosten.

	// 5. AANNAMES DIE TUSSENRESULTATEN OPNIEUW LATEN REKENEN; hun handtekening noemt ze, zodat het model een store met andere waarden niet leest
	// de benen (batch/UpdateAll.cmd legs, ongeveer 10 minuten per peildatum en buurtset)
	parameter<min_f>    MaxWalkingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum walking time from origin towards first stop";
	parameter<min_f>    MaxWalkingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum walking time from last stop towards destination";
	parameter<min_f>    MaxCyclingTime_Org2Stops          := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_Org2RMT_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail, metro, or tram stop";
	parameter<min_f>    MaxCyclingTime_Org2RM_Stops       := 15[min_f]              , Descr = "Maximum cycling time from origin towards first rail or metro stop (RM_Stops: haltes met Mode Rail of Metro in de GTFS)";
	parameter<min_f>    MaxCyclingTime_Org2Ric_Stops      := 15[min_f]              , Descr = "Maximum cycling time from origin towards first InterCity train station";
	parameter<min_f>    MaxCyclingTime_Stops2Dest         := 15[min_f]              , Descr = "Maximum cycling time from origin towards first stop";
	parameter<min_f>    MaxCyclingTime_OVF_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is an OV-fiets station towards destination";
	parameter<min_f>    MaxCyclingTime_RMT_Stops2Dest     := 15[min_f]              , Descr = "Maximum cycling time from last stop which is a RMT station towards destination";
	parameter<min_f>    MaxCyclingTime_RM_Stops2Dest      := 15[min_f]              , Descr = "Maximum cycling time from last stop which is a rail or metro stop (RM_Stops) towards destination (natransport RM_C)";
	parameter<km_hr>    WalkingSpeed_kmhr                 := 4.5[km_hr]             , Descr = "";
	parameter<km_hr>    CyclingSpeed_kmhr                 := 14[km_hr]              , Descr = "";
	// de ketenstore (batch/UpdateAll.cmd chains, uren per dagdeel); ook de maximale tijden van het voortransport hierboven, en de start- en
	// parkeertijd van de fiets: ze bepalen het langste voortransport (Advanced/PT_Max_V_Time) en daarmee het laatste instapmoment van de ketens
	parameter<min_f>    Cycling_StartTime                 := 1[min_f]               , Descr = "Starttijd van elke fietsrit: fiets pakken en wegrijden. Opgeteld bij de reistijd van de directe fietsrit, van elk fietsbeen in het voortransport en van elk fietsbeen in het natransport. Eerste aanname, door PBL te zetten.";
	parameter<min_f>    Cycling_ParkingTime_IC_Station    := 3[min_f]               , Descr = "Extra parkeertijd, bovenop Cycling_PreTransport_Penalty, voor een fietsbeen in het voortransport dat eindigt op een IC-station (PublicTransport_Prep/Impl/Ric_Stops), bij elk type fietsvoortransport (#117): grote stallingen, langer lopen naar het perron. Eerste aanname, door PBL te zetten.";
	parameter<min_f>    MaxPTTime                         := 90[min_f]              , Descr = "Maximum travel time using public transport, including transfers and waiting. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<uint16>   Max_transfers                     := 3w                     , Descr = "How many transfers are allowed?", IntegrityCheck = "this >= 1w && this <= 4w";
	parameter<euro_min> Transfer_Walking_Time_Costs       := 0.19[euro_min]         , Descr = "To attach a value to walking, the cost thereof (or the time it takes) is incorporated. This is a mechanism to ensure when looking for the cheapest journey the model won't let you walk as much as possible.";
	parameter<euro_min> Transfer_Waiting_Time_Costs       := 0.05[euro_min]         , Descr = "To attach a value to waiting, the cost thereof (or the time it takes) is incorporated.";
	// de autostores (batch/UpdateAll.cmd cars, uren per vertrekmoment)
	parameter<min_f>    MaxCarTime                        := 90[min_f]              , Descr = "Maximum travel time using car transport. Note that limiting this value might result in not being able to reach all destinations.";
	parameter<bool>     UseTomTomNetworkForCars           := TRUE                   , Descr = "Would you like to use the TomTom network car analysis? Or if not, the OSM network is used.";

	// 6. EEN HB-PAAR (#129): met OD_Herkomst en OD_Bestemming rekent het hele model, met dezelfde stappen (batch/UpdateAll.cmd
	// of batch/WriteODResults.ps1), alleen dat paar, en houdt het per optie de links van de route bij. Tussenresultaten staan dan in
	// %LocalDataProjDir%/IntermediateResults_<O>_<D>, de uitvoer in Output_<O>_<D> (Advanced/OD_Tag); /OD_Results toont ze op kaart, in tabel
	// en grafiek. Leeg: het generieke model, zonder links.
	parameter<string>   OD_Herkomst                       := ''                     , Descr = "De herkomst van het HB-paar: een naam uit Orgset, zoals OrgName in de uitvoer; bij Buurt2023 en Buurt2025 de CBS-buurtcode, bijvoorbeeld 'BU04020501' (Schilderskwartier, Hilversum, met Laapersweg 1). Leeg = alle herkomsten. Alleen met OD_Bestemming.";
	parameter<string>   OD_Bestemming                     := ''                     , Descr = "De bestemming van het HB-paar: een naam uit Destset, zoals DestName in de uitvoer, bijvoorbeeld 'BU0363KP03' (VU-kwartier, Amsterdam, met De Boelelaan 1085). Leeg = alle bestemmingen. Alleen met OD_Herkomst.";
	parameter<string>   OD_Vertrekmoment                  := ''                     , Descr = "Alleen met een HB-paar: een vertrekmoment van Dagdeel als uu:mm, bijvoorbeeld '07:30'; leeg = de vier vertrekmomenten van het dagdeel. Geldt voor elke component, ook de directe ritten (EenVertrekmoment) en de tijdafhankelijke autorit.", IntegrityCheck = "this == '' || (strlen(this) == 5 && substr(this, 2, 1) == ':')";
	parameter<uint32>   OD_Optie                          := 0                      , Descr = "De optie die de kaart van /OD_Results apart toont (Kaart/Optie): het nummer in Opties, vanaf 1; 0 = alle opties.";

	container Advanced : using = "classifications"
	{
		// AFGELEID UIT DE INSTELLINGEN BOVENAAN, niet zelf in te stellen
		parameter<string>   GTFS_file_date                            := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/GTFS_file_date)
		, Descr = "De GTFS-feed (map en mmd-store onder %NetworkModel_Dir%/Infrastructuur/GTFS) van de peildatum, uit Advanced/AnalysisMomentPresets (#125). De feed moet de dienstdagen D-1, D en D+1 van Analysis_date dekken (LoadFeeds/ServiceDays)."
		, IntegrityCheck = "strlen(this) == 8";
		parameter<string>   Analysis_date                             := rjoin(AnalysisMoment, Advanced/AnalysisMomentPresets/name, Advanced/AnalysisMomentPresets/Analysis_date)
		, Descr = "De dag van de OV-analyse: de peildatum van AnalysisMoment, uit Advanced/AnalysisMomentPresets (#125). Het net bevat de dienstdagen D-1, D en D+1 op een tijdas; LoadFeeds/ServiceDays controleert dat de feed elke dag die het analysevenster nodig heeft compleet heeft."
		, IntegrityCheck = "strlen(this) == 8";
		//Directe ritten naast het OV. De ketenrijger voegt per HB-paar de directe rit(ten) bij de OV-ketens en houdt
		//het Pareto-front op MinimiseCriteria (prijs, tijd) over; zie NetworkSetup/PublicTransport_Prep/Direct_OD.
		//De drie schakelaars volgen uit Component (#117).
		parameter<bool>     AllowDirectWalking                        := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectWalking) : rjoin(Advanced/ComponentName, Advanced/Componenten/name, Advanced/Componenten/DirectWalking), Descr = "Doet de directe looprit (OSM-loopnetwerk, tot MaxWalkingTime_Org2Dest) mee in het front per HB-paar? Uit Component (Advanced/Componenten/DirectWalking, #117); bij het samenvoegen: of een samengevoegde component hem heeft.";
		parameter<bool>     AllowDirectCycling                        := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectCycling) : rjoin(Advanced/ComponentName, Advanced/Componenten/name, Advanced/Componenten/DirectCycling), Descr = "Doet de directe fietsrit (het net van CyclingNetwork, tot MaxCyclingTime_Org2Dest) mee in het front per HB-paar? Uit Component (Advanced/Componenten/DirectCycling, #117); bij het samenvoegen: of een samengevoegde component hem heeft.";
		parameter<bool>     AllowDirectCar                            := Advanced/IsSamen ? any(Advanced/Componenten/InMerge && Advanced/Componenten/DirectCar) : rjoin(Advanced/ComponentName, Advanced/Componenten/name, Advanced/Componenten/DirectCar), Descr = "Doet de directe autorit (TomTom of OSM, zie UseTomTomNetworkForCars, tot MaxCarTime) mee in het front per HB-paar? Uit Component (Advanced/Componenten/DirectCar, #117); bij het samenvoegen: of een samengevoegde component hem heeft. De autoprijs is afstand x Car_CostPerKm.";
		parameter<string>   Car_CongestionMoment_ForDirect            := UseTomTomNetworkForCars ? rjoin(Dagdeel, Advanced/Dagdelen/name, Advanced/Dagdelen/CongestionMoment) : 'MaxSpeed'
		, Descr = "Welke reistijd van de auto de directe rit gebruikt: 'MorningRush' (07:30), 'NoonRush' (12:30), 'LateEveningRush' (19:30) of 'Freeflow' (alleen TomTom; bij OSM 'MaxSpeed'). Volgt uit Dagdeel (Advanced/Dagdelen/CongestionMoment, #125): het midden van het uur van de vertrekmomenten."
		, IntegrityCheck = "UseTomTomNetworkForCars ? Car_CongestionMoment_ForDirect != 'MaxSpeed' : Car_CongestionMoment_ForDirect == 'MaxSpeed'"; // TomTom kent Freeflow/MorningRush/NoonRush/LateEveningRush; OSM alleen MaxSpeed, want de OSM-spitsen zijn null-placeholders
		parameter<bool>     CarTimeDependent                          := UseTomTomNetworkForCars
		, Descr = "Rekent de directe autorit met tijdafhankelijke linktijden (#132)? Dan is er per vertrekmoment een autostore (PublicTransport_Prep/Direct/CarPerMoment/TD<moment>), waarin elk wegvak de TomTom-snelheid heeft van het moment waarop de rit het binnenrijdt. FALSE: een momentopname per congestiemoment. Vereist TomTom en een weekdag als CongestionSpeed_DaySelection."
		, IntegrityCheck = "!this || UseTomTomNetworkForCars";
		// AFGESPROKEN MET PBL. Elke component rekent op prijs en tijd (#117);
		// de criteria van het samenvoegen staan bovenaan (MergeCriteria). MinimiseCriteria staat in de handtekening van de ketenstore.
		parameter<string>   MinimiseCriteria                          := 'Price,Time'             , Descr = "De criteria van het front van een component: 'Price', 'Price_Augm', 'Time' of een combinatie, zoals 'Price,Time' (#117). 'Car' en 'Bike' maken auto- en fietsbezit criteria van de eindafweging per vertrekmoment, niet van de ketenrijger; voor de componenten horen die bij MergeCriteria. Staat in de handtekening van de ketenstore.";
		parameter<string>   CentroidWeightType                        := 'Addresses'            , Descr = "If you want to use weighted centroids for origins, how would you like to weigh the values comprsing the coentroid? Via addresses or population?";
		// De maximale looptijd van voor- en natransporttypen die geen component gebruikt: geen component loopt naar of van een trein-,
		// metro-, tram-, IC- of OV-fietshalte. Classifications/TimeInvariantTypes vraagt ze wel; gelijk aan die naar en van elke halte.
		parameter<min_f>    MaxWalkingTime_Org2RMT_Stops              := /ModelParameters/MaxWalkingTime_Org2Stops,  Descr = "Maximum walking time from origin towards first rail, metro, or tram stop";
		parameter<min_f>    MaxWalkingTime_Org2RM_Stops               := /ModelParameters/MaxWalkingTime_Org2Stops,  Descr = "Maximum walking time from origin towards first rail or metro stop (RM_Stops: haltes met Mode Rail of Metro in de GTFS)";
		parameter<min_f>    MaxWalkingTime_Org2Ric_Stops              := /ModelParameters/MaxWalkingTime_Org2Stops,  Descr = "Maximum walking time from origin towards first InterCity train station";
		parameter<min_f>    MaxWalkingTime_OVF_Stops2Dest             := /ModelParameters/MaxWalkingTime_Stops2Dest,  Descr = "Maximum walking time from last stop which is an OV-fiets station towards destination";
		parameter<min_f>    MaxWalkingTime_RMT_Stops2Dest             := /ModelParameters/MaxWalkingTime_Stops2Dest,  Descr = "Maximum walking time from last stop which is a RMT station towards destination";
		parameter<min_f>    MaxWalkingTime_RM_Stops2Dest              := /ModelParameters/MaxWalkingTime_Stops2Dest,  Descr = "Maximum walking time from last stop which is a rail or metro stop (RM_Stops) towards destination";

		/// GENERAL
		// BUURT NAAR BUURT (#126): twee buurtvarianten, elk met de CBS-buurtgrenzen en de BAG van
		// hetzelfde jaar, en met hetzelfde punt als herkomst en als bestemming: het zwaartepunt van de woonadressen van de
		// buurt (SourceData/RegioIndelingen/Buurt/address_weighted_centroid; een buurt zonder woningen krijgt het midden van
		// zijn vlak). Buurt2023 hoort bij de peildata 2015, 2023 en 2024, Buurt2025 bij 2025 en 2026; de presets van die
		// peildata hebben dezelfde Regios en BAG_snapshot, zodat ook 'Buurt' en de BAG-herkomsten die variant volgen.
		unit<uint8> Buurtsets : nrofrows = 2
		, Descr = "De buurtvarianten (#126). Kies er een als Orgset en Destset (org_domain_list, dest_domain_list): dan gelden zijn RegioIndelingen_year en BAG_snapshot, welke peildatum ook gekozen is."
		{
			attribute<string> name                 : ['Buurt2023', 'Buurt2025'];
			attribute<string> RegioIndelingen_year : ['2023', '2025'];
			attribute<string> BAG_snapshot         : ['20230101', '20250101'];
		}
		parameter<Buurtsets> Buurtset_Org                             := rlookup(lowercase(/ModelParameters/Orgset), lowercase(Buurtsets/name)), Descr = "De buurtvariant van de herkomsten, of null.";
		parameter<Buurtsets> Buurtset_Dest                            := rlookup(lowercase(/ModelParameters/Destset), lowercase(Buurtsets/name)), Descr = "De buurtvariant van de bestemmingen, of null.";
		parameter<Buurtsets> Buurtset                                 := MakeDefined(Buurtset_Org, Buurtset_Dest)
		,	Descr = "De buurtvariant van de run: die van de herkomsten, anders die van de bestemmingen, anders null (dan gelden de presets van AnalysisMoment). Er is een BAG en een gebiedsindeling per run, dus herkomsten en bestemmingen kunnen geen verschillende buurtvarianten zijn."
		,	IntegrityCheck = "!IsDefined(Buurtset_Org) || !IsDefined(Buurtset_Dest) || Buurtset_Org == Buurtset_Dest";
		parameter<string>   BAG_snapshot                              := IsDefined(Buurtset) ? Buurtsets/BAG_snapshot[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/BAG_snapshot)
		,	Descr = "Naam van de BAG-snapshotmap onder %NetworkModel_Dir%/RegioIndelingen/BAG: die van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders die van AnalysisMoment in de presettabel. Los van RegioIndelingen_year, want de BAG-standdatum en de CBS-gebiedsindeling lopen niet gelijk.";
		parameter<string>   BAG_year                                  := substr(BAG_snapshot, 0, 4)
		,	Descr = "Het jaar van de BAG-snapshot, uit BAG_snapshot. Wordt gebruikt om bouwjaren na de standdatum af te kappen en in de exportnamen.";
		parameter<string>   RegioIndelingen_year                      := IsDefined(Buurtset) ? Buurtsets/RegioIndelingen_year[Buurtset] : rjoin(lowercase(AnalysisMoment), lowercase(Advanced/AnalysisMomentPresets/name), Advanced/AnalysisMomentPresets/RegioIndelingen_year)
		,	Descr = "Het jaar van de CBS-gebiedsindeling: dat van de buurtvariant (Buurtset) als Orgset of Destset er een is, anders per AnalysisMoment in de presettabel.";
		parameter<string>   LISA_year                                 := '2018'                 , Descr = "Which year of the LISA-dataset would you like to use?";
		parameter<bool>     Dests_geclusterd                          := FALSE                  , Descr = "Would you like to cluster destinations? For example useful for firm destinations, with many firms at the same location. To determine the area of clustering look at Dest_location_scale";
		parameter<string>   Dest_location_scale                       := '100m'                 , Descr = "If clustering the destination, at which scale would you like to cluster? Options: '100m', '500m', '1000m', '5000m', '10000m', '50000m'";
		parameter<string>   Org_location_scale                        := '500m'                 , Descr = "Celmaat waarop de BAG-herkomsten geclusterd worden (BAG_woonpanden_Clustered).\n"
						"Opties zijn de celmaten uit geometries/Gridsizes: '25m', '100m', '500m', '1000m', '5000m', '10000m', '50000m'.\n"
						"Stond tot 2026-09-22 vast aan Dest_location_scale; op 100m levert de BAG-snapshot van 1-1-2026 588.903 herkomsten, wat de blokindeling en de OD-omvang onwerkbaar maakt.\n"
						"Losgekoppeld omdat de bestemmingen hun eigen maat mogen houden.";
		parameter<string>   items_of_interest                         := rjoin(lowercase(DestSet), lowercase(Advanced/dest_domain_list/label), Advanced/dest_domain_list/items_of_interest), Descr = "What is the item of interest in the analysis? Such as number of jobs. Decided via the dest_set.";
		parameter<bool>     ExcludeOrgBuurtCentroidsWithoutAddressPop := FALSE                  , Descr = "Would yo like to exclude buurt centroid that do not contain addresses or population (depending on CentroidWeightType).";
		parameter<uint32>   MaxPathLength                             := 259                    , Descr = "Het langste bestandspad dat Windows zonder longPathAware toestaat; GeoDMS vraagt geen lange paden aan. Elke storefamilie controleert er vooraf op (Templates/StoreSignature_T/PathGate), zodat een te lang pad faalt voordat er gerekend wordt (NetworkModel_PBL#118).";
		// HET HB-PAAR (#129): zie groep 6 bovenaan.
		parameter<bool>     IsOD                                      := /ModelParameters/OD_Herkomst != '' && /ModelParameters/OD_Bestemming != ''
		,	Descr = "Rekent deze run een HB-paar (OD_Herkomst en OD_Bestemming)? Dan zijn de herkomsten en bestemmingen elk een element (PublicTransport_Prep/impl/OD_Org, OD_Dest), staan de tussenresultaten en de uitvoer in eigen mappen (OD_Tag) en houden de routes hun links bij."
		,	IntegrityCheck = "(/ModelParameters/OD_Herkomst == '') == (/ModelParameters/OD_Bestemming == '') && (this || /ModelParameters/OD_Vertrekmoment == '')";
		parameter<string>   OD_Tag                                    := IsOD ? '_' + /ModelParameters/OD_Herkomst + '_' + /ModelParameters/OD_Bestemming : ''
		,	Descr = "Achter IntermediateResults en Output in de namen van de mappen van een HB-paar: _<O>_<D>, bijvoorbeeld _BU04020501_BU0363KP03; leeg in het generieke model."
		,	IntegrityCheck = "strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
		parameter<bool>     IsODMoment                                := IsOD && /ModelParameters/OD_Vertrekmoment != '', Descr = "Kiest het HB-paar een vertrekmoment (OD_Vertrekmoment)?";
		parameter<uint32>   OD_Minute                                 := IsODMoment ? uint32(substr(/ModelParameters/OD_Vertrekmoment, 3, 2)) : 0
		,	Descr = "De minuut van OD_Vertrekmoment; het uur moet dat van Dagdeel zijn en de minuut een van PT_DepartureMinutes_All."
		,	IntegrityCheck = "!IsODMoment || (uint32(substr(/ModelParameters/OD_Vertrekmoment, 0, 2)) == rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour) && any(PT_DepartureMinutes_All/values == this))";
		parameter<string>   IntermediateResultsDir                    := '%LocalDataProjDir%/IntermediateResults' + OD_Tag
		,	Descr = "De map van de stores van de autoritten, de benen en de ketens (PublicTransport_Prep); bij een HB-paar IntermediateResults_<O>_<D> (#129).";
		parameter<string>   OutputDir                                 := '%LocalDataProjDir%/Output' + OD_Tag + '/' + Analysis_date + '_' + /ModelParameters/OutputLabel + (IsSamen ? '_Merged' + string(/ModelParameters/MergeRunNr) + (any(Componenten/InMerge && Componenten/UsesCycling) ? CyclingNetwork_DirTag : '') : rjoin(ComponentName, Componenten/name, Componenten/UitvoerAchtervoegsel))
		,	Descr = "De map met de OV-uitvoer van deze run (#118): <Analysis_date>_<OutputLabel> met het achtervoegsel van de component (Componenten/UitvoerAchtervoegsel) of _Merged<MergeRunNr>, met _fb als een samengevoegde component over de Fietsersbond fietst; met PerBlock/tt_<moment>_<n>of<N> en signature.txt.";
		parameter<string>   fileNamePrefix                            := OutputDir + '/PerBlock/', Descr = "De map van de OV-uitvoer per herkomstblok (en van de exports van lopen, fiets en auto).";
		parameter<string>   OutputExt                                 := '.' + OutputFormat, Descr = "De extensie van de bestanden in PerBlock en Mediaan.";
		parameter<string>   ExportKlasse                              := IsSamen ? 'Merged' : ComponentName == 'WW' || ComponentName == 'CC' ? 'Direct' : ComponentName == 'Car' ? 'Car' : 'PT', Descr = "Welke kolommen de parquet-uitvoer van deze component heeft (PerDepartureMoment_T, CreateExports/LongFormat/Parquet_<ExportKlasse>): alleen die binnen de component variëren en niet lineair uit andere volgen. 'Direct' (WW, CC): Traveltime; 'Car': ook TravelDist_Car; 'PT': ook de prijzen, ModeUsed, de wacht-, voor- en natransporttijd en de afstanden per OV-modaliteit.";
		parameter<bool>     MaakMediaan                               := FALSE
		,	Descr = "Schrijft de uitvoerstap per blok ook de mediaan per HB-paar over de vertrekmomenten (Mediaan/tt_<datum>_mediaan_<n>of<N>)? Dat is de mediaan van de goedkoopste optie per vertrekmoment (laagste Price, bij gelijke prijs de snelste). Standaard niet: de medianen worden niet opgeleverd.";
		// De spelling van zeven kolomnamen van de parquet-uitvoer. GeoDMS onthoudt van een naam de spelling waarin hij het eerst gelezen
		// wordt, voor de hele configuratie (namen zijn hoofdletterongevoelig), en gdalwrite.vect schrijft die spelling als kolomnaam.
		// Elders heten deze items Price_augm en Traveldist_... Dit bestand
		// wordt als eerste gelezen, dus deze namen leggen de spelling van de csv-kop vast. Ze worden nergens gebruikt.
		container ParquetKolomSpelling
		{
			parameter<bool> Price_Augm;
			parameter<bool> TravelDist_Bus;
			parameter<bool> TravelDist_Metro;
			parameter<bool> TravelDist_Tram;
			parameter<bool> TravelDist_Rail;
			parameter<bool> TravelDist_Ferry;
			parameter<bool> TravelDist_N;
		}
		parameter<uint8>    NumberOfItersForNetworkCleanUp            := 10b                    , Descr = "In the network clean up method, how many iternations should be used?";

		// PUBLIC TRANSPORT
		parameter<string>   NS_TariffChoice                           := 'Price_FullFare'      , Descr = "Which tarif class for NS would you like to use. Full fare, or a discounted fare? Choices: 'Price_FullFare', 'Price_20pct_Discount' of 'Price_40pct_Discount'.";
		parameter<m>        MaxTransferDist                           := 500[m]                 , Descr = "Maximum Euclidean distance between public transport stops that is allowed to be walked for transfers.";
		parameter<string>   Concessiegebied_year                      := value(FareTable_year, uint32) < 2020 ? 'Y2020' : 'Y'+FareTable_year , Descr = "Which year of the concession areas would you like to use? Relevant for public transport price determination. Concessie-shapes bestaan alleen 2020-2026; voor FareTable_year < 2020 (o.a. DOVA-prijzen terug tot 2013) wordt Y2020 als proxy gebruikt.";
		parameter<string>   Concessiegebied_source                    := 'manual'               , Descr = "Use manual creation of concessiegebieden (based on CROW poster), or shapefile from CROW. Options:  manual, shape";
		parameter<string>   FareTable_year                            := substr(GTFS_file_date, 0, 4), Descr = "Prijsjaar: het jaar van GTFS_file_date, zodat de agency-labels van de FareTable bij de geladen feed horen (data/FareTable_dekkingsrapport.md). Detailed-FareTables bestaan voor 2023-2026; voor eerdere jaren rekent de prijs met DOVA (Advanced/PriceMethod_effective).";
		parameter<string>   PriceMethod                               := 'DOVA'             , Descr = "OV-prijsmethode: 'Detailed' (handmatige FareTable per Mode/Agency/Concessie/Lijn, zie OVprijzen/FareTable_2023) of 'DOVA' (concessie-brede km-tarieven uit DOVA-overzicht, terug tot 2013). Bij 'DOVA' bepaalt FareTable_year welk jaar (2013-2026) wordt gebruikt.";
		parameter<string>   PriceMethod_effective                     := value(FareTable_year, uint32) < 2023 ? 'DOVA' : PriceMethod, Descr = "Effectieve prijsmethode: Detailed-FareTables bestaan alleen voor 2023-2026, dus voor FareTable_year < 2023 (oudere GTFS-feeds) wordt altijd DOVA gebruikt, ongeacht PriceMethod.";
		parameter<string>   DOVA_year                                 := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaarkolom in het DOVA-overzicht (y2013..y2026); geklemd op dat bereik (bv. feed 20120917 -> 2013-prijzen).";
		parameter<string>   NS_prijzen_year                           := value(FareTable_year, uint32) < 2013 ? '2013' : (value(FareTable_year, uint32) > 2026 ? '2026' : FareTable_year), Descr = "Jaargang van de NS-tarieven-csv (data/Tarieven_NS/NS tarieven <jaar>.csv, 2013-2026 aanwezig); geklemd op dat bereik.";
		parameter<string>   NS_tariefnet_year                         := value(NS_prijzen_year, uint32) >= 2016 ? '2016' : '2013', Descr = "Jaargang van het NS-tariefnet (data/Tarieven_NS/NS_tariefnet_<jaar>.csv) bij NS_prijzen_year (#121): 2013 het NDOV-net met de gezamenlijke tariefpunten (stations met 0 TE ertussen), 2016 zonder die punten (elk stationspaar minstens 1 TE).";
		parameter<m>        DistanceTrainStationsSelection            := 350[m]                 , Descr = "To find out which GTFS-stops relate to which trainstation a geographic search distance is used.";
		parameter<m>        DistanceStopClusters                      := 100[m]                 , Descr = "To cluster stops which belong to the same 'stop' a geographic search distance is used. Stops in opposite directions should be considered the same stop cluster. Travelling from stops within a cluster is non-sensical.";
		unit<uint8> OVFiets_Locaties : nrofrows = 2
		, Descr = "De bestanden met de OV-fietslocaties in %NetworkModel_dir%/Infrastructuur, per jaar (AnalysisMomentPresets/OVFiets_year): 2023 283 locaties, gegeocodeerd door JC; 2025 de lijst van PBL (JB) van 13-10-2026, 293 locaties, gegeocodeerd met batch/OVFiets2025_Geocode.dms (kolom Bron)."
		{
			attribute<string> year : ['2023', '2025'];
			attribute<string> file : ['20260408_Locaties.OVF_2023_Geocoded.csv', '20261013_Locaties.OVF_2025_Geocoded.csv'];
		}
		parameter<string>   OVFiets_year                              := rjoin(/ModelParameters/AnalysisMoment, AnalysisMomentPresets/name, AnalysisMomentPresets/OVFiets_year);
		parameter<string>   OVFiets_File                              := rjoin(OVFiets_year, OVFiets_Locaties/year, OVFiets_Locaties/file), Descr = "Het bestand van de OV-fietslocaties van deze peildatum (SourceData/Infrastructure/OV_Fiets_Stations).";
		parameter<string>   OVFiets_FileTag                           := OVFiets_year == '2023' ? '' : '_ovf' + OVFiets_year, Descr = "In de handtekening van de OV-uitvoer als het natransport de OV-fiets heeft (PT_Output_ParamTag); leeg bij de locaties van 2023.";
		parameter<m>        DistanceOVFietsStops                      := 200[m]                 , Descr = "Maximale zoekafstand om OVfiets stations te koppelen aan GTFS haltes.";
		parameter<m>        DistanceKnooppuntClusters                 := 150[m]                 , Descr = "Clusterafstand om GTFS-haltes samen te voegen tot een OV-knooppunt (single linkage via connected_parts). Perrons/haltekommen van hetzelfde knooppunt vallen zo samen.";
		parameter<uint32>   Knooppunt_MinLijnen_BTM                   := 8                      , Descr = "Minimaal aantal unieke bus/tram/metro-lijnen op een haltecluster om als BTM-knooppunt te gelden (kruisende lijnen). Treinstations zijn altijd knooppunt; een solitaire metrohalte niet (die telt via de BTM-lijnen mee). Bij 8 lijnen ca. 270 BTM-knopen excl. metro (GTFS 20260316), schaal TBOV-actieagenda (~700 knooppunten totaal); bij 5 lijnen ca. 780.";
		parameter<uint32>   Knooppunt_MinVertrekken_BTM               := 150                    , Descr = "Minimaal aantal bus+tram+metro-vertrekken per dag (Analysis_date) op een haltecluster om als BTM-knooppunt te gelden. 150/dag komt overeen met ca. 8-10 vertrekken/uur overdag.";
		parameter<float32>  Knooppunt_BedrijfsurenPerDag              := 18f                    , Descr = "Aantal bedrijfsuren per dag waarmee vertrekken/dag wordt omgerekend naar frequentie/uur, t.b.v. de ontsluitingswaarde (vlindermodel).";
		parameter<m>        Knooppunt_DominantieRadius                := 1500[m]                , Descr = "Niet verhogen naar 2000m: dan valt o.a. busstation Drachten weg onder een sterkere kandidaat-halte in de buurt. Dominantiefilter (competitie, vgl. Goudappel 2024): een BTM-knooppunt vervalt als binnen deze straal een kandidaat met hogere netwerkwaarde ligt. Voorkomt reeksen knopen langs HOV-corridors (Zuidas, Uithoflijn), meerdere punten per groot complex (Schiphol) en corridorhaltes zonder eigen regiofunctie naast een station (Anderlechtlaan bij Station Zuid, De Hoek bij Hoofddorp). Een sterke BTM-knoop naast een zwak station blijft gewoon staan (Zoetermeer Centrum West naast Zoetermeer station); treinstations zelf vervallen nooit onder BTM-knopen.";
		parameter<m>        Knooppunt_DedupRadiusTrein                := 400[m]                 , Descr = "Twee treinclusters binnen deze straal (bv. NS-perrons en stadshaltes van hetzelfde station die net buiten de clusterafstand vallen, zoals Sloterdijk) worden ontdubbeld: het cluster met de meeste treinvertrekken blijft. Kortste afstand tussen twee echte NL-stations is ca. 800m, dus 400m is veilig.";
		parameter<uint32>   Knooppunt_MinRichtingen_BTM               := 3                      , Descr = "Minimaal aantal windrichtingen (4 sectoren: O/W/N/Z op basis van de richting naar de volgende halte) waarin BTM-vertrekken het cluster verlaten. Een corridor-bundel (R-net over een as, bv. Ilpendam) heeft er 2; een echt knooppunt met kruisende of uitwaaierende lijnen 3-4. Operationaliseert 'aantal richtingen' uit het vlindermodel.";
		parameter<float32>  Knooppunt_MinNetwerkwaarde_BTM            := 0f                     , Descr = "Optionele extra drempel op de netwerkwaarde (vlindermodel) voor BTM-knooppunten; 0 = uit. Ter referentie (GTFS 20260316): Amsterdam CS 3400, Station Noord 988, Zoetermeer Centrum West 501, Hoofddorp De Hoek 331, Anderlechtlaan 194, Lemmer busstation 111, Zierikzee busstation 78. Let op: een hoge drempel (bv. 500) schrapt vrijwel alle busstations in spoorloze kernen (Zierikzee, Lemmer, Drachten) - precies de knopen waarvoor deze laag is toegevoegd.";
		parameter<min_f>    MaxTransferTimeForBoardingSurcharge       := 35[min_f]              , Descr = "Maximale overstap tijd om binnen opstap basistarief te blijven. Dit is door Nederlands OV-prijs model bepaald. Dus niet zomaar aanpassen.";
		parameter<m_s>      TransferEffectiveSpeed                    := value(4.5[km_hr] / 1.2f, m_s), Descr = "De loopsnelheid tijdens het overstappen. X km/uur / 1.2 (correctie voor Manhattan distances) en dan geconverteerd naar meter/sec.";
		parameter<bool>     IncludeWaitingAtHomeInTravelTime          := FALSE                  , Descr = "Wil je dat de wachttijd thuis wordt meegenomen in de totale reisduur, bij vertrektijd vanaf bepaald moment?";
		parameter<Time>     PT_FirstDepartureMoment                   := first(MeasureMoments/Moment), Descr = "Begin van het analysevenster van het OV: het eerste vertrekmoment, in seconden sinds 00:00 van Analysis_date.";
		parameter<Time>     PT_LastArrivalMoment                      := last(MeasureMoments/Moment) + convert(ModelParameters/MaxPTTime, s_f)[Time] + uint32(NOT(IncludeWaitingAtHomeInTravelTime)) * MaxWaitingTimeAtOrigin
		, Descr = "Einde van het analysevenster van het OV: het laatste vertrekmoment plus MaxPTTime en de wachttijd thuis. Voorbij 24:00 (86400) loopt het venster door in de volgende dag, en gebruikt het netwerk ook de ritten van de dienstdag na Analysis_date.";
		parameter<min_f>    PT_Max_V_Time                             := max(OV_PreTransport_Typen/MaxTime) + Cycling_StartTime + Cycling_PreTransport_Penalty + Cycling_ParkingTime_IC_Station
		, Descr = "Langste voortransportbeen dat nog geldig kan zijn: de grootste Max*Time-grens (op netwerktijd) plus de start- en parkeertijden in het been. Begrenst per vertrekmoment het venster van OV-vertrekken (PerDepartureMoment_T) en het laatste instapmoment van de ketens.";
		parameter<Time>     PT_LastBoardingMoment                     := last(MeasureMoments/Moment) + convert(PT_Max_V_Time, s_f)[Time] + MaxWaitingTimeAtOrigin
		, Descr = "Laatste instapmoment waarop een keten nog gebruikt kan worden: het laatste vertrekmoment plus het langste voortransport en de wachttijd thuis, de bovengrens van Within_VW_Window. De ketenstap begint geen ketens die later instappen.";
		parameter<Time>     PrevServiceDayTailEnd                     := 21600[Time]           , Descr = "De ritten van de dienstdag voor Analysis_date die na middernacht doorrijden (GTFS-tijd 24:00 en later) vertrekken vrijwel alle voor 06:00; begint het analysevenster eerder, dan moet die dag compleet in de feed staan.";
		parameter<float32>  MinServiceDayTripShare                    := 0.95f                  , Descr = "Minimaal aandeel ritten van elke dienstdag die het analysevenster nodig heeft, ten opzichte van de drukste dag van dezelfde weekdag in de feed. Een feed is na een paar weken onvolledig en een feestdag rijdt een zondagsdienst; verlaag dit alleen bewust.";
		parameter<Time>     MaxWaitingTimeAtOrigin                    := 899[Time]             , Descr = "Maximale wachttijd thuis. Zet je dit hoog, zonder dat dit in de reistijd zit (WeighingWaitingAtOriginPreTransport = 0) dan kun je ongemerkt veel later vertrekken dan je denkt.";
		parameter<min_f>    GradeSeparatedTransferPenalty             := 0[min_f]               , Descr = "Does a public transport stop have a lot of vertical distance to traverse? In that case a time penalty will be given when traffering through that stop.";
		parameter<min_f>    Cycling_PreTransport_Penalty              := 0[min_f]               , Descr = "Parkeertijd van de fiets aan het eind van elk fietsbeen in het voortransport (bij een halte of station), opgeteld in de OD-matrix van het been (ExtraTime_seconds).";

		// FLEXVERVOER: GEBIEDSVERVOER OP AFROEP EN BELBUSSEN (ObjectVision/NetworkModel_PBL#113, #116)
		// Bravoflex, U-flex, SyntusFlex, FlexRRReis, Overal Flex, Texelhopper, Opstapper en belbussen staan in de
		// GTFS-feeds als gewone lijnen met ritten, maar moeten 30-60 min vooraf geboekt worden. NeTEx heeft er geen
		// gebiedsgeometrie voor (alleen de BISON flex-markering), dus de herkenning loopt op lijnnaam
		// (SourceData/Infrastructure/GTFS/RelevantSelection/Routes/IsFlex).
		// IsFlexMeenemen = FALSE neemt geen flex mee; met FlexMinInterval, FlexExtraWaitingTime en FlexCallCosts alle drie 0
		// rekent het de flexritten zoals de feed ze heeft. De standaard (#116): meenemen, met 15 min, 30 min en 0,00 euro;
		// de flextag van ketenstore en uitvoer (Flex_FileTag) is daarmee '_flex15i30w0ct'.
		parameter<bool>     IsFlexMeenemen                            := TRUE                   , Descr = "Neemt het model het flexvervoer (Routes/IsFlex: gebiedsvervoer op afroep en belbussen) mee? FALSE = alle links (rit- en wachtlinks) van flexlijnen uit het OV-net. De OV-knooppunten tellen de flexvertrekken hoe dan ook mee.";
		parameter<min_f>    FlexMinInterval                           := 15[min_f]              , Descr = "Minimum tijdsinterval tussen de ritten van een flexlijn: per ritpatroon (route, eerste en laatste halte, aantal haltes) blijft per blok van dit interval, vanaf 00:00 van de GTFS-dag, alleen de eerste rit in het OV-net (LoadFeeds/FlexOptions). Dunt flexlijnen die als rit per minuut zijn ingeroosterd (#116); 0 = niet dunnen.", IntegrityCheck = "this >= 0[min_f]";
		parameter<uint32>   FlexMinInterval_sec                       := uint32(round(convert(FlexMinInterval, s_f))), Descr = "FlexMinInterval in hele seconden, voor de blokken van LoadFeeds/FlexOptions.";
		parameter<min_f>    FlexExtraWaitingTime                      := 30[min_f]              , Descr = "Extra wachttijd per instap op een flexlijn, opgeteld bij de reistijd van het been: de beltijd en de onzekerheid over het aanrijtijdstip (#116). Telt mee in de MaxPTTime-grens en maakt TravelTime een criterium van de ketenrijger (Classifications/ChainJoinerParetoAttr_Candidates/HasTimePenalty).", IntegrityCheck = "this >= 0[min_f]";
		parameter<Euro>     FlexCallCosts                             := 0.00[Euro]             , Descr = "Belkosten per instap op een flexlijn, opgeteld bij de prijs van het been (in Price_O, dat de ketenrijger bij elke overstap optelt; #116).", IntegrityCheck = "this >= 0[Euro]";
		parameter<bool>     FlexHasTimePenalty                        := IsFlexMeenemen && FlexExtraWaitingTime > 0[min_f], Descr = "Krijgt een flexbeen extra wachttijd bij zijn reistijd?";
		parameter<string>   Flex_FileTag                              := not(IsFlexMeenemen) ? '_noflex' : (FlexMinInterval > 0[min_f] || FlexExtraWaitingTime > 0[min_f] || FlexCallCosts > 0[Euro] ? '_flex' + string(round(FlexMinInterval)) + 'i' + string(round(FlexExtraWaitingTime)) + 'w' + string(round(FlexCallCosts * 100f)) + 'ct' : ''), Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature) en van de OV-uitvoer (PT_Output_ParamTag): '_noflex' zonder flex, '_flex<interval>i<wachttijd>w<belkosten in ct>ct' met de flexparameters, leeg als die alle drie 0 zijn.";
		unit<uint8> FlexRouteTerms : nrofrows = 4
		, Descr = "Zoektermen (kleine letters, regex-alternatieven) waarop een GTFS-route als flex geldt; gezocht in lowercase(route_short_name + ' ' + route_long_name). Bewust smal: 'buurtbus'/'wijkbus' (dienstregeling), 'hopper' (Spijkhopper/Maasvlaktehopper zijn gewone EBS-lijnen), 'vlinder' (Arriva-kleinbussen op dienstregeling en de plaatsnaam 'Zaandam De Vlinder') en 'taxibus i.p.v. trein' (treinvervangend) horen er NIET in; die staan als bijna-treffers in FlexNearMissTerms en /FlexReport/NearMiss."
		{
			attribute<string> term        : ['flex', 'texelhopper', 'opstapper', 'belbus'];
			attribute<string> toelichting : ['Bravoflex (Arriva), Connexxion FLEX, Overal Flex, FlexRRReis, SyntusFlex, U-flex', 'Texelhopper (TXL)', 'Opstapper Fryslan (Arriva/Qbuzz)', 'belbus, generiek'];
		}
		parameter<string>   FlexRoutePattern                          := asList(FlexRouteTerms/term, '|');
		unit<uint8> FlexNearMissTerms : nrofrows = 5, Descr = "Termen die op flex lijken maar (nu) niet als flex gelden; alleen voor /FlexReport/NearMiss."
		{
			attribute<string> term : ['buurtbus', 'wijkbus', 'hopper', 'vlinder', 'taxi'];
		}
		parameter<string>   FlexNearMissPattern                       := asList(FlexNearMissTerms/term, '|');

		// RIT-OPSLAG VOOR SPECIALE TREINEN EN NS INTERNATIONAL (#3)
		// De NS-prijs van een reis volgt uit de tariefeenheden van het stationspaar (begin en eind van de NS-reis), over de
		// klassieke route: de HSL telt voor het tarief niet mee (SourceData/Infrastructure/OVprijzen/NS/Tariefnet_UitgeslotenKanten).
		// Wie tussen Schiphol en Rotterdam over de HSL reist (Intercity direct, Eurocity Direct) of binnenlands de ICE neemt,
		// betaalt daarbovenop per rit een toeslag. Die hangt van de rit af, niet van het stationspaar: hij komt per NS-been bij
		// de prijs (Price_S in PublicTransport_Prep/OD_L) en de ketenrijger telt hem los van het doorgaande NS-tarief op.
		parameter<bool>     IsRitOpslagMeenemen                       := TRUE                   , Descr = "Telt de rit-opslag van de treinen in RitOpslagTreinen mee in de prijs, en hun ExtraTijd in de reistijd? FALSE = geen toeslag.";
		parameter<bool>     IsNSInternationalInLnet                   := TRUE                   , Descr = "Doen de treinen van NS International (Eurocity Direct, EuroCity, ICE, IC Berlijn) mee in het NS-net (L-net) voor binnenlandse reizen, met het NS-tarief en hun rit-opslag? Treinen waarop een NS-kaartje nooit geldt (Eurostar, Nightjet) vallen er toch uit: zie TreinenZonderNSKaartje, en de GTFS staat op hun NL-haltes meestal geen in- of uitstappen toe (pickup_type of drop_off_type 1). FALSE = alle NS International-treinen buiten het net.";
		unit<uint8> RitOpslagTreinen : nrofrows = 2
		, Descr = "Treinproducten met een rit-opslag. Station_A en Station_B: NS-stationscodes van het traject waarover de opslag geldt; een been betaalt hem als zijn rit tussen in- en uitstappen beide stations aandoet. Leeg: elk been op het product betaalt hem. ExtraTijd: extra reistijd per instap, zoals FlexExtraWaitingTime (bijvoorbeeld voor reserveren). Het bedrag per jaar staat in SourceData/Infrastructure/OVprijzen/NS/RitOpslag; welke routes bij een product horen in RitOpslagRouteNamen."
		{
			attribute<string> name        : ['HSL_Schiphol_Rotterdam', 'ICE_binnenland'];
			attribute<string> Station_A   : ['shl', ''];
			attribute<string> Station_B   : ['rtd', ''];
			attribute<min_f>  ExtraTijd   : [0, 0];
			attribute<string> toelichting : ['NS-toeslag ICE/IC direct tussen Schiphol Airport en Rotterdam Centraal (sinds 15-12-2013 alleen dit traject), ook in de Eurocity Direct; Breda-Rotterdam over de HSL is toeslagvrij', 'NS-toeslag ICE/IC direct op elk binnenlands traject van de ICE (Amsterdam-Utrecht-Arnhem, Amsterdam-Amersfoort-Hengelo)'];
		}
		unit<uint8> RitOpslagRouteNamen : nrofrows = 4
		, Descr = "De route_short_name's (kleine letters, exact) waaraan een route van het L-net een product van RitOpslagTreinen herkent; zie SourceData/Infrastructure/GTFS/RelevantSelection/Routes/RitOpslag_rel. 'Intercity direct' heet zo bij NS en NS International (2024: HSN-treinen, 2025-2026: ICD-treinen), de ICE heet 'ICE International' (2024-2025) of 'ICE' (2026)."
		{
			attribute<string>           route_short_name : ['intercity direct', 'eurocity direct', 'ice', 'ice international'];
			attribute<RitOpslagTreinen> RitOpslag_rel    : [0, 0, 1, 1];
		}
		unit<uint8> TreinenZonderNSKaartje : nrofrows = 4
		, Descr = "Treinproducten van het L-net waarop een NS-kaartje nooit geldt (alleen een eigen kaartje met reservering), op route_short_name (kleine letters, exact); hun ritten doen niet mee in het L-net (PublicTransport_Prep/Set_L, GTFS/RelevantSelection/Routes/IsZonderNSKaartje). Nodig naast pickup_type/drop_off_type: in de feed van 20241001 laten 4 van de 30 Eurostar-ritten Amsterdam-Parijs uitstappen in Rotterdam toe, met een Eurostar-kaartje."
		{
			attribute<string> route_short_name : ['eurostar', 'thalys', 'nightjet', 'european sleeper'];
		}
		parameter<bool>     RitOpslagHasTimePenalty                   := IsRitOpslagMeenemen && max(RitOpslagTreinen/ExtraTijd) > 0[min_f], Descr = "Krijgt een been met rit-opslag extra reistijd?";
		parameter<string>   RitOpslag_Flags                           := (IsNSInternationalInLnet ? '' : 'I') + (IsRitOpslagMeenemen ? (RitOpslagHasTimePenalty ? 'w' + string(round(sum(RitOpslagTreinen/ExtraTijd))) : '') : 'R');
		parameter<string>   RitOpslag_FileTag                         := RitOpslag_Flags == '' ? '' : '_' + RitOpslag_Flags
		, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature) en van de OV-uitvoer (PT_Output_ParamTag): leeg met de standaard (NS International mee, rit-opslag mee, geen extra tijd), anders '_' met I (zonder NS International), R (zonder rit-opslag) of w<min> (extra tijd in minuten); kort vanwege de padlengte (#118).";

		parameter<bool>     IncludeWalkingCostsInPrice                := FALSE                  , Descr = "Wil je reistijdkosten van lopen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCyclingCostsInPrice                := TRUE                   , Descr = "Wil je reistijdkosten van fietsen meenemen in de uiteindelijke 'te bepalen' prijs.";
		parameter<bool>     IncludeCarCostsInPrice                    := TRUE                   , Descr = "Telt de kostprijs van de directe autorit (Car_FixedCosts_PerTrip + afstand x Car_CostPerKm) mee in Price? Zo niet, dan is de auto in het front gratis en wint hij op prijs altijd.";
		
		// COMPONENTEN (#117): een component is een directe rit (WW, CC of
		// Car) of een OV-reis <voortransport>_PT_<natransport>, met een voortransporttype uit VoortransportTypen en een natransporttype
		// uit NatransportTypen; alle 25 combinaties bestaan. Elke component kiest op MinimiseCriteria (prijs en tijd). Samenvoegen is
		// geen component: dat doet een run met MergeOutput, over de componenten in MergeComponents, met autobezit en fietsbezit als
		// criteria. Zo is de variant van JC (lopen naar elke halte of fietsen naar trein en metro, lopen na het OV, en
		// direct fietsen) de samenvoeging van W_PT_W, C_RM_PT_W en CC. Een e-bike is in te stellen met de fietsparameters.
		unit<uint8> VoortransportTypen : nrofrows = 5
		, Descr = "De voortransporttypen van de OV-componenten: lopen naar elke halte (W), fietsen naar elke halte (C), naar een trein- of metrohalte (C_RM), naar een trein-, metro- of tramhalte (C_RMT) of naar een IC-station (C_Ric). Namen uit Classifications/TimeInvariantTypes."
		{
			attribute<string> name             : ['Org2Stops_Walking', 'Org2Stops_Cycling', 'Org2RM_Stops_Cycling', 'Org2RMT_Stops_Cycling', 'Org2Ric_Stops_Cycling'], IntegrityCheck = "IsDefined(rlookup(this, /Classifications/TimeInvariantTypes/name))";
			attribute<uint32> BlokkenPerPortie : [50, 25, 25, 25, 25], Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap (batch/WriteOutputBlocks.ps1) van de OV-componenten met dit voortransport, dat het geheugen bepaalt: een kleinere portie houdt het geheugen lager, een grotere betaalt de opstart minder vaak. 0 = alle blokken in een portie. De omgevingsvariabele OUTPUT_BATCHSIZE gaat hier boven.";
			attribute</Classifications/TimeInvariantTypes> TimeInvariantTypes_rel := rlookup(name, /Classifications/TimeInvariantTypes/name);
			attribute<string> code             := /Classifications/TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel] + (/Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] != '' ? '_' + /Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] : ''), Descr = "W, C, C_RM, C_RMT of C_Ric: zoals in ModeUsed en OV_PreTransport_Typen/ExportName.";
		}
		unit<uint8> NatransportTypen : nrofrows = 5
		, Descr = "De natransporttypen van de OV-componenten: lopen (W), fietsen van elke halte (C), van een trein- of metrohalte (RM_C) of van een trein-, metro- of tramhalte (RMT_C), of de OV-fiets (OVf_C), alleen van een halte bij een OV-fietslocatie (DistanceOVFietsStops). Alleen de OV-fiets huurt; bij C, RM_C en RMT_C staat een eigen fiets bij de laatste halte (PostTransport_Cycling_Time_Costs). Namen uit Classifications/TimeInvariantTypes."
		{
			attribute<string> name             : ['Stops2Dest_Walking', 'Stops2Dest_Cycling', 'RM_Stops2Dest_Cycling', 'RMT_Stops2Dest_Cycling', 'OVF_Stops2Dest_Cycling'], IntegrityCheck = "IsDefined(rlookup(this, /Classifications/TimeInvariantTypes/name))";
			attribute</Classifications/TimeInvariantTypes> TimeInvariantTypes_rel := rlookup(name, /Classifications/TimeInvariantTypes/name);
			attribute<string> code             := (/Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] != '' ? /Classifications/TimeInvariantTypes/StopClass[TimeInvariantTypes_rel] + '_' : '') + /Classifications/TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel], Descr = "W, C, RM_C, RMT_C of OVf_C: zoals in ModeUsed en OV_PostTransport_Typen/ExportName.";
		}
		unit<uint8> PT_Componenten := combine_uint8(VoortransportTypen, NatransportTypen)
		, Descr = "De OV-componenten: elke combinatie van een voor- en een natransporttype, zonder directe rit."
		{
			attribute<string> name             := VoortransportTypen/code[first_rel] + '_PT_' + NatransportTypen/code[second_rel];
			attribute<string> Voortransport    := VoortransportTypen/name[first_rel];
			attribute<string> Natransport      := NatransportTypen/name[second_rel];
			attribute<uint32> BlokkenPerPortie := VoortransportTypen/BlokkenPerPortie[first_rel];
			attribute<bool>   NeedsBike        := /Classifications/TimeInvariantTypes/NeedsOwnBike[VoortransportTypen/TimeInvariantTypes_rel[first_rel]] || /Classifications/TimeInvariantTypes/NeedsOwnBike[NatransportTypen/TimeInvariantTypes_rel[second_rel]], Descr = "Vraagt de component een eigen fiets: fietsen in het voortransport, of in het natransport behalve de OV-fiets?";
			attribute<bool>   UsesCycling      := /Classifications/TimeInvariantTypes/NetworkType[VoortransportTypen/TimeInvariantTypes_rel[first_rel]] == 'Cycling' || /Classifications/TimeInvariantTypes/NetworkType[NatransportTypen/TimeInvariantTypes_rel[second_rel]] == 'Cycling', Descr = "Rijdt de component over het fietsnet: fietsen in voor- of natransport, ook de OV-fiets?";
		}
		unit<uint8> DirecteComponenten : nrofrows = 3
		, Descr = "De directe ritten als component: WW lopen, CC fietsen, Car de auto (in ModeUsed AA), zonder OV."
		{
			attribute<string> name             : ['WW', 'CC', 'Car'];
			attribute<bool>   DirectWalking    : [TRUE, FALSE, FALSE];
			attribute<bool>   DirectCycling    : [FALSE, TRUE, FALSE];
			attribute<bool>   DirectCar        : [FALSE, FALSE, TRUE];
		}
		unit<uint8> Componenten := union_unit_uint8(DirecteComponenten, PT_Componenten)
		, Descr = "De componenten, te kiezen met /ModelParameters/Component: de directe ritten en de OV-componenten (#117). De uitvoer van 2023 is geleverd als W_PT (WW en W_PT_W samen) en C_PT (CC, C_PT_W en C_PT_OVf_C samen)."
		{
			attribute<string> name             := union_data(., DirecteComponenten/name, PT_Componenten/name);
			attribute<string> Voortransport    := union_data(., const('Org2Stops_Walking', DirecteComponenten), PT_Componenten/Voortransport), Descr = "Het voortransporttype; bij een directe rit niet gebruikt.";
			attribute<string> Natransport      := union_data(., const('Stops2Dest_Walking', DirecteComponenten), PT_Componenten/Natransport), Descr = "Het natransporttype; bij een directe rit niet gebruikt.";
			attribute<bool>   DirectWalking    := union_data(., DirecteComponenten/DirectWalking, const(FALSE, PT_Componenten));
			attribute<bool>   DirectCycling    := union_data(., DirecteComponenten/DirectCycling, const(FALSE, PT_Componenten));
			attribute<bool>   DirectCar        := union_data(., DirecteComponenten/DirectCar, const(FALSE, PT_Componenten));
			attribute<bool>   MetOV            := union_data(., const(FALSE, DirecteComponenten), const(TRUE, PT_Componenten)), Descr = "Doen de OV-ketens mee? Zonder OV leest de eindafweging per vertrekmoment alleen de directe ritten, en hoeft er geen ketenstore te zijn.";
			attribute<bool>   UsesCycling      := union_data(., DirecteComponenten/DirectCycling, PT_Componenten/UsesCycling), Descr = "Rijdt de component over het fietsnet van CyclingNetwork? CC, en een OV-component met fietsen in voor- of natransport, ook de OV-fiets; voor de component van de run gelijk aan Advanced/UsesCycling.";
			attribute<string> UitvoerAchtervoegsel := '_' + name + (UsesCycling ? /ModelParameters/Advanced/CyclingNetwork_DirTag : ''), Descr = "Achter OutputLabel in de naam van de uitvoermap (OutputDir): _ en de naam van de component, met CyclingNetwork_DirTag (_fb) als de component over het fietsnet rijdt; het samenvoegen zoekt de componenten zo (NetworkSetup/ComponentMerge).";
			attribute<uint32> BlokkenPerPortie := union_data(., const(50, DirecteComponenten, uint32), PT_Componenten/BlokkenPerPortie), Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap: 50 bij een directe rit, bij een OV-component die van zijn voortransport (VoortransportTypen/BlokkenPerPortie).";
			attribute<bool>   EenVertrekmoment := union_data(., const(TRUE, DirecteComponenten), const(FALSE, PT_Componenten)), Descr = "Rekent en schrijft deze component een vertrekmoment, dat van het congestiemoment van het dagdeel (CongestionMinute; bij de ochtendspits 07:30), in plaats van vier per kwartier? Zo bij WW en CC, die niet van het vertrekmoment afhangen, en bij Car met een autostore per congestiemoment (#132). Het samenvoegen leest het ene bestand voor elk vertrekmoment.";
			attribute<bool>   EenVertrekmoment_Eff := EenVertrekmoment && !(DirectCar && /ModelParameters/Advanced/CarTimeDependent), Descr = "EenVertrekmoment, behalve bij de tijdafhankelijke autorit (CarTimeDependent): dan verschillen de vertrekmomenten echt.";
			attribute<string> ExportKlasse     := union_data(., DirecteComponenten/name == 'Car' ? 'Car' : 'Direct', const('PT', PT_Componenten)), Descr = "De soort kolommen van de parquet-uitvoer van de component (Advanced/ExportKlasse): Direct (WW, CC), Car of PT. Het samenvoegen leest ze zo.";
			attribute<bool>   NeedsCar         := DirectCar, Descr = "Vraagt de component een auto? Alleen Car.";
			attribute<bool>   NeedsBike        := union_data(., DirecteComponenten/DirectCycling, PT_Componenten/NeedsBike), Descr = "Vraagt de component een eigen fiets? CC, en een OV-component met fietsen in voor- of natransport behalve de OV-fiets.";
			attribute<bool>   InMerge          := IsDefined(strpos(',' + lowercase(/ModelParameters/MergeComponents) + ',', ',' + lowercase(name) + ',')), Descr = "Staat deze component in MergeComponents?";
		}
		parameter<bool>     IsSamen                                   := /ModelParameters/MergeOutput, Descr = "Voegt deze run de componenten samen (MergeOutput)?";
		parameter<bool>     MetOV                                     := !IsSamen && /ModelParameters/Component == 'PT', Descr = "Doen de OV-ketens mee in deze run (Componenten/MetOV)? Niet bij een directe rit en niet bij het samenvoegen.";
		parameter<string>   ComponentName                             := /ModelParameters/Component == 'PT' ? VoortransportTypen/code[rlookup(/ModelParameters/Voortransport, VoortransportTypen/TimeInvariantTypes_rel)] + '_PT_' + NatransportTypen/code[rlookup(/ModelParameters/Natransport, NatransportTypen/TimeInvariantTypes_rel)] : /ModelParameters/Component
		,	Descr = "De naam van de component van deze run: WW, CC, Car, of bij Component 'PT' <voortransport>_PT_<natransport> uit Voortransport en Natransport, bijvoorbeeld W_PT_W of C_RM_PT_OVf_C.", IntegrityCheck = "IsDefined(rlookup(this, Componenten/name))";
		parameter<string>   Component_Voortransport                   := TimeInvariantTypes/name[/ModelParameters/Voortransport], Descr = "De naam van het voortransporttype (/ModelParameters/Voortransport); bij een directe rit niet gebruikt.";
		parameter<string>   Component_Natransport                     := TimeInvariantTypes/name[/ModelParameters/Natransport], Descr = "De naam van het natransporttype (/ModelParameters/Natransport); bij een directe rit niet gebruikt.";
		parameter<bool>     EenVertrekmoment                          := !IsSamen && rjoin(ComponentName, Componenten/name, Componenten/EenVertrekmoment_Eff), Descr = "Rekent deze run een vertrekmoment, dat van het congestiemoment (Componenten/EenVertrekmoment; de directe ritten, Car niet met CarTimeDependent)?";
		parameter<uint32>   CongestionMinute                          := MakeDefined(uint32(substr(rjoin(rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/CongestionMoment), CongestionTimes/name, CongestionTimes/Time), 2, 2)), 30), Descr = "De minuut van het congestiemoment van het dagdeel (CongestionTimes/Time, bij de ochtendspits 0730): het vertrekmoment van een component met EenVertrekmoment.";
		parameter<string>   EenVertrekmoment_Shrt                     := (rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour) < 10 ? '0' : '') + string(rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour)) + 'h' + (EenVertrekmoment_Minute < 10 ? '0' : '') + string(EenVertrekmoment_Minute) + 'm', Descr = "De korte naam van dat vertrekmoment, als Time/TemplatableTextShrt (07h30m): zo heet het bestand per blok van een component met EenVertrekmoment, dat ComponentMerge voor elk vertrekmoment leest.";
		parameter<uint32>   EenVertrekmoment_Minute                   := IsODMoment ? OD_Minute : CongestionMinute, Descr = "De minuut van het ene vertrekmoment van een component met EenVertrekmoment: CongestionMinute, of bij een HB-paar met OD_Vertrekmoment dat (OD_Minute).";
		parameter<uint32>   BlokkenPerPortie                          := IsSamen ? 10 : rjoin(ComponentName, Componenten/name, Componenten/BlokkenPerPortie), Descr = "Herkomstblokken per GeoDmsRun in de uitvoerstap van deze run (Componenten/BlokkenPerPortie); bij het samenvoegen 10: in een opvraging ongeveer 7 GB per blok.";

		unit<uint8> DirectModes : nrofrows = 3
		, Descr = "De directe modaliteiten die naast het OV in het front per HB-paar kunnen meedoen, met hun schakelaar. De naam is de naam van de bron onder NetworkSetup/PublicTransport_Prep/Direct."
		{
			attribute<string> name    : ['Walking', 'Cycling', 'Car'];
			attribute<string> abbrev  : ['W', 'C', 'A'], Descr = "Letter van de modaliteit in ModeUsed (Modes/Selection/name_abbr); een directe rit heet in de uitvoer WW, CC of AA.";
			attribute<bool>   Allowed := union_data(., /ModelParameters/Advanced/AllowDirectWalking, /ModelParameters/Advanced/AllowDirectCycling, /ModelParameters/Advanced/AllowDirectCar);
		}
		unit<uint8> DirectModes_Selected := select_with_attr_by_cond(DirectModes, DirectModes/Allowed), Descr = "De toegestane directe modaliteiten.";
		parameter<string>   Direct_str                                := asList(DirectModes_Selected/abbrev + DirectModes_Selected/abbrev, ',')
		,	Descr = "De directe modaliteiten zoals ze in de handtekening staan (V-<Direct_str>,<voortransport>_N-<natransport>): WW, CC en/of AA, in de volgorde van DirectModes."
		,	IntegrityCheck = "Direct_str != '' || MetOV || IsSamen" // minstens een van AllowDirectWalking/Cycling/Car, behalve met OV (sinds 2026-10-19 de _OVf-componenten: alleen ketens, Direct_OD leeg via PublicTransport_Prep/HasDirectTI) en bij Merged
		;
		parameter<uint32>   NumberOfStopBlocks                        := IsOD ? 1 : 500         , Descr = "In the generation of the unlinked PT-network, how many stop blocks should be used in the Ketenrijger? Less means more memory usage per unit of time. Bij een HB-paar (IsOD) een blok: de haltes waar een voortransportbeen van de herkomst eindigt (PublicTransport_Prep/OD_Haltes).";
		parameter<uint32>   MaxStopBlockSize                          := 104                     , Descr = "In the generation of the unlinked PT-network, what is maximum stop block size? Make sure that the product of this value and the NumberOfStopBlocks is sufficient to include all stops";
		parameter<uint32>   NumberOfOrgBlocks                         := IsOD ? 1 : 450         , Descr = "In the generation of PT-output files, how many origin blocks should be used? Less means more memory use, but less overhead. Bij een HB-paar (IsOD) een blok met de ene herkomst. Het product met MaxOrgBlockSize moet minstens het aantal herkomsten zijn; ChecksBeforeRunning/Check_OriginBlocks meldt welk getal nodig is.";
		parameter<uint32>   MaxOrgBlockSize                           := IsDefined(Buurtset_Org) ? 33 : 200, Descr = "In the generation of PT-output files, what is maximum origin block size? 200 herkomsten per blok, 33 bij een buurtvariant als Orgset (#126): 450 x 33 dekt de buurten van 2023 en 2025, zodat alle blokken gevuld zijn. Het product met NumberOfOrgBlocks moet minstens het aantal herkomsten zijn.";
		parameter<bool>     PriceExportsAndIntegrityChecksNeeded      := IsDefined(strpos(lowercase(MinimiseCriteria), 'price')) || Export_PriceInformation;
		// PARETO-BENEN (ObjectVision/NetworkModel_PBL#115, ObjectVision/GeoDMS#856)
		// De pareto-optie van impedance_matrix doet een bi-criteria label-setting zoektocht op
		// (Duration, Length) in plaats van min-Duration met Length als bijproduct. Voor het R-net is
		// prijs = FixedPrice + VariablePrice * afstand en dus monotoon in Length: het (tijd,afstand)-
		// front IS daar het (tijd,prijs)-front. Voor het L-net (NS) volgt de prijs uit de
		// TariffUnits-matrix over (eerste,laatste) station en dus uit het OD-paar zelf; een front
		// levert daar geen extra prijsopties op, alleen meer rijen. Vandaar twee schakelaars.
		// De vier schakelaars zelf staan in een eigen bestand, zodat de meetharnas van #115 per
		// arm EEN bestand in zijn geheel kan herschrijven in plaats van regels in dit bestand te
		// moeten patchen: welke arm draait is dan af te lezen aan `git diff cfg/main/ParetoArm.dms`.
		#include<ParetoArm.dms>
		// PARETO-FRONT VOOR DE DIRECTE AUTORIT (#115, #88). De auto-Dijkstra
		// levert per HB-paar EEN route, de snelste. Met de pareto-optie levert dezelfde operator per HB-paar het (reistijd,
		// afstand)-front: de snelle snelwegroute naast de korte binnenweg. De prijs is afstand x Car_CostPerKm, dus dat is ook
		// het (tijd, prijs)-front dat de eindafweging per HB-paar tegen OV, lopen en fietsen afweegt. Alleen de directe rit
		// (PublicTransport_Prep/Direct/Car) gebruikt de pareto-variant; de auto-exports blijven scalair.
		parameter<bool>     ParetoLegs_Car                            := TRUE                   , Descr = "Gebruik de pareto-optie van impedance_matrix_od64 voor de directe autorit in het front per HB-paar: per HB-paar alle (reistijd, afstand)-optimale routes in plaats van alleen de snelste. Kost meer rekentijd en geheugen dan de scalaire Dijkstra; zie CarFrontEpsilon.";
		parameter<km>       CarLegDistanceQuantum                     := 0.04[km]               , Descr = "Alleen op een engine zonder pareto(imp2_epsilon) (EngineHasParetoEpsilon): kwantisatie van het tweede pareto-criterium, de afstand per link, met dithering (ImpedanceMatrix_with_AltImp_pareto_T/AltImp_q), zodat de fronten op een wegennet met continue lengtes niet ontsporen. 40 m is 1 ct bij 0,24 euro per km.";
		parameter<bool>     EngineHasParetoEpsilon                    := GeoDmsMajorVersionNumber() > 20 || (GeoDmsMajorVersionNumber() == 20 && GeoDmsMinorVersionNumber() >= 21), Descr = "Kent de engine de optie pareto(imp2_epsilon) van impedance_matrix_od64 en pareto_optimal_eps (ObjectVision/GeoDMS#1281, ObjectVision/GeoDMS#1282)? Zo niet, dan valt de directe autorit terug op de kwantisatie per link (CarLegDistanceQuantum) en blijft het front bij het lezen ongefilterd.";
		parameter<float32>  CarFrontEpsilon                           := 0.01f                  , Descr = "Relatieve epsilon van het autofront (#88, ObjectVision/GeoDMS#1282): het front loopt in volgorde van afstand, de kortste route eerst, en een langere route blijft alleen als ze meer dan deze fractie sneller is dan de snelste kortere route die blijft. De engine past de epsilon per bestemmingszone toe en zoekt exact. 0 = reistijd eerst met de gekwantiseerde afstand (CarLegDistanceQuantum).", IntegrityCheck = "this >= 0f && this <= 1f && (!EngineHasParetoEpsilon || EngineHasRelativeParetoEpsilon)";
		parameter<km>       CarFrontMaxDistance                       := value(MaxCarTime / 1[min_f] * 2.5f, km), Descr = "De grens op het eerste criterium van de zoektocht op afstand eerst (CarFrontEpsilon), die de engine verplicht stelt: de afstand die in MaxCarTime met 150 km/u te halen is, zodat hij niets afsnijdt; de echte grens is MaxCarTime op de reistijd, het tweede criterium.";
		parameter<bool>     EngineHasParetoLinkSet                    := TRUE                   , Descr = "Kent de engine pareto met LinkSet (ObjectVision/GeoDMS#1325)? Dan geeft de autorit in de HB-paarmodus (IsOD) de links van elke route in het front. Een engine zonder weigert dat met een fout: zet hem dan op FALSE, en de auto heeft geen route op de kaart. Buiten de HB-paarmodus telt hij niet.";
		parameter<string>   CarTD_Search                              := 'pareto_alt'           , Descr = "De zoektocht van de tijdafhankelijke autorit (CarTimeDependent): 'pareto_alt' = afstand eerst, zoals de momentopname (CarFrontEpsilon), met het tijdprofiel op de reistijd (timedependent_alt, ObjectVision/GeoDMS#1304); 'scalar' = alleen de snelste route, met het tijdprofiel op het enige criterium (timedependent).", IntegrityCheck = "this == 'pareto_alt' || this == 'scalar'";
		parameter<uint32>   CarTD_WindowStart                         := (rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour) - 1) * 3600, Descr = "Begin van het venster met tijdvakken van de tijdafhankelijke autorit, in seconden sinds 00:00: een uur voor het uur van de vertrekmomenten (06:00 bij de ochtendspits). De vertrektijd in de zoektocht telt vanaf hier.";
		parameter<uint32>   CarTD_NrSlots                             := 48                     , Descr = "Aantal tijdvakken van de TomTom Speed Profiles (300 s) in het venster: 4 uur. Het laatste vertrekmoment plus Car_StartTime plus MaxCarTime (bij de ochtendspits 09:17) ligt er binnen; daarna zou het profiel van voren af aan beginnen.", IntegrityCheck = "CarTD_WindowStart + this * 300 <= 86400";
		parameter<s_f>      CarTD_SlotDuration                        := 300[s_f]               , Descr = "Duur van een tijdvak van de TomTom Speed Profiles (time_slot loopt in stappen van 300 s).";
		parameter<bool>     EngineHasRelativeParetoEpsilon            := = EngineHasParetoEpsilon ? '#ParetoEpsilonProbe/od == 1' : 'FALSE'
		, Descr = "Rekent de engine de epsilon van pareto(imp2_epsilon) en pareto_optimal_eps relatief (ObjectVision/GeoDMS#1282)? Oudere builds namen hem zonder fout als bakbreedte in de eenheid van het criterium; de proef ParetoEpsilonProbe onderscheidt ze.";
		container ParetoEpsilonProbe: Descr = "Een netwerkje van drie knopen voor EngineHasRelativeParetoEpsilon."
		{
			unit<uint32> PNode : nrofrows = 3;
			unit<uint32> PLink : nrofrows = 3
			{
				attribute<PNode>   F1 : [0, 0, 2];
				attribute<PNode>   F2 : [1, 2, 1];
				attribute<float64> t  : [1.0, 1.0, 1.0];
				attribute<float64> c  : [10.0, 5.0, 4.95];
			}
			unit<uint32> PZone : nrofrows = 1;
			unit<uint32> PStart : nrofrows = 1
			{
				attribute<PNode> node_rel : [0];
				attribute<PZone> zone_rel : [0];
			}
			unit<uint32> PEnd : nrofrows = 1
			{
				attribute<PNode> node_rel : [1];
				attribute<PZone> zone_rel : [0];
			}
			unit<uint32> od := impedance_matrix(
				  'directed;startPoint(Node_rel,OrgZone_rel);endPoint(Node_rel,DstZone_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;pareto(imp2_epsilon);od:impedance'
				, PLink/t, PLink/F1, PLink/F2, PStart/node_rel, PStart/zone_rel, PEnd/node_rel, PEnd/zone_rel, const(100.0, PZone), PLink/c, 0.01);
		}
		parameter<string>   Car_PriceTag                              := AllowDirectCar ? '_car' + (IncludeCarCostsInPrice ? string(round(Car_CostPerKm * 100f)) + 'ctkm' + (Car_FixedCosts_PerTrip > 0[Euro] ? '-p' + string(round(Car_FixedCosts_PerTrip * 100f)) + 'ct' : '') : '0') : '', Descr = "Deel van de handtekening van de OV-uitvoer (PT_Output_ParamTag, #88): de prijs van de directe autorit, in ct per km en, als dat niet 0 is, per rit; _car0 als IncludeCarCostsInPrice uit staat. De autostore bevat alleen reistijd en afstand, dus de prijs staat niet in zijn handtekening.";
		parameter<float32>  ChainParetoTimeEpsilon                    := 0.01f                  , Descr = "Relatieve epsilon op de reistijd in de eindafweging per vertrekmoment, bij het samenvoegen en, met een tijdpenalty, in de ketenrijger (ObjectVision/GeoDMS#1282): de prijs staat voorop, en een duurdere optie blijft alleen als ze meer dan deze fractie sneller is dan de snelste goedkopere optie die blijft. 0.01: 1%; 0 = exact. Op de prijs en op de resttijden van de ketenrijger is de vergelijking exact.", IntegrityCheck = "this >= 0f && this <= 1f && (!EngineHasParetoEpsilon || EngineHasRelativeParetoEpsilon)";
		parameter<string>   ChainPareto_FileTag                       := EngineHasParetoEpsilon && ChainParetoTimeEpsilon > 0f ? '_chainrel' + string(ChainParetoTimeEpsilon * 100f) + 'pct' : '', Descr = "Deel van de handtekening van de ketenstore en van de OV-uitvoer: de relatieve epsilon op de reistijd in procenten, leeg als die 0 is of de engine hem niet kent.";
		parameter<string>   ChainStore_ParamTag                       :=
			  '_' + lowercase(PriceMethod_effective)
			+ (NS_TariffChoice == 'Price_20pct_Discount' ? '-ns20' : (NS_TariffChoice == 'Price_40pct_Discount' ? '-ns40' : ''))
			+ (PriceExportsAndIntegrityChecksNeeded ? '' : '-noprice')
			+ '_ov' + string(round(MaxTransferDist)) + '-' + string(round(TransferEffectiveSpeed * 3600f)) + '-' + string(round(Transfer_Walking_Time_Costs * 100f)) + '-' + string(round(Transfer_Waiting_Time_Costs * 100f)) + '-' + string(round(GradeSeparatedTransferPenalty)) + '-' + string(round(MaxTransferTimeForBoardingSurcharge))
			+ '_h' + string(round(DistanceStopClusters)) + '-' + string(round(DistanceTrainStationsSelection))
			+ '_v' + string(round(PT_Max_V_Time))
			+ (IFF_Overstaptijd ? '_iff' + IFF_file_date : '')
		, Descr = "Deel van de handtekening van de ketenstore (PublicTransport_Prep/ChainStore_Signature) met de parameters waar de ketens van afhangen en die de rest van de handtekening niet noemt: de prijsmethode (dova of detailed, met -ns20/-ns40 bij NS-korting en -noprice als de prijzen niet worden bewaard), _ov<MaxTransferDist m>-<TransferEffectiveSpeed m/uur>-<Transfer_Walking_Time_Costs ct/min>-<Transfer_Waiting_Time_Costs ct/min>-<GradeSeparatedTransferPenalty min>-<MaxTransferTimeForBoardingSurcharge min> en _h<DistanceStopClusters m>-<DistanceTrainStationsSelection m>. Het prijsjaar volgt uit GTFS_file_date, dat de handtekening noemt als het van Analysis_date afwijkt.";
		parameter<string>   CarNetwork_Revision                       := '_r3'
		, Descr = "Revisie van het TomTom-autonet in de handtekening van de autostores (en zo in de hash in hun naam): verhoog hem bij elke codewijziging die het autonet verandert, anders wordt de oude store gelezen. Wat per revisie veranderde, staat in de commits en in #88.";
		parameter<m>        ExtraLink_MaxSnapDistance                 := 250[m]                 , Descr = "Maximale afstand van een eindpunt van een handmatige verbinding (OSM/NetworkPreperation/ExtraVerbindingen) tot het wegennet; een verbinding met een verder eindpunt doet niet mee.";
		parameter<float32>  OSM_MaxSpeedQuantile                      := 0.5f
		, Descr = "Kwantiel van de getagde maxspeed per wegtype en land, over de getagde wegen, voor OSM-wegen zonder bruikbare maxspeed-tag: de mediaan beschrijft een typische ongetagde weg.";
		parameter<bool>     ChainStore_PerBlock                       := TRUE
		, Descr = "De ketenstap schrijft elk haltenblok in een eigen store (PublicTransport_Prep/StorageBlockDir_Str) en de uitvoerstap leest ze samen; FALSE: een store voor alle blokken (Write_Result). Per blok blijven de resultaten niet tot het eind in het geheugen, en een onderbroken ketenstap gaat bij het eerste ontbrekende blok verder (batch/WriteChainBlocks.ps1).";
		parameter<bool>     IFF_Overstaptijd                          := TRUE                   , Descr = "Duurt een overstap tussen twee verschillende treinhaltes (perrons) van hetzelfde NS-station minstens de overstaptijd van dat station uit de IFF-dienstregeling van NS (Infrastructure/IFF_Stations), naast de looptijd over de rechte afstand (#123)? Op hetzelfde perron en tussen trein en bus, tram of metro telt alleen de looptijd. In de handtekening van de ketenstore (_iff<datum>).";
		parameter<string>   IFF_file_date                             := '20261013'             , Descr = "De levering van de IFF-dienstregeling van NS (%NetworkModel_Dir%/Infrastructuur/IFF/<datum>/stations.csv), voor alle peildata; de overstaptijden per station veranderen weinig.";
		parameter<string>   ChainStore_Revision                       := '_r12'
		, Descr = "Revisie van de ketenopbouw in de handtekening van de ketenstore (en zo in de hash in zijn naam): verhoog hem bij elke codewijziging die de ketens verandert, anders wordt de oude store gelezen. Wat per revisie veranderde, staat in de commits en in de issues.";
		parameter<string>   ParetoLegs_Car_FileTag                    := ParetoLegs_Car ? '_paretoCar' + (EngineHasParetoEpsilon && CarFrontEpsilon > 0f ? 'D-r'+string(CarFrontEpsilon * 100f)+'pct' : (CarLegDistanceQuantum > 0[km] ? 'q'+string(round(CarLegDistanceQuantum * 1000f))+'m' : '')) : '', Descr = "Deel van de handtekening van de autostores en van de OV-uitvoer, want het front met de directe autorit hangt van deze parameters af (#88): 'D-r1pct', afstand eerst met de relatieve epsilon in procenten, of de kwantisatie in m; leeg als ParetoLegs_Car uit staat.";

		
		// PRIVATE TRANSPORT
		parameter<bool>     UseActualCyclingSpeeds                    := FALSE                  , Descr = "In the case of cycling, would you like to use actual cycling speeds (from Fietstelweek) or a constant speed (as defined in BikingSpeed_kmhr)?";
		parameter<string>   CongestionSpeed_DaySelection              := 'tuesday'              , Descr = "Which day (or day selection) do you choose to use TomTom congenstion data from. Options: 'Weekday' 'Weekend' 'Week' 'monday' 'tuesday' 'wednesday' 'thursday' 'friday' 'saturday' 'sunday' ";
		parameter<string>   TomTom_StreetTypeSelection                 := 'FuncRoadClass/V/Local_Road_of_Minor_Importance', Descr = "This setting gives to option to exclude certain roadtypes in the TomTom network. Options: 7 FuncRoadClass/V/Local_Road   8 FuncRoadClass/V/Secondary_Road Local_Road_of_Minor_Importance  Local_Road_of_High_Importance ";
		parameter<m>        Fietstel_OSM_link_dist                    := 8[m]                   , Descr = "De maximale afstand tussen OSM en FietsTelWeek data om te linken ";
		parameter<float64>  ConnectSearchDist                         := 100d*100d              , Descr = "Zoek gebied voor connect_info operaties, zoals linken NDW aan NWB en NWB aan OSM, en FietsTelWeek aan OSM. Float64: connect_info op dpoint-rdc verwacht een float64 zoekafstand (kwadratisch).";
		parameter<string>   CyclingNetwork                            := 'OSM'                  , Descr = "Het net van alle fietsbenen en de directe fietsrit: 'OSM' of 'Fietsersbond' (met eenrichtingsfietspaden, zonder Fietstelweek-snelheden). Standaard OSM, op verzoek van PBL: het Fietsersbond-net van 2024 krijgt geen nieuwe versies en wordt eerst met OSM vergeleken (#124). Lopen gaat altijd over OSM.", IntegrityCheck = "CyclingNetwork == 'Fietsersbond' || CyclingNetwork == 'OSM'";
		parameter<string>   Fietsersbond_file_date                    := '20250525'             , Descr = "De levering van het Fietsersbond-routenetwerk (%NetworkModel_Dir%/Infrastructuur/Fietsersbond_<datum>), voor alle peildata.";
		parameter<m>        Fietsersbond_MaxVeerpontLengte            := 2000[m]                , Descr = "Een veerpont van de Fietsersbond tot deze lengte doet mee in het fietsnet (217 van de 279 in de levering van 25-05-2025); de langere overtochten (62, 2 tot 39 km) niet: die horen bij het OV of liggen buiten bereik (#124).";
		parameter<min_f>    Fietsersbond_VeerpontExtraTijd            := 5[min_f]               , Descr = "Wachten en overvaren op een veerpont van de Fietsersbond, bovenop de fietstijd over zijn lengte (#124).";
		parameter<string>   CyclingNetwork_FileTag                    := CyclingNetwork == 'OSM' ? '' : '_fb' + Fietsersbond_file_date + '-veer' + string(round(Fietsersbond_MaxVeerpontLengte / 1[m])) + 'm' + string(round(Fietsersbond_VeerpontExtraTijd / 1[min_f])) + 'min', Descr = "In de handtekening van de OV-uitvoer als een fietsbeen of de directe fietsrit meedoet (PT_Output_ParamTag); leeg met OSM.";
		parameter<string>   CyclingNetwork_DirTag                     := CyclingNetwork == 'Fietsersbond' ? '_fb' : '', Descr = "Achter de naam van de uitvoermap van een component over het fietsnet (Componenten/UitvoerAchtervoegsel): '_fb' met de Fietsersbond, leeg met OSM, zodat de uitvoer over beide netten naast elkaar staat; WW, W_PT_W en Car hebben een map voor beide (#124).";
		parameter<km_hr>    E_BikingSpeed_kmhr                        := 20[km_hr]              , Descr = "";
		parameter<km_hr>    E_BikingSpeed_actualspeed_addition_kmhr   := 10[km_hr]              , Descr = "";
		parameter<km_hr>    CarSpeed_kmhr                             := 130[km_hr]             , Descr = "Alleen relevant bij OSM";
		parameter<km_hr>    CarSpeed_limit_kmhr                       := 100[km_hr]             , Descr = "Bijvoorbeeld bij 100kmpu op snelwegen overdag. Alleen relevant bij OSM";
		parameter<km_hr>    CarDefaultSpeed                           := 50[km_hr]              , Descr = "";
		parameter<km_hr>    CarDefaultSpeed_low                       := 30[km_hr]              , Descr = "";
		parameter<km_hr>    Ferry_Speed                               := 25[km_hr]              , Descr = "";
		parameter<bool>     InterpretAllRoadsAsBidirectional          := FALSE                  , Descr = "Should car(!) roads be interpreted as bidirectional, or should the OneDirection property be guiding?";//
		parameter<string>   OrgSet_SelectionTag                       := IsOD ? '-' + lowercase(/ModelParameters/OD_Herkomst) : switch(case(lowercase(Orgset) == 'buurt_enkele_buurt', '-' + lowercase(Orgset_EnkeleBuurt_Selection)), case(lowercase(Orgset) == 'buurt_enkele_gemeente' || lowercase(Orgset) == 'gemeente_enkele_gemeente', '-' + lowercase(Orgset_EnkeleGem_Selection)), case(lowercase(Orgset) == 'buurt_enkele_prov', '-' + lowercase(Orgset_EnkeleProv_Selection)), case(lowercase(Orgset) == 'buurt_enkele_corop', '-' + lowercase(Orgset_EnkeleCorop_Selection)), '')
		, Descr = "Het gekozen gebied van een enkele-gebied-herkomstenset in de bestandsnamen, zodat twee selecties geen autostore of uitvoerbestand delen. Bij een HB-paar (IsOD) de herkomst, zodat ook de handtekeningen het paar noemen en WalkingMirror niet geldt.";
		parameter<string>   DestSet_SelectionTag                      := IsOD ? '-' + lowercase(/ModelParameters/OD_Bestemming) : switch(case(lowercase(Destset) == 'buurt_enkele_buurt', '-' + lowercase(Destset_Enkele_Selection)), case(lowercase(Destset) == 'buurt_enkele_prov', '-' + lowercase(Destset_EnkeleProv_Selection)), case(lowercase(Destset) == 'buurt_enkele_corop', '-' + lowercase(Destset_EnkeleCorop_Selection)), '')
		, Descr = "Het gekozen gebied van een enkele-gebied-bestemmingenset in de bestandsnamen; bij een HB-paar (IsOD) de bestemming.";
		parameter<string>   DestSet_DateTag                           := lowercase(Destset) == 'ov_knooppunten' ? '_' + Analysis_date + (GTFS_file_date == Analysis_date ? '' : '_gtfs' + GTFS_file_date) : ''
		, Descr = "Datum van de bestemmingsset in de bestandsnamen, als die uit de dienstregeling volgt: de OV-knooppunten hangen af van de feed en van de vertrekken op Analysis_date, dus een andere datum krijgt een eigen autostore.";
		parameter<string>   DestSet_string_nodate                     := (Dests_geclusterd ? lowercase(Destset) + '_' + lowercase(Dest_location_scale) : lowercase(Destset)) + DestSet_SelectionTag
		, Descr = "De bestemmingsset zonder DestSet_DateTag, in de handtekening van de OV-uitvoer (PT_Output_ParamTag), die Analysis_date al noemt.";
		parameter<string>   PT_CombinationType                        := 'V-' + Direct_str + (MetOV ? (Direct_str != '' ? ',' : '') + asList(OV_PreTransport_Typen/ExportName, ',') + '_N-' + asList(OV_PostTransport_Typen/ExportName, ',') : '')
		, Descr = "De directe modaliteiten en de voor- en natransporttypen zoals ze in de handtekening van de OV-uitvoer staan; zonder OV (Car) alleen de directe modaliteiten.";
		parameter<bool>     UsesCycling                               := AllowDirectCycling || (MetOV && (IsDefined(strpos(Component_Voortransport, 'Cycling')) || IsDefined(strpos(Component_Natransport, 'Cycling'))))
		, Descr = "Doet een fietsbeen of de directe fietsrit mee? Dan noemt de handtekening van de OV-uitvoer het fietsnet (CyclingNetwork_FileTag).";
		parameter<string>   PT_Output_ParamTag                        := '_DEST-' + DestSet_string_nodate + '_' + PT_CombinationType + (MetOV ? '_Trsf-' + string(Max_transfers) : '') + '_MinCrit-' + asList(/Classifications/OutputParetoAttr/FileNameElement, '_') + (MetOV ? '_MaxPT-' + string(/ModelParameters/MaxPTTime) + 'min' + Flex_FileTag + RitOpslag_FileTag : '') + (AllowDirectCar ? ParetoLegs_Car_FileTag : '') + Car_PriceTag + ChainPareto_FileTag + (MetOV && IsDefined(strpos(Component_Natransport, 'OVF')) ? OVFiets_FileTag : '') + (UsesCycling ? CyclingNetwork_FileTag : '')
		, Descr = "De parameters van de OV-uitvoer na datum en herkomstset, voor de handtekening van de uitvoer (NetworkSetup/Output_Signature, #118): bestemmingenset, modaliteiten, criteria en de tags; de OV-tags (overstappen, MaxPT, flex, rit-opslag) alleen als het OV meedoet, de autotags alleen als de directe autorit meedoet (#117).";
		parameter<string>   DestSet_string                            := (Dests_geclusterd 
																			? lowercase(Destset) + '_' + lowercase(Dest_location_scale)
																			: lowercase(Destset)) + DestSet_SelectionTag + DestSet_DateTag, Descr = "De bestemmingsset zoals hij in de bestandsnamen staat, met DestSet_SelectionTag en DestSet_DateTag."; 
		parameter<string>   OrgSet_string                             := (strcount(Orgset, 'Clustered') > 0
													? lowercase(Orgset) + '_' + lowercase(Org_location_scale)
													: lowercase(Orgset)) + OrgSet_SelectionTag
		,	Descr = "De herkomstenset zoals hij in de bestandsnamen staat, met OrgSet_SelectionTag bij een enkel gebied. Bij een geclusterde set hoort de celmaat erbij, anders overschrijft een 500m-run de uitvoer van een 100m-run, net zoals DestSet_string dat voor de bestemmingen doet.";
		parameter<string>   OrgSet_PathTag                            := replace(OrgSet_string, 'buurt', 'b'), Descr = "De herkomstenset in de namen van stores en bestanden, kort voor de padlengte: OrgSet_string met b voor buurt, bijvoorbeeld b2025 voor buurt2025. De handtekeningen houden OrgSet_string.";
		parameter<string>   DestSet_PathTag                           := replace(DestSet_string, 'buurt', 'b'), Descr = "De bestemmingenset in de namen van stores en bestanden: DestSet_string met b voor buurt. De handtekeningen houden DestSet_string.";
		parameter<string>   OrgSet_NameTag                            := UpperCase(substr(OrgSet_PathTag, 0, 1)) + substr(OrgSet_PathTag, 1, strlen(OrgSet_PathTag)), Descr = "De herkomstenset in de naam van een benen-store, met een hoofdletter: Legs_B2025toStops_Walking.";
		parameter<string>   DestSet_NameTag                           := UpperCase(substr(DestSet_PathTag, 0, 1)) + substr(DestSet_PathTag, 1, strlen(DestSet_PathTag)), Descr = "De bestemmingenset in de naam van een benen-store, met een hoofdletter: Legs_Stops2B2025_Walking.";
		
		unit<uint8> OV_PreTransport_Typen := select_with_org_rel(TimeInvariantTypes/name == Component_Voortransport)
		, Descr = "Het voortransporttype van deze run: dat van Component (Componenten/Voortransport, #117). RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? '_'+StopClass : '';
			attribute<string> ExportName  := Mode_abbrev + StopClass_;
		}
		unit<uint8> OV_PostTransport_Typen := select_with_org_rel(TimeInvariantTypes/name == Component_Natransport)
		, Descr = "Het natransporttype van deze run: dat van Component (Componenten/Natransport, #117). RMT=Rail+Metro+Tram, OVF=OV-fiets, Ric=InterCity station."
		{
			attribute<TimeInvariantTypes> TimeInvariantTypes_rel := org_rel;
			attribute<string> name        := TimeInvariantTypes/name[TimeInvariantTypes_rel];
			attribute<string> Mode_abbrev := TimeInvariantTypes/Mode_abbrev[TimeInvariantTypes_rel];
			attribute<min_f>  MaxTime     := TimeInvariantTypes/MaxTime[TimeInvariantTypes_rel];
			attribute<string> StopClass   := TimeInvariantTypes/StopClass[TimeInvariantTypes_rel];
			
			attribute<string> StopClass_  := StopClass != '' ? StopClass+'_' : '';
			attribute<string> ExportName  := StopClass_ + Mode_abbrev;
		}
				
		
		unit<uint8> PT_DepartureHours : nrofrows = 1
		, Descr = "Het uur van de vertrekmomenten: dat van Dagdeel (#125). Meer uren in een run: nrofrows ophogen en de uren als lijst geven, bijvoorbeeld [7, 12, 19]; Car_CongestionMoment_ForDirect volgt dan nog steeds Dagdeel."
		{
			attribute<uint32> values := const(rjoin(/ModelParameters/Dagdeel, Dagdelen/name, Dagdelen/DepartureHour), .);
		}
		unit<uint8> PT_DepartureMinutes_All : nrofrows = 4
		, Descr = "De minuten van de vertrekmomenten in het uur van het dagdeel, per kwartier."
		{
			// attribute<uint32> values : [0]; 
			// attribute<uint32> values : [0,30]; 
			attribute<uint32> values : [0,15,30,45];										   
			// attribute<uint32> values : [0,5,10,15,20,25,30];  //7 stuks
			// attribute<uint32> values : [0,5,10,15,20,25,30,35,40,45,50,55];  //12 stuks
			// attribute<uint32> values : [0,5,10,55];  //4 stuks
		}
		unit<uint8> PT_DepartureMinutes := range(uint8, 0b, EenVertrekmoment || IsODMoment ? 1b : uint8(#PT_DepartureMinutes_All))
		, Descr = "De minuten van de vertrekmomenten van deze run: alle van PT_DepartureMinutes_All, bij EenVertrekmoment alleen die van het congestiemoment (CongestionMinute, #132), en bij een HB-paar met OD_Vertrekmoment alleen dat (OD_Minute, #129), ook voor een component met EenVertrekmoment."
		{
			attribute<uint32> values := IsODMoment ? const(OD_Minute, .) : EenVertrekmoment ? const(CongestionMinute, .) : PT_DepartureMinutes_All/values[value(id(.), PT_DepartureMinutes_All)];
		}
		
		unit<uint8>  AnalysisMomentPresets : nrofrows = 11
		, Descr = "Per peildatum (AnalysisMoment) de bronnen: OSM, CBS-gebiedsindeling, TomTom, BAG-snapshot, de dag van de OV-analyse en de GTFS-feed (#125). Een jaar zonder Analysis_date of GTFS_file_date is geen peildatum en draait niet."
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// name, OSM date , Regios, OSM_perProv, CarCongestionSpeed_date_TomTom, BAG_snapshot, Analysis_date, GTFS_file_date, OVFiets_year
				[
				'Y2012','20221201', '2012', 'TRUE',  'yr2021_12', '20120101',     '',         '', '2023',      //20140101
				'Y2013','20140101', '2022', 'FALSE', 'yr2021_12', '20130101',     '',         '', '2023',
				'Y2015','20240524', '2023', 'TRUE',  'yr2021_12', '20230101', '20151013', '', '2023',
				'Y2018','20190101', '2020', 'FALSE', 'yxx2021_12','20180101',     '',         '', '2023',
				'Y2020','20200117', '2020', 'FALSE', 'yr2021_12', '20200101',     '',         '', '2023',
				'Y2021','20211221', '2021', 'TRUE',  'yr2021_12', '20210101',     '',         '', '2023',
				'Y2022','20221201', '2022', 'TRUE',  'yr2022_12', '20220101',     '',         '', '2023',
				'Y2023','20240524', '2023', 'TRUE',  'yr2023_12', '20230101', '20231010', '20231003', '2023',
				'Y2024','20240524', '2023', 'TRUE',  'yr2024_12', '20230101', '20241008', '20241001', '2023',
				'Y2025','20260601', '2025', 'TRUE',  'yr2025_12', '20250101', '20251014', '20250930', '2025',
				'Y2026','20260601', '2025', 'TRUE',  'yr2025_12', '20250101', '20261013', '20260925', '2025'
				];
				// PEILDATA (#125): de tweede dinsdag van oktober. De feed van een peildatum dekt de dienstdagen D-1 tot D+1
				// (LoadFeeds/ServiceDays, MinServiceDayTripShare). Y2015 heeft nog geen feed en draait niet.
				// OSM: Y2015 tot en met Y2024 rekenen met de uitsnede 20240524, Y2025 en Y2026 met 20260601.
				// TomTom: de editie van december van het jaar: yr2023_12, yr2024_12 en yr2025_12; Y2026 voorlopig yr2025_12 en
				// Y2015 yr2021_12 (er is geen oudere). CarCongestionSpeed_date is de map %NetworkModel_PrivDir%/TomTom/<naam>/ met de
				// vier stores Roads, Junctions, Speednetworks en Speedprofiles.mmd, en het ruwe materiaal (multinet/, speedprofiles/)
				// om ze te maken (TomTom/Impl/HasRawMaterial; zonder ruw materiaal zet TomTom/Impl/FromFss een oude fss om).
				// Regios en BAG_snapshot: die van de buurtvariant van de peildatum (Advanced/Buurtsets, #126), CBS 2023 en BAG
				// 1-1-2023 voor 2015, 2023 en 2024, CBS 2025 en BAG 1-1-2025 voor 2025 en 2026; ook de BAG-herkomsten rekenen zo.
				// BAG_snapshot is de mapnaam onder %NetworkModel_Dir%/RegioIndelingen/BAG. Regios blijft voor Y2026 op 2025 tot CBS de
				// buurt- en wijkkaart 2026 publiceert: daarop staan de herkomstensets en de regio-aggregaties.
			}
			
			attribute<string>        name                    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string>        OSM_file_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
			attribute<string>        RegioIndelingen_year    := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			attribute<bool>          OSM_NL_prov             := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)][bool];
			attribute<string>        CarCongestionSpeed_date := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)];
			attribute<string>        BAG_snapshot            := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)];
			attribute<string>        Analysis_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 6, Elements)], Descr = "De peildatum (yyyymmdd, #125); leeg = geen peildatum.";
			attribute<string>        OVFiets_year            := Elements/Text[value(UInt32(ID(.))* nrAttr + 8, Elements)], Descr = "Het jaar van de OV-fietslocaties (Advanced/OVFiets_Locaties): 2025 voor de peildata 2025 en 2026, anders 2023.";
			attribute<string>        GTFS_file_date          := Elements/Text[value(UInt32(ID(.))* nrAttr + 7, Elements)], Descr = "De GTFS-feed van de peildatum (yyyymmdd, #125); leeg = (nog) geen feed.";

			parameter<uint32> nrAttr := 9;
		}

		unit<uint8> Dagdelen : nrofrows = 3
		, Descr = "De dagdelen van een peildatum (#125), te kiezen met /ModelParameters/Dagdeel: vier vertrekmomenten per kwartier vanaf DepartureHour (PT_DepartureMinutes), en het congestiemoment van de directe autorit (CongestionTimes), in het midden van dat uur."
		{
			attribute<string> name             : ['Ochtendspits', 'Middag', 'Avond'];
			attribute<uint32> DepartureHour    : [7, 12, 19];
			attribute<string> CongestionMoment : ['MorningRush', 'NoonRush', 'LateEveningRush'];
		}
	
		unit<uint32> org_domain_list : nrofrows = 23 // Hier worden de paden voor elke org set opgegeven. En wanneer er nieuwe bij komen dat hier ook toegevoegd worden.
