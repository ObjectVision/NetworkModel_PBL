// The syntax of this configuration (items, units, expressions and operators) is described on the GeoDMS wiki: https://github.com/ObjectVision/GeoDMS/wiki
container ModelParameters : using = "units;classifications"
{
	// THE SETTINGS OF A RUN: what a run calculates and the assumptions PBL may vary. Agreed and technical choices and most tables are in Advanced,
	// what follows from the settings is in Impl. Each group of assumptions says whether it only changes the output, or also the caches in
	// %LocalDataProjDir%/IntermediateResults, which the model then makes again.

	// 1. WHAT: analysis moment and day, part of the day, origins and destinations, and the output. batch/UpdateAll.cmd checks these
	// choices first (ChecksBeforeRunning in main.dms) and stops with a message that says what to change.
	parameter<string>   AnalysisMoment                        := 'Y2025'                 , Descr = "The analysis moment, a year in AnalysisMomentPresets in group 7 with an analysis day and a GTFS feed (Y2015 and Y2023 to Y2026), which sets the analysis day, the GTFS feed, OSM, TomTom, the CBS area division and the BAG (#125).";
	parameter<string>   AnalysisDay                           := ''                      , Descr = "The day of the public transport analysis as yyyymmdd, or empty for the analysis day of AnalysisMoment, the second Tuesday of October; the GTFS feed of AnalysisMoment must cover it (ChecksBeforeRunning/Check_GTFS).";
	parameter<string>   PartOfDay                             := 'Ochtendspits'          , Descr = "The part of the day of the departure moments, from PartsOfDay in group 8: 'Ochtendspits', 'Middag' or 'Avond', each with four moments a quarter of an hour apart (#125).";
	parameter<string>   Orgset                                := 'Buurt2025'             , Descr = "The origin set, one of Advanced/org_domain_list.";
	parameter<string>   Destset                               := 'Buurt2025'             , Descr = "The destination set, one of Advanced/dest_domain_list.";
	parameter<string>   Orgset_SingleNeighbourhood_Selection  := 'BU0363AD05'            , Descr = "The neighbourhood code (BU_CODE) when Orgset is a single neighbourhood.";
	parameter<string>   Orgset_SingleMunicipality_Selection   := 'Dronten'               , Descr = "The municipality name when Orgset is a single municipality.";
	parameter<string>   Orgset_SingleProvince_Selection       := 'Zuid_Holland'          , Descr = "The province name when Orgset is a single province.";
	parameter<string>   Orgset_SingleCorop_Selection          := 'Kop_van_Noord_Holland' , Descr = "The COROP name when Orgset is a single COROP area.";
	parameter<string>   Destset_SingleNeighbourhood_Selection := 'BU0363ET02'            , Descr = "The neighbourhood code (BU_CODE) when Destset is a single neighbourhood.";
	parameter<string>   Destset_SingleCorop_Selection         := 'Twente'                , Descr = "The COROP name when Destset is a single COROP area.";
	parameter<string>   Destset_SingleProvince_Selection      := 'Zuid_Holland'          , Descr = "The province name when Destset is a single province.";
	parameter<string>   OutputLabel                           := 'b2025'                 , Descr = "Name of the variant in the output folder Output/<analysis date>_<OutputLabel>_<component>_<hash>, at most 20 characters. The analysis date gives the year; the label gives the zone set and a part of the day other than the morning rush: b2025, b2025_middag, b2025_avond (#118).", IntegrityCheck = "strlen(this) >= 1 && strlen(this) <= 20 && strcount(this, ' ') == 0 && strcount(this, '/') == 0 && strcount(this, ':') == 0 && strcount(this, '.') == 0";
	parameter<string>   OutputFormat                          := 'parquet'               , Descr = "Format of the output per origin block and departure moment: 'parquet', typed and with only the columns that vary within the component, or 'csv' with all columns.", IntegrityCheck = "OutputFormat == 'csv' || OutputFormat == 'parquet'";
	parameter<bool>     Export_TravelledDistance              := TRUE                    , Descr = "Does the output include the travelled distance?";
	parameter<bool>     Export_PriceInformation               := TRUE                    , Descr = "Does the output include the price, split into pre-transport, public transport and post-transport and per mode?";
	parameter<string>   MinimiseCriteria                      := 'Price,Time'            , Descr = "Criteria of the front of a component: 'Price', 'Price_Augm', 'Time' or a combination such as 'Price,Time' (#117); part of the signature of the chain cache, so another value makes that cache again.";

	// 2. THE VARIANT (#117): the pre- and post-transport types and the direct trips that take part. Every pre-transport type that is on,
	// combined with every post-transport type that is on, is a public transport component <pre>_PT_<post>, such as W_PT_W or C_PT_ovfC;
	// with the direct trips that are on they are the components of the variant (Classifications/Components/Selected). batch/UpdateAll.cmd
	// calculates the components one after the other, each in its own GeoDmsRun steps and output folder, skips a component whose output is
	// complete, and then merges them.
	container PreTransport
	: Descr = "The pre-transport types of the variant, one switch per row of Classifications/PreTransportTypes."
	{
		parameter<bool> Org2Stops_Walking      := TRUE , Descr = "W: walking to every stop.";
		parameter<bool> Org2Stops_Cycling      := TRUE , Descr = "C: cycling to every stop.";
		parameter<bool> Org2RM_Stops_Cycling   := FALSE, Descr = "Crm: cycling to a rail or metro stop.";
		parameter<bool> Org2RMT_Stops_Cycling  := FALSE, Descr = "Crmt: cycling to a rail, metro or tram stop.";
		parameter<bool> Org2Ric_Stops_Cycling  := FALSE, Descr = "Cric: cycling to an intercity station.";
		parameter<bool> Org2R_Stops_Cycling    := FALSE, Descr = "Cr: cycling to a train station, also one served only by a regional or foreign rail operator; not to a light rail, metro or tram stop (#147).";
		parameter<bool> Org2N_Stops_Cycling    := FALSE, Descr = "Cn: cycling to a train station where NS trains stop (#147).";
	}
	container PostTransport
	: Descr = "The post-transport types of the variant, one switch per row of Classifications/PostTransportTypes; only ovfC rents a bike, the other cycling types use an own bike at the last stop."
	{
		parameter<bool> Stops2Dest_Walking     := TRUE , Descr = "W: walking.";
		parameter<bool> Stops2Dest_Cycling     := TRUE , Descr = "C: cycling from every stop.";
		parameter<bool> RM_Stops2Dest_Cycling  := FALSE, Descr = "rmC: cycling from a rail or metro stop.";
		parameter<bool> RMT_Stops2Dest_Cycling := FALSE, Descr = "rmtC: cycling from a rail, metro or tram stop.";
		parameter<bool> OVF_Stops2Dest_Cycling := TRUE , Descr = "ovfC: the OV-fiets, only from a stop at an OV-fiets location.";
	}
	parameter<bool>     DirectWalking                         := TRUE                    , Descr = "Is the direct walking trip (WW) a component of the variant?";
	parameter<bool>     DirectCycling                         := TRUE                    , Descr = "Is the direct cycling trip (CC) a component of the variant?";
	parameter<bool>     DirectCar                             := TRUE                    , Descr = "Is the direct car trip (Car) a component of the variant?";
	parameter<string>   GuiComponent                          := 'W_PT_W'                , Descr = "Only for GeoDmsGui: the component that the GUI shows, a name from Classifications/Components or 'Merged' for the merge of the variant; batch/UpdateAll.cmd chooses the component of each step itself (ConfigSettings/Overridable/RunComponent).";

	// 3. MERGING the components of the variant into one front (NetworkSetup/ComponentMerge), after the components
	parameter<bool>     Merge                                 := TRUE                    , Descr = "Does batch/UpdateAll.cmd merge the components of the variant into one Pareto front on MergeCriteria after calculating them (#117)?";
	parameter<string>   MergeCriteria                         := 'Price,Time,Car,Bike'   , Descr = "Criteria of the merged front, a subset of Price or Price_Augm, Time, Car (needs a car) and Bike (needs a bike), separated by commas; without Car and Bike an option with a car or bike can push out one without.";
	parameter<uint32>   MergeRunNr                            := 1                       , Descr = "Number of the merge in the name of its output folder (_Merged<MergeRunNr>_<hash>); the hash of its signature already gives a merge with other criteria or components a folder of its own, so the number only labels it.";

	// 4. ASSUMPTIONS THAT ONLY CHANGE THE OUTPUT; the caches stay valid, and the output of the components that use them gets another signature
	// and so a folder of its own (#145)
	parameter<min_f>    MaxTravelTime                         := 90[min_f]               , Descr = "Maximum travel time of the whole public transport journey.";
	parameter<min_f>    MaxWalkingTime_Org2Dest               := 90[min_f]               , Descr = "Maximum time of the direct walking trip.";
	parameter<min_f>    MaxCyclingTime_Org2Dest               := 90[min_f]               , Descr = "Maximum time of the direct cycling trip.";
	parameter<euro_min> PreTransport_Walking_Time_Costs       := 0.19[euro_min]          , Descr = "Cost per minute of walking in the pre-transport, so that the cheapest journey does not simply walk as far as possible.";
	parameter<euro_min> PostTransport_Walking_Time_Costs      := 0.19[euro_min]          , Descr = "Cost per minute of walking in the post-transport, so that the cheapest journey does not simply walk as far as possible.";
	parameter<euro_min> Direct_Walking_Time_Costs             := 0.19[euro_min]          , Descr = "Cost per minute of the direct walking trip.";
	// AN E-BIKE is a variant of the cycling parameters, not a mode of its own: a higher CyclingSpeed_kmhr and another Cycling_CostPerKm.
	// The speed is in the signature of the cycling legs and of the output of every component with a cycling leg or trip
	// (Impl/CyclingNetwork_Tag), and the price per minute that follows from both is in the signature of that output (SettingsTag,
	// TimeInvariantTypes/OutputSignatureTag). With the same OutputLabel, a run with e-bike values therefore writes CC and the public
	// transport components with cycling to output folders of their own, with another hash, beside those of the ordinary bike, and reuses
	// the output of WW, Car and the components that only walk, and the chain cache. A merge reads the folders that match its own settings,
	// so merges with and without the e-bike can be made one after the other without calculating anything again. To calculate with an e-bike,
	// put the e-bike value from the comment beside CyclingSpeed_kmhr and Cycling_CostPerKm in their place; to go back, put the value for the
	// ordinary bike from the same comment back. The junction penalties of cycling (Advanced/Junction_Penalties) apply to an e-bike too.
	parameter<euro_km>  Cycling_CostPerKm                     := 0.09[euro_km]           , Descr = "Cost per km of cycling on an own bike, in the direct cycling trip and the cycling pre- and post-transport, as an amount per minute at CyclingSpeed_kmhr."; // ordinary bike 0.09[euro_km]; the model has no e-bike value of its own, choose one
	parameter<euro_min> Direct_Cycling_Time_Costs             := Cycling_CostPerKm * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "Cost per minute of the direct cycling trip: Cycling_CostPerKm at CyclingSpeed_kmhr.";
	parameter<euro_min> PreTransport_Cycling_Time_Costs       := Cycling_CostPerKm * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "Cost per minute of cycling in the pre-transport: Cycling_CostPerKm at CyclingSpeed_kmhr.";
	parameter<euro_min> PostTransport_Cycling_Time_Costs      := Cycling_CostPerKm * /ModelParameters/CyclingSpeed_kmhr * 1[hr_f] / 60[min_f], Descr = "Cost per minute of cycling on an own bike in the post-transport: Cycling_CostPerKm at CyclingSpeed_kmhr; the OV-fiets costs OVFiets_RentalPrice instead.";
	parameter<euro>     OVFiets_RentalPrice                   := 4.45[euro]              , Descr = "Rent of an OV-fiets for the first 24 hours; it is paid, so it always counts in Price, also with Advanced/IncludeCyclingCostsInPrice off (#108).", Source = "NS, OV-fiets tariff 2023";
	parameter<Euro_km>  Car_CostPerKm                         := 0.24[Euro_km]           , Descr = "Cost of the direct car trip per km; because the cost follows from the distance, the car front on travel time and distance is also the front on travel time and cost (#88).";
	parameter<Euro>     Car_FixedCosts_PerTrip                := 0[Euro]                 , Descr = "Fixed cost per car trip, for example for parking.";
	parameter<min_f>    Car_StartTime                         := 2[min_f]                , Descr = "Time to walk to the car and drive off, added to the travel time of the direct car trip.";
	parameter<min_f>    Car_ParkingTime                       := 3[min_f]                , Descr = "Time to find a parking place and walk to the destination, added to the travel time of the direct car trip.";

	// 5. ASSUMPTIONS THAT MAKE CACHES AGAIN: they are in the signature of a cache, so a cache made with other values is not read but made again.
	// The pre- and post-transport caches (batch/UpdateAll.cmd legs, or the output step):
	parameter<min_f>    MaxWalkingTime_Org2Stops              := 15[min_f]               , Descr = "Maximum walking time from the origin to the first stop.";
	parameter<min_f>    MaxWalkingTime_Stops2Dest             := 15[min_f]               , Descr = "Maximum walking time from the last stop to the destination.";
	parameter<min_f>    MaxCyclingTime_Org2Stops              := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first stop.";
	parameter<min_f>    MaxCyclingTime_Org2RMT_Stops          := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first rail, metro or tram stop.";
	parameter<min_f>    MaxCyclingTime_Org2RM_Stops           := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first rail or metro stop.";
	parameter<min_f>    MaxCyclingTime_Org2Ric_Stops          := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first intercity station.";
	parameter<min_f>    MaxCyclingTime_Org2R_Stops            := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first train station.";
	parameter<min_f>    MaxCyclingTime_Org2N_Stops            := 15[min_f]               , Descr = "Maximum cycling time from the origin to the first train station served by NS.";
	parameter<min_f>    MaxCyclingTime_Stops2Dest             := 15[min_f]               , Descr = "Maximum cycling time from the last stop to the destination.";
	parameter<min_f>    MaxCyclingTime_OVF_Stops2Dest         := 15[min_f]               , Descr = "Maximum cycling time from the last stop, at an OV-fiets location, to the destination.";
	parameter<min_f>    MaxCyclingTime_RMT_Stops2Dest         := 15[min_f]               , Descr = "Maximum cycling time from the last rail, metro or tram stop to the destination.";
	parameter<min_f>    MaxCyclingTime_RM_Stops2Dest          := 15[min_f]               , Descr = "Maximum cycling time from the last rail or metro stop to the destination.";
	parameter<km_hr>    WalkingSpeed_kmhr                     := 4.5[km_hr]              , Descr = "Walking speed on the network.";
	parameter<km_hr>    CyclingSpeed_kmhr                     := 14[km_hr]               , Descr = "Cycling speed on the network."; // ordinary bike 14[km_hr], e-bike 20[km_hr] (see the comment at Cycling_CostPerKm)

	// The chain cache (batch/UpdateAll.cmd chains). The maximum pre-transport times above and the start and parking time of the bike count here
	// too: the largest maximum time over the pre-transport types of the variant sets the longest pre-transport (Impl/PT_Chains_Max_V_Time) and
	// with it the last boarding moment of the chains, which all public transport components of the variant share:
	parameter<min_f>    Cycling_StartTime                     := 1[min_f]                , Descr = "Time to take the bike and ride off, added to every direct cycling trip and every cycling leg.";
	parameter<min_f>    Cycling_ParkingTime_IC_Station        := 3[min_f]                , Descr = "Extra parking time for a cycling pre-transport leg that ends at an intercity station, on top of Advanced/Cycling_PreTransport_Penalty (#117).";
	parameter<min_f>    MaxPTTime                             := 90[min_f]               , Descr = "Maximum travel time in public transport, including transfers and waiting.";
	parameter<uint16>   Max_transfers                         := 3w                      , Descr = "Maximum number of transfers.", IntegrityCheck = "this >= 1w && this <= 4w";
	parameter<euro_min> Transfer_Walking_Time_Costs           := 0.19[euro_min]          , Descr = "Cost per minute of walking during a transfer.";
	parameter<euro_min> Transfer_Waiting_Time_Costs           := 0.05[euro_min]          , Descr = "Cost per minute of waiting.";
	
	// The car caches (batch/UpdateAll.cmd cars):
	parameter<min_f>    MaxCarTime                            := 90[min_f]               , Descr = "Maximum travel time of the direct car trip.";
	parameter<bool>     UseTomTomNetworkForCars               := TRUE                    , Descr = "Does the car use the TomTom network with its congested speeds, or else the OSM network?";
	parameter<string>   CongestionSpeed_DaySelection          := 'tuesday'               , Descr = "Day or group of days of the TomTom congested speeds: 'Weekday', 'Weekend', 'Week' or a day such as 'tuesday'; the analysis day must fall on it (LoadFeeds/Check_WeekdayMatchesCongestionDay).";

	// 6. ONE OD PAIR (#129): with OD_Origin and OD_Destination the whole model calculates only that pair, with the same steps, and keeps the
	// links of the route of every option. Its caches go to IntermediateResults_<O>_<D>, its output to Output_<O>_<D>, and /Output/OD_PairRoutes
	// shows them on a map, in a table and in a chart. Empty: the whole model, without links.
	parameter<string>   OD_Origin                             := ''                      , Descr = "The origin of the OD pair, a name from Orgset such as the CBS neighbourhood code 'BU04020501'; empty for all origins.";
	parameter<string>   OD_Destination                        := ''                      , Descr = "The destination of the OD pair, a name from Destset such as 'BU0363KP03'; empty for all destinations.";
	parameter<string>   OD_DepartureTime                      := ''                      , Descr = "With an OD pair, one departure moment of PartOfDay as hh:mm, for example '07:30'; empty for all moments of the part of the day.", IntegrityCheck = "this == '' || (strlen(this) == 5 && substr(this, 2, 1) == ':')";
	parameter<uint32>   OD_Option                             := 0                       , Descr = "The option that the map of /Output/OD_PairRoutes shows separately, numbered from 1; 0 for all options.";

	// 7. THE SOURCES: which delivery of each source the model reads. AnalysisMomentPresets gives a row per year that AnalysisMoment can
	// choose (#125), and below it are the deliveries that every analysis moment uses. The analysis day is the second Tuesday of October; the
	// feed of an analysis moment covers the service days D-1 to D+1 (LoadFeeds/ServiceDays, MinServiceDayTripShare). OSM: Y2012 to Y2015 use
	// the extract of 20140101, Y2023 and Y2024 that of 20240524, Y2025 that of 20250101 and Y2026 that of 20260601, the other years one of their
	// own. TomTom: the December edition of the year; Y2026 uses yr2025_12 for now and the years up to Y2021 yr2021_12, the oldest.
	// CarCongestionSpeed_date is the folder %NetworkModel_PrivDir%/TomTom/<name> with the four caches Roads, Junctions, Speednetworks and
	// Speedprofiles, licensed source data that SourceData/TomTom/Impl makes from the MultiNet delivery. Regios is the year of the CBS map of
	// the region sets without a year of their own (Buurt, Wijk, Gemeente, COROP, Provincie); their centroids are weighted with the BAG of
	// 1 January of that year. Regios stays at 2025 for Y2026 until CBS publishes the neighbourhood map of 2026. BAG_date is the date of
	// the BAG for the origin sets that read the BAG directly (PC4, PC6, BAG_woonpanden), selected from the delivery BAG_file_date below.
	unit<uint8>  AnalysisMomentPresets : nrofrows = 12
	, Descr = "Per analysis moment the sources: OSM, CBS area division, TomTom, the date of the BAG, the analysis day and the GTFS feed (#125); a year without analysis day or feed does not run."
	{
		unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text:
			// name, OSM date , Regios, TomTom-Cong,   BAG_date, AnalysisDate,  GTFS_date,OVF_year, OSM_pProv,
			[
			'Y2012','20140101', '2012', 'yr2021_12', '20120101',           '',         '',  '2023',    'TRUE',
			'Y2013','20140101', '2013', 'yr2021_12', '20130101',           '',         '',  '2023',   'FALSE',
			'Y2014','20140101', '2014', 'yr2021_12', '20140101',           '',         '',  '2023',   'FALSE',
			'Y2015','20140101', '2015', 'yr2021_12', '20150101',   '20151013', '20151007',  '2023',    'TRUE',
			'Y2018','20190101', '2018', 'yr2021_12', '20180101',           '',         '',  '2023',   'FALSE',
			'Y2020','20200117', '2020', 'yr2021_12', '20200101',           '',         '',  '2023',   'FALSE',
			'Y2021','20211221', '2021', 'yr2021_12', '20210101',           '',         '',  '2023',    'TRUE',
			'Y2022','20221201', '2022', 'yr2022_12', '20220101',           '',         '',  '2023',    'TRUE',
			'Y2023','20240524', '2023', 'yr2023_12', '20230101',   '20231010', '20231003',  '2023',    'TRUE',
			'Y2024','20240524', '2024', 'yr2024_12', '20240101',   '20241008', '20241001',  '2023',    'TRUE',
			'Y2025','20250101', '2025', 'yr2025_12', '20250101',   '20251014', '20250930',  '2025',    'TRUE',
			'Y2026','20260601', '2025', 'yr2025_12', '20260101',   '20261013', '20260925',  '2025',    'TRUE'
			];
		}

		attribute<string> name                    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
		attribute<string> OSM_file_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
		attribute<string> RegioIndelingen_year    := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
		attribute<string> CarCongestionSpeed_date := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)];
		attribute<string> BAG_date                := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)], Descr = "The date of the BAG (yyyymmdd) for the origin sets that read the BAG directly (#142).";
		attribute<string> Analysis_date           := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)], Descr = "The analysis day (yyyymmdd, #125); empty for no analysis day.";
		attribute<string> GTFS_file_date          := Elements/Text[value(UInt32(ID(.))* nrAttr + 6, Elements)], Descr = "The GTFS feed of the analysis moment (yyyymmdd, #125); empty for no feed yet.";
		attribute<string> OVFiets_year            := Elements/Text[value(UInt32(ID(.))* nrAttr + 7, Elements)], Descr = "The year of the OV-fiets locations (OVFiets_Locations).";
		attribute<bool>   OSM_NL_prov             := Elements/Text[value(UInt32(ID(.))* nrAttr + 8, Elements)][bool];

		parameter<uint32> nrAttr                  := 9;
	}
	
	// The deliveries that every analysis moment uses:
	parameter<string>   IFF_file_date                         := '20261013'              , Descr = "The delivery of the NS IFF timetable, used for all analysis moments (%NetworkModel_Dir%/Infrastructuur/IFF/<date>/stations.csv).";
	parameter<string>   Fietsersbond_file_date                := '20250525'              , Descr = "The delivery of the Fietsersbond route network, used for all analysis moments (%NetworkModel_Dir%/Infrastructuur/Fietsersbond_<date>).";
	parameter<string>   BAG_file_date                         := '20261008'              , Descr = "The delivery of the BAG, the date of the extract: SourceData/BAG_T reads the stores that BAG-Tools makes from it and selects from them the BAG on a date (#142).";
	parameter<string>   NDW_year                              := '2023'                  , Descr = "The year of the NDW traffic counts (%NetworkModel_dir%/Infrastructuur/NDW/Jaargemiddelden).";
	
	unit<uint8> OVFiets_Locations : nrofrows = 2
	, Descr = "The files with the OV-fiets locations in %NetworkModel_dir%/Infrastructuur, per year in AnalysisMomentPresets/OVFiets_year.", Source = "2023: 283 locations, geocoded by Object Vision; 2025: list of PBL of 13-10-2026, 293 locations, geocoded with batch/OVFiets2025_Geocode.dms"
	{
		attribute<string> year : ['2023', '2025'];
		attribute<string> file : ['20260408_Locaties.OVF_2023_Geocoded.csv', '20261013_Locaties.OVF_2025_Geocoded.csv'];
	}

	// 8. DEPARTURE MOMENTS (#125): PartOfDay chooses a row of PartsOfDay. The public transport trips leave at the minutes of
	// PT_DepartureMinutes_All in DepartureHour; the direct car trip and the TomTom speeds use the congestion moment at CongestionMinute
	// of that hour, with the speed cap Car_MaxSpeed. What follows from them for a run, such as CongestionTimes, is in Impl.
	unit<uint8> PartsOfDay : nrofrows = 3
	, Descr = "The parts of the day (#125), chosen with PartOfDay: the hour of the departure moments, and the congestion moment of the direct car trip with its minute in that hour and its cap on the car speed."
	{
		attribute<string> name             : ['Ochtendspits', 'Middag', 'Avond'];
		attribute<uint32> DepartureHour    : [7, 12, 19];
		attribute<string> CongestionMoment : ['MorningRush', 'NoonRush', 'LateEveningRush'], Descr = "The name of the TomTom congestion moment.";
		attribute<uint32> CongestionMinute : [30, 30, 30], Descr = "The minute of the congestion moment in DepartureHour, on a time slot of 5 minutes of the TomTom speed profiles (0, 5, ..., 55).";
		attribute<km_hr>  Car_MaxSpeed     : [100, 100, 0], Descr = "Cap on the car speed at the congestion moment, for TomTom and OSM; 0 for no cap.";
		attribute<bool>   NS_OffPeak       : [FALSE, TRUE, TRUE], Descr = "Do the departure moments fall in the off-peak hours of NS, on weekdays outside 6:30 to 9:00 and 16:00 to 18:30? Only then does Advanced/NS_TariffChoice apply; in the peak hours the model uses the full fare (Impl/NS_FareClass, #119).", Source = "NS, the conditions of Dal Voordeel: 40% discount on weekdays before 6:30, between 9:00 and 16:00 and after 18:30, by the moment of check-in.";
	}
	unit<uint8> PT_DepartureMinutes_All : nrofrows = 4
	, Descr = "The minutes of the departure moments in DepartureHour of the part of the day, every quarter of an hour."
	{
		attribute<uint32> values : [0,15,30,45];
	}

	container Advanced : using = "classifications"
	,	Descr = "Choices agreed with PBL and technical choices that a run normally leaves as they are, in seven groups by subject, and the tables PBL may extend: the origin and destination sets; the components are in Classifications and the parts of the day in ModelParameters."
	{
		// 1. ORIGINS AND DESTINATIONS: the sets that ModelParameters/Orgset and Destset choose from, and how their points are made.
		unit<uint32> org_domain_list : nrofrows = 23
		, Descr = "The origin sets that can be chosen as Orgset, with the path of each; a new set gets a row here."
		{
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				'Buurt'                               ,'SourceData/RegioIndelingen/Buurt/Centroids',
				'Buurt2023'                           ,'SourceData/RegioIndelingen/Divisions/Y2023/Buurt/Centroids', // #126: CBS 2023 and BAG 1-1-2023, whatever the analysis moment
				'Buurt2025'                           ,'SourceData/RegioIndelingen/Divisions/Y2025/Buurt/Centroids', // #126: CBS 2025 and BAG 1-1-2025
				'Buurt_perProvincie'                  ,'SourceData/RegioIndelingen/Buurt/Per_Prov/@REGIO@/sub',
				'Buurt_perCOROP'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROP/@REGIO@/sub',
				'Buurt_perCOROPp'                      ,'SourceData/RegioIndelingen/Buurt/Per_COROPp/@REGIO@/sub',
				'Buurt_enkele_buurt'                  ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt',
				'Buurt_enkele_Gemeente'               ,'SourceData/RegioIndelingen/Buurt/Enkele_Gemeente',
				'Buurt_enkele_Prov'                   ,'SourceData/RegioIndelingen/buurt/Enkele_Prov',
				'Buurt_enkele_Corop'                  ,'SourceData/RegioIndelingen/buurt/Enkele_Corop',
			
				'Wijk'                                ,'SourceData/RegioIndelingen/Wijk/Centroids',
				'Wijk_perProvincie'                   ,'SourceData/RegioIndelingen/Wijk/Per_Prov/@REGIO@/sub',
				'Wijk_perCOROP'                       ,'SourceData/RegioIndelingen/Wijk/Per_COROP/@REGIO@/sub',
			
				'Gemeente'                            ,'SourceData/RegioIndelingen/Gemeente/Centroids',
				'Gemeente_perProvincie'               ,'SourceData/RegioIndelingen/Gemeente/Per_Prov/@REGIO@/sub',
				'Gemeente_perCOROP'                   ,'SourceData/RegioIndelingen/Gemeente/Per_COROP/@REGIO@/sub',
				'Gemeente_enkele_gemeente'            ,'SourceData/RegioIndelingen/Gemeente/Enkele_gemeente',
			
				'PC4'                                 ,'SourceData/BAG/Adressen/Residential_Stock/PC4_centroids',
				'PC4_perCOROP'                        ,'SourceData/BAG/Adressen/Residential_Stock/PC4_centroids/Per_COROP/@REGIO@/sub',
			
				'PC6'                                 ,'SourceData/BAG/Adressen/Residential_Stock/PC6_centroids',
				'PC6_sub'                             ,'SourceData/BAG/Adressen/Residential_Stock/PC6_centroids/sub',
			
				'BAG_woonpanden'                      ,'SourceData/BAG/Panden/pand/pand_residential_vbo',
				'BAG_woonpanden_Clustered'            ,'SourceData/BAG/Panden/pand/pand_residential_vbo/HasPanden'
				]; 
			}
		
			attribute<uint32> id     := id(.);
			attribute<string> label  := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string> path   := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], DialogType = "LabelText";
		
			parameter<uint32> nrAttr := 2;
		}
		unit<uint32> dest_domain_list : nrofrows = 8
		, Descr = "The destination sets that can be chosen as Destset, with the path of each; a new set gets a row here."
		{ 
			unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
			{
				attribute<String> Text:
				// Label, Path
				[
				 'Buurt'                                                          ,'SourceData/RegioIndelingen/Buurt/Centroids'
				,'Buurt2023'                                                      ,'SourceData/RegioIndelingen/Divisions/Y2023/Buurt/Centroids'
				,'Buurt2025'                                                      ,'SourceData/RegioIndelingen/Divisions/Y2025/Buurt/Centroids'
				,'Buurt_enkele_Buurt'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_buurt_Dest'
				,'Buurt_enkele_Prov'                                              ,'SourceData/RegioIndelingen/Buurt/Enkele_Prov_dest'
				,'Buurt_enkele_Corop'                                             ,'SourceData/RegioIndelingen/Buurt/Enkele_Corop_dest'

				,'Wijk'                                                           ,'SourceData/RegioIndelingen/Wijk/Centroids'
			
				,'OV_Knooppunten'                                                 ,'SourceData/Infrastructure/GTFS/PT_Hubs/Export_Knooppunten'
				];  
			}
		
			attribute<uint32> id     := id(.);
			attribute<string> label  := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
			attribute<string> path   := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], DialogType = "LabelText";
		
			parameter<uint32> nrAttr := 2;
		}
		parameter<bool>     ExcludeOrgNeighbourhoodCentroidsWithoutAddressPop := FALSE, Descr = "Leave out the neighbourhoods without residential addresses in the BAG, which have no weighted centroid?";
		parameter<bool>     Dests_clustered                         := FALSE               , Descr = "Cluster the destinations on a grid of Dest_location_scale, for example for many firms at one location?";
		parameter<string>   Dest_location_scale                     := '100m'              , Descr = "Cell size of the destination clustering: '100m', '500m', '1000m', '5000m', '10000m' or '50000m'.";
		parameter<string>   Org_location_scale                      := '500m'              , Descr = "Cell size of the clustering of BAG origins (BAG_woonpanden_Clustered), one of the cell sizes in Geography/Gridsizes.";

		// 2. COMPONENTS (#117): the components, their pre- and post-transport types and the direct modes are in Classifications
		// (Classifications/Components). Every component optimises on MinimiseCriteria; an e-bike is set with the cycling parameters.
		// The maximum walking times of pre- and post-transport types that no component uses (to or from a rail, metro, tram, intercity, train,
		// NS or OV-fiets stop); Classifications/TimeInvariantTypes asks for them, so they equal those to and from every stop.
		parameter<min_f>    MaxWalkingTime_Org2RMT_Stops            := /ModelParameters/MaxWalkingTime_Org2Stops, Descr = "Maximum walking time from the origin to the first rail, metro or tram stop.";
		parameter<min_f>    MaxWalkingTime_Org2RM_Stops             := /ModelParameters/MaxWalkingTime_Org2Stops, Descr = "Maximum walking time from the origin to the first rail or metro stop.";
		parameter<min_f>    MaxWalkingTime_Org2Ric_Stops            := /ModelParameters/MaxWalkingTime_Org2Stops, Descr = "Maximum walking time from the origin to the first intercity station.";
		parameter<min_f>    MaxWalkingTime_Org2R_Stops              := /ModelParameters/MaxWalkingTime_Org2Stops, Descr = "Maximum walking time from the origin to the first train station.";
		parameter<min_f>    MaxWalkingTime_Org2N_Stops              := /ModelParameters/MaxWalkingTime_Org2Stops, Descr = "Maximum walking time from the origin to the first train station served by NS.";
		parameter<min_f>    MaxWalkingTime_OVF_Stops2Dest           := /ModelParameters/MaxWalkingTime_Stops2Dest, Descr = "Maximum walking time from the last stop, at an OV-fiets location, to the destination.";
		parameter<min_f>    MaxWalkingTime_RMT_Stops2Dest           := /ModelParameters/MaxWalkingTime_Stops2Dest, Descr = "Maximum walking time from the last rail, metro or tram stop to the destination.";
		parameter<min_f>    MaxWalkingTime_RM_Stops2Dest            := /ModelParameters/MaxWalkingTime_Stops2Dest, Descr = "Maximum walking time from the last rail or metro stop to the destination.";

		// 3. PUBLIC TRANSPORT NETWORK: stops, transfers, the waiting time at home, the pareto options of the rides and of the final front,
		// and the flex lines.
		parameter<m>        DistanceTrainStationsSelection          := 350[m]              , Descr = "Search distance to link GTFS stops to a train station.";
		parameter<m>        DistanceStopClusters                    := 100[m]              , Descr = "Search distance to cluster the stops of one place, such as both directions of a bus stop; a trip within a cluster makes no sense.";
		parameter<m>        DistanceOVFietsStops                    := 200[m]              , Descr = "Search distance to link OV-fiets locations to GTFS stops.";
		parameter<m>        MaxTransferDist                         := 500[m]              , Descr = "Maximum straight-line distance between two stops that a transfer may walk.";
		parameter<m_s>      TransferEffectiveSpeed                  := value(4.5[km_hr] / 1.2f, m_s), Descr = "Walking speed during a transfer: 4.5 km/h divided by 1.2 for detours.";
		parameter<min_f>    GradeSeparatedTransferPenalty           := 0[min_f]            , Descr = "Time penalty for a transfer at a stop with a large height difference.";
		parameter<bool>     IFF_TransferTime                        := TRUE                , Descr = "Does a transfer between two platforms of the same NS station take at least the transfer time of that station in the NS IFF timetable, besides the walking time over the straight distance (#123)?";
		parameter<min_f>    Cycling_PreTransport_Penalty            := 0[min_f]            , Descr = "Time to park the bike at the end of every cycling pre-transport leg.";
		parameter<bool>     IncludeWaitingAtHomeInTravelTime        := FALSE               , Descr = "Does the waiting time at home count in the travel time?";
		parameter<Time>     MaxWaitingTimeAtOrigin                  := 899[Time]           , Descr = "Maximum waiting time at home before the first departure; when it does not count in the travel time, a high value lets a trip leave much later than its departure moment.";
		parameter<float32>  MinServiceDayTripShare                  := 0.95f               , Descr = "Minimum share of trips of every service day the analysis window needs, relative to the busiest day of the same weekday in the feed, to catch incomplete feeds and holidays.";
		parameter<bool>     ParetoLegs_R                            := TRUE                , Descr = "Use the pareto option of impedance_matrix for the regional public transport rides (OD_R): with equal travel time the shortest, and so cheapest, route is kept (#115).";
		parameter<bool>     ParetoLegs_L                            := FALSE               , Descr = "Same for the NS rides (OD_L); off, because the NS fare depends on the first and last station, not on the distance travelled.";
		parameter<float32>  ChainParetoTimeEpsilon                  := 0.01f               , Descr = "Relative epsilon on the travel time in the final front per departure moment, when merging and with a time penalty in the chain joiner (ObjectVision/GeoDMS#1282): price comes first, and a more expensive option stays only when it is more than this fraction faster.", IntegrityCheck = "this >= 0f && this <= 1f";
		// DEMAND-RESPONSIVE TRANSPORT AND CALL BUSES (#113, #116). Flex lines are ordinary lines with trips in the GTFS feeds, but must be booked
		// 30 to 60 minutes ahead; NeTEx has no area geometry for them, so the model recognises them by line name
		// (SourceData/Infrastructure/GTFS/RelevantSelection/Routes/IsFlex). IncludeFlex FALSE leaves them out; with FlexMinInterval,
		// FlexExtraWaitingTime and FlexCallCosts all 0 the trips count as the feed has them. The default (#116) includes them with 15 min,
		// 30 min and 0.00 euro, which gives the flex tag '_flex15i30w0ct' of the chain cache and the output (Impl/Flex_FileTag).
		parameter<bool>     IncludeFlex                             := TRUE                , Descr = "Does the model include demand-responsive transport (Routes/IsFlex)? FALSE removes all links of flex lines from the network; the public transport nodes count flex departures anyway.";
		parameter<min_f>    FlexMinInterval                         := 15[min_f]           , Descr = "Minimum interval between the trips of a flex line: per trip pattern only the first trip of every interval stays, which thins lines scheduled every minute (#116); 0 does not thin.", IntegrityCheck = "this >= 0[min_f]";
		parameter<min_f>    FlexExtraWaitingTime                    := 30[min_f]           , Descr = "Extra waiting time per boarding of a flex line, for calling and the uncertain arrival of the vehicle (#116).", IntegrityCheck = "this >= 0[min_f]";
		parameter<Euro>     FlexCallCosts                           := 0.00[Euro]          , Descr = "Call costs per boarding of a flex line, added to the price of the ride (#116).", IntegrityCheck = "this >= 0[Euro]";
		parameter<float32>  FlexBookedStopShare                     := 0.5f                , Descr = "A bus line counts as flex when at least this share of its stop_times has pickup_type or drop_off_type 2, phone the agency (#116), besides the terms of Classifications/FlexRouteTerms; above 1 only the name counts.", IntegrityCheck = "this > 0f";
	
		// 4. FARES
		parameter<string>   PriceMethod                             := 'Detailed'          , Descr = "Public transport fares: 'Detailed', the fare tables per mode, agency, concession and line (OVprijzen/FareTable_2023), or 'DOVA', the kilometre fares per concession from the DOVA overview, back to 2013.";
		parameter<string>   NS_TariffChoice                         := 'Price_40pct_Discount', Descr = "NS fare class in a part of the day off-peak: 'Price_FullFare', 'Price_20pct_Discount' or 'Price_40pct_Discount'; in the NS peak hours the model uses the full fare (Impl/NS_FareClass, #119).";
		parameter<min_f>    MaxTransferTimeForBoardingSurcharge     := 35[min_f]           , Descr = "Maximum transfer time within which no new boarding fare is charged, as in the Dutch fare system.";
		parameter<bool>     IncludeWalkingCostsInPrice              := FALSE               , Descr = "Do the costs of walking count in Price? They are a valuation of the time, an amount per minute (PreTransport_, PostTransport_ and Direct_Walking_Time_Costs), and always count in Price_Augm.";
		parameter<bool>     IncludeCyclingCostsInPrice              := TRUE                , Descr = "Do the costs of cycling on an own bike count in Price? They are the costs per km as an amount per minute at CyclingSpeed_kmhr (PreTransport_, PostTransport_ and Direct_Cycling_Time_Costs), and always count in Price_Augm. The rent of the OV-fiets always counts in Price (#108).";
		parameter<bool>     IncludeCarCostsInPrice                  := TRUE                , Descr = "Does the cost of the direct car trip count in the price? Without it the car is free in the front and always wins on price.";
		// TRIP SURCHARGE FOR SPECIAL TRAINS AND NS INTERNATIONAL (#3): the trains, their sections and the amounts are in
		// SourceData/Infrastructure/OVprijzen/NS.
		parameter<bool>     IncludeTripSurcharge                    := TRUE                , Descr = "Do the trains in TripSurchargeTrains add their surcharge to the price and their extra time to the travel time?";
		parameter<bool>     IsNSInternationalInLnet                 := TRUE                , Descr = "Do NS International trains (Eurocity Direct, EuroCity, ICE, IC Berlin) count in the NS network for domestic journeys, with the NS fare and their surcharge? Trains on which an NS ticket never applies stay out (TrainsWithoutNSTicket).";

		// 5. PUBLIC TRANSPORT NODES (SourceData/Infrastructure/GTFS/PT_Hubs): when a cluster of stops counts as a node.
		parameter<m>        DistanceHubClusters                     := 150[m]              , Descr = "Cluster distance to merge GTFS stops into one public transport node (single linkage), so that the platforms of one node fall together.";
		parameter<uint32>   Hub_MinLines_BTM                        := 8                   , Descr = "Minimum number of distinct bus, tram and metro lines at a stop cluster for a bus/tram/metro node; train stations are always a node.";
		parameter<uint32>   Hub_MinDepartures_BTM                   := 150                 , Descr = "Minimum number of bus, tram and metro departures per day at a stop cluster for a bus/tram/metro node.";
		parameter<float32>  Hub_OperatingHoursPerDay                := 18f                 , Descr = "Operating hours per day, to turn departures per day into departures per hour for the node value (butterfly model).";
		parameter<m>        Hub_DominanceRadius                     := 1500[m]             , Descr = "A bus/tram/metro node drops out when a candidate with a higher network value lies within this radius, so that a corridor or a large complex gets one node.";
		parameter<m>        Hub_DedupRadiusTrain                    := 400[m]              , Descr = "Two train clusters within this radius are merged and the one with the most train departures stays, for platforms of one station just outside the cluster distance.";
		parameter<uint32>   Hub_MinDirections_BTM                   := 3                   , Descr = "Minimum number of compass directions, of four, in which bus, tram and metro departures leave the cluster: the number of directions of the butterfly model.";
		parameter<float32>  Hub_MinNetworkValue_BTM                 := 0f                  , Descr = "Optional minimum network value (butterfly model) of a bus/tram/metro node; 0 switches it off.";

		// 6. ROAD, WALKING AND CYCLING NETWORKS: OSM, TomTom and the Fietsersbond, the car front, the time-dependent
		// car trip and the junction penalties.
		parameter<string>   CyclingNetwork                          := 'OSM'               , Descr = "The network of all cycling legs and the direct cycling trip: 'OSM' or 'Fietsersbond', with one-way cycle paths; walking always uses OSM (#124).", IntegrityCheck = "CyclingNetwork == 'Fietsersbond' || CyclingNetwork == 'OSM'";
		parameter<m>        Fietsersbond_MaxFerryLength             := 2000[m]             , Descr = "A Fietsersbond ferry up to this length is part of the cycling network; longer crossings belong to public transport or lie out of reach (#124).";
		parameter<min_f>    Fietsersbond_FerryExtraTime             := 5[min_f]            , Descr = "Waiting and crossing time on a Fietsersbond ferry, on top of the cycling time over its length (#124).";
		parameter<km_hr>    CarSpeed_kmhr                           := 130[km_hr]          , Descr = "Maximum car speed on the OSM network.";
		parameter<km_hr>    CarSpeed_limit_kmhr                     := 100[km_hr]          , Descr = "Speed limit on OSM motorways during the day, such as 100 km/h; only for the OSM network.";
		parameter<km_hr>    CarDefaultSpeed                         := 50[km_hr]           , Descr = "Car speed on OSM roads without a speed of their own.";
		parameter<km_hr>    CarDefaultSpeed_low                     := 30[km_hr]           , Descr = "Car speed on minor OSM roads without a speed of their own.";
		parameter<km_hr>    Ferry_Speed                             := 25[km_hr]           , Descr = "Speed of a ferry.";
		parameter<bool>     InterpretAllRoadsAsBidirectional        := FALSE               , Descr = "Treat all car roads as two-way, ignoring the one-way property?";//
		parameter<string>   TomTom_StreetTypeSelection              := 'FuncRoadClass/V/Local_Road_of_Minor_Importance', Descr = "Road class from which the TomTom network leaves out roads, for example FuncRoadClass/V/Local_Road_of_Minor_Importance.";
		parameter<float32>  OSM_MaxSpeedQuantile                    := 0.5f
		, Descr = "Quantile of the tagged maxspeed per road type and country, used for OSM roads without a usable maxspeed tag.";
		parameter<m>        ExtraLink_MaxSnapDistance               := 250[m]              , Descr = "Maximum distance from an end point of a manual connection (OSM/NetworkPreperation/ExtraConnections) to the road network; a connection with an end point further away is left out.";
		parameter<uint8>    NumberOfItersForNetworkCleanUp          := 10b                 , Descr = "Number of iterations of the network clean-up.";

		// PARETO FRONT OF THE DIRECT CAR TRIP (#115, #88): with the pareto option the car search gives per OD pair the front on travel
		// time and distance, the fast motorway route beside the short local road, instead of only the fastest route. The price is
		// distance x Car_CostPerKm, so it is also the front on time and price. Only the direct car trip uses it; the car exports stay scalar.
		parameter<bool>     ParetoLegs_Car                          := TRUE                , Descr = "Use the pareto option of impedance_matrix_od64 for the direct car trip, giving all routes that are optimal on travel time and distance per OD pair instead of only the fastest.";
		parameter<km>       CarLegDistanceQuantum                   := 0.04[km]            , Descr = "Only with CarFrontEpsilon 0: quantisation of the distance per link, the second criterion of the car front, so that fronts on a network with continuous lengths do not explode; 40 m is 1 ct at 0.24 euro per km.";
		parameter<float32>  CarFrontEpsilon                         := 0.01f               , Descr = "Relative epsilon of the car front (#88, ObjectVision/GeoDMS#1282): ordered by distance, a longer route stays only when it is more than this fraction faster than the fastest shorter route that stays.", IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<string>   CarTD_Search                            := 'pareto_alt'        , Descr = "Search of the time-dependent car trip: 'pareto_alt', distance first as with CarFrontEpsilon and with the time profile on the travel time (ObjectVision/GeoDMS#1304), or 'scalar', only the fastest route.", IntegrityCheck = "this == 'pareto_alt' || this == 'scalar'";
		parameter<uint32>   CarTD_WindowStart                       := (rjoin(/ModelParameters/PartOfDay, /ModelParameters/PartsOfDay/name, /ModelParameters/PartsOfDay/DepartureHour) - 1) * 3600, Descr = "Start of the window of time slots of the time-dependent car trip, in seconds since 00:00: one hour before the hour of the departure moments.";
		parameter<uint32>   CarTD_NrSlots                           := 48                  , Descr = "Number of 300 s time slots of the TomTom speed profiles in the window, 4 hours, which covers the last departure moment plus start time plus MaxCarTime.", IntegrityCheck = "CarTD_WindowStart + this * 300 <= 86400";
		parameter<s_f>      CarTD_SlotDuration                      := 300[s_f]            , Descr = "Duration of a time slot of the TomTom speed profiles.";

		container Junction_Penalties
		: Descr = "Time penalties for passing a junction, depending on its number of legs, lower when the legs have a low speed."
		{
			parameter<s>        with_2Links_Walking               := 0[s]; // 0
			parameter<s>        with_3Links_Walking               := 2[s]; // 1
			parameter<s>        with_4Links_Walking               := 5[s]; // 2
			parameter<s>        with_gt4Links_Walking             := 6[s]; // 3
		
			// Cycling, also with e-bike values in CyclingSpeed_kmhr and Cycling_CostPerKm: an e-bike has the same junction penalties.
			parameter<s>        with_2Links_Cycling               := 0[s]; // 0
			parameter<s>        with_3Links_Cycling               := 2[s]; // 1
			parameter<s>        with_4Links_Cycling               := 5[s]; // 2
			parameter<s>        with_gt4Links_Cycling             := 6[s]; // 3
		
			parameter<s>        with_2Links_Car                   := 0[s]; // 0
			parameter<s>        with_3Links_Car                   := 2[s]; // 2
			parameter<s>        with_4Links_Car                   := 5[s]; // 5
			parameter<s>        with_gt4Links_Car                 := 6[s]; // 6
		
			parameter<s>        with_2_lowerSpeedLinks_Walking    := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Walking    := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Walking    := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Walking  := 0[s]; // 3
		
			parameter<s>        with_2_lowerSpeedLinks_Cycling    := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Cycling    := 0[s]; // 1
			parameter<s>        with_4_lowerSpeedLinks_Cycling    := 0[s]; // 2
			parameter<s>        with_gt4_lowerSpeedLinks_Cycling  := 0[s]; // 3
		
			parameter<s>        with_2_lowerSpeedLinks_Car        := 0[s]; // 0
			parameter<s>        with_3_lowerSpeedLinks_Car        := 0[s]; // 2
			parameter<s>        with_4_lowerSpeedLinks_Car        := 0[s]; // 5
			parameter<s>        with_gt4_lowerSpeedLinks_Car      := 0[s]; // 6
		}

		container OSM_impl
		: Descr = ""
		{
			unit<uint32> InOneFile : nrofrows = 4
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Region, OrgSet, OrgPath, Country, Type
					[
					'Netherlands'             ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Nordrhein-Westfalen'     ,'DE', 'OD'
					]; 
				}
			
				attribute<string> label    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string> name     := replace(label, '-', '_');
				attribute<string> Country  := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string> Type_src := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			
				parameter<uint32> nrAttr   := 3;
			}
			unit<uint32> InProvinces : nrofrows = 17
			{
				unit<uint32> Elements  := Range(uint32, 0, nrAttr*#.)
				{
					attribute<String> Text:
					// Region, OrgSet, OrgPath, Country, Type
					[
					'Drenthe'                 ,'NL', 'OD',
					'Flevoland'               ,'NL', 'OD',
					'Friesland'               ,'NL', 'OD',
					'Gelderland'              ,'NL', 'OD',
					'Groningen'               ,'NL', 'OD',
					'Limburg'                 ,'NL', 'OD',
					'Noord-Brabant'           ,'NL', 'OD',
					'Noord-Holland'           ,'NL', 'OD',
					'Overijssel'              ,'NL', 'OD',
					'Utrecht'                 ,'NL', 'OD',
					'Zeeland'                 ,'NL', 'OD',
					'Zuid-Holland'            ,'NL', 'OD',

					'Belgium'                 ,'BE', 'OD',

					'Niedersachsen'           ,'DE', 'OD',
					'Duesseldorf-regbez'       ,'DE', 'OD',
					'Koeln-regbez'             ,'DE', 'OD',
					'Muenster-regbez'          ,'DE', 'OD'
					]; 
				}
			
				attribute<string> label    := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)], DialogType = "LabelText";
				attribute<string> name     := replace(label, '-', '_');
				attribute<string> Country  := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)];
				attribute<string> Type_src := Elements/Text[value(UInt32(ID(.))* nrAttr + 2, Elements)];
			
				parameter<uint32> nrAttr   := 3;
			}
		}

		// 7. TECHNICAL: blocks, caches, file paths and the spelling of the output columns.
		parameter<uint32>   NumberOfStopBlocks                      := Impl/IsOD ? 1 : 500 , Descr = "Number of stop blocks of the chain generation; fewer blocks need more memory each, and with an OD pair there is one block with the stops reached from the origin.";
		parameter<uint32>   MaxStopBlockSize                        := 104                 , Descr = "Maximum number of stops per block of the chain generation; times NumberOfStopBlocks it must cover all stops (ChecksBeforeRunning/PT_CheckBlocks).";
		parameter<uint32>   NumberOfOrgBlocks                       := Impl/IsOD ? 1 : 450 , Descr = "Number of origin blocks of the output step; with an OD pair one block with the one origin, and times MaxOrgBlockSize it must cover all origins (ChecksBeforeRunning/Check_OriginBlocks).";
		parameter<uint32>   MaxOrgBlockSize                         := Impl/Orgset_FixedYear ? 33 : 200, Descr = "Maximum number of origins per block of the output step: 200, or 33 with a neighbourhood set of its own CBS year as Orgset (Buurt2023, Buurt2025), so that 450 blocks cover the neighbourhoods of 2023 and 2025 (#126).";
		// Origin blocks in parts (#117): the output step of a component whose estimated peak per origin block is above MaxMemoryPerProcess_GB
		// calculates every block in parts of fewer origins, each behind its own fence, and writes the block as one file (PublicTransport/PerPart).
		// The estimate (Impl/OutputPeak_Estimate_GB) scales the measured peak of the component above the fixed load with the origins per block and
		// the number of destinations.
		parameter<float32>  MaxMemoryPerProcess_GB                  := 64f                 , Descr = "The memory in GB that one GeoDmsRun of the output step may use; set it somewhat below the physical memory of the machine. A component whose estimated peak per origin block is higher calculates every block in parts (Impl/OrgBlockParts).", IntegrityCheck = "this > OutputPeak_FixedLoad_GB";
		parameter<float32>  OutputPeak_FixedLoad_GB                 := 21f                 , Descr = "The part of the peak of the output step that does not depend on the origins of the block: the network, the chain cache and the legs.", Source = "OVSRV10, the lowest commit charge of the 18 portions of the output step of C_PT_C, Y2025, morning (log analysis of 2026-10-29)";
		parameter<uint32>   OutputPeak_Reference_BlockSize          := 33                  , Descr = "The origins per block of the runs in which OutputPeak_Measured was measured.";
		parameter<uint32>   OutputPeak_Reference_Destinations       := 14729               , Descr = "The destinations of the runs in which OutputPeak_Measured was measured, the neighbourhoods of Buurt2025.";
		unit<uint8> OutputPeak_Measured : nrofrows = 16
		, Descr = "The highest commit charge in GB of a GeoDmsRun of the output step per component; a public transport component that is not in this table gets that of C_PT_ with the same post-transport, because the stops of another pre-transport are (nearly) a subset of those of C, cycling to every stop (Classifications/Components/OutputPeak_GB)."
		, Source = "OVSRV10 (127 GB), the output steps of Y2025, morning, Buurt2025 to Buurt2025, 33 origins per block: WW, CC and Car in portions of 50 blocks with GeoDMS 20.27.0, 2026-10-30 and 2026-10-31; W_PT_W, W_PT_C, W_PT_ovfC, C_PT_W, C_PT_C and C_PT_ovfC in portions of 50 blocks with the front of #140 and the chain cache in parquet, GeoDMS 20.28.0, 2026-10-31 and 2026-11-01; the others in portions of 25 (C) or 50 (W) blocks with GeoDMS 20.24.0, the chains per block of 801d567 and without the front of #140, 2026-10-20 to 2026-10-30 (log analysis of 2026-10-30)"
		{
			attribute<string>  name : ['C_PT_rmtC', 'C_PT_rmC', 'W_PT_rmtC', 'C_PT_W', 'C_PT_C', 'C_PT_ovfC', 'W_PT_rmC', 'W_PT_W', 'W_PT_C', 'W_PT_ovfC', 'Crm_PT_C', 'Car', 'WW', 'Crm_PT_W', 'Crm_PT_ovfC', 'CC'];
			attribute<float32> GB   : [98.0, 52.1, 40.3, 39.7, 39.5, 38.3, 36.8, 35.0, 34.9, 34.3, 27.1, 11.2, 9.0, 8.2, 6.9, 6.9];
		}
		parameter<bool>     PT_Chains_PerBlock                      := TRUE                , Descr = "Does the chain step write every stop block to its own cache, which the output step reads together? FALSE: one cache for all blocks (ChainGeneration_Single/Write).";
		parameter<bool>     PrePostTransportDecoupled               := TRUE                , Descr = "Write the pre- and post-transport connections once per base set to a cache in IntermediateResults and read them back? On, because every portion of the output step is a GeoDmsRun of its own, which would otherwise calculate the base sets again (#133).";
		parameter<bool>     MakeMedian                              := FALSE               , Descr = "Does the output step also write, per block, the median over the departure moments of the cheapest option per OD pair (Mediaan/tt_<date>_mediaan_<n>of<N>)?";
		parameter<uint32>   MaxPathLength                           := 259                 , Descr = "The longest file path Windows allows without longPathAware; every cache checks it before calculating (Templates/Signature_T/PathGate, #118).";
	
		// The spelling of seven column names of the parquet output. GeoDMS keeps the spelling in which a name is first read, for the whole
		// configuration (names are case-insensitive), and gdalwrite.vect writes that spelling as the column name. Elsewhere these items are
		// spelled Price_augm and Traveldist_...; ModelParameters.dms is the first file that main.dms reads, so these names fix the spelling.
		// They are not used otherwise.
		container ParquetColumnSpelling
		{
			parameter<bool> Price_Augm;
			parameter<bool> TravelDist_Bus;
			parameter<bool> TravelDist_Metro;
			parameter<bool> TravelDist_Tram;
			parameter<bool> TravelDist_Rail;
			parameter<bool> TravelDist_Ferry;
			parameter<bool> TravelDist_N;
		}
	}

	#include<Impl.dms>
}
