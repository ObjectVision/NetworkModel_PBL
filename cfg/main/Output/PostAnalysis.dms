container PostAnalysis : using = "units;Geography;modelparameters;classifications;sourcedata", Descr = "Analyses beside the model run: the network-based UAI for RSopen, travel times and distances to public transport stops for the RuimteScanner, and the median travel time per OD pair (FindMedian)."
{
	#include<UAI.dms>

	container StopAnalysis_RuimteScanner : Descr = "Travel time and distance from every 100 m cell to the nearest public transport stop per mode and class of trips per day, over the OSM networks for walking, cycling and car, as tifs for the RuimteScanner."
	{
		parameter<m>     Distance_StopClustering := 100[m], Descr = "Stops of the same mode within this distance of a stop, in the same province, count in its cluster for the number of trips per day.";
		parameter<min_f> MaxSearchTime              := 60[min_f], Descr = "Search limit of the travel time from the stops; it also sets the search limit of the distance through the speed of the network.";
		
		parameter<string> domain_str   := '100m';
		unit<spoint>      grid_domain  := ='rdc_'+domain_str;
		
		unit<uint8> Modes                    := GTFS_Modes/Selection;

		attribute<Modes>   Mode_perstop (Infrastructure/GTFS/RelevantSelection/StopTimes)  := Infrastructure/GTFS/RelevantSelection/StopTimes/Mode_perstop;

		unit<uint32> Stops_total := Infrastructure/GTFS/RelevantSelection/Stops
		, FreeData = "false"
		{
			attribute<rdc>              geometry              := Infrastructure/GTFS/RelevantSelection/Stops/geometry;
			attribute<string>           ModeName             := Modes/name[Mode_rel];

			attribute<uint32>           Cluster_NrTripsPerDay := Cluster_NrTripsPerDay_Tram + Cluster_NrTripsPerDay_Metro + Cluster_NrTripsPerDay_Rail + Cluster_NrTripsPerDay_Bus + Cluster_NrTripsPerDay_Ferry;
			attribute<uint32>           Cluster_CountStops    := Cluster_Count_Tram + Cluster_Count_Metro + Cluster_Count_Rail + Cluster_Count_Bus + Cluster_Count_Ferry;
			
			attribute<uint32>           Cluster_NrTripsPerDay_Tram   := MakeDefined(rjoin(geometry, Stop_per_mode/Tram/Per_mode_subset/geometry, Stop_per_mode/Tram/Per_mode_subset/Cluster_NrTripsPerDay),0);
			attribute<uint32>           Cluster_NrTripsPerDay_Metro  := MakeDefined(rjoin(geometry, Stop_per_mode/Metro/Per_mode_subset/geometry, Stop_per_mode/Metro/Per_mode_subset/Cluster_NrTripsPerDay),0);
			attribute<uint32>           Cluster_NrTripsPerDay_Rail   := MakeDefined(rjoin(geometry, Stop_per_mode/Rail/Per_mode_subset/geometry, Stop_per_mode/Rail/Per_mode_subset/Cluster_NrTripsPerDay),0);
			attribute<uint32>           Cluster_NrTripsPerDay_Bus    := MakeDefined(rjoin(geometry, Stop_per_mode/Bus/Per_mode_subset/geometry, Stop_per_mode/Bus/Per_mode_subset/Cluster_NrTripsPerDay),0);
			attribute<uint32>           Cluster_NrTripsPerDay_Ferry  := MakeDefined(rjoin(geometry, Stop_per_mode/Ferry/Per_mode_subset/geometry, Stop_per_mode/Ferry/Per_mode_subset/Cluster_NrTripsPerDay),0);
			
			attribute<uint32>           Cluster_Count_Tram   := MakeDefined(rjoin(geometry, Stop_per_mode/Tram/Per_mode_subset/geometry, Stop_per_mode/Tram/Per_mode_subset/Cluster_CountStops),0);
			attribute<uint32>           Cluster_Count_Metro  := MakeDefined(rjoin(geometry, Stop_per_mode/Metro/Per_mode_subset/geometry, Stop_per_mode/Metro/Per_mode_subset/Cluster_CountStops),0);
			attribute<uint32>           Cluster_Count_Rail   := MakeDefined(rjoin(geometry, Stop_per_mode/Rail/Per_mode_subset/geometry, Stop_per_mode/Rail/Per_mode_subset/Cluster_CountStops),0);
			attribute<uint32>           Cluster_Count_Bus    := MakeDefined(rjoin(geometry, Stop_per_mode/Bus/Per_mode_subset/geometry, Stop_per_mode/Bus/Per_mode_subset/Cluster_CountStops),0);
			attribute<uint32>           Cluster_Count_Ferry  := MakeDefined(rjoin(geometry, Stop_per_mode/Ferry/Per_mode_subset/geometry, Stop_per_mode/Ferry/Per_mode_subset/Cluster_CountStops),0);
		}
		
		container Generate_tiffs : Descr = "Writes the tifs of the travel time and the distance to the nearest stop of every mode and class, per network (walking, cycling, car)."
		{
			parameter<String> Traveltime_Pedestrian := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/pedestrian/OD_traveltime_grid',';')";
			parameter<String> Traveltime_Bike := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/bike/OD_traveltime_grid',';')";
			parameter<String> Traveltime_Car := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/car/OD_traveltime_grid',';')";
			
			parameter<String> Distance_Pedestrian := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/pedestrian/OD_distance_grid',';')";
			parameter<String> Distance_Bike := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/bike/OD_distance_grid',';')";
			parameter<String> Distance_Car := 'Ready',
			ExplicitSuppliers = "=asList('Dijkstras/Per_ModeDepartureK/'+Mode_X_DepartureMoments3K/name+'/CreateODperNetworkType/car/OD_distance_grid',';')";
		}
		
		container Dijkstras
		{
			container Per_ModeDepartureK := 
				for_each_ne(
					Mode_X_DepartureMoments3K/name
					, 'Per_ModeDepartureK_T(
							 '+quote(Mode_X_DepartureMoments3K/mode_name)+'
							,'+quote(Mode_X_DepartureMoments3K/DepartureMomentK_name)+'
							, perGridsize/size_'+domain_str+'/points
							, ModeDepartureK/'+string(Mode_X_DepartureMoments3K/mode_name)+'_'+string(Mode_X_DepartureMoments3K/DepartureMomentK_name)+'/Subset
						)'
				);
				
			Template Per_ModeDepartureK_T
			{
				parameter<string> ModeName;
				parameter<string> DepartureMoments3K_name;
				unit<uint32> org;
				unit<uint32> dest;
				
				
				container CreateODperNetworkType := 
					for_each_ne(
						classifications/OSM/network_type/name
						,'MakeFSS(org, dest,'+quote(classifications/OSM/network_type/name_alt)+')'
					);
					
				Template MakeFSS
				{
					unit<uint32>       org;
					unit<uint32>       dest;
					parameter<string>  network_type;
					//////
					container Create_Optimised_Network  := ='Templates/CreateNetwork_Efficient_T(Org, Dest, SourceData/Infrastructure/OSM/Network_'+network_type+', '+quote(network_type)+', FALSE)', Descr = "The OSM network of network_type, with the cells (org) and the stops (dest) connected to it.";
					
					unit<uint32>       LinkSet := Create_Optimised_Network/CreateMoreEfficientNetwork/FinalLinkSet;
					unit<uint32>       NodeSet := Create_Optimised_Network/CreateMoreEfficientNetwork/FinalNodeSet
					{
						attribute<.>   OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
						attribute<.>   DestNode_rel (dest) := rlookup(dest/geometry, geometry);
					}

					attribute<min_f> impedance (LinkSet) := ='convert(LinkSet/Impedance_per_ImpedanceType/max_'+network_type+', min_f)';
					attribute<km>    distance  (LinkSet) := ='LinkSet/Distance_per_ImpedanceType/max_'+network_type;

					attribute<min_f> OD_traveltime (NodeSet) := 
						impedance_table(
							  'bidirectional(link_flag);startPoint(Node_rel);cut(OrgZone_max_imp)'
							, impedance
							, LinkSet/F1
							, LinkSet/F2
							
							, NOT(LinkSet/IsOneDirection)
							, NodeSet/DestNode_rel
							, MaxSearchTime
						);
					attribute<min_f>  OD_traveltime_org          (org) := OD_traveltime[NodeSet/OrgNode_rel];
					attribute<min_f>  OD_traveltime_grid (grid_domain) := sum(OD_traveltime_org, org/grid_rel), StorageName = "='%LocalDataProjDir%/Output/OD_korste_reistijd_'+network_type+'_eerstehaltevan_'+ModeName+'_'+DepartureMoments3K_name+'.tif'", StorageType = "gdalwrite.grid";
					
					parameter<km> MaxTravelDistance := ='convert(MaxSearchTime, hr_f) * /ModelParameters/'+(lowercase(network_type) == 'walking' || lowercase(network_type) == 'cycling' ? '' : 'Advanced/')+network_type+'Speed_kmhr';
					
					attribute<km> OD_distance (NodeSet) := 
						impedance_table(
							  'bidirectional(link_flag);startPoint(Node_rel);cut(OrgZone_max_imp)'
							, distance
							, LinkSet/F1
							, LinkSet/F2
							
							, NOT(LinkSet/IsOneDirection)
							, NodeSet/DestNode_rel
							, MaxTravelDistance
						);
					attribute<km>  OD_distance_org          (org) := OD_distance[NodeSet/OrgNode_rel];
					attribute<km>  OD_distance_grid (grid_domain) := sum(OD_distance_org, org/grid_rel), StorageName = "='%LocalDataProjDir%/Output/OD_korste_afstand_'+network_type+'_eerstehaltevan_'+ModeName+'_'+DepartureMoments3K_name+'.tif'", StorageType = "gdalwrite.grid";
					
				}
			}
		}
		
		container ModeDepartureK :=
			for_each_ne(
				Mode_X_DepartureMoments3K/name
				, 'ModeDepartureK_T('+quote(Mode_X_DepartureMoments3K/Mode_name)+','+quote(Mode_X_DepartureMoments3K/DepartureMomentK_name)+','+string(Mode_X_DepartureMoments3K/Class_lower)+','+string(Mode_X_DepartureMoments3K/Class_upper)+')'
			);	
		
		Template ModeDepartureK_T
		{
			parameter<string> Mode;
			parameter<string> DepartureMomentK;
			parameter<uint32> Class_lowerbound;
			parameter<uint32> Class_upperbound;

			unit<uint32> subset := ='select_with_org_rel(Stop_per_mode/'+Mode+'/Per_mode_subset/Cluster_NrTripsPerDay >= Class_lowerbound && Stop_per_mode/'+Mode+'/Per_mode_subset/Cluster_NrTripsPerDay < Class_upperbound)'
			{
				attribute<rdc>              geometry              := ='Stop_per_mode/'+Mode+'/Per_mode_subset/geometry[org_rel]';
				attribute<string>           Label                 := ='Stop_per_mode/'+Mode+'/Per_mode_subset/Label[org_rel]', DialogType = "LabelText";
				attribute<uint32>           NrTripsPerDay         := ='Stop_per_mode/'+Mode+'/Per_mode_subset/NrTripsPerDay[org_rel]';
				attribute<uint32>           Cluster_NrTripsPerDay := ='Stop_per_mode/'+Mode+'/Per_mode_subset/Cluster_NrTripsPerDay[org_rel]';
				attribute<uint32>           Cluster_CountStops    := ='Stop_per_mode/'+Mode+'/Per_mode_subset/Cluster_CountStops[org_rel]';
			}
		}
		
		container Stop_per_mode :=
			for_each_ne(
				Modes/name
				, 'Stop_per_mode_T('+quote(Modes/name)+')'
			);	
		
		Template Stop_per_mode_T
		{
			parameter<string> Mode;
			
			unit<uint32> Per_mode_subset := select_with_org_rel(Stops_total/ModeName == Mode)
			{
				attribute<rdc>              geometry              := Stops_total/geometry[org_rel];
				attribute<RegioIndelingen/Provincie> prov_rel              := MakeDefined(point_in_polygon(geometry, RegioIndelingen/Provincie/Geometry),12);
				attribute<string>           Label                 := Stops_total/Label[org_rel];
				attribute<uint32>           NrTripsPerDay         := Stops_total/NrTripsPerDay[org_rel];
				attribute<uint32>           Cluster_NrTripsPerDay := rjoin(geometry, StopMatrix_merged/geometry, StopMatrix_merged/Cluster_NrTripsPerDay);
				attribute<uint32>           Cluster_CountStops    := rjoin(geometry, StopMatrix_merged/geometry, StopMatrix_merged/Cluster_CountStops);
				
				attribute<uint32>           classify_ClusterTrips (DepartureMoments_3K) := ClassifyJenksFisher(Cluster_NrTripsPerDay, DepartureMoments_3K);
				
				unit<uint32> StopMatrix_merged := ='union_unit('+AsItemList('StopsMatrix_PerProv/'+RegioIndelingen/Provincie/name+'/Stops_subset')+')'
				{
					attribute<rdc>         geometry              := ='union_data(., '+AsItemList('StopsMatrix_PerProv/'+RegioIndelingen/Provincie/name+'/Stops_subset/geometry')+')';
					attribute<string>      StopName             := ='union_data(., '+AsItemList('StopsMatrix_PerProv/'+RegioIndelingen/Provincie/name+'/Stops_subset/stop_name')+')';
					attribute<uint32>      Cluster_NrTripsPerDay := ='union_data(., '+AsItemList('StopsMatrix_PerProv/'+RegioIndelingen/Provincie/name+'/Stops_subset/Cluster_NrTripsPerDay')+')';
					attribute<uint32>      Cluster_CountStops    := ='union_data(., '+AsItemList('StopsMatrix_PerProv/'+RegioIndelingen/Provincie/name+'/Stops_subset/Cluster_CountStops')+')';
				}

				container StopsMatrix_PerProv :=
					for_each_ne(
						RegioIndelingen/Provincie/name
						, 'StopsMatrix_PerProv_T('+string(id(RegioIndelingen/Provincie))+')'
					);
				
				Template StopsMatrix_PerProv_T
				{
					parameter<uint32> prov_rel;
					
					unit<uint32> Stops_subset := select_with_org_rel(Per_mode_subset/prov_rel == prov_rel)
					{
						attribute<rdc>          geometry       := Per_mode_subset/geometry[org_rel];
						attribute<string>       stop_name      := Per_mode_subset/Label[org_rel];
						attribute<uint32>       NrTripsPerDay  := Per_mode_subset/NrTripsPerDay[org_rel];
						
						attribute<uint32>       Cluster_NrTripsPerDay  := StopsClustered/SumTrips;
						attribute<uint32>       Cluster_CountStops     := StopsClustered/CountStops;
					}
					
					unit<uint32> StopsMatrix := combine(Stops_subset, Stops_subset)
					{
						attribute<rdc>      point_1              := Stops_subset/geometry[first_rel];
						attribute<rdc>      point_2              := Stops_subset/geometry[second_rel];
						attribute<string>   stop_1_name          := Stops_subset/stop_name[first_rel];
						attribute<string>   stop_2_name          := Stops_subset/stop_name[second_rel];
						attribute<uint32>   NrTripsPerDay_stop_1 := Stops_subset/NrTripsPerDay[first_rel];
						attribute<uint32>   NrTripsPerDay_stop_2 := Stops_subset/NrTripsPerDay[second_rel];
						
						attribute<float32>  x_1      := PointCol(point_1)[float32];
						attribute<float32>  y_1      := PointRow(point_1)[float32];
						attribute<float32>  x_2      := PointCol(point_2)[float32];
						attribute<float32>  y_2      := PointRow(point_2)[float32];
						attribute<float32>  delta_x  := abs(x_1 - x_2)^2f;
						attribute<float32>  delta_y  := abs(y_1 - y_2)^2f;
						attribute<m>        dist     := MakeDefined(sqrt(delta_x + delta_y)[m],0[m]);
					}
					
					unit<uint32> StopsClustered := select_with_org_rel(StopsMatrix/dist < Distance_StopClustering) 
					{
						attribute<rdc>      point_1         := StopsMatrix/point_1[org_rel];
						attribute<rdc>      point_2         := StopsMatrix/point_2[org_rel];
						attribute<uint32>   stop_rel        := rlookup(point_1, Stops_subset/geometry);
						attribute<string>   stop_1_name     := StopsMatrix/stop_1_name[org_rel];
						attribute<string>   stop_2_name     := StopsMatrix/stop_2_name[org_rel];
						attribute<uint32>   NrTripsPerDay_stop_1 := StopsMatrix/NrTripsPerDay_stop_1[org_rel];
						attribute<uint32>   NrTripsPerDay_stop_2 := StopsMatrix/NrTripsPerDay_stop_2[org_rel];
						attribute<m>        dist                 := StopsMatrix/dist[org_rel];
						
						attribute<uint32>   SumTrips   (Stops_subset) := sum(NrTripsPerDay_stop_2, stop_rel);
						attribute<uint32>   CountStops (Stops_subset) := count(NrTripsPerDay_stop_2, stop_rel);
					}
				}
			}
		}
		
		unit<uint32> DepartureMoments_3K : nrofrows = 3, Descr = "Three classes of the number of trips per day of a stop cluster (Weinig, Gemiddeld, Veel), with per mode the class breaks by Jenks-Fisher on Cluster_NrTripsPerDay."
		{
			attribute<string> Name           : ['Weinig','Gemiddeld','Veel'];
			attribute<uint32> Tram_lower     := Stop_per_mode/Tram/Per_mode_subset/classify_ClusterTrips;
			attribute<uint32> Metro_lower    := Stop_per_mode/Metro/Per_mode_subset/classify_ClusterTrips;
			attribute<uint32> Rail_lower     := Stop_per_mode/Rail/Per_mode_subset/classify_ClusterTrips;
			attribute<uint32> Bus_lower      := Stop_per_mode/Bus/Per_mode_subset/classify_ClusterTrips;
			attribute<uint32> Ferry_lower    := Stop_per_mode/Ferry/Per_mode_subset/classify_ClusterTrips;
			
			attribute<uint32> Tram_upper     := MakeDefined(Tram_lower[id(.) + 1],20000);
			attribute<uint32> Metro_upper    := MakeDefined(Metro_lower[id(.) + 1],20000);
			attribute<uint32> Rail_upper     := MakeDefined(Rail_lower[id(.) + 1],20000);
			attribute<uint32> Bus_upper      := MakeDefined(Bus_lower[id(.) + 1],20000);
			attribute<uint32> Ferry_upper    := MakeDefined(Ferry_lower[id(.) + 1],20000);
			
			container V := for_each_nedv(Name, string(id(.)), void, .);
		}
		
		unit<uint32> Mode_X_DepartureMoments3K := combine(GTFS_Modes/Selection,DepartureMoments_3K)
		{
			attribute<string> Mode_name            := GTFS_Modes/Selection/name[first_rel];
			attribute<string> DepartureMomentK_name  := DepartureMoments_3K/name[second_rel];
			attribute<string> name                 := Mode_name + '_' + DepartureMomentK_name;
			
			attribute<uint32> Class_lower          := Mode_name == 'Tram' 
														? DepartureMoments_3K/Tram_lower[second_rel]
														: Mode_name == 'Metro'
															? DepartureMoments_3K/Metro_lower[second_rel]
															: Mode_name == 'Rail'
																? DepartureMoments_3K/Rail_lower[second_rel]
																: Mode_name == 'Bus'
																	? DepartureMoments_3K/Bus_lower[second_rel]
																	: DepartureMoments_3K/Ferry_lower[second_rel];
			attribute<uint32> Class_upper          := Mode_name == 'Tram' 
														? DepartureMoments_3K/Tram_upper[second_rel]
														: Mode_name == 'Metro'
															? DepartureMoments_3K/Metro_upper[second_rel]
															: Mode_name == 'Rail'
																? DepartureMoments_3K/Rail_upper[second_rel]
																: Mode_name == 'Bus'
																	? DepartureMoments_3K/Bus_upper[second_rel]
																	: DepartureMoments_3K/Ferry_upper[second_rel];
		}
	
	}




	unit<uint32> ReadResult := FindMedian/Org
	, StorageName = "C:/Users/JipClaassens/OneDrive - Objectvision/Object Vision/Projecten/202510-Nieuwsuur Bereikbaarheid/Buurt2022_Bereikbaarheid.xlsx"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	{
		attribute<float32> ZH_Change      := (float32(Ziekenhuizen_2025) - float32(Ziekenhuizen_2022)) / float32(Ziekenhuizen_2022);
		attribute<float32> HAVOVWO_Change := (float32(HAVOVWO_2025) - float32(HAVOVWO_2022)) / float32(HAVOVWO_2022);
		attribute<float32> VMBO_Change    := (float32(VMBO_2025) - float32(VMBO_2022)) / float32(VMBO_2022);
		
		attribute<int32>   Delta_ZH       := Ziekenhuizen_2025 - Ziekenhuizen_2022;
	}
	
	
	container FindMedian
	{
		// Median travel time per origin and destination: per departure moment the fastest front row, then the median over the departure
		// moments with a connection (NrMoments). It reads the merged public transport output (NetworkSetup/ConfigurationPerBlock/Merge_Output/
		// MergeTimes) through GDAL, for the origins and destinations of the run and without the modes in ExcludedModes.
		parameter<min_f>  SearchLimit   := 30[min_f], Descr = "Pairs with a median travel time up to and including this value go into Result.";
		parameter<string> ExcludedModes := 'AA'
		, Descr = "ModeUsed values, separated by commas, that do not count; the default is the direct car trip (AA), so that the median describes accessibility without a car, and an empty value counts all rows.";

		unit<uint32> Dest    := /NetworkSetup/PublicTransport_Prep/Impl/dest;
		unit<uint32> Org     := /NetworkSetup/PublicTransport_Prep/Impl/org
		{
			attribute<uint32> NumberOfDestReachable := pcount(Result/Origin_rel);
		}
		unit<uint32> Moments := /ModelParameters/Impl/MeasureMoments;

		unit<uint32> c_Org_Dest := combine_unit(Org, Dest)
		{
			attribute<min_f>  MedianTT     := rth_element(ReadCSV/PerMoment/MinTT, 0.5f, ReadCSV/PerMoment/c_Org_Dest_rel);
			attribute<uint32> NrMoments    := pcount(ReadCSV/PerMoment/c_Org_Dest_rel);
			attribute<Org>    Origin_rel   := value(id(.) / uint32(#Dest), Org);
			attribute<Dest>   Dest_rel     := value(id(.) % uint32(#Dest), Dest);
		}

		unit<uint32> Result := select_with_org_rel(IsDefined(c_Org_Dest/MedianTT) && c_Org_Dest/MedianTT <= SearchLimit)
		{
			attribute<min_f>  MedianTT     := org_rel -> MedianTT;
			attribute<uint32> NrMoments    := org_rel -> NrMoments;
			attribute<Org>    Origin_rel   := org_rel -> Origin_rel;
			attribute<Dest>   Dest_rel     := org_rel -> Dest_rel;
			attribute<string> Org_name     := Org/name[Origin_rel];
			attribute<string> Dest_name    := Dest/name[Dest_rel];
		}

		container ReadCSV
		{
			parameter<string> filename := /NetworkSetup/GenerateOutput/Output_Sig/ForReading + '/tt_' + ModelParameters/Impl/Analysis_date + '.csv', Descr = "The merged output over the departure moments (Merge_Times) in ModelParameters/Impl/OutputDir, read only when the signature of that folder matches (#118).";

			unit<uint32> domain
			:	StorageName     = "=filename"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "true";

			container data
			{
				attribute<min_f>      Traveltime_val (domain) := float32(domain/Traveltime) * 1[min_f];
				attribute<Org>        Origin_rel     (domain) := rlookup(domain/OrgName, Org/name);
				attribute<Dest>       Dest_rel       (domain) := rlookup(domain/DestName, Dest/name);
				attribute<Moments>    Moment_rel     (domain) := rlookup(domain/DepTime, Moments/Name);
				attribute<uint64>     Key            (domain) := uint64(combine_data(c_Org_Dest, Origin_rel, Dest_rel)) * uint64(#Moments) + uint64(Moment_rel);
				attribute<bool>       IsExcluded     (domain) := IsDefined(strpos(const(',' + ExcludedModes + ',', domain), ',' + domain/ModeUsed + ','));
			}

			unit<uint32> Rows := select_with_org_rel(IsDefined(data/Traveltime_val) && IsDefined(data/Key) && NOT(data/IsExcluded))
			{
				attribute<min_f>      Traveltime     := org_rel -> data/Traveltime_val;
				attribute<uint64>     Key            := org_rel -> data/Key;
				attribute<PerMoment>  PerMoment_rel  := rlookup(Key, PerMoment/values);
			}
			unit<uint32> PerMoment := unique_uint32(Rows/Key), Descr = "One element per origin, destination and departure moment with a connection."
			{
				attribute<min_f>      MinTT          := min(Rows/Traveltime, Rows/PerMoment_rel);
				attribute<c_Org_Dest> c_Org_Dest_rel := value(values / uint64(#Moments), c_Org_Dest);
			}
		}
	}
}