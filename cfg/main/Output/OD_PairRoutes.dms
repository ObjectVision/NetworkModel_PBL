// THE ROUTES OF ONE OD PAIR ON A MAP, IN A TABLE AND IN A CHART (#129).
// With OD_Origin and OD_Destination (ModelParameters, group 6) the model calculates only that pair, and the output step writes per
// component and departure moment, beside the normal output, <OutputDir>/PerBlock/od_<moment>.gpkg with three layers: od_opties,
// od_onderdelen and od_links (NetworkSetup/PublicTransport/PerDepartureMoment_T/OD_Output). This container reads them back, per
// component of the variant and for Combined:
// - <component>/Options and Combined/Options: a row per option and departure moment (table);
// - <component>/Parts: the journey description per option, in the order of the journey (table);
// - <component>/Links and Combined/Links: the links of the routes (map), coloured per mode (Modes), with Optie and Mode_rel to
//   colour or filter by; MapView/OptionLinks shows only ModelParameters/OD_Option;
// - Chart: Prijs against Reistijd, a series per departure moment and group of Usage (car, bike), each a front in the colour of
//   the group; open the Scatter Chart of Chart/<moment>_<group>/Points/Prijs and drag the Prijs of the other groups onto it.
// Combined merges the options of the Components per departure moment as ComponentMerge does: not dominated on price and travel time
// (with ChainParetoTimeEpsilon) and on car and bike ownership when MergeCriteria names them.
container OD_PairRoutes : using = "units;Geography;ModelParameters", Descr = "The routes of one OD pair (ModelParameters group 6, #129), read back from the gpkg files of the output step per component and merged, as tables, a map and a chart."
{
	unit<uint32> Moments := ModelParameters/Impl/MeasureMoments
	{
		attribute<string> Short := Time/TemplatableTextShrt[Moment];
	}
	unit<uint8>       Comps             := ModelParameters/Impl/VariantComponents, Descr = "The components of the variant; each must have output for the pair (batch/WriteODResults.ps1), otherwise the error message names the missing file.";
	unit<uint32>      OptionNrs         := range(uint32, 0, 1000), Descr = "The numbers of the options per departure moment, for the key (moment, option).";
	unit<uint64>      MomentOption      := combine_unit_uint64(Moments, OptionNrs);
	unit<uint32>      SeqNrs            := range(uint32, 0, 100), Descr = "The sequence numbers of the parts of an option, for the order of the journey.";
	unit<uint64>      MomentOptionSeqNr := combine_unit_uint64(Moments, OptionNrs, SeqNrs);

	// The map: colour and line width per mode. Links/geometry gets them per link (PenColor and PenWidth of the links); Links/Mode_rel
	// shows them as a theme, with a legend.
	unit<uint8> Modes := /Classifications/GTFS_Modes/Selection
	{
		attribute<uint32> PenColor : [rgb(0, 150, 0), rgb(200, 0, 0), rgb(225, 185, 0), rgb(90, 90, 90), rgb(0, 0, 140), rgb(240, 90, 0), rgb(150, 150, 150), rgb(120, 50, 225), rgb(0, 90, 200)], DialogType = "PenColor"
		,	Descr = "In the order of GTFS_Modes/Selection: tram, metro, train, bus, ferry, walking, waiting, cycling, car.";
		attribute<int16>  PenWidth : [3, 4, 4, 3, 3, 2, 2, 2, 3], DialogType = "PenWidth", Descr = "Line width in pixels: train and metro wider, walking and cycling narrower.";
	}

	// The chart: a series per group of options by what they need, a car (NeedsCar) and a bike (NeedsBike), the criteria Car and Bike of
	// MergeCriteria. A Scatter Chart colours a point by the class of its Y value, not by another attribute; that is why each group has its
	// own series, whose Prijs has a classification of one class in the colour of the group (Series_T).
	unit<uint8> Usage : nrofrows = 4, Descr = "The groups of options by the use of a car and a bike, with their colour in the chart."
	{
		attribute<string> name        : ['ZonderAutoFiets', 'MetFiets', 'MetAuto', 'MetAutoFiets'];
		attribute<string> label       : ['zonder auto of fiets', 'met fiets', 'met auto', 'met auto en fiets'];
		attribute<uint32> SymbolColor : [rgb(225, 150, 0), rgb(120, 50, 225), rgb(0, 90, 200), rgb(0, 150, 150)], DialogType = "SymbolColor", Descr = "As on the map: orange for walking and public transport, purple for the bike, blue for the car.";
		container         V           := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}
	unit<uint32> MomentGroup := combine_unit_uint32(Moments, Usage), Descr = "The series of the chart of Combined, one per departure moment and group; those of one moment are next to each other."
	{
		attribute<Moments> Moment_rel := first_rel(id(.));
		attribute<Usage>   Group_rel  := second_rel(id(.));
		attribute<string>  name       := Moments/name[Moment_rel] + '_' + Usage/name[Group_rel];
	}
	// A series is a front: the options of one group and departure moment, ordered by travel time, so that the line of the chart (Points +
	// Line, in the order of the rows) connects them from fast and expensive to slow and cheap.
	Template Series_T
	{
		unit<uint32>       Src;
		parameter<Usage>   Group;
		parameter<Moments> Moment;
		///
		unit<uint32> Chosen := select_with_org_rel(Src/Usage_rel == Group && Src/Moment_rel == Moment)
		{
			attribute<float32> Reistijd := Src/Reistijd[org_rel];
		}
		unit<uint32> Points := range(uint32, 0, #Chosen), Descr = "The options of the group Group and the departure moment Moment, ordered by travel time."
		{
			attribute<Src>     org_rel  := Chosen/org_rel[union_data(., index(Chosen/Reistijd))];
			attribute<float32> Reistijd := Src/Reistijd[org_rel], DialogType = "XAxis", Descr = "In minutes, the X axis of the Scatter Chart of Prijs.";
			attribute<float32> Prijs    := Src/Prijs[org_rel], cdf = "Classes/ClassBreaks", Descr = "In euro, in the colour of the group; open the Scatter Chart of this attribute and drag the Prijs of the other groups onto it.";
			attribute<string>  label    := Src/label[org_rel];
			unit<uint8> Classes : nrofrows = 1
			{
				attribute<float32> ClassBreaks : [0], DialogType = "Classification";
				attribute<uint32>  SymbolColor := const(Usage/SymbolColor[Group], .), DialogType = "SymbolColor";
				attribute<string>  Label       := const(Usage/label[Group], .);
			}
		}
	}

	// A gpkg of one component and one departure moment.
	Template Read_T
	{
		parameter<string> FileName;
		///
		container gpkg : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
		{
			unit<uint32> od_opties
			{
				attribute<uint32>  Optie;
				attribute<string>  OrgName;
				attribute<string>  DestName;
				attribute<string>  Component;
				attribute<string>  Vertrek;
				attribute<float32> Reistijd;
				attribute<float32> Prijs;
				attribute<string>  ModeUsed;
			}
			unit<uint32> od_onderdelen
			{
				attribute<uint32>  Optie;
				attribute<uint32>  Volgnr;
				attribute<string>  Soort;
				attribute<string>  Modaliteit;
				attribute<string>  Lijn;
				attribute<string>  Vervoerder;
				attribute<string>  Van;
				attribute<string>  Naar;
				attribute<string>  Vertrek;
				attribute<string>  Aankomst;
				attribute<float32> Minuten;
				attribute<uint32>  Afstand_m;
				attribute<float32> Prijs;
			}
			unit<uint32> od_links
			{
				attribute<uint32> Optie;
				attribute<uint32> Onderdeel;
				attribute<uint32> Volgnr;
				attribute<string> Modaliteit;
				attribute<rdc>    geometry (arc);
			}
		}
	}

	// A component: the departure moments together, with the option per moment (Optie).
	Template Component_T
	{
		parameter<string> CompName;
		///
		container        Out       := /NetworkSetup/GenerateOutput/CompOutput_T(CompName), Descr = "The folder of the output of the component with the current settings (#145): Output_<O>_<D>/<date>_<label>_<component>_<hash>.";
		parameter<string> FileMoment := /Classifications/Components/FileMoment[Out/Comp_rel], Descr = "The moment of the one file of a component with one file per block (WW and CC: alle), which every departure moment reads; empty for a file per moment.";
		container        PerMoment := for_each_ne(Moments/name, 'Read_T(' + quote(Out/Sig/ForReading + '/PerBlock/od_') + ' + ' + quote(FileMoment != '' ? const(FileMoment, Moments) : Moments/Short) + ' + ''.gpkg'')');
		unit<uint32> Options := ='union_unit(' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties') + ')'
		{
			attribute<Moments> Moment_rel := ='union_data(., ' + AsItemList('const(' + string(id(Moments)) + '[Moments], PerMoment/' + Moments/name + '/gpkg/od_opties)') + ')';
			attribute<uint32>  Optie      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties/Optie') + ')';
			attribute<string>  Component  := const(CompName, .);
			attribute<string>  Vertrek    := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties/Vertrek') + ')';
			attribute<float32> Reistijd   := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties/Reistijd') + ')', Descr = "In minutes.";
			attribute<float32> Prijs      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties/Prijs') + ')', Descr = "In euro.";
			attribute<string>  ModeUsed   := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_opties/ModeUsed') + ')';
			attribute<string>  label      := CompName + ' ' + string(Optie) + ' ' + Vertrek + ' ' + ModeUsed;
			attribute<Usage>   Usage_rel  := const(Group, .);
		}
		parameter<bool>  NeedsCar  := Comps/NeedsCar[rlookup(CompName, Comps/name)];
		parameter<bool>  NeedsBike := Comps/NeedsBike[rlookup(CompName, Comps/name)];
		parameter<Usage> Group     := NeedsCar ? (NeedsBike ? Usage/V/MetAutoFiets : Usage/V/MetAuto) : (NeedsBike ? Usage/V/MetFiets : Usage/V/ZonderAutoFiets);
		unit<uint32> Parts_Src := ='union_unit(' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen') + ')'
		,	Descr = "The parts in the order of the gpkg: per departure moment first the direct trips and the pre-transport legs, then the public transport rides and the transfers, and the post-transport."
		{
			attribute<Moments> Moment_rel := ='union_data(., ' + AsItemList('const(' + string(id(Moments)) + '[Moments], PerMoment/' + Moments/name + '/gpkg/od_onderdelen)') + ')';
			attribute<uint32>  Optie      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Optie') + ')';
			attribute<uint32>  Volgnr     := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Volgnr') + ')';
			attribute<string>  Soort      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Soort') + ')';
			attribute<string>  Modaliteit := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Modaliteit') + ')';
			attribute<string>  Lijn       := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Lijn') + ')';
			attribute<string>  Vervoerder := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Vervoerder') + ')';
			attribute<string>  Van        := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Van') + ')';
			attribute<string>  Naar       := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Naar') + ')';
			attribute<string>  Vertrek    := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Vertrek') + ')';
			attribute<string>  Aankomst   := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Aankomst') + ')';
			attribute<float32> Minuten    := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Minuten') + ')';
			attribute<uint32>  Afstand_m  := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Afstand_m') + ')';
			attribute<float32> Prijs      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_onderdelen/Prijs') + ')';
			attribute<MomentOptionSeqNr> SortKey := combine_data(MomentOptionSeqNr, Moment_rel, value(Optie, OptionNrs), value(Volgnr, SeqNrs));
		}
		unit<uint32> Parts := range(uint32, 0, #Parts_Src), Descr = "The journey description: per departure moment and option the parts in the order of the journey (Volgnr)."
		{
			attribute<Parts_Src> org_rel    := union_data(., index(Parts_Src/SortKey));
			attribute<Moments>   Moment_rel := Parts_Src/Moment_rel[org_rel];
			attribute<uint32>    Optie      := Parts_Src/Optie[org_rel];
			attribute<uint32>    Volgnr     := Parts_Src/Volgnr[org_rel];
			attribute<string>    Soort      := Parts_Src/Soort[org_rel];
			attribute<string>    Modaliteit := Parts_Src/Modaliteit[org_rel];
			attribute<string>    Lijn       := Parts_Src/Lijn[org_rel];
			attribute<string>    Vervoerder := Parts_Src/Vervoerder[org_rel];
			attribute<string>    Van        := Parts_Src/Van[org_rel];
			attribute<string>    Naar       := Parts_Src/Naar[org_rel];
			attribute<string>    Vertrek    := Parts_Src/Vertrek[org_rel];
			attribute<string>    Aankomst   := Parts_Src/Aankomst[org_rel];
			attribute<float32>   Minuten    := Parts_Src/Minuten[org_rel];
			attribute<uint32>    Afstand_m  := Parts_Src/Afstand_m[org_rel];
			attribute<float32>   Prijs      := Parts_Src/Prijs[org_rel];
		}
		unit<uint32> Links := ='union_unit(' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links') + ')'
		{
			attribute<Moments> Moment_rel     := ='union_data(., ' + AsItemList('const(' + string(id(Moments)) + '[Moments], PerMoment/' + Moments/name + '/gpkg/od_links)') + ')';
			attribute<uint32>  Optie          := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links/Optie') + ')';
			attribute<uint32>  Onderdeel      := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links/Onderdeel') + ')';
			attribute<uint32>  Volgnr         := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links/Volgnr') + ')';
			attribute<string>  Modaliteit     := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links/Modaliteit') + ')';
			attribute<rdc>     geometry (arc) := ='union_data(., ' + AsItemList('PerMoment/' + Moments/name + '/gpkg/od_links/geometry') + ')';
			attribute<Modes>   Mode_rel       := rlookup(Modaliteit, Modes/name);
			attribute<uint32>  PenColor       := Modes/PenColor[Mode_rel], DialogType = "PenColor";
			attribute<int16>   PenWidth       := Modes/PenWidth[Mode_rel], DialogType = "PenWidth";
		}
		container MapView
		{
			unit<uint32>      OptionLinks                 := select_with_org_rel(OD_Option == 0 || Links/Optie == OD_Option), Descr = "The links of ModelParameters/OD_Option (0: all).";
			attribute<rdc>    geometry (arc, OptionLinks) := Links/geometry[OptionLinks/org_rel];
			attribute<string> Modaliteit    (OptionLinks) := Links/Modaliteit[OptionLinks/org_rel];
			attribute<Modes>  Mode_rel      (OptionLinks) := Links/Mode_rel[OptionLinks/org_rel];
			attribute<uint32> PenColor      (OptionLinks) := Links/PenColor[OptionLinks/org_rel], DialogType = "PenColor";
			attribute<int16>  PenWidth      (OptionLinks) := Links/PenWidth[OptionLinks/org_rel], DialogType = "PenWidth";
		}
		container        Chart     := for_each_ne(Moments/name, 'Series_T(Options, Group, ' + string(id(Moments)) + '[Moments])');

		// The comparison with the run of the whole model (#135): the rows of the pair in this output against those of the same pair in the
		// output of the component in the run with OutputLabel OD_CompareLabel. That folder has the signature of the pair without the parts of
		// the pair (FullSignature), and the pair is in the file of the block of its origin (FullRun/BlockFile). Both files are read with the
		// readers of ComponentMerge, and a row is the same when every column of their common schema (CompareColumns) is equal.
		container Compare : Descr = "The rows of the pair per departure moment against those in the output of the whole model (#135); Report sums it up."
		{
			parameter<string> FullSignature := replace(Out/Signature, /NetworkSetup/PublicTransport_Prep/PT_Chains_ODTag, '', ModelParameters/Impl/OrgSet_SelectionTag, '', ModelParameters/Impl/DestSet_SelectionTag, '')
			,	Descr = "The signature of the output of the component in the run of the whole model: that of the pair without its chains and without its origin and destination in the sets.";
			container         FullHash      := /Templates/StringHash_T(FullSignature);
			parameter<string> FullDir       := '%LocalDataProjDir%/Output/' + ModelParameters/Impl/Analysis_date + '_' + (Out/TimeInvariant ? replace(ModelParameters/Impl/OrgSet_PathTag, ModelParameters/Impl/OrgSet_SelectionTag, '') : ModelParameters/OD_CompareLabel) + /Classifications/Components/OutputSuffix[Out/Comp_rel] + '_' + FullHash/Hex
			,	Descr = "The folder of the whole model, named as CompOutput_T/Dir names it: with OD_CompareLabel, or for WW and CC with the origin set without the origin of the pair.";
			container         FullSig       := /Templates/Signature_T(FullDir, FullDir + '/signature.txt', FullSignature, /NetworkSetup/GenerateOutput/MaxSubPathLength)
			,	Descr = "The signature in the folder of the whole model; an error says that the folder is missing or that its run had other settings.";
			parameter<string> ExportClass   := /Classifications/Components/ExportClass[Out/Comp_rel];
			parameter<bool>   CompBike      := NeedsBike, Descr = "NeedsBike of the component, under a name that the readers do not use themselves.";
			// A component with one file per block (FileMoment) is compared once, any other per departure moment.
			unit<uint32> FileMoments := range(uint32, 0, FileMoment != '' ? 1u : #Moments)
			{
				attribute<string> Short := FileMoment != '' ? const(FileMoment, .) : Moments/Short[value(id(.), Moments)];
				attribute<string> name  := 'tt_' + Short;
			}
			container PerMoment := for_each_ne(FileMoments/name, 'CompareMoment_T(' + quote(FileMoments/Short) + ')');
			Template CompareMoment_T
			{
				parameter<string> MomentShort;
				///
				parameter<string> PairFile := Out/Sig/ForReading + '/PerBlock/tt_' + MomentShort + '_1of1.parquet';
				parameter<string> FullFile := FullSig/ForReading + '/PerBlock/tt_' + MomentShort + '_' + FullRun/BlockFile + '.parquet';
				container         Read     := for_each_ne(Sides/name, '/NetworkSetup/ComponentMerge/Read' + ExportClass + '_T(' + Sides/FileItem + ', ' + quote(CompName) + ', CompBike)');
				attribute<string> PairKey (Read/Pair/domain) := =asList('string(Read/Pair/' + CompareColumns/name + ')', ' + ''|'' + ');
				attribute<string> FullKey (Read/Full/domain) := =asList('string(Read/Full/' + CompareColumns/name + ')', ' + ''|'' + ');
				container         Rows     := CompareRows_T(Read/Pair/domain, Read/Pair/OrgName, Read/Pair/DestName, PairKey, Read/Full/domain, Read/Full/OrgName, Read/Full/DestName, FullKey);
			}
			attribute<uint32> NrPairRows (FileMoments) := ='union_data(FileMoments, ' + asList('PerMoment/' + FileMoments/name + '/Rows/NrPairRows', ', ') + ')';
			attribute<uint32> NrFullRows (FileMoments) := ='union_data(FileMoments, ' + asList('PerMoment/' + FileMoments/name + '/Rows/NrFullRows', ', ') + ')';
			attribute<bool>   IsEqual    (FileMoments) := ='union_data(FileMoments, ' + asList('PerMoment/' + FileMoments/name + '/Rows/IsEqual', ', ') + ')';
			// Only with both folders the files are read; otherwise Report says which output is missing.
			parameter<bool>   HasPair                  := Out/Sig/IsChecked, Descr = "Is there output of the pair with the current settings?";
			parameter<bool>   HasFull                  := FullSig/IsChecked, Descr = "Is there output of the whole model with the same settings (FullDir)?";
			parameter<bool>   AllEqual                 := = HasPair && HasFull ? 'all(IsEqual)' : 'FALSE';
			parameter<string> CountsText               := CompName + ': ' + (all(IsEqual) ? 'gelijk' : 'VERSCHIL') + ' (' + asList(FileMoments/Short + ' ' + string(NrPairRows) + ' rijen van het paar, ' + string(NrFullRows) + ' van het model', '; ') + ')';
			parameter<string> Report                   := = HasPair && HasFull ? 'CountsText' : quote(CompName + ': geen uitvoer van ' + (HasPair ? 'het hele model met dezelfde instellingen in ' + FullDir : 'het paar met de huidige instellingen in ' + Out/Dir))
			,	Descr = "Per departure moment the number of rows of the pair in its own output and in that of the whole model, and whether they are the same; or which output is missing.";
		}
	}
	container         PerComponent      := for_each_ne(Comps/name, 'Component_T(' + quote(Comps/name) + ')'), Descr = "The output of every component in MergeComponents, read back per departure moment.";

	// The block of the origin in the run of the whole model, as NetworkSetup/impl/OrgBlockSelections chooses it there: with the same random
	// permutation of all origins of Orgset and the same block size (#135).
	container FullRun : Descr = "The block file of the origin of the pair in the output of the run of the whole model (#135)."
	{
		unit<uint32>      Orgs      := =/NetworkSetup/PublicTransport_Prep/impl/Org_domain
		{
			attribute<.>  rnd_rel := rnd_permutation(0, .);
		}
		parameter<Orgs>   Org_rel   := rlookup(ModelParameters/OD_Origin, Orgs/name);
		parameter<uint32> Block_nr  := uint32(Orgs/rnd_rel[Org_rel]) / ModelParameters/Advanced/MaxOrgBlockSize;
		parameter<string> BlockFile := string(Block_nr + 1) + 'of' + string(ModelParameters/Advanced/NumberOfOrgBlocks_All);
	}
	unit<uint8> Sides : nrofrows = 2, Descr = "The two files of a comparison: the output of the pair and the block file of the whole model."
	{
		attribute<string> name     : ['Pair', 'Full'];
		attribute<string> FileItem : ['PairFile', 'FullFile'];
	}
	unit<uint8> CompareColumns : nrofrows = 21, Descr = "The columns of the common schema of the readers of ComponentMerge, apart from OrgName and DestName."
	{
		attribute<string> name : ['Traveltime', 'Price', 'Price_Augm', 'ModeUsed', 'NeedsCar', 'NeedsBike', 'WaitingTime', 'PretransTime', 'PosttransTime', 'TravelDist_Bus', 'TravelDist_Metro', 'TravelDist_Tram', 'TravelDist_Rail', 'TravelDist_Ferry', 'TravelDist_Car', 'TravelDist_V', 'TravelDist_N', 'PretransPrice', 'PosttransPrice', 'TransferWalkTime', 'PTWaitTime'];
	}
	unit<uint8> MergedColumns : nrofrows = 34, Descr = "The columns of the merged output after OrgName and DestName, as ComponentMerge writes them (Parquet/tt)."
	{
		attribute<string> name : ['Traveltime', 'Price', 'Price_Augm', 'ModeUsed', 'NeedsCar', 'NeedsBike', 'WaitingTime', 'PretransTime', 'PosttransTime', 'TravelDist_Bus', 'TravelDist_Metro', 'TravelDist_Tram', 'TravelDist_Rail', 'TravelDist_Ferry', 'TravelDist_Car', 'Component'
		                         , 'TravelDist_V', 'TravelDist_N', 'PTTime', 'PretransPrice', 'PTPrice', 'PosttransPrice', 'TravelDist_PT', 'TravelDist_Walking', 'TravelDist_Cycling', 'WalkingTime', 'CyclingTime', 'CarTime', 'WalkingPrice', 'CyclingPrice', 'CarPrice'
		                         , 'InVehicleTime', 'TransferWalkTime', 'PTWaitTime'];
	}

	// The core of a comparison (#135): the rows of the pair in a file of its own output and in the block file of the whole model, each with a
	// key of all compared columns. The two are equal when every different row occurs equally often in both.
	Template CompareRows_T
	{
		unit<uint32>      PairDomain;
		attribute<string> PairOrgName  (PairDomain);
		attribute<string> PairDestName (PairDomain);
		attribute<string> PairRowKey   (PairDomain);
		unit<uint32>      FullDomain;
		attribute<string> FullOrgName  (FullDomain);
		attribute<string> FullDestName (FullDomain);
		attribute<string> FullRowKey   (FullDomain);
		///
		unit<uint32> PairRows := select_with_org_rel(PairOrgName == ModelParameters/OD_Origin && PairDestName == ModelParameters/OD_Destination)
		{
			attribute<string> Key := PairRowKey[org_rel];
		}
		unit<uint32> FullRows := select_with_org_rel(FullOrgName == ModelParameters/OD_Origin && FullDestName == ModelParameters/OD_Destination)
		{
			attribute<string> Key := FullRowKey[org_rel];
		}
		unit<uint32> AllRows := union_unit(PairRows, FullRows)
		{
			attribute<string> Key := union_data(., PairRows/Key, FullRows/Key);
		}
		unit<uint32> Keys := unique(AllRows/Key), Descr = "The different rows of both files, with how often each occurs in the output of the pair and in that of the whole model."
		{
			attribute<uint32> NrPair := pcount_uint32(rlookup(PairRows/Key, values));
			attribute<uint32> NrFull := pcount_uint32(rlookup(FullRows/Key, values));
		}
		parameter<uint32> NrPairRows  := #PairRows;
		parameter<uint32> NrFullRows  := #FullRows;
		parameter<uint32> NrDifferent := sum_uint32(Keys/NrPair != Keys/NrFull), Descr = "The number of different rows that do not occur equally often in both files.";
		parameter<bool>   IsEqual     := all(Keys/NrPair == Keys/NrFull);
	}
	// A file of the merged output, with all its columns.
	Template ReadMerged_T
	{
		parameter<string> FileName;
		///
		unit<uint32> domain : StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "true"
		{
			attribute<string>  OrgName;
			attribute<string>  DestName;
			attribute<float32> Traveltime;
			attribute<float32> Price;
			attribute<float32> Price_Augm;
			attribute<string>  ModeUsed;
			attribute<uint8>   NeedsCar;
			attribute<uint8>   NeedsBike;
			attribute<float32> WaitingTime;
			attribute<float32> PretransTime;
			attribute<float32> PosttransTime;
			attribute<uint32>  TravelDist_Bus;
			attribute<uint32>  TravelDist_Metro;
			attribute<uint32>  TravelDist_Tram;
			attribute<uint32>  TravelDist_Rail;
			attribute<uint32>  TravelDist_Ferry;
			attribute<uint32>  TravelDist_Car;
			attribute<string>  Component;
			attribute<uint32>  TravelDist_V;
			attribute<uint32>  TravelDist_N;
			attribute<float32> PTTime;
			attribute<float32> PretransPrice;
			attribute<float32> PTPrice;
			attribute<float32> PosttransPrice;
			attribute<uint32>  TravelDist_PT;
			attribute<uint32>  TravelDist_Walking;
			attribute<uint32>  TravelDist_Cycling;
			attribute<float32> WalkingTime;
			attribute<float32> CyclingTime;
			attribute<float32> CarTime;
			attribute<float32> WalkingPrice;
			attribute<float32> CyclingPrice;
			attribute<float32> CarPrice;
			attribute<float32> InVehicleTime;
			attribute<float32> TransferWalkTime;
			attribute<float32> PTWaitTime;
		}
	}

	container Compare : Descr = "The comparison of every component of the variant and of their merge with the run of the whole model (#135); per departure moment in PerComponent/<component>/Compare and Merged."
	{
		attribute<bool>   IsEqual (Comps) := ='union_data(Comps, ' + asList('PerComponent/' + Comps/name + '/Compare/AllEqual', ', ') + ')';
		attribute<string> Report  (Comps) := ='union_data(Comps, ' + asList('PerComponent/' + Comps/name + '/Compare/Report', ', ') + ')';

		// The merge: its signature holds the hashes of the components ([name:hash]), so that of the whole model follows from theirs
		// (PerComponent/<component>/Compare/FullHash); its folder is named as NetworkSetup/ComponentMerge_Def/Dir names it.
		container Merged : Descr = "The merged output of the pair per departure moment against that of the whole model."
		{
			parameter<string> FullCompHashes := =asList('''[' + Comps/name + ':'' + PerComponent/' + Comps/name + '/Compare/FullHash/Hex + '']''', ' + ');
			parameter<string> FullSignature  := replace(/NetworkSetup/ComponentMerge_Def/Signature, /NetworkSetup/ComponentMerge_Def/CompHashes, FullCompHashes, ModelParameters/Impl/OrgSet_SelectionTag, '')
			,	Descr = "The signature of the merged output of the whole model: that of the pair with the hashes of the components of the whole model and without the origin of the pair in the set.";
			container         FullHash       := /Templates/StringHash_T(FullSignature);
			parameter<string> FullDir        := '%LocalDataProjDir%/Output/' + ModelParameters/Impl/Analysis_date + '_' + ModelParameters/OD_CompareLabel + '_Merged' + string(ModelParameters/MergeRunNr) + (any(Comps/UsesCycling) ? ModelParameters/Impl/CyclingNetwork_DirTag : '') + '_' + FullHash/Hex;
			container         FullSig        := /Templates/Signature_T(FullDir, FullDir + '/signature.txt', FullSignature, /NetworkSetup/GenerateOutput/MaxSubPathLength);
			container         PairSig        := /Templates/Signature_T(/NetworkSetup/ComponentMerge_Def/Dir, /NetworkSetup/ComponentMerge_Def/Dir + '/signature.txt', /NetworkSetup/ComponentMerge_Def/Signature, /NetworkSetup/GenerateOutput/MaxSubPathLength);
			container         PerMoment      := for_each_ne(Moments/name, 'CompareMoment_T(' + quote(Moments/Short) + ')');
			Template CompareMoment_T
			{
				parameter<string> MomentShort;
				///
				parameter<string> PairFile := PairSig/ForReading + '/PerBlock/tt_' + MomentShort + '_1of1.parquet';
				parameter<string> FullFile := FullSig/ForReading + '/PerBlock/tt_' + MomentShort + '_' + FullRun/BlockFile + '.parquet';
				container         Read     := for_each_ne(Sides/name, 'ReadMerged_T(' + Sides/FileItem + ')');
				attribute<string> PairKey (Read/Pair/domain) := =asList('string(Read/Pair/domain/' + MergedColumns/name + ')', ' + ''|'' + ');
				attribute<string> FullKey (Read/Full/domain) := =asList('string(Read/Full/domain/' + MergedColumns/name + ')', ' + ''|'' + ');
				container         Rows     := CompareRows_T(Read/Pair/domain, Read/Pair/domain/OrgName, Read/Pair/domain/DestName, PairKey, Read/Full/domain, Read/Full/domain/OrgName, Read/Full/domain/DestName, FullKey);
			}
			attribute<uint32> NrPairRows (Moments) := ='union_data(Moments, ' + asList('PerMoment/' + Moments/name + '/Rows/NrPairRows', ', ') + ')';
			attribute<uint32> NrFullRows (Moments) := ='union_data(Moments, ' + asList('PerMoment/' + Moments/name + '/Rows/NrFullRows', ', ') + ')';
			attribute<bool>   IsEqual    (Moments) := ='union_data(Moments, ' + asList('PerMoment/' + Moments/name + '/Rows/IsEqual', ', ') + ')';
			parameter<bool>   HasPair              := PairSig/IsChecked, Descr = "Is there merged output of the pair with the current settings?";
			parameter<bool>   HasFull              := FullSig/IsChecked, Descr = "Is there merged output of the whole model with the same settings (FullDir)?";
			parameter<bool>   AllEqual             := = HasPair && HasFull ? 'all(IsEqual)' : 'FALSE';
			parameter<string> CountsText           := 'Merged: ' + (all(IsEqual) ? 'gelijk' : 'VERSCHIL') + ' (' + asList(Moments/Short + ' ' + string(NrPairRows) + ' rijen van het paar, ' + string(NrFullRows) + ' van het model', '; ') + ')';
			parameter<string> Report               := = HasPair && HasFull ? 'CountsText' : quote('Merged: geen uitvoer van ' + (HasPair ? 'het hele model met dezelfde instellingen in ' + FullDir : 'het paar met de huidige instellingen in ' + /NetworkSetup/ComponentMerge_Def/Dir))
			,	Descr = "Per departure moment the number of rows of the pair in its merged output and in that of the whole model, and whether they are the same; or which output is missing.";
		}
		parameter<bool>   AllEqual        := all(IsEqual) && Merged/AllEqual;
		parameter<string> ReportText      := asList(Report, '\n') + '\n' + Merged/Report, Descr = "The reports of the components and of the merge, one per line.";
	}
	unit<uint8>       Comps_Er          := Comps;

	container Combined : Descr = "The options of all components merged per departure moment into one front, as ComponentMerge does, with their links and chart."
	{
		unit<uint32> Candidates := ='union_unit(' + AsItemList('PerComponent/' + Comps_Er/name + '/Options') + ')'
		{
			attribute<Comps_Er> Comp_rel   := ='union_data(., ' + AsItemList('const(' + string(id(Comps_Er)) + '[Comps_Er], PerComponent/' + Comps_Er/name + '/Options)') + ')';
			attribute<string>   Component  := Comps_Er/name[Comp_rel];
			attribute<Moments>  Moment_rel := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/Moment_rel') + ')';
			attribute<uint32>   Optie      := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/Optie') + ')';
			attribute<string>   Vertrek    := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/Vertrek') + ')';
			attribute<float32>  Reistijd   := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/Reistijd') + ')';
			attribute<float32>  Prijs      := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/Prijs') + ')';
			attribute<string>   ModeUsed   := ='union_data(., ' + AsItemList('PerComponent/' + Comps_Er/name + '/Options/ModeUsed') + ')';
			attribute<bool>     NeedsCar   := Comps_Er/NeedsCar[Comp_rel];
			attribute<bool>     NeedsBike  := Comps_Er/NeedsBike[Comp_rel];
			// The criteria of the merge (MergeCriteria), as in NetworkSetup/ComponentMerge: price and time in Ct and s.
			attribute<Ct>       Price_ct   := rounded_convert(Prijs[Euro], Ct);
			attribute<s>        Time_s     := rounded_convert(Reistijd[min_f], s);
			parameter<bool>     WithPrice  := IsDefined(strpos(lowercase(MergeCriteria), 'price'));
			parameter<bool>     WithTime   := IsDefined(strpos(lowercase(MergeCriteria), 'time'));
			parameter<bool>     WithCar    := IsDefined(strpos(lowercase(MergeCriteria), 'car'));
			parameter<bool>     WithBike   := IsDefined(strpos(lowercase(MergeCriteria), 'bike'));
			// pareto_optimal_eps(group, crit1, crit2, eps2, ...): the first criterion and a bool have no epsilon (Classifications/OutputParetoAttr/ParetoArgs).
			attribute<bool>     keep       := = 'pareto_optimal_eps(Moment_rel'
			                                  + (WithPrice ? ', Price_ct' : '') + (WithTime ? ', Time_s' + (WithPrice ? ', /ModelParameters/Advanced/ChainParetoTimeEpsilon' : '') : '')
			                                  + (WithCar ? ', NeedsCar' : '') + (WithBike ? ', NeedsBike' : '') + ')';
		}
		unit<uint32> Options := select_with_org_rel(Candidates/keep)
		{
			attribute<string>  Component  := Candidates/Component[org_rel];
			attribute<Moments> Moment_rel := Candidates/Moment_rel[org_rel];
			attribute<uint32>  Optie      := Candidates/Optie[org_rel], Descr = "The option in the output of the component.";
			attribute<string>  Vertrek    := Candidates/Vertrek[org_rel];
			attribute<float32> Reistijd   := Candidates/Reistijd[org_rel];
			attribute<float32> Prijs      := Candidates/Prijs[org_rel];
			attribute<string>  ModeUsed   := Candidates/ModeUsed[org_rel];
			attribute<string>  label      := Component + ' ' + string(Optie) + ' ' + Vertrek + ' ' + ModeUsed;
			attribute<bool>    NeedsCar   := Candidates/NeedsCar[org_rel];
			attribute<bool>    NeedsBike  := Candidates/NeedsBike[org_rel];
			attribute<Usage>   Usage_rel  := NeedsCar ? (NeedsBike ? Usage/V/MetAutoFiets : Usage/V/MetAuto) : (NeedsBike ? Usage/V/MetFiets : Usage/V/ZonderAutoFiets);
		}
		// The links of the chosen options, from the links of their component.
		unit<uint32> Links := ='union_unit(' + AsItemList('CompLinks/' + Comps_Er/name + '/Sel') + ')'
		{
			attribute<string> Component      := ='union_data(., ' + AsItemList('const(' + quote(Comps_Er/name) + ', CompLinks/' + Comps_Er/name + '/Sel)') + ')';
			attribute<uint32> Optie          := ='union_data(., ' + AsItemList('CompLinks/' + Comps_Er/name + '/Sel/Optie') + ')';
			attribute<string> Modaliteit     := ='union_data(., ' + AsItemList('CompLinks/' + Comps_Er/name + '/Sel/Modaliteit') + ')';
			attribute<rdc>    geometry (arc) := ='union_data(., ' + AsItemList('CompLinks/' + Comps_Er/name + '/Sel/geometry') + ')';
			attribute<Modes>  Mode_rel       := rlookup(Modaliteit, Modes/name);
			attribute<uint32> PenColor       := Modes/PenColor[Mode_rel], DialogType = "PenColor";
			attribute<int16>  PenWidth       := Modes/PenWidth[Mode_rel], DialogType = "PenWidth";
		}
		container CompLinks := for_each_ne(Comps_Er/name, 'CompLinks_T(' + quote(Comps_Er/name) + ')');
		Template CompLinks_T
		{
			parameter<string> CompName;
			///
			unit<uint32>            L            := ='PerComponent/' + CompName + '/Links';
			// A link belongs to a chosen option when that option is of this component, with the same departure moment and number.
			attribute<MomentOption> Key_L    (L) := combine_data(MomentOption, L/Moment_rel, value(L/Optie, OptionNrs));
			attribute<bool>         IsChosen (L) := IsDefined(rlookup(Key_L, ChosenOptions/OptionKey));
			unit<uint32> ChosenOptions := select_with_org_rel(Options/Component == CompName)
			{
				attribute<MomentOption> OptionKey := combine_data(MomentOption, Options/Moment_rel[org_rel], value(Options/Optie[org_rel], OptionNrs));
			}
			unit<uint32> Sel := select_with_org_rel(IsChosen)
			{
				attribute<uint32> Optie          := L/Optie[org_rel];
				attribute<string> Modaliteit     := L/Modaliteit[org_rel];
				attribute<rdc>    geometry (arc) := L/geometry[org_rel];
			}
		}
		container Chart     := for_each_ne(MomentGroup/name, 'Series_T(Options, ' + string(MomentGroup/Group_rel) + '[Usage], ' + string(MomentGroup/Moment_rel) + '[Moments])');
	}
}
