container Validation
: using = "units;Classifications;SourceData"
, Descr = "Validation of the public transport chains against 9292.nl, stop to stop (ObjectVision/NetworkModel_PBL#53, skill model-validatie): for the stop pairs in StopPairs, Rows holds the chains of the chain cache that depart between DepartFrom and DepartUntil, with departure, arrival, travel time, price, trip surcharge (Price_S, the ICD/ICE surcharge that 9292 leaves out of the price) and ModeUsed, and Write writes all its columns to %LocalDataProjDir%/Output/validatie_*.csv; it reads only the block caches of the departure stops, or with ReadCache FALSE calculates those blocks itself without writing them, to test without a chain cache."
{
	parameter<string> FileStem                  := '%LocalDataProjDir%/Output/validatie_'+ModelParameters/Impl/GTFS_file_date+'_'+ModelParameters/Impl/Analysis_date, Descr = "Path of the csv without extension: validatie_<feed date>_<analysis date> in %LocalDataProjDir%/Output.";
	parameter<bool>   ReadCache                 := TRUE, Descr = "TRUE reads the blocks from the chain cache (PublicTransport_Prep/PT_Chains_Blocks); FALSE calculates them in memory (ChainGeneration_PerBlock/<block>/BlockResultContainer/Result) without writing them.";
	parameter<Time>   DepartFrom                := /ModelParameters/Impl/PT_FirstDepartureMoment, Descr = "Start of the departure window: the first departure moment of the model.";
	parameter<Time>   DepartUntil               := value(uint32(DepartFrom) + 3600, Time), Descr = "End of the departure window, one hour after DepartFrom.";

	unit<uint32>      Stops                     := /NetworkSetup/PublicTransport_Prep/impl/Stops;
	unit<uint32>      BlockDomain               := /NetworkSetup/PublicTransport_Prep/impl/BlockDomain;

	// Stop pairs by GTFS name (Stops/name); all stops with that name count (platforms, both directions).
	unit<uint32> StopPairs : nrofrows = 8
	{
		attribute<string> kind      : ['HSL', 'HSL', 'HSL ICD1800', 'NS', 'grens VIAS', 'grens DB', 'Waterbus', 'eilandbus'];
		attribute<string> from_stop : ['Schiphol Airport', 'Amsterdam Zuid', 'Hilversum', 'Amsterdam Zuid', 'Arnhem Centraal', 'Enschede', 'Dordrecht, Merwekade', 'Nes, Veerhaven'];
		attribute<string> to_stop   : ['Rotterdam Centraal', 'Rotterdam Centraal', 'Rotterdam Centraal', 'Utrecht Centraal', 'Zevenaar', 'Glanerbrug', 'Rotterdam, Erasmusbrug', 'Hollum, Amelander Kaap'];
	}
	// join_equal_values does not take strings, so the pairs are joined via the number of the stop name.
	unit<uint32>      Names                     := unique(Stops/name);
	attribute<Names>  Stop_Name_rel     (Stops) := rlookup(Stops/name, Names/values);
	attribute<Names>  From_Name_rel (StopPairs) := rlookup(StopPairs/from_stop,  Names/values);
	attribute<Names>  To_Name_rel   (StopPairs) := rlookup(StopPairs/to_stop, Names/values);
	parameter<bool>   Check_Names               := all(IsDefined(From_Name_rel) && IsDefined(To_Name_rel))
	, IntegrityCheck = "Check_Names", Descr = "Does every from and to name in StopPairs exist as a stop name in the feed?";

	unit<uint32> FromStops := join_equal_values_uint32(From_Name_rel, Stop_Name_rel)
	{
		attribute<StopPairs>   Pair_rel  := first_rel;
		attribute<Stops>       Stop_rel  := second_rel;
		attribute<BlockDomain> Block_rel := value(/NetworkSetup/PublicTransport_Prep/impl/BlockSelections/rnd_rel[Stop_rel] / ModelParameters/Advanced/MaxStopBlockSize, BlockDomain), Descr = "The stop block of this stop in the chain step, chosen as ChainGeneration_PerBlock_T does.";
	}
	unit<uint32> ToStops := join_equal_values_uint32(To_Name_rel, Stop_Name_rel)
	{
		attribute<uint64> key := uint64(first_rel) * uint64(#Stops) + uint64(second_rel);
	}
	unit<uint32> CacheBlocks := unique(FromStops/Block_rel)
	{
		attribute<string> name        := BlockDomain/name[values];
		attribute<string> source_path := (ReadCache ? '/NetworkSetup/PublicTransport_Prep/PT_Chains_Blocks/PerBlock/' : '/NetworkSetup/PublicTransport_Prep/ChainGeneration_PerBlock/')
		                                 + name + (ReadCache ? '/Read' : '/BlockResultContainer/Result');
	}

	unit<uint64> CacheChains := ='union_unit_uint64(' + AsItemList(CacheBlocks/source_path) + ')'
	{
		attribute</NetworkSetup/PublicTransport_Prep/uq_c_FromTime_Stop> uq_c_FromTime_Stop_rel := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/uq_c_FromTime_Stop_rel') + ')';
		attribute</NetworkSetup/PublicTransport_Prep/uq_c_ToTime_Stop> uq_c_ToTime_Stop_rel := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/uq_c_ToTime_Stop_rel') + ')';
		attribute<s>      Traveltime    := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/Traveltime') + ')';
		attribute<Ct>     Price         := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/Price') + ')';
		attribute<Ct>     Price_S       := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/Price_S') + ')';
		attribute<uint32> ModeCode      := ='union_data(., ' + AsItemList(CacheBlocks/source_path + '/ModeCode') + ')';
		unit<uint32> UqModeCode := unique_uint32(ModeCode)
		{
			unit<uint8>       CD       := /Classifications/GTFS_Modes/CodeDigits;
			attribute<string> ModeUsed := CD/abbr[value(values / 65536u % 16u, CD)] + CD/abbr[value(values / 4096u % 16u, CD)] + CD/abbr[value(values / 256u % 16u, CD)] + CD/abbr[value(values / 16u % 16u, CD)] + CD/abbr[value(values % 16u, CD)];
		}
		attribute<string> ModeUsed      := UqModeCode/ModeUsed[rlookup(ModeCode, UqModeCode/values)], Descr = "The mode letters per leg, from ModeCode in the chain cache.";
		attribute<Stops>  From_Stop_rel := /NetworkSetup/PublicTransport_Prep/uq_c_FromTime_Stop/From_Stop_rel[uq_c_FromTime_Stop_rel];
		attribute<Time>   From_Time_rel := /NetworkSetup/PublicTransport_Prep/uq_c_FromTime_Stop/From_Time_rel[uq_c_FromTime_Stop_rel];
		attribute<Stops>  To_Stop_rel   := /NetworkSetup/PublicTransport_Prep/uq_c_ToTime_Stop/To_Stop_rel[uq_c_ToTime_Stop_rel];
		attribute<Time>   To_Time_rel   := /NetworkSetup/PublicTransport_Prep/uq_c_ToTime_Stop/To_Time_rel[uq_c_ToTime_Stop_rel];
	}

	// Chains from a departure stop of a pair to an arrival stop of the same pair, within the departure window.
	unit<uint64> Candidates := join_equal_values_uint64(CacheChains/From_Stop_rel, FromStops/Stop_rel)
	{
		attribute<StopPairs> Pair_rel   := FromStops/Pair_rel[second_rel];
		attribute<uint64>    to_key     := uint64(Pair_rel) * uint64(#Stops) + uint64(CacheChains/To_Stop_rel[first_rel]);
		attribute<bool>      IsSelected := IsDefined(rlookup(to_key, ToStops/key)) && CacheChains/From_Time_rel[first_rel] >= DepartFrom && CacheChains/From_Time_rel[first_rel] <= DepartUntil;
	}
	unit<uint64> Rows := select_with_org_rel(Candidates/IsSelected)
	, StorageName = "=FileStem+'.csv'", StorageType = "gdalwrite.vect"
	{
		attribute<string>  soort      := StopPairs/kind[Candidates/Pair_rel[org_rel]];
		attribute<string>  van        := StopPairs/from_stop[Candidates/Pair_rel[org_rel]];
		attribute<string>  naar       := StopPairs/to_stop[Candidates/Pair_rel[org_rel]];
		attribute<string>  vertrek    := Time/Label[CacheChains/From_Time_rel[Candidates/first_rel[org_rel]]];
		attribute<string>  aankomst   := Time/Label[CacheChains/To_Time_rel[Candidates/first_rel[org_rel]]];
		attribute<float32> reistijd   := float32(CacheChains/Traveltime[Candidates/first_rel[org_rel]]) / 60f, Descr = "Travel time of the chain in minutes, including any transfer penalties.";
		attribute<float32> prijs      := float32(CacheChains/Price[Candidates/first_rel[org_rel]]) / 100f, Descr = "Price in euro, including the trip surcharge.";
		attribute<float32> rit_opslag := float32(CacheChains/Price_S[Candidates/first_rel[org_rel]]) / 100f, Descr = "Price_S in euro: the ICD/ICE surcharge, which 9292 leaves out of the price.";
		attribute<string>  ModeUsed   := CacheChains/ModeUsed[Candidates/first_rel[org_rel]];
	}

	parameter<string> Write                     := 'Validation: ' + string(#Rows) + ' ketens voor ' + string(#StopPairs) + ' haltenparen', ExplicitSuppliers = "Rows", Descr = "Calculating this item writes Rows with all its columns to FileStem.csv.";
}
