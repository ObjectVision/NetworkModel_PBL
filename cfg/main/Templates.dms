container Templates: Using = "Units;Geography;Classifications"
{      
	#include<CreateNetwerk_Basic_T.dms> //network creation basic, used for determining congestion speeds
	#include<PrivateTransport_Car_T.dms>
	#include<CreateNetwork_Pedestrian_Bike_T.dms>
	#include<CreateNetwork_Efficient_T.dms>   //network creation with part that omits JFS, and dead branches
	#include<CreateNetwork_TomTom_T.dms>   //network creation without optimisation. Used for TomTom with Directions
	#include<Check_Connectiveness_T.dms>
	#include<Check_Connectiveness_T_adhoc.dms>
	#include<doDateSelection_T.dms>
	
	#include<ReadMergeExports_OV_perType_T.dms>
	#include<Merge_Regions_OV_T.dms>
	#include<ReadExport_OV_perTime_T.dms>
	#include<RouteLinks_T.dms> // RouteLinks_T: the links of routes from a LinkSet, in the OD pair mode (#129)
	#include<StoreNames_T.dms> // StringHash_T and StoreSignature_T: short names for stores and output (NetworkModel_PBL#118)
	
	unit<SPoint> Neighbourhood := range(spoint, point_xy(int16(-1), int16(-1)), point_xy(int16(2), int16(2))), Descr = "Rooks case contiguous neighbours (first order)"
	{
		attribute<uint32> Top     := uint32(id(.) = point_xy(int16(0),int16(1),spoint));
		attribute<uint32> Right   := uint32(id(.) = point_xy(int16(1),int16(0),spoint));
		attribute<uint32> Bottom  := uint32(id(.) = point_xy(int16(0),int16(-1),spoint));
		attribute<uint32> Left    := uint32(id(.) = point_xy(int16(-1),int16(0),spoint));
	}
	
	Template GTFS_getTimes_T : Descr = "Converts the GTFS times hh:mm:ss of TimesString to Time_rel; an hour beyond the last hour of Time wraps around to the start of Time."
	{
		unit<uint32>      inVector;
		attribute<string> TimesString (inVector);
		
		unit<uint32> TimesVector := inVector
		{
			attribute<uint32> hour_sep := strpos(TimesString, ':');
			attribute<uint32> sec_sep  := strrpos(TimesString, ':');
			attribute<uint32> hour     := uint32(substr(TimesString, 0, hour_sep));
			attribute<uint32> min      := uint32(substr(TimesString, hour_sep + 1, sec_sep - hour_sep - 1));
			attribute<uint32> sec      := uint32(substr(TimesString, sec_sep + 1, 2));
			attribute<uint32> hoursyst := hour <= max(Time/Hour) ? hour : sub_or_null(hour, max(Time/Hour) + 1);
			attribute<Time>   Time_rel  := ((hoursyst * 60 * 60) + (min * 60) + sec)[Time];
		}
	}

	// Date arithmetic without a date type: a date yyyymmdd as a day number, the number of days since 1 January 1970, and back. This way
	// the day before 20241001 is 20240930 and not 20241000. The formulas are those of the Gregorian calendar (H. Hinnant, days_from_civil
	// and civil_from_days), in uint32, valid from 1 March 1970.
	Template DayNr_T : Descr = "Converts a date yyyymmdd to a day number, the number of days since 1970-01-01, and gives its weekday."
	{
		unit<uint32>      Dom;
		attribute<uint32> yyyymmdd (Dom);
		//
		attribute<uint32> Y       (Dom) := yyyymmdd / 10000;
		attribute<uint32> M       (Dom) := (yyyymmdd / 100) % 100;
		attribute<uint32> D       (Dom) := yyyymmdd % 100;
		attribute<uint32> y_mar   (Dom) := Y - uint32(M <= 2), Descr = "The year that starts on 1 March.";
		attribute<uint32> era     (Dom) := y_mar / 400;
		attribute<uint32> yoe     (Dom) := y_mar - era * 400;
		attribute<uint32> doy     (Dom) := (153 * ((M + 9) % 12) + 2) / 5 + D - 1;
		attribute<uint32> doe     (Dom) := yoe * 365 + yoe / 4 - yoe / 100 + doy;
		attribute<uint32> DayNr   (Dom) := era * 146097 + doe - 719468, Descr = "Days since 1970-01-01.";
		attribute<uint32> Weekday (Dom) := (DayNr + 3) % 7, Descr = "0 = Monday, as in Units/Weekdays.";
	}

	Template CivilDate_T : Descr = "Converts a day number, the number of days since 1970-01-01, back to a date yyyymmdd."
	{
		unit<uint32>      Dom;
		attribute<uint32> DayNr (Dom);
		//
		attribute<uint32> z        (Dom) := DayNr + 719468;
		attribute<uint32> era      (Dom) := z / 146097;
		attribute<uint32> doe      (Dom) := z - era * 146097;
		attribute<uint32> yoe      (Dom) := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
		attribute<uint32> doy      (Dom) := doe - (365 * yoe + yoe / 4 - yoe / 100);
		attribute<uint32> mp       (Dom) := (5 * doy + 2) / 153;
		attribute<uint32> D        (Dom) := doy - (153 * mp + 2) / 5 + 1;
		attribute<uint32> M        (Dom) := (mp + 2) % 12 + 1;
		attribute<uint32> Y        (Dom) := yoe + era * 400 + uint32(M <= 2);
		attribute<uint32> yyyymmdd (Dom) := Y * 10000 + M * 100 + D;
	}
}