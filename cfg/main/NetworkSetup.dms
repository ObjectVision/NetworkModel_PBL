container NetworkSetup : using = "units;Geography;SourceData;Classifications;ModelParameters"
{     
	#include<PublicTransport_Prep.dms>
	#include<ComponentMerge.dms>

	container impl
	{
		parameter<string> Org_str := PublicTransport_Prep/impl/Org_unit, Descr = "The path of the origins: Orgset, or for an OD pair its one origin (#129).";

		unit<uint32> OrgBlockSelections := =Org_str
		{
			attribute<.> rnd_rel := rnd_permutation(0, .);
			attribute<OrgBlockDomain> OrgBlock_rel := value(rnd_rel / ModelParameters/Advanced/MaxOrgBlockSize, OrgBlockDomain), Descr = "The origin block of this origin, on which ConfigurationPerOrgBlock_T/org and the direct trips per block (PublicTransport/Direct_OD) select.";
			attribute<OrgParts>       OrgPart_rel  := value((uint32(rnd_rel) % ModelParameters/Advanced/MaxOrgBlockSize) / ModelParameters/Impl/OrgPartSize, OrgParts), Descr = "The part of its block that this origin is in (ModelParameters/Impl/OrgBlockParts): like the block, a contiguous range of rnd_rel.";
		}
		unit<uint8> OrgParts := range(uint8, 0b, ModelParameters/Impl/OrgBlockParts)
		, Descr = "The parts in which the output step calculates every origin block (ModelParameters/Impl/OrgBlockParts, #117); one part is the whole block."
		{
			attribute<string> name := 'Part' + string(id(.) + 1b) + 'of' + string(#.);
		}

		// The direct trips of all origins (PublicTransport_Prep/Direct_OD) with what does not depend on the block, calculated once: the places of
		// origin and destination, the ownership the trip needs, and the origin block and its part; every part of a block selects its rows from it
		// (PublicTransport/PerPart/<part>/Direct_OD).
		unit<uint64> Direct_OD := PublicTransport_Prep/Direct_OD
		{
			attribute<s>    Duration_seconds := PublicTransport_Prep/Direct_OD/Duration_seconds;
			attribute<dam>  Distance         := PublicTransport_Prep/Direct_OD/Distance;
			attribute<ct>   Price            := PublicTransport_Prep/Direct_OD/Price;
			attribute<ct>   Price_Augm       := PublicTransport_Prep/Direct_OD/Price_Augm;
			attribute<OrgBlockSelections> OrgZone_rel := PublicTransport_Prep/Direct_OD/OrgZone_rel, Descr = "The origin in the full set of origins, as PublicTransport_Prep/Impl/Places/Origin_rel.";
			attribute<PublicTransport_Prep/impl/dest> DstZone_rel := PublicTransport_Prep/Direct_OD/DstZone_rel;
			attribute<PublicTransport_Prep/impl/Modes> Mode_rel := PublicTransport_Prep/Direct_OD/Mode_rel;
			attribute<bool> NeedsCar         := Mode_rel == PublicTransport_Prep/impl/Modes/V/Car, Descr = "Criterion of the final front: the trip needs a car (Classifications/OwnershipParetoAttr, #117).";
			attribute<bool> NeedsBike        := Mode_rel == PublicTransport_Prep/impl/Modes/V/Cycling, Descr = "Criterion of the final front: the trip needs a bike (Classifications/OwnershipParetoAttr, #117).";
			attribute<PublicTransport_Prep/impl/Places> From_Place_rel := rlookup(OrgZone_rel, PublicTransport_Prep/impl/Places/Origin_rel);
			attribute<PublicTransport_Prep/impl/Places> To_Place_rel := rlookup(DstZone_rel, PublicTransport_Prep/impl/Places/Dest_rel);
			attribute<OrgBlockDomain> OrgBlock_rel := OrgBlockSelections/OrgBlock_rel[OrgZone_rel];
			attribute<OrgParts>       OrgPart_rel  := OrgBlockSelections/OrgPart_rel[OrgZone_rel];
		}

		// The pre-transport and post-transport of all origins, from the caches of the legs (PublicTransport_Prep/Legs), united once over the types of
		// the component (PT_PreTransport_Types, PT_PostTransport_Types); every part of an origin block selects its pre-transport legs on the block
		// and the part (PublicTransport/PerPart/<part>/V), and uses all post-transport legs (PublicTransport/N).
		unit<uint64> V_org := ='union_unit_uint64('+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix', ',')+')'
		, Descr = "The pre-transport legs of all origins, over the pre-transport types of the component."
		{
			attribute<PublicTransport_Prep/impl/Places> From_Place_rel := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/From_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Places> To_Place_rel   := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/To_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Modes>  Mode_rel       := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/Mode_rel', ',')+')';
			attribute<VN_ModeClasses/Uq>                ModeClass_rel  := ='union_data(., '+asList('const('+string(rlookup(ModelParameters/Impl/PT_PreTransport_Types/ExportName, /classifications/VN_ModeClasses/Uq/name))+'[VN_ModeClasses/Uq], PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix)', ',')+')';
			attribute<s>                                impedance      := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/Duration_seconds_ext[s]', ',')+')';
			attribute<s>                                impedance_net  := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/impedance[s]', ',')+')', Descr = "Network travel time of the leg without start and parking time, which the Max*Time limits test, as does the cut of the Dijkstra search.";
			attribute<dam>                              Distance       := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/Distance', ',')+')';
			attribute<ct>                               Price          := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PreTransport_Types/name+'/ODMatrix/Price', ',')+')';
			attribute<OrgBlockSelections>               OrgZone_rel    := PublicTransport_Prep/impl/Places/Origin_rel[From_Place_rel], Descr = "The origin of the leg in the full set of origins, empty if the leg does not start at an origin.";
			attribute<OrgBlockDomain>                   OrgBlock_rel   := OrgBlockSelections/OrgBlock_rel[OrgZone_rel];
			attribute<OrgParts>                         OrgPart_rel    := OrgBlockSelections/OrgPart_rel[OrgZone_rel];
		}
		attribute<bool>   IsVStop (PublicTransport_Prep/impl/Places) := pcount(V_org/To_Place_rel) > 0u64
		, Descr = "Whether a pre-transport leg of the component ends at this place, because the output reads from the chain cache only the chains that board at such a stop (PublicTransport_Prep/PT_V).";
		
		unit<uint64> N := ='union_unit_uint64('+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix', ',')+')'
		, Descr = "The post-transport legs to all destinations, over the post-transport types of the component."
		{
			attribute<PublicTransport_Prep/impl/Places> From_Place_rel := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/From_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Places> To_Place_rel := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/To_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Modes> Mode_rel := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/Mode_rel', ',')+')';
			attribute<VN_ModeClasses/Uq> ModeClass_rel := ='union_data(., '+asList('const('+string(rlookup(ModelParameters/Impl/PT_PostTransport_Types/ExportName, /classifications/VN_ModeClasses/Uq/name))+'[VN_ModeClasses/Uq], PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix)', ',')+')';
			attribute<s>      impedance     := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/Duration_seconds_ext[s]', ',')+')';
			attribute<s>      impedance_net := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/impedance[s]', ',')+')', Descr = "Network travel time of the leg without start and parking time, which the Max*Time limits test, as does the cut of the Dijkstra search.";
			attribute<dam>    Distance      := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/Distance', ',')+')';
			attribute<ct>     Price         := ='union_data(., '+asList('PublicTransport_Prep/Legs/'+ModelParameters/Impl/PT_PostTransport_Types/name+'/ODMatrix/Price', ',')+')';
			attribute<string> DestName      := PublicTransport_Prep/impl/Places/label[To_Place_rel]; //debug
		}
		unit<uint32> OrgBlockDomain := range(0, ModelParameters/Advanced/NumberOfOrgBlocks)
		{
			attribute<string> name        := 'Block_'+string(id(.)+1)+'of'+string(max(id(.))+1);
			attribute<string> FileName    := string(id(.)+1)+'of'+string(max(id(.))+1), Descr = "The block in the name of the output per block, PerBlock/tt_<moment>_<n>of<N>.csv (#118).";
			attribute<uint64> BlockOffset := min_elem(uint64(id(.)) * uint64(ModelParameters/Advanced/MaxOrgBlockSize), uint64(#OrgBlockSelections));
			attribute<uint64> BlockEnd    := min_elem(BlockOffset + uint64(ModelParameters/Advanced/MaxOrgBlockSize), uint64(#OrgBlockSelections));
			attribute<uint32> BlockSize   := uint32(BlockEnd - BlockOffset);
		}
	}

	container GenerateOutput
	{	
		// The signature of the public transport output (#118, #145). The output is in ModelParameters/Impl/OutputDir,
		// Output/<Analysis_date>_<PartOfDay>_<OutputLabel>_<component>_<hash>, with the hash of the signature in the name, as the caches have it, so that output
		// made with other settings has a folder of its own; only departure moment and block are in the file names, and all parameters in
		// <OutputDir>/signature.txt. The writer per block (PublicTransport/PerDepartureMoment_T, LongFormat/File) writes it and refuses a folder with a
		// different signature; the readers and mergers (ReadExport_OV_perTime_T, Merge_Regions_OV_T, Merge_Times, PostAnalysis/FindMedian,
		// ComponentMerge) refuse to read when it is missing or differs, so that a collision of the hash gives an error. The chain cache and the car
		// cache belong to it, because the output is calculated from their content.
		//
		// CompOutput_T gives for one component the signature of its output, the hash and the folder, the same in every run: the run uses it for its
		// own component (ThisComp), the merge for every component of the variant (ComponentMerge_Def/PerComp), and Output/FrontCheck and
		// Output/OD_PairRoutes for the components they read. What it uses besides the component therefore does not depend on the component of the
		// run: the signatures of the chain cache and of the car cache follow from the part of the day and the variant
		// (PublicTransport_Prep/PT_Chains_Signature, Impl/CarSignatureMoment). A setting that changes the output is in the signature of the
		// components that use it, with its value, also the default, and a setting that does not change it is not, so that runs that differ only
		// in such a setting share the output: WW and CC carry neither the part of the day nor OutputLabel (Classifications/Components/
		// TimeInvariant), and with parquet the prices that the merge computes are in its signature (ComponentMerge_Def/DirectPriceTag).
		Template CompOutput_T : Descr = "The signature, hash and folder of the output of one component (#145), the same in every run."
		{
			parameter<string> CompName;
			///
			parameter</Classifications/Components> Comp_rel := rlookup(CompName, /Classifications/Components/name), IntegrityCheck = "IsDefined(this)";
			parameter<bool>   WithPT      := /Classifications/Components/WithPT[Comp_rel];
			parameter<bool>   IsWW        := /Classifications/Components/DirectWalking[Comp_rel];
			parameter<bool>   IsCC        := /Classifications/Components/DirectCycling[Comp_rel];
			parameter<bool>   IsCar       := /Classifications/Components/DirectCar[Comp_rel];
			parameter<bool>   UsesCycling := /Classifications/Components/UsesCycling[Comp_rel];
			parameter<bool>   IsOVF       := WithPT && IsDefined(strpos(/Classifications/Components/PostTransport[Comp_rel], 'OVF'));
			parameter</Classifications/TimeInvariantTypes> Pre_rel  := rlookup(/Classifications/Components/PreTransport[Comp_rel], /Classifications/TimeInvariantTypes/name);
			parameter</Classifications/TimeInvariantTypes> Post_rel := rlookup(/Classifications/Components/PostTransport[Comp_rel], /Classifications/TimeInvariantTypes/name);

			parameter<string> CombinationType := 'V-' + (WithPT ? /Classifications/Components/PreCode[Comp_rel] + '_N-' + /Classifications/Components/PostCode[Comp_rel] : /Classifications/Components/DirectCode[Comp_rel])
			,	Descr = "The pre- and post-transport type of a public transport component (V-W_N-ovfC), or the direct trip (V-WW).";
			parameter<bool>   CarCriterion  := IsCar && IsDefined(strpos(lowercase(/ModelParameters/MinimiseCriteria), 'car'));
			parameter<bool>   BikeCriterion := /Classifications/Components/NeedsBike[Comp_rel] && IsDefined(strpos(lowercase(/ModelParameters/MinimiseCriteria), 'bike'));
			parameter<string> MinCrit       := asList(/Classifications/ComponentParetoAttr/FileNameElement, '_') + (CarCriterion ? '_A' : '') + (BikeCriterion ? '_C' : '')
			,	Descr = "The criteria of the front of the component: MinimiseCriteria, with A and C for the ownership criteria that apply to it, as Classifications/OutputParetoAttr in a run of the component.";
			parameter<bool>   TimeInvariant := /Classifications/Components/TimeInvariant[Comp_rel], Descr = "Does the output not depend on the departure moment (WW, CC)? Then the moment, the criteria of a front and OutputLabel are not in its signature and folder, so that every part of the day and every variant label reads the same output.";
			parameter<bool>   IsCsv         := /ModelParameters/OutputFormat == 'csv', Descr = "Is the output csv, which writes all columns, the prices and the distances included, so that their settings are in the signature?";
			parameter<string> CarPriceTag   := IsCar ? '_car' + (/ModelParameters/Advanced/IncludeCarCostsInPrice ? string(round(/ModelParameters/Car_CostPerKm * 100f)) + 'ctkm' + (/ModelParameters/Car_FixedCosts_PerTrip > 0[Euro] ? '-p' + string(round(/ModelParameters/Car_FixedCosts_PerTrip * 100f)) + 'ct' : '') : '0') : ''
			,	Descr = "The price of the direct car trip in ct per km and, when not 0, per trip (#88); _car0 when Advanced/IncludeCarCostsInPrice is off.";
			parameter<string> SettingsTag   :=
				  (IsWW   ? '_WW-max' + string(/ModelParameters/MaxWalkingTime_Org2Dest) + 'min' + (IsCsv ? /NetworkSetup/ComponentMerge_Def/WalkingPriceTag : '') + '-' + /ModelParameters/Impl/WalkingNetwork_Tag : '')
				+ (IsCC   ? '_CC-max' + string(/ModelParameters/MaxCyclingTime_Org2Dest) + 'min-start' + string(/ModelParameters/Cycling_StartTime) + 'min' + (IsCsv ? /NetworkSetup/ComponentMerge_Def/CyclingPriceTag : '') + '-' + /ModelParameters/Impl/CyclingNetwork_Tag : '')
				+ (WithPT ? '_PT-maxtt' + string(/ModelParameters/MaxTravelTime) + 'min-waitmax' + string(/ModelParameters/Advanced/MaxWaitingTimeAtOrigin) + 's-waitintt' + string(uint8(/ModelParameters/Advanced/IncludeWaitingAtHomeInTravelTime)) + '-inprice' + string(uint8(/ModelParameters/Advanced/IncludeWalkingCostsInPrice)) + string(uint8(/ModelParameters/Advanced/IncludeCyclingCostsInPrice))
				          + '_V-' + /Classifications/TimeInvariantTypes/OutputSignatureTag[Pre_rel] + '_N-' + /Classifications/TimeInvariantTypes/OutputSignatureTag[Post_rel] : '')
				+ (IsCar  ? '_Car-start' + string(/ModelParameters/Car_StartTime) + 'min-park' + string(/ModelParameters/Car_ParkingTime) + 'min' : '')
				+ (/Classifications/Components/SingleDepartureMoment_Eff[Comp_rel] && !TimeInvariant ? '_dep' + /ModelParameters/Impl/SingleDepartureMoment_Shrt : '')
				+ '_median' + string(uint8(/ModelParameters/Advanced/MakeMedian))
				+ /ModelParameters/Impl/OrgDest_Tag
			,	Descr = "The settings that change the output of this kind of component and are in no cache it reads (#145): the maximum times and networks of its trips and legs, the costs where the output holds the price, a single departure moment where the trip depends on it, and the placing of the origins and destinations.";
			parameter<string> ParamTag      :=
				'_DEST-' + /ModelParameters/Impl/DestSet_string_nodate + '_' + CombinationType
				+ (WithPT ? '_Trsf-' + string(/ModelParameters/Max_transfers) : '')
				+ (TimeInvariant ? '' : '_MinCrit-' + MinCrit)
				+ (WithPT ? '_MaxPT-' + string(/ModelParameters/MaxPTTime) + 'min' + /ModelParameters/Impl/Flex_FileTag + /ModelParameters/Impl/TripSurcharge_FileTag : '')
				+ (IsCar ? /ModelParameters/Impl/ParetoLegs_Car_FileTag : '')
				+ CarPriceTag + (TimeInvariant ? '' : /ModelParameters/Impl/ChainPareto_FileTag)
				+ (IsOVF ? /ModelParameters/Impl/OVFiets_FileTag : '')
				+ (UsesCycling ? /ModelParameters/Impl/CyclingNetwork_FileTag : '')
				+ SettingsTag
			,	Descr = "The parameters of the output after date and origin set: destination set, modes, the criteria and epsilon of the front (not for WW and CC, which have one route per pair), the tags and SettingsTag.";
			parameter<string> CarSignature  := = IsCar ? '''_'' + /NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + /ModelParameters/Impl/CarSignatureMoment + '/Signature' : ''''''
			,	Descr = "The signature of the car cache that the direct car trip reads, with a _ in front; empty for another component.";
			// With parquet the format tag _parquet-s3- stands for the columns in whole seconds, with the distances and prices of the pre- and
			// post-transport (#144) and the walking and waiting at transfers (#146); the kind of component after it sets the columns.
			parameter<string> Signature     :=
				'tt_' + /ModelParameters/Impl/Analysis_date + '_ORG-' + /ModelParameters/Impl/OrgSet_string + ParamTag
				+ (IsCsv ? '_export' + (/ModelParameters/Export_TravelledDistance ? '-dist' : '') + (/ModelParameters/Export_PriceInformation ? '-price' : '') : '')
				+ (WithPT ? '_' + /NetworkSetup/PublicTransport_Prep/PT_Chains_Signature : '')
				+ CarSignature
				+ (/ModelParameters/OutputFormat == 'parquet' ? '_parquet-s3-' + /Classifications/Components/ExportClass[Comp_rel] : '')
			,	Descr = "The signature of the output of the component: date, origin set, ParamTag, with csv the exported columns (parquet always has all columns of its kind), the signatures of the chain cache (with WithPT) and the car cache, and with parquet the format and the kind of component.";
			container         Hash          := /Templates/StringHash_T(Signature);
			parameter<string> Dir           := '%LocalDataProjDir%/Output' + /ModelParameters/Impl/OD_Tag + '/' + /ModelParameters/Impl/Analysis_date + '_' + (TimeInvariant ? /ModelParameters/Impl/OrgSet_PathTag : /ModelParameters/PartOfDay + '_' + /ModelParameters/OutputLabel) + /Classifications/Components/OutputSuffix[Comp_rel] + '_' + Hash/Hex
			,	Descr = "The output folder of the component: date, part of the day and OutputLabel (for WW and CC only the origin set, OrgSet_PathTag, because they do not depend on the part of the day), the component (with _fb on the Fietsersbond network) and the hash of Signature.";
			container         Sig           := /Templates/Signature_T(Dir, Dir + '/signature.txt', Signature, /NetworkSetup/GenerateOutput/MaxSubPathLength)
			,	Descr = "The signature in the folder, which a reader of the output of the component checks (Sig/ForReading).";
		}
		container         ThisComp             := CompOutput_T(/ModelParameters/Impl/ComponentName), Descr = "The output of the component of this run; not used when merging.";
		parameter<uint32> MaxSubPathLength     := strlen('/PerBlock/tt_') + max_elem(max(strlen(/ModelParameters/Impl/MeasureMoments/FileTag)), strlen('mediaan')) + 1 + max(strlen(impl/OrgBlockDomain/FileName)) + strlen(/ModelParameters/Impl/OutputExt)
		, Descr = "The length of the longest path in an output folder after its name: PerBlock/tt_<moment>_<n>of<N>.csv or .parquet.";

		parameter<string> Output_Signature_Run := ThisComp/Signature, Descr = "The signature of the output of the component of this run (CompOutput_T).";
		parameter<string> Output_Signature     := =/ModelParameters/Impl/IsMerged ? 'ComponentMerge_Def/Signature' : 'Output_Signature_Run', Descr = "The signature of the output folder: Output_Signature_Run of a run, or for the component Merged (#117) that of ComponentMerge, with the hashes of the merged components.";

		container         Output_Sig           := /Templates/Signature_T(
		                                          /ModelParameters/Impl/OutputDir
		                                          , /ModelParameters/Impl/OutputDir + '/signature.txt'
		                                          , Output_Signature
		                                          , MaxSubPathLength
		                                          )
		, Descr = "The signature in the output folder, which the writer per block writes (checking also the longest path, PerBlock/tt_<moment>_<n>of<N>.csv or .parquet) and the readers and mergers check.";
	
		parameter<string> OutputDir_ForBatch   := replace(expand(., /ModelParameters/Impl/OutputDir), '/', '\\'), StorageName = "%ConfigDir%/../../batch/log/output_dir.txt", StorageType = "str"
		, Descr = "The output folder for batch/UpdateAll.cmd, which removes the files of the model from it before the output step (tt_*.csv, tt_*.xml and the signature).";

		// Is the output of this run complete? Then batch/UpdateAll.cmd skips it. The folder must hold the signature of the current settings, the
		// counts file of every origin block with origins (Tellingen, written with the last file of the block), and the counts of all blocks
		// (od_tellingen.csv, which OD_Counts_FromFiles writes after the last portion).
		parameter<string> OutputDir_Expanded   := expand(., /ModelParameters/Impl/OutputDir);
		attribute<bool>   BlockDone (impl/OrgBlockDomain) := impl/OrgBlockDomain/BlockSize == 0 || ExistingFile('', OutputDir_Expanded + '/Tellingen/tellingen_' + impl/OrgBlockDomain/FileName + '.csv') != ''
		, Descr = "Does the origin block have its counts file, or no origins?";
		parameter<bool>   IsComplete           := Output_Sig/IsChecked && all(BlockDone) && ExistingFile('', OutputDir_Expanded + '/od_tellingen.csv') != ''
		, Descr = "Is the output of this run complete: the signature of the current settings, the counts of every block, and od_tellingen.csv?";
		container ForBatch : Descr = "IsComplete for batch/UpdateAll.cmd, without a metadata file beside it, because with the global ExportSettings/MetaInfo the write of this file does not finish."
		{
			container ExportSettings { container MetaInfo; }
			parameter<string> IsComplete := ../IsComplete ? 'complete' : 'incomplete', StorageName = "%ConfigDir%/../../batch/log/output_complete.txt", StorageType = "str"
			, Descr = "complete or incomplete; batch/UpdateAll.cmd skips the output step of a complete component.";
		}

		// The counts of all origin blocks in the output folder, od_tellingen.csv and unieke_od_tellingen.csv, added up from the counts file that
		// the output or the merge of every block writes (Tellingen/tellingen_<n>of<N>.csv), so that the output step in portions needs nothing
		// beside GeoDMS: batch/WriteOutputBlocks.ps1 requests Generate after the last portion. A single request of the output makes the same two
		// files itself (ConfigurationPerBlock/Generate_Output/OD_Counts). The origin blocks each have their own origins, so the counts of the
		// blocks add up, the unique pairs too. The two files get no metadata beside them, as in ForBatch: that would run git in this GeoDmsRun.
		container OD_Counts_FromFiles
		:	Descr = "The counts of all origin blocks, added up from the counts files of the blocks in Tellingen and written as od_tellingen.csv and unieke_od_tellingen.csv."
		{
			container         ExportSettings { container MetaInfo; }
			unit<uint32>      Blocks       := select_with_org_rel(impl/OrgBlockDomain/BlockSize > 0)
			,	Descr = "The origin blocks with origins; each writes a counts file."
			{
				attribute<string> name     := impl/OrgBlockDomain/name[org_rel];
				attribute<string> FileName := impl/OrgBlockDomain/FileName[org_rel];
			}
			unit<uint32>      Moments      := /ModelParameters/Impl/MeasureMoments;
			unit<uint8>       Kinds        := Classifications/OD_Counts_Kind;
			unit<uint8>       Groups       := Classifications/OD_Counts_Group;
			// the fields of a line of a counts file: the table (rijen or paren), the kind or group, a count per departure moment and the total
			unit<uint32>      Fields       := range(uint32, 0, #Moments + 3)
			{
				attribute<string> name     := 'F' + string(id(.));
			}
			unit<uint32>      Counts       := range(uint32, 0, #Moments + 1)
			{
				attribute<string> name     := 'F' + string(id(.) + 2);
			}
			parameter<string> MomentHeader := asList(Moments/FileTag, ';');
			parameter<string> Header       := 'tabel;naam;' + MomentHeader + ';totaal', Descr = "The header of a counts file of this run.";

			container PerBlock := for_each_ne(Blocks/name, 'Block_T(' + quote(Blocks/FileName) + ')');
			Template Block_T : Descr = "The counts file of one origin block: its header, the lines of the kinds of rows and the lines of the groups of pairs."
			{
				parameter<string> FileName;
				///
				parameter<string> Path               := /ModelParameters/Impl/OutputDir + '/Tellingen/tellingen_' + FileName + '.csv';
				parameter<string> Text               : StorageName = "=Path", StorageType = "str", StorageReadOnly = "true";
				parameter<string> HeaderLine         := readLines(Text, void, 0u64);
				attribute<string> KindLine  (Kinds)  := readLines(Text, Kinds, HeaderLine/ReadPos);
				attribute<string> GroupLine (Groups) := readLines(Text, Groups, KindLine/ReadPos);
			}

			Template Sum_T : Descr = "The lines of one table (Kinds or Groups) of all blocks, their fields, and per kind or group the sum over the blocks of every count."
			{
				unit<uint8>       Classes;
				parameter<string> LineName;
				parameter<string> Table;
				///
				unit<uint32> Lines := combine_unit_uint32(Blocks, Classes)
				{
					attribute<string>  Line      := ='union_data(., ' + asList('PerBlock/' + Blocks/name + '/' + LineName, ',') + ')';
					attribute<Classes> Class_rel := second_rel(id(.));
					container          Field     := for_each_nedv(Fields/name, 'ReadElems(Line, string, ' + MakeDefined(Fields/name[sub_or_null(id(Fields), 1)] + '/ReadPos', 'const(0, Lines)') + ', 16)', Lines, string);
				}
				container         Sum                 := for_each_nedv(Counts/name, 'sum(uint64(Lines/Field/' + Counts/name + '), Lines/Class_rel)', Classes, uint64);
				parameter<bool>   IsConsistent        := all(Lines/Field/F0 == Table && Lines/Field/F1 == Classes/label[Lines/Class_rel]);
				attribute<string> OutLine   (Classes) := ='Classes/label + ' + asList(''';'' + string(Sum/' + Counts/name + ')', ' + ');
			}
			container         Kind         := Sum_T(Kinds,  'KindLine',  'rijen');
			container         Group        := Sum_T(Groups, 'GroupLine', 'paren');

			attribute<string> HeaderLine (Blocks) := ='union_data(Blocks, ' + asList('PerBlock/' + Blocks/name + '/HeaderLine', ',') + ')';
			parameter<bool>   IsConsistent := all(HeaderLine == Header) && Kind/IsConsistent && Group/IsConsistent
			,	Descr = "Does every counts file have the header of this run, and its lines in the order of Kinds and Groups?";
			parameter<string> File_RowCounts  := 'soort;' + MomentHeader + ';totaal\n' + asList(Kind/OutLine, '\n') + '\n'
			,	StorageName = "=/ModelParameters/Impl/OutputDir + '/od_tellingen.csv'", StorageType = "str", IntegrityCheck = "IsConsistent"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
			,	Descr = "Rows of the output per kind of option (Kinds), per departure moment and in total, over all blocks.";
			parameter<string> File_PairCounts := 'groep;' + MomentHeader + ';samen\n' + asList(Group/OutLine, '\n') + '\n'
			,	StorageName = "=/ModelParameters/Impl/OutputDir + '/unieke_od_tellingen.csv'", StorageType = "str", IntegrityCheck = "IsConsistent"
			,	ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
			,	Descr = "Unique OD pairs per group (Groups), per departure moment and over all moments together, over all blocks.";
			parameter<string> Generate        := 'Ready', ExplicitSuppliers = "File_RowCounts;File_PairCounts"
			,	Descr = "Writes od_tellingen.csv and unieke_od_tellingen.csv; batch/WriteOutputBlocks.ps1 requests it after the last portion.";
		}

		parameter<string> Generate_Output      := =/ModelParameters/Impl/IsMerged ? 'ComponentMerge/Generate' : 'ConfigurationPerBlock/Generate_Output/OUTPUT_Generate_PublicTransport_fullOD_long_CSVFiles'
		, Descr = "The output step of batch/UpdateAll.cmd: the output per block and departure moment with the counts, or for the component Merged the merge of the components of the variant (ComponentMerge, #117), whose counts over all blocks OD_Counts_FromFiles makes.";
	}
	

	container ConfigurationPerBlock :=
		for_each_ne(
			impl/OrgBlockDomain/name
			, 'ConfigurationPerOrgBlock_T('+string(id(impl/OrgBlockDomain))+')'
		)
	{
		container Generate_Output
		{
			// The counts as well (OD_Counts), in the same request: they use the results behind the fences of the blocks, which exist only in the
			// phase in which the blocks are calculated.
			parameter<string> OUTPUT_Generate_PublicTransport_fullOD_long_CSVFiles := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Generate',' + ') + ' + OD_Counts/Generate';

			// batch/WriteOutputBlocks.ps1 calculates the output in portions of blocks, one GeoDmsRun per portion, as WriteChainBlocks.ps1 does for the
			// chain step, because in one request for all blocks (above) the memory grows with every block. The counts over all blocks are then
			// made by GenerateOutput/OD_Counts_FromFiles.
			parameter<string> OutputBlocks_List                        := AsList(/ModelParameters/Impl/IsMerged
			                                                              ? '/NetworkSetup/ComponentMerge/PerBlock/' + /NetworkSetup/Impl/OrgBlockDomain/name + '/Fence/Generate'
			                                                              : '/NetworkSetup/ConfigurationPerBlock/' + /NetworkSetup/Impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Generate', '\n')
			, StorageName = "%ConfigDir%/../../batch/log/output_blocks.txt", StorageType = "str"
			, ExplicitSuppliers = "/NetworkSetup/GenerateOutput/Output_Sig/ForWriting"
			, Descr = "The requests per origin block, one per line, for batch/WriteOutputBlocks.ps1: the output per block, or for the component Merged the merge per block (ComponentMerge/PerBlock); through Output_Sig/ForWriting it first writes or checks the signature of the output folder and the longest path.";
			
			parameter<string> OutputBlocks_PerPortion                  := string(/ModelParameters/Impl/BlocksPerPortion)
			, StorageName = "%ConfigDir%/../../batch/log/output_blocks_per_portion.txt", StorageType = "str"
			, Descr = "Origin blocks per GeoDmsRun for batch/WriteOutputBlocks.ps1: Classifications/Components/BlocksPerPortion of the component, 0 = all blocks in one portion.";

			// Counts next to the public transport output, in <OutputDir>: od_tellingen.csv with the rows per kind of option and per departure moment
			// (and the total), and unieke_od_tellingen.csv with the unique OD pairs per group and per departure moment (and over all moments together).
			// The blocks each have their own origins, so the counts per block are added up.
			container OD_Counts
			{
				unit<uint8>       Kinds                          := Classifications/OD_Counts_Kind;
				unit<uint8>       Groups                         := Classifications/OD_Counts_Group;
				unit<uint32>      Moments                        := /ModelParameters/Impl/MeasureMoments;

				container         PerMoment                      := for_each_ne(Moments/Name, 'Moment_T(' + quote(Moments/Name) + ')');
				Template Moment_T
				{
					parameter<string> Moment;
					///
					attribute<uint64> RowCounts   (Kinds) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Counts/RowCounts/' + Moment, ' + ');
					attribute<uint64> PairCounts (Groups) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Counts/PairCounts/' + Moment, ' + ');
				}
				attribute<uint64> RowCounts_Total        (Kinds) := =asList('PerMoment/' + Moments/Name + '/RowCounts', ' + ');
				attribute<uint64> PairCounts_AllMoments (Groups) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Counts/PairCounts_AllMoments', ' + ');

				parameter<string> MomentHeader                   := asList(Moments/FileTag, ';');
				attribute<string> RowCountsLine          (Kinds) := ='Kinds/label + ' + asList(''';'' + string(PerMoment/' + Moments/Name + '/RowCounts)', ' + ') + ' + '';'' + string(RowCounts_Total)';
				attribute<string> PairCountsLine        (Groups) := ='Groups/label + ' + asList(''';'' + string(PerMoment/' + Moments/Name + '/PairCounts)', ' + ') + ' + '';'' + string(PairCounts_AllMoments)';
				parameter<string> File_RowCounts                 := 'soort;' + MomentHeader + ';totaal\n' + asList(RowCountsLine, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Impl/OutputDir + '/od_tellingen.csv'", StorageType = "str"
				,	Descr = "Rows of the public transport output per kind of option (Classifications/OD_Counts_Kind), per departure moment and in total.";
				parameter<string> File_PairCounts                := 'groep;' + MomentHeader + ';samen\n' + asList(PairCountsLine, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Impl/OutputDir + '/unieke_od_tellingen.csv'", StorageType = "str"
				,	Descr = "Unique OD pairs per group (Classifications/OD_Counts_Group), per departure moment and over all moments together.";
				parameter<string> Generate                       := File_RowCounts + File_PairCounts;
			}
			
			parameter<string> OUTPUT_Generate_Car_traveltimes_CSVFiles := PrivateTransport/Export_Car_Traveltimes;
		}
		
		container Merge_Output
		{
			container MergeRegions
			{
				parameter<string> OUTPUT_Merge_PublicTransport_Regions_fullOD_long_CSVFiles := ReadMergeExports_PublicTransport/OUTPUT_Merge_Regions;
			}
			container MergeTimes
			{			
				parameter<string> OUTPUT_Merge_PublicTransport_Times_fullOD_long_CSVFiles := ReadMergeExports_PublicTransport/OUTPUT_Merge_Times;
			}
		
			parameter<string> CombinationType := ModelParameters/Impl/PT_CombinationType;

			
			container ReadMergeExports_PublicTransport := Templates/ReadMergeExports_OV_perType_T(CombinationType,DestSet)
			{
				parameter<string> OUTPUT_Merge_Regions := Merge_Regions/OUTPUT_Merge_Regions;
				parameter<string> OUTPUT_Merge_Times   := 'Ready', ExplicitSuppliers = "Merge_Times/LongFormat/File_fullOD";
			}
		}	
	}

	Template ConfigurationPerOrgBlock_T 
	{
		parameter<NetworkSetup/impl/OrgBlockDomain> BlockDomain_id;
		////

		unit<uint32> org := select_with_org_rel(NetworkSetup/impl/OrgBlockSelections/OrgBlock_rel == BlockDomain_id)
		{
			attribute<rdc>     geometry       := NetworkSetup/impl/OrgBlockSelections/geometry[org_rel];
			attribute<string>  name           := NetworkSetup/impl/OrgBlockSelections/name[org_rel];
		}
		unit<uint32> dest := impl/dest_src
		{
			attribute<rdc> geometry := impl/dest_src/geometry;
		}
		
		container impl := PublicTransport_Prep/Impl
		{
			unit<uint32> org  := ../org;
			unit<uint32> dest := ../dest;
		} 
		
		container PublicTransport
		{
			#include<PublicTransport.dms>
		}
	}
	
	container PrivateTransport
	{
		parameter<string> Export_Walking_traveltimes := Walking/ExportTable_Traveltimes/File;
		parameter<string> Export_Cycling_traveltimes := Cycling/ExportTable_Traveltimes/File;
		parameter<string> Export_Car_traveltimes     := Car/ExportTable_Traveltimes/File;
		
		unit<uint32>      Org                        := PublicTransport_Prep/Impl/org;
		unit<uint32>      Dest                       := PublicTransport_Prep/Impl/dest;
		
		container Impl := ../impl
		{
			parameter<string> fileNamePrefix := ModelParameters/Impl/fileNamePrefix;
			parameter<string> fileNameSuffix :=
				'_ORG-'    + ModelParameters/Impl/OrgSet_PathTag +  
				'_DEST-'   + ModelParameters/Impl/DestSet_PathTag +
				'_NETWERK-@@' +
				'_MaxTime-##min';
		}
		
		Container Walking 
		{
			unit<uint32> LinkSet                           := PublicTransport_Prep/Create_Optimised_Network_Walking/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet := PublicTransport_Prep/Create_Optimised_Network_Walking/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.> OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
				attribute<.> DestNode_rel (dest) := rlookup(dest/geometry, geometry);
			}
				
			container    Calc_Traveltimes_maxspeed_Walking := Calc_Traveltimes_T(LinkSet, NodeSet, LinkSet/Impedance_per_ImpedanceType/max_Walking, LinkSet/Distance_per_ImpedanceType/max_Walking, ModelParameters/MaxWalkingTime_Org2Dest);
			
			unit<uint64> ExportTable_Traveltimes := Calc_Traveltimes_maxspeed_Walking/Traveltimes
			{
				attribute<org >   Org_rel           := OrgZone_rel;
				attribute<dest>   Dst_rel           := DstZone_rel;
				
				attribute<min_f>  DefaultSpeed_imp  := Impedance;
				attribute<km>     TravelledDistance := Alt_imp;
				
				attribute<string> BodyLines         :=
					org/name[Org_rel] + ';' + 
					dest/name[Dst_rel] + ';' +
					string(DefaultSpeed_imp) + ';' +
					string(TravelledDistance);
				parameter<string> File              := 'Org;Dst;Freeflow;AfgelegedeAfstand\n'++asList(BodyLines, '\n'), StorageName = "=impl/fileNamePrefix+'Traveltimes'+replace(impl/fileNameSuffix, '@@', 'Walking', '##',  string(ModelParameters/MaxWalkingTime_Org2Dest)) +'.csv'", StorageType = "str";
			}
		}
		
		Container Cycling
		{
			unit<uint32> LinkSet_Cycling                    := PublicTransport_Prep/Create_Optimised_Network_Cycling/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet_Cycling := PublicTransport_Prep/Create_Optimised_Network_Cycling/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.> OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
				attribute<.> DestNode_rel (dest) := rlookup(dest/geometry, geometry);
			}
			container    Calc_Traveltimes_maxspeed_Cycling  := Calc_Traveltimes_T(LinkSet_Cycling, NodeSet_Cycling, LinkSet_Cycling/Impedance_per_ImpedanceType/max_Cycling, LinkSet_Cycling/Distance_per_ImpedanceType/max_Cycling, ModelParameters/MaxCyclingTime_Org2Dest);

			unit<uint64> ExportTable_Traveltimes := Calc_Traveltimes_maxspeed_Cycling/Traveltimes
			{
				attribute<org >   Org_rel                 := OrgZone_rel;
				attribute<dest>   Dst_rel                 := DstZone_rel;

				attribute<min_f>  DefaultSpeed_imp        := Impedance;
				attribute<km>     TravelledDistance       := Alt_imp;

				attribute<string> BodyLines               :=
					org/name[Org_rel] + ';' +
					dest/name[Dst_rel] + ';' +
					string(DefaultSpeed_imp) + ';' +
					string(TravelledDistance);
				parameter<string> File                    := 'Org;Dst;Freeflow;AfgelegedeAfstand\n'++asList(BodyLines, '\n'), StorageName = "=impl/fileNamePrefix+'Traveltimes'+replace(impl/fileNameSuffix, '@@', 'Cycling', '##',  string(ModelParameters/MaxCyclingTime_Org2Dest)) +'.csv'", StorageType = "str";
			}
			
		}
		
		container         Car                        := Templates/PrivateTransport_Car_T(org, dest, true);
		
		Template Calc_Traveltimes_T
		{
			unit<uint32>     LinkSet_dom;
			unit<uint32>     NodeSet_dom;
			attribute<s_f>   impedance (LinkSet_dom);
			attribute<km>    distance  (LinkSet_dom);
			parameter<min_f> MaxTraveltime_min;
			///
			
			// In the OD pair mode (ModelParameters/Impl/IsOD, #129) the search also requests the LinkSet, and Links gives per trip the links of its route
			// (Templates/RouteLinks_T); the travel times are the same.
			unit<uint64> Traveltimes := ='impedance_matrix_od64(''bidirectional(link_flag);startPoint(Node_rel):max_imp;endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;od:impedance,OrgZone_rel,DstZone_rel'
			                            + (ModelParameters/Impl/IsOD ? ',LinkSet' : '') + '''
					, convert(impedance, min_f)
					, LinkSet_dom/F1
					, LinkSet_dom/F2
					, not(LinkSet_dom/IsOneDirection)
					, NodeSet_dom/OrgNode_rel
					, NodeSet_dom/DestNode_rel
					, MaxTraveltime_min
					, distance
				)'
			{
				attribute<string> Org_Dest := string(OrgZone_rel)+'_'+string(DstZone_rel);
			}
			// The searches use the one-way cycle paths of the Fietsersbond (not(IsOneDirection), #124); OSM walking and cycling have no one-way links.
			container Links := =ModelParameters/Impl/IsOD
			                   ? 'Templates/RouteLinks_T(Traveltimes, Traveltimes/LinkSet, LinkSet_dom, NodeSet_dom, LinkSet_dom/F1, LinkSet_dom/F2, NodeSet_dom/geometry, NodeSet_dom/DestNode_rel[Traveltimes/DstZone_rel])'
			                   : 'Templates/NoRouteLinks_T()'
			, Descr = "The links of the route of every trip, only in the OD pair mode (IsOD).";
			
			// The routes of all trips, also outside the OD pair mode, for inspection, with the line per route from RouteLinks_T.
			unit<uint64> Traveltimes_with_Linkset :=
				impedance_matrix_od64('bidirectional(link_flag);startPoint(Node_rel):max_imp;endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;od:impedance,OrgZone_rel,DstZone_rel,LinkSet'
					, convert(impedance, min_f)
					, LinkSet_dom/F1
					, LinkSet_dom/F2
					, not(LinkSet_dom/IsOneDirection)
					, NodeSet_dom/OrgNode_rel
					, NodeSet_dom/DestNode_rel
					, MaxTraveltime_min
					, distance
				)
			{
				attribute<string> Org_Dest         := string(OrgZone_rel)+'_'+string(DstZone_rel);
				attribute<rdc>    geometry   (arc) := TravelledJourney/geometry;
				container         TravelledJourney := Templates/RouteLinks_T(., LinkSet, LinkSet_dom, NodeSet_dom, LinkSet_dom/F1, LinkSet_dom/F2, NodeSet_dom/geometry, NodeSet_dom/DestNode_rel[DstZone_rel]);
			}
			
		}
	}
}
