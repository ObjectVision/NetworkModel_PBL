container NetworkSetup : using = "units;geometries;SourceData;Classifications;ModelParameters"
{     
	#include<PublicTransport_Prep.dms>
	#include<ComponentMerge.dms>
	// unit<uint32> quick_path := /NetworkSetup/ConfigurationPerRegio/all/PublicTransport/At_07h00m00s/Stops;

	container impl
	{
		parameter<string> Org_str           := rjoin(lowercase(/ModelParameters/Orgset), lowercase(Advanced/org_domain_list/label), Advanced/org_domain_list/path);

		unit<uint32> OrgBlockSelections := =Org_str
		{
			attribute<.>              rnd_rel       := rnd_permutation(0, .);
			attribute<OrgBlockDomain> OrgBlock_rel  := value(rnd_rel / ModelParameters/Advanced/MaxOrgBlockSize, OrgBlockDomain), Descr = "Het herkomstblok van deze herkomst: ConfigurationPerOrgBlock_T/org en de directe ritten per blok (PublicTransport/Direct_OD) kiezen hierop.";
		}

		// De directe ritten van alle herkomsten (PublicTransport_Prep/Direct_OD) met wat niet van het blok afhangt, een keer gerekend:
		// de plaatsen van herkomst en bestemming, het bezit dat de rit vraagt en het herkomstblok; elk blok kiest daaruit zijn rijen
		// (PublicTransport/Direct_OD). Tot 2026-10-07 rekende elk blok dat over de hele tabel (PublicTransport/Direct_OD_all), met
		// twee rlookups en een tekst per rij: voor Auto met Buurt2023 naar Buurt2023 779 miljoen rijen, 450 keer.
		unit<uint64> Direct_OD := PublicTransport_Prep/Direct_OD
		{
			attribute<s>                                    Duration_seconds := PublicTransport_Prep/Direct_OD/Duration_seconds;
			attribute<dam>                                  Distance         := PublicTransport_Prep/Direct_OD/Distance;
			attribute<ct>                                   Price            := PublicTransport_Prep/Direct_OD/Price;
			attribute<ct>                                   Price_Augm       := PublicTransport_Prep/Direct_OD/Price_Augm;
			attribute<OrgBlockSelections>                   OrgZone_rel      := PublicTransport_Prep/Direct_OD/OrgZone_rel, Descr = "De herkomst in de volledige herkomstenset, zoals PublicTransport_Prep/Impl/Places/Origin_rel.";
			attribute<PublicTransport_Prep/impl/dest>       DstZone_rel      := PublicTransport_Prep/Direct_OD/DstZone_rel;
			attribute<PublicTransport_Prep/impl/Modes>      Mode_rel         := PublicTransport_Prep/Direct_OD/Mode_rel;
			attribute<bool>                                 NeedsCar         := Mode_rel == PublicTransport_Prep/impl/Modes/V/Car, Descr = "Criterium van de eindafweging (Classifications/OwnershipParetoAttr, NetworkModel_PBL#117).";
			attribute<bool>                                 NeedsBike        := Mode_rel == PublicTransport_Prep/impl/Modes/V/Cycling, Descr = "Idem.";
			attribute<PublicTransport_Prep/impl/Places>     From_Place_rel   := rlookup(OrgZone_rel, PublicTransport_Prep/impl/Places/Origin_rel);
			attribute<PublicTransport_Prep/impl/Places>     To_Place_rel     := rlookup(DstZone_rel, PublicTransport_Prep/impl/Places/Dest_rel);
			attribute<OrgBlockDomain>                       OrgBlock_rel     := OrgBlockSelections/OrgBlock_rel[OrgZone_rel];
		}

		// Het voor- en natransport van alle herkomsten, een keer verenigd over de typen van de component (OV_PreTransport_Typen,
		// OV_PostTransport_Typen); elk blok kiest zijn voortransportbenen op het herkomstblok (PublicTransport/V) en gebruikt alle
		// natransportbenen (PublicTransport/N). Tot 2026-10-07 verenigde elk blok alle benen opnieuw, met voor elk voortransportbeen
		// de tekst OrgName en de keuze IsRelevantForOrgSubset.
		unit<uint64> V_org := ='union_unit_uint64('+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix', ',')+')'
		, Descr = "PreTransport"
		{
			attribute<PublicTransport_Prep/impl/Places> From_Place_rel   := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/From_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Places> To_Place_rel     := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/To_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Modes>  Mode_rel         := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/Mode_rel', ',')+')';
			attribute<VN_ModeClasses/Uq>                ModeClass_rel    := ='union_data(., '+asList('const('+string(rlookup(ModelParameters/Advanced/OV_PreTransport_Typen/ExportName, /classifications/VN_ModeClasses/Uq/name))+'[VN_ModeClasses/Uq], PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix)', ',')+')';
			attribute<s>                                impedance        := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/Duration_seconds_ext[s]', ',')+')';
			attribute<s>                                impedance_net    := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/impedance[s]', ',')+')', Descr = "Netwerkreistijd van het been, zonder start- en parkeertijd; hierop toetsen de Max*Time-grenzen, net als de cut van de Dijkstra.";
			attribute<dam>                              Distance         := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/Distance', ',')+')';
			attribute<ct>                               Price            := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PreTransport_Typen/name+'/Create_Routes/ODMatrix/Price', ',')+')';
			attribute<OrgBlockSelections>               OrgZone_rel      := PublicTransport_Prep/impl/Places/Origin_rel[From_Place_rel], Descr = "De herkomst van het been in de volledige herkomstenset; leeg als het been niet bij een herkomst begint.";
			attribute<OrgBlockDomain>                   OrgBlock_rel     := OrgBlockSelections/OrgBlock_rel[OrgZone_rel];
		}
		unit<uint64> N := ='union_unit_uint64('+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix', ',')+')'
		, Descr = "PostTransport"
		{
			attribute<PublicTransport_Prep/impl/Places> From_Place_rel   := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/From_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Places> To_Place_rel     := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/To_Place_rel', ',')+')';
			attribute<PublicTransport_Prep/impl/Modes>  Mode_rel         := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/Mode_rel', ',')+')';
			attribute<VN_ModeClasses/Uq>                ModeClass_rel    := ='union_data(., '+asList('const('+string(rlookup(ModelParameters/Advanced/OV_PostTransport_Typen/ExportName, /classifications/VN_ModeClasses/Uq/name))+'[VN_ModeClasses/Uq], PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix)', ',')+')';
			attribute<s>                                impedance        := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/Duration_seconds_ext[s]', ',')+')';
			attribute<s>                                impedance_net    := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/impedance[s]', ',')+')', Descr = "Netwerkreistijd van het been, zonder start- en parkeertijd; hierop toetsen de Max*Time-grenzen, net als de cut van de Dijkstra.";
			attribute<dam>                              Distance         := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/Distance', ',')+')';
			attribute<ct>                               Price            := ='union_data(., '+asList('PublicTransport_Prep/TimeInvariantConnections/'+ModelParameters/Advanced/OV_PostTransport_Typen/name+'/Create_Routes/ODMatrix/Price', ',')+')';
			attribute<string>                           DestName         := PublicTransport_Prep/impl/Places/label[To_Place_rel]; //debug
		}
		unit<uint32> OrgBlockDomain   := range(0, ModelParameters/Advanced/NumberOfOrgBlocks)
		{
			attribute<string> name          := 'Block_'+string(id(.)+1)+'of'+string(max(id(.))+1);
			attribute<string> FileName      := string(id(.)+1)+'of'+string(max(id(.))+1), Descr = "Het blok in de naam van de uitvoer per blok, PerBlock/tt_<datum>_<moment>_<n>of<N>.csv (sinds 2026-10-03 zonder 'Block_', NetworkModel_PBL#118).";
			attribute<uint64> BlockOffset   := min_elem(uint64(id(.)) * uint64(ModelParameters/Advanced/MaxOrgBlockSize), uint64(#OrgBlockSelections));
			attribute<uint64> BlockEnd      := min_elem(BlockOffset + uint64(ModelParameters/Advanced/MaxOrgBlockSize), uint64(#OrgBlockSelections));
			attribute<uint32> BlockSize     := uint32(BlockEnd - BlockOffset);
		}
	}

	// De handtekening van de OV-uitvoer (sinds 2026-10-03, NetworkModel_PBL#118). De uitvoer staat in ModelParameters/Advanced/OutputDir
	// (Output/<Analysis_date>_<OutputLabel>), met in de bestandsnamen alleen datum, vertrekmoment en blok; alle parameters staan in
	// <OutputDir>/signature.txt. De schrijver per blok (PublicTransport/PerDepartureMoment_T, LongFormat/File) schrijft hem en weigert
	// een map met een andere handtekening; de lezers en samenvoegers (ReadExport_OV_perTime_T, Merge_Regions_OV_T, Merge_Times,
	// PostAnalysis/FindMedian) weigeren te lezen als hij ontbreekt of afwijkt. De ketenstore en de autostore horen erbij, want de
	// uitvoer is uit hun inhoud gerekend.
	parameter<string> Output_CarSignature := = /ModelParameters/AllowDirectCar ? '''_''+/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + /ModelParameters/Car_CongestionMoment_ForDirect + '/Signature' : ''''''
	, Descr = "De handtekening van de autostore van de directe autorit (Car_CongestionMoment_ForDirect) met een _ ervoor, leeg zonder AllowDirectCar.";
	parameter<string> Output_Signature_Run :=
		  'tt_' + /ModelParameters/Analysis_date + '_ORG-' + /ModelParameters/Advanced/OrgSet_string + /ModelParameters/Advanced/PT_Output_ParamTag
		+ '_export' + (/ModelParameters/Export_TravelledDistance ? '-dist' : '') + (/ModelParameters/Export_PriceInformation ? '-price' : '')
		+ (/ModelParameters/Advanced/MetOV ? '_' + /NetworkSetup/PublicTransport_Prep/ChainStore_Signature : '')
		+ Output_CarSignature
	, Descr = "Handtekening van de OV-uitvoer: datum, herkomstenset en PT_Output_ParamTag (tot 2026-10-03 de bestandsnaam zonder vertrekmoment en blok), de kolommen (Export_TravelledDistance, Export_PriceInformation), en de handtekeningen van de ketenstore (alleen als het OV meedoet, Advanced/MetOV) en van de autostore.";
	parameter<string> Output_Signature := =/ModelParameters/Advanced/IsSamen ? 'ComponentMerge_Def/Signature' : 'Output_Signature_Run'
	, Descr = "De handtekening van de uitvoermap: Output_Signature_Run van een run, of bij Component 'Samen' (#117) die van ComponentMerge, met de handtekeningen van de samengevoegde componenten.";
	container Output_Sig := /Templates/StoreSignature_T(
		  /ModelParameters/Advanced/OutputDir
		, /ModelParameters/Advanced/OutputDir + '/signature.txt'
		, Output_Signature
		, strlen('/PerBlock/tt_' + /ModelParameters/Analysis_date + '_') + max(strlen(/ModelParameters/Advanced/MeasureMoments/TemplatableTextShrt)) + 1 + max(strlen(impl/OrgBlockDomain/FileName)) + strlen('.csv')
		)
	, Descr = "De handtekening in de uitvoermap: de schrijver per blok schrijft hem (en controleert het langste pad, PerBlock/tt_<datum>_<moment>_<n>of<N>.csv), de lezers en samenvoegers controleren hem.";
	parameter<string> OutputDir_ForBatch := replace(expand(., /ModelParameters/Advanced/OutputDir), '/', '\\'), StorageName = "%ConfigDir%/../../batch/log/output_dir.txt", StorageType = "str"
	, Descr = "De uitvoermap voor batch/UpdateAll.cmd output, dat er voor de uitvoerstap de bestanden van het model uit weghaalt (tt_*.csv, tt_*.xml en de handtekening).";

	parameter<string> Generate_Output := =/ModelParameters/Advanced/IsSamen ? 'ComponentMerge/Generate' : 'ConfigurationPerBlock/Generate_Output/OUTPUT_Generate_PublicTransport_fullOD_long_CSVFiles'
	, Descr = "De uitvoerstap (batch/UpdateAll.cmd output): de uitvoer per blok en vertrekmoment, met de tellingen, of bij Component 'Samen' het samenvoegen van de componenten (ComponentMerge; sinds 2026-10-05, #117). Bij Samen maakt batch/OdTellingen.py de tellingen.";

	container ConfigurationPerBlock := 
		for_each_ne(
			impl/OrgBlockDomain/name
			, 'ConfigurationPerOrgBlock_T('+string(id(impl/OrgBlockDomain))+')'
		)
	{
		container Generate_Output
		{
			// parameter<string> OUTPUT_Generate_PublicTransport_decay_CSVFiles        := =asList(Advanced/Regio/name+'/PublicTransport/Generate_Output/OUTPUT_Generate_decay_CSVFiles',' + ');
			// Sinds 2026-10-04 ook de tellingen (OD_Tellingen), in dezelfde opvraging: die gebruiken de resultaten achter de hekken van
			// de blokken, en die zijn er alleen in de fase waarin de blokken gerekend worden.
			parameter<string> OUTPUT_Generate_PublicTransport_fullOD_long_CSVFiles  := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Generate',' + ') + ' + OD_Tellingen/Generate';

			// Sinds 2026-10-07 rekent batch/WriteOutputBlocks.ps1 de uitvoer in porties van blokken, een GeoDmsRun per portie, zoals
			// WriteChainBlocks.ps1 de ketenstap: in een opvraging voor alle blokken (hierboven) groeide het geheugen van de uitvoer van
			// Auto voor Buurt2023 naar Buurt2023 met ongeveer 0,7 GB per blok tot 386 GB. De tellingen maakt dan batch/OdTellingen.py.
			parameter<string> OutputBlocks_List := /ModelParameters/Advanced/IsSamen ? '' : AsList('/NetworkSetup/ConfigurationPerBlock/' + /NetworkSetup/Impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Generate', '\n')
			, StorageName = "%ConfigDir%/../../batch/log/output_blocks.txt", StorageType = "str"
			, ExplicitSuppliers = "/NetworkSetup/Output_Sig/ForWriting"
			, Descr = "De opvragingen per herkomstblok, een per regel, voor batch/WriteOutputBlocks.ps1 (sinds 2026-10-07); leeg bij Component 'Samen', dat een opvraging blijft (ComponentMerge). Via Output_Sig/ForWriting schrijft of controleert dit eerst de handtekening van de uitvoermap en het langste pad.";
			parameter<string> OutputBlocks_PerPortion := string(/ModelParameters/Advanced/BlokkenPerPortie)
			, StorageName = "%ConfigDir%/../../batch/log/output_blocks_per_portion.txt", StorageType = "str"
			, Descr = "Herkomstblokken per GeoDmsRun voor batch/WriteOutputBlocks.ps1: ModelParameters/Advanced/Componenten/BlokkenPerPortie van de component, 0 = alle blokken in een portie.";

			// Tellingen naast de OV-uitvoer (sinds 2026-10-04), in <OutputDir>: od_tellingen.csv met de rijen per soort optie en per
			// vertrekmoment (en het totaal), en unieke_od_tellingen.csv met de unieke HB-paren per groep en per vertrekmoment (en over de
			// momenten samen). De blokken hebben elk hun eigen herkomsten, dus de tellingen per blok worden opgeteld.
			container OD_Tellingen
			{
				unit<uint8>  Soort   := Classifications/OD_Tellingen_Soort;
				unit<uint8>  Groep   := Classifications/OD_Tellingen_Groep;
				unit<uint32> Moments := /ModelParameters/Advanced/MeasureMoments;

				container PerMoment := for_each_ne(Moments/Name, 'Moment_T(' + quote(Moments/Name) + ')');
				Template Moment_T
				{
					parameter<string> Moment;
					///
					attribute<uint64> Rijen (Soort) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Tellingen/Rijen/' + Moment, ' + ');
					attribute<uint64> Paren (Groep) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Tellingen/Paren/' + Moment, ' + ');
				}
				attribute<uint64> Rijen_Totaal (Soort) := =asList('PerMoment/' + Moments/Name + '/Rijen', ' + ');
				attribute<uint64> Paren_Samen  (Groep) := =asList(/NetworkSetup/impl/OrgBlockDomain/name + '/PublicTransport/Generate_Output/Traveltime_ForEachDepTime_Fence/Tellingen/Paren_Samen', ' + ');

				parameter<string> MomentKop := asList(Moments/TemplatableTextShrt, ';');
				attribute<string> RijenRegel (Soort) := ='Soort/label + ' + asList(''';'' + string(PerMoment/' + Moments/Name + '/Rijen)', ' + ') + ' + '';'' + string(Rijen_Totaal)';
				attribute<string> ParenRegel (Groep) := ='Groep/label + ' + asList(''';'' + string(PerMoment/' + Moments/Name + '/Paren)', ' + ') + ' + '';'' + string(Paren_Samen)';
				parameter<string> File_Rijen := 'soort;' + MomentKop + ';totaal\n' + asList(RijenRegel, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Advanced/OutputDir + '/od_tellingen.csv'", StorageType = "str"
				,	Descr = "Rijen van de OV-uitvoer per soort optie (Classifications/OD_Tellingen_Soort), per vertrekmoment en in totaal.";
				parameter<string> File_Paren := 'groep;' + MomentKop + ';samen\n' + asList(ParenRegel, '\n') + '\n'
				,	StorageName = "=/ModelParameters/Advanced/OutputDir + '/unieke_od_tellingen.csv'", StorageType = "str"
				,	Descr = "Unieke HB-paren per groep (Classifications/OD_Tellingen_Groep), per vertrekmoment en over de momenten samen.";
				parameter<string> Generate := File_Rijen + File_Paren;
			}
			// parameter<string> OUTPUT_Generate_PublicTransport_fullOD_long_CSVFiles  := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PublicTransport/Generate_Output/Traveltime_ForEachDepTime/Generate',' + ');
			// parameter<string> OUTPUT_Generate_Car_decay_CSVFiles                    := =asList(Advanced/Regio/name+'/PrivateTransport/Export_Car_Decayed',' + ');
			// parameter<string> OUTPUT_Generate_Car_traveltimes_CSVFiles              := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PrivateTransport/Export_Car_Traveltimes',' + ');
			parameter<string> OUTPUT_Generate_Car_traveltimes_CSVFiles              := PrivateTransport/Export_Car_Traveltimes;
			// parameter<string> OUTPUT_Generate_Cycling_decay_CSVFiles                := =asList(Advanced/Regio/name+'/PrivateTransport/Export_Cycling_Decayed',' + '); 
			// parameter<string> OUTPUT_Generate_Cycling_traveltimes_CSVFiles          := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PrivateTransport/Export_Cycling_Traveltimes',' + '); 
			// parameter<string> OUTPUT_Generate_Walking_decay_CSVFiles                := =asList(Advanced/Regio/name+'/PrivateTransport/Export_Walking_Decayed',' + '); 
			// parameter<string> OUTPUT_Generate_Walking_traveltimes_CSVFiles          := =asList(NetworkSetup/Impl/OrgBlockDomain/name+'/PrivateTransport/Export_Walking_Traveltimes',' + '); 
		}
		
		container Merge_Output
		{
			container MergeRegions
			{
				parameter<string> OUTPUT_Merge_PublicTransport_Regions_fullOD_long_CSVFiles   := ReadMergeExports_PublicTransport/OUTPUT_Merge_Regions;
			}
			container MergeTimes
			{			
				parameter<string> OUTPUT_Merge_PublicTransport_Times_fullOD_long_CSVFiles     := ReadMergeExports_PublicTransport/OUTPUT_Merge_Times;
			}
			// parameter<string> OUTPUT_Merge_Car_Regions_traveltimes_CSVFiles               := ReadMergeExports_PrivateTransport/Car/Merge/OUTPUT_Merge_Regions;
			// parameter<string> OUTPUT_Merge_Bike_Regions_traveltimes_CSVFiles              := ReadMergeExports_PrivateTransport/Bike/Merge/OUTPUT_Merge_Regions;
			// parameter<string> OUTPUT_Merge_Pedestrian_Regions_traveltimes_CSVFiles        := ReadMergeExports_PrivateTransport/Pedestrian/Merge/OUTPUT_Merge_Regions;
			
			
			// Voor het mergen van de geëxporteerde data:
				// Zet de geexporteerde bestanden in de PerRegio map.
				// Orgset == Buurt
				// Destset = Buurt
				// Getiled_berekenen = true
			
			parameter<string> Direct_str := ModelParameters/Advanced/Direct_str; // WW, CC en/of AA; sinds 2026-09-23 uit DirectModes
			parameter<string> V_typen := (Direct_str != '' ? Direct_str + ',' : '') + asList(ModelParameters/Advanced/OV_PreTransport_Typen/ExportName, ',');
			parameter<string> N_typen := asList(ModelParameters/Advanced/OV_PostTransport_Typen/ExportName, ',');
			parameter<string> CombinationType := ModelParameters/Advanced/PT_CombinationType;

			
			container ReadMergeExports_PublicTransport := Templates/ReadMergeExports_OV_perType_T(CombinationType,DestSet)
			{
				parameter<string> OUTPUT_Merge_Regions       := Merge_Regions/OUTPUT_Merge_Regions;   
				parameter<string> OUTPUT_Merge_Times         := 'Ready', ExplicitSuppliers = "Merge_Times/LongFormat/File_fullOD";
			}
			
			// container ReadMergeExports_PrivateTransport
			// {
				// container Car
				// {
					// container Read := 
						// for_each_ne(
							// Advanced/Regio/name
							// , 'Templates/ReadExport_Car_T('+quote(Advanced/Regio/name)+','+quote(DestSet)+')'
						// );
						
					// container Merge := Templates/Merge_Regions_Car_T(DestSet)
					// {
						// parameter<string>   OUTPUT_Merge_Regions  := LongFormat/File_full;
					// }
				// }
				// container Bike
				// {
					// container Read := 
						// for_each_ne(
							// Advanced/Regio/name
							// , 'Templates/ReadExport_PedestrianBike_T('+quote(Advanced/Regio/name)+','+quote(DestSet)+',''Bike'')'
						// );
						
					// container Merge := Templates/Merge_Regions_PedestrianBike_T(DestSet,'Bike')
					// {
						// parameter<string>   OUTPUT_Merge_Regions  := File;
					// }
				// }
				// container Pedestrian
				// {
					// container Read := 
						// for_each_ne(
							// Advanced/Regio/name
							// , 'Templates/ReadExport_PedestrianBike_T('+quote(Advanced/Regio/name)+','+quote(DestSet)+',''Pedestrian'')'
						// );
						
					// container Merge := Templates/Merge_Regions_PedestrianBike_T(DestSet,'Pedestrian')
					// {
						// parameter<string>   OUTPUT_Merge_Regions  := File;
					// }
				// }
			// }
		}	
	}

	Template ConfigurationPerOrgBlock_T 
	{
		parameter<NetworkSetup/impl/OrgBlockDomain> BlockDomain_id;
		////

		unit<uint32> org := select_with_org_rel(NetworkSetup/impl/OrgBlockSelections/OrgBlock_rel == BlockDomain_id)
		{
			attribute<rdc>                   geometry       := NetworkSetup/impl/OrgBlockSelections/geometry[org_rel];
			attribute<string>                name           := NetworkSetup/impl/OrgBlockSelections/name[org_rel];
			attribute<float32>               nr_inwoners    := NetworkSetup/impl/OrgBlockSelections/nr_inwoners[float32][org_rel];
		}
		
		// unit<uint32> dest := =Advanced/Create_Symmetric_fullOD ? 'org' : 'impl/dest_src'
		// {
			// attribute<rdc>                   geometry       := =Advanced/Create_Symmetric_fullOD ? 'org/geometry' : 'impl/dest_src/geometry';
		// 
		unit<uint32> dest := impl/dest_src
		{
			attribute<rdc>                   geometry       := impl/dest_src/geometry;
		}
		
		container impl := PublicTransport_Prep/Impl
		{
			unit<uint32> org := ../org;
			unit<uint32> dest := ../dest;
			
			// parameter<string> Org_str           := rjoin(lowercase(Advanced/Orgset_str), lowercase(Advanced/org_domain_list/label), Advanced/org_domain_list/path);
			// parameter<string> Org_domain        := replace(rjoin(lowercase(Advanced/Orgset_str), lowercase(Advanced/org_domain_list/label), Advanced/org_domain_list/path), '@REGIO@', regio_name);
			
			// parameter<string> regio_name_if_enkel_sub := switch(
															 // case(strcount(ModelParameters/Orgset, 'Buurt_enkele_Corop') > 0, ModelParameters/Orgset_EnkeleCorop_Selection)
															// ,case(strcount(ModelParameters/Orgset, 'Buurt_enkele_Prov') > 0, ModelParameters/Orgset_EnkeleProv_Selection)
															// , regio_name
														// );
														
		} 
		
		container PublicTransport 
		{
			#include<PublicTransport.dms>
			
		}
	}
	
	container PrivateTransport 
	{
		parameter<string> Export_Walking_decayed      := Walking/ExportTable_Decayed/File;
		parameter<string> Export_Walking_traveltimes  := Walking/ExportTable_Traveltimes/File;
		parameter<string> Export_Cycling_decayed      := Cycling/ExportTable_Decayed/File;
		parameter<string> Export_Cycling_traveltimes  := Cycling/ExportTable_Traveltimes/File;
		parameter<string> Export_Car_Decayed          := Car/ExportTable_Decayed/File;
		parameter<string> Export_Car_traveltimes      := Car/ExportTable_Traveltimes/File;
		
		unit<uint32> Org  := PublicTransport_Prep/Impl/org;
		unit<uint32> Dest := PublicTransport_Prep/Impl/dest;
		
		container Impl := ../impl
		{
			parameter<string> fileNamePrefix :=  Advanced/fileNamePrefix;
			parameter<string> fileNameSuffix :=  
				// '_ORG-'    + Advanced/OrgSet_string + '-' + NetworkSetup/Impl/OrgBlockDomain/name[BlockDomain_id]+ 
				'_ORG-'    + Advanced/OrgSet_string +  
				'_DEST-'   + Advanced/DestSet_string +
				'_NETWERK-@@' +
				'_MaxTime-##min';
		}
		
		Container Walking 
		{
			unit<uint32> LinkSet := PublicTransport_Prep/Create_Optimised_Network_Walking/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet := PublicTransport_Prep/Create_Optimised_Network_Walking/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.>   OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
				attribute<.>   DestNode_rel (dest) := rlookup(dest/geometry, geometry);
			}
				
			container Calc_Traveltimes_maxspeed_Walking := Calc_Traveltimes_T(LinkSet, NodeSet, LinkSet/Impedance_per_ImpedanceType/max_Walking, LinkSet/Distance_per_ImpedanceType/max_Walking, ModelParameters/MaxWalkingTime_Org2Dest, 'walk');
			
			unit<uint64> ExportTable_Traveltimes := Calc_Traveltimes_maxspeed_Walking/Traveltimes
			{
				attribute<org > Org_rel := OrgZone_rel;
				attribute<dest> Dst_rel := DstZone_rel;
				
				attribute<min_f> DefaultSpeed_imp    := Impedance;
				attribute<km>    AfgelegedeAfstand   := Alt_imp;
				
				attribute<string> BodyLines :=
					org/name[Org_rel] + ';' + 
					dest/name[Dst_rel] + ';' +
					string(DefaultSpeed_imp) + ';' +
					string(AfgelegedeAfstand);
				parameter<string> File := 'Org;Dst;Freeflow;AfgelegedeAfstand\n'++asList(BodyLines, '\n'), StorageName = "=impl/fileNamePrefix+'Traveltimes'+replace(impl/fileNameSuffix, '@@', 'Walking', '##',  string(ModelParameters/MaxWalkingTime_Org2Dest)) +'.csv'", StorageType = "str";
			}
			unit<uint32> ExportTable_Decayed := org
			{
				attribute<float32> nr_items_of_interest_decayed_freeflow        := Calc_Traveltimes_maxspeed_walking/Decay/D_i;
				
				attribute<string> BodyLines (org) := org/name + ';' + string(nr_items_of_interest_decayed_freeflow);
				parameter<string> File            := 'Org;freeflow\n'++asList(BodyLines, '\n'), StorageName = "=impl/fileNamePrefix+''+Advanced/items_of_interest+'_decayed'+replace(impl/fileNameSuffix, '@@', 'Walking', '##',  string(ModelParameters/MaxWalkingTime_Org2Dest))+'.csv'", StorageType = "str";
			}
		}
		
		Container Cycling
		{
			unit<uint32> LinkSet_Cycling := PublicTransport_Prep/Create_Optimised_Network_Cycling/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet_Cycling := PublicTransport_Prep/Create_Optimised_Network_Cycling/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.>   OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
				attribute<.>   DestNode_rel (dest) := rlookup(dest/geometry, geometry);	
			}
			container Calc_Traveltimes_maxspeed_Cycling  := Calc_Traveltimes_T(LinkSet_Cycling, NodeSet_Cycling, LinkSet_Cycling/Impedance_per_ImpedanceType/max_Cycling, LinkSet_Cycling/Distance_per_ImpedanceType/max_Cycling, ModelParameters/MaxCyclingTime_Org2Dest, 'bike');
			container Calc_Traveltimes_congested_Cycling := Calc_Traveltimes_T(LinkSet_Cycling, NodeSet_Cycling, LinkSet_Cycling/Impedance_per_ImpedanceType/congested_Cycling, LinkSet_Cycling/Distance_per_ImpedanceType/congested_Cycling, ModelParameters/MaxCyclingTime_Org2Dest, 'bike');
			
			unit<uint32> LinkSet_e_bike := PublicTransport_Prep/Create_Optimised_Network_EBike/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet_e_bike := PublicTransport_Prep/Create_Optimised_Network_EBike/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.>   OrgNode_rel   (org) := rlookup(org/geometry,  geometry);
				attribute<.>   DestNode_rel (dest) := rlookup(dest/geometry, geometry);	
			}
			container Calc_Traveltimes_maxspeed_e_bike := Calc_Traveltimes_T(LinkSet_e_bike, NodeSet_e_bike, LinkSet_e_bike/Impedance_per_ImpedanceType/max_e_bike, LinkSet_e_bike/Distance_per_ImpedanceType/max_e_bike, ModelParameters/MaxCyclingTime_Org2Dest, 'bike');
			container Calc_Traveltimes_congested_e_bike := Calc_Traveltimes_T(LinkSet_e_bike, NodeSet_e_bike, LinkSet_e_bike/Impedance_per_ImpedanceType/congested_e_bike, LinkSet_e_bike/Distance_per_ImpedanceType/congested_e_bike, ModelParameters/MaxCyclingTime_Org2Dest, 'bike');
			
			unit<uint64> ExportTable_Traveltimes := Calc_Traveltimes_maxspeed_Cycling/Traveltimes
			{
				attribute<org > Org_rel := OrgZone_rel;
				attribute<dest> Dst_rel := DstZone_rel;
				
				attribute<min_f> DefaultSpeed_imp     := Impedance;
				attribute<km>    AfgelegedeAfstand    := Alt_imp;
				attribute<min_f> E_Bike_imp           := rjoin(Org_Dest, Calc_Traveltimes_maxspeed_e_bike/Traveltimes/Org_Dest, Calc_Traveltimes_maxspeed_e_bike/Traveltimes/Impedance);
				attribute<min_f> ActualCycling_imp       := rjoin(Org_Dest, Calc_Traveltimes_congested_Cycling/Traveltimes/Org_Dest, Calc_Traveltimes_congested_Cycling/Traveltimes/Impedance);
				attribute<min_f> ActualE_Bike_Adj_imp := rjoin(Org_Dest, Calc_Traveltimes_congested_e_bike/Traveltimes/Org_Dest, Calc_Traveltimes_congested_e_bike/Traveltimes/Impedance);
				attribute<bool>  IsCorrect_ActualCycling     := ActualCycling_imp >= DefaultSpeed_imp;
				
				attribute<string> BodyLines_ActualCycling :=
					org/name[Org_rel] + ';' + 
					dest/name[Dst_rel] + ';' +
					string(DefaultSpeed_imp) + ';' +
					string(E_Bike_imp) + ';' +
					string(ActualCycling_imp) + ';' +
					string(ActualE_Bike_Adj_imp) + ';' +
					string(AfgelegedeAfstand);
				parameter<string> File_ActualCycling := 'Org;Dst;Freeflow;Freeflow_ebike;ActualCycling;ActualE_Bike_Adj;AfgelegedeAfstand\n'++asList(BodyLines_ActualCycling, '\n'), StorageName = "=impl/fileNamePrefix+'Traveltimes'+replace(impl/fileNameSuffix, '@@', 'Cycling', '##',  string(ModelParameters/MaxCyclingTime_Org2Dest)) +'.csv'", StorageType = "str";
				
				attribute<string> BodyLines_Freeflow :=
					org/name[Org_rel] + ';' + 
					dest/name[Dst_rel] + ';' +
					string(DefaultSpeed_imp) + ';' + 
					string(E_Bike_imp) + ';' + 
					string(AfgelegedeAfstand);
				parameter<string> File_Freeflow := 'Org;Dst;Freeflow;Freeflow_ebike;AfgelegedeAfstand\n'++asList(BodyLines_Freeflow, '\n'), StorageName = "=impl/fileNamePrefix+'Traveltimes'+replace(impl/fileNameSuffix, '@@', 'Cycling', '##',  string(ModelParameters/MaxCyclingTime_Org2Dest)) +'.csv'", StorageType = "str";
				
				parameter<string> File := =ModelParameters/Advanced/UseActualCyclingSpeeds ? 'File_ActualCycling' : 'File_Freeflow';
			}
			
			unit<uint32> ExportTable_Decayed := org
			{
				attribute<float32> nr_items_of_interest_decayed_Cycling_MaxSpeed    := Calc_Traveltimes_maxspeed_Cycling/Decay/D_i;
				attribute<float32> nr_items_of_interest_decayed_Ebike            := Calc_Traveltimes_maxspeed_e_bike/Decay/D_i;
				attribute<float32> nr_items_of_interest_decayed_ActualCycling       := Calc_Traveltimes_congested_Cycling/Decay/D_i;
				attribute<float32> nr_items_of_interest_decayed_ActualE_Bike_adj := Calc_Traveltimes_congested_e_bike/Decay/D_i;
				attribute<float32> Loss_ActualCycling                               := nr_items_of_interest_decayed_Cycling_MaxSpeed - nr_items_of_interest_decayed_ActualCycling;
				
				attribute<string> BodyLines (org) := org/name + ';' + string(nr_items_of_interest_decayed_Cycling_MaxSpeed) + ';'+string(nr_items_of_interest_decayed_Ebike) + ';'+string(nr_items_of_interest_decayed_ActualCycling) + ';'+string(nr_items_of_interest_decayed_ActualE_Bike_adj);
				parameter<string> File            := 'Org;freeflow;freeflow_ebike;ActualCycling;ActualE_Bike_Adj\n'++asList(BodyLines, '\n'), StorageName = "=impl/fileNamePrefix+''+Advanced/items_of_interest+'_decayed'+replace(impl/fileNameSuffix, '@@', 'Cycling', '##',  string(ModelParameters/MaxCyclingTime_Org2Dest))+'.csv'", StorageType = "str";
			}
		}
		
		container Car := Templates/PrivateTransport_Car_T(org, dest, true); 
		
		Template Calc_Traveltimes_T
		{
			unit<uint32>     LinkSet_dom;
			unit<uint32>     NodeSet_dom;
			attribute<s_f>   impedance   (LinkSet_dom);
			attribute<km>    distance    (LinkSet_dom);
			parameter<min_f> MaxTraveltime_min;
			parameter<string> DecayMode; // 'walk' of 'bike': de parameterset in ModelParameters/Advanced/Distance_decay
			///
			// De decay gebruikt de parameters van de eigen modaliteit; tot 2026-09-25 altijd die van de auto (audit 3.2).
			parameter<float32> decay_a := ='Advanced/Distance_Decay/'+DecayMode+'_a';
			parameter<float32> decay_b := ='Advanced/Distance_Decay/'+DecayMode+'_b';
			parameter<float32> decay_c := ='Advanced/Distance_Decay/'+DecayMode+'_c';
			
			unit<uint64> Traveltimes :=
				impedance_matrix_od64('bidirectional;startPoint(Node_rel):max_imp;endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;od:impedance,OrgZone_rel,DstZone_rel'
					, convert(impedance, min_f)
					, LinkSet_dom/F1
					, LinkSet_dom/F2
					, NodeSet_dom/OrgNode_rel
					, NodeSet_dom/DestNode_rel
					, MaxTraveltime_min //cut impedance
					, distance
				)
			{
				attribute<string> Org_Dest    := string(OrgZone_rel)+'_'+string(DstZone_rel);
			}
			
			unit<uint64> Traveltimes_with_Linkset :=
				impedance_matrix_od64('bidirectional;startPoint(Node_rel):max_imp;endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;od:impedance,OrgZone_rel,DstZone_rel,LinkSet'
					, convert(impedance, min_f)
					, LinkSet_dom/F1
					, LinkSet_dom/F2
					, NodeSet_dom/OrgNode_rel
					, NodeSet_dom/DestNode_rel
					, MaxTraveltime_min //cut impedance
					, distance
				)
			{
				attribute<string> Org_Dest := string(OrgZone_rel)+'_'+string(DstZone_rel);
				attribute<rdc>    geometry (arc) := TravelledJourney/Route[invert(TravelledJourney/Sequence_rel)];
				
				unit<uint32> TravelledJourney := sequence2points(LinkSet) //vertaling van LinkSet attribute (afgelegde route in OD), naar onderdelen van de reis
				{
					attribute<rdc>         Route (arc)    := points2sequence(LinkPoints/Point, LinkPoints/Sequence_rel, LinkPoints/Ordinal);
					attribute<rdc>         FromPoint      := LinkSet_dom/FromPoint[point];
					attribute<rdc>         ToPoint        := LinkSet_dom/ToPoint[point];

					unit<uint32> LinkPoints := union_unit(., .)
					{
						attribute<rdc>                  Point        := union_data(., FromPoint, ToPoint);
						attribute<..>                   Sequence_rel := union_data(., id(..), id(..));
						attribute<uint32>               Ordinal      := union_data(., const(0,..,uint32), const(1,..,uint32));
						attribute<...>                  Sequence_rel_old := TravelledJourney/Sequence_rel[Sequence_rel];
						attribute<uint32>               Ordinal_old      := TravelledJourney/Ordinal[Sequence_rel];
					}
				}
			}
			
			unit<uint64> Decay := 
				impedance_matrix_od64('bidirectional;startPoint(Node_rel);endPoint(Node_rel);cut(OrgZone_max_imp);interaction(v_i,w_j,dist_logit(alpha,beta,gamma)):D_i'
					, convert(impedance, min_f)
					, LinkSet_dom/F1
					, LinkSet_dom/F2
					, NodeSet_dom/OrgNode_rel
					, NodeSet_dom/DestNode_rel
					, MaxTraveltime_min
					, 1f                                 // v_i
					, dest/nr_items_of_interest[float32] // w_j
					, decay_a, decay_b, decay_c
				);
		}
	}
}
