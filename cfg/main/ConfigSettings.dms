container ConfigSettings
{
	// Waar de brondata staan. Sinds 2026-10-23 weer in git (van f2c0718, 25-04-2026, tot dan machine-lokaal en gitignored),
	// zodat een verse download van main opent: main.dms laadt dit bestand altijd, en zonder stopte het al bij het inlezen.
	//
	// Wijk je af van deze standaard, verander dan niet dit bestand, maar geef de waarde op in GeoDMS. GeoDMS zoekt een
	// Overridable eerst in de omgevingsvariabele GEODMS_Overridable_<naam>, dan in het register onder
	// HKEY_CURRENT_USER\Software\ObjectVision\<computernaam>\GeoDMS\<naam>, en pas dan hier (AbstrStorageManager.cpp,
	// GetRegConfigSetting). In GeoDmsGui: Settings > Config Options, dat de waarde in het register zet.
	// Voorbeeld: de werkplek van Maarten (OVSRV10) heeft NetworkModel_Dir = F:/SourceData/NetworkModel_PBL in het register.
	container Overridable
	{
		parameter<string> NetworkModel_Dir     := '%SourceDataDir%/NetworkModel';          // brondata: GTFS, netwerken, CBS, ...
		parameter<string> NetworkModel_PrivDir := '%SourceDataDir%/NetworkModel_PBL_priv'; // TomTom (licentie)
		parameter<string> BAG_DataDir          := '%SourceDataDir%';                       // BAG
	}
}
