container ConfigSettings
{
	// Where the source data are. This file is in git so that a fresh download of main opens, because main.dms always loads it.
	//
	// To use another location, do not change this file but give the value to GeoDMS. GeoDMS looks for an Overridable
	// first in the environment variable GEODMS_Overridable_<name>, then in the registry under
	// HKEY_CURRENT_USER\Software\ObjectVision\<computer name>\GeoDMS\<name>, and only then here (AbstrStorageManager.cpp,
	// GetRegConfigSetting). In GeoDmsGui, Settings > Config Options writes the value to the registry.
	// Example: the workstation OVSRV10 of Object Vision has NetworkModel_Dir = F:/SourceData/NetworkModel_PBL in the registry.
	container Overridable
	{
		parameter<string> NetworkModel_Dir     := '%SourceDataDir%/NetworkModel';          // source data: GTFS, networks, CBS, ...
		parameter<string> NetworkModel_PrivDir := '%SourceDataDir%/NetworkModel_PBL_priv'; // TomTom (licensed)
		parameter<string> BAG_DataDir          := '%SourceDataDir%';                       // BAG
		// The component that a GeoDmsRun step calculates (ModelParameters/Impl/ComponentName): batch/UpdateAll.cmd sets it per step in the
		// environment variable GEODMS_Overridable_RunComponent; 'gui' means ModelParameters/GuiComponent.
		parameter<string> RunComponent         := 'gui';
	}
}
