container SourceData: Using = "Units;Classifications;Geography"
{
	container Infrastructure
	{
		#include<gtfs.dms>
		#include<OSM.dms>
		#include<NDW.dms>
		#include<Fietstelweek.dms>
		#include<Fietsersbond.dms>
		#include<Infrastructure.dms>
		#include<OVprijzen.dms>
		#include<TomTom.dms>

		unit<uint32> Network_Cycling := ='/SourceData/Infrastructure/' + ModelParameters/Advanced/CyclingNetwork + '/Network_Cycling'
		,	Descr = "Het fietsnet van het model: Fietsersbond/Network_Cycling of OSM/Network_Cycling, naar ModelParameters/Advanced/CyclingNetwork (#124).";
	}
	
	#include<RegioIndelingen.dms>
	#include<Locaties.dms>
	#include<BAG.dms>
}
