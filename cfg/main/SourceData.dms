container SourceData: Using = "Units;Classifications;Geography", Descr = "The input data of the model: the transport infrastructure, the region divisions, the locations of residents and facilities, and the BAG."
{
	container Infrastructure : Descr = "The transport infrastructure: the GTFS timetable, the OSM, TomTom and Fietsersbond networks, NDW, the Fietstelweek speeds, the stations and the public transport fares."
	{
		#include<gtfs.dms>
		#include<OSM.dms>
		#include<NDW.dms>
		#include<Fietstelweek.dms>
		#include<Fietsersbond.dms>
		#include<Infrastructure.dms>
		#include<OVprijzen.dms>
		#include<TomTom.dms>

		unit<uint32> Network_Cycling := ='/SourceData/Infrastructure/' + ModelParameters/Advanced/CyclingNetwork + '/Network_Cycling'
		,	Descr = "The cycling network of the model: Fietsersbond/Network_Cycling or OSM/Network_Cycling, as ModelParameters/Advanced/CyclingNetwork sets it (#124).";
	}
	
	#include<RegioIndelingen.dms>
	#include<Locaties.dms>
	#include<BAG.dms>
	container BAG := BAG_T(ModelParameters/Impl/BAG_snapshot)
	,	Descr = "The BAG snapshot of the analysis moment, for the origin sets that read the BAG directly: PC4, PC6 and the residential buildings.";
}
