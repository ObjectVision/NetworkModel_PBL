unit<uint32> Fietstelweek  
:	StorageName     = "='%NetworkModel_dir%/Infrastructuur/Fietstelweek/links-met-snelheden-routeerbaar-2015-2016-2017-900913-v2.shp'"
, 	Descr = "The links of the Fietstelweek with the cycling speed measured on them; OSM/Final_Network gives OSM cycle links the speed of the measured links nearby, which the model uses when ModelParameters/Advanced/UseActualCyclingSpeeds is on.", Source = "Fietstelweek 2015, 2016 and 2017: routable links with speeds, version 2, from http://opendata.cyclingintelligence.eu/"
,	StorageType     = "gdal.vect"
,	StorageReadOnly = "True"
, 	DialogType      = "map"
, 	DialogData      = "geometry_rd" 
,	SyncMode        = "none"
{
	attribute<Geography/WebMercator_base>         geometry    (arc);
	attribute<Geography/rdc>                      geometry_rd (arc) := convert(geometry,Geography/rdc);
	attribute<float64>                             SNEL_ABS;
	attribute<float64>                             INTENS_MEE;
	// Only links with measured trips (INTENS_MEE > 0) get a speed: on the other links SNEL_ABS is an imputed 8, 10 or 12 km/h,
	// which is no measurement and would make the linked OSM links slower than the fallback speed.
	attribute<float32>                             bike_speed        := SNEL_ABS[float32] != 0f && INTENS_MEE > 0d ? SNEL_ABS[float32] : 0f/0f;
	
	unit<uint32> links_with_speed := select_with_attr_by_cond(.,IsDefined(bike_speed)), Descr = "The links with a measured cycling speed.";

	unit<uint32> Arc2Segments := arc2segm(links_with_speed/geometry_rd)
	, DialogData = "point"
	, DialogType = "map"
	{
		attribute<float32> bike_speed := rjoin(Sequence_rel, id(Fietstelweek/links_with_speed), Fietstelweek/links_with_speed/bike_speed);
	}
	
	unit<uint32> DynaPoint_untiled := dyna_point(Arc2Segments/point, Arc2Segments/nextpoint, 25d)
	, DialogData = "point"
	, DialogType = "map"
	{
		attribute<float32> bike_speed := Arc2Segments/bike_speed[Sequence_rel];
	}
	unit<uint32> DynaPoint := TiledUnit(100000[DynaPoint_untiled]), Descr = "Points every 25 m along the measured links, each with the speed of its link; OSM cycle links take the mean speed of the points near them."
	{
		attribute<float32> bike_speed := DynaPoint_untiled/bike_speed[id(.)[DynaPoint_untiled]];
		attribute<rdc>     point      := DynaPoint_untiled/point[id(.)[DynaPoint_untiled]];
	}
}