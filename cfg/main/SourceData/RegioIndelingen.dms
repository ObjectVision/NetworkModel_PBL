	unit<uint8> Concessiegebied := ='Concessiegebieden/'+ModelParameters/Impl/ConcessionArea_year+'/Concessiegebied', Descr = "The public transport concession areas of the year ModelParameters/Impl/ConcessionArea_year.";
	
	// Concession shapes exist for 2020 to 2026 (Concessie_YYYY.shp). They are read per year, so that ConcessionArea_year = 'Y' + FareTable_year
	// works for every available year (relevant for PriceMethod 'DOVA'). For years before 2020 (the DOVA km fares go back to 2013) there is no
	// shape, and ModelParameters/Impl/ConcessionArea_year takes 2020 instead.
	unit<uint32> Concession_years := range(uint32, 2020, 2027)
	{
		attribute<uint32> year     := id(.);
		attribute<string> year_str := string(year);
		attribute<string> name     := 'Y'+year_str;
	}

	Template Read_Concession_T
	{
		parameter<string> year;
		//
		unit<uint32> shape
		: StorageName = "='%NetworkModel_dir%/RegioIndelingen/Concessiegebieden/Concessie_'+year+'.shp'"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, DialogData = "rdc"
		{
			attribute<string>          name                := AsItemName(concessie);
			attribute<Concessiegebied> Concessiegebied_rel := rlookup(name, Concessiegebied/name);
		}

		unit<uint8> Concessiegebied := union_unit_uint8(shape)
		{
			attribute<rdc>    geometry (poly) := union_data(., shape/geometry);
			attribute<string> name            := union_data(., shape/name);
			attribute<string> label           := name;
		}
	}

	container Concessiegebieden :=
		for_each_ne(
			Concession_years/name
			, 'Read_Concession_T('+quote(Concession_years/year_str)+')'
		);
	
	Template Per_Prov_T
	{
		parameter<uint32> prov_id;
		unit<uint32> domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/prov_rel == '+string(prov_id)+')'
		{
			attribute<rdc>    geometry    := domain/geometry[org_rel];
			attribute<string> name        := domain/name[org_rel];
			attribute<string> label       := domain/label[org_rel];
			attribute<uint32> nr_inhabitants := domain/nr_inhabitants[org_rel];
		}
	}
	Template Per_COROP_T
	{
		parameter<uint32> COROP_id;
		unit<uint32> domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/corop_rel == '+string(COROP_id)+')'
		{
			attribute<rdc>    geometry    := domain/geometry[org_rel];
			attribute<string> name        := domain/name[org_rel];
			attribute<string> label       := domain/label[org_rel];
			attribute<uint32> nr_inhabitants := domain/nr_inhabitants[org_rel];
		}
	}
	Template Per_CoropP_T
	{
		parameter<uint32> CoropP_id;
		unit<uint32> domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/CoropP_rel == '+string(CoropP_id)+')'
		{
			attribute<rdc>    geometry    := domain/geometry[org_rel];
			attribute<string> name        := domain/name[org_rel];
			attribute<string> label       := domain/label[org_rel];
			attribute<uint32> nr_inhabitants := domain/nr_inhabitants[org_rel];
		}
	}
}
