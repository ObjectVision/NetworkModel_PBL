container RegioIndelingen : using = "Geography", Descr = "The CBS region divisions per year (Divisions) and those of the analysis moment (neighbourhoods, districts, municipalities, COROP regions, provinces and more) with their weighted centroids, other zone systems with centroids, and the public transport concession areas."
{ 
	parameter<string> Regions_year      := ModelParameters/Impl/RegioIndelingen_year;
	
	unit<uint32> Divisions_years := range(uint32, 2000, 2026)
	{
		attribute<uint32> year                 := id(.);
		attribute<string> name                 := 'Y'+string(year);
		attribute<bool>   IsGeneralised        := year < 2019;
		attribute<string> Path_str             := year < 2020
		                                          ? replace(Name_before_2020_str, 'YYYY', string(year), 'GG', IsGeneralised ? '_gegeneraliseerd' : '_niet_gegeneraliseerd')
		                                          : replace(Name_from_2020_str, 'YYYY', string(year), 'GG', IsGeneralised ? '_gegeneraliseerd' : '_niet_gegeneraliseerd');
		attribute<string> Path_Gen_str         := year < 2020 ? replace(Name_before_2020_str, 'YYYY', string(year), 'GG', '_gegeneraliseerd') : replace(Name_from_2020_str, 'GG', '_gegeneraliseerd') ;
		
		parameter<string> Name_before_2020_str := 'cbs_@R@_YYYYGG';
		parameter<string> Name_from_2020_str   := '@R@GG';
	}
	container         Divisions         :=
		for_each_ne(
			Divisions_years/name
			, 'Read_Divisions_gpkg_T('+quote(string(Divisions_years/year))+')'
		);

	Template Read_Divisions_gpkg_T
	{
		parameter<string> year;
		//
		parameter<string> Path_str     := rjoin(uint32(year), Divisions_years/year, Divisions_years/Path_str), Descr = "The table name of a division in the gpkg of the year, with @R@ for the division: cbs_@R@_<year>_<generalised> before 2020, @R@_<generalised> from 2020 on, and the not generalised version where CBS delivers it.";
		parameter<string> BAG_date     := year + '0101', Descr = "1 January of the year, the date of the BAG whose dwellings weight the centroids of the neighbourhoods, districts and municipalities of this year.";

		container         gpkg
		:	StorageName     = "='%NetworkModel_dir%/RegioIndelingen/cbsgebiedsindelingen'+year+'.gpkg'"
		, 	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	SyncMode        = "alltables"
		,	DialogData      = "rdc"
		,	URL             = "https://www.cbs.nl/nl-nl/dossier/nederland-regionaal/geografische-data/cbs-gebiedsindelingen";

		container         BAG          := BAG_T(BAG_date);

		unit<uint32> Buurt := ='gpkg/' + replace(Path_str, '@R@', 'buurt')
		, Descr = "The CBS neighbourhoods of the year, with their centroids weighted by the residential addresses of the BAG of the same year."
		{
			attribute<string>    name                         := AsItemName(statnaam);
			attribute<string>    label                        := statcode;
			attribute<.>         per_rdc_100m      (rdc_100m) := poly2grid(Geometry, rdc_100m);
			
			attribute<rdc>       address_weighted_centroid    := =ModelParameters/Advanced/ExcludeOrgNeighbourhoodCentroidsWithoutAddressPop
			                                                     ? 'CalcAddressCentroids/HasAddresses
			                                                         ? CalcAddressCentroids/centroid
			                                                         : null_fp'
			                                                     : 'CalcAddressCentroids/centroid';
																		
			attribute<rdc>       centroid                     := address_weighted_centroid;
			attribute<Centroids> Centroids_rel                := rlookup(centroid, Centroids/geometry);

			unit<uint32> CalcAddressCentroids := .
			{
				attribute<float64> x_mean           := mean(pointcol(Addresses/geometry), Addresses/region_rel);
				attribute<float64> y_mean           := mean(pointrow(Addresses/geometry), Addresses/region_rel);
				attribute<rdc>     centroid0        := point_xy(x_mean, y_mean, rdc);

				// checks
				attribute<.>       poly_rel         := point_in_polygon(centroid0, ../geometry);
				attribute<string>  statcode_poly    := ../statcode;
				attribute<string>  statcode_centr   := statcode_poly[poly_rel];
				attribute<bool>    IsStatcode_equal := statcode_poly == statcode_centr;
				attribute<bool>    HasAddresses     := pcount(Addresses/region_rel) > 0;

				attribute<rdc>     centroid_or_mid  := centroid_or_mid(../geometry);
				attribute<rdc>     centroid         := IsStatcode_equal ? centroid0 : centroid_or_mid;

				unit<uint32> Addresses := BAG/Adressen/Residential_Stock
				{
					attribute<...> region_rel := point_in_polygon(geometry, .../geometry);
				}
			}

			unit<uint32> Centroids := unique(centroid)
			{
				attribute<Geography/rdc> geometry       := values;
				attribute<string>        name           := ../statcode[invert(Centroids_rel)];
				attribute<string>        label          := ../statnaam[invert(Centroids_rel)];
				attribute<Gemeente>      gemeente_rel   := point_in_polygon(geometry, Gemeente/geometry);
				attribute<Provincie>     prov_rel       := point_in_polygon(geometry, Provincie/geometry);
				attribute<Corop>         corop_rel      := point_in_polygon(geometry, Corop/geometry);
				attribute<Coropp>        coropp_rel     := point_in_polygon(geometry, Coropp/geometry);
				container                V              := for_each_nedv(AsItemName(name), 'value('+string(id(.))+', ..)', void, .);
			}
		}
	}
	
	unit<uint32> Buurt := ='Divisions/y'+Regions_year+'/buurt'
	{
		attribute<rdc>    geometry   (poly) := ='Divisions/y'+Regions_year+'/buurt/geometry';
		attribute<string> statcode          := ='Divisions/y'+Regions_year+'/buurt/statcode';
		attribute<string> statnaam          := ='Divisions/y'+Regions_year+'/buurt/statnaam';
				
		unit<uint32>      Enkele_Buurt      := ='select_with_attr_by_cond(Centroids, id(Centroids) == Centroids/v/'+ModelParameters/Orgset_SingleNeighbourhood_Selection+')';
		unit<uint32>      Enkele_Buurt_dest := ='select_with_attr_by_cond(Centroids, id(Centroids) == Centroids/v/'+ModelParameters/Destset_SingleNeighbourhood_Selection+')';
		unit<uint32>      Enkele_Gemeente   := ='select_with_attr_by_cond(Centroids, Centroids/gemeente_rel == Gemeente/V/'+ModelParameters/Orgset_SingleMunicipality_Selection+')';
		unit<uint32>      Enkele_Prov       := ='select_with_attr_by_cond(Centroids, Centroids/prov_rel == Provincie/V/'+ModelParameters/Orgset_SingleProvince_Selection+')';
		unit<uint32>      Enkele_Corop      := ='select_with_attr_by_cond(Centroids, Centroids/corop_rel == COROP/V/'+ModelParameters/Orgset_SingleCorop_Selection+')';
		
		// Own destination sets: Enkele_Prov_dest and Enkele_Corop_dest use the destination selections (Destset_SingleProvince_Selection, Destset_SingleCorop_Selection) instead of the origin selections.
		unit<uint32>      Enkele_Prov_dest  := ='select_with_attr_by_cond(Centroids, Centroids/prov_rel == Provincie/V/'+ModelParameters/Destset_SingleProvince_Selection+')';
		unit<uint32>      Enkele_Corop_dest := ='select_with_attr_by_cond(Centroids, Centroids/corop_rel == COROP/V/'+ModelParameters/Destset_SingleCorop_Selection+')';
		
		container         Per_Prov          :=
			for_each_ne(
				provincie/name
				, 'Per_Prov_T('+string(id(provincie))+', Centroids)'
			);
		container         Per_COROP         :=
			for_each_ne(
				COROP/name
				, 'Per_COROP_T('+string(id(COROP))+', Centroids)'
			);
		container         Per_COROPp        :=
			for_each_ne(
				COROPp/name
				, 'Per_COROPp_T('+string(id(COROPp))+', Centroids)'
			);
	}
	
	unit<uint32> Wijk := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'wijk')
	{
		attribute<rdc>       geometry              (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'wijk')+'/geometry';
		attribute<string>    statcode                     := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'wijk')+'/statcode';
		attribute<string>    statnaam                     := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'wijk')+'/statnaam';
		attribute<string>    name                         := AsItemName(statnaam);
		attribute<string>    label                        := statnaam;
		attribute<.>         per_rdc_100m      (rdc_100m) := poly2grid(Geometry, rdc_100m);
		
		
		attribute<rdc>       address_weighted_centroid    := ='Divisions/y'+Regions_year+'/BAG/Adressen/Residential_Stock/wijk/centroid';
		attribute<rdc>       centroid                     := address_weighted_centroid;
		attribute<Centroids> Centroids_rel                := rlookup(centroid, Centroids/geometry);
		
		unit<uint32> Centroids := unique(centroid)
		{
			attribute<Geography/rdc> geometry       := values;
			attribute<string>        name           := ../statcode[invert(Centroids_rel)];
			attribute<string>        label          := ../statnaam[invert(Centroids_rel)];
			attribute<Provincie>     prov_rel       := point_in_polygon(geometry, Provincie/geometry);
			attribute<Corop>         corop_rel      := point_in_polygon(geometry, Corop/geometry);
			container                V              := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
		}
		
		container            Per_Prov                     :=
			for_each_ne(
				provincie/name
				, 'Per_Prov_T('+string(id(provincie))+', Centroids)'
			);
		container            Per_COROP                    :=
			for_each_ne(
				COROP/name
				, 'Per_COROP_T('+string(id(COROP))+', Centroids)'
			);
	}
	
	unit<uint32> Gemeente := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'gemeente')
	{
		attribute<rdc>       geometry              (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'gemeente')+'/geometry';
		attribute<string>    statcode                     := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'gemeente')+'/statcode';
		attribute<string>    statnaam                     := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_str), '@R@', 'gemeente')+'/statnaam';
		attribute<string>    name                         := AsItemName(statnaam);
		attribute<string>    label                        := statnaam;
		attribute<.>         per_rdc_100m      (rdc_100m) := poly2grid(Geometry, rdc_100m);

		container            V                            := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
		
		attribute<rdc>       address_weighted_centroid    := ='Divisions/y'+Regions_year+'/BAG/Adressen/Residential_Stock/gemeente/centroid';
		attribute<rdc>       centroid                     := address_weighted_centroid;
		attribute<Centroids> Centroids_rel                := rlookup(centroid, Centroids/geometry);
		
		unit<uint32> Centroids := unique(centroid)
		{
			attribute<Geography/rdc> geometry       := values;
			attribute<string>        name           := ../statcode[invert(Centroids_rel)];
			attribute<string>        label          := ../statnaam[invert(Centroids_rel)];
			attribute<Provincie>     prov_rel       := point_in_polygon(geometry, Provincie/geometry);
			attribute<Corop>         corop_rel      := point_in_polygon(geometry, Corop/geometry);
			container                V              := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			container                V_Code         := for_each_nedv(AsItemName(name), 'value('+string(id(.))+', ..)', void, .);
		}
		
		unit<uint32>         Enkele_Gemeente              := ='select_with_attr_by_cond(Centroids, id(Centroids) == Centroids/V_Code/'+ModelParameters/Orgset_SingleMunicipality_Selection+')';
		
		container            Per_Prov                     :=
			for_each_ne(
				provincie/name
				, 'Per_Prov_T('+string(id(provincie))+', Centroids)'
			);
		container            Per_COROP                    :=
			for_each_ne(
				COROP/name
				, 'Per_COROP_T('+string(id(COROP))+', Centroids)'
			);
	}
	
	unit<uint32> Corop := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropgebied')+''
	{
		attribute<rdc>    geometry         (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropgebied')+'/geometry';
		attribute<string> statcode                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropgebied')+'/statcode';
		attribute<string> statnaam                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropgebied')+'/statnaam';
		attribute<string> name                    := AsItemName(statnaam);
		attribute<string> label                   := statnaam;
		attribute<.>      per_rdc_100m (rdc_100m) := poly2grid(Geometry, rdc_100m);

		container         V                       := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<uint32> CoropP := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropplusgebied')+''
	, KeepData = "true"
	{
		attribute<rdc>    geometry         (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropplusgebied')+'/geometry';
		attribute<string> statcode                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropplusgebied')+'/statcode';
		attribute<string> statnaam                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'coropplusgebied')+'/statnaam';
		attribute<string> name                    := AsItemName(statnaam);
		attribute<string> label                   := statnaam;
		attribute<.>      per_rdc_100m (rdc_100m) := poly2grid(Geometry, rdc_100m);

		container         V                       := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<uint32> Provincie := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'provincie')+''
	{
		attribute<rdc>    geometry         (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'provincie')+'/geometry';
		attribute<string> statcode                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'provincie')+'/statcode';
		attribute<string> statnaam                := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'provincie')+'/statnaam';
		attribute<string> name                    := replace(AsItemName(statnaam), 'Fryslân', 'Friesland');
		attribute<string> label                   := statnaam;
		attribute<.>      per_rdc_100m (rdc_100m) := poly2grid(Geometry, rdc_100m);

		container         V                       := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<uint32> Zorgkantoorregio := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'zorgkantoorregio')+''
	{
		attribute<rdc>    geometry (poly) := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'zorgkantoorregio')+'/geometry';
		attribute<string> statcode        := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'zorgkantoorregio')+'/statcode';
		attribute<string> statnaam        := ='Divisions/y'+Regions_year+'/gpkg/'+replace(rjoin(Regions_year, string(Divisions_years/year), Divisions_years/Path_Gen_str), '@R@', 'zorgkantoorregio')+'/statnaam';
		attribute<string> name            := AsItemName(statnaam);
		attribute<string> label           := statnaam;

		container         V               := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	unit<uint32> NL := range(uint32, 0, 1)
	{
		attribute<rdc>    geometry              (poly) := union_data(., geos_union_polygon(Corop/geometry)), Descr = "geos_* needs float64 coordinates, which is why rdc is a dpoint.";
		attribute<string> name                         : [ 'All' ];
		attribute<rdc>    Netherlands_10kbuffer (poly) := bg_outer_multi_polygon(geos_buffer_multi_polygon(geometry, 10000d, 16b));
	}
	
	unit<uint8>       Concessiegebied   := ='Concessiegebieden/'+ModelParameters/Impl/ConcessionArea_year+'/Concessiegebied', Descr = "The public transport concession areas of the year ModelParameters/Impl/ConcessionArea_year.";
	
	// Concession shapes exist for 2020 to 2026 (Concessie_YYYY.shp). They are read per year, so that ConcessionArea_year = 'Y' + FareTable_year
	// works for every available year (relevant for PriceMethod 'DOVA'). For years before 2020 (the DOVA km fares go back to 2013) there is no
	// shape, and ModelParameters/Impl/ConcessionArea_year takes 2020 instead.
	unit<uint32> Concession_years := range(uint32, 2020, 2027)
	{
		attribute<uint32> year     := id(.);
		attribute<string> year_str := string(year);
		attribute<string> name     := 'Y'+year_str;
	}

	Template Read_Concession_T
	{
		parameter<string> year;
		//
		unit<uint32> shape
		: StorageName = "='%NetworkModel_dir%/RegioIndelingen/Concessiegebieden/Concessie_'+year+'.shp'"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, DialogData = "rdc"
		{
			attribute<string> name := AsItemName(concessie);
			attribute<Concessiegebied> Concessiegebied_rel := rlookup(name, Concessiegebied/name);
		}

		unit<uint8> Concessiegebied := union_unit_uint8(shape)
		{
			attribute<rdc>    geometry (poly) := union_data(., shape/geometry);
			attribute<string> name            := union_data(., shape/name);
			attribute<string> label           := name;
		}
	}

	container         Concessiegebieden :=
		for_each_ne(
			Concession_years/name
			, 'Read_Concession_T('+quote(Concession_years/year_str)+')'
		);
	
	Template Per_Prov_T
	{
		parameter<uint32> prov_id;
		unit<uint32>      domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/prov_rel == '+string(prov_id)+')'
		{
			attribute<rdc>    geometry       := domain/geometry[org_rel];
			attribute<string> name           := domain/name[org_rel];
			attribute<string> label          := domain/label[org_rel];
		}
	}
	Template Per_COROP_T
	{
		parameter<uint32> COROP_id;
		unit<uint32>      domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/corop_rel == '+string(COROP_id)+')'
		{
			attribute<rdc>    geometry       := domain/geometry[org_rel];
			attribute<string> name           := domain/name[org_rel];
			attribute<string> label          := domain/label[org_rel];
		}
	}
	Template Per_CoropP_T
	{
		parameter<uint32> CoropP_id;
		unit<uint32>      domain;
		//
		unit<uint32> sub := ='select_with_org_rel(domain/CoropP_rel == '+string(CoropP_id)+')'
		{
			attribute<rdc>    geometry       := domain/geometry[org_rel];
			attribute<string> name           := domain/name[org_rel];
			attribute<string> label          := domain/label[org_rel];
		}
	}
}
