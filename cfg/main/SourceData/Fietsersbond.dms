// The route network of the Fietsersbond (routeplanner.fietsersbond.nl). The shapefiles are in RD New (EPSG:28992), so directly in rdc.
//
// links.shp and nodes.shp form a topological network: links/van_id and links/naar_id refer to nodes/id, so F1 and F2 follow with an rlookup
// and no connect step is needed (a few links lack a node, see links/NrLinksZonderNode). The network has no measured cycling speeds (those are
// in the Fietstelweek), but per link it has the cycling access per direction (toegang), road type, surface, quality, nuisance, lighting,
// surroundings, gradient classes and the speed limit for cars.
// The other shapefiles are POI layers (cycle junctions, bollards, ferries, obstacles and more), and the *_relations.txt files link them to the
// nodes or the links. Only the cycle junctions are included here; the other layers have field names with spaces and are not needed for routing.
//
// Network_Cycling is the cycling network of the model when ModelParameters/Advanced/CyclingNetwork is 'Fietsersbond' (#124).

container Fietsersbond
:	Descr = "The route network of the Fietsersbond: links and nodes with a van_id/naar_id topology, without cycling speeds.", Source = "Fietsersbond route network (routeplanner.fietsersbond.nl), delivered to PBL on 25-05-2025 as '250525 Data fietsersbond netwerk.zip', unpacked in %NetworkModel_Dir%/Infrastructuur/Fietsersbond_20250525"
,	URL   = "https://routeplanner.fietsersbond.nl"
{
	parameter<string> file_date := ModelParameters/Advanced/Fietsersbond_file_date;
	parameter<string> dir       := '%NetworkModel_Dir%/Infrastructuur/Fietsersbond_'+file_date;

	unit<uint32> links
	:	StorageName     = "= dir + '/links.shp'"
	,	Descr           = "The links of the route network."
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	,	SyncMode        = "none"
	{
		attribute<rdc>     geometry (arc);
		attribute<int32>   id;
		attribute<int32>   van_id;
		attribute<int32>   naar_id;
		attribute<float64> lengte                                                      : Descr = "Length in metres according to the delivery; it matches arc_length(geometry).";
		attribute<string>  toegang                                                     : Descr = "Cycling access per direction: 'beide' (both), 'heen' (in the digitising direction van_id -> naar_id), 'terug' (against it) or 'geen' (none).";
		attribute<string>  toegang_sp                                                  : Descr = "The same for the speed pedelec.";
		attribute<string>  straat;
		attribute<string>  wegnummer;
		attribute<string>  plaats;
		attribute<string>  gemeente;
		attribute<string>  provincie;
		attribute<string>  navigatie                                                   : Descr = "'standaard' (standard), 'onderdeel van kruispunt' (part of a junction), 'onderdeel van rotonde' (part of a roundabout) or empty.";
		attribute<string>  ongelijkv                                                   : Descr = "Grade separation: 'nee' (none), 'ergens overheen' (over something), 'ergens onderdoor' (under something) or 'tunnel > 200 m'.";
		attribute<string>  wegNiveau                                                   : Descr = "Road level: 'overige weg' (other road), 'belangrijke hoofdweg' (main road), 'langs hoofdweg' (along a main road), 'autosnelweg' (motorway), 'ONBEKEND' (unknown) or empty.";
		attribute<string>  wegtype                                                     : Descr = "Road type in 18 classes, among them 'normale weg', 'fietspad (langs weg)', 'solitair fietspad', 'fietsstraat', 'weg met fiets(suggestie)strook', 'voetgangersgebied' and 'veerpont' (ferry).";
		attribute<string>  wegdeksrt                                                   : Descr = "Road surface: 'asfalt/beton', 'klinkers', 'tegels', 'halfverhard', 'onverhard', 'schelpenpad' or 'overig (hout/kinderkopjes e.d.)'.";
		attribute<string>  wegkwal                                                     : Descr = "Road quality: 'goed' (good), 'redelijk' (fair) or 'slecht' (poor).";
		attribute<string>  hinder                                                      : Descr = "Nuisance from other traffic, from 'zeer weinig' (very little) through 'weinig', 'redelijk' and 'veel' to 'zeer veel' (very much).";
		attribute<string>  verlichting;
		attribute<string>  omgeving;
		attribute<string>  water;
		attribute<string>  schoonheid;
		attribute<string>  maxsnelheid                                                 : Descr = "The speed limit for cars on the road (km/h as text, also 'stapvoets (15)'), not a cycling speed.";
		attribute<string>  hoofdroute                                                  : Descr = "Part of a main route of the Fietsersbond: 'beide', 'heen', 'terug' or 'geen', as in toegang.";
		attribute<string>  knooppunt                                                   : Descr = "Part of the cycle junction network: 'beide', 'heen', 'terug' or 'geen', as in toegang.";
		attribute<string>  lf                                                          : Descr = "The LF routes (long-distance cycle routes) over this link.";
		attribute<string>  routes;
		attribute<string>  BiBK                                                        : Descr = "Moped on the carriageway in the built-up area: 'ja' (yes) or 'nee' (no).";
		attribute<string>  wegbeheer;
		attribute<string>  strooien;
		attribute<string>  snelfiets                                                   : Descr = "Fast cycle route: 'ja' (yes) or 'nee' (no).";
		attribute<string>  breedtekls                                                  : Descr = "Width class of the cycle path ('< 1 meter' to '5 meter en breder'), mostly empty.";
		attribute<string>  gem_st_fwd                                                  : Descr = "Average gradient in the forward direction: '<1%', '1-2%', '2-4%' or '>4%'.";
		attribute<string>  gem_st_bwd;
		attribute<string>  max_st_fwd                                                  : Descr = "Maximum gradient in the forward direction: '<1%' to '>20%'.";
		attribute<string>  max_st_bwd;
		attribute<string>  lanes_fwd;
		attribute<string>  lanes_bwd;
		attribute<string>  is_af;
		attribute<float64> extreistijd;

		attribute<nodes>   F1                := rlookup(van_id,  nodes/id);
		attribute<nodes>   F2                := rlookup(naar_id, nodes/id);
		attribute<bool>    IsBikeAccessible  := toegang != 'geen';
		attribute<bool>    IsOneDirection    := toegang == 'heen' || toegang == 'terug';
		attribute<bool>    IsReversed        := toegang == 'terug', Descr = "Rideable only against the digitising direction, so a directed network must reverse F1 and F2 or the geometry.";
		attribute<m>       length            := arc_length(geometry, m_f64)[m];

		parameter<uint32>  NrLinksZonderNode := sum(uint32(!IsDefined(F1) || !IsDefined(F2)))
		,	Descr = "The number of links whose van_id or naar_id is missing in nodes.shp; Network_Cycling leaves them out.";
	}

	unit<uint32> nodes
	:	StorageName     = "= dir + '/nodes.shp'"
	,	Descr           = "The nodes of the route network."
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	,	SyncMode        = "none"
	{
		attribute<rdc>     geometry;
		attribute<int32>   id;
		attribute<int32>   knppnt_id;
		attribute<int32>   knooppunt                                                   : Descr = "Number of the cycle junction at this node, 0 if there is none.";
		attribute<string>  plaatsnaam;
		attribute<string>  alias1;
		attribute<string>  alias2;
		attribute<string>  plaatstype;
		attribute<string>  gemeente;
		attribute<string>  provincie;
		attribute<int32>   NrOfLinks;

		parameter<uint32>  NrZonderPositie   := sum(uint32(id < 0i))
		,	Descr = "The number of nodes without a real position, recognised by a negative id; such a node lies at xy(0;0).";
	}

	// The cycling network of the model (#124), with the attributes of OSM/Network_Cycling, so that CreateNetwork_Efficient_T and the cycling legs
	// work with it unchanged:
	// - the links with cycling access and two known nodes; a ferry only up to Fietsersbond_MaxVeerpontLengte;
	// - one-way (toegang 'heen' or 'terug'): IsOneDirection, with the geometry in the direction of travel, so 'terug' reversed;
	// - speed CyclingSpeed_kmhr and E_BikingSpeed_kmhr; lower on a ferry, so that the time over the link is length / speed +
	//   Fietsersbond_VeerpontExtraTijd; there are no Fietstelweek speeds, so the rush hour speed is the free-flow speed;
	// - roadType_rel for the junction penalty (IsSlowTrafficRoad): 'ferry' for a ferry, 'tertiary' for a road with cars above 30 km/h,
	//   'residential' for a road up to 30 km/h, 'cycleway' for the rest (cycle paths, pedestrian areas).
	// The model builds the topology from the end points of the segments (arc2segm), not from van_id and naar_id. Where two nodes lie at the
	// same place, or where intermediate points of different links coincide, the model connects them too, as with OSM.
	attribute<bool> IsInNetwork (links) := links/IsBikeAccessible && IsDefined(links/F1) && IsDefined(links/F2)
		&& (links/wegtype != 'veerpont' || links/length <= ModelParameters/Advanced/Fietsersbond_MaxVeerpontLengte);

	unit<uint32> Network_Cycling := select_with_org_rel(IsInNetwork)
	{
		attribute<rdc>      geometry_digitised (arc)     := collect_by_cond(., IsInNetwork, links/geometry), Descr = "In the digitising direction, from van_id to naar_id.";
		attribute<string>   toegang                      := collect_by_cond(., IsInNetwork, links/toegang);
		attribute<string>   wegtype                      := collect_by_cond(., IsInNetwork, links/wegtype);
		attribute<uint32>   MaxSnelheidAuto              := uint32(MakeDefined(regex_search(collect_by_cond(., IsInNetwork, links/maxsnelheid), '[0-9]+'), '0')), Descr = "The first number in maxsnelheid ('stapvoets (15)' gives 15), or 0 without one.";
		attribute<bool>     IsVeerpont                   := wegtype == 'veerpont';
		attribute<bool>     IsWeg                        := wegtype == 'normale weg' || wegtype == 'weg met fiets(suggestie)strook' || wegtype == 'ventweg' || wegtype == 'fietsstraat' || wegtype == 'ONBEKEND', Descr = "A road with cars, not a cycle path or pedestrian area.";
		attribute<bool>     IsReversed                   := toegang == 'terug';
		unit<uint32> Points := sequence2points(geometry_digitised)
		{
			attribute<uint32> Ordinal_rijrichting := IsReversed[sequence_rel] ? pcount(sequence_rel)[sequence_rel] - 1 - ordinal : ordinal;
		}
		attribute<rdc>      geometry (arc)               := points2sequence(Points/point, Points/sequence_rel, Points/Ordinal_rijrichting), Descr = "In the direction of travel: a link with toegang 'terug' is reversed.";
		attribute<classifications/OSM/roadType> roadType_rel := IsVeerpont ? Classifications/OSM/roadType/V/ferry : IsWeg && MaxSnelheidAuto > 30 ? Classifications/OSM/roadType/V/tertiary : IsWeg ? Classifications/OSM/roadType/V/residential : Classifications/OSM/roadType/V/cycleway;
		attribute<string>   OSM_id                       := 'fb' + string(collect_by_cond(., IsInNetwork, links/id)), Descr = "The link id of the Fietsersbond, under the name that OSM/Network_Cycling uses.";
		attribute<string>   roadType_label               := Classifications/OSM/roadType/label[roadType_rel];
		attribute<bool>     IsOneDirection               := toegang == 'heen' || toegang == 'terug';
		attribute<bool>     Connectable                  := not(IsVeerpont), Descr = "Origins, destinations and stops do not attach to a ferry.";

		attribute<km>       LengthKm                     := convert(collect_by_cond(., IsInNetwork, links/length), km);
		attribute<min_f>    ExtraTijd                    := IsVeerpont ? ModelParameters/Advanced/Fietsersbond_VeerpontExtraTijd : 0[min_f];
		attribute<km_hr>    speed_max_car                := const((0/0)[km_hr],.);
		attribute<km_hr>    speed_max_limit_car          := const((0/0)[km_hr],.);
		attribute<km_hr>    speed_max_cycling            := IsVeerpont ? LengthKm / convert(convert(LengthKm / ModelParameters/CyclingSpeed_kmhr, min_f) + ExtraTijd, hr_f) : const(ModelParameters/CyclingSpeed_kmhr, .);
		attribute<km_hr>    speed_max_e_bike             := IsVeerpont ? LengthKm / convert(convert(LengthKm / ModelParameters/Advanced/E_BikingSpeed_kmhr, min_f) + ExtraTijd, hr_f) : const(ModelParameters/Advanced/E_BikingSpeed_kmhr, .);
		attribute<km_hr>    speed_max_walking            := const((0/0)[km_hr],.);
		attribute<km_hr>    speed_congested_cycling      := speed_max_cycling, Descr = "There are no Fietstelweek speeds here, so this is the free-flow speed.";
		attribute<km_hr>    speed_congested_e_bike       := speed_max_e_bike;
		attribute<km_hr>    speed_congested_morning_car  := const((0/0)[km_hr],.);
		attribute<km_hr>    speed_congested_noon_car     := const((0/0)[km_hr],.);
		attribute<km_hr>    speed_congested_late_car     := const((0/0)[km_hr],.);
	}

	unit<uint32> Fietsknooppunten
	:	StorageName     = "= dir + '/knooppunt(Fietsknooppunten).shp'"
	,	Descr           = "The cycle junctions of the route network."
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	,	SyncMode        = "none"
	{
		attribute<rdc>     geometry;
		attribute<int32>   id;
		attribute<string>  Knooppunt;
		attribute<string>  Gemeente;
		attribute<string>  Provincie;
		attribute<string>  Naam;
	}
}
