container NetworkPreperation : Descr = "Prepares the OSM road network: it cuts the roads into segments, adds the extra connections and keeps the largest connected part."
{  
	unit<uint32> road := Merge_SourceData/Merge_Country_Roads;
	
	container preperation
	{
		unit<uint32> road_segments := arc2segm(road/geometry)
		{
			attribute<string>   key            := String(pointRow(point)) + '_' + String(pointCol(point)) + '_' + String(pointRow(nextpoint)) + '_'+ String(pointCol(nextpoint));
			attribute<roadType> roadType_rel   := road/roadType_rel[Sequence_rel];
			attribute<km_hr>    maxspeed       := road/maxspeed[Sequence_rel];
			attribute<string>   OSM_id         := road/OSM_id[Sequence_rel];
			attribute<bool>     IsOneDirection := road/IsOneDirection[Sequence_rel];
			
			unit<uint32> pointset := union_unit(., .)
			{
				attribute<rdc>    point  := Union_Data(., ../point, ../nextpoint);
				attribute<..>     ArcID  := value(ID(.) % nrofrows(..), ..);
				attribute<uint32> VolgNr := ID(.) / nrofrows(..);
			}
			attribute<rdc>      geometry (arc) := points2sequence(pointset/point, pointset/ArcID, pointset/VolgNr);
		}
		
		#include <ExtraConnections.dms>
		
		unit<uint32> road_segments_with_extra_nodes := connect(road_segments/geometry, ExtraConnections/nodes/geometry)
		{
			attribute<roadType> roadType_rel   := MakeDefined(road_segments/roadType_rel[arc_rel], /Classifications/OSM/roadType/V/connectlink);
			attribute<km_hr>    maxspeed       := MakeDefined(road_segments/maxspeed[arc_rel], ModelParameters/Advanced/CarDefaultSpeed);
			attribute<string>   OSM_id         := road_segments/OSM_id[arc_rel];
			attribute<bool>     IsOneDirection := road_segments/IsOneDirection[arc_rel];
			 
		}
	}
	
	unit<uint32> Network_with_extraconnections := ='union_unit(preperation/road_segments_with_extra_nodes, preperation/ExtraConnections/link)'
	{
		attribute<rdc>      geometry   (arc) := union_data(., preperation/road_segments_with_extra_nodes/geometry, preperation/ExtraConnections/link/geometry);
		attribute<roadType> roadType_rel     := union_data(., preperation/road_segments_with_extra_nodes/roadType_rel,   preperation/ExtraConnections/link/roadType_rel);
		attribute<km_hr>    maxspeed         := union_data(., preperation/road_segments_with_extra_nodes/maxspeed,  preperation/ExtraConnections/link/maxspeed);
		attribute<string>   OSM_id           := union_data(., preperation/road_segments_with_extra_nodes/OSM_id,  const('',preperation/ExtraConnections/link));
		attribute<bool>     IsOneDirection   := union_data(., preperation/road_segments_with_extra_nodes/IsOneDirection,  const(FALSE,preperation/ExtraConnections/link));
		attribute<rdc>      point            := first_point(geometry);
		attribute<rdc>      nextpoint        := last_point(geometry);
			
		unit<uint32> pointset : = union_unit(., .)
		{
			attribute<rdc>  point           := union_data(., ../point, ../nextpoint);
			attribute<bool> IsInMainNetwork := isNull(rlookup(point, NodesNotConnected/point));
			attribute<..>   ArcNr           := value(ID(.) % #(..), ..);
		}

		attribute<bool>     IsInMainNetwork  := all(pointset/IsInMainNetwork, pointset/ArcNr);

		unit<uint32> NodeSet := unique(pointset/point)
		,	DialogData = "Values"
		,	DialogType = "Map"
		{
			attribute<rdc> values;
		}

		attribute<NodeSet>  F1               := rlookup(point,     NodeSet/Values);
		attribute<NodeSet>  F2               := rlookup(nextpoint, NodeSet/Values);
	
		unit<uint32> networks := connected_parts(F1, F2) // All networks, including the subnetworks.
		{
			attribute<uint32>   nr_nodes   := sum(const(1, NodeSet, uint32), part_rel);
			parameter<uint32>   MaxNrNodes := max(networks/nr_nodes);
			parameter<networks> main       := rlookup(MaxNrNodes, nr_nodes); // assumption: the network with the most nodes is the relevant network
		}

		unit<uint32> NodesNotConnected := select_with_org_rel(networks/part_rel <> networks/main)
		{
			attribute<rdc> point := NodeSet/Values[org_rel];
		}
		
		unit<uint32>        ConnectedNetwork := select_with_attr_by_cond(., IsInMainNetwork); // the resulting connected road network
	}
}
