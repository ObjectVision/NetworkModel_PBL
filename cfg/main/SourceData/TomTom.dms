container TomTom : Descr = "The TomTom MultiNet road network with its historical speed profiles, of the edition that the analysis moment sets, for the car network."
{ 
	parameter<string> file_date := rjoin(ModelParameters/AnalysisMoment, ModelParameters/Advanced/AnalysisMomentPresets/name, ModelParameters/Advanced/AnalysisMomentPresets/CarCongestionSpeed_date), Descr = "The folder name of the TomTom edition of the analysis moment.";
	
	unit<uint8> Moments : nrofrows = 11, Descr = "The moments of the TomTom speeds: the speed moments weekday, weekend, week and freeflow, and the seven days of the week."
	{
		attribute<string> name : ['weekday','weekend','week','freeflow','sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
	}
		
	parameter<string> CacheDir := '%LocalDataProjDir%/TomTom/' + file_date, Descr = "The folder in LocalData with the four caches of the edition (Roads, Junctions, Speednetworks, Speedprofiles), which Impl makes from the raw material in Impl/dir.";
	
	container Impl : Descr = "Makes the four TomTom caches (Roads, Junctions, Speednetworks, Speedprofiles) of the edition in CacheDir, from its raw MultiNet files or from an old fss in Impl/dir."
	{
		parameter<string> dir       := '%NetworkModel_PrivDir%/TomTom/'+file_date+'', Descr = "The folder of the edition with the raw material (multinet, speedprofiles) or an old fss; the model only reads here, with forward slashes.";
		
		parameter<string> Generate_FileList_CSVs := 'Ready', ExplicitSuppliers = "GetFileNames_Network/WriteFilesCSV;GetFileNames_Speedprofiles/WriteFilesCSV";
		parameter<string> Write_All              := 'Ready', ExplicitSuppliers = "Write_Roads;Write_Junctions;Write_Speednetworks;Write_Speedprofiles";

		// The four caches come from the raw material (Merge_*, folder multinet/ of the edition) or, for an edition that only exists as an old fss,
		// from that fss (FromFss). UpdateAll.cmd sources calls these four.
		parameter<bool>   HasRawMaterial         := ExistingFile('', expand(., dir + '/multinet')) != '', Descr = "True when the edition has the raw material (multinet/); otherwise the caches come from the fss (FromFss).";
		parameter<string> Write_Roads            := 'Ready', ExplicitSuppliers = "=HasRawMaterial ? 'Merge_Roads' : 'FromFss/Roads'";
		parameter<string> Write_Junctions        := 'Ready', ExplicitSuppliers = "=HasRawMaterial ? 'Merge_Junctions' : 'FromFss/Junctions'";
		parameter<string> Write_Speednetworks    := 'Ready', ExplicitSuppliers = "=HasRawMaterial ? 'Merge_Speednetworks' : 'FromFss/Speednetworks'";
		parameter<string> Write_Speedprofiles    := 'Ready', ExplicitSuppliers = "=HasRawMaterial ? 'Merge_Speedprofiles' : 'FromFss/Speedprofiles'";
		
		unit<uint32> FileNames_Roads         := GetFileNames_Network/Files/Files_polylines;
		unit<uint32> FileNames_Junctions     := GetFileNames_Network/Files/Files_points;
		unit<uint32> FileNames_Speedprofiles_network := GetFileNames_Speedprofiles/Files/Files_HSNP;
		unit<uint32> FileNames_Speedprofiles_profile := GetFileNames_Speedprofiles/Files/Files_HSPR;
	
		container Read_TomTom_Files_Roads := 
			for_each_ne(
				FileNames_Roads/name
				,'Read_TomTom_Files_T('+quote(FileNames_Roads/path)+')'
			);
			
		container Read_TomTom_Files_Junctions := 
			for_each_ne(
				FileNames_Junctions/name
				,'Read_TomTom_Files_T('+quote(FileNames_Junctions/path)+')'
			);
			
		container Read_TomTom_Files_SP_network := 
			for_each_ne(
				FileNames_Speedprofiles_network/name
				,'Read_TomTom_Files_T('+quote(FileNames_Speedprofiles_network/path)+')'
			);
		container Read_TomTom_Files_SP_profiles := 
			for_each_ne(
				FileNames_Speedprofiles_profile/name
				,'Read_TomTom_Files_T('+quote(FileNames_Speedprofiles_profile/path)+')'
			);
			
		Template Read_TomTom_Files_T
		{
			parameter<string> File_path;
			///
			
			unit<uint32> Read 
			:	StorageName     = "= File_path"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True";
		}
	
		unit<uint32>  Merge_Roads := ='union_unit('+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read', ',')+')'
		, StorageName = "=CacheDir + '/Roads.mmd'"
		{
			attribute<rdc>    geometry (arc)               := ='union_data(., '+asList('LatLongWgs842RD(Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/geometry, dpoint)[rdc]', ',')+')';
			attribute<uint64> NW_ID                        := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/ID[uint64]', ',')+')';
			attribute<uint8>  FRC                          := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/FRC[uint8]', ',')+')', Descr = "functional road class";
			attribute<int32>  FeatureType                  := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/FEATTYP', ',')+')', Descr = "4110=Road element, 4130=Ferry connection, 4165= address boundary element";
			attribute<uint8>  FerryType                    := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/FT[uint8]', ',')+')', Descr = "0=no ferry, 1 = ferry conn operated by ship or hovercraft, 2 = rail connection ferry operated by train";
			attribute<uint64> F_JNCTID                     := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/F_JNCTID[uint64]', ',')+')', Descr = "From junction identifier";
			attribute<uint64> T_JNCTID                     := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/T_JNCTID[uint64]', ',')+')', Descr = "To junction identifier";
			attribute<uint8>  F_JNCTTYP                    := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/F_JNCTTYP[uint8]', ',')+')', Descr = "From junction type; 0=junction, 2, bifurcation, 3 = railway crossing, 4 = country border crossing, 5 = ferry operated by train crossing, 6 = internal data set border crossing";
			attribute<uint8>  T_JNCTTYP                    := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/T_JNCTTYP[uint8]', ',')+')', Descr = "To junction type; 0=junction, 2, bifurcation, 3 = railway crossing, 4 = country border crossing, 5 = ferry operated by train crossing, 6 = internal data set border crossing";
			attribute<m>      METERS                       := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/METERS[m]', ',')+')', Descr = "Feature length";
			attribute<min_f>  MINUTES                      := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/MINUTES[min_f]', ',')+')', Descr = "travel time in minutes";
			attribute<string> ONEWAY                       := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/ONEWAY', ',')+')', Descr = "Direction of traffic flow: FT positive direction, N closed in both directions, TF negative direction";
			attribute<km_hr>  KPH                          := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/KPH[km_hr]', ',')+')', Descr = "Average speed";
			attribute<int8>   F_ELEV                       := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/F_ELEV[int8]', ',')+')', Descr = "From Z-level, -9 to 9";
			attribute<int8>   T_ELEV                       := ='union_data(., '+asList('Read_TomTom_Files_Roads/'+FileNames_Roads/name+'/Read/T_ELEV[int8]', ',')+')', Descr = "To Z-level, -9 to 9";
		}
		
		unit<uint32>  Merge_Junctions := ='union_unit('+asList('Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read', ',')+')'
		, StorageName = "=CacheDir + '/Junctions.mmd'"
		{
			attribute<rdc>    geometry                     := ='union_data(., '+asList('LatLongWgs842RD(Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read/geometry, dpoint)[rdc]', ',')+')';
			attribute<int32>  FeatureType                  := ='union_data(., '+asList('Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read/FEATTYP', ',')+')', Descr = "4110=Road element, 4130=Ferry connection, 4165= address boundary element";
			attribute<uint64> JNCTID                       := ='union_data(., '+asList('Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read/ID[uint64]', ',')+')', Descr = "junction identifier";
			attribute<uint8>  JNCTTYP                      := ='union_data(., '+asList('Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read/JNCTTYP[uint8]', ',')+')', Descr = "junction type; 0=junction, 2, bifurcation, 3 = railway crossing, 4 = country border crossing, 5 = ferry operated by train crossing, 6 = internal data set border crossing";
			attribute<int8>   ELEV                         := ='union_data(., '+asList('Read_TomTom_Files_Junctions/'+FileNames_Junctions/name+'/Read/ELEV[int8]', ',')+')', Descr = "Z-level, -9 to 9";
		}
		
		unit<uint32>  Merge_Speednetworks := ='union_unit('+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read', ',')+')'
		, StorageName = "=CacheDir + '/Speednetworks.mmd'"
		{
			attribute<uint64> NW_ID                        := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/network_id[uint64]', ',')+')', Descr = "network id";
			attribute<uint8>  VAL_DIR                      := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/val_dir[uint8]', ',')+')', Descr = "Validity direction: 2 = positive direction (from F_JNCTID to T_JNCTID of the road element), 3 = negative direction.";
			attribute<string> region_code                  := ='union_data(., '+asList('const('+quote(FileNames_Speedprofiles_network/SP_regioncode)+', Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read)', ',')+')', Descr = "file region code";
			attribute<uint16> SP_freeflow                  := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/spfreeflow[uint16]', ',')+')', Descr = "speedprofile freeflow";
			attribute<uint16> SP_weekday                   := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/spweekday[uint16]', ',')+')', Descr = "speedprofile weekday";
			attribute<uint16> SP_weekend                   := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/spweekend[uint16]', ',')+')', Descr = "speedprofile weekend";
			attribute<uint16> SP_week                      := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/spweek[uint16]', ',')+')', Descr = "speedprofile week";
			
			attribute<uint16> SP_Sunday                    := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_1[uint16]', ',')+')', Descr = "speedprofile sunday";
			attribute<uint16> SP_Monday                    := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_2[uint16]', ',')+')', Descr = "speedprofile monday";
			attribute<uint16> SP_Tuesday                   := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_3[uint16]', ',')+')', Descr = "speedprofile tuesday";
			attribute<uint16> SP_Wednesday                 := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_4[uint16]', ',')+')', Descr = "speedprofile wednesday";
			attribute<uint16> SP_Thursday                  := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_5[uint16]', ',')+')', Descr = "speedprofile thursday";
			attribute<uint16> SP_Friday                    := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_6[uint16]', ',')+')', Descr = "speedprofile friday";
			attribute<uint16> SP_Saturday                  := ='union_data(., '+asList('Read_TomTom_Files_SP_network/'+FileNames_Speedprofiles_network/name+'/Read/profile_7[uint16]', ',')+')', Descr = "speedprofile saturday";
		}
		
		unit<uint32>  Merge_Speedprofiles := ='union_unit('+asList('Read_TomTom_Files_SP_profiles/'+FileNames_Speedprofiles_profile/name+'/Read', ',')+')'
		, StorageName = "=CacheDir + '/Speedprofiles.mmd'"
		{
			attribute<int32>   profile_id                   := ='union_data(., '+asList('Read_TomTom_Files_SP_profiles/'+FileNames_Speedprofiles_profile/name+'/Read/profile_id', ',')+')', Descr = "profile id";
			attribute<string>  region_code                  := ='union_data(., '+asList('const('+quote(FileNames_Speedprofiles_profile/SP_regioncode)+', Read_TomTom_Files_SP_profiles/'+FileNames_Speedprofiles_profile/name+'/Read)', ',')+')', Descr = "file region code";
			attribute<int32>   time_slot                    := ='union_data(., '+asList('Read_TomTom_Files_SP_profiles/'+FileNames_Speedprofiles_profile/name+'/Read/time_slot', ',')+')', Descr = "The start of the time slot, in seconds since 00:00.";
			attribute<float32> rel_sp                       := ='union_data(., '+asList('Read_TomTom_Files_SP_profiles/'+FileNames_Speedprofiles_profile/name+'/Read/rel_sp[float32]', ',')+')', Descr = "relative speed";
		}

		// Converter for the editions that only exist as fss, yr2022_12 and yr2023_12. Those fss were written when rdc was fpoint, carry no value types
		// and have no raw material next to them any more, so Merge_* cannot make them. FromFss reads them with the value types of that time (the
		// geometry as Geography/rdc_f32, then [rdc]) and writes the same four mmd caches as Merge_*, in the same folder. The fss stay in place.
		container FromFss : Descr = "Makes the four caches of an edition that only exists as fss, reading the fss with the value types of that time."
		{
			unit<uint32> Roads_fss
			:	StorageName     = "='%NetworkModel_PrivDir%/TomTom/'+file_date+'/Roads_FSS.fss'"
			,	StorageReadOnly = "true"
			{
				attribute<Geography/rdc_f32> geometry (arc);
				attribute<uint64>             NW_ID;
				attribute<uint8>              FRC;
				attribute<int32>              FeatureType;
				attribute<uint8>              FerryType;
				attribute<uint64>             F_JNCTID;
				attribute<uint64>             T_JNCTID;
				attribute<uint8>              F_JNCTTYP;
				attribute<uint8>              T_JNCTTYP;
				attribute<m>                  METERS;
				attribute<min_f>              Minutes;
				attribute<string>             ONEWAY;
				attribute<km_hr>              KPH;
				attribute<int8>               F_ELEV;
				attribute<int8>               T_ELEV;
			}
			unit<uint32> Roads := Roads_fss
			,	StorageName = "=CacheDir + '/Roads.mmd'"
			{
				attribute<rdc>    geometry (arc) := Roads_fss/geometry[rdc];
				attribute<uint64> NW_ID          := Roads_fss/NW_ID;
				attribute<uint8>  FRC            := Roads_fss/FRC;
				attribute<int32>  FeatureType    := Roads_fss/FeatureType;
				attribute<uint8>  FerryType      := Roads_fss/FerryType;
				attribute<uint64> F_JNCTID       := Roads_fss/F_JNCTID;
				attribute<uint64> T_JNCTID       := Roads_fss/T_JNCTID;
				attribute<uint8>  F_JNCTTYP      := Roads_fss/F_JNCTTYP;
				attribute<uint8>  T_JNCTTYP      := Roads_fss/T_JNCTTYP;
				attribute<m>      METERS         := Roads_fss/METERS;
				attribute<min_f>  MINUTES        := Roads_fss/Minutes;
				attribute<string> ONEWAY         := Roads_fss/ONEWAY;
				attribute<km_hr>  KPH            := Roads_fss/KPH;
				attribute<int8>   F_ELEV         := Roads_fss/F_ELEV;
				attribute<int8>   T_ELEV         := Roads_fss/T_ELEV;
			}

			unit<uint32> Junctions_fss
			:	StorageName     = "='%NetworkModel_PrivDir%/TomTom/'+file_date+'/Junctions_FSS.fss'"
			,	StorageReadOnly = "true"
			{
				attribute<Geography/rdc_f32> geometry;
				attribute<int32>              FeatureType;
				attribute<uint64>             JNCTID;
				attribute<uint8>              JNCTTYP;
				attribute<int8>               ELEV;
			}
			unit<uint32> Junctions := Junctions_fss
			,	StorageName = "=CacheDir + '/Junctions.mmd'"
			{
				attribute<rdc>    geometry    := Junctions_fss/geometry[rdc];
				attribute<int32>  FeatureType := Junctions_fss/FeatureType;
				attribute<uint64> JNCTID      := Junctions_fss/JNCTID;
				attribute<uint8>  JNCTTYP     := Junctions_fss/JNCTTYP;
				attribute<int8>   ELEV        := Junctions_fss/ELEV;
			}

			unit<uint32> Speednetworks_fss
			:	StorageName     = "='%NetworkModel_PrivDir%/TomTom/'+file_date+'/Speednetworks_FSS.fss'"
			,	StorageReadOnly = "true"
			{
				attribute<uint64> NW_ID;
				attribute<string> region_code;
				attribute<uint16> SP_freeflow;
				attribute<uint16> SP_weekday;
				attribute<uint16> SP_weekend;
				attribute<uint16> SP_week;
				attribute<uint16> SP_Sunday;
				attribute<uint16> SP_Monday;
				attribute<uint16> SP_Tuesday;
				attribute<uint16> SP_Wednesday;
				attribute<uint16> SP_Thursday;
				attribute<uint16> SP_Friday;
				attribute<uint16> SP_Saturday;
			}

			// VAL_DIR from the row order. The raw material gives for each road element first the positive direction (2), then the negative one (3); the
			// four rows of an element that is in both the NL and the BE file are two such pairs. An element with one row only has its direction of travel:
			// 3 with ONEWAY 'TF', else 2. The rule is not exact: for a small share of the elements with two rows the order is reversed, so that the two
			// directions get each other's profile, and the single rows of roads closed to cars (ONEWAY 'N') alternate.
			container ValDir
			{
				unit<uint32> Element := unique(Speednetworks_fss/NW_ID)
				{
					attribute<uint32> NrRows := pcount(../Element_rel);
				}
				attribute<Element> Element_rel (Speednetworks_fss) := rlookup(Speednetworks_fss/NW_ID, Element/values);
				attribute<uint32>  Rank        (Speednetworks_fss) := cumulate(const(1, Speednetworks_fss, uint32), Element_rel) - 1, Descr = "The rank of the row within its road element, from 0.";
				attribute<string>  ONEWAY      (Speednetworks_fss) := Roads_fss/ONEWAY[rlookup(Speednetworks_fss/NW_ID, Roads_fss/NW_ID)];
				attribute<uint8>   VAL_DIR     (Speednetworks_fss) := Element/NrRows[Element_rel] == 1
					? (ONEWAY == 'TF' ? 3b : 2b)
					: (Rank % 2 == 0 ? 2b : 3b);
			}
			unit<uint32> Speednetworks := Speednetworks_fss
			,	StorageName = "=CacheDir + '/Speednetworks.mmd'"
			{
				attribute<uint64> NW_ID        := Speednetworks_fss/NW_ID, Descr = "network id";
				attribute<uint8>  VAL_DIR      := ValDir/VAL_DIR, Descr = "Validity direction: 2 = positive direction (from F_JNCTID to T_JNCTID of the road element), 3 = negative direction; derived from the row order (FromFss/ValDir).";
				attribute<string> region_code  := Speednetworks_fss/region_code, Descr = "file region code";
				attribute<uint16> SP_freeflow  := Speednetworks_fss/SP_freeflow, Descr = "speedprofile freeflow";
				attribute<uint16> SP_weekday   := Speednetworks_fss/SP_weekday, Descr = "speedprofile weekday";
				attribute<uint16> SP_weekend   := Speednetworks_fss/SP_weekend, Descr = "speedprofile weekend";
				attribute<uint16> SP_week      := Speednetworks_fss/SP_week, Descr = "speedprofile week";
				attribute<uint16> SP_Sunday    := Speednetworks_fss/SP_Sunday, Descr = "speedprofile sunday";
				attribute<uint16> SP_Monday    := Speednetworks_fss/SP_Monday, Descr = "speedprofile monday";
				attribute<uint16> SP_Tuesday   := Speednetworks_fss/SP_Tuesday, Descr = "speedprofile tuesday";
				attribute<uint16> SP_Wednesday := Speednetworks_fss/SP_Wednesday, Descr = "speedprofile wednesday";
				attribute<uint16> SP_Thursday  := Speednetworks_fss/SP_Thursday, Descr = "speedprofile thursday";
				attribute<uint16> SP_Friday    := Speednetworks_fss/SP_Friday, Descr = "speedprofile friday";
				attribute<uint16> SP_Saturday  := Speednetworks_fss/SP_Saturday, Descr = "speedprofile saturday";
			}

			unit<uint32> Speedprofiles_fss
			:	StorageName     = "='%NetworkModel_PrivDir%/TomTom/'+file_date+'/Speedprofiles_FSS.fss'"
			,	StorageReadOnly = "true"
			{
				attribute<int32>   profile_id;
				attribute<string>  region_code;
				attribute<int32>   time_slot;
				attribute<float32> rel_sp;
			}
			unit<uint32> Speedprofiles := Speedprofiles_fss
			,	StorageName = "=CacheDir + '/Speedprofiles.mmd'"
			{
				attribute<int32>   profile_id  := Speedprofiles_fss/profile_id, Descr = "profile id";
				attribute<string>  region_code := Speedprofiles_fss/region_code, Descr = "file region code";
				attribute<int32>   time_slot   := Speedprofiles_fss/time_slot;
				attribute<float32> rel_sp      := Speedprofiles_fss/rel_sp, Descr = "relative speed";
			}
		}

		container GetFileNames_Network       := GetFileNames_T(dir, 'multinet', 'shp');
		container GetFileNames_Speedprofiles := GetFileNames_T(dir, 'speedprofiles', 'dbf');
		
		Template GetFileNames_T
		{
			parameter<string> dir;
			parameter<string> type; 
			parameter<string> ext; 
			///
			parameter<string> FOI     := '"'+Expand(.,dir)+'/'+type;       //Folder Of Interest 
			parameter<string> slash          : ['\\'];
			
			parameter<bool> WriteFilesCSV := GetFolderInfo/writeObjectList == 0 ? TRUE : FALSE;
			// If this fails, a work-around: open a cmd window in the multinet folder and run
			//Dir "C:\GeoDMS\SourceData\NetworkModel_PBL_Priv\TomTom\yr2023_09\multinet
			// then
			// Dir "*.shp" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2023_09_multinet.csv /B /S
			// Dir "*.shp" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2024_09_multinet.csv /B /S
			// Dir "*.shp" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2024_12_multinet.csv /B /S
			// Dir "*.shp" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2025_12_multinet.csv /B /S
			// and add a line 'path' at the top
			
			// for the profiles:
			//Dir "C:\GeoDMS\SourceData\NetworkModel_PBL_Priv\TomTom\yr2023_09\speedprofiles
			//Dir "*.dbf" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2023_09_speedprofiles.csv /B /S
			//Dir "*.dbf" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2024_09_speedprofiles.csv /B /S
			//Dir "*.dbf" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2024_12_speedprofiles.csv /B /S
			//Dir "*.dbf" >> C:/GeoDMS/LocalData/networkmodel_pbl_v2024/TomTom/dirinfo_yr2025_12_speedprofiles.csv /B /S
			// and add a line 'path' at the top

			container GetFolderInfo
			{
				parameter<string> FOI_edit          := replace(FOI, '/', '\\');
				parameter<string> ComSpec           := Expand(., '%env:ComSpec%');
				parameter<string> FileNameDirInfo   := Expand(., '%LocalDataProjDir%/TomTom/dirinfo_'+file_date+'_'+type+'.csv');
				parameter<string> DirCmdOrgMD       := Expand(., 'MD "%LocalDataProjDir%/TomTom"');
				parameter<string> DirCmdOrgHeader   := 'echo path > '+FileNameDirInfo;
				parameter<string> DirCmdOrgDir      := 'Dir '+ FOI_edit +'\\*.'+ext+'" >> ' + FileNameDirInfo ;

				parameter<string> DirCmd            := Replace(DirCmdOrgMD, '/', '\\') + ' & ' + Replace(DirCmdOrgHeader, '/', '\\') + ' & ' + Replace(DirCmdOrgDir, '/', '\\') + ' /B /S';
				parameter<string> NewLine           : ['\n'];
				parameter<uint32> writeObjectList   := exec_ec(ComSpec, '/c ' + DirCmd, Expand(., '%LocalDataProjDir%'));
			}
			
			unit<uint32> Files 
			: Storagename = "=GetFolderInfo/FileNameDirInfo"
			, StorageType = "gdal.vect"
			, StorageReadOnly = "true"
			{
				attribute<string> name            := AsItemName(FileName);
				attribute<uint32> pos_last_slash  := strrpos(path, slash);
				attribute<string> FileName        := substr(path, pos_last_slash + 1);
				attribute<string> FolderName      := substr(path, 0, pos_last_slash);
				
				attribute<string> file_str_values : StorageName     = "=first(FolderName)", StorageType     = "strfiles", StorageReadOnly = "True", URL = "https://www.esri.com/content/dam/esrisites/sitecore-archive/Files/Pdfs/library/whitepapers/pdfs/shapefile.pdf";
				
				attribute<string> ShapeType       := AsHex(substr(file_str_values, 32, 1));
				attribute<bool>   IsPolyline      := ShapeType == '03'; // 1 == point, 3 == polyline, 5 == polygon
				attribute<bool>   IsPoint         := ShapeType == '01'; // 1 == point, 3 == polyline, 5 == polygon
				attribute<uint32> post_last__     := MakeDefined(strrpos(FileName, '_') + 1, strlen(FileName) - 6);
				attribute<string> Suffix0         := substr(FileName, post_last__);
				attribute<uint32> Suffix0_len     := strlen(Suffix0);
				attribute<string> Suffix          := substr(Suffix0, 0, strlen(Suffix0) - 4);
				
				attribute<bool>   IsRoadGeom      := IsDefined(rlookup(Suffix, Road_Suffices/values));
				attribute<bool>   IsNetworkGeom   := IsDefined(rlookup(Suffix, Network_Suffices/values));
				attribute<bool>   IsJunctionGeom  := IsDefined(rlookup(Suffix, Junction_Suffices/values));
				attribute<bool>   IsHSNP          := IsDefined(rlookup(Suffix, Speed_network_Suffices/values));
				attribute<bool>   IsHSPR          := IsDefined(rlookup(Suffix, Speed_profile_Suffices/values));
				
				attribute<string> SP_regioncode   := substr(FileName, 0, 6);
				
				unit<uint8> Road_Suffices : nrofrows = 9
				{
					attribute<string> values : ['00','01','02','03','04','05','06','07','08']; //,'fe'];
				}
				
				unit<uint8> Network_Suffices : nrofrows = 1
				{
					attribute<string> values : ['nw']; 
				}
				
				unit<uint8> Junction_Suffices : nrofrows = 1
				{
					attribute<string> values : ['jc']; 
				}
				
				unit<uint8> Speed_network_Suffices : nrofrows = 1
				{
					attribute<string> values : ['hsnp']; 
				}
				unit<uint8> Speed_profile_Suffices : nrofrows = 1
				{
					attribute<string> values : ['hspr']; 
				}
				
				
				unit<uint32> Files_polylines := select_with_org_rel(IsPolyline && IsNetworkGeom)
				{
					attribute<string> name            := ../name[org_rel];
					attribute<string> path            := ../path[org_rel];
				}
				unit<uint32> Files_points := select_with_org_rel(IsPoint && IsJunctionGeom)
				{
					attribute<string> name            := ../name[org_rel];
					attribute<string> path            := ../path[org_rel];
				}
				unit<uint32> Files_HSNP := select_with_org_rel(IsHSNP)
				, Descr = "Historical Speed Network Profile: the average speeds per segment, based on historical measurements at a given time or per time period, defined per link."
				{
					attribute<string> name            := ../name[org_rel];
					attribute<string> path            := ../path[org_rel];
					attribute<string> SP_regioncode   := ../SP_regioncode[org_rel];
				}
				unit<uint32> Files_HSPR := select_with_org_rel(IsHSPR)
				, Descr = "Historical Speed Profile: a detailed speed profile, often with a speed value per 5 or 15 minutes for typical days (for example Tuesday versus Saturday)."
				{
					attribute<string> name            := ../name[org_rel];
					attribute<string> path            := ../path[org_rel];
					attribute<string> SP_regioncode   := ../SP_regioncode[org_rel];
				}
			}
		}
	}

	// A read-only mmd reader may not declare sub-items (ObjectVision/GeoDMS#1245): the dictionary of the cache (0Dictionary.dms in the mmd)
	// defines them and checks their value types on reading. So each cache has a bare reader Read_<name>, and next to it the unit that the
	// configuration uses, which passes on the stored columns and holds the derived ones; all paths outside this file stay the same.
	unit<uint32>  Read_Junctions
	: StorageName = "=CacheDir + '/Junctions.mmd'"
	, StorageReadOnly = "true"
	, Descr = "Bare reader of the Junctions cache; it declares nothing, the dictionary supplies the columns."
	;

	unit<uint32>  Junctions0 := Read_Junctions
	{
		attribute<rdc>             geometry              := Read_Junctions/geometry;
		attribute<int32>           FeatureType           := Read_Junctions/FeatureType;
		attribute<uint64>          JNCTID                := Read_Junctions/JNCTID;
		attribute<uint8>           JNCTTYP               := Read_Junctions/JNCTTYP;
		attribute<int8>            ELEV                  := Read_Junctions/ELEV;

		attribute<Junctions> Junctions_rel := rlookup(JNCTID, junctions/values);
	}
	
	unit<uint32>  Junctions := unique(Junctions0/JNCTID), Descr = "The TomTom junctions, one per JNCTID."
	{
		attribute<rdc>            geometry         := first(Junctions0/geometry, Junctions0/Junctions_rel);
		attribute<int32>          FeatureType      := first(Junctions0/FeatureType, Junctions0/Junctions_rel);
		attribute<uint64>         JNCTID           := values;
		attribute<uint8>          JNCTTYP          := first(Junctions0/JNCTTYP, Junctions0/Junctions_rel);
		attribute<int8>           ELEV             := first(Junctions0/ELEV, Junctions0/Junctions_rel);
		attribute<bool>           Connectable      := rjoin(JNCTID, Roads/F_JNCTID, Roads/Connectable) || rjoin(JNCTID, Roads/T_JNCTID, Roads/Connectable);
	}
	
	unit<uint32> TexelHack : nrofrows = 1, Using = "units", Descr = "A polygon around the ferry port on Texel, in which Roads makes the roads two-way."
	{
		parameter<rdc> top_left     := point_xy(113790d, 557996d, rdc); // X=113790.89; Y=557996.776; ZL=0.297619048
		parameter<rdc> top_right    := point_xy(114661d, 557946d, rdc); // X=114661.13; Y=557946.376; ZL=0.297619048
		parameter<rdc> bottom_left  := point_xy(113952d, 557344d, rdc); // X=113952.17; Y=557344.936; ZL=0.297619048
		parameter<rdc> bottom_right := point_xy(114580d, 557472d, rdc); // X=114580.49; Y=557472.616; ZL=0.297619048

		
		unit<uint32> point_set : nrofrows = 5
		{
			attribute<rdc>  point        := union_data(., top_left, top_right, bottom_right, bottom_left, top_left);
			attribute<..>   sequence_rel := const(0, .);
			attribute<.>    ordinal      := id(.);
		}
		
		attribute<rdc> polygon (poly)      := points2sequence(point_set/point, point_set/sequence_rel, point_set/ordinal);
	}
	
	// Bare reader, see the explanation at Read_Junctions: nothing may be declared under a read-only mmd reader (ObjectVision/GeoDMS#1245),
	// so the pass-through columns and the derived ones are one level up.
	unit<uint32>  Read_Roads
	: StorageName = "=CacheDir + '/Roads.mmd'"
	, StorageReadOnly = "true"
	, Descr = "Bare reader of the Roads cache; it declares nothing, the dictionary supplies the columns."
	;

	unit<uint32>  Roads := Read_Roads, Descr = "The TomTom road elements of the cache, with their direction of travel, their junctions and the flags for the selection."
	{
		attribute<rdc>                     geometry (arc)         := Read_Roads/geometry;
		attribute<uint64>                  NW_ID                  := Read_Roads/NW_ID;
		attribute<uint8>                   FRC                    := Read_Roads/FRC;

		attribute<FuncRoadClass>  FRC_rel               := (FRC + 1[FuncRoadClass_EK])[FuncRoadClass];
		
		attribute<int32>          FeatureType := Read_Roads/FeatureType;
		attribute<uint8>          FerryType := Read_Roads/FerryType;
		attribute<uint64>         F_JNCTID := Read_Roads/F_JNCTID;
		attribute<uint64>         T_JNCTID := Read_Roads/T_JNCTID;
		attribute<uint64>         F_JNCTID_directed := Direction == Directions_TomTom/v/backwards ? T_JNCTID : F_JNCTID;
		attribute<uint64>         T_JNCTID_directed := Direction == Directions_TomTom/v/backwards ? F_JNCTID : T_JNCTID;
		attribute<Junctions>      F_JNCT_rel             := rlookup(F_JNCTID_directed, Junctions/JNCTID);
		attribute<Junctions>      T_JNCT_rel             := rlookup(T_JNCTID_directed, Junctions/JNCTID);
		
		attribute<uint8>          F_JNCTTYP := Read_Roads/F_JNCTTYP;
		attribute<uint8>          T_JNCTTYP := Read_Roads/T_JNCTTYP;
		attribute<m>              METERS := Read_Roads/METERS;
		attribute<min_f>          MINUTES := Read_Roads/MINUTES;
		attribute<string>         ONEWAY := Read_Roads/ONEWAY;
		attribute<bool>           IsInTexelHack         := IsDefined(point_in_polygon(first_point(geometry), TexelHack/polygon)) || IsDefined(point_in_polygon(last_point(geometry), TexelHack/polygon));
		attribute<Directions_TomTom> Direction0            := MakeDefined(rlookup(Oneway, Directions_TomTom/code), 0[Directions_TomTom]); // relevant for routing later: with direction = 3, f_ and t_ must be swapped, and with 3 and 4 the traffic is one-way
		// The Texel hack makes the roads near the ferry port two-way, but not a road that is closed to cars (ONEWAY 'N').
		attribute<Directions_TomTom> Direction             := IsInTexelHack && Direction0 != Directions_TomTom/v/nocars ? Directions_TomTom/v/dual : Direction0;
		attribute<bool>           IsOneDirection        := Direction == Directions_TomTom/v/backwards || Direction == Directions_TomTom/v/forwards;
		attribute<km_hr>          KPH := Read_Roads/KPH;
		attribute<int8>           F_ELEV := Read_Roads/F_ELEV;
		attribute<int8>           T_ELEV := Read_Roads/T_ELEV;
		attribute<bool>           IsFerry               := FerryType == 1b;
		attribute<bool>           IsStreetTypeSelection  := ='FRC_rel <= '+ModelParameters/Advanced/TomTom_StreetTypeSelection;
		// Only road elements (FEATTYP 4110) and ferry connections (4130), not the address area boundaries (4165, FRC -1); and each NW_ID once,
		// because an NW_ID that is in both the NL and the BE file would give a double link and make an ordinary road point a junction with a penalty.
		attribute<bool>           IsRoadOrFerry         := FeatureType == 4110i || FeatureType == 4130i;
		attribute<bool>           IsFirstOfNW_ID        := rlookup(NW_ID, NW_ID) == id(.);
		attribute<bool>           Connectable           := FRC_rel != Classifications/FuncRoadClass/V/Motorway_Freeway_or_Other_Major_Road;
	}
	
	unit<uint32> Roads_selection := select_with_attr_by_cond(Roads, Roads/IsStreetTypeSelection && Roads/IsRoadOrFerry && Roads/IsFirstOfNW_ID), Descr = "The road elements of the car network: the street types up to ModelParameters/Advanced/TomTom_StreetTypeSelection, only roads and ferries, and each NW_ID once."
	{
		// The speed profile has one row per direction for each road element (VAL_DIR 2 = positive, from F_JNCTID to T_JNCTID; 3 = negative),
		// each with its own profiles and its own free-flow speed. 'fwd' is the direction of travel of the road element as the car network uses it
		// (F_JNCTID_directed to T_JNCTID_directed; with TF the negative direction), 'bwd' the opposite direction of a two-way road.
		attribute<Speednetworks>  Speednetworks_pos_rel  := rlookup(NW_ID * 4u64 + 2u64, Speednetworks/NW_DIR_key);
		attribute<Speednetworks>  Speednetworks_neg_rel  := rlookup(NW_ID * 4u64 + 3u64, Speednetworks/NW_DIR_key);
		attribute<Speednetworks>  Speednetworks_fwd_rel  := Direction == Directions_TomTom/v/backwards ? Speednetworks_neg_rel : Speednetworks_pos_rel;
		attribute<Speednetworks>  Speednetworks_bwd_rel  := Direction == Directions_TomTom/v/backwards ? Speednetworks_pos_rel : Speednetworks_neg_rel;
		
		container CalcTimes :=
			for_each_ne(
				ModelParameters/Advanced/CongestionTimes/name
				, 'CalcTimes_T('+quote(ModelParameters/Advanced/CongestionTimes/name)+')'
			);
		
		container Export := Write2Gpkg_T(.)
		{
		}
	
		Template Write2Gpkg_T
		{
			unit<uint32>      domain;
			
			unit<uint32> Network := domain
			, StorageName = "='%LocalDataProjDir%/TomTom/Car_network_'+file_date+'_'+ModelParameters/Advanced/CongestionSpeed_DaySelection+'.gpkg'"
			, StorageType = "gdalwrite.vect" 
			{
				attribute<Geography/rdc>               geometry (arc)      := domain/geometry;
				attribute<FuncRoadClass>                FRC_rel             := domain/FRC_rel;
				attribute<string>                       roadType_label       := FuncRoadClass/label[FRC_rel];
				attribute<km_hr>                        speed_freeflow      := ='CalcTimes/'+first(ModelParameters/Advanced/CongestionTimes/name)+'/PerMoment/freeflow/KPH';
				attribute<km_hr>                        speed_morning       := ='CalcTimes/MorningRush/PerMoment/'+ModelParameters/Advanced/CongestionSpeed_DaySelection+'/KPH';
				attribute<km_hr>                        speed_noon          := ='CalcTimes/NoonRush/PerMoment/'+ModelParameters/Advanced/CongestionSpeed_DaySelection+'/KPH';
				attribute<km_hr>                        speed_evening       := ='CalcTimes/LateEveningRush/PerMoment/'+ModelParameters/Advanced/CongestionSpeed_DaySelection+'/KPH';
					
				
			}
			
			unit<uint32> Attributes := SubItem_PropValues(Network, 'name');
		}
		
		Template CalcTimes_T
		{ 
			parameter<string> Time;
			///
			// Cap on the car speed of this congestion moment (ModelParameters/Advanced/CongestionTimes/MaxSpeed; 0 means none); freeflow is never capped.
			parameter<km_hr> MaxSpeed := MakeDefined(rjoin(Time, ModelParameters/Advanced/CongestionTimes/name, ModelParameters/Advanced/CongestionTimes/MaxSpeed), 0[km_hr]);
			
			container PerMoment :=
				for_each_ne(
					Moments/name
					, 'PerMoment_T('+quote(Moments/name)+')'
				);
			
			Template PerMoment_T
			{
				parameter<string> Moment;
				//
				// Travel time per direction: the length divided by the TomTom speed of that direction at this moment
				// (Speednetworks/CalcTimes/<time>/PerMoment/<moment>/Speed); without a speed profile row it is the travel time of the road network
				// (MINUTES of MultiNet). Minutes and kph are the direction of travel of the car network (fwd), Minutes_bwd and kph_bwd the opposite
				// direction of a two-way road.
				parameter<bool>  IsCapped                         := MaxSpeed > 0[km_hr] && lowercase(Moment) != 'freeflow';
				attribute<min_f> Minutes_uncapped     (Roads_selection) := ='MakeDefined(convert(convert(Roads_selection/meters, km) / Speednetworks/CalcTimes/'+Time+'/PerMoment/'+Moment+'/Speed[Speednetworks_fwd_rel], min_f), Roads_selection/Minutes)';
				attribute<min_f> Minutes_bwd_uncapped (Roads_selection) := ='MakeDefined(convert(convert(Roads_selection/meters, km) / Speednetworks/CalcTimes/'+Time+'/PerMoment/'+Moment+'/Speed[Speednetworks_bwd_rel], min_f), Roads_selection/Minutes)';
				attribute<min_f> Minutes_at_MaxSpeed  (Roads_selection) := convert(convert(Roads_selection/meters, km) / (MaxSpeed > 0[km_hr] ? MaxSpeed : 1000[km_hr]), min_f);
				attribute<min_f> Minutes       (Roads_selection) := IsCapped ? max_elem(Minutes_uncapped, Minutes_at_MaxSpeed) : Minutes_uncapped;
				attribute<min_f> Minutes_bwd   (Roads_selection) := IsCapped ? max_elem(Minutes_bwd_uncapped, Minutes_at_MaxSpeed) : Minutes_bwd_uncapped;
				attribute<km_hr> kph_src       (Roads_selection) := convert(Roads_selection/meters, km) / convert(Minutes, hr_f);
				attribute<km_hr> kph           (Roads_selection) := IsFerry ? ModelParameters/Advanced/Ferry_Speed : kph_src;
				attribute<km_hr> kph_bwd       (Roads_selection) := IsFerry ? ModelParameters/Advanced/Ferry_Speed : convert(Roads_selection/meters, km) / convert(Minutes_bwd, hr_f);
				attribute<km_hr> Speed_PerRPS  (RoadPointSet)    := kph[RoadPointSet/Sequence_rel];
			}
		}
		
		unit<uint32> RoadPointSet := sequence2points(geometry)
		, DialogData = "point"
		, DialogType = "map";
	}
	
	// Bare reader, see the explanation at Read_Junctions (ObjectVision/GeoDMS#1245).
	unit<uint32>  Read_Speednetworks
	: StorageName = "=CacheDir + '/Speednetworks.mmd'"
	, StorageReadOnly = "true"
	, Descr = "Bare reader of the Speednetworks cache; it declares nothing, the dictionary supplies the columns."
	;

	unit<uint32>  Speednetworks := Read_Speednetworks, Descr = "The speed rows of the edition, one per direction of a road element, with their speeds and their profile ids per day of the week."
	{
		attribute<uint64> NW_ID := Read_Speednetworks/NW_ID;
		attribute<string> region_code := Read_Speednetworks/region_code;
		attribute<uint8>  VAL_DIR := Read_Speednetworks/VAL_DIR;
		attribute<uint64> NW_DIR_key := NW_ID * 4u64 + uint64(VAL_DIR), Descr = "Key of road element and direction; a road element has one row per direction.";
		
		attribute<uint16> SP_freeflow := Read_Speednetworks/SP_freeflow;
		attribute<uint16> SP_weekday := Read_Speednetworks/SP_weekday;
		attribute<uint16> SP_weekend := Read_Speednetworks/SP_weekend;
		attribute<uint16> SP_week := Read_Speednetworks/SP_week;
		
		attribute<uint16> SP_Sunday := Read_Speednetworks/SP_Sunday;
		attribute<uint16> SP_Monday := Read_Speednetworks/SP_Monday;
		attribute<uint16> SP_Tuesday := Read_Speednetworks/SP_Tuesday;
		attribute<uint16> SP_Wednesday := Read_Speednetworks/SP_Wednesday;
		attribute<uint16> SP_Thursday := Read_Speednetworks/SP_Thursday;
		attribute<uint16> SP_Friday := Read_Speednetworks/SP_Friday;
		attribute<uint16> SP_Saturday := Read_Speednetworks/SP_Saturday;
		
		attribute<Roads>  Roads_rel    := rlookup(NW_ID, Roads/NW_ID);
		attribute<SpeedProfileKeys> DayProfile_rel := ='rlookup(region_code + ''_'' + string(SP_' + ModelParameters/Advanced/CongestionSpeed_DaySelection + '), SpeedProfileKeys/values)'
		, Descr = "The profile of the day CongestionSpeed_DaySelection (a weekday, whose SP_<day> holds a profile id) in SpeedProfileKeys, for the time-dependent car trip (ModelParameters/Impl/CarTimeDependent, #132); null without a profile, and the snapshot then takes MINUTES as well.";
		
		container CalcTimes :=
			for_each_ne(
				ModelParameters/Advanced/CongestionTimes/name
				, 'CalcTimes_T('+quote(ModelParameters/Advanced/CongestionTimes/Time)+')'
			);
			
		Template CalcTimes_T
		{
			parameter<string> Time;
			///
			
			parameter<uint32> Time_hour_in_sec := uint32(substr(Time, 0, 2)) * 3600;
			parameter<uint32> Time_min_in_sec  := uint32(substr(Time, 2, 2)) * 60;
			parameter<uint32> Time_in_seconds  := Time_hour_in_sec + Time_min_in_sec;
			
			container PerMoment :=
				for_each_ne(
					Moments/name
					, 'PerMoment_T('+quote(Moments/name)+')'
				);
			
			Template PerMoment_T
			{
				parameter<string> Moment;
				//
				
				// The weekdays hold a profile id in SP_<day> (profile_1..7), with a relative speed per quarter of an hour in percent of SPFREEFLOW; freeflow,
				// weekday, weekend and week hold a speed in km/h in SP_<moment> itself. Speed is therefore SP_<moment> for a speed moment and
				// SP_freeflow x relative speed for a weekday.
				parameter<bool>    IsSpeedMoment                 := lowercase(Moment) == 'freeflow' || lowercase(Moment) == 'weekday' || lowercase(Moment) == 'weekend' || lowercase(Moment) == 'week', Descr = "True when SP_<moment> is a speed instead of a profile id.";
				attribute<uint16>  SP            (Speednetworks) := ='SP_'+Moment;
				attribute<km_hr>   Speed         (Speednetworks) := = IsSpeedMoment
					? 'SP > 0w ? value(float32(SP), km_hr) : value(null_f, km_hr)'
					: 'SP_freeflow > 0w ? value(float32(SP_freeflow), km_hr) * factor : value(null_f, km_hr)'
				,	Descr = "The speed of this row (one direction of a road element) at this moment; null without a speed or profile.";
				attribute<string>  Region_SP_key (Speednetworks) := region_code + '_' + string(SP) + '_' + string(Time_in_seconds);
				attribute<float32> factor        (Speednetworks) := = IsSpeedMoment ? 'const(null_f, Speednetworks, float32)' : 'rjoin(Region_SP_key, Speedprofiles/Region_Profile_TimeSlot_key, Speedprofiles/rel_sp / 100f)', Descr = "The relative speed of the profile at this time; null for a speed moment.";
			}
		}
	}
	
	// Bare reader, see the explanation at Read_Junctions (ObjectVision/GeoDMS#1245).
	unit<uint32>  Read_Speedprofiles
	: StorageName = "=CacheDir + '/Speedprofiles.mmd'"
	, StorageReadOnly = "true"
	, Descr = "Bare reader of the Speedprofiles cache; it declares nothing, the dictionary supplies the columns."
	;

	unit<uint32>  Speedprofiles := Read_Speedprofiles, Descr = "The relative speed per speed profile and time slot."
	{
		attribute<int32>   profile_id := Read_Speedprofiles/profile_id;
		attribute<string>  region_code := Read_Speedprofiles/region_code;
		attribute<string>  SP_profile_ID := region_code + '_' +string(profile_id);
		attribute<int32>   time_slot := Read_Speedprofiles/time_slot;
		attribute<float32> rel_sp := Read_Speedprofiles/rel_sp;
		
		attribute<string>  Region_Profile_TimeSlot_key  := region_code + '_' + string(profile_id) + '_' + string(time_slot);
		
		attribute<int32>   hour          := time_slot / (60i * 60i);
		attribute<int32>   minutes       := (time_slot - (hour * 60i * 60i)) / 60i;
		attribute<upoint>  unipt         := point(uint32(profile_id), uint32(time_slot), upoint);
		attribute<SpeedProfileKeys> Profile_rel  := rlookup(SP_profile_ID, SpeedProfileKeys/values);
		attribute<uint32>  ProfileDaySlot_key    := uint32(Profile_rel) * 288 + uint32(time_slot) / 300, Descr = "The position in ProfileDaySlot: profile after profile, and per profile the time slots of 300 s from 00:00.";
	}

	// Time-dependent car trip (ModelParameters/Impl/CarTimeDependent, #132): the relative speed per profile and time slot as a table, and which
	// profiles change in the window of the departure moments (CarTD_WindowStart, CarTD_NrSlots). The link times per time slot and the factors
	// for the search are in Templates/CreateNetwork_TomTom_T, TimeDependent.
	unit<uint32> SpeedProfileKeys := unique(Speedprofiles/SP_profile_ID)
	, Descr = "The speed profiles: region and profile id (Speedprofiles/SP_profile_ID)."
	{
		attribute<bool> VariesInWindow := max(WindowSlot/rel_speed, WindowSlot/Profile_rel) > min(WindowSlot/rel_speed, WindowSlot/Profile_rel) || any(not(IsDefined(WindowSlot/rel_speed)), WindowSlot/Profile_rel)
		, Descr = "True when the relative speed of this profile changes within the window or is missing in a time slot; otherwise the link time is constant there and the link gets no profile of its own.";
	}
	unit<uint32> ProfileDaySlot := range(uint32, 0, #SpeedProfileKeys * 288)
	, Descr = "The 288 time slots of 300 s of a day for each profile, profile after profile."
	{
		attribute<float32> rel_speed := rjoin(uint32(id(.)), Speedprofiles/ProfileDaySlot_key, Speedprofiles/rel_sp) / 100f, Descr = "The speed relative to SP_freeflow (rel_sp is in percent).";
	}
	unit<uint32> WindowSlot := range(uint32, 0, #SpeedProfileKeys * ModelParameters/Advanced/CarTD_NrSlots)
	, Descr = "The time slots of the window for each profile, profile after profile."
	{
		attribute<SpeedProfileKeys> Profile_rel := value(uint32(id(.)) / ModelParameters/Advanced/CarTD_NrSlots, SpeedProfileKeys);
		attribute<float32>          rel_speed   := ProfileDaySlot/rel_speed[value(uint32(Profile_rel) * 288 + ModelParameters/Advanced/CarTD_WindowStart / 300 + uint32(id(.)) % ModelParameters/Advanced/CarTD_NrSlots, ProfileDaySlot)];
	}
}
