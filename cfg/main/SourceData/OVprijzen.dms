				'Rail'  ,'Breng'               ,'Gelderland'    ,'Concessie_Arnhem_Nijmegen'          ,'Arnhem-Doetinchem'    ,'1.08' ,'0.228' ,'0'      ,'2023-val toegevoegd: Breng/Hermes (Transdev) rail Arnhem-Doetinchem [feed: vh. Transdev]',
				'Bus'   ,'Connexxion'          ,'Zuid_Holland'  ,''                                   ,'500'                  ,'1.08' ,'0'     ,'0.79'   ,'Parkshuttle Rivium (route_short_name 500): OV-basistarief plus vast bedrag per rit (Flatfare), ook bij een overstap, #164 | bron: https://dova.nu/sites/default/files/20260212%20Overzicht%20km-tarieven%202013-2026.xlsx',
				'Bus'   ,'Keolis'              ,'Overijssel'    ,''                                   ,''                     ,'1.08' ,'0.207' ,'0'      ,'TVV-lijnen 822-824 (treinvervangend Zwolle/Kampen/Enschede); tarief = Blauwnet-analogie'

				// a ride of an agency without a rule here gets the DOVA fare of the concession area of its line (OD_extra_attributen, #55)
			];
		}
		
		attribute<string>   Mode                           := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
		attribute<string>   Vervoerder                     := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], Descr = "The agency; Agency_rel matches it, in lowercase, on the agency names of the GTFS feed (Classifications/Agencies).";
		attribute<string>   Concessiegebied                := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)];
		attribute<string>   Lijn                           := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)];
		attribute<Euro>     FixedPrice                     := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)][Euro];
		attribute<Euro_km>  VariablePrice                  := Elements/Text[value(UInt32(ID(.))* nrAttr + 6, Elements)][Euro_km];
		attribute<Euro>     RideSurcharge                  := Elements/Text[value(UInt32(ID(.))* nrAttr + 7, Elements)][Euro], Descr = "A fixed amount per ride on top of the boarding fare and the price per kilometre, also when the ride continues an OV-chip journey, such as the flat fare of the Parkshuttle Rivium (#164); the chain joiner adds it as Price_S.";
		attribute<string>   Opmerking                      := Elements/Text[value(UInt32(ID(.))* nrAttr + 8, Elements)];
		
		attribute<Modes>    Mode_rel                       := rlookup(Mode, Modes/name);
		attribute<Agencies> Agency_rel                     := rlookup(lowercase(Vervoerder), Agencies/name);
		attribute<Concessiegebieden> Concessiegebieden_rel := rlookup(AsItemName(Concessiegebied), Concessiegebieden/name);
		
		attribute<string>   Concessiegebied_str            := AsItemName(Concessiegebied != '' ? ''+Concessiegebied : '');
		attribute<string>   Lijn_str                       := Lijn != '' ? '_'+Lijn : '';
		
		attribute<string>   Mode_Agency_CG_Line_identifier := Mode +'_'+ lowercase(Vervoerder) +'_'+ Concessiegebied_str + Lijn_str;
		attribute<string>   Mode_Agency_CG_identifier      := Mode +'_'+ lowercase(Vervoerder) +'_'+ Concessiegebied_str;
		attribute<string>   Mode_Agency_identifier         := Mode +'_'+ lowercase(Vervoerder);
		attribute<string>   label                          := Mode_Agency_CG_Line_identifier;

		parameter<uint32>   nrAttr                         := 9;
	}
	

