		}
		
		attribute<string>   Mode                           := Elements/Text[value(UInt32(ID(.))* nrAttr + 0, Elements)];
		attribute<string>   Vervoerder                     := Elements/Text[value(UInt32(ID(.))* nrAttr + 1, Elements)], Descr = "The agency; Agency_rel matches it, in lowercase, on the agency names of the GTFS feed (Classifications/Agencies).";
		attribute<string>   Concessiegebied                := Elements/Text[value(UInt32(ID(.))* nrAttr + 3, Elements)];
		attribute<string>   Lijn                           := Elements/Text[value(UInt32(ID(.))* nrAttr + 4, Elements)];
		attribute<Euro>     FixedPrice                     := Elements/Text[value(UInt32(ID(.))* nrAttr + 5, Elements)][Euro];
		attribute<Euro_km>  VariablePrice                  := Elements/Text[value(UInt32(ID(.))* nrAttr + 6, Elements)][Euro_km];
		attribute<Euro>     RideSurcharge                  := Elements/Text[value(UInt32(ID(.))* nrAttr + 7, Elements)][Euro], Descr = "A fixed amount per ride on top of the boarding fare and the price per kilometre, also when the ride continues an OV-chip journey, such as the flat fare of the Parkshuttle Rivium (#164); the chain joiner adds it as Price_S.";
		attribute<string>   Opmerking                      := Elements/Text[value(UInt32(ID(.))* nrAttr + 8, Elements)];
		
		attribute<Modes>    Mode_rel                       := rlookup(Mode, Modes/name);
		attribute<Agencies> Agency_rel                     := rlookup(lowercase(Vervoerder), Agencies/name);
		attribute<Concessiegebieden> Concessiegebieden_rel := rlookup(AsItemName(Concessiegebied), Concessiegebieden/name);
		
		attribute<string>   Concessiegebied_str            := AsItemName(Concessiegebied != '' ? ''+Concessiegebied : '');
		attribute<string>   Lijn_str                       := Lijn != '' ? '_'+Lijn : '';
		
		attribute<string>   Mode_Agency_CG_Line_identifier := Mode +'_'+ lowercase(Vervoerder) +'_'+ Concessiegebied_str + Lijn_str;
		attribute<string>   Mode_Agency_CG_identifier      := Mode +'_'+ lowercase(Vervoerder) +'_'+ Concessiegebied_str;
		attribute<string>   Mode_Agency_identifier         := Mode +'_'+ lowercase(Vervoerder);
		attribute<string>   label                          := Mode_Agency_CG_Line_identifier;

		parameter<uint32>   nrAttr                         := 9;
	}

	container NS
	{
		unit<uint32> NS_PricePerTariffUnit
		: StorageName = "='%ProjDir%/Data/Tarieven_NS/NS tarieven '+ModelParameters/Impl/NS_prices_year+'.csv'"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, URL = "https://www.ns.nl/binaries/_ht_1704966727326/content/assets/ns-nl/tarieven/2024/consumenten/ns-tarievenlijst-consumenten-2024.pdf"
		, Descr = "NS prices per number of tariff units in the year NS_prices_year, at full fare and with 20% and 40% discount.", Source = "csv per year 2013 to 2026: 2013 to 2019 from the official NS fare list pdfs (Wayback Machine) and NDOV xls, 2020 to 2022 from the official HRN price tables, 2023 onward from the NS fare list; column headers without the VAT percentage (6% up to 2018, 9% from 2019); the discounts of 2013 to 2018 calculated as exactly 0.8 and 0.6 times the full fare (NS rule)"
		{
			attribute<uint32>  TariffUnits    := uint32(Aantal_tarief_eenheden);
			attribute<euro>    FullFare       := float32(Voltarief_incl_btw)[euro];
			attribute<euro>    Discount_20pct := float32(_20_korting_incl_btw)[euro];
			attribute<euro>    Discount_40pct := float32(_40_korting_incl_btw)[euro];
		}

		// NS calculates the tariff units of a station pair over the classic route; whoever travels over the HSL pays the trip surcharge on top
		// (TripSurcharge below). The tariff network of NDOV (tariefnet.dat) also has the HSL edges, and the shortest route over them gives too few
		// units (ObjectVision/NetworkModel_PBL#3), so those edges are left out (TariffNetwork_ExcludedEdges).
		unit<uint8> TariffNetwork_ExcludedEdges : nrofrows = 2
		, Descr = "Edges of NS_tariefnet_<year>.csv that NS does not count for the fare: the HSL-Zuid, in both directions (see NS_TariffUnits_matrix/IsExcluded)."
		{
			attribute<string> org         : ['hfd', 'rlb'];
			attribute<string> dest        : ['rtd', 'bdpb'];
			attribute<string> key         := org + '_' + dest;
			attribute<string> Explanation : ['HSL-Zuid Hoofddorp - Rotterdam Centraal (50 TE; klassiek via Leiden en Den Haag 62)', 'HSL-Zuid Rotterdam Lombardijen - Breda-Prinsenbeek (32 TE; klassiek via Dordrecht en Lage Zwaluwe 38)'];
		}

		// TRIP SURCHARGE FOR SPECIAL TRAINS AND NS INTERNATIONAL (#3). The NS fare of a journey follows from the tariff units of the station
		// pair over the classic route; the high-speed line does not count for it (TariffNetwork_ExcludedEdges above). Travelling over
		// the HSL between Schiphol and Rotterdam, or on the ICE within the Netherlands, costs a supplement per trip. It depends on the trip,
		// not on the station pair, so it is added per ride with NS (Price_S in PublicTransport_Prep/OD_L), apart from the through NS fare.
		unit<uint8> TripSurchargeTrains : nrofrows = 2
		, Descr = "Train products with a surcharge: Station_A and Station_B mark the section on which it applies (empty: every ride of the product), ExtraTime is the extra time per boarding, and the amount per year is in TripSurcharge below."
		{
			attribute<string> name        : ['HSL_Schiphol_Rotterdam', 'ICE_binnenland'];
			attribute<string> Station_A   : ['shl', ''];
			attribute<string> Station_B   : ['rtd', ''];
			attribute<min_f>  ExtraTime   : [0, 0];
			attribute<string> Explanation : ['NS-toeslag ICE/IC direct tussen Schiphol Airport en Rotterdam Centraal (sinds 15-12-2013 alleen dit traject), ook in de Eurocity Direct; Breda-Rotterdam over de HSL is toeslagvrij', 'NS-toeslag ICE/IC direct op elk binnenlands traject van de ICE (Amsterdam-Utrecht-Arnhem, Amsterdam-Amersfoort-Hengelo)'];
		}
		unit<uint8> TripSurchargeRouteNames : nrofrows = 4
		, Descr = "The route_short_names (lower case, exact) by which a route of the NS network is recognised as a product of TripSurchargeTrains."
		{
			attribute<string> route_short_name : ['intercity direct', 'eurocity direct', 'ice', 'ice international'];
			attribute<TripSurchargeTrains> TripSurcharge_rel : [0, 0, 1, 1];
		}
		unit<uint8> TrainsWithoutNSTicket : nrofrows = 4
		, Descr = "Train products of the NS network on which an NS ticket never applies (own ticket with reservation), by route_short_name; their trips are left out of the NS network."
		{
			attribute<string> route_short_name : ['eurostar', 'thalys', 'nightjet', 'european sleeper'];
		}

		// Trip surcharge for special trains (ObjectVision/NetworkModel_PBL#3): the NS surcharge 'ICE / IC direct' per single trip, for the
		// products in TripSurchargeTrains above (HSL Schiphol-Rotterdam and domestic ICE). The amount is that of
		// NS_prices_year at full fare: the off-peak discount at the surcharge pole (40%, only with an OV-chipkaart) is not included.
		container TripSurcharge
		{
			unit<uint8>            Trains                := TripSurchargeTrains;

			unit<uint8> PerYear : nrofrows = 14
			, Descr = "NS surcharge ICE / IC direct per single trip, per fare year."
			{
				attribute<string> year              : ['2013', '2014', '2015', '2016', '2017', '2018', '2019', '2020', '2021', '2022', '2023', '2024', '2025', '2026'];
				attribute<Euro>   Surcharge_ICE_ICD : [ 2.30,   2.30,   2.30,   2.40,   2.40,   2.40,   2.40,   2.60,   2.60,   2.70,   2.90,   2.90,   3.00,   3.20 ];
				attribute<string> reference         :
				[
					'GEEN BRON GEVONDEN: gelijk aan 2015 gehouden; tot 15-12-2013 gold de toeslag ook op andere HSL-delen (wiki.ovinnederland.nl)',
					'GEEN BRON GEVONDEN: gelijk aan 2015 gehouden',
					'treinreiziger.nl 24-1-2015: toeslag enkele reis 2,30',
					'GEEN BRON GEVONDEN: 2,30 in 2015, 2,40 in 2017',
					'NS-tarievenlijst 1-1-2017 (treinreiziger.nl/downloads)',
					'treinreiziger.nl 6-4-2018: normaal 2,40, in de daluren vanaf 9-4-2018 1,40',
					'NS-tarievenlijst 1-1-2019',
					'NS-tarievenlijst 1-1-2020',
					'NS-tarievenlijst 1-1-2021',
					'NS-tarievenlijst 1-1-2022',
					'NS-tarievenlijst consumenten 1-1-2023',
					'NS-tarievenlijst consumenten 1-1-2024 (daluren 1,74)',
					'treinenweb.nl (NS-tarieven 2025: van 2,90 naar 3,00), rover.nl',
					'NS-prijslijst consumenten 1-1-2026 (daluren 1,92 aan de toeslagpaal)'
				];
			}
			parameter<Euro>        Surcharge_ICE_ICD     := rjoin(ModelParameters/Impl/NS_prices_year, PerYear/year, PerYear/Surcharge_ICE_ICD)
			, IntegrityCheck = "IsDefined(this)", Descr = "The surcharge of NS_prices_year.";

			attribute<Euro>        Surcharge    (Trains) := const(Surcharge_ICE_ICD, Trains), Descr = "Surcharge per single trip; both products follow the NS surcharge ICE / IC direct.";
			attribute<s>           ExtraTime    (Trains) := convert(Trains/ExtraTime, s), Descr = "The extra travel time of the product, in seconds.";
			attribute<bool>        HasSection   (Trains) := Trains/Station_A != '' && Trains/Station_B != '', Descr = "Does the product have a section between Station_A and Station_B?";
			attribute<NS_stations> StationA_rel (Trains) := rlookup(Trains/Station_A, NS_stations/code);
			attribute<NS_stations> StationB_rel (Trains) := rlookup(Trains/Station_B, NS_stations/code);
			parameter<bool>        Check_Stations        := all(not(HasSection) || (IsDefined(StationA_rel) && IsDefined(StationB_rel)))
			, IntegrityCheck = "Check_Stations == True", Descr = "Do the stations of each section in TripSurchargeTrains exist in NS_stations?";
		}
				
		// The tariff network per vintage (ModelParameters/Impl/NS_TariffNetwork_year, ObjectVision/NetworkModel_PBL#121):
		// - 2013 (for NS_prices_year 2013 to 2015): tariefnet.dat of NDOV, from ns-latest.zip, where it no longer is. It has the shared tariff
		//   points of NS: 35 edges of 0 tariff units between stations close to each other, such as Hilversum and Hilversum Sportpark, or Den Haag HS
		//   and Den Haag Centraal.
		// - 2016: NS abolished those points with the fares of 2016: every station pair is at least 1 tariff unit, the 0 became 1 (Den Haag HS to
		//   Laan v NOI is 2) and an adjacent edge 1 lower. This is the 2013 network with 69 edges adjusted to the tariff unit map of NS
		//   (rijdendetreinen.nl/tickets/tariefafstanden; the 5 border points bhg, ehai, fvsg, vlgr and wrg are not on it and are unchanged).
		//   Only pairs with the Valleilijn stations still differ (apd,hvl 37 here, NS has amf,apd 43); those use the RRReis fare, not the NS fare.
		unit<uint32> NS_TariffUnits_matrix
		: StorageName = "='%ProjDir%/Data/Tarieven_NS/NS_tariefnet_'+ModelParameters/Impl/NS_TariffNetwork_year+'.csv'"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, URL = "https://www.rijdendetreinen.nl/tickets/tariefafstanden"
		, Descr = "The NS tariff network of NS_TariffNetwork_year, with ut,utm (#120): 2013 with the shared tariff points of before 2016, 2016 with 69 edges adjusted to the tariff unit map of NS.", Source = "2013: NDOV tariefnet.dat (https://data.ndovloket.nl/ns/ns-latest.zip) with a header added; 2016: the same with 69 edges from the tariff unit map of NS (rijdendetreinen.nl, retrieved 2026-10-04)"
		{
			attribute<NS_stations> StartPoint_rel     := rlookup(org, NS_stations/code);
			attribute<NS_stations> EndPoint_rel       := rlookup(dest, NS_stations/code);
			attribute<rdc>         StartPoint         := NS_stations/geometry[StartPoint_rel];
			attribute<rdc>         EndPoint           := NS_stations/geometry[EndPoint_rel];
			attribute<uint32>      TariffUnit         := uint32(unit2);
			attribute<rdc>         geometry     (arc) := points2sequence(LinkPoints/Point, LinkPoints/Sequence_rel, LinkPoints/Ordinal);

			attribute<uint32>      c_NS_start_end_rel := combine_data(c_NS_start_end, StartPoint_rel, EndPoint_rel);
			attribute<bool>        IsExcluded         := IsDefined(rlookup(org + '_' + dest, TariffNetwork_ExcludedEdges/key)) || IsDefined(rlookup(dest + '_' + org, TariffNetwork_ExcludedEdges/key))
			, Descr = "An edge that NS does not count for the fare (TariffNetwork_ExcludedEdges); it does not take part in ConnectedNetwork.";

			unit<uint32> c_NS_start_end := combine(NS_stations, NS_stations)
			{
				attribute<string> label      := NS_stations/code[first_rel] + '_' + NS_stations/code[second_rel];
				attribute<uint32> TariffUnit := rjoin(id(.), c_NS_start_end_rel, NS_TariffUnits_matrix/TariffUnit);
			}

			unit<uint32> OrgDest := select_with_org_rel(IsDefined(rlookup(NS_stations/geometry, StartPoint)) || IsDefined(rlookup(NS_stations/geometry, EndPoint)))
			{
				attribute<rdc>    geometry := NS_stations/geometry[org_rel];
				attribute<string> label    := NS_stations/label[org_rel];
			}
			
			unit<uint32> LinkPoints := union_unit(., .)
			{
				attribute<rdc>    Point        := union_data(., StartPoint, EndPoint);
				attribute<..>     Sequence_rel := union_data(., id(..), id(..));
				attribute<uint32> Ordinal      := union_data(., const(0,..,uint32), const(1,..,uint32));
			}
			
			unit<uint32> ConnectedNetwork := select_with_attr_by_cond(., IsDefined(StartPoint) && IsDefined(EndPoint) && not(IsExcluded))
			{
				unit<uint32> NodeSet := unique(LinkPoints/Point)
				{
					attribute<rdc>    geometry := values;
					attribute<string> label    := rjoin(geometry, NS_stations/geometry, NS_stations/label);
					
				}
				
				attribute<NodeSet> F1                 := rlookup(StartPoint,NodeSet/geometry);
				attribute<NodeSet> F2                 := rlookup(EndPoint,NodeSet/geometry);
			
				attribute<NodeSet> org_node (OrgDest) := rlookup(OrgDest/geometry, NodeSet/geometry);
				attribute<NodeSet> dst_node (OrgDest) := rlookup(OrgDest/geometry, NodeSet/geometry);
			
			} 
			
			unit<uint32> ODMatrix :=
				impedance_matrix('bidirectional;startPoint(Node_rel);endPoint(Node_rel);od:impedance,OrgZone_rel,DstZone_rel,LinkSet'
					, ConnectedNetwork/TariffUnit
					, ConnectedNetwork/F1
					, ConnectedNetwork/F2
					
					, ConnectedNetwork/org_node
					, ConnectedNetwork/dst_node
				)
			{
				attribute<Euro>        Price_FullFare       := impedance >= 200
				                                               ? max(NS_PricePerTariffUnit/FullFare)
				                                               : rjoin(impedance, NS_PricePerTariffUnit/TariffUnits, NS_PricePerTariffUnit/FullFare);
				attribute<Euro>        Price_20pct_Discount := impedance >= 200
				                                               ? max(NS_PricePerTariffUnit/Discount_20pct)
				                                               : rjoin(impedance, NS_PricePerTariffUnit/TariffUnits, NS_PricePerTariffUnit/Discount_20pct);
				attribute<Euro>        Price_40pct_Discount := impedance >= 200
				                                               ? max(NS_PricePerTariffUnit/Discount_40pct)
				                                               : rjoin(impedance, NS_PricePerTariffUnit/TariffUnits, NS_PricePerTariffUnit/Discount_40pct);
				attribute<Euro>        Price                := =ModelParameters/Impl/NS_FareClass;
				attribute<Ct>          Price_ct             := rounded_convert(Price, Ct);
				attribute<NS_stations> Org_NS_station_rel   := OrgDest/org_rel[OrgZone_rel];
				attribute<NS_stations> Dest_NS_station_rel  := OrgDest/org_rel[DstZone_rel];
				attribute<uint32>      c_NS_start_end_rel   := combine_data(c_NS_start_end, Org_NS_station_rel, Dest_NS_station_rel);
				
					

			}
		}

		unit<uint32> NS_stations
		: StorageName = "%ProjDir%/Data/Tarieven_NS/NS_stations.csv"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, URL = "https://data.ndovloket.nl/ns/ns-latest.zip"
		, Descr = "The NS stations with their code, name and location.", Source = "NDOV stations.dat from ns-latest.zip, converted to csv with headers added"
		{
			attribute<string> code                  := trim(stations_code);
			attribute<string> label                 := trim(stations_naam);
			attribute<rdc>    geometry              := rjoin(code, lowercase(Infrastructure/Read_NS_Stations_SHP/code), Infrastructure/Read_NS_Stations_SHP/geometry_rd);
			
			attribute<bool>   IsInNL                := IsDefined(point_in_polygon(geometry, /SourceData/RegioIndelingen/NL/geometry));
		}
	}
	#include<TripSurchargeReport.dms>
}