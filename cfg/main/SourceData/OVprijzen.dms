container OVprijzen  
{
	unit<uint32> Agencies          := Classifications/Agencies;
	unit<uint8>  Modes             := Classifications/GTFS_Modes/Selection;
	unit<uint8>  Concessiegebieden := SourceData/RegioIndelingen/Concessiegebied;
	
	unit<uint8>  FareTable         := =ModelParameters/Impl/PriceMethod_effective == 'DOVA' ? 'FareTable_DOVA' : 'FareTable_'+ModelParameters/Impl/FareTable_year, Descr = "The fare table in use: FareTable_DOVA, or the detailed FareTable_<year> of ModelParameters/Impl/FareTable_year.";
	
	unit<uint32> Read_DOVA_DistanceFares
	: StorageName = "%ProjDir%/data/DOVA_Overzicht km-tarieven 2013-2026_edit.xlsx"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	, SqlString   = "SELECT * FROM kmtarief", Descr = "The DOVA kilometre fares per concession and mode class, with the column of DOVA_year as VariablePrice.", Source = "DOVA, overview of kilometre fares and base fares 2013 to 2026, sheet kmtarief"
	{
		attribute<Euro>    FixedPrice    := const(Read_DOVA_BoardingFares/FixedPrice_param,.);
		attribute<Euro_km> VariablePrice := ='y'+ModelParameters/Impl/DOVA_year+'[Euro_km]';
		
	}
	
	unit<uint32> Read_DOVA_BoardingFares
	: StorageName = "%ProjDir%/data/DOVA_Overzicht km-tarieven 2013-2026_edit.xlsx"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	, SqlString   = "SELECT * FROM basistarief", Descr = "The DOVA base fare, the column of DOVA_year as FixedPrice.", Source = "DOVA, overview of kilometre fares and base fares 2013 to 2026, sheet basistarief"
	{
		attribute<Euro> FixedPrice       := ='y'+ModelParameters/Impl/DOVA_year+'[Euro]';
		parameter<Euro> FixedPrice_param := first(FixedPrice);
	}

	unit<uint8> ModeClass : NrOfRows = 3
	{
		attribute<string>  name                   : ['BTM','Rail','Ferry'], Descr = "Mode classes for the DOVA prices: BTM = bus, tram and metro, Rail = regional train, Ferry = ferry; NS trains go through the L-net (NS fare structure), not through this FareTable.";
		attribute<Euro_km> VariablePrice_national := mean(Read_DOVA_DistanceFares_Priced/VariablePrice, Read_DOVA_DistanceFares_Priced/ModeClass_rel), Descr = "National average kilometre fare per mode class of the chosen year; the fallback for concessions without a DOVA row and for the Buitenland safety net.";
	}

	// One canonical DOVA row per (concession, mode class) (column use_for_price=1 in the xlsx). The DOVA concessions are matched to the shape
	// concessions through the column Concessiegebied_model (byte-exact), the mode class through the column Mode_klasse.
	unit<uint32> Read_DOVA_DistanceFares_Priced := select_with_attr_by_cond(Read_DOVA_DistanceFares, uint8(Read_DOVA_DistanceFares/use_for_price) > 0b)
	{
		attribute<string>    MC_CG_key     := Mode_klasse + '_' + AsItemName(Concessiegebied_model);
		attribute<ModeClass> ModeClass_rel := rlookup(Mode_klasse, ModeClass/name);
	}

	// FareTable from the DOVA overview, keyed on (concession x mode class): the fare table when ModelParameters/Impl/PriceMethod_effective is
	// 'DOVA', and in the detailed method the fare of the rides without a rule.
	// BTM (bus/tram/metro) gets the concession kilometre fare; Rail (regional train) gets the separate DOVA rail kilometre fare; Ferry likewise
	// where available. Missing (concession, class) combinations fall back to the BTM fare of the same concession (MakeDefined).
	unit<uint8> FareTable_DOVA_NL := combine_uint8(Concessiegebieden, ModeClass)
	{
		attribute<string>  CG_name                := Concessiegebieden/name[first_rel];
		attribute<string>  MC_name                := ModeClass/name[second_rel];
		attribute<string>  MC_CG_key              := MC_name + '_' + CG_name;
		attribute<Euro>    FixedPrice             := const(Read_DOVA_BoardingFares/FixedPrice_param, .);
		attribute<Euro_km> VariablePrice_specific := rjoin(MC_CG_key,      Read_DOVA_DistanceFares_Priced/MC_CG_key, Read_DOVA_DistanceFares_Priced/VariablePrice);
		attribute<Euro_km> VariablePrice_BTM      := rjoin('BTM_'+CG_name, Read_DOVA_DistanceFares_Priced/MC_CG_key, Read_DOVA_DistanceFares_Priced/VariablePrice);
		// last fallback: the national class average, for shape concessions without a DOVA row (for example Stadsvervoer Lelystad in the 2023 shape).
		attribute<Euro_km> VariablePrice          := MakeDefined(MakeDefined(VariablePrice_specific, VariablePrice_BTM), ModeClass/VariablePrice_national[second_rel]);
	}

	// #168: DB charges on the Dutch section of the RB51 (Enschede - Gronau) the base fare plus its kilometre fare over the NS tariff units of the
	// station pair (Classifications/Agencies/IsPricedOnTariffUnits). The DOVA overview has that kilometre fare in the row of DB Regio from 2018
	// on. In the DOVA method the rides of DB get it through their own row of FareTable_DOVA; the detailed fare tables have a rule per year.
	container DB
	{
		parameter<string>  MC_CG_key               := 'Rail_DB', Descr = "The key of the row of DB in FareTable_DOVA, which MC_CG_key_DOVA of OD_extra_attributen gives to the rides of DB.";
		parameter<string>  FirstYear               := '2018', Descr = "The first year with a kilometre fare of DB Regio in the DOVA overview; an earlier fare year gets the fare of this year, scaled with the DOVA base fare.";
		unit<uint32>       Row                     := select_with_attr_by_cond(Read_DOVA_DistanceFares, Read_DOVA_DistanceFares/Vervoerder == 'DB Regio'), Descr = "The row of DB Regio (Enschede - Gronau) in the DOVA overview.";
		parameter<Euro_km> VariablePrice_given     := first(Row/VariablePrice);
		parameter<Euro_km> VariablePrice_FirstYear := ='first(Row/y'+FirstYear+')[Euro_km]';
		parameter<Euro>    FixedPrice_FirstYear    := ='first(Read_DOVA_BoardingFares/y'+FirstYear+')[Euro]';
		parameter<Euro_km> VariablePrice           := value(ModelParameters/Impl/DOVA_year, uint32) < value(FirstYear, uint32)
		                                              ? VariablePrice_FirstYear * (Read_DOVA_BoardingFares/FixedPrice_param / FixedPrice_FirstYear)
		                                              : VariablePrice_given
		, IntegrityCheck = "IsDefined(this) && this > 0[Euro_km]"
		, Descr = "The kilometre fare of DB in DOVA_year, per NS tariff unit: the DOVA overview, and before FirstYear an estimate, the fare of FirstYear times the ratio of the DOVA base fares, which follow the national tariff index.";
	}
	unit<uint8> DB_Row : nrofrows = 1, Descr = "The single row of DB that FareTable_DOVA adds to the concession rows.";

	unit<uint8> MinimumFareDistance : nrofrows = 4
	, Descr = "Rules of the detailed fare tables whose kilometre fare counts at least a minimum distance, per fare year. The Valleilijn charges one fare for the first 8 NS tariff units; its rule gives that fare as FixedPrice plus 8 times VariablePrice, so a shorter ride counts 8 (#176)."
	, Source = "Valleilijn: provincial fare decisions prb-2024-19228 (2024 and 2025) and prb-2025-20501 (2026), zoek.officielebekendmakingen.nl"
	{
		attribute<string> FareTable_year  : ['2024', '2025', '2026', '2026'];
		attribute<string> Rule            : ['Rail_rrreis_Concessie_Arnhem_Nijmegen', 'Rail_rrreis_Concessie_Arnhem_Nijmegen', 'Rail_rrreis_keolis_Concessie_Arnhem_Nijmegen', 'Bus_rrreis_keolis_'], Descr = "The key of the rule, its Mode_Agency_CG_Line_identifier in FareTable_<year>.";
		attribute<km>     MinFareDistance : [8, 8, 8, 8], Descr = "The minimum number of tariff units, or kilometres for a ride priced over its distance travelled, of the kilometre fare of a ride with this rule.";
		attribute<string> key             := FareTable_year + '|' + Rule;
	}

	// Safety net for rides outside all concession polygons (foreign sections of De Lijn/DB/Eurobahn/NIAG and possible edge artefacts): one
	// row per mode class, key '<class>_Buitenland' (see MC_CG_key_DOVA in OD_extra_attributen). Kilometre fare = national DOVA average of the
	// class of the chosen year, boarding fare = national base fare. Without this safety net Price_IntegrityCheck fails in DOVA mode on those rides.
	// The last row is that of DB (#168).
	unit<uint8> FareTable_DOVA := union_unit_uint8(FareTable_DOVA_NL, ModeClass, DB_Row)
	{
		attribute<string>  MC_CG_key                      := union_data(., FareTable_DOVA_NL/MC_CG_key, ModeClass/name + '_Buitenland', const(DB/MC_CG_key, DB_Row));
		attribute<Euro>    FixedPrice                     := union_data(., FareTable_DOVA_NL/FixedPrice, const(Read_DOVA_BoardingFares/FixedPrice_param, ModeClass), const(Read_DOVA_BoardingFares/FixedPrice_param, DB_Row));
		attribute<Euro_km> VariablePrice                  := union_data(., FareTable_DOVA_NL/VariablePrice, ModeClass/VariablePrice_national, const(DB/VariablePrice, DB_Row));
		attribute<Euro>    RideSurcharge                  := const(0[Euro], .), Descr = "The DOVA fares have no surcharge per ride; the column exists so that the prices of OD_extra_attributen also exist when FareTable is FareTable_DOVA (#164).";
		// The identifier columns of a detailed fare table, here all MC_CG_key, so that the lookups of OD_extra_attributen (FareTable_rel_Line
		// and the others) also exist when FareTable is FareTable_DOVA; the price then comes from MC_CG_key_DOVA.
		attribute<string>  Mode_Agency_CG_Line_identifier := MC_CG_key;
		attribute<string>  Mode_Agency_CG_identifier      := MC_CG_key;
		attribute<string>  Mode_Agency_identifier         := MC_CG_key;
		attribute<string>  label                          := MC_CG_key;
	}

	// ---- Pre-flight price coverage (see /ChecksBeforeRunning/PT_CheckPriceCoverage) ----
	// Cheap to evaluate BEFORE building the network: it reads only agency and routes of the loaded feed plus the active fare table. A ride
	// without a rule in the detailed fare table gets the DOVA fare of its concession (OD_extra_attributen, #55), so a (mode, agency) combination
	// without any row is reported here, not refused. Routes without trips on the chosen Analysis_date also count.
	// DOVA mode: coverage holds by construction (combine over all concessions + Buitenland safety net + national fallback); there the check
	// is that all prices of the chosen year are filled and plausible.
	container PriceCoverage
	{
		// regional routes (OD_R) of the feed; NS (OD_L) is priced through the NS fare structure, and walking/cycling pseudo-routes have no agency. The source
		// is RelevantSelection/Routes (the unit with the attribute subitems; select_with_attr_by_cond on an alias unit copies no attributes).
		unit<uint32> RnetRoutes := select_with_attr_by_cond(/SourceData/Infrastructure/GTFS/RelevantSelection/Routes
									,  IsDefined(/SourceData/Infrastructure/GTFS/RelevantSelection/Routes/agency_rel)
									&& IsDefined(/SourceData/Infrastructure/GTFS/RelevantSelection/Routes/Mode_rel)
									&& Agencies/IsRO[/SourceData/Infrastructure/GTFS/RelevantSelection/Routes/agency_rel])
		{
			attribute<string> Mode_Agency_identifier := Modes/name[Mode_rel] +'_'+ Agencies/name[agency_rel];
		}

		unit<uint32> UniqueCombos := unique(RnetRoutes/Mode_Agency_identifier)
		{
			attribute<uint32> NrRoutes    := pcount(rlookup(RnetRoutes/Mode_Agency_identifier, values));
			attribute<bool>   InFareTable := IsDefined(rlookup(values, FT_detailed/Mode_Agency_identifier));
		}
		unit<uint32>      MissingCombos      := select_with_attr_by_cond(UniqueCombos, not(UniqueCombos/InFareTable));
		parameter<string> MissingCombos_list := asList(MissingCombos/values + ' [' + string(MissingCombos/NrRoutes) + ' routes]', '; ');

		// Audit trail: writes the coverage per (mode, agency) combination to csv, so that per feed and fare year it is documented what was checked
		// (generate it by updating this item).
		unit<uint32> CoverageReport := UniqueCombos
		, StorageName = "= '%LocalDataProjDir%/Output/Checks/Prijsdekking_feed'+ModelParameters/Impl/GTFS_file_date+'_FareTable'+ModelParameters/Impl/FareTable_year+'.csv'"
		, StorageType = "gdalwrite.vect"
		{
			attribute<string> mode_agency  (.) := UniqueCombos/values;
			attribute<uint32> nr_routes    (.) := UniqueCombos/NrRoutes;
			attribute<bool>   in_faretable (.) := UniqueCombos/InFareTable;
		}

		// The detailed table (#153): every rule of regional transport has a price, and no negative one (the NS rules are priced through the
		// tariff units and are left empty); a table that fails this stops the run at its checks (ChecksBeforeRunning/Check_PriceCoverage). A
		// price above the limits of ModelParameters/Advanced is reported, not refused, because some prices are really that high, such as the
		// ferry to Terschelling. MakeDefined instead of IsDefined, so that a null price counts as FALSE in all().
		unit<uint8>       FT_detailed        := ='FareTable_'+ModelParameters/Impl/FareTable_year;
		attribute<bool>   IsNS_Rule   (FT_detailed) := lowercase(FT_detailed/Vervoerder) == 'ns';
		attribute<bool>   HasPrices   (FT_detailed) := MakeDefined(FT_detailed/FixedPrice, 0[Euro] - 1[Euro]) >= 0[Euro] && MakeDefined(FT_detailed/VariablePrice, 0[Euro_km] - 1[Euro_km]) >= 0[Euro_km]
		                                               && MakeDefined(FT_detailed/RideSurcharge, 0[Euro] - 1[Euro]) >= 0[Euro];
		attribute<bool>   IsUnusual   (FT_detailed) := not(IsNS_Rule) && HasPrices
		                                               && (FT_detailed/FixedPrice + FT_detailed/RideSurcharge > (FT_detailed/Mode == 'Ferry' ? ModelParameters/Advanced/PlausibleMaxFixedPrice_Ferry : ModelParameters/Advanced/PlausibleMaxFixedPrice)
		                                                   || FT_detailed/VariablePrice > ModelParameters/Advanced/PlausibleMaxVariablePrice);
		parameter<bool>   Table_OK_detailed  := all(IsNS_Rule || HasPrices), Descr = "Does every rule of regional transport in the detailed fare table have a price that is not negative?";
		unit<uint8>       UnusualRules       := select_with_org_rel(IsUnusual), Descr = "The rules with a price above the limits of ModelParameters/Advanced: real fares, or errors to check.";
		parameter<string> UnusualRules_list  := asList(FT_detailed/label[UnusualRules/org_rel] + ' (' + string(FT_detailed/FixedPrice[UnusualRules/org_rel]) + ' euro, ' + string(FT_detailed/VariablePrice[UnusualRules/org_rel]) + ' euro per km and ' + string(FT_detailed/RideSurcharge[UnusualRules/org_rel]) + ' euro per ride)', '; ');

		// #173: a rule that can never apply. A ride takes the first rule with its key (rlookup in OD_extra_attributen), and the column Provincie
		// is not part of the key, so a later rule with the same key prices nothing; with another price the order of the table decides the price.
		// A rule whose concession area the shapes of the fare year do not have matches no ride either. The rules per key are counted with
		// unique and not by an rlookup of the key on itself, because GeoDMS rewrites lookup(rlookup(a, a), c) to c, which holds only for unique a.
		unit<uint32>      Keys               := unique_uint32(FT_detailed/Mode_Agency_CG_Line_identifier), Descr = "The keys of the rules of the detailed fare table, with the number of rules and of different prices per key (#173)."
		{
			attribute<uint32> NrRules := pcount_uint32(Key_rel);
			attribute<uint32> NrFares := pcount_uint32(KeyFares/Key_rel);
		}
		attribute<Keys>   Key_rel     (FT_detailed) := rlookup(FT_detailed/Mode_Agency_CG_Line_identifier, Keys/values);
		attribute<string> KeyFare     (FT_detailed) := FT_detailed/Mode_Agency_CG_Line_identifier + '|' + MakeDefined(string(FT_detailed/FixedPrice), '') + '|' + MakeDefined(string(FT_detailed/VariablePrice), '') + '|' + MakeDefined(string(FT_detailed/RideSurcharge), '');
		unit<uint32>      KeyFares           := unique_uint32(KeyFare), Descr = "The different combinations of a key and its prices."
		{
			attribute<Keys> Key_rel := rjoin(values, KeyFare, ../Key_rel);
		}
		attribute<bool>   IsUnknownCG (FT_detailed) := FT_detailed/Concessiegebied != '' && IsNull(FT_detailed/Concessiegebieden_rel), Descr = "Does the rule name a concession area that the shapes of the fare year do not have (#173)?";
		unit<uint32>      SharedKeys         := select_with_org_rel(Keys/NrRules > 1 && Keys/NrFares <= 1), Descr = "The keys of more than one rule with the same price: only the first rule of each applies, and the others can go (#173).";
		unit<uint32>      ConflictingKeys    := select_with_org_rel(Keys/NrFares > 1), Descr = "The keys of rules with different prices: the order of the table decides the price (#173).";
		unit<uint8>       UnknownCG_Rules    := select_with_org_rel(IsUnknownCG), Descr = "The rules with a concession area that the shapes of the fare year do not have, so that they match no ride (#173).";
		parameter<string> SharedKeys_list    := asList(Keys/values[SharedKeys/org_rel] + ' (' + string(Keys/NrRules[SharedKeys/org_rel]) + ' rules)', '; ');
		parameter<string> ConflictingKeys_list := asList(Keys/values[ConflictingKeys/org_rel] + ' (' + string(Keys/NrRules[ConflictingKeys/org_rel]) + ' rules, ' + string(Keys/NrFares[ConflictingKeys/org_rel]) + ' prices)', '; ');
		parameter<string> UnknownCG_list     := asList(FT_detailed/label[UnknownCG_Rules/org_rel] + ' (' + FT_detailed/Concessiegebied[UnknownCG_Rules/org_rel] + ')', '; ');

		// The DOVA table: filled and plausible for every concession and mode class; in the detailed method it prices the rides without a rule.
		parameter<bool>   Table_OK_DOVA      := all(
		                                           MakeDefined(FareTable_DOVA/FixedPrice,    0[Euro]    - 1[Euro])    >= 0[Euro]    && MakeDefined(FareTable_DOVA/FixedPrice,    999[Euro])    <= ModelParameters/Advanced/PlausibleMaxFixedPrice
		                                        && MakeDefined(FareTable_DOVA/VariablePrice, 0[Euro_km] - 1[Euro_km]) >= 0[Euro_km] && MakeDefined(FareTable_DOVA/VariablePrice, 999[Euro_km]) <= ModelParameters/Advanced/PlausibleMaxVariablePrice);

		// One line for ChecksBeforeRunning (#153): FAIL stops the run, for a rule without a price and for rules of one key with different prices
		// (#173). WARN reports a combination without a rule, which falls back on the DOVA fare of its concession, a rule with an unusual price,
		// a key of more than one rule with the same price, and a concession area that the shapes of the fare year do not have.
		parameter<string> Coverage_Text      := string(#MissingCombos)+' of the '+string(#UniqueCombos)+' combinations of mode and agency of feed '+ModelParameters/Impl/GTFS_file_date+(#MissingCombos == 1 ? ' has' : ' have')+' no rule in FareTable_'+ModelParameters/Impl/FareTable_year+(#MissingCombos == 1 ? ' and gets the DOVA fare of its concession: ' : ' and get the DOVA fare of their concession: ')+MissingCombos_list+'.';
		parameter<string> Unusual_Text       := string(#UnusualRules)+(#UnusualRules == 1 ? ' rule' : ' rules')+' of FareTable_'+ModelParameters/Impl/FareTable_year+(#UnusualRules == 1 ? ' has' : ' have')+' a price above the limits of ModelParameters/Advanced (PlausibleMaxFixedPrice, PlausibleMaxFixedPrice_Ferry, PlausibleMaxVariablePrice)'+(#UnusualRules == 1 ? '; check it: ' : '; check them: ')+UnusualRules_list+'.';
		parameter<string> Conflicting_Text   := string(#ConflictingKeys)+(#ConflictingKeys == 1 ? ' key' : ' keys')+' of FareTable_'+ModelParameters/Impl/FareTable_year+(#ConflictingKeys == 1 ? ' has' : ' have')+' rules with different prices, of which only the first in the table applies (the column Provincie is not part of the key); give each rule its own concession area or line, or remove it: '+ConflictingKeys_list+'.';
		parameter<string> SharedKeys_Text    := string(#SharedKeys)+(#SharedKeys == 1 ? ' key' : ' keys')+' of FareTable_'+ModelParameters/Impl/FareTable_year+(#SharedKeys == 1 ? ' has' : ' have')+' more than one rule with the same price, of which only the first applies; remove the others: '+SharedKeys_list+'.';
		parameter<string> UnknownCG_Text     := string(#UnknownCG_Rules)+(#UnknownCG_Rules == 1 ? ' rule' : ' rules')+' of FareTable_'+ModelParameters/Impl/FareTable_year+(#UnknownCG_Rules == 1 ? ' has a concession area' : ' have concession areas')+' that the shapes of '+ModelParameters/Impl/ConcessionArea_year+' do not have, so that '+(#UnknownCG_Rules == 1 ? 'it matches' : 'they match')+' no ride: '+UnknownCG_list+'.';
		parameter<string> Status_Detailed    := !Table_OK_detailed
		                                        ? 'FAIL: FareTable_'+ModelParameters/Impl/FareTable_year+' has rules of regional transport without a price or with a negative price; fill them in.'
		                                        : #ConflictingKeys > 0
		                                        ? 'FAIL: ' + Conflicting_Text
		                                        : #MissingCombos > 0 || #UnusualRules > 0 || #SharedKeys > 0 || #UnknownCG_Rules > 0
		                                        ? 'WARN: ' + trim((#MissingCombos > 0 ? Coverage_Text + ' ' : '') + (#UnusualRules > 0 ? Unusual_Text + ' ' : '') + (#SharedKeys > 0 ? SharedKeys_Text + ' ' : '') + (#UnknownCG_Rules > 0 ? UnknownCG_Text : ''))
		                                        : 'PASS: all '+string(#UniqueCombos)+' combinations of mode and agency of feed '+ModelParameters/Impl/GTFS_file_date+' have a rule in FareTable_'+ModelParameters/Impl/FareTable_year+', with prices within the limits, a key of its own for every rule and every concession area in the shapes.';

		parameter<string> Status_DOVA        := Table_OK_DOVA
		                                        ? 'PASS: the DOVA fares of '+ModelParameters/Impl/DOVA_year+' are filled and within the limits for every concession and mode class.'
		                                        : 'FAIL: the DOVA fares of '+ModelParameters/Impl/DOVA_year+' have empty prices or prices above the limits of ModelParameters/Advanced; check the year columns of the DOVA xlsx.';

		parameter<string> Status             := =ModelParameters/Impl/PriceMethod_effective == 'DOVA' ? 'Status_DOVA' : 'Table_OK_DOVA ? Status_Detailed : Status_DOVA';
		parameter<string> Status_gated       := =ModelParameters/Impl/PriceExportsAndIntegrityChecksNeeded ? 'Status' : 'Status_skip';
		parameter<string> Status_skip        := 'PASS: prices are off (no price in MinimiseCriteria and Export_PriceInformation FALSE), so the fare tables are not checked.';
	}

	unit<uint8> FareTable_2023 : NrOfRows = 135, URL = "https://github.com/ObjectVision/NetworkModel_PBL/issues/2", Descr = "The detailed fare table of 2023: per mode, agency, concession and line a boarding fare (FixedPrice), a price per kilometre (VariablePrice) and a surcharge per ride on top of both (RideSurcharge, #164), with the source of each row in Opmerking. A rule without a price per kilometre and without a surcharge is a fixed fare per ride outside the OV-chip journey (#55). The column Provincie is a note only: a rule without a concession area applies to the agency in every concession area without a rule of its own, and of rules with the same key only the first applies (#173)."
	{
		unit<uint32> Elements := Range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text:
			[
				//de    ,Vervoerder            ,Provincie       ,Concessiegebied                      ,Lijn                   ,Ritprijs ,Kmprijs ,Ritopslag ,Opmerking (source per row; 'GEEN BRON GEVONDEN' = not found online)                                                      
				'Rail'  ,'NS'                  ,'Alle'          ,''                                   ,''                     ,''     ,''      ,''       ,'TariffUnits in NS tabel',
				'Bus'   ,'NS'                  ,'Alle'          ,''                                   ,''                     ,''     ,''      ,''       ,'TariffUnits in NS tabel',
				'Bus'   ,'Overal_Connexxion_'  ,'Alle'          ,''                                   ,''                     ,'1.08' ,'0.187' ,'0'      ,'vangnet voor Connexxion-grensritten buiten eigen concessies; mediaan van de Connexxion/Hermes/Breng-concessietarieven 2023 (DOVA); alle concessies hebben eigen rijen',
				'Rail'  ,'Blauwnet'            ,'Drenthe'       ,'Groningen_Drenthe'                  ,''                     ,'1.08' ,'0.208' ,'0'      ,'2e klas Arriva Blauwnet',
				'Bus'   ,'Qbuzz'               ,'Drenthe'       ,'Groningen_Drenthe'                  ,''                     ,'1.08' ,'0.188' ,'0'      ,'',
				'Bus'   ,'allGo_Keolis_'       ,'Flevoland'     ,'Busvervoer_Almere'                  ,''                     ,'1.08' ,'0.177' ,'0'      ,'Almere | 2023-val: 0,161 was 2022-prijs; Keolis Almere 2023 = 0,177',
				'Bus'   ,'OV_Regio_IJsselmond' ,'Flevoland'     ,'IJsselmond'                         ,''                     ,'1.08' ,'0.185' ,'0'      ,'',
				'Bus'   ,'Arriva'              ,'Fryslân'       ,'Openbaar busvervoer Fryslân'        ,'Buurtbus NZW-Fryslan' ,'1.08' ,'0.079' ,'0'      ,'buurtbussen Noordzuidwest-Fryslan',
				'Bus'   ,'Arriva'              ,'Fryslân'       ,'Openbaar busvervoer Fryslân'        ,'Buurtbus ZO-Fryslan'  ,'1.08' ,'0.187' ,'0'      ,'buurtbussen Zuidoost-Fryslan',
				'Bus'   ,'Arriva'              ,'Fryslân'       ,'Openbaar busvervoer Fryslân'        ,'Opstapper'            ,'2.50' ,'0'     ,'0'      ,'ritkaart 2.50 | bron: Arriva Tarievensheet 2024 v1.0, tab N-WAD/N-NF',
