container OSM : using = "classifications/OSM", Descr = "The OpenStreetMap road network of the analysis moment: read per region, merged per country, prepared and stored, with the car, cycling and walking networks derived from it."
{  
	parameter<string> file_date   := rjoin(ModelParameters/AnalysisMoment, ModelParameters/Advanced/AnalysisMomentPresets/name, ModelParameters/Advanced/AnalysisMomentPresets/OSM_file_date);
	parameter<string> dir         := '%NetworkModel_Dir%/Infrastructuur/OSM/'+file_date;
	parameter<string> date        := file_date == '20221201' ? '-221201' : file_date == '20240101' ? '-240101' : '-latest';
	parameter<bool>   OSM_NL_prov := rjoin(ModelParameters/AnalysisMoment, ModelParameters/Advanced/AnalysisMomentPresets/name,ModelParameters/Advanced/AnalysisMomentPresets/OSM_NL_prov), Descr = "True when the OSM edition of the analysis moment is read per Dutch province instead of from one file.";     
	
	unit<uint32>      OSM_Regios  := =OSM_NL_prov ? 'ModelParameters/Advanced/OSM_impl/InProvincies' : 'ModelParameters/Advanced/OSM_impl/InEenBestand'
	, Descr = "The OSM regions to read, the Dutch provinces or one file, each with its country."
	{
		attribute<string>        label          := =OSM_NL_prov ? 'ModelParameters/Advanced/OSM_impl/InProvincies/label' : 'ModelParameters/Advanced/OSM_impl/InEenBestand/label';
		attribute<string>        name           := =OSM_NL_prov ? 'ModelParameters/Advanced/OSM_impl/InProvincies/name' : 'ModelParameters/Advanced/OSM_impl/InEenBestand/name';
		attribute<string>        Country        := =OSM_NL_prov ? 'ModelParameters/Advanced/OSM_impl/InProvincies/Country' : 'ModelParameters/Advanced/OSM_impl/InEenBestand/Country';
		attribute<string>        Type_src       := =OSM_NL_prov ? 'ModelParameters/Advanced/OSM_impl/InProvincies/Type_src' : 'ModelParameters/Advanced/OSM_impl/InEenBestand/Type_src';
		
		attribute<bool>          IsOD_Regio      := Type_src == 'OD';
		
		
		unit<uint32> OD_regios := select_with_org_rel(IsOD_Regio)
		{
			attribute<string> name  := ../name[org_rel];
			attribute<string> label := ../label[org_rel];
		}
		
		unit<uint32> Countries : nrofrows = 3
		{
			attribute<string> name : ['Germany', 'Netherlands', 'Belgium'];
		}
		
		unit<uint32> Germany := select_with_org_rel(country == 'DE')
		{
			attribute<string> name  := ../name[org_rel];
			attribute<string> label := ../label[org_rel];
		}
		unit<uint32> Netherlands := select_with_org_rel(country == 'NL')
		{
			attribute<string> name  := ../name[org_rel];
			attribute<string> label := ../label[org_rel];
		}
		unit<uint32> Belgium := select_with_org_rel(country == 'BE')
		{
			attribute<string> name  := ../name[org_rel];
			attribute<string> label := ../label[org_rel];
		}
	}

	container Prepare_SourceData :=
		for_each_ne(
			OSM_Regios/name
			, 'Prepare_SourceData_T('+quote(OSM_Regios/label)+','+quote(OSM_Regios/country)+')'
		);
	
	Template Prepare_SourceData_T
	{
		parameter<string> Regio;
		parameter<string> Country;
		///
		unit<uint32> Read_Roads_shp 
		:	StorageName     = "= dir + '/'+Regio+''+date+'-free.shp/gis_osm_roads_free_1.shp'"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogType = "Map"
		,	DialogData = "geometry_rd"
		{
			attribute<wgs84_base>        geometry    (arc);
			attribute<rdc>               geometry_rd_src (arc) := LatLongWgs842RD(geometry, dpoint)[rdc];
			// The points of a one-way road with oneway 'T' (direction of travel against the digitising direction) are reversed, so that the direction
			// of travel of every one-way road runs from the first to the last point: the network uses a one-way link only from F1 to F2.
			unit<uint32> Points_rd := sequence2points(geometry_rd_src)
			{
				attribute<uint32> NrPoints (..) := pcount(Sequence_rel);
				attribute<uint32> Ordinal_dir   := ../Direction[Sequence_rel] == Directions_OSM/v/backwards ? NrPoints[Sequence_rel] - 1 - Ordinal : Ordinal;
			}
			attribute<rdc>               geometry_rd (arc)   := points2sequence(Points_rd/Point, Points_rd/Sequence_rel, Points_rd/Ordinal_dir), Descr = "Geometry in RD, in the direction of travel when the road is one-way.";
			attribute<string>            fclass;
			attribute<string>            oneway;
			attribute<int32>             maxspeed;
			attribute<Directions_OSM>    Direction      := MakeDefined(rlookup(Oneway, Directions_OSM/code), Directions_OSM/v/dual); 
			attribute<bool>              IsOneDirection := Direction == Directions_OSM/v/backwards || Direction == Directions_OSM/v/forwards;
			// An fclass that is not in Classifications/OSM/roadType becomes 'unknown' (walkable only); NrUnmappedFclass counts them, to notice new fclasses.
			attribute<roadType>          roadType_rel    := MakeDefined(rlookup(fclass, roadType/name), roadType/V/unknown);
			parameter<uint32>            NrUnmappedFclass := sum(uint32(IsNull(rlookup(fclass, roadType/name))));
		}
	}
	
	container Merge_SourceData
	{
		container Merge_Roads_perCountry :=
			for_each_ne(
				OSM_Regios/Countries/name
				, 'Make_Merged_Roads_perCountry_T('+quote(OSM_Regios/Countries/name)+')'
			);

		
		Template Make_Merged_Roads_perCountry_T
		{
			parameter<string> country_name;
			//
			unit<uint32> Country_regios := ='OSM_Regios/'+country_name;
			unit<uint32>  Merge_CountryRegion_Roads := ='union_unit('+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp', ',')+')'
			{
				attribute<rdc>                          geometry (arc)                   := ='union_data(., '+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp/geometry_rd', ',')+')';
				attribute<km_hr>                        maxspeed_src                     := ='union_data(., '+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp/maxspeed[km_hr]', ',')+')';
				attribute<roadType>                     roadType_rel                     := ='union_data(., '+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp/roadType_rel', ',')+')';
				attribute<string>                       OSM_id                           := ='union_data(., '+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp/OSM_id', ',')+')';
				attribute<bool>                         IsOneDirection                   := ='union_data(., '+asList('Prepare_SourceData/'+Country_regios/name+'/Read_Roads_shp/IsOneDirection', ',')+')';
				
				attribute<km_hr>                        rth_maxspeed_per_roadType         (classifications/OSM/roadType) := rth_element(maxspeed_src > 0[km_hr] && maxspeed_src < 140[km_hr] ? maxspeed_src : (0f/0f)[km_hr], ModelParameters/Advanced/OSM_MaxSpeedQuantile, roadType_rel), Descr = "Quantile of the tagged maxspeed per road type.";
				attribute<km_hr>                        rth_maxspeed_per_roadType_Defined (classifications/OSM/roadType) := rth_maxspeed_per_roadType == 0[km_hr] ? ModelParameters/Advanced/CarDefaultSpeed_low : MakeDefined(rth_maxspeed_per_roadType, ModelParameters/Advanced/CarDefaultSpeed_low);
			
				attribute<km_hr>                        maxspeed_edit00                                                := maxspeed_src != 0[km_hr] && IsDefined(maxspeed_src) && maxspeed_src < 140[km_hr]  ? maxspeed_src : rjoin(roadType_rel, id(classifications/OSM/roadType), rth_maxspeed_per_roadType_Defined);
				attribute<km_hr>                        maxspeed_edit0                                                 := roadType_rel == classifications/OSM/roadType/v/motorway && maxspeed_edit00 < 80[km_hr] ? rjoin(roadType_rel, id(classifications/OSM/roadType), rth_maxspeed_per_roadType_Defined) : maxspeed_edit00;
				attribute<km_hr>                        maxspeed                                                       := switch(case(maxspeed_edit0 == 0[km_hr], ModelParameters/Advanced/CarDefaultSpeed), case(maxspeed_edit0 < 15[km_hr], 15[km_hr]), maxspeed_edit0);
			
					
			}
		}

		unit<uint32>  Merge_Country_Roads := ='union_unit('+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads', ',')+')'
		{
			attribute<rdc>                          geometry (arc)     := ='union_data(., '+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads/geometry', ',')+')';
			attribute<km_hr>                        maxspeed           := ='union_data(., '+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads/maxspeed', ',')+')';
			attribute<roadType>                     roadType_rel       := ='union_data(., '+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads/roadType_rel', ',')+')';
			attribute<string>                       OSM_id             := ='union_data(., '+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads/OSM_id', ',')+')';
			attribute<bool>                         IsOneDirection     := ='union_data(., '+asList('Merge_Roads_perCountry/'+OSM_Regios/Countries/name+'/Merge_CountryRegion_Roads/IsOneDirection', ',')+')';
			
		}
	}
	
	#include <NetworkPreperation.dms>

	// The calculation side of the network lies outside the store: the mmd writer refuses every item with DisableStorage under its holder, because
	// everything under the holder belongs to the store (ObjectVision/GeoDMS#1245). Storing these items is no alternative: values is a second copy
	// of the geometry, and AddBikeCongestionSpeeds/Impl is the connect_info with all Fietstelweek dynapoints. Make_Final_Network keeps the name
	// and the store, so that /MakeUnlinkedData/Step1_Sources/OSM_Network and Final_Network keep working unchanged.
	unit<uint32> Final_Network_src := unique(NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/geometry)
	,	Descr = "The calculation side of the final OSM network (not stored); Make_Final_Network writes the attributes to keep from it to the mmd."
	{
		attribute<NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork> ConnectedNetwork_rel    := rlookup(geometry, NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/geometry);
		attribute<rdc>                          geometry (arc) := values;
		attribute<roadType>                      roadType_rel    := NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/roadType_rel[ConnectedNetwork_rel];
		attribute<km_hr>                        maxspeed       := NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/maxspeed[ConnectedNetwork_rel];
		attribute<string>                       OSM_id         := NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/OSM_id[ConnectedNetwork_rel];
		attribute<bool>                         IsOneDirection := NetworkPreperation/Network_with_extraverbindingen/ConnectedNetwork/IsOneDirection[ConnectedNetwork_rel];
		
		attribute<km_hr>                        congestion_speed_bike            := recollect_by_cond(roadType/isPartOfBikeNetwork[roadType_rel], AddBikeCongestionSpeeds/Impl/bike_speed_OSM);
		
		unit<uint32> AddBikeCongestionSpeeds := select_with_org_rel(roadType/isPartOfBikeNetwork[roadType_rel])
		{
			attribute<rdc>                          geometry (arc)                   := ../geometry[org_rel];
			attribute<string>                       OSM_id                           := ../OSM_id[org_rel];
			
			parameter<float64> ConnectSearchDist := 8d*8d;
			
			container Impl := connect_info(geometry, Fietstelweek/DynaPoint/Point, ConnectSearchDist)
			{
				attribute<km_hr> bike_speed_dynapoint  (Fietstelweek/DynaPoint)        := dist[float32] <= ModelParameters/Advanced/Fietstel_OSM_link_dist ? Fietstelweek/DynaPoint/bike_speed : (0/0)[km_hr];
				attribute<km_hr> bike_speed_OSM        (AddBikeCongestionSpeeds)       := mean(bike_speed_dynapoint, ArcID);
			}
		}
	}

	parameter<string> StoreRevision := '_r3'
	,   Descr = "Revision of the network building in the name of the OSM network store; raise it with every change that alters the content of the store, or else the old store is read.";

	unit<uint32> Make_Final_Network := Final_Network_src, Descr = "Writes the final OSM network to the mmd store, whose name holds the OSM date and StoreRevision."
	,   StorageName = "='%LocalDataProjDir%/OSM/Final_Network_'+file_date+StoreRevision+'.mmd'"
	{
		attribute<rdc>                          geometry (arc)        := Final_Network_src/geometry;
		attribute<roadType>                     roadType_rel          := Final_Network_src/roadType_rel;
		attribute<km_hr>                        maxspeed              := Final_Network_src/maxspeed;
		attribute<string>                       OSM_id                := Final_Network_src/OSM_id;
		attribute<bool>                         IsOneDirection        := Final_Network_src/IsOneDirection;
		attribute<km_hr>                        congestion_speed_bike := Final_Network_src/congestion_speed_bike;
	}

	// A read-only mmd reader may not declare sub-items (ObjectVision/GeoDMS#1245): the dictionary of the store defines them (and checks their
	// value types on reading, see 0Dictionary.dms in the mmd). So Read_Final_Network is the bare reader; Final_Network passes on the six stored
	// attributes and adds the derived ones, under the same name and paths, so that Network_Car, Network_Cycling, Network_Walking and the
	// templates stay unchanged.
	unit<uint32> Read_Final_Network
	:   StorageName = "=PropValue(Make_Final_Network, 'StorageName')"
	,   StorageReadOnly = "true"
	,   Descr = "Bare reader of the OSM network store; it declares nothing, the dictionary of the mmd supplies geometry, roadType_rel, maxspeed, OSM_id, IsOneDirection and congestion_speed_bike.";

	unit<uint32> Final_Network := Read_Final_Network, Descr = "The final OSM network as read from the store, with the derived speeds and the flags for the car, cycling and walking networks."
	{
		attribute<rdc>                          geometry (arc)                   := Read_Final_Network/geometry;
		attribute<roadType>                     roadType_rel                     := Read_Final_Network/roadType_rel;
		attribute<km_hr>                        maxspeed                         := Read_Final_Network/maxspeed;
		attribute<string>                       OSM_id                           := Read_Final_Network/OSM_id;
		attribute<bool>                         IsOneDirection                   := Read_Final_Network/IsOneDirection;
		attribute<km_hr>                        congestion_speed_bike            := Read_Final_Network/congestion_speed_bike;
		attribute<string>                       roadType_label                    := roadType/label[roadType_rel];
		attribute<km_hr>                        freeflow_speed_cycling           := const(ModelParameters/CyclingSpeed_kmhr,.);
		attribute<km_hr>                        freeflow_speed_walking           := const(ModelParameters/WalkingSpeed_kmhr,.);
		attribute<km_hr>                        congestion_speed_MorningRush     := const(null_f, ., km_hr); // OSM congestion is not used, but this placeholder keeps all templates working.
		attribute<km_hr>                        congestion_speed_NoonRush        := const(null_f, ., km_hr); // OSM congestion is not used, but this placeholder keeps all templates working.
		attribute<km_hr>                        congestion_speed_LateEveningRush := const(null_f, ., km_hr); // OSM congestion is not used, but this placeholder keeps all templates working.
		
		attribute<bool>                         isPartOfCarNetwork        := roadType/IsPartOfCarNetwork[roadType_rel];
		attribute<bool>                         isPartOfCyclingNetwork    := roadType/isPartOfBikeNetwork[roadType_rel];
		attribute<bool>                         isPartOfWalkingNetwork    := roadType/isPartOfPedestrianNetwork[roadType_rel];
		
		container Connectiveness
		{
			unit<uint32> src := ..;
			attribute<rdc>               point (src)           := first_point(src/geometry);
			attribute<rdc>               nextpoint (src)       := last_point(src/geometry);
			
			unit<uint32> pointset : = union_unit(src,src)
			{
				attribute<rdc>       point       := union_data(., ../point, ../nextpoint);
				attribute<bool>                 isVerbonden := isNull(rlookup(point, NodesNotConnected/point));
				attribute<src>                   ArcNr       := value(ID(.) % #(src), src);
			}
			
			unit<uint32> NodeSet := unique(pointset/point)
			,	DialogData = "Values"
			,	DialogType = "Map"
			{
				attribute<rdc> values;
			}

			attribute<NodeSet> F1 (src) := rlookup(point,     NodeSet/Values);
			attribute<NodeSet> F2 (src) := rlookup(nextpoint, NodeSet/Values);
		
			unit<uint32> networks:= connected_parts(F1, F2) // All networks, including the subnetworks.
			{
				attribute<uint32>   nr_nodes   := sum(const(1, NodeSet, uint32), part_rel);
				parameter<uint32>   MaxNrNodes := max(networks/nr_nodes);
				parameter<networks> main       := rlookup(MaxNrNodes, nr_nodes); // assumption: the network with the most nodes is the relevant network
			}

			unit<uint32> NodesNotConnected := select_with_org_rel(networks/part_rel <> networks/main)
			{
				attribute<Geography/rdc> point := NodeSet/Values[org_rel];
			}
			attribute<bool> isVerbonden (src) := all(pointset/isVerbonden, pointset/ArcNr);
		}
	}

	unit<uint32> Network_Car := select_with_org_rel(Final_Network/isPartOfCarNetwork), Descr = "The OSM links that cars may use, with the attributes that the network templates expect."
	{
		attribute<rdc>                          geometry (arc)                   := Final_Network/geometry[org_rel];
		attribute<roadType>                      roadType_rel                      := Final_Network/roadType_rel[org_rel];
		attribute<string>                       OSM_id                           := Final_Network/OSM_id[org_rel];
		attribute<string>                       roadType_label                    := Final_Network/roadType_label[org_rel];
		attribute<bool>                         IsOneDirection                   := Final_Network/IsOneDirection[org_rel];
		
		attribute<bool>                         Connectable                      := roadType_rel != Classifications/OSM/roadType/V/motorway && roadType_rel != Classifications/OSM/roadType/V/motorway_link;
		attribute<km_hr>                        speed_max_car                    := Final_Network/maxspeed[org_rel];
		attribute<km_hr>                        speed_max_limit_car              := speed_max_car > ModelParameters/Advanced/CarSpeed_limit_kmhr ? ModelParameters/Advanced/CarSpeed_limit_kmhr : speed_max_car;
		attribute<km_hr>                        speed_max_cycling                := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_e_bike                 := const(ModelParameters/Advanced/E_BikingSpeed_kmhr,.);
		attribute<km_hr>                        speed_max_walking                := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_cycling          := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_e_bike           := const((0/0)[km_hr],.);
		// OSM has no congestion: the rush hour speed is the speed limit of the road, capped at the maximum speed of the moment
		// (ModelParameters/Advanced/CongestionTimes/MaxSpeed).
		parameter<km_hr>                        MaxSpeed_MorningRush             := MakeDefined(rjoin('MorningRush', ModelParameters/Advanced/CongestionTimes/name, ModelParameters/Advanced/CongestionTimes/MaxSpeed), 0[km_hr]);
		parameter<km_hr>                        MaxSpeed_NoonRush                := MakeDefined(rjoin('NoonRush', ModelParameters/Advanced/CongestionTimes/name, ModelParameters/Advanced/CongestionTimes/MaxSpeed), 0[km_hr]);
		parameter<km_hr>                        MaxSpeed_LateEveningRush         := MakeDefined(rjoin('LateEveningRush', ModelParameters/Advanced/CongestionTimes/name, ModelParameters/Advanced/CongestionTimes/MaxSpeed), 0[km_hr]);
		attribute<km_hr>                        speed_congested_morning_car      := MakeDefined(Final_Network/congestion_speed_MorningRush[org_rel], MaxSpeed_MorningRush > 0[km_hr] && speed_max_car > MaxSpeed_MorningRush ? MaxSpeed_MorningRush : speed_max_car);
		attribute<km_hr>                        speed_congested_noon_car         := MakeDefined(Final_Network/congestion_speed_NoonRush[org_rel], MaxSpeed_NoonRush > 0[km_hr] && speed_max_car > MaxSpeed_NoonRush ? MaxSpeed_NoonRush : speed_max_car);
		attribute<km_hr>                        speed_congested_late_car         := MakeDefined(Final_Network/congestion_speed_LateEveningRush[org_rel], MaxSpeed_LateEveningRush > 0[km_hr] && speed_max_car > MaxSpeed_LateEveningRush ? MaxSpeed_LateEveningRush : speed_max_car);
		
		unit<uint32> isVerbonden := select_with_attr_by_cond(., Connectiveness/isVerbonden);
		
		container Connectiveness
		{
			unit<uint32> src := ..;
			attribute<Geography/rdc>               point (src)           := first_point(src/geometry);
			attribute<Geography/rdc>               nextpoint (src)       := last_point(src/geometry);
			
			unit<uint32> pointset : = union_unit(src,src)
			{
				attribute<Geography/rdc>       point       := union_data(., ../point, ../nextpoint);
				attribute<bool>                 isVerbonden := isNull(rlookup(point, NodesNotConnected/point));
				attribute<src>                  ArcNr       := value(ID(.) % #(src), src);
			}
			
			unit<uint32> NodeSet := unique(pointset/point)
			,	DialogData = "Values"
			,	DialogType = "Map"
			{
				attribute<Geography/rdc> values;
			}

			attribute<NodeSet> F1 (src) := rlookup(point,     NodeSet/Values);
			attribute<NodeSet> F2 (src) := rlookup(nextpoint, NodeSet/Values);
		
			unit<uint32> networks:= connected_parts(F1, F2) // All networks, including the subnetworks.
			{
				attribute<uint32>   nr_nodes   := sum(const(1, NodeSet, uint32), part_rel);
				parameter<uint32>   MaxNrNodes := max(networks/nr_nodes);
				parameter<networks> main       := rlookup(MaxNrNodes, nr_nodes); // assumption: the network with the most nodes is the relevant network
			}

			unit<uint32> NodesNotConnected := select_with_org_rel(networks/part_rel <> networks/main)
			{
				attribute<Geography/rdc> point := NodeSet/Values[org_rel];
			}
			attribute<bool> isVerbonden (src) := all(pointset/isVerbonden, pointset/ArcNr);
		}
	}
	unit<uint32> Network_Cycling := select_with_org_rel(Final_Network/isPartOfCyclingNetwork), Descr = "The OSM links that cyclists may use, with the Fietstelweek speed as the congested cycling speed."
	{
		attribute<rdc>                          geometry (arc)                   := Final_Network/geometry[org_rel];
		attribute<classifications/OSM/roadType>  roadType_rel                      := Final_Network/roadType_rel[org_rel];
		attribute<string>                       OSM_id                           := Final_Network/OSM_id[org_rel];
		attribute<string>                       roadType_label                    := Final_Network/roadType_label[org_rel];
		attribute<bool>                         IsOneDirection                   := const(FALSE,.);
		attribute<bool>                         Connectable                      := roadType_rel != Classifications/OSM/roadType/V/motorway && roadType_rel != Classifications/OSM/roadType/V/motorway_link;
		
		attribute<km_hr>                        speed_max_car                    := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_limit_car              := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_cycling                := Final_Network/freeflow_speed_cycling[org_rel];
		attribute<km_hr>                        speed_max_e_bike                 := const(ModelParameters/Advanced/E_BikingSpeed_kmhr,.);
		attribute<km_hr>                        speed_max_walking                := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_cycling          := Final_Network/congestion_speed_bike[org_rel];
		attribute<km_hr>                        speed_congested_e_bike           := speed_congested_cycling + ModelParameters/Advanced/E_BikingSpeed_actualspeed_addition_kmhr;
		attribute<km_hr>                        speed_congested_morning_car      := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_noon_car         := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_late_car         := const((0/0)[km_hr],.);
		
		unit<uint32> isVerbonden := select_with_attr_by_cond(., Connectiveness/isVerbonden);
		
		container Connectiveness
		{
			unit<uint32> src := ..;
			attribute<Geography/rdc>               point (src)           := first_point(src/geometry);
			attribute<Geography/rdc>               nextpoint (src)       := last_point(src/geometry);
			
			unit<uint32> pointset : = union_unit(src,src)
			{
				attribute<Geography/rdc>       point       := union_data(., ../point, ../nextpoint);
				attribute<bool>                 isVerbonden := isNull(rlookup(point, NodesNotConnected/point));
				attribute<src>                   ArcNr       := value(ID(.) % #(src), src);
			}
			
			unit<uint32> NodeSet := unique(pointset/point)
			,	DialogData = "Values"
			,	DialogType = "Map"
			{
				attribute<Geography/rdc> values;
			}

			attribute<NodeSet> F1 (src) := rlookup(point,     NodeSet/Values);
			attribute<NodeSet> F2 (src) := rlookup(nextpoint, NodeSet/Values);
		
			unit<uint32> networks:= connected_parts(F1, F2) // All networks, including the subnetworks.
			{
				attribute<uint32>   nr_nodes   := sum(const(1, NodeSet, uint32), part_rel);
				parameter<uint32>   MaxNrNodes := max(networks/nr_nodes);
				parameter<networks> main       := rlookup(MaxNrNodes, nr_nodes); // assumption: the network with the most nodes is the relevant network
			}

			unit<uint32> NodesNotConnected := select_with_org_rel(networks/part_rel <> networks/main)
			{
				attribute<Geography/rdc> point := NodeSet/Values[org_rel];
			}
			attribute<bool> isVerbonden (src) := all(pointset/isVerbonden, pointset/ArcNr);
		}
	}
	unit<uint32> Network_Walking := select_with_org_rel(Final_Network/isPartOfWalkingNetwork), Descr = "The OSM links that pedestrians may use."
	{
		attribute<rdc>                          geometry (arc)                   := Final_Network/geometry[org_rel];
		attribute<classifications/OSM/roadType> roadType_rel                     := Final_Network/roadType_rel[org_rel];
		attribute<string>                       OSM_id                           := Final_Network/OSM_id[org_rel];
		attribute<string>                       roadType_label                   := Final_Network/roadType_label[org_rel];
		attribute<bool>                         IsOneDirection                   := const(FALSE,.);

		attribute<bool>                         Connectable                      := roadType_rel != Classifications/OSM/roadType/V/motorway && roadType_rel != Classifications/OSM/roadType/V/motorway_link;
		attribute<km_hr>                        speed_max_car                    := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_limit_car              := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_cycling                := const((0/0)[km_hr],.);
		attribute<km_hr>                        Speed_max_e_bike                 := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_max_walking                := Final_Network/freeflow_speed_walking[org_rel];
		attribute<km_hr>                        speed_congested_cycling          := const((0/0)[km_hr],.);
		attribute<km_hr>                        Speed_congested_e_bike           := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_morning_car      := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_noon_car         := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_late_car         := const((0/0)[km_hr],.);
		attribute<km_hr>                        speed_congested_pedestrian       := const((0/0)[km_hr],.);
		
		unit<uint32> isVerbonden := select_with_attr_by_cond(., Connectiveness/isVerbonden);	
		
		container Connectiveness
		{
			unit<uint32> src := ..;
			attribute<Geography/rdc>               point (src)           := first_point(src/geometry);
			attribute<Geography/rdc>               nextpoint (src)       := last_point(src/geometry);
			
			unit<uint32> pointset : = union_unit(src,src)
			{
				attribute<Geography/rdc>       point       := union_data(., ../point, ../nextpoint);
				attribute<bool>                 isVerbonden := isNull(rlookup(point, NodesNotConnected/point));
				attribute<src>                   ArcNr       := value(ID(.) % #(src), src);
			}
			
			unit<uint32> NodeSet := unique(pointset/point)
			,	DialogData = "Values"
			,	DialogType = "Map"
			{
				attribute<Geography/rdc> values;
			}

			attribute<NodeSet> F1 (src) := rlookup(point,     NodeSet/Values);
			attribute<NodeSet> F2 (src) := rlookup(nextpoint, NodeSet/Values);
		
			unit<uint32> networks:= connected_parts(F1, F2) // All networks, including the subnetworks.
			{
				attribute<uint32>   nr_nodes   := sum(const(1, NodeSet, uint32), part_rel);
				parameter<uint32>   MaxNrNodes := max(networks/nr_nodes);
				parameter<networks> main       := rlookup(MaxNrNodes, nr_nodes); // assumption: the network with the most nodes is the relevant network
			}

			unit<uint32> NodesNotConnected := select_with_org_rel(networks/part_rel <> networks/main)
			{
				attribute<Geography/rdc> point := NodeSet/Values[org_rel];
			}
			attribute<bool> isVerbonden (src) := all(pointset/isVerbonden, pointset/ArcNr);
		}
	}
	
	container OSM_Netwerken_Export 
	{
		parameter<string> Generate := Car/Generate + Cycling/Generate + Walking/Generate;
		
		container Car        := Write2Gpkg_T(Network_Car, 'Car')
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "Network"; 
		}
		container Cycling       := Write2Gpkg_T(Network_Cycling, 'Cycling')
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "Network"; 
		}
		container Walking := Write2Gpkg_T(Network_Walking, 'Walking')
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "Network"; 
		}
	
		Template Write2Gpkg_T
		{
			unit<uint32>      domain;
			parameter<string> Mode;
			
			unit<uint32> Network := domain
			, StorageName = "='%LocalDataProjDir%/OSM/'+Mode+'_network_'+file_date+'.gpkg'"
			, StorageType = "gdalwrite.vect" 
			{
				attribute<Geography/rdc>               geometry (arc)      := domain/geometry;
				attribute<string>                       OSM_id              := domain/OSM_id;
				attribute<classifications/OSM/roadType>  roadType_rel         := domain/roadType_rel;
				attribute<string>                       roadType_label       := domain/roadType_label;
				attribute<km_hr>                        car_freeflow        := domain/speed_max_car;
				attribute<km_hr>                        cycling_freeflow    := domain/speed_max_cycling;
				attribute<km_hr>                        walking_freeflow    := domain/speed_max_walking;
				attribute<km_hr>                        cs_bike             := domain/speed_congested_cycling;
				attribute<km_hr>                        cs_morning          := domain/speed_congested_morning_car;
				attribute<km_hr>                        cs_noon             := domain/speed_congested_noon_car;
				attribute<km_hr>                        cs_evening          := domain/speed_congested_late_car;
			}
			
		}
	}
}
