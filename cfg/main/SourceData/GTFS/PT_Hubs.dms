// There is no legal definition of a public transport hub. This operationalisation follows the common frameworks:
// - Actieagenda OV-knooppunten / Toekomstbeeld OV 2040: all train stations plus the main urban and regional HOV hubs (high-quality public transport);
// - Nationale Standaard invloedsgebieden OV-knooppunten (Goudappel and the Ministry of IenW, February 2024): types A and B (large stations),
//   C (train station, metro stop, HOV hub) and D (HOV stop);
// - the butterfly model (vlindermodel) of Vereniging Deltametropool: network value = connection value + access value, with
//   access value = frequency per hour x directions x 0.2 x mode score.
// In practice:
// (1) stops are clustered spatially into hub candidates, and hubs outside the Netherlands drop out;
// (2) each cluster with a train is a hub, typed after the NS station typology (Trein_IC versus Trein), so that light stations (Assendelft)
//     can be recognised and weighted separately;
// (3) a cluster without a train is a hub when its number of unique bus, tram and metro lines, its number of BTM departures per day and its
//     number of departure directions (sectors) all exceed a threshold (see ModelParameters/Advanced); the direction criterion keeps out corridor
//     bundles (R-net along one axis) that count many lines but are no transfer point. So metro stops are not hubs by themselves: a single metro
//     stop on a corridor is a stop of a high-quality line, not a bundling with transfers (the CROW core). Metro hubs with crossing lines or a
//     bus station (Beurs, Noord, Zuidplein) pass the combined threshold anyway;
// (4) dominance filter: a BTM candidate drops out when a stronger hub lies within Hub_DominanceRadius, against strings of hubs along
//     corridors and several points per complex;
// (5) a network value after the butterfly model is added as an attribute, so that users can choose another threshold themselves.
// Simplifications against the butterfly model: the number of directions is not determined separately (the departures already count both
// directions), and trains are not split into HSL, IC and sprinter.
container PT_Hubs : using = "RelevantSelection"
, Descr = "Public transport hubs derived from the GTFS timetable of Analysis_date: clusters of nearby stops that have a train or pass thresholds on bus, tram and metro lines, departures and directions, with their type and network value, for use as a regional location variable such as the travel time to the nearest hub (Redevelopment repository, issue #18)."
{
	//// Mode scores, an approximation of butterfly model 2.1 (HSL 125 points ... feeder bus or tram 25 points; Goudappel 2024 uses 25 points for all buses)
	parameter<float32>     Score_Train                 := 100f, Descr = "Score per train departure; HSL, IC and sprinter are not distinguished, because route_type in the Dutch GTFS does not tell them apart.";
	parameter<float32>     Score_Metro                 := 60f;
	parameter<float32>     Score_Tram                  := 25f;
	parameter<float32>     Score_Bus                   := 25f;
	parameter<float32>     Score_Ferry                 := 25f;

	unit<uint8> HubTypes : nrofrows = 4
	, Descr = "Type per hub, where train goes before BTM (bus, tram, metro); Trein_IC follows the NS station typology ((hub) intercity or mega station) from the train station shapefile, so that users can weight stations by importance."
	{
		attribute<string> name  : ['Trein_IC','Trein','BTM_knooppunt','Geen'];
		attribute<string> label := name;
		container         V     := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}

	//// Helper attributes at the level of stops and stop_times
	attribute<bool>        DepartsToday    (StopTimes) := StopTimes/SelToday && IsDefined(StopTimes/Stop_rel), Descr = "Stop events on Analysis_date at a used stop.";
	attribute<Routes>      Route_rel       (StopTimes) := Trips/Route_rel[StopTimes/Trip_rel];
	attribute<bool>        IsBTM           (StopTimes) := StopTimes/Mode_rel == Modes/V/bus || StopTimes/Mode_rel == Modes/V/tram || StopTimes/Mode_rel == Modes/V/metro;
	attribute<bool>        DepartsTodayBTM (StopTimes) := DepartsToday && IsBTM;
	attribute<HubClusters> HubCluster_rel  (StopTimes) := HubClusters/PartNr[StopTimes/Stop_rel];

	//// Departure direction: the sector (E/W/N/S) of the trip to the next stop; it operationalises the 'number of directions' of the butterfly model
	attribute<bool>        HasNextStop     (StopTimes) := IsDefined(StopTimes/NextRawStop_rel);
	attribute<float64>     DirectiondX     (StopTimes) := pointcol(LoadFeeds/RawStops/geometry[StopTimes/NextRawStop_rel]) - pointcol(LoadFeeds/RawStops/geometry[StopTimes/RawStop_rel]);
	attribute<float64>     DirectiondY     (StopTimes) := pointrow(LoadFeeds/RawStops/geometry[StopTimes/NextRawStop_rel]) - pointrow(LoadFeeds/RawStops/geometry[StopTimes/RawStop_rel]);
	attribute<uint32>      DirectionSector (StopTimes) := abs(DirectiondX) >= abs(DirectiondY)
	                                                      ? (DirectiondX > 0d ? 0 : 1)
	                                                      : (DirectiondY > 0d ? 2 : 3);
	attribute<bool>        DepartsTodayBTM_WithDirection (StopTimes) := DepartsTodayBTM && HasNextStop;

	attribute<uint32>      NrDeparturesToday   (Stops) := sum_uint32(DepartsToday, StopTimes/Stop_rel);

	//// Step 1: cluster the stops into hub candidates (single linkage within DistanceHubClusters)
	// Stops also holds stops that only the trips of the previous day after midnight or of the next day use. They do not count in the clustering:
	// a hub describes the timetable of Analysis_date, and such a stop could connect two clusters.
	attribute<bool>        StopToday           (Stops) := NrDeparturesToday > 0, Descr = "A stop with a stop event on Analysis_date.";
	unit<uint32>           NearbyStopPairs_all         := join_near_values(Stops/geometry, Stops/geometry, float64(ModelParameters/Advanced/DistanceHubClusters));
	unit<uint32> NearbyStopPairs := select_with_org_rel(StopToday[NearbyStopPairs_all/first_rel] && StopToday[NearbyStopPairs_all/second_rel])
	, Descr = "All pairs of stops with departures on Analysis_date within the cluster distance; input for connected_parts."
	{
		attribute<Stops> first_rel  := NearbyStopPairs_all/first_rel[org_rel];
		attribute<Stops> second_rel := NearbyStopPairs_all/second_rel[org_rel];
	}

	unit<uint32> HubClusters := connected_parts(NearbyStopPairs/first_rel, NearbyStopPairs/second_rel)
	, Descr = "Stop clusters: each connected group of stops is a hub candidate, and the sub-item PartNr relates each stop to its cluster."
	{
		attribute<Stops>    MainStop_rel       := max_index(NrDeparturesToday, PartNr), Descr = "The busiest stop of the cluster, which gives its name and geometry.";
		attribute<rdc>      geometry           := Stops/geometry[MainStop_rel];
		attribute<string>   ClusterName        := Stops/Name[MainStop_rel];
		attribute<uint32>   NrStops            := pcount(PartNr);
		attribute<string>   Label              := ClusterName;

		attribute<uint32>   NrDepartures_Train := sum_uint32(DepartsToday && StopTimes/Mode_rel == Modes/V/rail , HubCluster_rel);
		attribute<uint32>   NrDepartures_Metro := sum_uint32(DepartsToday && StopTimes/Mode_rel == Modes/V/metro, HubCluster_rel);
		attribute<uint32>   NrDepartures_Tram  := sum_uint32(DepartsToday && StopTimes/Mode_rel == Modes/V/tram , HubCluster_rel);
		attribute<uint32>   NrDepartures_Bus   := sum_uint32(DepartsToday && StopTimes/Mode_rel == Modes/V/bus  , HubCluster_rel);
		attribute<uint32>   NrDepartures_Ferry := sum_uint32(DepartsToday && StopTimes/Mode_rel == Modes/V/ferry, HubCluster_rel);
		attribute<uint32>   NrDepartures_BTM   := NrDepartures_Tram + NrDepartures_Bus + NrDepartures_Metro;
		attribute<uint32>   NrDepartures       := NrDepartures_Train + NrDepartures_BTM + NrDepartures_Ferry;

		attribute<uint32>   NrLines_BTM        := pcount(uq_HubRouteBTM/HubCluster_rel), Descr = "Number of unique bus, tram and metro lines (route_ids) that serve the cluster on Analysis_date.";
		attribute<uint32>   NrDirections_BTM   := pcount(uq_HubSectorBTM/HubCluster_rel), Descr = "Number of compass directions (at most 4) in which BTM departures leave the cluster: 2 for a corridor bundle, 3 or 4 for a crossing or fanning-out hub.";

		//// Steps 2 and 3: selection of the hubs
		attribute<bool>     HasTrain           := NrDepartures_Train > 0;
		attribute<bool>     HasMetro           := NrDepartures_Metro > 0;
		attribute<bool>     IsBTM_Hub          := NrLines_BTM     >= ModelParameters/Advanced/Hub_MinLines_BTM
		                                          && NrDepartures_BTM >= ModelParameters/Advanced/Hub_MinDepartures_BTM
		                                          && NrDirections_BTM >= ModelParameters/Advanced/Hub_MinDirections_BTM
		                                          && Netwerkwaarde    >= ModelParameters/Advanced/Hub_MinNetworkValue_BTM;
		attribute<bool>     IsCandidate        := HasTrain || IsBTM_Hub, Descr = "Passes the thresholds; it becomes a hub only after the dominance filter (see Candidates).";

		//// IC typing through the NS station typology (link to the train station shapefile within DistanceTrainStationsSelection)
		unit<uint32> ICLink := join_near_values(geometry, /SourceData/Infrastructure/Infrastructure/Trainstations/geometry, float64(ModelParameters/Advanced/DistanceTrainStationsSelection))
		{
			attribute<bool> IsIC := /SourceData/Infrastructure/Infrastructure/Trainstations/IsIC[second_rel];
		}
		attribute<bool>     HasICStation       := HasTrain && MakeDefined(any(ICLink/IsIC, ICLink/first_rel), false);

		attribute<HubTypes> Type_rel           := switch(
		                                               case(HasICStation , HubTypes/V/Trein_IC)
		                                              ,case(HasTrain     , HubTypes/V/Trein)
		                                              ,case(IsBTM_Hub, HubTypes/V/BTM_knooppunt)
		                                              ,HubTypes/V/Geen
		                                          );

		//// Step 4: network value after the butterfly model (approximation)
		attribute<float32>  Verbindingswaarde  := (HasTrain             ? Score_Train : 0f)
		                                          + (HasMetro             ? Score_Metro : 0f)
		                                          + (NrDepartures_Tram  > 0 ? Score_Tram  : 0f)
		                                          + (NrDepartures_Bus   > 0 ? Score_Bus   : 0f)
		                                          + (NrDepartures_Ferry > 0 ? Score_Ferry : 0f);
		attribute<float32>  Ontsluitingswaarde := 0.2f *
		                                          (	  float32(NrDepartures_Train) * Score_Train
		                                              + float32(NrDepartures_Metro) * Score_Metro
		                                              + float32(NrDepartures_Tram)  * Score_Tram
		                                              + float32(NrDepartures_Bus)   * Score_Bus
		                                              + float32(NrDepartures_Ferry) * Score_Ferry
		                                          ) / ModelParameters/Advanced/Hub_OperatingHoursPerDay
												, Descr = "0.2 x frequency per hour x mode score, summed over the modes, where the departures per day in both directions divided by the operating hours approximate frequency x directions.";
		attribute<float32>  Netwerkwaarde      := Verbindingswaarde + Ontsluitingswaarde;
	}

	//// Unique combinations of hub and line for the line threshold
	unit<uint32> BTM_Departures := select_with_org_rel(DepartsTodayBTM)
	{
		attribute<upoint> HubRoute := point_xy(uint32(Route_rel[org_rel]), uint32(HubCluster_rel[org_rel]), upoint);
	}
	unit<uint32> uq_HubRouteBTM := unique(BTM_Departures/HubRoute)
	{
		attribute<HubClusters> HubCluster_rel := pointRow(Values)[HubClusters];
	}

	//// Unique combinations of hub and departure sector for the direction criterion
	unit<uint32> BTM_DeparturesWithDirection := select_with_org_rel(DepartsTodayBTM_WithDirection)
	{
		attribute<upoint> HubSector := point_xy(DirectionSector[org_rel], uint32(HubCluster_rel[org_rel]), upoint);
	}
	unit<uint32> uq_HubSectorBTM := unique(BTM_DeparturesWithDirection/HubSector)
	{
		attribute<HubClusters> HubCluster_rel := pointRow(Values)[HubClusters];
	}

	//// Dominance filter: a BTM candidate drops out when a stronger candidate (a train, or a higher network value) lies within Hub_DominanceRadius.
	//// This prevents strings of hubs along HOV corridors and several points per large complex (Schiphol); train stations never drop out.
	unit<uint32> Candidates := select_with_org_rel(HubClusters/IsCandidate)
	{
		attribute<rdc>     geometry             := HubClusters/geometry[org_rel];
		attribute<float32> Netwerkwaarde        := HubClusters/Netwerkwaarde[org_rel];
		attribute<bool>    HasTrain             := HubClusters/HasTrain[org_rel];
		attribute<uint32>  NrDepartures_Train   := HubClusters/NrDepartures_Train[org_rel];
		attribute<bool>    IsInNL               := IsDefined(point_in_polygon(geometry, /SourceData/RegioIndelingen/Provincie/geometry)), Descr = "The GTFS feed also holds foreign public transport (De Lijn, border stations, international trains), and all hubs outside the Netherlands drop out.";

		unit<uint32> NearbyPairs := join_near_values(geometry, geometry, float64(ModelParameters/Advanced/Hub_DominanceRadius))
		{
			attribute<float64> DistanceSqr              := sqr(pointcol(../geometry[second_rel]) - pointcol(../geometry[first_rel]))
			                                               + sqr(pointrow(../geometry[second_rel]) - pointrow(../geometry[first_rel]));

			//// A BTM candidate drops out for every candidate with a higher network value within the dominance radius.
			//// Deliberately on network value and not 'the train always wins': a strong bus hub next to a weak station (Zoetermeer Centrum West, Zuidplein) must stay.
			attribute<bool>    NeighbourIsStronger      := !../HasTrain[first_rel]
			                                               && (	../Netwerkwaarde[second_rel] >  ../Netwerkwaarde[first_rel]
			                                                   || (../Netwerkwaarde[second_rel] == ../Netwerkwaarde[first_rel] && second_rel < first_rel)
			                                                   );
			//// A train cluster drops out only for a train cluster with more train departures within the (smaller) deduplication radius: platform and square clusters of one station.
			attribute<bool>    TrainNeighbourIsStronger := ../HasTrain[first_rel] && ../HasTrain[second_rel]
			                                               && DistanceSqr <= sqr(float64(ModelParameters/Advanced/Hub_DedupRadiusTrain))
			                                               && (	../NrDepartures_Train[second_rel] >  ../NrDepartures_Train[first_rel]
			                                                   || (../NrDepartures_Train[second_rel] == ../NrDepartures_Train[first_rel] && second_rel < first_rel)
			                                                   );
		}
		attribute<bool>    HasStrongerNeighbour := any(NearbyPairs/NeighbourIsStronger || NearbyPairs/TrainNeighbourIsStronger, NearbyPairs/first_rel);
		attribute<bool>    IsDominant           := IsInNL && !HasStrongerNeighbour;
	}
	attribute<bool>        IsHub         (HubClusters) := HubClusters/IsCandidate && MakeDefined(Candidates/IsDominant[invert(Candidates/org_rel)], false);

	//// Export: a point file with all hubs
	unit<uint32> Export_Knooppunten := select_with_org_rel(IsHub)
	, StorageName = "='%LocalDataProjDir%/Output/OV_knooppunten_'+ModelParameters/Impl/GTFS_file_date+'.gpkg'"
	, StorageType = "gdalwrite.vect"
	, Descr = "Public transport hubs as a point file (RD New), for example for accessibility analyses such as the travel time to the nearest hub."
	{
		attribute<rdc>     geometry           := HubClusters/geometry[org_rel];
		attribute<string>  name               := HubClusters/ClusterName[org_rel];
		attribute<string>  label              := HubClusters/ClusterName[org_rel];
		attribute<string>  type               := HubTypes/name[HubClusters/Type_rel[org_rel]];
		attribute<uint32>  nr_stops           := HubClusters/NrStops[org_rel];
		attribute<uint32>  vertrekken_trein   := HubClusters/NrDepartures_Train[org_rel];
		attribute<uint32>  vertrekken_metro   := HubClusters/NrDepartures_Metro[org_rel];
		attribute<uint32>  vertrekken_tram    := HubClusters/NrDepartures_Tram[org_rel];
		attribute<uint32>  vertrekken_bus     := HubClusters/NrDepartures_Bus[org_rel];
		attribute<uint32>  vertrekken_totaal  := HubClusters/NrDepartures[org_rel];
		attribute<uint32>  lijnen_btm         := HubClusters/NrLines_BTM[org_rel];
		attribute<uint32>  richtingen_btm     := HubClusters/NrDirections_BTM[org_rel];
		attribute<float32> verbindingswaarde  := HubClusters/Verbindingswaarde[org_rel];
		attribute<float32> ontsluitingswaarde := HubClusters/Ontsluitingswaarde[org_rel];
		attribute<float32> netwerkwaarde      := HubClusters/Netwerkwaarde[org_rel];
	}

	container Accessibility_Car
	: Descr = "Travel time by car over the OSM network to the nearest public transport hub, for every 100 m cell on Dutch land and written as a 25 m tif, as a regional location variable replacing tt_Trainstation_2006 (Redevelopment repository, issue #18): a Dijkstra from all hub nodes at once gives each network node its travel time to the nearest hub, and each cell takes that of its node."
	{

			//// Covering origin set: all 100 m cell centres on Dutch land (province land mask through poly2grid; deliberately not perGridsize/points, which depends on the broken geos_union_polygon NL item).
			attribute<bool>    InNL                   (rdc_100m) := IsDefined(/SourceData/RegioIndelingen/Provincie/per_rdc_100m);
			unit<uint32> Org_100m := select_with_org_rel(InNL)
			{
				attribute<rdc>      geometry := Geography/perGridsize/size_100m/domain/geometry[org_rel];
				attribute<rdc_100m> grid_rel := org_rel;
			}

			//// An own network instance with the grid points as origins and the hubs as destinations (independent of ModelParameters/Orgset and Destset).
			container          CarNetwork                        := Templates/CreateNetwork_Efficient_T(Org_100m, Export_Knooppunten, SourceData/Infrastructure/OSM/Network_Car/MainNetwork, 'car', FALSE);
			unit<uint32>       LinkSet                           := CarNetwork/CreateMoreEfficientNetwork/FinalLinkSet;
			unit<uint32> NodeSet := CarNetwork/CreateMoreEfficientNetwork/FinalNodeSet
			{
				attribute<.> OrgNode_rel            (Org_100m) := rlookup(Org_100m/geometry, geometry);
				attribute<.> DestNode_rel (Export_Knooppunten) := rlookup(Export_Knooppunten/geometry, geometry);
			}

			attribute<min_f>   Traveltime_node         (NodeSet) :=
				convert(
					impedance_table(
						  'bidirectional;startPoint(Node_rel);cut(OrgZone_max_imp)'
						, LinkSet/Impedance_per_ImpedanceType/max_limit_car
						, LinkSet/F1
						, LinkSet/F2
						, NodeSet/DestNode_rel
						, convert(ModelParameters/MaxCarTime, s_f)
					)
				, min_f)
			, Descr = "Deliberately undirected (one-way traffic ignored): this prevents unreachable pockets behind one-way links (industrial estates, ports), and for a regional travel time proxy the error is negligible.";

			attribute<min_f>   Traveltime_org         (Org_100m) := Traveltime_node[NodeSet/OrgNode_rel];
			attribute<min_f>   Traveltime_100m        (rdc_100m) := Traveltime_org[invert(Org_100m/grid_rel)];

			container Diag_NullCells
			: Descr = "Diagnosis of origin points without a travel time: no network node found (rlookup), or the node not reached by the Dijkstra (an unreachable subcomponent, or beyond MaxCarTime)."
			{
				parameter<uint32> n_org                  := #Org_100m;
				parameter<uint32> n_orgnode_null         := sum(uint32(!IsDefined(NodeSet/OrgNode_rel)));
				parameter<uint32> n_traveltime_org_null  := sum(uint32(!IsDefined(Traveltime_org)));
				parameter<uint32> n_nodes                := #NodeSet;
				parameter<uint32> n_node_traveltime_null := sum(uint32(!IsDefined(Traveltime_node)));

				parameter<string> Summary                := 'orgs: '+string(n_org)
				                                            + '; orgs zonder node: '+string(n_orgnode_null)
				                                            + '; orgs zonder reistijd: '+string(n_traveltime_org_null)
				                                            + '; nodes: '+string(n_nodes)
				                                            + '; nodes zonder reistijd: '+string(n_node_traveltime_null)
				, StorageName = "='%LocalDataProjDir%/Output/diag_ovknoop_nullcellen.txt'", StorageType = "str";

				unit<uint32> NullOrgs := select_with_org_rel(!IsDefined(Traveltime_org))
				, StorageName = "='%LocalDataProjDir%/Output/diag_ovknoop_nullorgs.gpkg'", StorageType = "gdalwrite.vect"
				{
					attribute<rdc>  geometry      := Org_100m/geometry[org_rel];
					attribute<bool> node_gevonden := IsDefined(NodeSet/OrgNode_rel[org_rel]);
				}
			}

			//// Safety net: 100 m cells that stay empty after the network calculation (loose network components) get a 2 km potential mean of the surrounding filled cells.
			//// Only within the Netherlands; salt marshes and islands without a road within 2 km rightly stay null (no car travel time possible).
			attribute<float32> Pot_sum                (rdc_100m) := potential(MakeDefined(Traveltime_100m[float32], 0f), Distmatrices_100m/pot2000m/rev_dist_scaled[float32]);
			attribute<float32> Pot_n                  (rdc_100m) := potential(IsDefined(Traveltime_100m) ? 1f : 0f,      Distmatrices_100m/pot2000m/rev_dist_scaled[float32]);
			attribute<min_f>   Traveltime_100m_filled (rdc_100m) := MakeDefined(Traveltime_100m, InNL && Pot_n > 0f ? convert(Pot_sum / Pot_n, min_f) : (0/0)[min_f]);

			//// 100 m -> 25 m: each 25 m cell gets the value of its 100 m cell (direct grid-to-grid mapping).
			attribute<min_f>   Traveltime_25m          (rdc_25m) := Traveltime_100m_filled[Geography/perGridsize/size_25m/domain/rdc_100m_rel]
			, StorageName = "='%LocalDataProjDir%/Output/TraveltimeToNearest_OV_Knooppunten_'+ModelParameters/Impl/GTFS_file_date+'_rdc25m.tif'"
			, StorageType = "gdalwrite.grid"
			, Descr = "Travel time (min) by car to the nearest public transport hub, per 25 m cell, covering the Netherlands.";
	}
}
