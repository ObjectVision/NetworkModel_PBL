container LoadFeeds
: Descr = "Load data from GTFS-files"
{ 
	parameter<bool>              Write_All     := True, ExplicitSuppliers = "= asList('Write/'+File_Structure/CacheName+'/data',';')";
	
	unit<uint32>                 File_Structure   : NrOfRows = 8
	{
		attribute<string> Name: ['agency','calendar','calendar_dates','routes','shapes','stop_times','stops','trips'];
		attribute<string> CacheName: ['agency','Calendar','Calendar_dates','Routes','Shapes','Stop_times','Stops','Trips']
		,	Descr = "The name of the table in the mmd cache, in the spelling with which the rest of the configuration reads it (Read/Stop_times, Read/Shapes and so on); Name is the file name of the csv and stays lower case.";
	}
	
	unit<uint32>                 Attribute_Structure   : NrOfRows = 32
	{
		attribute<string> Name: ['agency_name','agency_id','stop_id','stop_lat','stop_lon','stop_name','route_id','route_type','route_short_name','route_long_name','trip_id','route_id','service_id','stop_sequence','departure_time','arrival_time','monday','tuesday','wednesday','thursday','friday','saturday','sunday','start_date','end_date','date','exception_type', 'shape_id', 'shape_pt_sequence', 'shape_pt_lat', 'shape_pt_lon', 'shape_dist_traveled'];
	}
	
	container Load := 
		for_each_ne(
			File_Structure/Name
			, 'LoadCSVThroughGDAL_T(File_Structure,'+string(id(File_Structure))+')'
		);
		
	Template LoadCSVThroughGDAL_T
	{
		unit<uint32> File_Structure;
		parameter<File_Structure> inFile;
		//
		
		unit<uint32> ReadCSV
		: StorageName     = "= '%NetworkModel_dir%/Infrastructuur/GTFS/'+ModelParameters/Impl/GTFS_file_date+'/'+File_Structure/Name[inFile]+'.csv'"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> CSV_attributes := SubItem_PropValues(ReadCSV,'name');
	}

	// The cache holder holds only domain and data per table. That is no style choice: the mmd writer refuses every item with DisableStorage
	// under its holder (ObjectVision/GeoDMS#1245), and a template cannot keep its case parameters outside the instantiation. So the reading
	// happens in Load, outside the holder, and the tables refer to it directly.
	//
	// A holder that refers to a container outside itself (container Write := <other container>, or a meta-scripted reference per table name)
	// writes nothing and does not report it: the sub-items of a referenced container are engine shadows, which the writer skips, and the run
	// ends with exit 0 without a cache. Hence the eight explicit blocks; the table names are also in File_Structure/CacheName above.
	container Write
	:	StorageName = "= '%NetworkModel_dir%/Infrastructuur/GTFS/'+ModelParameters/Impl/GTFS_file_date+'.mmd'"
	{
		container agency
		{
			unit<uint32>   domain := Load/agency/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/agency/CSV_attributes/name
					, 'Load/agency/ReadCSV/' + Load/agency/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Calendar
		{
			unit<uint32>   domain := Load/calendar/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/calendar/CSV_attributes/name
					, 'Load/calendar/ReadCSV/' + Load/calendar/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Calendar_dates
		{
			unit<uint32>   domain := Load/calendar_dates/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/calendar_dates/CSV_attributes/name
					, 'Load/calendar_dates/ReadCSV/' + Load/calendar_dates/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Routes
		{
			unit<uint32>   domain := Load/routes/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/routes/CSV_attributes/name
					, 'Load/routes/ReadCSV/' + Load/routes/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Shapes
		{
			unit<uint32>   domain := Load/shapes/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/shapes/CSV_attributes/name
					, 'Load/shapes/ReadCSV/' + Load/shapes/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Stop_times
		{
			unit<uint32>   domain := Load/stop_times/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/stop_times/CSV_attributes/name
					, 'Load/stop_times/ReadCSV/' + Load/stop_times/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Stops
		{
			unit<uint32>   domain := Load/stops/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/stops/CSV_attributes/name
					, 'Load/stops/ReadCSV/' + Load/stops/CSV_attributes/name
					, domain
					, string
				);
		}
		
		container Trips
		{
			unit<uint32>   domain := Load/trips/ReadCSV;
			container data :=
				for_each_nedv(
					  Load/trips/CSV_attributes/name
					, 'Load/trips/ReadCSV/' + Load/trips/CSV_attributes/name
					, domain
					, string
				);
		}
		
	}
		
	container Read 
	: StorageName = "= '%NetworkModel_dir%/Infrastructuur/GTFS/'+ModelParameters/Impl/GTFS_file_date+'.mmd'"
	, StorageReadOnly = "true";
		
	unit<uint32> Calendar_dates := Read/Calendar_dates/domain  
	, Descr = "Exceptions for the services defined in the calendar.txt."
	{
		attribute<uint32>   nDate       := uint32(Read/Calendar_dates/data/date), Descr = "Date when service exception occurs";
		attribute<uint32>   nType       := uint32(Read/Calendar_dates/data/exception_type), Descr = "exception_type = 1 -> Service has been added for the specified date; exception_type = 2 -> Service has been removed for the specified date.";
		attribute<Services> Services_rel := rlookup(Read/Calendar_dates/data/service_id, Services/Values), Descr = "Identifies a set of dates when a service exception occurs for one or more routes.";
		// The service days come from ServiceDays, which derives them from a day number, so that the day before the first of a month is a real date.
		attribute<uint32>   Today       := uint32(ServiceDays/Today_date     = nDate);
		attribute<uint32>   Yesterday   := uint32(ServiceDays/Yesterday_date = nDate);
		attribute<uint32>   Tomorrow    := uint32(ServiceDays/Tomorrow_date  = nDate);
		attribute<CalendarDates> CalendarDate_rel := rlookup(nDate, CalendarDates/values);
	}

	unit<uint32> CalendarDates := unique(Calendar_dates/nDate)
	, Descr = "The dates in calendar_dates, with the number of trips per date and the busiest date per weekday, for the check in ServiceDays."
	{
		attribute<uint32>   yyyymmdd              := values;
		container           Day                   := /Templates/DayNr_T(., yyyymmdd);
		attribute<Weekdays> Weekday_rel           := value(Day/Weekday, Weekdays);
		attribute<uint32>   NrTrips               := sum(Calendar_dates/nType == 1 ? Services/NrTrips[Calendar_dates/Services_rel] : 0, Calendar_dates/CalendarDate_rel), Descr = "Trips of the services that are added on this date (exception_type 1).";
		attribute<uint32>   MaxTrips_PerWeekday (Weekdays) := max(NrTrips, Weekday_rel);
	}

	container ServiceDays
	: Descr = "The service days around Analysis_date (D): D-1, D and D+1, which the network lays on one time axis in seconds since 00:00 of D, with all trips of D at their GTFS time (also 24:00 and later), the trips of D-1 after midnight (GTFS time 24:00 and later, minus 24 hours) and the trips of D+1 that start before the end of the analysis window (plus 24 hours); the dates follow from a day number, not from arithmetic on the digits."
	{
		unit<uint32> AnalysisDay : nrofrows = 1
		{
			attribute<uint32> yyyymmdd := const(uint32(ModelParameters/Impl/Analysis_date), .);
		}
		container AnalysisDayNr := /Templates/DayNr_T(AnalysisDay, AnalysisDay/yyyymmdd);

		unit<uint32> Days : nrofrows = 3
		{
			attribute<string>        name                 : ['Yesterday', 'Today', 'Tomorrow'];
			attribute<string>        label                : ['D-1', 'D', 'D+1'];
			attribute<uint32>        DayNr                := first(AnalysisDayNr/DayNr) + id(.) - 1;
			container                Civil                := /Templates/CivilDate_T(., DayNr);
			attribute<uint32>        yyyymmdd             := Civil/yyyymmdd;
			attribute<Weekdays>      Weekday_rel          := value((DayNr + 3) % 7, Weekdays);
			attribute<bool>          IsDSTChange          := Weekday_rel == Weekdays/V/sunday && (Civil/M == 3 || Civil/M == 10) && Civil/D >= 25, Descr = "The last Sunday of March or October: the GTFS times of that day count from 12:00 minus 12 hours, which is then not midnight.";
			attribute<bool>          IsNeeded             := id(.) == 1
			                                                 || (id(.) == 0 && ModelParameters/Impl/PT_FirstDepartureMoment < ModelParameters/Impl/PrevServiceDayTailEnd)
			                                                 || (id(.) == 2 && uint32(ModelParameters/Impl/PT_LastArrivalMoment) > 86400)
			, Descr = "D always; D-1 when the window starts before PrevServiceDayTailEnd; D+1 when the window runs on past midnight.";
			attribute<CalendarDates> CalendarDate_rel     := rlookup(yyyymmdd, CalendarDates/yyyymmdd);
			attribute<uint32>        NrTrips              := MakeDefined(CalendarDates/NrTrips[CalendarDate_rel], 0);
			attribute<uint32>        MaxTrips_SameWeekday := MakeDefined(CalendarDates/MaxTrips_PerWeekday[Weekday_rel], 0);
			attribute<float32>       TripShare            := MaxTrips_SameWeekday > 0 ? float32(NrTrips) / float32(MaxTrips_SameWeekday) : 0f;
			attribute<bool>          IsComplete           := TripShare >= ModelParameters/Advanced/MinServiceDayTripShare;
			attribute<string>        Report               := label + ' ' + string(yyyymmdd) + ' (' + Weekdays/name[Weekday_rel] + '): ' + string(NrTrips) + ' ritten, '
			                                                 + string(round(TripShare * 100f)) + '% van de drukste ' + Weekdays/name[Weekday_rel] + ' in de feed'
			                                                 + (IsNeeded ? (IsComplete ? '' : ', ONVOLLEDIG') : ', niet nodig voor dit venster')
			                                                 + (IsDSTChange ? ', zomertijdwissel' : '');
		}
		parameter<uint32> Yesterday_date := Days/yyyymmdd[value(0, Days)];
		parameter<uint32> Today_date     := Days/yyyymmdd[value(1, Days)];
		parameter<uint32> Tomorrow_date  := Days/yyyymmdd[value(2, Days)];
		parameter<string> Report         := asList(Days/Report, '; ');

		// The three checks are calculated as soon as the public transport network is built (ExplicitSuppliers of RelevantSelection/ScheduledLinks).
		parameter<bool> Check_ServiceDaysComplete := all(!Days/IsNeeded || Days/IsComplete)
		, IntegrityCheck = "Check_ServiceDaysComplete == True"
		, Descr = "Every service day that the analysis window needs is in the feed with at least MinServiceDayTripShare of the trips of the busiest day of the same weekday; Report gives the numbers.";
		parameter<string>   CongestionDay := lowercase(ModelParameters/Advanced/CongestionSpeed_DaySelection);
		parameter<Weekdays> Today_Weekday := Days/Weekday_rel[value(1, Days)];
		parameter<bool> Check_WeekdayMatchesCongestionDay :=
			CongestionDay == 'week'
			|| (CongestionDay == 'weekday' && Today_Weekday < Weekdays/V/saturday)
			|| (CongestionDay == 'weekend' && Today_Weekday >= Weekdays/V/saturday)
			|| CongestionDay == Weekdays/name[Today_Weekday]
		, IntegrityCheck = "Check_WeekdayMatchesCongestionDay == True"
		, Descr = "The weekday of Analysis_date matches Advanced/CongestionSpeed_DaySelection, the day of the TomTom speeds for the car.";
		parameter<bool> Check_NoDSTChange := all(!(Days/IsDSTChange && Days/IsNeeded && id(Days) >= 1))
		, IntegrityCheck = "Check_NoDSTChange == True"
		, Descr = "Neither D nor, when the window runs on past midnight, D+1 is a day with a change to or from daylight saving time (the trips of D-1 after midnight come out right even then).";
	}
	
	unit<uint32> RawStops := Read/Stops/domain, Descr = "The stops of the feed, with their point in RD and whether a selected trip uses them."
	{
		attribute<float64>           stop_lat            := float64(Read/Stops/data/stop_lat);
		attribute<float64>           stop_lon            := float64(Read/Stops/data/stop_lon);
		attribute<string>            stop_id             := Read/Stops/data/stop_id;
		attribute<string>            stop_name           := Read/Stops/data/stop_name;
		attribute<dpoint>            point_wgs           := point_xy(float64(stop_lon), float64(stop_lat), wgs84_base);
		attribute<rdc>               geometry_feed       := LatLongWgs842RD(point_wgs, rdc);
		// A stop with the coordinates (0, 0) in the feed gets the point of its parent_station; without a parent with a point it keeps the point
		// from the feed. Otherwise such stops (for example foreign platforms of international trains) would lie together in the Gulf of Guinea,
		// as one stop cluster with transfers at distance 0.
		attribute<bool>              IsWithoutPoint        := stop_lat == 0d || stop_lon == 0d;
		attribute<.>                 Parent_rel          := rlookup(Read/Stops/data/parent_station, stop_id);
		attribute<rdc>               geometry            := IsWithoutPoint ? MakeDefined(geometry_feed[Parent_rel], geometry_feed) : geometry_feed;
		attribute<string>            Label               := stop_name;
		attribute<bool>              StopUsed            := any(RawStopTimes/SelToday, RawStopTimes/RawStop_rel) || any(RawStopTimes/SelYesterday, RawStopTimes/RawStop_rel) || any(RawStopTimes/SelTomorrow, RawStopTimes/RawStop_rel);
	}
	
	unit<uint32> RawTrips  := Read/Trips/domain, Descr = "The trips of the feed, with the service days on which they run and whether they join the public transport network."
	{
		attribute<string>                  trip_id         := Read/Trips/data/trip_id;
		attribute<uint32>                  shape_id        := uint32(Read/Trips/data/shape_id);
		attribute<string>                  service_id      := Read/Trips/data/service_id;
		attribute<Services>                Services_rel     := rlookup(service_id, Services/Values);
		attribute<bool>                    sel_today       := Services/Today_exc[Services_rel] = 1;
		attribute<bool>                    sel_yesterday   := Services/Yesterday_exc[Services_rel] = 1;
		attribute<bool>                    sel_tomorrow    := Services/Tomorrow_exc[Services_rel] = 1;
		attribute<Time>                    StartTime       := min(RawStopTimes/departureTime/TimesVector/Time_rel, RawStopTimes/RawTrip_rel);
		attribute<bool>                    sel_tomorrow_window := sel_tomorrow && uint32(StartTime) + 86400 < uint32(ModelParameters/Impl/PT_LastArrivalMoment), Descr = "Trips of D+1 that start before the end of the analysis window; none when the window ends before midnight.";
		attribute<Trips_x_order_uq>        first_txo       := min_index(Trips_x_order_uq/ord, Trips_x_order_uq/RawTrip_rel);
		attribute<shapes>                  shape_rel       := rlookup(shape_id, shapes/shape_id);
		// Flexible transport: a trip of a flex line that departs in the same block of ModelParameters/Advanced/FlexMinInterval as an earlier trip
		// of the same trip pattern does not join the public transport network (FlexOptions, RawStopTimes/Sel*Net). The public transport hubs count
		// all trips (StopTimes/SelToday), so that the destinations do not depend on the flex parameters.
		attribute<bool>                    IsFlex          := MakeDefined(RelevantSelection/Routes/IsFlex[RelevantSelection/Trips/Route_rel], false);
		attribute<bool>                    KeepFlexOption  := = ModelParameters/Advanced/IncludeFlex && ModelParameters/Impl/FlexMinInterval_sec > 0
			? 'not(IsFlex) || MakeDefined(FlexOptions/Keep[invert(FlexOptions/org_rel)], true)'
			: 'const(true, ., bool)'
			, Descr = "True when the trip joins the public transport network; only trips of flex lines can drop out, see FlexOptions.";
	}
	
	unit<uint32> RawStopTimes := Read/Stop_times/domain //StopTimes
	, Descr = "Times that a vehicle arrives at and departs from stops for each trip."
	{
		attribute<RawTrips>              RawTrip_rel            := rlookup(Read/Stop_times/data/trip_id, RawTrips/trip_id);
		attribute<bool>                    SelToday                 := RawTrips/sel_today[RawTrip_rel];
		attribute<bool>                    SelYesterday             := RawTrips/sel_yesterday[RawTrip_rel] && (Time/Day[departureTime/TimesVector/Time_rel] > 0);
		attribute<bool>                    SelTomorrow              := RawTrips/sel_tomorrow_window[RawTrip_rel] && (Time/Day[departureTime/TimesVector/Time_rel] == 0) && (Time/Day[arrivalTime/TimesVector/Time_rel] == 0), Descr = "Whole trips of D+1 that start before the end of the window, with a GTFS time below 24:00, so that plus 24 hours they fall within the time axis of 48 hours.";
		attribute<bool>                    SelYesterdayNet          := SelYesterday && RawTrips/KeepFlexOption[RawTrip_rel], Descr = "SelYesterday without the thinned flex options (RawTrips/KeepFlexOption): the trips of the public transport network.";
		attribute<bool>                    SelTodayNet              := SelToday     && RawTrips/KeepFlexOption[RawTrip_rel], Descr = "SelToday without the thinned flex options (RawTrips/KeepFlexOption): the trips of the public transport network.";
		attribute<bool>                    SelTomorrowNet           := SelTomorrow  && RawTrips/KeepFlexOption[RawTrip_rel], Descr = "SelTomorrow without the thinned flex options (RawTrips/KeepFlexOption): the trips of the public transport network.";
		attribute<RawStops>              RawStop_rel            := rlookup(Read/Stop_times/data/stop_id, RawStops/stop_id);
		attribute<RawStops>              NextRawStop_rel        := RawStop_rel[NextStopId];
		attribute<uint32>                  Stop_Sequence            := uint32(Read/Stop_times/data/stop_sequence);
		attribute<uint32>                  shape_dist_traveled      := uint32(Read/Stop_times/data/shape_dist_traveled);
		attribute<uint32>                  next_shape_dist_traveled := shape_dist_traveled[NextStopId];
		// #3: GTFS pickup_type and drop_off_type 1 mean no boarding or alighting here; 2 and 3 (phone the agency, arrange with the driver) count as
		// allowed, as with flex lines, and empty counts as 0. This keeps Eurostar, Nightjet, European Sleeper and GoVolta out of domestic trips:
		// at their Dutch stops they allow boarding or alighting, never both.
		attribute<bool>                    PickupAllowed            := MakeDefined(uint32(Read/Stop_times/data/pickup_type), 0) != 1;
		attribute<bool>                    DropOffAllowed           := MakeDefined(uint32(Read/Stop_times/data/drop_off_type), 0) != 1;

		attribute<upoint>                  Trip_x_Ordinal           := point_xy(Stop_Sequence, RawTrip_rel, upoint);
		attribute<Trips_x_order_uq>        txo_uq_rel               := rlookup(Trip_x_Ordinal, Trips_x_order_uq/Values);
		attribute<uint32>                  ordered_ord              := txo_uq_rel - RawTrips/first_txo[RawTrip_rel];
		attribute<upoint>                  ThisStopUni              := point_xy(RawTrip_rel, ordered_ord, upoint);
		attribute<upoint>                  NextStopUni              := point_xy(RawTrip_rel, ordered_ord+1, upoint);
		attribute<.>                       NextStopId               := rlookup(NextStopUni, ThisStopUni);
		attribute<bool>                    EndPoint                 := IsNull(NextStopId);
		
		container departureTime := Templates/GTFS_getTimes_T(.,Read/Stop_times/data/departure_time);
		container arrivalTime   := Templates/GTFS_getTimes_T(.,Read/Stop_times/data/arrival_time);
	
		// The links per service day, on the time axis in seconds since 00:00 of Analysis_date (D). The length of a link without a usable
		// shape_dist_traveled falls back to the straight-line distance.
		container Yesterday := DayLinks_T(SelYesterdayNet, 0, 24 * 60 * 60), Descr = "Trips of D-1 after midnight (GTFS time 24:00 and later), minus 24 hours.";
		container Today     := DayLinks_T(SelTodayNet,     0, 0),            Descr = "Trips of D at their GTFS time, also after midnight (24:00 and later).";
		container Tomorrow  := DayLinks_T(SelTomorrowNet,  24 * 60 * 60, 0), Descr = "Trips of D+1 that start before the end of the analysis window, plus 24 hours.";
	}

	// Thinning of the flex options (ModelParameters/Advanced/FlexMinInterval). Some feeds schedule on-demand area transport as a trip every
	// minute, which gives very many public transport legs per departure and very large stop blocks. Per trip pattern (route, first and last
	// stop, number of stops) only the first trip of each block of FlexMinInterval, counted from 00:00 of the GTFS day, stays.
	unit<uint32> FlexOptions := select_with_org_rel(RawTrips/IsFlex)
	{
		attribute<RawStopTimes> First_st      := min_index(RawStopTimes/Stop_Sequence, RawStopTimes/RawTrip_rel)[org_rel];
		attribute<RawStopTimes> Last_st       := max_index(RawStopTimes/Stop_Sequence, RawStopTimes/RawTrip_rel)[org_rel];
		attribute<uint32>         NrStops       := pcount(RawStopTimes/RawTrip_rel)[org_rel];
		attribute<uint64>         PatternKey    := ((uint64(RelevantSelection/Trips/Route_rel[org_rel]) * uint64(#RawStops) + uint64(RawStopTimes/RawStop_rel[First_st])) * uint64(#RawStops) + uint64(RawStopTimes/RawStop_rel[Last_st])) * uint64(1024) + uint64(min_elem(NrStops, uint32(1023)));
		unit<uint32>              Pattern       := unique_uint32(PatternKey);
		attribute<Pattern>        Pattern_rel   := rlookup(PatternKey, Pattern/values);
		attribute<uint32>         StartSec      := uint32(RawTrips/StartTime[org_rel]);
		attribute<uint64>         GroupKey      := uint64(Pattern_rel) * uint64(65536) + uint64(StartSec / ModelParameters/Impl/FlexMinInterval_sec);
		unit<uint32>              Group         := unique_uint32(GroupKey);
		attribute<Group>          Group_rel     := rlookup(GroupKey, Group/values);
		attribute<.>              First (Group) := min_index(StartSec, Group_rel), Descr = "The first trip of each block; with equal start times the first in the feed.";
		attribute<bool>           Keep          := First[Group_rel] == ID(.);
	}

	Template DayLinks_T
	{
		attribute<bool>   Sel (RawStopTimes);
		parameter<uint32> AddSec;
		parameter<uint32> SubSec;
		//
		unit<uint32> Links := select_with_org_rel(Sel && !RawStopTimes/EndPoint)
		{
			attribute<rdc>         geometry     (arc) := points2sequence(GenLines/Points, GenLines/Sequence_rel, GenLines/Ordinal);
			attribute<uint32>      dist_shape         := sub_or_null(RawStopTimes/next_shape_dist_traveled[org_rel], RawStopTimes/shape_dist_traveled[org_rel]);
			attribute<uint32>      dist_traveled      := dist_shape <= 100 ? null_u : dist_shape;
			attribute<m>           dist_euclid        := arc_length(geometry, m_f64)[m];
			attribute<rdc>         fromPoint          := RawStops/geometry[RawStopTimes/RawStop_rel[org_rel]];
			attribute<RawStops>  From_RawStop_rel := RawStopTimes/RawStop_rel[org_rel];
			attribute<rdc>         ToPoint            := RawStops/geometry[RawStopTimes/NextRawStop_rel[org_rel]];
			attribute<RawStops>  To_RawStop_rel   := RawStopTimes/RawStop_rel[RawStopTimes/NextStopId[org_rel]];
			attribute<RawTrips>  RawTrip_rel      := RawStopTimes/RawTrip_rel[org_rel];
			attribute<Time>        depTime            := value(sub_or_null(uint32(RawStopTimes/departureTime/TimesVector/Time_rel[org_rel]) + AddSec, SubSec), Time);
			attribute<Time>        arrTime            := value(sub_or_null(uint32(RawStopTimes/arrivalTime/TimesVector/Time_rel[RawStopTimes/NextStopId[org_rel]]) + AddSec, SubSec), Time);
			attribute<km>          Length             := MakeDefined(convert(float32(dist_traveled)[m], km), convert(dist_euclid, km));
			attribute<bool>        FromPickupAllowed  := RawStopTimes/PickupAllowed[org_rel];
			attribute<bool>        FromDropOffAllowed := RawStopTimes/DropOffAllowed[org_rel];
			attribute<bool>        ToPickupAllowed    := RawStopTimes/PickupAllowed[RawStopTimes/NextStopId[org_rel]];
			attribute<bool>        ToDropOffAllowed   := RawStopTimes/DropOffAllowed[RawStopTimes/NextStopId[org_rel]];
		}
		unit<uint32> GenLines := union_unit(Links, Links)
		{
			attribute<rdc>    Points          := union_data(., Links/FromPoint, Links/ToPoint);
			attribute<Links>  Sequence_rel    := union_data(., id(Links), id(Links));
			attribute<uint32> Ordinal         := union_data(., const(0,Links,uint32), const(1,Links,uint32));
		}
	}

	unit<uint32> Trips_x_order_uq := unique(RawStopTimes/Trip_x_Ordinal) 
	{
		attribute<RawTrips>  RawTrip_rel:= pointRow(Values)[RawTrips];
		attribute<uint32>      ord     := pointCol(Values);
	}
	
	unit<uint32> Services := unique(RawTrips/service_id)
	, Descr = "The services of the trips (service_id), with their exception type on D-1, D and D+1 from calendar_dates and their number of trips."
	{
		attribute<uint32>  Today_exc     := sum(Calendar_dates/Today * Calendar_dates/nType, Calendar_dates/Services_rel);
		attribute<uint32>  Yesterday_exc := sum(Calendar_dates/Yesterday * Calendar_dates/nType, Calendar_dates/Services_rel);
		attribute<uint32>  Tomorrow_exc  := sum(Calendar_dates/Tomorrow * Calendar_dates/nType, Calendar_dates/Services_rel);
		attribute<uint32>  NrTrips       := pcount(RawTrips/Services_rel);
	}
	
	unit<uint32> Shapes := Read/Shapes/domain
	, Descr = "Rules for mapping vehicle travel paths, sometimes referred to as route alignments."
	{
		attribute<uint32>  shape_id                      := uint32(Read/Shapes/data/shape_id);
		attribute<uint32>  shape_pt_sequence             := uint32(Read/Shapes/data/shape_pt_sequence);
		attribute<shape_seqnrs>  shape_seqnrs_rel        := rlookup(shape_pt_sequence, id(shape_seqnrs));
		attribute<float64> shape_pt_lat                  := float64(Read/Shapes/data/shape_pt_lat);
		attribute<float64> shape_pt_lon                  := float64(Read/Shapes/data/shape_pt_lon);
		attribute<uint32>  shape_dist_traveled_cum       := uint32(Read/Shapes/data/shape_dist_traveled);
		
		attribute<uint32>  shape_dist_traveled_cum_prev  := shape_dist_traveled_cum[sub_or_null(id(.),1)];
		attribute<uint32>  shape_id_prev                 := shape_id[sub_or_null(id(.),1)];
		attribute<uint32>  shape_dist_traveled_increm    := shape_id == shape_id_prev ? sub_or_null(shape_dist_traveled_cum, shape_dist_traveled_cum_prev) : 0;
		attribute<km>      real_length                   := value(shape_dist_traveled_increm, m)[km];
		attribute<dpoint>  point_wgs                     := point_xy(shape_pt_lon, shape_pt_lat, wgs84_base);
		attribute<rdc>     geometry                      := LatLongWgs842RD(point_wgs, rdc);
		
		attribute<c_shape_seqnr> c_shape_seqnr_rel := combine_data(c_shape_seqnr, shape_id, shape_seqnrs_rel);
		attribute<upoint> shape_dist_iden   := point_xy(shape_id, shape_dist_traveled_cum);
		
		attribute<Uq> Uq_rel := rlookup(shape_id, Uq/values);
		
		unit<uint32> Uq := unique_uint32(shape_id)
		{
			attribute<uint32>  shape_id       := values;
			attribute<rdc>     geometry (arc) := points2sequence(../geometry,Uq_rel);
			attribute<m>       length_m       := arc_length(geometry, m_f64)[m];
			attribute<uint32>  dist_traveled  := last(shape_dist_traveled_cum, Uq_rel);
			attribute<uint32>  dist_traveled_incr  := sum(shape_dist_traveled_increm, Uq_rel);
		}
	}
	
	unit<uint32>                       shape_seqnrs      : nrofrows = 10000;
	unit<uint64>                       c_shape_seqnr     := combine_unit_uint64(shapes, shape_seqnrs);
}



