container BAG
{
	// parameter<string> SnapshotDir := '%BAG_DataDir_OVSRV6%/BAG/snapshots.ext/20220101';
	// parameter<string> SnapshotDir   := '%NetworkModel_dir%/RegioIndelingen/BAG/'+ModelParameters_base/RegioIndelingen_year+'0101';
	// Sinds 2026-09-22 leest deze config de BAG-snapshot die BAG-Tools zelf oplevert:
	// %BAG_DataDir%/BAG/snapshots.ext/<jaar>0101.new/bag.mmd, een enkele mmd-store met de hele BAG.
	// Het achtervoegsel .new is hoe MakeSnapshot zijn uitvoermap noemt (MakeSnapshot.dms:26), niet een
	// voorlopige status. De store van 20260101 is gemaakt uit het BAG-historiebestand
	// %SourceDataDir%/BAG/20260808/mmd_ge en meldt in zijn overzicht.txt nul ontbrekende geometrieen.
	// De oude drieslag vbo/pand/adres.fss onder %NetworkModel_dir%/RegioIndelingen/BAG bestond hier
	// nooit; PostAnalysis/UAI leest wel nog de jaarreeks snapshots.ext/<jaar>0101_RS via Snapshot_T.
	parameter<string> SnapshotDir   := '%BAG_DataDir%/BAG/snapshots.ext/'+ModelParameters/Advanced/BAG_snapshot;
	unit<uint32> RegioUnit_Buurt    := /SourceData/RegioIndelingen/Buurt;
	unit<uint32> RegioUnit_Wijk     := /SourceData/RegioIndelingen/Wijk;
	unit<uint32> RegioUnit_Gemeente := /SourceData/RegioIndelingen/Gemeente;
	
	parameter<uint32> BAG_year      := uint32(ModelParameters/Advanced/BAG_year);

	// De BAG-snapshots (vbo/pand/adres.fss) zijn EXTERNE stores: op deze machine lezen ook BAG-Tools,
	// Hestia (ook bij TNO), RSLight2021, RSopen, Vesta50, WLO2024, Sawec, RVNL, NetworkModel_PE en
	// AccessibilityModelling ze. Ze blijven dus staan zoals ze zijn; deze config leest een mmd-kopie
	// ernaast, met precies de kolommen die NetworkModel_PBL nodig heeft. Snapshot_T levert per
	// snapshotmap drie lagen: fss (de externe store, ongewijzigd gelezen), Make_mmd (schrijft de kopie
	// ernaast, eenmalig per snapshot via Make_mmd/Generate) en store (de kale mmd-lezers, die onder een
	// read-only MMD-holder niets mogen declareren, zie issue #1245).
	//
	// De geometrie in vbo en pand staat als rdc_mm (ipoint, millimeters) en is dus niet geraakt door de
	// overgang van rdc naar dpoint; adres.fss heeft wel een fpoint-geometrie en die wordt hier niet
	// gelezen (dat is ook waarom de oude declaratie ervan uitgecommentarieerd stond).
	Template Snapshot_T
	{
		parameter<string> dir;
		//
		container fss
		: Descr = "De externe snapshot-stores in hun eigen vorm; alleen als bron voor de mmd-kopie."
		{
			unit<uint32> vbo
			:	StorageName     = "= dir+'/vbo.fss'"
			,	StorageReadOnly = "True"
			{
				attribute<rdc_mm>              geometry_mm;
				attribute<string>              identificatie;
				attribute<int32>               oppervlakte;
				attribute<string>              nummeraanduiding_id;
				attribute<string>              pand_id;
				attribute<string>              status;
				
				container gebruiksdoelen := for_each_ndv(Classifications/vbo_gebruiksdoel/name, vbo, bool);
			}
			
			unit<uint32> pand
			:	StorageName     = "= dir+'/pand.fss'"
			,	StorageReadOnly = "True"
			{
				attribute<rdc_mm>              geometry_mm (polygon);
				attribute<string>              identificatie;
				attribute<int16>               bouwjaar;
				attribute<WPSrc>               woonpand_type;
				attribute<string>              status;
			}
			
			unit<uint32> adres
			:	StorageName     = "= dir+'/adres.fss'"
			,	StorageReadOnly = "True"
			{
				attribute<string>              straatnaam;
				attribute<string>              postcode;
				attribute<int32>               huisnummer;
				attribute<string>              huisletter;
				attribute<string>              toevoeging;
				attribute<string>              woonplaatsnaam;
				attribute<string>              nummeraanduiding_id;
			}
		}
		
		container Make_mmd
		: Descr = "Schrijft de mmd-kopieen naast de fss. Vraag Make_mmd/Generate op, of vbo/pand/adres apart."
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "vbo;pand;adres";
			
			unit<uint32> vbo := fss/vbo
			,	StorageName = "= dir+'/vbo.mmd'"
			{
				attribute<rdc_mm>              geometry_mm         := fss/vbo/geometry_mm;
				attribute<string>              identificatie       := fss/vbo/identificatie;
				attribute<int32>               oppervlakte         := fss/vbo/oppervlakte;
				attribute<string>              nummeraanduiding_id := fss/vbo/nummeraanduiding_id;
				attribute<string>              pand_id             := fss/vbo/pand_id;
				attribute<string>              status              := fss/vbo/status;
				
				container gebruiksdoelen := for_each_nedv(Classifications/vbo_gebruiksdoel/name, 'fss/vbo/gebruiksdoelen/'+Classifications/vbo_gebruiksdoel/name, vbo, bool);
			}
			
			unit<uint32> pand := fss/pand
			,	StorageName = "= dir+'/pand.mmd'"
			{
				attribute<rdc_mm>              geometry_mm (polygon) := fss/pand/geometry_mm;
				attribute<string>              identificatie         := fss/pand/identificatie;
				attribute<int16>               bouwjaar              := fss/pand/bouwjaar;
				attribute<WPSrc>               woonpand_type         := fss/pand/woonpand_type;
				attribute<string>              status                := fss/pand/status;
			}
			
			unit<uint32> adres := fss/adres
			,	StorageName = "= dir+'/adres.mmd'"
			{
				attribute<string>              straatnaam          := fss/adres/straatnaam;
				attribute<string>              postcode            := fss/adres/postcode;
				attribute<int32>               huisnummer          := fss/adres/huisnummer;
				attribute<string>              huisletter          := fss/adres/huisletter;
				attribute<string>              toevoeging          := fss/adres/toevoeging;
				attribute<string>              woonplaatsnaam      := fss/adres/woonplaatsnaam;
				attribute<string>              nummeraanduiding_id := fss/adres/nummeraanduiding_id;
			}
		}
		
		container store
		: Descr = "Kale mmd-lezers; declareren niets (#1245), de dictionary van de kopie levert de kolommen."
		{
			unit<uint32> vbo   : StorageName = "= dir+'/vbo.mmd'",   StorageReadOnly = "true";
			unit<uint32> pand  : StorageName = "= dir+'/pand.mmd'",  StorageReadOnly = "true";
			unit<uint32> adres : StorageName = "= dir+'/adres.mmd'", StorageReadOnly = "true";
		}
	}
	
	// Kale lezer van de snapshot-store: onder een read-only MMD-holder mag niets gedeclareerd worden
	// (#1245), de dictionary levert woonplaats, openbareruimte, nummeraanduiding, ligplaats,
	// standplaats, pand en vbo plus de statusklassen. De items hieronder brengen die vorm terug naar de
	// namen die de rest van deze config al gebruikte, zodat src, de gebruiksdoelsets, de pandclusters,
	// de adrescentroiden en RegioIndelingen ongewijzigd blijven. Wat de snapshot extra biedt en hier
	// nog niet gebruikt wordt: pand/gebruiksdoelen/nr_woon (het aantal woon-vbo's per pand, dat Panden/
	// pand zelf uitrekent), vbo/pand_rel en vbo/nummeraanduiding_rel als echte relaties, en
	// vbo/nevenadres en vbo/gerelateerdPand.
	container snapshot
	:	StorageName     = "= SnapshotDir+'/bag.mmd'"
	,	StorageReadOnly = "true"
	,	Descr = "Kale lezer van de BAG-snapshot van BAG-Tools; declareert niets."
	;
	
	// De statuslabels van de snapshot zijn kleine letters en kennen een extra klasse 'onbekend'; de
	// eigen classificaties hebben hoofdletters. Koppelen op kleine letters houdt de selecties van dit
	// model (VBO_selection, Pand_selection_condition) letterlijk gelijk; 'onbekend' wordt null.
	// De snapshot heeft ook een eigen vlag 'selected', maar die kiest er drie (in gebruik, in gebruik
	// niet ingemeten, verbouwing) waar dit model er vier neemt (ook buiten gebruik), dus die vlag wordt
	// hier niet gebruikt.
	container status_mapping
	{
		attribute<vbo_status>  vbo  (snapshot/status_vbo)  := rlookup(lowercase(snapshot/status_vbo/Label),  lowercase(vbo_status/label));
		attribute<pand_status> pand (snapshot/status_pand) := rlookup(lowercase(snapshot/status_pand/Label), lowercase(pand_status/label));
	}

	
	container VBOs
	{
		// Uit de snapshot, onder de namen die src verwacht. geometry komt hier al als rdc (dpoint) uit de
		// store, dus de oude omweg via rdc_mm is niet meer nodig; nummeraanduiding_id en status zijn
		// afgeleid van de relaties en klassen van de snapshot.
		unit<uint32> import := snapshot/vbo
		{
			attribute<rdc>                 geometry            := snapshot/vbo/geometry;
			attribute<string>              identificatie       := snapshot/vbo/identificatie;
			attribute<int32>               oppervlakte         := snapshot/vbo/oppervlakte;
			attribute<string>              pand_id             := snapshot/pand/identificatie[snapshot/vbo/pand_rel];
			attribute<string>              nummeraanduiding_id := snapshot/nummeraanduiding/identificatie[snapshot/vbo/nummeraanduiding_rel];
			attribute<vbo_status>          status_rel          := status_mapping/vbo[snapshot/vbo/meta/status_rel];
			attribute<string>              status              := vbo_status/label[status_rel];
			
			container gebruiksdoelen := for_each_nedv(Classifications/vbo_gebruiksdoel/name, 'snapshot/vbo/gebruiksdoelen/'+Classifications/vbo_gebruiksdoel/name, import, bool);
		}
		
		unit<uint32> src := import
		{
			attribute<rdc>                 geometry                := import/geometry;
			attribute<string>              identificatie           := import/identificatie;
			attribute<string>              nummeraanduiding_id     := import/nummeraanduiding_id;
			attribute<string>              pand_id                 := import/pand_id;	// Expliciet, niet alleen via de verwijzing naar import: de arrow (org_rel -> pand_id) in de
			// gebruiksdoelsets kan alleen echte sub-items van src vinden.
			attribute<uint64>              vbo_bag_nr              := uint64(import/identificatie);
			attribute<vbo_status>          status_rel              := rlookup(status, vbo_status/label);
			attribute<string>              status                  := import/status;
			attribute<panden/pand>         pand_rel                := rlookup(pand_id, panden/pand/identificatie);
			
			container gebruiksdoelen := 
				for_each_nedv(
					vbo_gebruiksdoel/name
					, 'import/gebruiksdoelen/'+vbo_gebruiksdoel/name
					, import
					, bool
				);
				
			attribute<bool> VBO_selection := src/status_rel == Classifications/vbo_status/V/verblijfsobject_in_gebruik
												|| src/status_rel == Classifications/vbo_status/V/verblijfsobject_in_gebruik_niet_ingemeten
												|| src/status_rel == Classifications/vbo_status/V/verblijfsobject_buiten_gebruik
												|| src/status_rel == Classifications/vbo_status/V/Verbouwing_verblijfsobject;
		}
											
		container GebruiksdoelSets :=
			for_each_ne(
				vbo_gebruiksdoel/name,
				'MaakGebruiksdoelSets_T(' + quote(vbo_gebruiksdoel/name) +')'
			);
		
		Template MaakGebruiksdoelSets_T
		{
			//
			parameter<string> name;
			//
			
			unit<uint32> GebruiksdoelSet := ='select_with_org_rel(src/gebruiksdoelen/'+name+'&& src/VBO_selection)'
			{
				// De arrow (org_rel -> x) lost x op tegen de STORE-unit waar dit domein uiteindelijk op rust, niet
				// tegen src of import. Alleen wat de snapshot zelf heeft is dus zo te halen: geometry,
				// identificatie, oppervlakte, pand_rel, nummeraanduiding_rel, meta/status_rel en de
				// gebruiksdoelen. Een pand_id of nummeraanduiding_id bestaat daar niet meer (de oude fss had ze
				// als string), dus die worden hier uit de relaties gehaald.
				attribute<rdc>                 geometry                             := org_rel -> geometry;
				attribute<string>              identificatie                        := org_rel -> identificatie;
				attribute<string>              nummeraanduiding_id                  := snapshot/nummeraanduiding/identificatie[org_rel -> nummeraanduiding_rel];
				attribute<string>              pand_identificatie                   := snapshot/pand/identificatie[org_rel -> pand_rel];
				attribute<panden/pand>         pand_rel                             := rlookup(pand_identificatie, panden/pand/identificatie)
				,	Descr = "Verwijzing naar de geselecteerde panden (Panden/pand). Niet rechtstreeks org_rel -> pand_rel: dat levert een relatie naar de ONgefilterde pand-unit van de snapshot, en die is niet te verenigen met de dynamische selectie Panden/pand (de engine meldt dan een domain mismatch op de sleuteluitdrukking).";
			}
		}
	}
	
	container Panden
	{
		// Uit de snapshot. De geometrie is hier al rdc (dpoint) poly; woonpand_type_rel wordt op positie
		// gekoppeld aan WPSrc: beide hebben zes klassen in dezelfde orde, waarbij de zesde in de snapshot
		// 'meergezinspand' heet en in WPSrc 'appartement'.
		unit<uint32> import := snapshot/pand
		{
			attribute<rdc>    geometry (polygon)    := snapshot/pand/geometry;
			attribute<string> identificatie         := snapshot/pand/identificatie;
			attribute<int16>  bouwjaar              := int16(snapshot/pand/bouwjaar);
			attribute<WPSrc>  woonpand_type         := value(uint8(snapshot/pand/woonpand_type_rel), WPSrc);
			attribute<pand_status> status_rel       := status_mapping/pand[snapshot/pand/meta/status_rel];
			attribute<string> status                := pand_status/label[status_rel];
			attribute<uint32> nr_woon_vbo           := snapshot/pand/gebruiksdoelen/nr_woon, Descr = "Aantal vbo's met woonfunctie per pand, kant en klaar in de snapshot; Panden/pand rekent dit zelf ook uit als count_vbo_pand_woon, over de eigen status- en gebruiksdoelselectie.";
		}
		
		unit<uint32> src := import
		{
			attribute<rdc> geometry (polygon) := import/geometry;
			attribute<string> identificatie := import/identificatie;
			attribute<uint64> bag_nr := uint64(identificatie);
			attribute<int16> bouwjaar := import/bouwjaar;
			attribute<int16> bouwjaar_trunc := bouwjaar < 1000s || bouwjaar > BAG_year[int16] ? (0/0)[int16] : bouwjaar < 1600s ? 1600s : bouwjaar;
			attribute<WPSrc> woonpand_type := import/woonpand_type;
			attribute<WPSrc> WPSrc_rel := woonpand_type;
			attribute<rdc> NW := lower_bound(src/geometry);
			attribute<rdc> SE := upper_bound(src/geometry);
			attribute<m_f64> X_ext := sub_or_null(PointCol(SE), PointCol(NW))[m_f64], Descr = "Breedte van de omhullende van het pand. De selectie hieronder gooit panden groter dan een kilometer weg; in de snapshot van 20260101 zijn er geen panden zonder geometrie (overzicht.txt), maar de check blijft staan als vangnet.";
			attribute<m_f64> Y_ext := sub_or_null(PointRow(SE), PointRow(NW))[m_f64];
			attribute<string> status := import/status;
			attribute<pand_status> status_rel := rlookup(status, pand_status/label);
			attribute<bool> Pand_selection_condition (src) := src/X_ext < 1000[m_f64] && src/Y_ext < 1000[m_f64]
				&& (src/status_rel == pand_status/V/Pand_in_gebruik
					|| src/status_rel == pand_status/V/Pand_in_gebruik_niet_ingemeten
					|| src/status_rel == pand_status/V/Pand_buiten_gebruik
					|| src/status_rel == pand_status/V/Verbouwing_pand);
		}
	
		unit<uint32> pand := select_with_attr_by_cond(src, src/Pand_selection_condition)
		{
			unit<uint32>                  vbo_woon_domein      := VBOs/GebruiksdoelSets/woon/GebruiksdoelSet;
			attribute<string>             pand_id                  := identificatie;
			attribute<rdc>                pand_centroid            := centroid_or_mid(geometry);
			attribute<uint32>             count_vbo_pand_woon      := pcount(vbo_woon_domein/pand_rel); //pand_woon_vbo_rel
			
			unit<uint32> pand_woon_vbo := select_with_org_rel(pand/count_vbo_pand_woon > 0)
			{
				attribute<rdc>             pand_polygoon (polygon)  := org_rel -> geometry, Descr = "De pandcontour; heette geometry_mm toen de snapshot de geometrie in millimeters gaf.";
				attribute<rdc>             geometry                 := org_rel -> pand_centroid;
				
				attribute<uint32>          count_vbo_pand_woon      := org_rel -> count_vbo_pand_woon;
				attribute<string>          name                     := org_rel -> pand_id;
	
				unit<spoint> domain := ='rdc_'+Gridsize;
				
				attribute<domain>                domain_rel                      := geometry[domain];
				attribute<uint32>                Count_per_domain       (domain) := count(count_vbo_pand_woon[uint32], domain_rel);
				attribute<uint32>                Count_IsPositive       (domain) := Count_per_domain > 0 ? Count_per_domain : (0/0);
				attribute<uint32>                Sum_woningen           (domain) := sum(count_vbo_pand_woon, domain_rel)
				,	Descr = "Aantal woningen (verblijfsobjecten met woonfunctie, in voorraad) per cel; Count_per_domain telt de panden.";
				
				parameter<string>                Gridsize                        := ModelParameters/Advanced/Dest_location_scale;
				
				unit<uint32> HeeftPanden := select_with_attr_by_org_rel(.,Count_IsPositive > 0)
				{
					attribute<rdc>    geometry            := domain/point[org_rel];
					attribute<uint32> identificatie       := id(.);
					attribute<string> id_name             := 'PandBlok_' + string(identificatie);
					attribute<string> label               := id_name;
					attribute<string> name                := id_name;
					attribute<uint32> nr_panden           := Count_per_domain;
					attribute<uint32> nr_woningen         := Sum_woningen;
					attribute<uint32> nr_inwoners         := Sum_woningen
					,	Descr = "De org-unit van het OV-model (NetworkSetup/PublicTransport_Prep/impl/org) vraagt elke herkomstenset om nr_inwoners als gewicht. Voor deze set is het aantal WONINGEN in de cel de beste maat die in de BAG zelf zit; het is dus geen inwonertal. Wie een echt inwonertal wil, vermenigvuldigt met een gemiddelde huishoudgrootte of koppelt SourceData/Locaties/Inwoners (CBS-vierkanten) aan de cel.";
				} 
				
			}
		}

	}	
	
	container Adressen
	{	
		// De adressen zijn in de snapshot de nummeraanduidingen, met straatnaam en woonplaatsnaam al
		// bijgeschreven (en een eigen rdc-geometrie, die deze config niet gebruikt: src leidt de
		// geometrie af uit de vbo's, zodat een adres op zijn verblijfsobject ligt).
		unit<uint32> import := snapshot/nummeraanduiding
		{
			attribute<string>   straatnaam          := snapshot/nummeraanduiding/straatnaam;
			attribute<string>   postcode            := snapshot/nummeraanduiding/postcode;
			attribute<int32>    huisnummer          := snapshot/nummeraanduiding/huisnummer;
			attribute<string>   huisletter          := snapshot/nummeraanduiding/huisletter;
			attribute<string>   toevoeging          := snapshot/nummeraanduiding/toevoeging;
			attribute<string>   woonplaatsnaam      := snapshot/nummeraanduiding/woonplaatsNaam;
			attribute<string>   nummeraanduiding_id := snapshot/nummeraanduiding/identificatie;
		}
		
		unit<uint32> src := import
		{
			attribute<string>   postcode               := import/postcode;
			attribute<string>   postcode4               := substr(postcode, 0, 4);
			attribute<string>   city                   := woonplaatsnaam;
			attribute<rdc>      geometry               := ='rjoin(nummeraanduiding_id, VBOs/src/nummeraanduiding_id, VBOs/src/geometry)';
			attribute<bool>     IsWoon                 := ='rjoin(nummeraanduiding_id, VBOs/src/nummeraanduiding_id, VBOs/src/gebruiksdoelen/woon)';
			attribute<bool>     IsVoorraad             := ='rjoin(nummeraanduiding_id, VBOs/src/nummeraanduiding_id, VBOs/src/VBO_selection)';
			attribute<rdc>      point                  := geometry;
			attribute<string>   pc_huisnr              := postcode +'_'+string(huisnummer);
			attribute<string>   name                   := pc_huisnr;
		}
		
		unit<uint32> Woon_Voorraad := select_with_attr_by_cond(src, src/IsWoon && src/IsVoorraad)
		{
			attribute<RegioUnit_Buurt>    buurt_rel    := point_in_polygon(geometry,  RegioUnit_Buurt/geometry);
			attribute<RegioUnit_Wijk>     wijk_rel     := point_in_polygon(geometry,  RegioUnit_Wijk/geometry);
			attribute<RegioUnit_Gemeente> gemeente_rel := point_in_polygon(geometry,  RegioUnit_Gemeente/geometry);
			
			attribute<uint32>   PC4_uq_rel := rlookup(postcode4, pc4_uq/values);
			attribute<uint32>   PC6_uq_rel := rlookup(postcode, pc6_uq/values);
			
			unit<uint32> buurt := RegioUnit_Buurt
			{
				attribute<float64>  x_mean    := mean(pointcol(../geometry), buurt_rel);
				attribute<float64>  y_mean    := mean(pointrow(../geometry), buurt_rel);
				attribute<rdc>      centroid0 := point_xy(x_mean, y_mean, rdc);
				
				//controles
				attribute<.>        poly_rel             := point_in_polygon(centroid0, ./geometry);
				attribute<string>   statcode_poly        := ./statcode;
				attribute<string>   statcode_centr       := statcode_poly[Poly_rel];
				attribute<bool>     IsStatcode_gelijk    := statcode_poly == statcode_centr;
				attribute<bool>     HeeftAdressen        := pcount(buurt_rel) > 0; 
				
				attribute<rdc>      centroid_or_mid      := centroid_or_mid(./geometry);
				attribute<rdc>      centroid             := IsStatcode_gelijk ? centroid0 : centroid_or_mid;
			}
			
			unit<uint32> wijk := RegioUnit_Wijk
			{
				attribute<float64>  x_mean := mean(pointcol(../geometry), wijk_rel);
				attribute<float64>  y_mean := mean(pointrow(../geometry), wijk_rel);
				attribute<rdc>      centroid0 := point_xy(x_mean, y_mean, rdc);
				
				//controles
				attribute<.>        poly_rel       := point_in_polygon(centroid0, ./geometry);
				attribute<string>   statcode_poly  := ./statcode;
				attribute<string>   statcode_centr := statcode_poly[Poly_rel];
				attribute<bool>     IsStatcode_gelijk   := statcode_poly == statcode_centr;
				
				attribute<rdc>      centroid_or_mid      := centroid_or_mid(./geometry);
				attribute<rdc>      centroid             := IsStatcode_gelijk ? centroid0 : centroid_or_mid;
			}
			
			unit<uint32> gemeente := RegioUnit_Gemeente
			{
				attribute<float64>  x_mean := mean(pointcol(../geometry), gemeente_rel);
				attribute<float64>  y_mean := mean(pointrow(../geometry), gemeente_rel);
				attribute<rdc>      centroid0 := point_xy(x_mean, y_mean, rdc);
				
				//controles
				attribute<.>        poly_rel       := point_in_polygon(centroid0, ./geometry);
				attribute<string>   statcode_poly  := ./statcode;
				attribute<string>   statcode_centr := statcode_poly[Poly_rel];
				attribute<bool>     IsStatcode_gelijk   := statcode_poly == statcode_centr;
				
				attribute<rdc>      centroid_or_mid      := centroid_or_mid(./geometry);
				attribute<rdc>      centroid             := IsStatcode_gelijk ? centroid0 : centroid_or_mid;
			}
			
			unit<uint32> pc4_uq := unique(postcode4)
			{
				attribute<float64>  x_mean   := mean(pointcol(../geometry), PC4_uq_rel);
				attribute<float64>  y_mean   := mean(pointrow(../geometry), PC4_uq_rel);
				attribute<rdc>      geometry := point_xy(x_mean, y_mean, rdc);
				attribute<string>   PC4      := values;
			}
			
			unit<uint32> PC4_centroids := select_with_attr_by_cond(pc4_uq, IsDefined(pc4_uq/geometry) && pc4_uq/PC4 != '')
			{
				attribute<rdc>      point    := geometry;
				attribute<string>   name     := PC4;
				attribute<string>   label    := PC4;
				attribute<SourceData/RegioIndelingen/COROP> corop_rel    := point_in_polygon(geometry, SourceData/RegioIndelingen/COROP/geometry);
				
				unit<uint32> sub1 := select_with_attr_by_cond(., name == '8891')
				{
				}
				
				container Per_COROP := 
					for_each_ne(
						SourceData/RegioIndelingen/COROP/name
						, '/SourceData/RegioIndelingen/Per_COROP_T('+string(id(SourceData/RegioIndelingen/COROP))+', ..)'
					);
			}
			
			unit<uint32> pc6_uq := unique(postcode)
			{
				attribute<float64>  x_mean   := mean(pointcol(../geometry), PC6_uq_rel);
				attribute<float64>  y_mean   := mean(pointrow(../geometry), PC6_uq_rel);
				attribute<rdc>      geometry := point_xy(x_mean, y_mean, rdc);
				attribute<string>   PC6      := values;
			}
			
			unit<uint32> PC6_centroids := select_with_attr_by_cond(pc6_uq, IsDefined(pc6_uq/geometry) && pc6_uq/PC6 != '')
			{
				attribute<rdc>      point    := geometry;
				attribute<string>   name     := PC6;
			}
		}
	}
}
