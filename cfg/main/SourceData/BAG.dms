container BAG_History
:	Descr  = "The BAG with all voorkomens of the verblijfsobjecten (vbo's), panden and nummeraanduidingen, one store per object type as Xml2MMD of BAG-Tools writes it; BAG_T selects from it the state on a date (#142)."
,	Source = "Kadaster, BAG 2.0 extract of ModelParameters/BAG_file_date, converted with Xml2MMD of ObjectVision/BAG-Tools."
{
	parameter<string>      Dir                           := '%NetworkModel_Dir%/RegioIndelingen/BAG/BAG_' + ModelParameters/BAG_file_date + '_History', Descr = "The folder of the stores, under the name that BAG-Tools gives it.";

	unit<uint32>           vbo                           : StorageName = "=Dir + '/vbo.mmd'"             , StorageReadOnly = "True";
	unit<uint32>           pand                          : StorageName = "=Dir + '/pand.mmd'"            , StorageReadOnly = "True";
	unit<uint32>           nummeraanduiding              : StorageName = "=Dir + '/nummeraanduiding.mmd'", StorageReadOnly = "True";

	attribute<vbo_status>  vbo_status_rel   (vbo/status) := rlookup(lowercase(vbo/status/Label), lowercase(vbo_status/label)), IntegrityCheck = "all(IsDefined(this) || vbo/status/Label == 'onbekend')", Descr = "The status codes of the vbo store as elements of Classifications/vbo_status, matched on their label; the code onbekend has none.";
	attribute<pand_status> pand_status_rel (pand/status) := rlookup(lowercase(pand/status/Label), lowercase(pand_status/label)), IntegrityCheck = "all(IsDefined(this) || pand/status/Label == 'onbekend')", Descr = "The status codes of the pand store as elements of Classifications/pand_status, matched on their label; the code onbekend has none.";
	attribute<uint64>      vbo_pand_id             (vbo) := vbo/gerelateerdPand/pand_id[rlookup(id(vbo), vbo/gerelateerdPand/vbo_rel)], Descr = "The first pand of a vbo voorkomen in the order of the BAG, so that a vbo in more than one pand counts once.";
	attribute<int32>       pand_X_ext             (pand) := sub_or_null(PointCol(upper_bound(pand/geometry)), PointCol(lower_bound(pand/geometry))), Descr = "The width of the polygon of a pand voorkomen in mm; null for an empty polygon, which Xml2MMD writes for a coordinate that does not fit in millimetres.";
	attribute<int32>       pand_Y_ext             (pand) := sub_or_null(PointRow(upper_bound(pand/geometry)), PointRow(lower_bound(pand/geometry))), Descr = "The height of the polygon of a pand voorkomen in mm; null for an empty polygon.";
}

Template Valid_T
:	Descr = "The voorkomens of a BAG store that are valid on a date, one per object: begun on or before the date and not ended on or before it, and of an object with more than one such voorkomen the one with the highest voorkomenidentificatie, as MakeSnapshot of BAG-Tools chooses."
{
	unit<uint32>      Store;
	parameter<int32>  Peildatum;
	attribute<uint64> ObjectId    (Store);
	attribute<uint32> VoorkomenId (Store);
	attribute<int32>  BeginDate   (Store);
	attribute<int32>  EndDate     (Store);
	//

	unit<uint32> Valid := select_with_org_rel(BeginDate <= Peildatum && (EndDate == 0i || EndDate > Peildatum)), Descr = "The voorkomens valid on Peildatum; an end date of 0 means not ended."
	{
		attribute<uint64>  object_id    := ObjectId[org_rel];
		attribute<uint32>  voorkomen_id := VoorkomenId[org_rel];
		attribute<Objects> object_rel   := rlookup(object_id, Objects/values);
		attribute<bool>    IsChosen     := voorkomen_id == Objects/LastVoorkomenId[object_rel];
	}

	unit<uint32> Objects := unique(Valid/object_id)
	{
		attribute<uint32>  LastVoorkomenId := max(Valid/voorkomen_id, Valid/object_rel);
	}

	unit<uint32> Result := select_with_org_rel(Valid/IsChosen), Descr = "One voorkomen per object, with its row in the store (store_rel)."
	{
		attribute<Store>   store_rel := Valid/org_rel[org_rel];
	}
}

Template BAG_T
:	Descr = "The BAG on the date: the vbo's, panden and addresses valid on it, selected from BAG_History (#142)."
{
	parameter<string> date;
	//
	parameter<int32>  Peildatum           := int32(date), Descr = "The date as yyyymmdd.";
	unit<uint32>      RegionUnit_Wijk     := /SourceData/RegioIndelingen/Wijk;
	unit<uint32>      RegionUnit_Gemeente := /SourceData/RegioIndelingen/Gemeente;

	container VBOs
	{
		container Valid            := Valid_T(BAG_History/vbo, Peildatum, BAG_History/vbo/identificatie, BAG_History/vbo/meta/VOORKOMENIDENTIFICATIE, BAG_History/vbo/meta/BEGINDATUM, BAG_History/vbo/meta/EINDDATUM);

		unit<uint32> src := Valid/Result
		{
			attribute<rdc_mm>      geometry_mm         := BAG_History/vbo/geometry[store_rel];
			attribute<rdc>         geometry            := geometry_mm[rdc];
			attribute<uint64>      identificatie       := BAG_History/vbo/identificatie[store_rel];
			attribute<uint64>      nummeraanduiding_id := BAG_History/vbo/nummeraanduiding_id[store_rel];
			attribute<vbo_status>  status_rel          := BAG_History/vbo_status_rel[BAG_History/vbo/meta/status_rel[store_rel]];
			attribute<uint64>      pand_id             := BAG_History/vbo_pand_id[store_rel];
			attribute<panden/pand> pand_rel            := rlookup(pand_id, panden/pand/identificatie);

			container              gebruiksdoelen      :=
				for_each_nedv(
					vbo_gebruiksdoel/name
					, 'BAG_History/vbo/gebruiksdoelen/' + vbo_gebruiksdoel/name + '[store_rel]'
					, src
					, bool
				);

			attribute<bool>        VBO_selection       := status_rel == Classifications/vbo_status/V/verblijfsobject_in_gebruik
			                                              || status_rel == Classifications/vbo_status/V/verblijfsobject_in_gebruik_niet_ingemeten
			                                              || status_rel == Classifications/vbo_status/V/verblijfsobject_buiten_gebruik
			                                              || status_rel == Classifications/vbo_status/V/Verbouwing_verblijfsobject;
		}

		container GebruiksdoelSets :=
			for_each_ne(
				vbo_gebruiksdoel/name,
				'MakeGebruiksdoelSets_T(' + quote(vbo_gebruiksdoel/name) +')'
			);

		Template MakeGebruiksdoelSets_T
		{
			//
			parameter<string> name;
			//

			unit<uint32> GebruiksdoelSet := ='select_with_org_rel(src/gebruiksdoelen/'+name+' && src/VBO_selection)'
			{
				attribute<rdc>         geometry            := src/geometry[org_rel];
				attribute<uint64>      identificatie       := src/identificatie[org_rel];
				attribute<uint64>      nummeraanduiding_id := src/nummeraanduiding_id[org_rel];
				attribute<panden/pand> pand_rel            := src/pand_rel[org_rel];
			}
		}
	}

	container Panden
	{
		container Valid := Valid_T(BAG_History/pand, Peildatum, BAG_History/pand/identificatie, BAG_History/pand/meta/VOORKOMENIDENTIFICATIE, BAG_History/pand/meta/BEGINDATUM, BAG_History/pand/meta/EINDDATUM);

		unit<uint32> src := Valid/Result
		{
			attribute<uint64>      identificatie            := BAG_History/pand/identificatie[store_rel];
			attribute<pand_status> status_rel               := BAG_History/pand_status_rel[BAG_History/pand/meta/status_rel[store_rel]];
			attribute<int32>       X_ext                    := BAG_History/pand_X_ext[store_rel];
			attribute<int32>       Y_ext                    := BAG_History/pand_Y_ext[store_rel];
			attribute<bool>        Pand_selection_condition := X_ext < 1000000i && Y_ext < 1000000i
			                                                   && (status_rel == pand_status/V/Pand_in_gebruik
			                                                       || status_rel == pand_status/V/Pand_in_gebruik_niet_ingemeten
			                                                       || status_rel == pand_status/V/Pand_buiten_gebruik
			                                                       || status_rel == pand_status/V/Verbouwing_pand)
			, Descr = "The panden in use or in renovation, with a polygon smaller than 1 km in both directions; a pand without a polygon has no extent and drops out.";
		}

		unit<uint32> pand := select_with_org_rel(src/Pand_selection_condition)
		{
			attribute<BAG_History/pand> store_rel := src/store_rel[org_rel];
			attribute<uint64> identificatie              := src/identificatie[org_rel];
			attribute<string> pand_id                    := right('0000000000000000' + string(identificatie), 16), Descr = "The identificatie as the BAG writes it, sixteen digits with leading zeros.";
			unit<uint32>      vbo_residential_domain     := VBOs/GebruiksdoelSets/woon/GebruiksdoelSet;
			attribute<uint32> count_vbo_pand_residential := pcount(vbo_residential_domain/pand_rel);

			unit<uint32> pand_residential_vbo := select_with_org_rel(pand/count_vbo_pand_residential > 0)
			{
				attribute<rdc_mm> geometry_mm      (polygon) := BAG_History/pand/geometry[org_rel -> store_rel];
				attribute<rdc>    geometry                   := centroid_or_mid(geometry_mm[rdc]);

				attribute<uint32> count_vbo_pand_residential := org_rel -> count_vbo_pand_residential;
				attribute<string> name                       := org_rel -> pand_id;

				unit<spoint>      domain                     := ='rdc_'+Gridsize;

				attribute<domain> domain_rel                 := geometry[domain];
				attribute<uint32> Count_per_domain  (domain) := count(count_vbo_pand_residential[uint32], domain_rel);
				attribute<uint32> Count_IsPositive  (domain) := Count_per_domain > 0 ? Count_per_domain : (0/0);
				attribute<uint32> Sum_dwellings     (domain) := sum(count_vbo_pand_residential, domain_rel), Descr = "Number of dwellings (vbo's with a residential function) per cell; Count_per_domain counts the buildings.";

				parameter<string> Gridsize                   := ModelParameters/Advanced/Org_location_scale, Descr = "Cell size of the origin clustering.";

				unit<uint32> HasPanden := select_with_attr_by_org_rel(.,Count_IsPositive > 0), Descr = "The cells with at least one residential building, as origins named PandBlok_<n>."
				{
					attribute<rdc>    geometry       := domain/point[org_rel];
					attribute<uint32> identificatie  := id(.);
					attribute<string> id_name        := 'PandBlok_' + string(identificatie);
					attribute<string> label          := id_name;
					attribute<string> name           := id_name;
					attribute<uint32> nr_panden      := Count_per_domain;
					attribute<uint32> nr_dwellings   := Sum_dwellings;
					attribute<uint32> nr_inhabitants := Sum_dwellings, Descr = "The origin weight that NetworkSetup asks every origin set for: here the number of dwellings in the cell, not a population count.";
				}

			}
		}

	}

	container Adressen
	{
		container Valid := Valid_T(BAG_History/nummeraanduiding, Peildatum, BAG_History/nummeraanduiding/identificatie, BAG_History/nummeraanduiding/meta/VOORKOMENIDENTIFICATIE, BAG_History/nummeraanduiding/meta/BEGINDATUM, BAG_History/nummeraanduiding/meta/EINDDATUM);

		unit<uint32> nummeraanduiding := Valid/Result
		{
			attribute<uint64> identificatie := BAG_History/nummeraanduiding/identificatie[store_rel];
			attribute<string> postcode      := BAG_History/nummeraanduiding/postcode[store_rel];
		}

		unit<uint32> Residential_Stock := VBOs/GebruiksdoelSets/woon/GebruiksdoelSet, Descr = "The dwellings in the housing stock, the vbo's with a residential function in VBOs/src/VBO_selection, at their point and with the postcode of their main address, with their district and municipality; the neighbourhoods of a CBS year count them themselves (RegioIndelingen/Divisions)."
		{
			attribute<../nummeraanduiding> nummeraanduiding_rel := rlookup(nummeraanduiding_id, ../nummeraanduiding/identificatie);
			attribute<string> postcode   := ../nummeraanduiding/postcode[nummeraanduiding_rel];
			attribute<string> postcode4  := substr(postcode, 0, 4);

			attribute<RegionUnit_Wijk> wijk_rel := point_in_polygon(geometry,  RegionUnit_Wijk/geometry);
			attribute<RegionUnit_Gemeente> gemeente_rel := point_in_polygon(geometry,  RegionUnit_Gemeente/geometry);

			attribute<uint32> PC4_uq_rel := rlookup(postcode4, pc4_uq/values);
			attribute<uint32> PC6_uq_rel := rlookup(postcode, pc6_uq/values);

			unit<uint32> wijk := RegionUnit_Wijk
			{
				attribute<float64> x_mean           := mean(pointcol(../geometry), wijk_rel);
				attribute<float64> y_mean           := mean(pointrow(../geometry), wijk_rel);
				attribute<rdc>     centroid0        := point_xy(x_mean, y_mean, rdc);

				// checks
				attribute<.>       poly_rel         := point_in_polygon(centroid0, ./geometry);
				attribute<string>  statcode_poly    := ./statcode;
				attribute<string>  statcode_centr   := statcode_poly[Poly_rel];
				attribute<bool>    IsStatcode_equal := statcode_poly == statcode_centr;

				attribute<rdc>     centroid_or_mid  := centroid_or_mid(./geometry);
				attribute<rdc>     centroid         := IsStatcode_equal ? centroid0 : centroid_or_mid;
			}

			unit<uint32> gemeente := RegionUnit_Gemeente
			{
				attribute<float64> x_mean           := mean(pointcol(../geometry), gemeente_rel);
				attribute<float64> y_mean           := mean(pointrow(../geometry), gemeente_rel);
				attribute<rdc>     centroid0        := point_xy(x_mean, y_mean, rdc);

				// checks
				attribute<.>       poly_rel         := point_in_polygon(centroid0, ./geometry);
				attribute<string>  statcode_poly    := ./statcode;
				attribute<string>  statcode_centr   := statcode_poly[Poly_rel];
				attribute<bool>    IsStatcode_equal := statcode_poly == statcode_centr;

				attribute<rdc>     centroid_or_mid  := centroid_or_mid(./geometry);
				attribute<rdc>     centroid         := IsStatcode_equal ? centroid0 : centroid_or_mid;
			}

			unit<uint32> pc4_uq := unique(postcode4)
			{
				attribute<float64> x_mean   := mean(pointcol(../geometry), PC4_uq_rel);
				attribute<float64> y_mean   := mean(pointrow(../geometry), PC4_uq_rel);
				attribute<rdc>     geometry := point_xy(x_mean, y_mean, rdc);
				attribute<string>  PC4      := values;
			}

			unit<uint32> PC4_centroids := select_with_attr_by_cond(pc4_uq, IsDefined(pc4_uq/geometry) && pc4_uq/PC4 != '')
			{
				attribute<rdc>    point     := geometry;
				attribute<string> name      := PC4;
				attribute<string> label     := PC4;
				attribute<SourceData/RegioIndelingen/COROP> corop_rel := point_in_polygon(geometry, SourceData/RegioIndelingen/COROP/geometry);

				unit<uint32> sub1 := select_with_attr_by_cond(., name == '8891')
				{
				}

				container         Per_COROP :=
					for_each_ne(
						SourceData/RegioIndelingen/COROP/name
						, '/SourceData/RegioIndelingen/Per_COROP_T('+string(id(SourceData/RegioIndelingen/COROP))+', ..)'
					);
			}

			unit<uint32> pc6_uq := unique(postcode)
			{
				attribute<float64> x_mean   := mean(pointcol(../geometry), PC6_uq_rel);
				attribute<float64> y_mean   := mean(pointrow(../geometry), PC6_uq_rel);
				attribute<rdc>     geometry := point_xy(x_mean, y_mean, rdc);
				attribute<string>  PC6      := values;
			}

			unit<uint32> PC6_centroids := select_with_attr_by_cond(pc6_uq, IsDefined(pc6_uq/geometry) && pc6_uq/PC6 != '')
			{
				attribute<rdc>    point := geometry;
				attribute<string> name  := PC6;
			}
		}
	}
}
