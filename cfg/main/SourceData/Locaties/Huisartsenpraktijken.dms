container Huisartsenpraktijken : Descr = "The GP practices per delivery; sub keeps the rows with Org_type 1.", Source = "A web scrape of the GP practices, on 28 and 29 January 2022 and on 4 November 2022 (column Scrapedatum); the files do not name the site"
{
	unit<uint32> y2022_jan
	:	StorageName     = "%SourceDataDir%/NetworkModel/Voorzieningen/Huisartsenpraktijken/Huisartsenpraktijken2022_xy.gdb"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	Descr           = "The GP practices of January 2022."
	{
		unit<uint32> Huisartsenpraktijken_jan2022_xy
		{
			attribute<Geography/rdc>    geometry;
			attribute<Geography/rdc>    point                   := geometry;
			attribute<string>           Name                    := string(HP_ID);
			attribute<uint32>           Nr_huisartsenpraktijken := const(1,.);
			attribute<RegionUnit_Buurt> buurt_rel               := point_in_polygon(geometry, RegionUnit_Buurt/Geometry);
			attribute<string>           buurtcode               := RegionUnit_Buurt/statcode[buurt_rel];
			attribute<string>           buurtnaam               := RegionUnit_Buurt/statnaam[buurt_rel];
			
			unit<uint32>                sub                     := select_with_attr_by_cond(.,Org_type == 1w);
		}
	}

	unit<uint32> y2022_nov
	:	StorageName     = "%SourceDataDir%/NetworkModel/Voorzieningen/Huisartsenpraktijken/Huisartsenpraktijken_nov2022_xy.gdb"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	Descr           = "The GP practices of November 2022."
	{
		unit<uint32> Huisartsenpraktijken_nov2022_xy
		{
			attribute<Geography/rdc>    geometry;
			attribute<Geography/rdc>    point                   := geometry;
			attribute<string>           Name                    := string(HP_ID);
			attribute<uint32>           Nr_huisartsenpraktijken := const(1,.);
			attribute<RegionUnit_Buurt> buurt_rel               := point_in_polygon(geometry, RegionUnit_Buurt/Geometry);
			attribute<string>           buurtcode               := RegionUnit_Buurt/statcode[buurt_rel];
			attribute<string>           buurtnaam               := RegionUnit_Buurt/statnaam[buurt_rel];
			
			unit<uint32>                sub                     := select_with_attr_by_cond(.,Org_type == 1w);
		}
	}
}
