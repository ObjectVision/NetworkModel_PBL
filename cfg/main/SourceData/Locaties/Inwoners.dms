unit<uint32> Inwoners
:	StorageName     = "='%NetworkModel_dir%/Populatie/cbs_vk100_'+Population_Year+'.gpkg'"
,	StorageType     = "gdal.vect"
,	SyncMode        = "AllTables"
,	StorageReadOnly = "True"
,	DialogType      = "map"
,	DialogData      = "centroid"
{
	attribute<rdc>              geometry (poly);
	attribute<rdc>              centroid        := centroid_or_mid(geometry);
	attribute<uint32>           nr_inhabitants  := aantal_inwoners[uint32];
	attribute<RegionUnit_Buurt> buurt_rel       := point_in_polygon(centroid, RegionUnit_Buurt/Geometry);
	attribute<Geography/selection_polygon> StudyArea_rel := point_in_polygon(centroid, Geography/selection_polygon/polygon);
	attribute<rdc_100m>         per_rdc_100m    := centroid[rdc_100m];
	
	unit<uint32> HeeftInwoners := select_with_attr_by_cond(., IsDefined(StudyArea_rel) && nr_inhabitants > 0)
	{  
		attribute<string> name := 'd' + string(id(.));
	}
}

