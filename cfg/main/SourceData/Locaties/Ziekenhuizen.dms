container Ziekenhuizen : Descr = "The hospitals: general (alg) and academic (ac) hospitals and outpatient clinics (bp), per delivery. In the files with alg_ac_bp in the name only the main locations are cleaned; sub selects them (Soort 1 and 2 for the hospitals, Soort 3 for the outpatient clinics)."

{
	unit<uint32> y2012_alg_ac_bp
	:	StorageName     = "%SourceDataDir%/NetworkModel/Voorzieningen/Ziekenhuizen/Ziekenhuizen_alg_ac_bp_xy_2012_def.gdb"
