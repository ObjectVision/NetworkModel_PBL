container NetworkModel : IntegrityCheck = "GeoDMSVersion() >= 20.2402" // 20.24.2: pareto_optimal_eps with a relative epsilon; format 17.1.2 -> 17.0102
{ 	
	// HOW TO RUN THE MODEL (the wiki, How to run the model, has the details):
	// 1. Choose in ModelParameters the analysis moment, the origins and destinations, and the component, or the components to merge.
	// 2. Make the decoupled data with the steps under MakeUnlinkedData, in order. A store is made once per edition or setting, and its signature tells whether it fits.
	// 3. Calculate the results with batch\UpdateAll.cmd output. It runs the origin blocks in portions, each in its own GeoDmsRun, so that memory is freed in between;
	//    NetworkSetup/GenerateOutput/Generate_Output does the same in the GUI in one process, which only suits a small set or one OD pair.
	// 4. To merge components into one front, set MergeOutput in ModelParameters and run batch\UpdateAll.cmd output again.
	// Outside the GUI, batch\UpdateAll.cmd sources, legs, chains and cars make the same stores as step 2.

	container ChecksBeforeRunning
	{
		parameter<string> PT_CheckBlocks         := uint64(ModelParameters/Advanced/MaxStopBlockSize) * uint64(ModelParameters/Advanced/NumberOfStopBlocks) > uint64(#/NetworkSetup/PublicTransport_Prep/Impl/BlockSelections) 
																																? 'PASS: block numbers and size are adequate. It needs to be at least '+string(#/NetworkSetup/PublicTransport_Prep/Impl/BlockSelections)+' and now it is '+string(ModelParameters/Advanced/MaxStopBlockSize)+' * '+string(ModelParameters/Advanced/NumberOfStopBlocks)+' = '+string(uint64(ModelParameters/Advanced/MaxStopBlockSize) * uint64(ModelParameters/Advanced/NumberOfStopBlocks)) 
																																: 'FAIL: you need more or larger blocks to accomodate all stops. It needs to be at least '+string(#/NetworkSetup/PublicTransport_Prep/Impl/BlockSelections)+' and now it is '+string(ModelParameters/Advanced/MaxStopBlockSize)+' * '+string(ModelParameters/Advanced/NumberOfStopBlocks)+' = '+string(uint64(ModelParameters/Advanced/MaxStopBlockSize) * uint64(ModelParameters/Advanced/NumberOfStopBlocks))+''
																															, Descr = "Passen alle haltes in de haltenblokken (MaxStopBlockSize x NumberOfStopBlocks)? Zo niet, maak de blokken groter of talrijker.";
		parameter<string> PT_CheckPrices         := all(NetworkSetup/PublicTransport_Prep/Impl/OD_R/Impl/Price_IntegrityCheck) && all(/NetworkSetup/PublicTransport_Prep/Impl/OD_L/NS_Station_Price_IntegrityCheck)  ? 'PASS: all links have a valid price (or no prices are needed)' : 'FAIL: you need to check the prices (or turn of prices)', Descr = "Heeft elk OV-been een geldige prijs (een FareTable-rij met prijzen), als de instellingen prijzen vragen? Rekent na de netwerkbouw; de ongeprijsde combinaties staan in NetworkSetup/PublicTransport_Prep/Impl/OD_R/impl/Ongeprijsd/uniek, de goedkope voorcheck is PT_CheckPriceCoverage.";
		parameter<string> PT_CheckPriceCoverage  := SourceData/Infrastructure/OVprijzen/PrijsDekking/Status_gated
													, Descr = "Goedkope voorcheck, te draaien VOOR de (uren durende) netwerkbouw en blokruns, bij elke nieuwe feed of nieuw prijsjaar: dekt de actieve prijstabel alle (mode,agency)-combinaties van de geladen GTFS-feed, en zijn alle tabelprijzen gevuld en plausibel? PT_CheckPrices blijft de sluitende check op OD-niveau (na netwerkbouw); diagnose bij FAIL daarvan: NetworkSetup/PublicTransport_Prep/Impl/OD_R/impl/Ongeprijsd/uniek.";
		parameter<string> Check_OriginBlocks      := ModelParameters/Advanced/NumberOfOrgBlocks * ModelParameters/Advanced/MaxOrgBlockSize >= #/NetworkSetup/Impl/OrgBlockSelections 
																												? 'PASS: block numbers and size are adequate.' 
																												: 'FAIL: you need more or larger blocks to accomodate all origins. It needs to be at least '+string(#/NetworkSetup/Impl/OrgBlockSelections )+' and now it is '+string(ModelParameters/Advanced/MaxOrgBlockSize)+' * '+string(ModelParameters/Advanced/NumberOfOrgBlocks)+' = '+string(uint64(ModelParameters/Advanced/MaxOrgBlockSize) * uint64(ModelParameters/Advanced/NumberOfOrgBlocks))+'';
	}

	container MakeUnlinkedData
	:	Descr = "The preparation steps, in order: each step writes stores that the runs read back."
	{
		container Step1_Sources
		:	Descr = "Once per edition of the source data: the OSM network, the TomTom networks (only needed for the component Car) and the GTFS store."
		{
			parameter<String> OSM_Network      := 'Ready', ExplicitSuppliers = "/SourceData/Infrastructure/OSM/Make_Final_Network";
			parameter<String> TomTom_FileLists := 'Ready', ExplicitSuppliers = "/SourceData/Infrastructure/TomTom/impl/GetFileNames_Network/WriteFilesCSV;/SourceData/Infrastructure/TomTom/impl/GetFileNames_Speedprofiles/WriteFilesCSV", Descr = "Lists the files of the raw TomTom delivery, which TomTom_Networks reads.";
			parameter<String> TomTom_Networks  := 'Ready', ExplicitSuppliers = "/SourceData/Infrastructure/TomTom/impl/Generate_Stores";
			parameter<String> GTFS_Feed        := 'Ready', ExplicitSuppliers = "/SourceData/Infrastructure/GTFS/LoadFeeds/store";
		}

		container Step2_Legs
		:	Descr = "The legs of pre- and post-transport as a parquet store per base set in IntermediateResults, which the runs read with ModelParameters/Advanced/LegsDecoupled; Generate_All writes nothing without it."
		{
			parameter<String> Generate_All       := 'Ready', ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/LegStores_Write"
			,	Descr = "Alle basissets in een keer, zoals UpdateAll.cmd legs: de drie hieronder, en Stops2Dest_Walking als herkomsten en bestemmingen verschillen (anders is lopen van de halte naar de bestemming het spiegelbeeld van Org2Stops_Walking).";
			parameter<String> Org2Stops_Walking  := 'Ready', ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/LegStores/Org2Stops_Walking/Write_Legs/legs"
			,	Descr = "Lopen van elke herkomst naar elke halte, over OSM: Legs_<set>toStops_Walking_<hash>.parquet.";
			parameter<String> Org2Stops_Cycling  := 'Ready', ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/LegStores/Org2Stops_Cycling/Write_Legs/legs"
			,	Descr = "Fietsen van elke herkomst naar elke halte, over het net van ModelParameters/Advanced/CyclingNetwork: Legs_<set>toStops_Cycling_<hash>.parquet.";
			parameter<String> Stops2Dest_Cycling := 'Ready', ExplicitSuppliers = "/NetworkSetup/PublicTransport_Prep/LegStores/Stops2Dest_Cycling/Write_Legs/legs"
			,	Descr = "Fietsen van elke halte naar elke bestemming: Legs_Stops2<set>_Cycling_<hash>.parquet. Een eigen store, want het Fietsersbond-net heeft eenrichtingsfietspaden.";
		}

		container Step3_PT_Chains
		:	Descr = "De OV-ketenstore van het dagdeel: een store per haltenblok in %LocalDataProjDir%/IntermediateResults/PT_Chains_<datum>_<venster>_<hash>, dezelfde als UpdateAll.cmd chains maakt."
		{
			parameter<String> Check_Blocks             := /ChecksBeforeRunning/PT_CheckBlocks, Descr = "Passen alle haltes in de haltenblokken (MaxStopBlockSize x NumberOfStopBlocks)?";
			parameter<String> Check_PriceCoverage      := /ChecksBeforeRunning/PT_CheckPriceCoverage, Descr = "Dekt de prijstabel alle combinaties van modaliteit en vervoerder in de feed? Seconden; draai hem voor de ketens.";
			parameter<String> BlocksWritten            := string(/NetworkSetup/PublicTransport_Prep/PT_Chains_Blocks/NrWritten) + ' van ' + string(/NetworkSetup/PublicTransport_Prep/PT_Chains_Blocks/NrBlocks) + ' haltenblokken hebben een store'
			,	Descr = "Hoeveel blokken van de ketenstore met de huidige handtekening er al zijn (een blok telt als zijn 0Dictionary.dms bestaat).";
			parameter<String> Generate_ToDo            := 'Ready', ExplicitSuppliers = "=AsList(/NetworkSetup/PublicTransport_Prep/PT_Chains_Blocks/ToDo/Item, ';')"
			,	Descr = "Rekent en schrijft de blokken zonder store in een opvraging; UpdateAll.cmd chains rekent ze in porties, elk in een eigen GeoDmsRun, zodat het geheugen tussen de porties vrijkomt.";
			container PerBlock := for_each_ne(/NetworkSetup/PublicTransport_Prep/impl/BlockDomain/name, 'WriteBlock_T(' + quote(/NetworkSetup/PublicTransport_Prep/impl/BlockDomain/name) + ')')
			,	Descr = "Per haltenblok: Write rekent en schrijft de store van dat blok, bijvoorbeeld om een blok te proberen.";

			Template WriteBlock_T
			{
				parameter<string> BlockName;
				///
				parameter<String> Write := 'Ready', ExplicitSuppliers = "='/NetworkSetup/PublicTransport_Prep/ChainGeneration_PerBlock/' + BlockName + '/Write'";
			}
		}

		container Step4_CarStores
		:	Descr = "Only for the component Car: per departure moment the travel times and distances of the direct car trip between all origins and destinations (#132)."
		{
			parameter<string> Moments := /ModelParameters/Advanced/CarTimeDependent ? AsList('TD' + /ModelParameters/Advanced/MeasureMoments/TemplatableTextShrt, ' ') : /ModelParameters/Advanced/Car_CongestionMoment_ForDirect
			,	StorageName = "%ConfigDir%/../../batch/log/car_moments.txt", StorageType = "str"
			,	Descr = "The moments whose car store the model reads; batch/UpdateAll.cmd cars makes these when it is given no moments.";
			parameter<string> Writers := '/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/' + replace(Moments, ' ', '/Write_Car;/NetworkSetup/PublicTransport_Prep/Direct/CarPerMoment/') + '/Write_Car';
			parameter<String> Generate_All := 'Ready', ExplicitSuppliers = "=/ModelParameters/Advanced/AllowDirectCar ? Writers : ''"
			,	Descr = "Makes the car stores of all Moments, in one process; batch/UpdateAll.cmd cars makes them one by one.";
		}
	}

	#include<ModelParameters.dms>
	#include<units.dms>
	#include<Geography.dms>
	#include<Classifications.dms>
	#include<SourceData.dms>
	#include<NetworkSetup.dms>
	#include<Templates.dms>
	#include<Output.dms>
	#include<ExportSettings.dms>
	#include<ConfigSettings.dms>
}